//===----------------------------------------------------------------------===//
//
// File: src/tests/fixtures/runtime/test_canvas3d_backend_stats.zia
// Purpose: GPU telemetry and bounded static-geometry residency regression.
// Key invariants: Software counters stay zero; unchanged GPU geometry remains
//   resident through 512 identities, mutations invalidate only their own mesh,
//   and a larger working set still exercises bounded eviction without dropped draws.
// Ownership/Lifetime: The fixture owns its canvas, meshes and materials.
// Links: src/runtime/graphics/3d/backend/vgfx3d_backend.h,
//   docs/internals/graphics3d-architecture.md.
//
//===----------------------------------------------------------------------===//

module test_canvas3d_backend_stats;

bind Zanna.Graphics3D;
bind Zanna.Math;
bind Zanna.Terminal;

func fail(reason: String) {
    Say("FAIL: " + reason);
}

func drawFrame(canvas: Canvas3D, cam: Camera3D, mesh: Mesh3D, mat: Material3D) {
    canvas.Poll();
    canvas.Clear(0.1, 0.1, 0.12);
    canvas.Begin(cam);
    canvas.DrawMesh(mesh, Mat4.Translate(0.0, 0.0, 0.0 - 3.0), mat);
    canvas.End();
    canvas.Flip();
}

func drawWorkingSet(canvas: Canvas3D, cam: Camera3D, meshes: List[Mesh3D], mat: Material3D) {
    canvas.Poll();
    canvas.Clear(0.1, 0.1, 0.12);
    canvas.Begin(cam);
    for i in 0..meshes.length() {
        canvas.DrawMesh(meshes.get(i), Mat4.Translate((i % 32) * 0.1 - 1.55,
                        (i / 32) * 0.1 - 0.95, -4.0), mat);
    }
    canvas.End();
    canvas.Flip();
}

func residencyGate(canvas: Canvas3D, cam: Camera3D, mat: Material3D) -> Boolean {
    var meshes: List[Mesh3D] = [];
    for _ in 0..512 { meshes.add(Mesh3D.Box(0.07, 0.07, 0.02)); }
    for _ in 0..3 { drawWorkingSet(canvas, cam, meshes, mat); }
    var misses = canvas.BackendMeshCacheMisses;
    var hits = canvas.BackendMeshCacheHits;
    for _ in 0..3 { drawWorkingSet(canvas, cam, meshes, mat); }
    if canvas.BackendMeshCacheMisses != misses or canvas.BackendMeshCacheHits - hits < 1536 {
        fail("512 unchanged static meshes did not remain resident");return false;
    }
    Mesh3D.Transform(meshes.get(0), Mat4.Translate(0.001, 0.0, 0.0));
    drawWorkingSet(canvas, cam, meshes, mat);
    if canvas.BackendMeshCacheMisses - misses != 1 {
        fail("a one-mesh mutation refreshed unrelated geometry");return false;
    }
    for _ in 0..128 { meshes.add(Mesh3D.Box(0.07, 0.07, 0.02)); }
    for _ in 0..3 { drawWorkingSet(canvas, cam, meshes, mat); }
    misses = canvas.BackendMeshCacheMisses;
    drawWorkingSet(canvas, cam, meshes, mat);
    if canvas.BackendMeshCacheMisses <= misses or canvas.BackendDroppedDraws != 0 {
        fail("640-mesh working set did not exercise bounded eviction without drops");return false;
    }
    return true;
}

func start() {
    var canvas = Canvas3D.New("backend stats probe", 320, 240);
    var cam = Camera3D.New(60.0, 320.0 / 240.0, 0.1, 100.0);
    var mesh = Mesh3D.Box(1.0, 1.0, 1.0);
    var mat = Material3D.FromColor(0.6, 0.4, 0.2);

    // Two frames: the first uploads the box into the geometry cache (miss),
    // the second reuses it (hit).
    drawFrame(canvas, cam, mesh, mat);
    drawFrame(canvas, cam, mesh, mat);

    if canvas.Backend == "software" {
        if canvas.BackendDrawCalls != 0 or canvas.BackendMeshCacheMisses != 0
           or canvas.BackendPresentPath != 0 {
            fail("software backend reported nonzero backend stats without a hook");
            return;
        }
        Say("PASS: backend stats (software zeros)");
        return;
    }

    if canvas.BackendDrawCalls < 2 {
        fail("GPU backend did not count the two mesh draw calls");
        return;
    }
    if canvas.BackendMeshCacheMisses < 1 or canvas.BackendMeshCacheHits < 1 {
        fail("GPU backend did not count the cache miss/hit pair");
        return;
    }
    if canvas.BackendPresentPath != 1 and canvas.BackendPresentPath != 2 {
        fail("GPU backend did not classify its present path");
        return;
    }
    if canvas.BackendDroppedDraws != 0 {
        fail("GPU backend dropped draws in a well-formed frame");
        return;
    }
    if residencyGate(canvas, cam, mat) == false { return; }
    Say("PASS: backend stats (" + canvas.Backend + ")");
}
