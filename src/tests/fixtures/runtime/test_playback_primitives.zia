// Test: ADR 0250 — dt-driven Tween/SmoothValue and Math interpolation shaping
// Written on Zanna.Testing.Suite, which is itself part of the surface
// under test (ADR 0251) — the harness and its first real consumer.
module test_playback_primitives;
bind Zanna.Terminal as Terminal;
bind Zanna.Text.Fmt as Fmt;
bind Zanna.Game.Tween as Tween;
bind Zanna.Game.SmoothValue as SmoothValue;

var fails: Integer = 0;
func near(a: Float, b: Float, eps: Float) -> Boolean {
    var d = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d < eps;
}
func check(cond: Boolean, msg: String) {
    if !cond { Terminal.Say("FAIL: " + msg); fails = fails + 1; }
}

func start() {
    // --- ms mode advances by wall time, not frames -------------------------
    var t = new Tween();
    t.StartMs(0.0, 100.0, 1000, 0);          // 0 = linear
    check(t.IsMs, "StartMs must set ms mode");
    t.UpdateMs(250);
    check(near(t.Value, 25.0, 0.001), "250/1000 ms linear -> 25 (got " + Fmt.Num(t.Value) + ")");
    t.UpdateMs(250);
    check(near(t.Value, 50.0, 0.001), "500/1000 ms linear -> 50");
    var done = t.UpdateMs(500);
    check(done, "reaching the duration reports completion");
    check(near(t.Value, 100.0, 0.000001), "completion pins the exact end value");
    check(t.IsComplete, "IsComplete after the final advance");

    // --- the same total dt in different slices lands identically -----------
    var a = new Tween();
    a.StartMs(0.0, 100.0, 1000, 0);
    for i in 0..40 { a.UpdateMs(10); }       // 40 x 10 ms
    var b = new Tween();
    b.StartMs(0.0, 100.0, 1000, 0);
    b.UpdateMs(400);                          // one 400 ms step
    check(near(a.Value, b.Value, 0.000001),
          "dt slicing must not change the result (" + Fmt.Num(a.Value) + " vs " +
          Fmt.Num(b.Value) + ")");

    // --- SeekMs is path-independent ----------------------------------------
    var s = new Tween();
    s.StartMs(0.0, 1000.0, 2000, 0);
    s.SeekMs(1500);
    var atSeek = s.Value;
    s.SeekMs(200);
    s.SeekMs(1900);
    s.SeekMs(1500);
    check(near(s.Value, atSeek, 0.000001), "SeekMs must be path-independent");
    s.SeekMs(0);
    check(near(s.Value, 0.0, 0.000001), "seek to 0");
    check(!s.IsComplete, "seeking back un-completes");
    s.SeekMs(999999);
    check(near(s.Value, 1000.0, 0.000001), "seek past the end pins the target");

    // --- mode is sticky ------------------------------------------------------
    var f = new Tween();
    f.Start(0.0, 100.0, 10, 0);               // frame mode
    check(!f.IsMs, "Start leaves frame mode");
    var before = f.Value;
    f.UpdateMs(500);
    check(near(f.Value, before, 0.000001), "UpdateMs is a no-op on a frame tween");
    var m = new Tween();
    m.StartMs(0.0, 100.0, 1000, 0);
    var mv = m.Value;
    m.Update();
    check(near(m.Value, mv, 0.000001), "Update is a no-op on a ms tween");

    // --- integer progress + bit-exact integer lerp --------------------------
    var p = new Tween();
    p.StartMs(0.0, 100.0, 1000, 0);
    p.UpdateMs(250);
    check(p.ProgressPermille == 250, "progress permille 250 (got " +
          Fmt.Int(p.ProgressPermille) + ")");
    p.UpdateMs(750);
    check(p.ProgressPermille == 1000, "progress permille 1000 at the end");
    check(Tween.LerpIntPermille(0, 1000, 250) == 250, "lerp permille quarter");
    check(Tween.LerpIntPermille(0, 1000, 0) == 0, "lerp permille start");
    check(Tween.LerpIntPermille(0, 1000, 1000) == 1000, "lerp permille end");
    check(Tween.LerpIntPermille(0, 1000, 0 - 5) == 0, "lerp permille clamps low");
    check(Tween.LerpIntPermille(0, 1000, 5000) == 1000, "lerp permille clamps high");
    check(Tween.LerpIntPermille(7, 7, 400) == 7, "lerp permille constant");

    // --- reduce motion snaps ------------------------------------------------
    var r = new Tween();
    r.ReduceMotion = true;
    r.StartMs(0.0, 100.0, 5000, 0);
    check(near(r.Value, 100.0, 0.000001), "reduce-motion lands on the target");
    check(r.IsComplete, "reduce-motion reports complete");

    // --- SmoothValue: same dt sequence, same result -------------------------
    var sv1 = new SmoothValue(0.0, 0.9);
    sv1.TimeConstantMs = 100;
    sv1.Target = 100.0;
    for i in 0..10 { sv1.UpdateMs(16); }
    var sv2 = new SmoothValue(0.0, 0.9);
    sv2.TimeConstantMs = 100;
    sv2.Target = 100.0;
    for i in 0..10 { sv2.UpdateMs(16); }
    check(near(sv1.Value, sv2.Value, 0.000001), "UpdateMs is deterministic");
    check(sv1.Value > 50.0 && sv1.Value < 100.0,
          "160 ms at tau=100 should be well along (got " + Fmt.Num(sv1.Value) + ")");

    // a coarser dt reaching the same total time lands close to the same place
    var sv3 = new SmoothValue(0.0, 0.9);
    sv3.TimeConstantMs = 100;
    sv3.Target = 100.0;
    for i in 0..4 { sv3.UpdateMs(40); }       // 160 ms in 4 steps
    check(near(sv1.Value, sv3.Value, 6.0),
          "frame-rate independence: 10x16ms vs 4x40ms (" + Fmt.Num(sv1.Value) +
          " vs " + Fmt.Num(sv3.Value) + ")");

    check(sv1.TimeConstantMs == 100, "time constant round-trips (got " +
          Fmt.Int(sv1.TimeConstantMs) + ")");
    var sn = new SmoothValue(0.0, 0.9);
    sn.Target = 42.0;
    sn.SnapToTarget();
    check(near(sn.Value, 42.0, 0.000001), "SnapToTarget");

    if fails == 0 { Terminal.Say("RESULT: ok (ADR 0250 playback surface behaves)"); }
    else { Terminal.Say("RESULT: fail (" + Fmt.Int(fails) + " checks)"); }
}
