// Test: Async Promise/Future pattern
module TestAsyncPromise;

bind Zanna.Terminal;

func start() {
    // === Test 1: Promise creation ===
    var promise = Zanna.Threads.Promise.New();
    if (promise == null) { Say("FAIL: Promise.New should return non-null"); return; }

    // === Test 2: IsDone before set ===
    var done = Zanna.Threads.Promise.get_IsDone(promise);
    if (done != false) { Say("FAIL: Promise should not be done before Set"); return; }

    // === Test 3: GetFuture ===
    var future = Zanna.Threads.Promise.GetFuture(promise);
    if (future == null) { Say("FAIL: GetFuture should return non-null"); return; }

    // === Test 4: Future IsDone before resolve ===
    var fDone = Zanna.Threads.Future.get_IsDone(future);
    if (fDone != false) { Say("FAIL: Future should not be done before resolve"); return; }

    // === Test 5: Future IsError before resolve ===
    var fErr = Zanna.Threads.Future.get_IsError(future);
    if (fErr != false) { Say("FAIL: Future should not be error before resolve"); return; }

    // === Test 6: Set value on promise ===
    var value = Zanna.Collections.Seq.New();
    Zanna.Collections.Seq.Push(value, 42);
    Zanna.Threads.Promise.Set(promise, value);

    // === Test 7: IsDone after set ===
    done = Zanna.Threads.Promise.get_IsDone(promise);
    if (done != true) { Say("FAIL: Promise should be done after Set"); return; }

    // === Test 8: Future IsDone after resolve ===
    fDone = Zanna.Threads.Future.get_IsDone(future);
    if (fDone != true) { Say("FAIL: Future should be done after resolve"); return; }

    // === Test 9: Future.Get retrieves value ===
    var got = Zanna.Threads.Future.Get(future);
    if (got == null) { Say("FAIL: Future.Get should return value"); return; }

    // Verify it's the same Seq
    var gLen = Zanna.Collections.Seq.get_Count(got as Zanna.Collections.Seq);
    if (gLen != 1) { Say("FAIL: retrieved Seq should have 1 element"); return; }

    // === Test 10: Future.Wait (should return immediately since done) ===
    Zanna.Threads.Future.Wait(future);

    // === Test 11: Future.WaitFor (should return true immediately) ===
    var waitOk = Zanna.Threads.Future.WaitFor(future, 1000);
    if (waitOk != true) { Say("FAIL: WaitFor should return true for completed future"); return; }

    // === Test 12: Error promise ===
    var errPromise = Zanna.Threads.Promise.New();
    var errFuture = Zanna.Threads.Promise.GetFuture(errPromise);
    Zanna.Threads.Promise.SetError(errPromise, "test error");

    var isErr = Zanna.Threads.Future.get_IsError(errFuture);
    if (isErr != true) { Say("FAIL: error future should have IsError=true"); return; }

    var errMsg = Zanna.Threads.Future.get_Error(errFuture);
    if (Zanna.String.get_Length(errMsg) < 1) { Say("FAIL: error message should be non-empty"); return; }

    // === Test 13: Async.Delay ===
    var delayed = Zanna.Threads.Async.Delay(1);
    if (delayed == null) { Say("FAIL: Async.Delay should return a Future"); return; }

    // Wait for the delay
    Zanna.Threads.Future.Wait(delayed);
    var dDone = Zanna.Threads.Future.get_IsDone(delayed);
    if (dDone != true) { Say("FAIL: delayed future should be done after Wait"); return; }

    // === Test 14: Async.All with pre-resolved futures ===
    var p1 = Zanna.Threads.Promise.New();
    var f1 = Zanna.Threads.Promise.GetFuture(p1);
    Zanna.Threads.Promise.Set(p1, Zanna.Collections.Seq.New());

    var p2 = Zanna.Threads.Promise.New();
    var f2 = Zanna.Threads.Promise.GetFuture(p2);
    Zanna.Threads.Promise.Set(p2, Zanna.Collections.Seq.New());

    var futures = Zanna.Collections.Seq.New();
    Zanna.Collections.Seq.Push(futures, f1);
    Zanna.Collections.Seq.Push(futures, f2);

    var allFuture = Zanna.Threads.Async.All(futures);
    if (allFuture == null) { Say("FAIL: Async.All should return a Future"); return; }

    Zanna.Threads.Future.Wait(allFuture);
    var allDone = Zanna.Threads.Future.get_IsDone(allFuture);
    if (allDone != true) { Say("FAIL: All future should be done"); return; }

    Say("RESULT: ok");
}
