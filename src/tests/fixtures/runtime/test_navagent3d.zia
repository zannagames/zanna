module TestNavAgent3D;

bind Zanna.Graphics3D;
bind Zanna.Math;
bind Zanna.Terminal;

func start() {
    var mesh = Mesh3D.Plane(20.0, 20.0);
    var nav = NavMesh3D.Build(mesh, 0.4, 1.8);

    var scene = SceneGraph.New();
    var parent = SceneNode.New();
    var child = SceneNode.New();
    SceneNode.SetPosition(parent, 2.0, 0.0, 1.0);
    SceneNode.AddChild(parent, child);
    SceneGraph.Add(scene, parent);

    var agent = NavAgent3D.New(nav, 0.4, 1.8);
    NavAgent3D.BindNode(agent, child);
    NavAgent3D.set_DesiredSpeed(agent, 6.0);
    NavAgent3D.set_StoppingDistance(agent, 0.2);
    NavAgent3D.Warp(agent, Vec3.New(0.0, 0.0, 0.0));
    NavAgent3D.SetTarget(agent, Vec3.New(4.0, 0.0, 4.0));

    var i = 0;
    while (i < 80) {
        NavAgent3D.Update(agent, 0.05);
        i = i + 1;
    }

    var worldPos = Mat4.TransformPoint(child.WorldMatrix, Vec3.Zero());
    if (Vec3.get_X(worldPos) < 3.65 || Vec3.get_X(worldPos) > 4.35 || Vec3.get_Z(worldPos) < 3.65 ||
        Vec3.get_Z(worldPos) > 4.35) {
        Say("FAIL: NavAgent3D should drive a bound SceneNode to the target in world space");
        return;
    }
    if (NavAgent3D.get_HasPath(agent) != false) {
        Say("FAIL: NavAgent3D should clear HasPath after reaching the target");
        return;
    }
    if (NavAgent3D.get_RemainingDistance(agent) < -0.3 || NavAgent3D.get_RemainingDistance(agent) > 0.3) {
        Say("FAIL: NavAgent3D should reduce RemainingDistance near zero on arrival");
        return;
    }

    var world = PhysicsWorld3D.New(0.0, -9.8, 0.0);
    var character = Character3D.New(0.4, 1.8, 80.0);
    Character3D.set_World(character, world);
    NavAgent3D.BindCharacter(agent, character);
    NavAgent3D.SetTarget(agent, Vec3.New(3.0, 0.0, 0.0));

    i = 0;
    while (i < 20) {
        NavAgent3D.Update(agent, 0.1);
        i = i + 1;
    }

    var charPos = Character3D.get_Position(character);
    if (Vec3.get_X(charPos) <= 1.5) {
        Say("FAIL: NavAgent3D should advance a bound Character3D");
        return;
    }

    NavAgent3D.SetTarget(agent, Vec3.New(5.0, 0.0, 0.0));
    NavAgent3D.Update(agent, 0.1);
    NavAgent3D.Warp(agent, Vec3.New(-3.0, 0.0, 0.0));

    var agentPos = NavAgent3D.get_Position(agent);
    var vel = NavAgent3D.get_Velocity(agent);
    if (Vec3.get_X(agentPos) < -3.2 || Vec3.get_X(agentPos) > -2.8) {
        Say("FAIL: NavAgent3D.Warp should move the agent immediately");
        return;
    }
    if (Vec3.get_X(vel) < -0.001 || Vec3.get_X(vel) > 0.001) {
        Say("FAIL: NavAgent3D.Warp should clear the old velocity");
        return;
    }
    if (NavAgent3D.get_HasPath(agent) != true) {
        Say("FAIL: NavAgent3D.Warp should rebuild the path when a target is still active");
        return;
    }

    // Target readback mirrors SetTarget/ClearTarget.
    if (NavAgent3D.get_HasTarget(agent) != true) {
        Say("FAIL: NavAgent3D should report HasTarget after SetTarget");
        return;
    }
    var targetPos = NavAgent3D.get_Target(agent);
    if (Vec3.get_X(targetPos) < 4.9 || Vec3.get_X(targetPos) > 5.1) {
        Say("FAIL: NavAgent3D.Target should read back the SetTarget position");
        return;
    }

    // Path corners: walk order, first corner near the agent's side of the path.
    if (NavAgent3D.get_PathCornerCount(agent) < 2) {
        Say("FAIL: NavAgent3D should expose at least start/goal path corners");
        return;
    }
    var lastCorner = NavAgent3D.GetPathCorner(
        agent, NavAgent3D.get_PathCornerCount(agent) - 1);
    if (Vec3.get_X(lastCorner) < 4.5 || Vec3.get_X(lastCorner) > 5.5) {
        Say("FAIL: the final path corner should sit at the goal");
        return;
    }

    // Stop keeps the target and path but suppresses motion until Resume.
    NavAgent3D.Stop(agent);
    if (NavAgent3D.get_IsStopped(agent) != true) {
        Say("FAIL: NavAgent3D.Stop should latch IsStopped");
        return;
    }
    var stoppedPos = NavAgent3D.get_Position(agent);
    i = 0;
    while (i < 10) {
        NavAgent3D.Update(agent, 0.1);
        i = i + 1;
    }
    var heldPos = NavAgent3D.get_Position(agent);
    if (Vec3.get_X(heldPos) < Vec3.get_X(stoppedPos) - 0.001
        || Vec3.get_X(heldPos) > Vec3.get_X(stoppedPos) + 0.001) {
        Say("FAIL: a stopped NavAgent3D must not move");
        return;
    }
    if (NavAgent3D.get_HasTarget(agent) != true) {
        Say("FAIL: Stop must keep the navigation target");
        return;
    }
    NavAgent3D.Resume(agent);
    if (NavAgent3D.get_IsStopped(agent) != false) {
        Say("FAIL: NavAgent3D.Resume should clear IsStopped");
        return;
    }
    i = 0;
    while (i < 10) {
        NavAgent3D.Update(agent, 0.1);
        i = i + 1;
    }
    var resumedPos = NavAgent3D.get_Position(agent);
    if (Vec3.get_X(resumedPos) <= Vec3.get_X(heldPos) + 0.1) {
        Say("FAIL: a resumed NavAgent3D should continue toward the target");
        return;
    }

    Say("PASS: navagent3d");
}
