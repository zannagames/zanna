module TestCanvas3DRtOcclusionIsolation;

bind Zanna.Graphics3D;
bind Zanna.Graphics;
bind Zanna.Math;
bind Zanna.Terminal;

// ADR 0310 coverage: render-target frames neither run nor perturb CPU
// occlusion culling.
//   - A warmed covered-streak keeps culling on window frames.
//   - An interleaved RT bracket reports zero CPU-occluded draws itself and
//     does NOT reset the window frames' streaks (previously the identity
//     flip wiped the history and the serial gap broke every streak, so the
//     frame after an RT bracket lost its culling).

func drawScene(canvas: Canvas3D, cam: Camera3D, wall: Mesh3D, hidden: Mesh3D,
               mat: Material3D) {
    Canvas3D.Clear(canvas, 0.0, 0.0, 0.0);
    Canvas3D.Begin(canvas, cam);
    // A big near wall fully covering a grid of boxes behind it.
    Canvas3D.DrawMesh(canvas, wall, Mat4.Translate(0.0, 0.0, 4.0), mat);
    var i = 0;
    while (i < 12) {
        var gx = (i % 4) * 2.0 - 3.0;
        var gy = (i / 4) * 2.0 - 2.0;
        Canvas3D.DrawMesh(canvas, hidden, Mat4.Translate(gx, gy, -6.0), mat);
        i = i + 1;
    }
    Canvas3D.End(canvas);
}

func start() {
    var canvas = Canvas3D.New("RT Occlusion Isolation", 96, 64);
    var cam = Camera3D.New(60.0, 1.5, 0.1, 200.0);
    Camera3D.LookAt(cam,
                    new Vec3(0.0, 0.0, 10.0),
                    new Vec3(0.0, 0.0, 0.0),
                    new Vec3(0.0, 1.0, 0.0));
    var wall = Mesh3D.Box(14.0, 10.0, 0.5);
    var hidden = Mesh3D.Box(1.0, 1.0, 1.0);
    var mat = Material3D.FromColor(0.7, 0.7, 0.7);
    var rt = RenderTarget3D.New(96, 64);

    Canvas3D.SetOcclusionCulling(canvas, true);

    // Warm the covered streaks on window frames.
    var warmed = 0;
    var f = 0;
    while (f < 10) {
        drawScene(canvas, cam, wall, hidden, mat);
        Canvas3D.Flip(canvas);
        warmed = canvas.CpuOccludedDrawCount;
        f = f + 1;
    }
    if (warmed <= 0) {
        Say("FAIL: warm-up never occluded the covered boxes");
        return;
    }

    // One RT bracket in between — it must not occlude anything itself.
    Canvas3D.SetRenderTarget(canvas, rt);
    drawScene(canvas, cam, wall, hidden, mat);
    if (canvas.CpuOccludedDrawCount != 0) {
        Say("FAIL: an RT frame must not run CPU occlusion, got " +
            toString(canvas.CpuOccludedDrawCount));
        return;
    }
    Canvas3D.ResetRenderTarget(canvas);

    // The very next window frame keeps its warmed culling (streaks and
    // history untouched by the RT bracket).
    drawScene(canvas, cam, wall, hidden, mat);
    Canvas3D.Flip(canvas);
    if (canvas.CpuOccludedDrawCount < warmed) {
        Say("FAIL: the RT bracket broke the window frames' covered streaks (" +
            toString(canvas.CpuOccludedDrawCount) + " < " + toString(warmed) + ")");
        return;
    }

    Say("PASS");
}
