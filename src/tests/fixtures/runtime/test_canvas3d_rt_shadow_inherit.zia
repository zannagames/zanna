module TestCanvas3DRtShadowInherit;

bind Zanna.Graphics3D;
bind Zanna.Graphics;
bind Zanna.Math;
bind Zanna.Terminal;

// ADR 0309 coverage: render-target shadow inheritance.
//   - With no cache (first frame ever is a render-target frame) the opt-in
//     falls back to the full shadow pass.
//   - A render-target frame after a full window-backed pass re-arms the
//     cached slots (ShadowSlotsCached) instead of re-rendering them, even
//     when a caster moved — the discriminator against plain signature reuse,
//     which frame D proves by rendering everything again with the flag off.
//   - With cascades enabled, only the non-cascade slots inherit; the
//     cascaded primary re-renders (cascade selection is camera-relative).
//
// A "mover" box shifts every frame so shadow-slot signatures never match
// across frames; every cached/inherited slot is therefore attributable to
// ADR 0309, not to the per-slot signature cache.

var moverX = 0.0;

func drawScene(canvas: Canvas3D, cam: Camera3D, ground: Mesh3D, pillar: Mesh3D,
               mover: Mesh3D, mat: Material3D) {
    moverX = moverX + 0.3;
    Canvas3D.Clear(canvas, 0.0, 0.0, 0.0);
    Canvas3D.Begin(canvas, cam);
    Canvas3D.DrawMesh(canvas, ground, Mat4.Translate(0.0, -1.0, 0.0), mat);
    Canvas3D.DrawMesh(canvas, pillar, Mat4.Translate(3.0, 0.5, 0.0), mat);
    Canvas3D.DrawMesh(canvas, mover, Mat4.Translate(moverX, 0.5, 1.5), mat);
    Canvas3D.End(canvas);
}

func start() {
    var canvas = Canvas3D.New("RT Shadow Inherit", 96, 64);
    if (!Canvas3D.BackendSupports(canvas, "shadow-point")) {
        Say("PASS"); // backend without extended shadow slots (e.g. OpenGL)
        return;
    }
    var cam = Camera3D.New(60.0, 1.5, 0.1, 200.0);
    Camera3D.LookAt(cam,
                    new Vec3(0.0, 9.0, 16.0),
                    new Vec3(3.0, 0.0, 0.0),
                    new Vec3(0.0, 1.0, 0.0));
    var ground = Mesh3D.Plane(50.0, 50.0);
    var pillar = Mesh3D.Box(1.0, 3.0, 3.0);
    var mover = Mesh3D.Box(1.0, 1.0, 1.0);
    var mat = Material3D.FromColor(0.7, 0.7, 0.7);
    var rt = RenderTarget3D.New(96, 64);

    Canvas3D.EnableShadows(canvas, 256);
    Canvas3D.SetShadowCascades(canvas, 1);
    Canvas3D.SetAmbient(canvas, 0.05, 0.05, 0.05);
    Canvas3D.SetRenderTargetShadowInherit(canvas, 1);

    var sun = Light3D.Directional(new Vec3(0.2, -1.0, 0.1), 0.15, 0.15, 0.15);
    sun.CastsShadows = true;
    Canvas3D.SetLight(canvas, 0, sun);
    var point = Light3D.Point(new Vec3(0.0, 2.0, 0.0), 1.0, 1.0, 1.0, 0.0);
    point.CastsShadows = true;
    Canvas3D.SetLight(canvas, 1, point);

    // Frame A: render-target frame with an EMPTY cache -> full-pass fallback.
    Canvas3D.SetRenderTarget(canvas, rt);
    drawScene(canvas, cam, ground, pillar, mover, mat);
    if (canvas.ShadowSlotsUsed != 7) {
        Say("FAIL A: sun (1) + cube point (6) should render 7 slots, got " + toString(canvas.ShadowSlotsUsed));
        return;
    }
    if (canvas.ShadowSlotsCached != 0) {
        Say("FAIL A: no cache exists yet, nothing may be inherited");
        return;
    }
    Canvas3D.ResetRenderTarget(canvas);

    // Frame B: full window-backed pass -> writes the inherit cache.
    drawScene(canvas, cam, ground, pillar, mover, mat);
    Canvas3D.Flip(canvas);
    if (canvas.ShadowSlotsUsed != 7) {
        Say("FAIL B: windowed pass should render 7 slots");
        return;
    }

    // Frame C: render-target frame, mover shifted (all signatures stale) ->
    // every slot must come from ADR 0309 inheritance.
    Canvas3D.SetRenderTarget(canvas, rt);
    drawScene(canvas, cam, ground, pillar, mover, mat);
    if (canvas.ShadowSlotsUsed != 7) {
        Say("FAIL C: inherited frame should still publish 7 slots");
        return;
    }
    if (canvas.ShadowSlotsCached != 7) {
        Say("FAIL C: all 7 slots should inherit, got " + toString(canvas.ShadowSlotsCached));
        return;
    }
    Canvas3D.ResetRenderTarget(canvas);

    // Frame D: same shape with the flag OFF -> the sun slot and every cube
    // face containing the moved caster mismatch their signatures and must
    // re-render (faces the mover never entered may still legitimately reuse);
    // proves frame C's full 7-slot cached count came from inheritance.
    Canvas3D.SetRenderTargetShadowInherit(canvas, 0);
    Canvas3D.SetRenderTarget(canvas, rt);
    drawScene(canvas, cam, ground, pillar, mover, mat);
    if (canvas.ShadowSlotsUsed != 7) {
        Say("FAIL D: flag-off RT frame should render 7 slots");
        return;
    }
    if (canvas.ShadowSlotsCached >= 7) {
        Say("FAIL D: signature reuse alone may not satisfy all 7 slots, got " +
            toString(canvas.ShadowSlotsCached));
        return;
    }
    Canvas3D.ResetRenderTarget(canvas);
    Canvas3D.SetRenderTargetShadowInherit(canvas, 1);

    // Phase 2 (CSM backends): the cascaded primary re-renders per RT camera,
    // only the cube tiles inherit.
    if (Canvas3D.BackendSupports(canvas, "shadow-csm")) {
        Canvas3D.SetShadowCascades(canvas, 2); // also invalidates the cache
        drawScene(canvas, cam, ground, pillar, mover, mat);
        Canvas3D.Flip(canvas);
        if (canvas.ShadowSlotsUsed != 8) {
            Say("FAIL E: 2 cascades + 6 cube faces should render 8 slots, got " + toString(canvas.ShadowSlotsUsed));
            return;
        }
        Canvas3D.SetRenderTarget(canvas, rt);
        drawScene(canvas, cam, ground, pillar, mover, mat);
        if (canvas.ShadowSlotsUsed != 8) {
            Say("FAIL F: cascaded inherit frame should still publish 8 slots");
            return;
        }
        // The 6 cube faces inherit; the near cascade (holding the moved
        // caster) must re-render. The far cascade may legitimately
        // signature-reuse, so cached lands in [6, 8).
        if (canvas.ShadowSlotsCached < 6 || canvas.ShadowSlotsCached >= 8) {
            Say("FAIL F: cubes inherit but at least one cascade re-renders, got " +
                toString(canvas.ShadowSlotsCached));
            return;
        }
        Canvas3D.ResetRenderTarget(canvas);
    }

    Say("PASS");
}
