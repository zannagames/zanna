                                                           "vertexCount + int(vid)) * 3;\n"
                                                           "            float3 delta = "
                                                           "float3(morphNormalDeltas[base + 0],\n"
                                                           "                                  "
                                                           "morphNormalDeltas[base + 1],\n"
                                                           "                                  "
                                                           "morphNormalDeltas[base + 2]);\n"
                                                           "            if (!mainFinite3(delta))\n"
                                                           "                continue;\n"
                                                           "            float3 normalCandidate = "
                                                           "nrm + delta * w;\n"
                                                           "            if "
                                                           "(mainFinite3(normalCandidate))\n"
                                                           "                nrm = "
                                                           "normalCandidate;\n"
                                                           "        }\n"
                                                           "    }\n"
                                                           "    return safeNormalize3(nrm, "
                                                           "float3(0.0, 1.0, 0.0));\n"
                                                           "}\n"
                                                           "\n"
                                                           "uint skinPaletteIndex(uint "
                                                           "paletteBase, uint boneIndex) {\n"
                                                           "    uint safeBase = min(paletteBase, "
                                                           "255u);\n"
                                                           "    uint maxOffset = 255u - safeBase;\n"
                                                           "    if (instanceBoneStride > 0)\n"
                                                           "        maxOffset = min(maxOffset, "
                                                           "(uint)(instanceBoneStride - 1));\n"
                                                           "    return safeBase + min(boneIndex, "
                                                           "maxOffset);\n"
                                                           "}\n"
                                                           "\n"
                                                           "float4 skinPosition(float4 pos, uint4 "
                                                           "boneIdx, float4 boneWt, int "
                                                           "usePrevPalette, uint paletteBase) {\n"
                                                           "    if ((usePrevPalette != 0 && "
                                                           "hasPrevSkinning == 0) || "
                                                           "(usePrevPalette == 0 && hasSkinning "
                                                           "== 0))\n"
                                                           "        return pos;\n"
                                                           "    float4 skinned = float4(0.0, 0.0, "
                                                           "0.0, 0.0);\n"
                                                           "    float totalWeight = 0.0;\n"
                                                           "    for (int i = 0; i < 4; i++) {\n"
                                                           "        float w = boneWt[i];\n"
                                                           "        if (!(w > 0.0001 && w < "
                                                           "1e20))\n"
                                                           "            continue;\n"
                                                           "        uint idx = "
                                                           "skinPaletteIndex(paletteBase, "
                                                           "boneIdx[i]);\n"
                                                           "        row_major float4x4 bm = "
                                                           "usePrevPalette != 0 ? "
                                                           "prevBonePalette[idx] : "
                                                           "bonePalette[idx];\n"
                                                           "        float4 transformed = mul(bm, "
                                                           "pos);\n"
                                                           "        if "
                                                           "(!mainFinite4(transformed))\n"
                                                           "            continue;\n"
                                                           "        float4 skinCandidate = skinned "
                                                           "+ transformed * w;\n"
                                                           "        if "
                                                           "(!mainFinite4(skinCandidate))\n"
                                                           "            continue;\n"
                                                           "        skinned = skinCandidate;\n"
                                                           "        totalWeight += w;\n"
                                                           "    }\n"
                                                           "    return totalWeight > 0.0001 ? "
                                                           "skinned / totalWeight : pos;\n"
                                                           "}\n"
                                                           "\n"
                                                           "float3 skinVector(float3 vec, uint4 "
                                                           "boneIdx, float4 boneWt, uint "
                                                           "paletteBase) {\n"
                                                           "    if (hasSkinning == 0)\n"
                                                           "        return vec;\n"
                                                           "    float3 skinned = float3(0.0, 0.0, "
                                                           "0.0);\n"
                                                           "    float totalWeight = 0.0;\n",
                "    for (int i = 0; i < 4; i++) {\n"
                "        float w = boneWt[i];\n"
                "        if (!(w > 0.0001 && w < 1e20))\n"
                "            continue;\n"
                "        uint idx = skinPaletteIndex(paletteBase, boneIdx[i]);\n"
                "        float3 transformed = mul(bonePalette[idx], float4(vec, 0.0)).xyz;\n"
                "        if (!mainFinite3(transformed))\n"
                "            continue;\n"
                "        float3 skinCandidate = skinned + transformed * w;\n"
                "        if (!mainFinite3(skinCandidate))\n"
                "            continue;\n"
                "        skinned = skinCandidate;\n"
                "        totalWeight += w;\n"
                "    }\n"
                "    return totalWeight > 0.0001 ? skinned / totalWeight : vec;\n"
                "}\n"
                "\n"
                "float4x4 makeMatrixRows(float4 r0, float4 r1, float4 r2, float4 r3) {\n"
                "    return float4x4(r0.x, r0.y, r0.z, r0.w,\n"
                "                    r1.x, r1.y, r1.z, r1.w,\n"
                "                    r2.x, r2.y, r2.z, r2.w,\n"
                "                    r3.x, r3.y, r3.z, r3.w);\n"
                "}\n"
                "\n"
                "PS_INPUT buildOutput(float3 pos,\n"
                "                     float3 prevPos,\n"
                "                     float3 nrm,\n"
                "                     float4 tan,\n"
                "                     float2 uv,\n"
                "                     float2 uv1,\n"
                "                     float4 color,\n"
                "                     row_major float4x4 currentModel,\n"
                "                     row_major float4x4 currentNormal,\n"
                "                     row_major float4x4 prevModel,\n"
                "                     float hasHistory,\n"
                "                     float3 decalCoord,\n"
                "                     float decalFacing) {\n"
                "    PS_INPUT output;\n"
                "    float4 wp = mul(currentModel, float4(pos, 1.0));\n"
                "    float4 prevWp = mul(prevModel, float4(prevPos, 1.0));\n"
                "    float4 currClip = mul(viewProjection, wp);\n"
                "    float4 prevClip = mul(prevViewProjection, prevWp);\n"
                "    output.pos = clipZToBackend(currClip);\n"
                "    output.worldPos = wp.xyz;\n"
                "    output.normal = mul(currentNormal, float4(nrm, 0.0)).xyz;\n"
                "    output.tangent = float4(mul(currentModel, float4(tan.xyz, 0.0)).xyz, tan.w);\n"
                "    output.uv = uv;\n"
                "    output.uv1 = uv1;\n"
                "    output.color = color;\n"
                "    output.currClip = currClip;\n"
                "    output.prevClip = prevClip;\n"
                "    output.hasObjectHistory = hasHistory;\n"
                "    output.decalCoord = decalCoord;\n"
                "    output.decalFacing = decalFacing;\n"
                "    return output;\n"
                "}\n"
                "\n"
                "PS_INPUT VSMain(VS_INPUT input, uint vid : SV_VertexID) {\n"
                "    float3 pos = applyMorphPosition(input.pos, vid, 0);\n"
                "    float3 prevPos = applyMorphPosition(input.pos, vid, hasPrevMorphWeights);\n"
                "    float3 nrm = applyMorphNormal(input.normal, vid, 0);\n"
                "    float4 tan = input.tangent;\n"
                "    float4 skinnedPos = skinPosition(float4(pos, 1.0), input.boneIdx, "
                "input.boneWt, 0, 0u);\n"
                "    float4 prevSkinnedPos = skinPosition(float4(prevPos, 1.0), input.boneIdx, "
                "input.boneWt, "
                "1, 0u);\n"
                "    float3 skinnedNormal = safeNormalize3(skinVector(nrm, input.boneIdx, "
                "input.boneWt, 0u), "
                "float3(0.0, 1.0, 0.0));\n"
                "    float3 skinnedTangent = safeNormalize3(skinVector(tan.xyz, input.boneIdx, "
                "input.boneWt, 0u), "
                "float3(1.0, 0.0, 0.0));\n"
                "    if (hasSkinning == 0) {\n"
                "        skinnedPos = float4(pos, 1.0);\n"
                "        skinnedNormal = safeNormalize3(nrm, float3(0.0, 1.0, 0.0));\n"
                "        skinnedTangent = safeNormalize3(tan.xyz, float3(1.0, 0.0, 0.0));\n"
                "    }\n"
                "    if (hasPrevSkinning == 0)\n"
                "        prevSkinnedPos = float4(prevPos, 1.0);\n"
                "    float4 decalPos = float4(pos, 1.0);\n"
                "    float3 decalCoord = float3(dot(decalRow0, decalPos), dot(decalRow1, decalPos), dot(decalRow2, decalPos));\n"
                "    float decalFacing = dot(nrm, decalParams.xyz);\n"
                "    return buildOutput(skinnedPos.xyz,\n"
                "                       prevSkinnedPos.xyz,\n"
                "                       skinnedNormal,\n"
                "                       float4(skinnedTangent, tan.w),\n"
                "                       input.uv,\n"
                "                       input.uv1,\n"
                "                       input.color,\n"
                "                       modelMatrix,\n",
                "                       normalMatrix,\n"
                "                       hasPrevModelMatrix != 0 ? prevModelMatrix : modelMatrix,\n"
                "                       (hasPrevModelMatrix != 0 || hasPrevSkinning != 0 || "
                "hasPrevMorphWeights != 0) ? 1.0 : 0.0,\n"
"                       decalCoord,\n"
"                       decalFacing);\n"
                "}\n"
                "\n"
                "PS_INPUT VSMainInstanced(VS_INPUT_INSTANCED input, uint vid : SV_VertexID) {\n"
                "    uint skinBase = input.iid * (uint)instanceBoneStride;\n"
                "    float4x4 instModel = makeMatrixRows(input.instanceModel0,\n"
                "                                        input.instanceModel1,\n"
                "                                        input.instanceModel2,\n"
                "                                        input.instanceModel3);\n"
                "    float4x4 instNormal = makeMatrixRows(input.instanceNormal0,\n"
                "                                         input.instanceNormal1,\n"
                "                                         input.instanceNormal2,\n"
                "                                         input.instanceNormal3);\n"
                "    float4x4 prevModel = makeMatrixRows(input.prevModel0,\n"
                "                                        input.prevModel1,\n"
                "                                        input.prevModel2,\n"
                "                                        input.prevModel3);\n"
                "    float3 pos = applyMorphPosition(input.pos, vid, 0);\n"
                "    float3 prevPos = applyMorphPosition(input.pos, vid, hasPrevMorphWeights);\n"
                "    float3 nrm = applyMorphNormal(input.normal, vid, 0);\n"
                "    float4 tan = input.tangent;\n"
                "    float4 skinnedPos = skinPosition(float4(pos, 1.0), input.boneIdx, "
                "input.boneWt, 0, skinBase);\n"
                "    float4 prevSkinnedPos = skinPosition(float4(prevPos, 1.0), input.boneIdx, "
                "input.boneWt, "
                "1, skinBase);\n"
                "    float3 skinnedNormal = safeNormalize3(skinVector(nrm, input.boneIdx, "
                "input.boneWt, skinBase), "
                "float3(0.0, 1.0, 0.0));\n"
                "    float3 skinnedTangent = safeNormalize3(skinVector(tan.xyz, input.boneIdx, "
                "input.boneWt, skinBase), "
                "float3(1.0, 0.0, 0.0));\n"
                "    if (hasSkinning == 0) {\n"
                "        skinnedPos = float4(pos, 1.0);\n"
                "        skinnedNormal = safeNormalize3(nrm, float3(0.0, 1.0, 0.0));\n"
                "        skinnedTangent = safeNormalize3(tan.xyz, float3(1.0, 0.0, 0.0));\n"
                "    }\n"
                "    if (hasPrevSkinning == 0)\n"
                "        prevSkinnedPos = float4(prevPos, 1.0);\n"
                "    float4 decalPos = float4(pos, 1.0);\n"
                "    float3 decalCoord = float3(dot(decalRow0, decalPos), dot(decalRow1, decalPos), dot(decalRow2, decalPos));\n"
                "    float decalFacing = dot(nrm, decalParams.xyz);\n"
                "    return buildOutput(skinnedPos.xyz,\n"
                "                       prevSkinnedPos.xyz,\n"
                "                       skinnedNormal,\n"
                "                       float4(skinnedTangent, tan.w),\n"
                "                       input.uv,\n"
                "                       input.uv1,\n"
                "                       input.color,\n"
                "                       instModel,\n"
                "                       instNormal,\n"
                "                       hasPrevInstanceMatrices != 0 ? prevModel : instModel,\n"
                "                       (hasPrevInstanceMatrices != 0 || hasPrevSkinning != 0 || "
                "hasPrevMorphWeights != 0) ? 1.0 : 0.0,\n"
"                       decalCoord,\n"
"                       decalFacing);\n"
                "}\n"
                "\n"
                "PS_INPUT VSMainParticles(VS_INPUT_PARTICLE input) {\n"
                "    PS_INPUT output;\n"
                "    float3 world = input.particleCenter.xyz + input.particleRight.xyz * "
                "input.pos.x + "
                "input.particleUp.xyz * input.pos.y;\n"
                "    float3 particleNormal = safeNormalize3(cross(input.particleRight.xyz, "
                "input.particleUp.xyz), float3(0.0, 0.0, 1.0));\n"
                "    float3 particleTangent = safeNormalize3(input.particleRight.xyz, float3(1.0, "
                "0.0, "
                "0.0));\n"
                "    float4 currClip = mul(viewProjection, float4(world, 1.0));\n"
                "    output.pos = clipZToBackend(currClip);\n"
                "    output.worldPos = world;\n"
                "    output.normal = particleNormal;\n"
                "    output.tangent = float4(particleTangent, 1.0);\n"
                "    output.uv = input.uv;\n"
                "    output.uv1 = input.uv1;\n"
                "    output.color = input.color * input.particleColor;\n"
                "    output.currClip = currClip;\n"
                "    output.decalCoord = float3(0.0, 0.0, 0.0);\n"
                "    output.decalFacing = 1.0;\n"
                "    output.prevClip = mul(prevViewProjection, float4(world, 1.0));\n"
                "    output.hasObjectHistory = 0.0;\n"
                "    return output;\n"
                "}\n"
                "\n"
                "static const int kShadowCsmSlots = " VGFX3D_STR(
                    VGFX3D_CSM_SLOTS) ";\n"
                                      "static const "
                                      "int "
                                      "kShadowAtlasCol"
                                      "umns "
                                      "= " VGFX3D_STR(
                                          VGFX3D_D3D11_SHADOW_ATLAS_COLUMNS) ";\n"
                                                                             "static const int "
                                                                             "kShadowAtlasRows "
                                                                             "= " VGFX3D_STR(VGFX3D_D3D11_SHADOW_ATLAS_ROWS) ";\n"
                                                                                                                             "static const int kShadowProjectionCube = " VGFX3D_STR(
                                                                                                                                 VGFX3D_SHADOW_PROJECTION_CUBE) ";\n"
                                                                                                                                                                "\n"
                                                                                                                                                                "int resolveShadowCascade(Light light, float3 worldPos) {\n"
                                                                                                                                                                "    int shadowIndex = light.shadowIndex;\n"
                                                                                                                                                                "    if (shadowIndex >= 0 && light.shadowProjectionType == kShadowProjectionCube) {\n"
                                                                                                                                                                "        float3 d = worldPos - light.position.xyz;\n"
                                                                                                                                                                "        float3 a = abs(d);\n"
                                                                                                                                                                "        int face = (a.x >= a.y && a.x >= a.z) ? (d.x >= 0.0 ? 0 : 1)\n"
                                                                                                                                                                "                   : (a.y >= a.z ? (d.y >= 0.0 ? 2 : 3) : (d.z >= 0.0 ? 4 : 5));\n"
                                                                                                                                                                "        shadowIndex += face;\n"
                                                                                                                                                                "        return shadowIndex >= 0 && shadowIndex < shadowCount ? shadowIndex : -1;\n"
                                                                                                                                                                "    }\n"
                                                                                                                                                                "    if (shadowIndex < 0 || shadowIndex >= shadowCount)\n"
                                                                                                                                                                "        return -1;\n"
                                                                                                                                                                "    int cascadeCount = clamp(light.shadowCascadeCount, 1, kShadowCsmSlots);\n"
                                                                                                                                                                "    cascadeCount = min(cascadeCount, shadowCount - shadowIndex);\n"
                                                                                                                                                                "    if (cascadeCount <= 1)\n"
                                                                                                                                                                "        return shadowIndex;\n"
                                                                                                                                                                "    float viewDepth = dot(worldPos - cameraPosition.xyz, cameraForward.xyz);\n"
                                                                                                                                                                "    if (viewDepth <= light.shadowCascadeSplits.x || cascadeCount == 1)\n"
                                                                                                                                                                "        return shadowIndex;\n"
                                                                                                                                                                "    if (viewDepth <= light.shadowCascadeSplits.y || cascadeCount == 2)\n"
                                                                                                                                                                "        return shadowIndex + 1;\n"
                                                                                                                                                                "    if (viewDepth <= light.shadowCascadeSplits.z || cascadeCount == 3)\n"
                                                                                                                                                                "        return shadowIndex + 2;\n"
                                                                                                                                                                "    return shadowIndex + 3;\n"
                                                                                                                                                                "}\n"
                                                                                                                                                                "\n"
                                                                                                                                                                "float sampleShadowAt(int shadowIndex, float2 uv, float depth, float bias) {\n"
                                                                                                                                                                "    float result = 1.0;\n"
                                                                                                                                                                "    if (shadowIndex >= kShadowCsmSlots) {\n"
                                                                                                                                                                "        int tile = shadowIndex - kShadowCsmSlots;\n"
                                                                                                                                                                "        uint atlasWidth;\n"
                                                                                                                                                                "        uint atlasHeight;\n"
                                                                                                                                                                "        shadowAtlas.GetDimensions(atlasWidth, atlasHeight);\n"
                                                                                                                                                                "        float2 tileScale = 1.0 / float2(kShadowAtlasColumns, kShadowAtlasRows);\n"
                                                                                                                                                                "        float2 tileSize = max(float2(atlasWidth, atlasHeight) * tileScale,\n"
                                                                                                                                                                "                              float2(1.0, 1.0));\n"
                                                                                                                                                                "        float2 halfTexel = 0.5 / tileSize;\n"
                                                                                                                                                                "        float2 localUv = clamp(uv, halfTexel, 1.0 - halfTexel);\n"
                                                                                                                                                                "        float2 tileOrigin = float2(float(tile % kShadowAtlasColumns),\n"
                                                                                                                                                                "                                   float(tile / kShadowAtlasColumns)) * tileScale;\n"
                                                                                                                                                                "        float2 auv = tileOrigin + localUv * tileScale;\n"
                                                                                                                                                                "        result = shadowAtlas.SampleCmpLevelZero(shadowSampler, auv, depth - bias);\n"
                                                                                                                                                                "    } else if (shadowIndex == 0) {\n"
                                                                                                                                                                "        result = shadowTex0.SampleCmpLevelZero(shadowSampler, uv, depth - bias);\n"
                                                                                                                                                                "    } else if (shadowIndex == 1) {\n"
                                                                                                                                                                "        result = shadowTex1.SampleCmpLevelZero(shadowSampler, uv, depth - bias);\n"
                                                                                                                                                                "    } else if (shadowIndex == 2) {\n"
                                                                                                                                                                "        result = shadowTex2.SampleCmpLevelZero(shadowSampler, uv, depth - bias);\n"
                                                                                                                                                                "    } else {\n"
                                                                                                                                                                "        result = shadowTex3.SampleCmpLevelZero(shadowSampler, uv, depth - bias);\n"
                                                                                                                                                                "    }\n"
                                                                                                                                                                "    return result;\n"
                                                                                                                                                                "}\n"
                                                                                                                                                                "\n"
                                                                                                                                                                /* Plan 06: 16-point Poisson disk, deterministic dart-throwing (64-bit LCG,
                                                                                                                                                                 * seed 80, min separation 0.4369) — matches the GLSL/MSL twins. Tap subsets
                                                                                                                                                                 * stride the table so 4/8-tap tiers stay well-distributed. */
                                                                                                                                                                "static const float2 kShadowPoisson[16] = {\n"
                                                                                                                                                                "    float2(0.482408, 0.345286), float2(0.079872, 0.641222),\n"
                                                                                                                                                                "    float2(-0.211339, -0.305133), float2(0.485624, -0.638176),\n"
                                                                                                                                                                "    float2(-0.197270, 0.252333), float2(-0.823845, 0.551135),\n"
                                                                                                                                                                "    float2(-0.333578, 0.886038), float2(0.835697, 0.028104),\n"
                                                                                                                                                                "    float2(-0.921729, -0.289255), float2(-0.184344, -0.769094),\n"
                                                                                                                                                                "    float2(0.449912, -0.195238), float2(0.534685, 0.795828),\n"
                                                                                                                                                                "    float2(-0.661694, -0.644587), float2(-0.599728, 0.062200),\n"
                                                                                                                                                                "    float2(0.899330, -0.413558), float2(0.200012, -0.976846)};\n"
                                                                                                                                                                "\n"
                                                                                                                                                                /* Plan 06 sampling model: normal-offset the receiver ~1.5 shadow texels
                                                                                                                                                                 * (world units, ortho slots; derived from the shadow VP row lengths so far
                                                                                                                                                                 * cascades offset proportionally), add a slope-proportional per-texel
                                                                                                                                                                 * compare bias, and filter with a rotated-Poisson PCF over the hardware
                                                                                                                                                                 * comparison sampler. shadowFilter carries the knobs (x = slope-bias
                                                                                                                                                                 * factor, y = strength, z = tap count). */
                                                                                                                                                                "float sampleShadowCascade(Light light, int shadowIndex, float3 worldPos,\n"
                                                                                                                                                                "                          float3 N, float3 L, float2 fragXY) {\n"
                                                                                                                                                                "    row_major float4x4 shadowMatrix = shadowVP[shadowIndex];\n"
                                                                                                                                                                "    float2 mapSize;\n"
                                                                                                                                                                "    if (shadowIndex >= kShadowCsmSlots) {\n"
                                                                                                                                                                "        uint atlasWidth;\n"
                                                                                                                                                                "        uint atlasHeight;\n"
                                                                                                                                                                "        shadowAtlas.GetDimensions(atlasWidth, atlasHeight);\n"
                                                                                                                                                                "        mapSize = float2(atlasWidth, atlasHeight) /\n"
                                                                                                                                                                "                  float2(kShadowAtlasColumns, kShadowAtlasRows);\n"
                                                                                                                                                                "    }\n"
                                                                                                                                                                "    else if (shadowIndex == 0) shadowTex0.GetDimensions(mapSize.x, mapSize.y);\n"
                                                                                                                                                                "    else if (shadowIndex == 1) shadowTex1.GetDimensions(mapSize.x, mapSize.y);\n",
                "    else if (shadowIndex == 2) shadowTex2.GetDimensions(mapSize.x, mapSize.y);\n"
                "    else shadowTex3.GetDimensions(mapSize.x, mapSize.y);\n"
                "    float2 texel = 1.0 / max(mapSize, float2(1.0, 1.0));\n"
                "    float texelWorld = 0.0;\n"
                "    float depthScale = 0.0;\n"
                "    if (light.shadowProjectionType == 0) {\n"
                "        float3 row0 = float3(shadowMatrix[0][0], shadowMatrix[0][1], "
                "shadowMatrix[0][2]);\n"
                "        float3 row2 = float3(shadowMatrix[2][0], shadowMatrix[2][1], "
                "shadowMatrix[2][2]);\n"
                "        float l0 = length(row0);\n"
                "        float l2 = length(row2);\n"
                "        texelWorld = (l0 > 1e-9) ? 2.0 * texel.x / l0 : 0.0;\n"
                "        depthScale = 0.5 * l2;\n"
                "    }\n"
                "    float3 samplePos = worldPos + N * (texelWorld * 1.5);\n"
                "    float4 lc = mul(shadowMatrix, float4(samplePos, 1.0));\n"
                "    if (!mainFinite4(lc) || (light.shadowProjectionType != 0 &&\n"
                "        !(lc.w > 0.0001 && lc.w < 1e20)))\n"
                "        return 1.0;\n"
                "    float3 ndc = light.shadowProjectionType != 0 ? lc.xyz / lc.w : lc.xyz;\n"
                "    if (!mainFinite3(ndc))\n"
                "        return 1.0;\n"
                "    float2 uv = ndcToTextureUv(ndc.xy);\n"
                "    float depth = ndc.z * 0.5 + 0.5;\n"
                "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || depth < 0.0 || "
                "depth > 1.0)\n"
                "        return 1.0;\n"
                "    float ndl = clamp(dot(N, L), 0.05, 1.0);\n"
                "    float slope = sqrt(max(1.0 - ndl * ndl, 0.0)) / ndl;\n"
                "    float bias = shadowBias + shadowFilter.x * min(slope, 8.0) * texelWorld * "
                "depthScale;\n"
                "    float ign = frac(52.9829189 * frac(0.06711056 * fragXY.x + 0.00583715 * "
                "fragXY.y));\n"
                "    float ca = cos(6.2831853 * ign);\n"
                "    float sa = sin(6.2831853 * ign);\n"
                "    int taps = clamp((int)shadowFilter.z, 4, 16);\n"
                "    int stride = 16 / taps;\n"
                "    float lit = 0.0;\n"
                "    for (int i = 0; i < taps; i++) {\n"
                "        float2 p = kShadowPoisson[i * stride];\n"
                "        float2 o = float2(p.x * ca - p.y * sa, p.x * sa + p.y * ca) * texel * "
                "1.5;\n"
                "        float s = sampleShadowAt(shadowIndex, uv + o, depth, bias);\n"
                "        lit += (s == s) ? saturate(s) : 1.0;\n"
                "    }\n"
                "    return lit / (float)taps;\n"
