    "float2 ndcDeltaToUvDelta(float2 delta) { return float2(delta.x * 0.5, -delta.y * 0.5); }\n"
    "bool reconstructWorld(float2 uv, float depth, out float3 worldOut) {\n"
    "    float4 clip = float4(uvToNdc(uv), depth * 2.0 - 1.0, 1.0);\n"
    "    float4 world = mul(invViewProjection, clip);\n"
    "    worldOut = float3(0.0, 0.0, 0.0);\n"
    "    if (!postFinite4(world) || !(abs(world.w) > 0.0001 && abs(world.w) < 1e20))\n"
    "        return false;\n"
    "    worldOut = world.xyz / world.w;\n"
    "    return postFinite3(worldOut);\n"
    "}\n"
    /* Plan 05: normal-aware hemispheric SSAO with a range check (see the GLSL/MSL
     * twins). Normals come from screen-space derivatives of the reconstructed position;
     * a golden-angle spiral rotated by interleaved-gradient noise replaces the fixed
     * ring; the smoothstep range check kills the depth-only halo around silhouettes. */
    "float computeSSAO(float2 uv, float depth) {\n"
    "    if (ssaoEnabled == 0)\n"
    "        return 1.0;\n"
    /* Reversed-Z: cleared/far depth is 0, so the sky guard tests the low end. */
    "    if (depth <= 0.0001)\n"
    "        return 1.0;\n"
    "    float3 P;\n"
    "    if (!reconstructWorld(uv, depth, P))\n"
    "        return 1.0;\n"
    "    float3 N = cross(ddx(P), ddy(P));\n"
    "    float nlen2 = dot(N, N);\n"
    "    if (!(nlen2 > 1e-12 && nlen2 < 1e20))\n"
    "        return 1.0;\n"
    "    N *= rsqrt(nlen2);\n"
    "    float3 V = cameraPosition.xyz - P;\n"
    "    float dist2 = dot(V, V);\n"
    "    if (!(dist2 > 1e-8 && dist2 < 1e20))\n"
    "        return 1.0;\n"
    "    float dist = sqrt(dist2);\n"
    "    if (dot(N, V / dist) < 0.0)\n"
    "        N = -N;\n"
    "    float radius = max(ssaoRadius, 0.01);\n"
    "    float screenRadius = clamp(radius / dist * 0.5, 0.002, 0.05);\n"
    "    int taps = clamp(ssaoSamples, 4, 16);\n"
    "    float2 px = uv / max(invResolution, float2(1e-6, 1e-6));\n"
    "    float ign = frac(52.9829189 * frac(0.06711056 * px.x + 0.00583715 * px.y));\n"
    "    float occ = 0.0;\n",
    "    float wsum = 0.0;\n"
    "    for (int i = 0; i < taps; i++) {\n"
    "        float ang = ((float)i + ign) * 2.39996323;\n"
    "        float rad = screenRadius * sqrt(((float)i + 0.5) / (float)taps);\n"
    "        float2 suv = uv + float2(cos(ang), sin(ang)) * rad;\n"
    "        float sd = depthAt(suv);\n"
    "        float3 Ps;\n"
    "        if (!reconstructWorld(suv, sd, Ps))\n"
    "            continue;\n"
    "        float3 d = Ps - P;\n"
    "        float dl2 = dot(d, d);\n"
    "        if (!(dl2 > 1e-12 && dl2 < 1e20))\n"
    "            continue;\n"
    "        float dl = sqrt(dl2);\n"
    "        float rangeCheck = 1.0 - smoothstep(0.0, 1.0, dl / radius);\n"
    "        occ += max(dot(N, d / dl) - 0.025, 0.0) * rangeCheck;\n"
    "        wsum += 1.0;\n"
    "    }\n"
    "    return 1.0 - saturate(occ / max(wsum, 1.0) * ssaoIntensity * 2.0);\n"
    "}\n"
    "float2 cameraVelocity(float2 uv, float depth) {\n"
    "    float3 worldPos;\n"
    "    if (!reconstructWorld(uv, depth, worldPos))\n"
    "        return float2(0.0, 0.0);\n"
    "    float4 prevClip = mul(prevViewProjection, float4(worldPos, 1.0));\n"
    "    if (!postFinite4(prevClip) || !(abs(prevClip.w) > 0.0001 && abs(prevClip.w) < 1e20))\n"
    "        return float2(0.0, 0.0);\n"
    "    float2 prevNdc = prevClip.xy / prevClip.w;\n"
    "    float2 currNdc = uvToNdc(uv);\n"
    "    float2 velocity = ndcDeltaToUvDelta(currNdc - prevNdc);\n"
    "    return postFinite2(velocity) ? velocity : float2(0.0, 0.0);\n"
    "}\n"
    "float3 applyMotionBlur(float2 uv, float depth, float3 color) {\n"
    "    if (motionBlurEnabled == 0)\n"
    "        return color;\n"
    "    float4 motion = motionTex.Sample(postSampler, uv);\n"
    "    if (!postFinite4(motion))\n"
    "        return color;\n"
    "    float2 velocity = motion.xy * 2.0 - 1.0;\n"
    "    if (motion.z < 0.5)\n"
    "        velocity = cameraVelocity(uv, depth);\n"
    "    velocity *= motionBlurIntensity;\n"
    "    if (!postFinite2(velocity))\n"
    "        return color;\n"
    "    if (length(velocity) < 0.0005)\n"
    "        return color;\n"
    "    int taps = clamp(motionBlurSamples, 2, 8);\n"
    "    float3 accum = float3(0.0, 0.0, 0.0);\n"
    "    for (int i = 0; i < taps; i++) {\n"
    "        float t = ((float)i / (float)(taps - 1)) - 0.5;\n"
    "        accum += sceneAt(uv + velocity * t);\n"
    "    }\n"
    "    return accum / (float)taps;\n"
    "}\n"
    "float3 applyDOF(float2 uv, float depth, float3 color) {\n"
    "    if (dofEnabled == 0)\n"
    "        return color;\n"
    "    float3 worldPos;\n"
    "    if (!reconstructWorld(uv, depth, worldPos))\n"
    "        return color;\n"
    "    float dist = length(worldPos - cameraPosition.xyz);\n"
    "    float blur = clamp(abs(dist - dofFocusDistance) * max(dofAperture, 0.0) * 0.02, 0.0, "
    "max(dofMaxBlur, 0.0));\n"
    "    if (blur < 0.001)\n"
    "        return color;\n"
    "    float2 radius = invResolution * blur;\n"
    "    float3 accum = color * 0.4;\n"
    "    accum += sceneAt(uv + float2(radius.x, 0.0)) * 0.15;\n"
    "    accum += sceneAt(uv + float2(-radius.x, 0.0)) * 0.15;\n"
    "    accum += sceneAt(uv + float2(0.0, radius.y)) * 0.15;\n"
    "    accum += sceneAt(uv + float2(0.0, -radius.y)) * 0.15;\n"
    "    return accum;\n"
    "}\n"
    "float3 applyBloom(float2 uv, float3 color) {\n"
    "    if (bloomEnabled == 0)\n"
    "        return color;\n"
    "    if (bloomTexEnabled != 0)\n"
    "        return color + bloomTex.Sample(postSampler, uv).rgb * bloomIntensity;\n"
    "    float2 bloomStep = invResolution * (float)clamp(bloomPasses, 0, 32);\n"
    "    float3 bloom = max(color - float3(bloomThreshold, bloomThreshold, bloomThreshold), "
    "float3(0.0, 0.0, 0.0));\n"
    "    bloom += max(sceneAt(uv + float2(bloomStep.x, 0.0)) - float3(bloomThreshold, "
    "bloomThreshold, bloomThreshold), float3(0.0, 0.0, 0.0));\n"
    "    bloom += max(sceneAt(uv + float2(-bloomStep.x, 0.0)) - float3(bloomThreshold, "
    "bloomThreshold, bloomThreshold), float3(0.0, 0.0, 0.0));\n",
    "    bloom += max(sceneAt(uv + float2(0.0, bloomStep.y)) - float3(bloomThreshold, "
    "bloomThreshold, bloomThreshold), float3(0.0, 0.0, 0.0));\n"
    "    bloom += max(sceneAt(uv + float2(0.0, -bloomStep.y)) - float3(bloomThreshold, "
    "bloomThreshold, bloomThreshold), float3(0.0, 0.0, 0.0));\n"
    "    return color + bloom * (bloomIntensity / 5.0);\n"
    "}\n"
    "float3 tonemap(float3 color) {\n"
    /* Plan 05 gamma fix: explicit mode-0 tonemap on the linear-HDR scene target applies
     * exposure + gamma-out so its output transform matches modes 1/2. */
    "    if (tonemapMode == 0 && tonemapExplicit != 0 && sceneIsHdr != 0)\n"
    "        return pow(saturate(color * tonemapExposure), 1.0 / 2.2);\n"
    "    if (tonemapMode != 1 && tonemapMode != 2)\n"
    "        return color;\n"
    "    color = max(color * tonemapExposure, float3(0.0, 0.0, 0.0));\n"
    "    if (tonemapMode == 1)\n"
    "        return pow(saturate(color / (1.0 + color)), 1.0 / 2.2);\n"
    "    if (tonemapMode == 2) {\n"
    "        float a = 2.51;\n"
    "        float b = 0.03;\n"
    "        float c = 2.43;\n"
    "        float d = 0.59;\n"
    "        float e = 0.14;\n"
    "        color = saturate((color * (a * color + b)) / (color * (c * color + d) + e));\n"
    "        return pow(color, 1.0 / 2.2);\n"
    "    }\n"
    "    return color;\n"
    "}\n"
    "float3 applyColorGrade(float3 color) {\n"
    "    if (colorGradeEnabled == 0)\n"
    "        return color;\n"
    "    color = (color - 0.5) * cgContrast + 0.5;\n"
    "    color += cgBrightness;\n"
    "    float l = gradeLuma(color);\n"
    "    return saturate(lerp(float3(l, l, l), color, cgSaturation));\n"
    "}\n"
    /* Plan 61: 3D LUT grade from the 256x16 strip (16 tiles of 16x16: x = red,
     * y = green, tile = blue), 8-corner trilinear via Load — replicates the
     * CPU reference sampler (rt_postfx3d apply_color_lut_cpu). */
    "float3 applyColorLut(float3 color) {\n"
    "    if (lutEnabled == 0)\n"
    "        return color;\n"
    "    float3 lc = saturate(color) * 15.0;\n"
    "    int3 l0 = int3(lc);\n"
    "    int3 l1 = min(l0 + int3(1, 1, 1), int3(15, 15, 15));\n"
    "    float3 lt = lc - float3(l0);\n"
    "    float3 acc = float3(0.0, 0.0, 0.0);\n"
    "    for (int corner = 0; corner < 8; corner++) {\n"
    "        int rr = (corner & 1) != 0 ? l1.x : l0.x;\n"
    "        int gg = (corner & 2) != 0 ? l1.y : l0.y;\n"
    "        int bb = (corner & 4) != 0 ? l1.z : l0.z;\n"
    "        float wgt = ((corner & 1) != 0 ? lt.x : 1.0 - lt.x) *\n"
    "                    ((corner & 2) != 0 ? lt.y : 1.0 - lt.y) *\n"
    "                    ((corner & 4) != 0 ? lt.z : 1.0 - lt.z);\n"
    "        acc += wgt * lutTex.Load(int3(bb * 16 + rr, gg, 0)).rgb;\n"
    "    }\n"
    "    return lerp(color, acc, lutBlend);\n"
    "}\n"
    /* Plan 61 / ADR 0271: clamped unsharp mask — edge gain bounded by the local
     * 5-tap min/max so no ringing halos. Per-pass authoring: a sharpen entry
     * runs alone, so color equals the pass source here. */
    "float3 applySharpen(float2 uv, float3 color) {\n"
    "    if (sharpenEnabled == 0)\n"
    "        return color;\n"
    "    float3 shN = sceneAt(uv + float2(0.0, -invResolution.y));\n"
    "    float3 shS = sceneAt(uv + float2(0.0, invResolution.y));\n"
    "    float3 shE = sceneAt(uv + float2(invResolution.x, 0.0));\n"
    "    float3 shW = sceneAt(uv + float2(-invResolution.x, 0.0));\n"
    "    float3 shLo = min(color, min(min(shN, shS), min(shE, shW)));\n"
    "    float3 shHi = max(color, max(max(shN, shS), max(shE, shW)));\n"
    "    return clamp(color + sharpenAmount * (color - (shN + shS + shE + shW) * 0.25),\n"
    "                 shLo, shHi);\n"
    "}\n"
    "float3 applyVignette(float2 uv, float3 color) {\n"
    "    if (vignetteEnabled == 0)\n"
    "        return color;\n"
    /* Pixel-space distance over the half-diagonal so the falloff is radial at
     * any aspect ratio (matches the CPU reference). */
    "    float2 vres = 1.0 / max(invResolution, float2(0.000001, 0.000001));\n"
    "    float2 centered = (uv - 0.5) * vres;\n"
    "    float dist = length(centered) / max(0.5 * length(vres), 0.000001);\n"
    "    float vig = 1.0;\n"
    "    if (dist > vignetteRadius)\n"
    "        vig = 1.0 - saturate((dist - vignetteRadius) / max(vignetteSoftness, 0.000001));\n"
    "    return color * vig;\n"
    "}\n"
    "float3 applyFXAA(float2 uv, float3 color) {\n"
    "    if (fxaaEnabled == 0)\n"
    "        return color;\n"
    "    float3 n = sceneAt(uv + float2(0.0, -invResolution.y));\n"
    "    float3 s = sceneAt(uv + float2(0.0, invResolution.y));\n"
    "    float3 e = sceneAt(uv + float2(invResolution.x, 0.0));\n"
    "    float3 w = sceneAt(uv + float2(-invResolution.x, 0.0));\n"
    "    float lumaM = luminance(color);\n"
    "    float edge = abs(luminance(n) + luminance(s) - 2.0 * lumaM) +\n"
    "                 abs(luminance(e) + luminance(w) - 2.0 * lumaM);\n"
    "    if (edge < 0.08)\n"
    "        return color;\n"
    "    return lerp(color, (n + s + e + w) * 0.25, 0.5);\n"
    "}\n"
    "float4 PSPostFX(VS_OUTPUT input) : SV_Target {\n"
    "    float depth = depthAt(input.uv);\n"
    "    float3 sourceColor = sceneAt(input.uv);\n"
    "    if (any(isnan(sourceColor)) || any(isinf(sourceColor)))\n"
    "        sourceColor = float3(0.0, 0.0, 0.0);\n"
    "    float3 color = sourceColor;\n"
    "    color = applyMotionBlur(input.uv, depth, color);\n"
    "    color = applyDOF(input.uv, depth, color);\n"
    "    color *= computeSSAO(input.uv, depth);\n"
    "    color = applyFXAA(input.uv, color);\n"
    "    color = applyBloom(input.uv, color);\n"
    "    color = tonemap(color);\n"
    "    color = applyColorGrade(color);\n"
    "    color = applyColorLut(color);\n"
    "    color = applySharpen(input.uv, color);\n"
    "    color = applyVignette(input.uv, color);\n"
    "    if (any(isnan(color)) || any(isinf(color)))\n"
    "        color = sourceColor;\n"
    "    return float4(saturate(color), 1.0);\n"
    "}\n"
    "float4 PSOverlayComposite(VS_OUTPUT input) : SV_Target {\n"
    "    return overlayTex.Sample(postSampler, input.uv);\n"
    "}\n",
};

static void *volatile d3d11_postfx_shader_source_cache;

/// @brief Return the lazily assembled general post-processing and overlay HLSL source.
/// @return Process-lifetime immutable shader source, or `NULL` if assembly fails.
static const char *d3d11_postfx_shader_source_get(void) {
    return d3d11_join_shader_chunks(&d3d11_postfx_shader_source_cache,
                                    d3d11_postfx_shader_source_chunks,
                                    sizeof(d3d11_postfx_shader_source_chunks) /
                                        sizeof(d3d11_postfx_shader_source_chunks[0]));
}

#define d3d11_postfx_shader_source d3d11_postfx_shader_source_get()


/* Plan 05: mip-chain bloom passes — 13-tap downsample (Karis average + soft-knee
 * threshold on the first pass) and 3x3 tent upsample (accumulated additively via the
 * existing additive blend state). Shares vs_postfx's fullscreen triangle. */
static const char *const d3d11_bloom_shader_source_chunks[] = {
    "cbuffer BloomCB : register(b0) {\n"
    "    float2 srcInvSize;\n"
    "    float threshold;\n"
    "    int firstPass;\n"
    "};\n"
    "Texture2D srcTex : register(t0);\n"
    "SamplerState postSampler : register(s0);\n"
    "struct VS_OUTPUT {\n"
    "    float4 pos : SV_POSITION;\n"
    "    float2 uv : TEXCOORD0;\n"
    "};\n"
    "bool bloomFinite3(float3 v) { return !any(isnan(v)) && !any(isinf(v)); }\n"
    "float3 bloomSafeColor(float3 c) {\n"
    "    return bloomFinite3(c) ? clamp(c, 0.0, 65504.0) : float3(0.0, 0.0, 0.0);\n"
    "}\n"
    "float bloomLuma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }\n"
    "float3 bloomKaris(float3 c) {\n"
    "    c = bloomSafeColor(c);\n"
    "    return c / (1.0 + max(bloomLuma(c), 0.0));\n"
    "}\n"
    "float3 srcAt(float2 uv) { return bloomSafeColor(srcTex.Sample(postSampler, uv).rgb); }\n"
    "float4 PSBloomDown(VS_OUTPUT input) : SV_Target {\n"
    "    float2 uv = input.uv;\n"
    "    float2 ts = srcInvSize;\n"
    "    float3 a = srcAt(uv + ts * float2(-2.0, -2.0));\n"
    "    float3 b = srcAt(uv + ts * float2(0.0, -2.0));\n"
    "    float3 c = srcAt(uv + ts * float2(2.0, -2.0));\n"
    "    float3 d = srcAt(uv + ts * float2(-2.0, 0.0));\n"
    "    float3 e = srcAt(uv);\n"
    "    float3 f = srcAt(uv + ts * float2(2.0, 0.0));\n"
    "    float3 g = srcAt(uv + ts * float2(-2.0, 2.0));\n"
    "    float3 h = srcAt(uv + ts * float2(0.0, 2.0));\n"
    "    float3 i2 = srcAt(uv + ts * float2(2.0, 2.0));\n"
    "    float3 j = srcAt(uv + ts * float2(-1.0, -1.0));\n"
    "    float3 k = srcAt(uv + ts * float2(1.0, -1.0));\n"
    "    float3 l = srcAt(uv + ts * float2(-1.0, 1.0));\n"
    "    float3 m = srcAt(uv + ts * float2(1.0, 1.0));\n"
    "    float3 col;\n"
    "    if (firstPass != 0) {\n"
    "        col = bloomKaris((j + k + l + m) * 0.25) * 0.5;\n"
    "        col += bloomKaris((a + b + d + e) * 0.25) * 0.125;\n"
    "        col += bloomKaris((b + c + e + f) * 0.25) * 0.125;\n"
    "        col += bloomKaris((d + e + g + h) * 0.25) * 0.125;\n"
    "        col += bloomKaris((e + f + h + i2) * 0.25) * 0.125;\n"
    "        float lum = bloomLuma(col);\n"
    "        float scale = (lum > threshold) ? (lum - threshold) / (lum + 1e-6) : 0.0;\n"
    "        col *= scale;\n"
    "    } else {\n"
    "        col = (j + k + l + m) * (0.5 * 0.25);\n"
    "        col += (a + b + d + e) * (0.125 * 0.25);\n"
    "        col += (b + c + e + f) * (0.125 * 0.25);\n"
    "        col += (d + e + g + h) * (0.125 * 0.25);\n"
    "        col += (e + f + h + i2) * (0.125 * 0.25);\n"
    "    }\n"
    "    return float4(bloomSafeColor(col), 1.0);\n"
    "}\n"
    "float4 PSBloomUp(VS_OUTPUT input) : SV_Target {\n"
    "    float2 uv = input.uv;\n"
    "    float2 ts = srcInvSize;\n"
    "    float3 col = srcAt(uv + ts * float2(-1.0, -1.0));\n"
    "    col += srcAt(uv + ts * float2(0.0, -1.0)) * 2.0;\n"
    "    col += srcAt(uv + ts * float2(1.0, -1.0));\n"
    "    col += srcAt(uv + ts * float2(-1.0, 0.0)) * 2.0;\n"
    "    col += srcAt(uv) * 4.0;\n"
    "    col += srcAt(uv + ts * float2(1.0, 0.0)) * 2.0;\n"
    "    col += srcAt(uv + ts * float2(-1.0, 1.0));\n"
    "    col += srcAt(uv + ts * float2(0.0, 1.0)) * 2.0;\n"
    "    col += srcAt(uv + ts * float2(1.0, 1.0));\n"
    "    return float4(bloomSafeColor(col * (1.0 / 16.0)), 1.0);\n"
    "}\n",
};

static void *volatile d3d11_bloom_shader_source_cache;

/// @brief Return the lazily assembled bloom downsample and upsample HLSL source.
/// @return Process-lifetime immutable shader source, or `NULL` if assembly fails.
static const char *d3d11_bloom_shader_source_get(void) {
    return d3d11_join_shader_chunks(&d3d11_bloom_shader_source_cache,
                                    d3d11_bloom_shader_source_chunks,
                                    sizeof(d3d11_bloom_shader_source_chunks) /
                                        sizeof(d3d11_bloom_shader_source_chunks[0]));
}

