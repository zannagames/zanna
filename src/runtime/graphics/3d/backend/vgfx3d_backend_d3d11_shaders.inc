/* Plan 05: TAA resolve — reproject the persistent history through per-pixel velocity
 * (rasterized motion when flagged, analytic camera reprojection otherwise), clamp it to
 * the current frame's 3x3 neighborhood, and blend. Motion vectors are rendered under
 * projection jitter, so the current-minus-previous jitter delta is subtracted first. */
static const char *const d3d11_taa_shader_source_chunks[] = {
    "cbuffer TAACB : register(b0) {\n"
    "    row_major float4x4 invViewProjection;\n"
    "    row_major float4x4 prevViewProjection;\n"
    "    float2 invResolution;\n"
    "    float2 jitterDelta;\n"
    "    float blendWeight;\n"
    "    int historyValid;\n"
    "    float2 _taaPad0;\n"
    "};\n"
    "Texture2D currTex : register(t0);\n"
    "Texture2D histTex : register(t1);\n"
    "Texture2D motionTex : register(t2);\n"
    "Texture2D depthTex : register(t3);\n"
    "SamplerState postSampler : register(s0);\n"
    "struct VS_OUTPUT {\n"
    "    float4 pos : SV_POSITION;\n"
    "    float2 uv : TEXCOORD0;\n"
    "};\n"
    "float2 uvToNdc(float2 uv) { return float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0); }\n"
    "float2 ndcDeltaToUvDelta(float2 delta) { return float2(delta.x * 0.5, -delta.y * 0.5); }\n"
    "bool taaFinite1(float v) { return !isnan(v) && !isinf(v); }\n"
    "bool taaFinite3(float3 v) { return !any(isnan(v)) && !any(isinf(v)); }\n"
    "bool taaFinite4(float4 v) { return !any(isnan(v)) && !any(isinf(v)); }\n"
    "float4 PSTAAResolve(VS_OUTPUT input) : SV_Target {\n"
    "    float3 curr = currTex.Sample(postSampler, input.uv).rgb;\n"
    "    if (!taaFinite3(curr))\n"
    "        curr = float3(0.0, 0.0, 0.0);\n"
    "    if (historyValid == 0)\n"
    "        return float4(curr, 1.0);\n"
    "    float4 motion = motionTex.Sample(postSampler, input.uv);\n"
    "    if (!taaFinite4(motion))\n"
    "        return float4(curr, 1.0);\n"
    "    float2 velocity = motion.xy * 2.0 - 1.0;\n"
    "    if (motion.z < 0.5) {\n"
    "        float depth = depthTex.Sample(postSampler, input.uv).r;\n"
    "        if (!taaFinite1(depth) || depth < 0.0 || depth > 1.0)\n"
    "            return float4(curr, 1.0);\n"
    "        float4 clip = float4(uvToNdc(input.uv), depth * 2.0 - 1.0, 1.0);\n"
    "        float4 world = mul(invViewProjection, clip);\n"
    "        if (!taaFinite4(world) || !(abs(world.w) > 0.0001 && abs(world.w) < 1e20))\n"
    "            return float4(curr, 1.0);\n"
    "        world.xyz /= world.w;\n"
    "        float4 prevClip = mul(prevViewProjection, float4(world.xyz, 1.0));\n"
    "        if (!taaFinite4(prevClip) ||\n"
    "            !(abs(prevClip.w) > 0.0001 && abs(prevClip.w) < 1e20))\n"
    "            return float4(curr, 1.0);\n"
    "        velocity = ndcDeltaToUvDelta(uvToNdc(input.uv) - prevClip.xy / prevClip.w);\n"
    "    }\n"
    "    velocity -= jitterDelta;\n"
    "    if (any(isnan(velocity)) || any(isinf(velocity)))\n"
    "        return float4(curr, 1.0);\n"
    "    float2 histUv = input.uv - velocity;\n"
    "    if (histUv.x < 0.0 || histUv.x > 1.0 || histUv.y < 0.0 || histUv.y > 1.0)\n"
    "        return float4(curr, 1.0);\n"
    "    float3 hist = histTex.Sample(postSampler, histUv).rgb;\n"
    "    if (!taaFinite3(hist))\n"
    "        return float4(curr, 1.0);\n"
    "    float3 cmin = curr;\n"
    "    float3 cmax = curr;\n"
    "    [unroll]\n"
    "    for (int dy = -1; dy <= 1; dy++) {\n"
    "        [unroll]\n"
    "        for (int dx = -1; dx <= 1; dx++) {\n"
    "            if (dx == 0 && dy == 0)\n"
    "                continue;\n"
    "            float3 n = currTex.Sample(postSampler, input.uv + float2(dx, dy) * "
    "invResolution).rgb;\n"
    "            if (taaFinite3(n)) {\n"
    "                cmin = min(cmin, n);\n"
    "                cmax = max(cmax, n);\n"
    "            }\n"
    "        }\n"
    "    }\n"
    "    hist = clamp(hist, cmin, cmax);\n"
    "    float w = clamp(blendWeight, 0.0, 0.98);\n"
    "    w *= 1.0 - saturate(length(velocity) * 8.0) * 0.85;\n"
    "    float3 resolved = lerp(curr, hist, w);\n"
    "    return float4(taaFinite3(resolved) ? resolved : curr, 1.0);\n"
    "}\n",
};

static void *volatile d3d11_taa_shader_source_cache;

/// @brief Return the lazily assembled temporal anti-aliasing resolve HLSL source.
/// @return Process-lifetime immutable shader source, or `NULL` if assembly fails.
static const char *d3d11_taa_shader_source_get(void) {
    return d3d11_join_shader_chunks(&d3d11_taa_shader_source_cache,
                                    d3d11_taa_shader_source_chunks,
                                    sizeof(d3d11_taa_shader_source_chunks) /
                                        sizeof(d3d11_taa_shader_source_chunks[0]));
}

#define d3d11_taa_shader_source d3d11_taa_shader_source_get()


/* Plan 10: screen-space reflections — linear ray-march against the scene depth
 * buffer with binary refinement for pixels whose motion-target alpha carries an
 * SSR mask (Water3D / SsrEnabled materials). Misses keep the source pixel, whose
 * env-map reflection term acts as the fallback. */
static const char *const d3d11_ssr_shader_source_chunks[] = {
    "cbuffer SSRCB : register(b0) {\n"
    "    row_major float4x4 invViewProjection;\n"
    "    row_major float4x4 viewProjection;\n"
    "    float4 camPos;\n"
    "    float4 params0;\n"
    "    float2 invResolution;\n"
    "    float2 _ssrPad0;\n"
    "};\n"
    "Texture2D sceneTex : register(t0);\n"
    "Texture2D depthTex : register(t1);\n"
    "Texture2D motionTex : register(t2);\n"
    "SamplerState postSampler : register(s0);\n"
    "struct VS_OUTPUT {\n"
    "    float4 pos : SV_POSITION;\n"
    "    float2 uv : TEXCOORD0;\n"
    "};\n"
    "float2 ssrUvToNdc(float2 uv) { return float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0); }\n"
    "float2 ssrNdcToUv(float2 ndc) { return float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5); }\n"
    "float3 ssrSafeNormalize3(float3 v, float3 fallback) {\n"
    "    float len2 = dot(v, v);\n"
    "    return (len2 > 1e-12 && len2 < 1e20) ? v * rsqrt(len2) : fallback;\n"
    "}\n"
    "bool ssrFinite1(float v) { return !isnan(v) && !isinf(v); }\n"
    "bool ssrFinite3(float3 v) { return !any(isnan(v)) && !any(isinf(v)); }\n"
    "bool ssrFinite4(float4 v) { return !any(isnan(v)) && !any(isinf(v)); }\n"
    "bool ssrDepthAt(float2 uv, out float depth) {\n"
    "    depth = depthTex.Sample(postSampler, uv).r;\n"
    "    return ssrFinite1(depth) && depth >= 0.0 && depth <= 1.0;\n"
    "}\n"
    "bool ssrWorldAt(float2 uv, float depth, out float3 worldOut) {\n"
    "    float4 clip = float4(ssrUvToNdc(uv), depth * 2.0 - 1.0, 1.0);\n"
    "    float4 world = mul(invViewProjection, clip);\n"
    "    worldOut = float3(0.0, 0.0, 0.0);\n"
    "    if (!ssrFinite4(world) || !(abs(world.w) > 0.0001 && abs(world.w) < 1e20))\n"
    "        return false;\n"
    "    worldOut = world.xyz / world.w;\n"
    "    return ssrFinite3(worldOut);\n"
    "}\n"
    "float4 PSSSR(VS_OUTPUT input) : SV_Target {\n"
    "    float3 base = sceneTex.Sample(postSampler, input.uv).rgb;\n"
    "    if (!ssrFinite3(base))\n"
    "        base = float3(0.0, 0.0, 0.0);\n"
    "    float mask = motionTex.Sample(postSampler, input.uv).a;\n"
    "    float depth;\n"
    "    if (!ssrFinite1(mask) || !ssrDepthAt(input.uv, depth))\n"
    "        return float4(base, 1.0);\n"
    "    mask = saturate(mask);\n"
    /* Reversed-Z: cleared/far depth is 0 and nearer is larger, so the sky guard and
     * every ray-vs-scene comparison below flip direction. */
    "    if (mask <= 0.004 || depth <= 0.0001)\n"
    "        return float4(base, 1.0);\n"
    "    float3 world;\n"
    "    float3 wx;\n"
    "    float3 wy;\n"
    "    float2 du = float2(invResolution.x, 0.0);\n"
    "    float2 dv = float2(0.0, invResolution.y);\n"
    "    float depthX;\n"
    "    float depthY;\n"
    "    if (!ssrWorldAt(input.uv, depth, world) ||\n"
    "        !ssrDepthAt(input.uv + du, depthX) || !ssrWorldAt(input.uv + du, depthX, wx) ||\n"
    "        !ssrDepthAt(input.uv + dv, depthY) || !ssrWorldAt(input.uv + dv, depthY, wy))\n"
    "        return float4(base, 1.0);\n"
    "    float3 N = ssrSafeNormalize3(cross(wx - world, wy - world), float3(0.0, 1.0, 0.0));\n"
    "    float3 V = ssrSafeNormalize3(world - camPos.xyz, float3(0.0, 0.0, -1.0));\n"
    "    if (dot(N, V) > 0.0)\n"
    "        N = -N;\n"
    "    float3 R = reflect(V, N);\n"
    "    float2 px = input.uv / invResolution;\n"
    "    float ign = frac(52.9829189 * frac(0.06711056 * px.x + 0.00583715 * px.y));\n"
    "    int steps = clamp(int(params0.z), 8, 48);\n"
    "    float t = 0.05 + 0.08 * ign;\n"
    "    float prevT = 0.0;\n"
    "    float2 hitUv = float2(-1.0, -1.0);\n"
    "    bool hit = false;\n"
    "    [loop]\n"
    "    for (int i = 0; i < steps; i++) {\n"
    "        float3 pos = world + R * t;\n"
    "        float4 pc = mul(viewProjection, float4(pos, 1.0));\n"
    "        if (!ssrFinite4(pc) || !(pc.w > 0.0001 && pc.w < 1e20))\n"
    "            break;\n"
    "        float3 ndc = pc.xyz / pc.w;\n"
    "        if (!ssrFinite3(ndc))\n"
    "            break;\n"
    "        float2 uv2 = ssrNdcToUv(ndc.xy);\n"
    "        if (uv2.x < 0.0 || uv2.x > 1.0 || uv2.y < 0.0 || uv2.y > 1.0)\n"
    "            break;\n"
    "        float rayD = ndc.z * 0.5 + 0.5;\n"
    "        float sceneD;\n"
    "        if (!ssrDepthAt(uv2, sceneD))\n"
    "            break;\n"
    "        if (rayD < sceneD - 0.0002) {\n"
    "            float lo = prevT;\n"
    "            float hi = t;\n"
    "            bool refineValid = true;\n"
    "            [unroll]\n"
    "            for (int r = 0; r < 4; r++) {\n"
    "                float mid = (lo + hi) * 0.5;\n"
    "                float4 mc = mul(viewProjection, float4(world + R * mid, 1.0));\n"
    "                if (!ssrFinite4(mc) || !(mc.w > 0.0001 && mc.w < 1e20)) {\n",
    "                    refineValid = false;\n"
    "                    break;\n"
    "                }\n"
    "                float3 mndc = mc.xyz / mc.w;\n"
    "                if (!ssrFinite3(mndc)) {\n"
    "                    refineValid = false;\n"
    "                    break;\n"
    "                }\n"
    "                float2 muv = ssrNdcToUv(mndc.xy);\n"
    "                if (muv.x < 0.0 || muv.x > 1.0 || muv.y < 0.0 || muv.y > 1.0) {\n"
    "                    refineValid = false;\n"
    "                    break;\n"
    "                }\n"
    "                float midSceneD;\n"
    "                if (!ssrDepthAt(muv, midSceneD)) {\n"
    "                    refineValid = false;\n"
    "                    break;\n"
    "                }\n"
    "                if (mndc.z * 0.5 + 0.5 < midSceneD - 0.0002)\n"
    "                    hi = mid;\n"
    "                else\n"
    "                    lo = mid;\n"
    "            }\n"
    "            if (!refineValid)\n"
    "                break;\n"
    "            float4 hc = mul(viewProjection, float4(world + R * hi, 1.0));\n"
    "            if (!ssrFinite4(hc) || !(hc.w > 0.0001 && hc.w < 1e20))\n"
    "                break;\n"
    "            float3 hndc = hc.xyz / hc.w;\n"
    "            if (!ssrFinite3(hndc))\n"
    "                break;\n"
    "            hitUv = ssrNdcToUv(hndc.xy);\n"
    "            if (hitUv.x < 0.0 || hitUv.x > 1.0 || hitUv.y < 0.0 || hitUv.y > 1.0)\n"
    "                break;\n"
    "            float hitRayD = hndc.z * 0.5 + 0.5;\n"
    "            float hitSceneD;\n"
    "            if (!ssrDepthAt(hitUv, hitSceneD) || !ssrFinite1(hitRayD))\n"
    "                break;\n"
    "            hit = (hitSceneD - hitRayD) < 0.02;\n"
    "            break;\n"
    "        }\n"
    "        prevT = t;\n"
    "        t *= 1.35;\n"
    "    }\n"
    "    if (!hit || hitUv.x < 0.0)\n"
    "        return float4(base, 1.0);\n"
    "    float2 edge = min(hitUv, 1.0 - hitUv);\n"
    "    float edgeFade = saturate(min(edge.x, edge.y) * 8.0);\n"
    "    float ndv = saturate(dot(-V, N));\n"
    "    float fres = 0.2 + 0.8 * pow(1.0 - ndv, 2.0);\n"
    "    float amt = saturate(params0.x) * mask * edgeFade * fres;\n"
    "    float3 refl = sceneTex.Sample(postSampler, hitUv).rgb;\n"
    "    if (!ssrFinite3(refl))\n"
    "        return float4(base, 1.0);\n"
    "    float3 reflected = lerp(base, refl, amt);\n"
    "    return float4(ssrFinite3(reflected) ? reflected : base, 1.0);\n"
    "}\n",
};

static void *volatile d3d11_ssr_shader_source_cache;

/// @brief Return the lazily assembled screen-space reflection HLSL source.
/// @return Process-lifetime immutable shader source, or `NULL` if assembly fails.
static const char *d3d11_ssr_shader_source_get(void) {
    return d3d11_join_shader_chunks(&d3d11_ssr_shader_source_cache,
                                    d3d11_ssr_shader_source_chunks,
                                    sizeof(d3d11_ssr_shader_source_chunks) /
                                        sizeof(d3d11_ssr_shader_source_chunks[0]));
}

#define d3d11_ssr_shader_source d3d11_ssr_shader_source_get()
