//
// File: zannastudio/src/scm/scm_git.zia
// Purpose: Run Git commands through bounded, cancellable asynchronous process
//          jobs and parse their structured output for Studio source control.
// Key invariants:
//   - UI callers start and pump GitJob instances; they never wait in-frame.
//   - Environment overlays preserve configured credential brokers, agents,
//     proxies, certificates, locale, and platform process requirements.
//   - Studio never receives or stores a password/passphrase response.
//   - Captured stdout and stderr remain bounded for hostile or noisy commands.
// Ownership/Lifetime:
//   - Git owns repository/tool resolution; each returned GitJob owns one child
//     process until completion, cancellation, or explicit destruction.
// Links: zannastudio/src/scm/scm_view.zia,
//        zannastudio/src/scm/scm_gutter_controller.zia
//
//===----------------------------------------------------------------------===//

module scm_git;

bind "../scm/scm_git_support";

bind "../build/bounded_output";

bind Process = Zanna.System.Process;
bind Pty = Zanna.System.Pty;
bind Env = Zanna.System.Environment;
bind Machine = Zanna.System.Machine;
bind IO = Zanna.IO;
bind Path = Zanna.IO.Path;
bind Map = Zanna.Collections.Map;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;
bind Obj = Zanna.Core.Object;
bind Time = Zanna.Time;

final MAX_GIT_STDOUT_CHARS = 500000;
final MAX_GIT_STDERR_CHARS = 120000;

// ============================================================================
// MODULE: scm_git
// PURPOSE: Async git command layer for the IDE Source Control view.
//
// WHERE-THIS-FITS: scm_view owns widgets and starts GitJob instances from this
//          module. Each frame it pumps the active job, then parses status/diff
//          output or refreshes after mutating commands.
//
// KEY-DESIGN-CHOICES:
//   * PROCESS, NOT EXEC. Zanna.System.Process gives stdout, stderr, exit code,
//     and cancellation in one handle, so network operations never block the UI.
//   * PATH RESOLUTION AT THE EDGE. Process does not search PATH, so this module
//     resolves git once and reports a useful error if it cannot be found.
//   * PORCELAIN V2 PARSING. Status parsing is field-based, so paths containing
//     spaces are handled without display-string splitting.
// ============================================================================

/// @brief One changed file in `git status`, with staged/worktree state.
class GitEntry {
    expose String path;
    expose String oldPath;
    expose String index;
    expose String worktree;
    expose Boolean staged;
    expose Boolean untracked;
    expose Boolean renamed;
    expose Boolean conflicted;

    expose func init() {
        path = "";
        oldPath = "";
        index = ".";
        worktree = ".";
        staged = false;
        untracked = false;
        renamed = false;
        conflicted = false;
    }
}

/// @brief Parsed `git status --porcelain=v2 --branch` snapshot for one repo.
class GitStatus {
    expose Boolean isRepo;
    expose String branch;
    expose List[GitEntry] entries;
    expose String errorText;

    expose func init() {
        isRepo = false;
        branch = "";
        entries = [];
        errorText = "";
    }
}

/// @brief One commit row parsed from `git log` (plan 11 history view).
class GitCommit {
    expose String sha;
    expose String author;
    expose String date;
    expose String subject;

    expose func init() {
        sha = "";
        author = "";
        date = "";
        subject = "";
    }
}

/// @brief One path record from a commit's NUL-delimited name-status stream.
class GitCommitFile {
    expose String status;
    expose String path;
    expose String oldPath;

    expose func init() {
        status = "";
        path = "";
        oldPath = "";
    }
}

/// @brief One asynchronous git process and its captured streams.
class GitJob {
    expose Process.ProcessHandle handle;
    expose String kind;
    expose String path;
    expose Boolean stagedDiff;
    expose String stdoutText;
    expose String stderrText;
    expose Integer exitCode;
    expose Boolean running;
    expose Boolean started;
    expose Boolean stdoutTruncated;
    expose Boolean stderrTruncated;

    expose func init() {
        handle = null;
        kind = "";
        path = "";
        stagedDiff = false;
        stdoutText = "";
        stderrText = "";
        exitCode = -1;
        running = false;
        started = false;
        stdoutTruncated = false;
        stderrTruncated = false;
    }

    expose func Start(program: String,
                      args: Any,
                      cwd: String,
                      jobKind: String,
                      jobPath: String,
                      isStagedDiff: Boolean,
                      env: Any) -> Boolean {
        kind = jobKind;
        path = jobPath;
        stagedDiff = isStagedDiff;
        stdoutText = "";
        stderrText = "";
        exitCode = -1;
        stdoutTruncated = false;
        stderrTruncated = false;
        handle = Process.StartWithEnvOverlay(program, args, cwd, env);
        if handle == null or handle.IsValid() == false {
            handle = null;
            running = false;
            started = false;
            stderrText = "Could not start git process";
            return false;
        }
        running = true;
        started = true;
        return true;
    }

    expose func Pump() -> Boolean {
        if handle == null { running = false; return false; }
        Drain();
        if handle.IsRunning() {
            running = true;
            return true;
        }
        Drain();
        exitCode = handle.ExitCode();
        handle.Destroy();
        handle = null;
        running = false;
        return false;
    }

    expose func Wait() {
        if handle == null { running = false; return; }
        while handle != null and handle.IsRunning() {
            Pump();
            Time.Clock.Sleep(5);
        }
        if handle != null {
            Pump();
        }
    }

    expose func Kill() -> Boolean {
        if handle == null { return false; }
        var ok = handle.Kill();
        Drain();
        exitCode = -1;
        handle.Destroy();
        handle = null;
        running = false;
        return ok;
    }

    expose func Success() -> Boolean {
        return started and running == false and exitCode == 0;
    }

    expose func CombinedOutput() -> String {
        if stdoutText == "" { return stderrText; }
        if stderrText == "" { return stdoutText; }
        return stdoutText + "\n" + stderrText;
    }

    hide func Drain() {
        if handle == null { return; }
        AppendStdoutResult(handle.ReadStdoutResult());
        AppendStderrResult(handle.ReadStderrResult());
    }

    hide func AppendStdoutResult(result: Any) {
        if result == null { return; }
        var out = Map.GetStr(result, "text");
        if out != "" {
            stdoutText = bounded_output.Append(stdoutText, out,
                                               "[git stdout truncated]\n",
                                               MAX_GIT_STDOUT_CHARS);
        }
        if Map.GetBool(result, "truncated") and stdoutTruncated == false {
            stdoutTruncated = true;
            stdoutText = bounded_output.Append(stdoutText,
                                               "\n[git stdout truncated by runtime]\n",
                                               "[git stdout truncated]\n",
                                               MAX_GIT_STDOUT_CHARS);
        }
    }

    hide func AppendStderrResult(result: Any) {
        if result == null { return; }
        var err = Map.GetStr(result, "text");
        if err != "" {
            stderrText = bounded_output.Append(stderrText, err,
                                               "[git stderr truncated]\n",
                                               MAX_GIT_STDERR_CHARS);
        }
        if Map.GetBool(result, "truncated") and stderrTruncated == false {
            stderrTruncated = true;
            stderrText = bounded_output.Append(stderrText,
                                               "\n[git stderr truncated by runtime]\n",
                                               "[git stderr truncated]\n",
                                               MAX_GIT_STDERR_CHARS);
        }
    }
}

/// @brief One PTY-backed interactive git process (push/pull) whose credential
///        prompts are detected in the merged output and answered in-app.
/// @details The child controls terminal echo, so secrets typed through
///          SendInput are not echoed back by password prompts. Output is
///          bounded like GitJob streams.
class GitPtyJob {
    expose Pty.PtySession session;
    expose String kind;
    expose String outputText;   // merged stdout+stderr (bounded)
    expose String lastDelta;    // bytes drained by the most recent Pump
    expose Integer exitCode;
    expose Boolean running;
    expose Boolean started;
    expose String promptText;   // non-empty while git waits for an answer

    expose func init() {
        session = null;
        kind = "";
        outputText = "";
        lastDelta = "";
        exitCode = -1;
        running = false;
        started = false;
        promptText = "";
    }

    expose func Start(program: String, args: Any, cwd: String,
                      jobKind: String, env: Any) -> Boolean {
        kind = jobKind;
        outputText = "";
        lastDelta = "";
        exitCode = -1;
        promptText = "";
        if Pty.IsSupported() == false {
            outputText = "PTY support is not available on this platform";
            return false;
        }
        var opened = Pty.OpenResult(program, args, cwd, env, 120, 12);
        if not opened.IsOk {
            outputText = opened.UnwrapErrStr();
            if outputText == "" { outputText = "Could not start interactive git"; }
            return false;
        }
        session = opened.Unwrap();
        if session.IsValid() == false {
            outputText = "PTY session handle was invalid";
            session = null;
            return false;
        }
        running = true;
        started = true;
        return true;
    }

    /// @brief Drain output, refresh prompt detection, and detect exit.
    /// @return True while the child is still running.
    expose func Pump() -> Boolean {
        lastDelta = "";
        if session == null { running = false; return false; }
        lastDelta = Drain();
        if session.IsRunning() {
            promptText = DetectPrompt(outputText);
            running = true;
            return true;
        }
        lastDelta = lastDelta + Drain();
        exitCode = session.ExitCode();
        session.Destroy();
        session = null;
        running = false;
        promptText = "";
        return false;
    }

    /// @brief Answer the pending prompt (a newline is appended).
    expose func SendInput(text: String) {
        if session == null or running == false { return; }
        session.Write(text + "\n");
        promptText = "";
    }

    expose func Kill() {
        if session == null { return; }
        session.Kill();
        session.Destroy();
        session = null;
        running = false;
        promptText = "";
        exitCode = -1;
    }

    expose func Success() -> Boolean {
        return started and running == false and exitCode == 0;
    }

    expose func IsWaitingForInput() -> Boolean {
        return running and promptText != "";
    }

    hide func Drain() -> String {
        if session == null { return ""; }
        var result = session.ReadResult();
        var out = Map.GetStr(result, "text");
        if out != "" {
            outputText = bounded_output.Append(outputText, out,
                                               "[git output truncated]\n",
                                               MAX_GIT_STDOUT_CHARS);
        }
        return out;
    }
}

/// @brief Detect a credential or confirmation prompt at the PTY output tail.
expose func DetectPrompt(text: String) -> String {
    return scm_git_support.DetectPrompt(text);
}

/// @brief True when a credential prompt asks for a secret.
expose func PromptWantsMask(prompt: String) -> Boolean {
    return scm_git_support.PromptWantsMask(prompt);
}

/// @brief Parse `git log` output produced by StartLog into commit rows.
/// @details Git forbids NUL in commit metadata, making four NUL-delimited fields
///          unambiguous even when author/subject text contains tabs or controls.
///          The former RS/US representation remains readable for compatibility.
expose func ParseLog(text: String) -> List[GitCommit] {
    var commits: List[GitCommit] = [];
    if text == "" { return commits; }
    if Str.IndexOf(text, Str.Chr(0)) != 0 {
        var fields = Str.Split(text, Str.Chr(0));
        var fieldIndex = 0;
        while fieldIndex + 3 < Seq.get_Count(fields) {
            var c = new GitCommit();
            c.sha = Str.Trim(Obj.ToString(Seq.Get(fields, fieldIndex)));
            c.author = Obj.ToString(Seq.Get(fields, fieldIndex + 1));
            c.date = Obj.ToString(Seq.Get(fields, fieldIndex + 2));
            c.subject = Obj.ToString(Seq.Get(fields, fieldIndex + 3));
            if c.sha != "" { commits.Push(c); }
            fieldIndex = fieldIndex + 4;
        }
        return commits;
    }
    var records = Str.Split(text, Str.Chr(30));
    var i = 0;
    while i < Seq.get_Count(records) {
        var record = Str.Trim(Obj.ToString(Seq.Get(records, i)));
        i = i + 1;
        if record == "" { continue; }
        var fields = Str.Split(record, Str.Chr(31));
        if Seq.get_Count(fields) < 4 { continue; }
        var c = new GitCommit();
        c.sha = Str.Trim(Obj.ToString(Seq.Get(fields, 0)));
        c.author = Obj.ToString(Seq.Get(fields, 1));
        c.date = Obj.ToString(Seq.Get(fields, 2));
        c.subject = Obj.ToString(Seq.Get(fields, 3));
        if c.sha != "" { commits.Push(c); }
    }
    return commits;
}

/// @brief Parse one NUL-delimited `git show --name-status -z` stream.
/// @details The first four tokens are the pretty header. Each ordinary status
///          owns one path token; rename/copy statuses own old and new path
///          tokens. Structured records preserve tabs and newlines in paths.
expose func ParseCommitFiles(text: String) -> List[GitCommitFile] {
    var files: List[GitCommitFile] = [];
    if text == "" { return files; }
    var tokens = Str.Split(text, Str.Chr(0));
    var i = 4;
    while i < Seq.get_Count(tokens) {
        var status = Str.Trim(Obj.ToString(Seq.Get(tokens, i)));
        i = i + 1;
        if status == "" { continue; }
        var first = Str.Left(status, 1);
        if first != "A" and first != "M" and first != "D"
           and first != "R" and first != "C" and first != "T" {
            continue;
        }
        var file = new GitCommitFile();
        file.status = status;
        if first == "R" or first == "C" {
            if i + 1 >= Seq.get_Count(tokens) { break; }
            file.oldPath = Obj.ToString(Seq.Get(tokens, i));
            file.path = Obj.ToString(Seq.Get(tokens, i + 1));
            i = i + 2;
        } else {
            if i >= Seq.get_Count(tokens) { break; }
            file.path = Obj.ToString(Seq.Get(tokens, i));
            i = i + 1;
        }
        if file.path != "" { files.Push(file); }
    }
    return files;
}

/// @brief git command layer bound to one repository root.
class Git {
    expose String repo;
    expose String gitPath;
    expose Integer lastExit;
    expose String lastError;

    expose func init() {
        repo = "";
        gitPath = "";
        lastExit = 0;
        lastError = "";
    }

    expose func SetRepo(path: String) {
        repo = path;
    }

    expose func ResolveGit() -> String {
        if gitPath != "" and IO.File.Exists(gitPath) { return gitPath; }
        var overridePath = EnvValue("ZANNA_GIT_BINARY");
        if overridePath != "" and IO.File.Exists(overridePath) {
            gitPath = Path.Absolute(overridePath);
            return gitPath;
        }
        var name = "git";
        if Machine.Os == "windows" { name = "git.exe"; }
        gitPath = ResolveBinary(name);
        return gitPath;
    }

    expose func StartStatus() -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "status");
        Seq.Push(args, "--porcelain=v2");
        Seq.Push(args, "--branch");
        Seq.Push(args, "-z");
        Seq.Push(args, "--renames");
        return StartCommand("status", args, "", false);
    }

    expose func StartShowHead(path: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "show");
        Seq.Push(args, "HEAD:" + path);
        return StartCommand("show", args, path, false);
    }

    expose func StartDiff(path: String,
                          staged: Boolean) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "diff");
        if staged { Seq.Push(args, "--cached"); }
        Seq.Push(args, "--");
        Seq.Push(args, path);
        return StartCommand("diff", args, path, staged);
    }

    /// @brief Start the bounded worktree diff used by editor gutter markers.
    /// @details External diff commands and text-conversion drivers are disabled:
    ///          they are unnecessary for source-line markers and can prompt,
    ///          recurse, or block on arbitrary user configuration. Zero context
    ///          keeps parsing and retained output proportional to changed hunks.
    /// @param path Repository-relative source path.
    /// @return Asynchronous job tagged `gutterDiff`.
    expose func StartGutterDiff(path: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "diff");
        Seq.Push(args, "--no-ext-diff");
        Seq.Push(args, "--no-textconv");
        Seq.Push(args, "--unified=0");
        Seq.Push(args, "--no-color");
        Seq.Push(args, "--");
        Seq.Push(args, path);
        return StartCommand("gutterDiff", args, path, false);
    }

    expose func StartStage(path: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "add");
        Seq.Push(args, "--");
        Seq.Push(args, path);
        return StartCommand("stage", args, path, false);
    }

    expose func StartStageAll() -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "add");
        Seq.Push(args, "-A");
        return StartCommand("stageAll", args, "", false);
    }

    expose func StartUnstage(path: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "restore");
        Seq.Push(args, "--staged");
        Seq.Push(args, "--");
        Seq.Push(args, path);
        return StartCommand("unstage", args, path, false);
    }

    expose func StartCommit(message: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "commit");
        Seq.Push(args, "-m");
        Seq.Push(args, message);
        return StartCommand("commit", args, "", false);
    }

    expose func StartPush() -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "push");
        return StartCommand("push", args, "", false);
    }

    expose func StartPull() -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "pull");
        return StartCommand("pull", args, "", false);
    }

    expose func StartCheckout(branchName: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "switch");
        Seq.Push(args, branchName);
        return StartCommand("checkout", args, branchName, false);
    }

    expose func StartBranches() -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "branch");
        Seq.Push(args, "--format=%(refname:short)");
        return StartCommand("branches", args, "", false);
    }

    /// @brief Start a lazily-paged `git log` (plan 11 history view).
    /// @param skip Commits to skip (paging offset).
    /// @param count Maximum commits to return for this page.
    /// @details Four NUL-delimited fields make every Git-permitted author and
    ///          subject byte unambiguous (see ParseLog).
    expose func StartLog(skip: Integer, count: Integer) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "log");
        Seq.Push(args, "--skip=" + skip);
        Seq.Push(args, "--max-count=" + count);
        Seq.Push(args, "--date=short");
        Seq.Push(args, "--pretty=format:%H%x00%an%x00%ad%x00%s%x00");
        return StartCommand("log", args, "" + skip, false);
    }

    /// @brief Start listing the files touched by one commit (name-status form).
    expose func StartCommitFiles(sha: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "show");
        Seq.Push(args, "--name-status");
        Seq.Push(args, "-z");
        Seq.Push(args, "--pretty=format:%H%x00%an%x00%ad%x00%s%x00");
        Seq.Push(args, "--date=short");
        Seq.Push(args, sha);
        return StartCommand("logfiles", args, sha, false);
    }

    /// @brief Start fetching one file's content at a specific revision.
    /// @param rev Revision expression (e.g. a sha, or sha with a `~1` suffix).
    /// @param path Repo-relative file path.
    /// @param jobKind Job kind tag so the completion handler can route the text.
    expose func StartShowAt(rev: String, path: String, jobKind: String) -> GitJob {
        var args = Seq.New();
        Seq.Push(args, "show");
        Seq.Push(args, rev + ":" + path);
        return StartCommand(jobKind, args, path, false);
    }

    /// @brief Start an interactive (PTY-backed) network operation such as push
    ///        or pull so git can ask for credentials (plan 11).
    /// @details Unlike StartCommand jobs, the PTY environment leaves terminal
    ///          prompting enabled; the view detects prompt lines in the merged
    ///          output and answers through GitPtyJob.SendInput.
    expose func StartInteractive(kind: String, args: Any) -> GitPtyJob {
        var job = new GitPtyJob();
        lastError = "";
        if repo == "" {
            lastError = "No repository is open";
            job.outputText = lastError;
            return job;
        }
        var program = ResolveGit();
        if program == "" {
            lastError = "Could not find git. Add git to PATH or set ZANNA_GIT_BINARY.";
            job.outputText = lastError;
            return job;
        }
        if job.Start(program, args, repo, kind, GitInteractiveEnvironment()) == false {
            lastError = job.outputText;
        }
        return job;
    }

    /// @brief Interactive push (credentials answered in-app when prompted).
    expose func StartPushInteractive() -> GitPtyJob {
        var args = Seq.New();
        Seq.Push(args, "push");
        return StartInteractive("push", args);
    }

    /// @brief Interactive pull (credentials answered in-app when prompted).
    expose func StartPullInteractive() -> GitPtyJob {
        var args = Seq.New();
        Seq.Push(args, "pull");
        return StartInteractive("pull", args);
    }

    /// @brief Environment for PTY-backed git: identical inheritance to the
    ///        non-interactive set, but terminal prompting stays enabled so
    ///        credential questions surface in-app instead of failing.
    hide func GitInteractiveEnvironment() -> Any {
        var env = Seq.New();
        CopyEnvIfPresent(env, "PATH");
        CopyEnvIfPresent(env, "HOME");
        CopyEnvIfPresent(env, "USER");
        CopyEnvIfPresent(env, "LOGNAME");
        CopyEnvIfPresent(env, "USERPROFILE");
        CopyEnvIfPresent(env, "HOMEDRIVE");
        CopyEnvIfPresent(env, "HOMEPATH");
        CopyEnvIfPresent(env, "SystemRoot");
        CopyEnvIfPresent(env, "WINDIR");
        CopyEnvIfPresent(env, "TEMP");
        CopyEnvIfPresent(env, "TMP");
        CopyEnvIfPresent(env, "TMPDIR");
        CopyEnvIfPresent(env, "SSH_AUTH_SOCK");
        CopyEnvIfPresent(env, "SSH_AGENT_PID");
        Seq.Push(env, "TERM=dumb");
        Seq.Push(env, "GIT_MERGE_AUTOEDIT=no");
        Seq.Push(env, "GIT_PAGER=cat");
        Seq.Push(env, "PAGER=cat");
        return env;
    }

    hide func StartCommand(kind: String,
                           args: Any,
                           path: String,
                           staged: Boolean) -> GitJob {
        var job = new GitJob();
        lastError = "";
        if repo == "" {
            lastError = "No repository is open";
            job.stderrText = lastError;
            return job;
        }
        var program = ResolveGit();
        if program == "" {
            lastError = "Could not find git. Add git to PATH or set ZANNA_GIT_BINARY.";
            job.stderrText = lastError;
            return job;
        }
        if job.Start(program, args, repo, kind, path, staged, GitEnvironment()) == false {
            lastError = job.stderrText;
        }
        return job;
    }

    /// @brief Build the small environment overlay for Git subprocesses.
    /// @details Process preserves the complete parent environment, including
    ///          configured Git Credential Manager/credential helpers, askpass,
    ///          SSH agents, proxies, certificate paths, locale, and Windows
    ///          process variables. Only UI-hostile terminal/editor/pager behavior
    ///          is overridden. Secrets stay inside the configured broker.
    /// @return Sequence of `NAME=value` overrides for StartWithEnvOverlay.
    hide func GitEnvironment() -> Any {
        var env = Seq.New();
        Seq.Push(env, "GIT_TERMINAL_PROMPT=0");
        Seq.Push(env, "GIT_MERGE_AUTOEDIT=no");
        Seq.Push(env, "GIT_PAGER=cat");
        Seq.Push(env, "PAGER=cat");
        return env;
    }

    /// @brief Append one inherited environment variable to a child environment.
    /// @details Empty and missing values are skipped so the child environment does
    ///          not gain malformed assignments. Values are copied verbatim because
    ///          the process runtime validates the final `NAME=value` string.
    /// @param env Mutable sequence receiving assignments.
    /// @param name Environment variable name to copy when present.
    hide func CopyEnvIfPresent(env: Any,
                               name: String) {
        if env == null or name == "" { return; }
        if Env.HasVariable(name) == false { return; }
        var value = Env.GetVariable(name);
        if value == "" { return; }
        Seq.Push(env, name + "=" + value);
    }

    expose func StatusFromOutput(stdoutText: String,
                                 stderrText: String,
                                 exitCode: Integer) -> GitStatus {
        var st = ParseStatus(stdoutText);
        st.isRepo = exitCode == 0;
        st.errorText = stderrText;
        if exitCode != 0 and st.errorText == "" {
            st.errorText = "git status failed with exit code " + exitCode;
        }
        return st;
    }

    expose func Status() -> GitStatus {
        var job = StartStatus();
        job.Wait();
        lastExit = job.exitCode;
        return StatusFromOutput(job.stdoutText, job.stderrText, job.exitCode);
    }

    expose func Diff(path: String,
                     staged: Boolean) -> String {
        var job = StartDiff(path, staged);
        job.Wait();
        lastExit = job.exitCode;
        return job.stdoutText;
    }

    expose func Stage(path: String) -> Boolean {
        var job = StartStage(path);
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func StageAll() -> Boolean {
        var job = StartStageAll();
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Unstage(path: String) -> Boolean {
        var job = StartUnstage(path);
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Commit(message: String) -> Boolean {
        var job = StartCommit(message);
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Push() -> Boolean {
        var job = StartPush();
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Pull() -> Boolean {
        var job = StartPull();
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Checkout(branchName: String) -> Boolean {
        var job = StartCheckout(branchName);
        job.Wait();
        lastExit = job.exitCode;
        return job.Success();
    }

    expose func Branches() -> String {
        var job = StartBranches();
        job.Wait();
        lastExit = job.exitCode;
        return job.stdoutText;
    }

    expose func IsRepo() -> Boolean {
        return Status().isRepo;
    }

    expose func CurrentBranch() -> String {
        return Status().branch;
    }

    hide func ParseStatus(out: String) -> GitStatus {
        var st = new GitStatus();
        if Str.IndexOf(out, Str.Chr(0)) != 0 {
            var records = Str.Split(out, Str.Chr(0));
            var recordIndex = 0;
            while recordIndex < Seq.get_Count(records) {
                var record = Obj.ToString(Seq.Get(records, recordIndex));
                recordIndex = recordIndex + 1;
                if record == "" { continue; }
                if Str.StartsWith(record, "# branch.head ") {
                    st.branch = Str.Trim(
                        Str.Mid(record, Str.get_Length("# branch.head ") + 1));
                    if st.branch == "(detached)" { st.branch = ""; }
                    continue;
                }
                if Str.StartsWith(record, "2 ") {
                    if recordIndex >= Seq.get_Count(records) { continue; }
                    var oldPath = Obj.ToString(Seq.Get(records, recordIndex));
                    recordIndex = recordIndex + 1;
                    var renamed = ParseTrackedLine(record, 9, true);
                    if renamed != null {
                        renamed.oldPath = oldPath;
                        st.entries.Push(renamed);
                    }
                    continue;
                }
                var entry = ParseStatusLine(record);
                if entry != null { st.entries.Push(entry); }
            }
            return st;
        }
        var lines = Str.Split(out, "\n");
        var i = 0;
        while i < Seq.get_Count(lines) {
            var line = Obj.ToString(Seq.Get(lines, i));
            i = i + 1;
            if line == "" { continue; }
            if Str.StartsWith(line, "# branch.head ") {
                st.branch = Str.Trim(Str.Mid(line, Str.get_Length("# branch.head ") + 1));
                if st.branch == "(detached)" { st.branch = ""; }
                continue;
            }
            var e = ParseStatusLine(line);
            if e != null {
                st.entries.Push(e);
            }
        }
        return st;
    }

    hide func ParseStatusLine(line: String) -> GitEntry {
        if Str.StartsWith(line, "? ") {
            var e = new GitEntry();
            e.index = "?";
            e.worktree = "?";
            e.path = UnquotePath(Str.Mid(line, 3));
            e.untracked = true;
            e.staged = false;
            return e;
        }
        if Str.StartsWith(line, "1 ") {
            return ParseTrackedLine(line, 8, false);
        }
        if Str.StartsWith(line, "2 ") {
            return ParseTrackedLine(line, 9, true);
        }
        if Str.StartsWith(line, "u ") {
            return ParseUnmergedLine(line);
        }
        return null;
    }

    /// @brief Parse a porcelain-v2 unmerged status row.
    /// @param line Raw `git status --porcelain=v2` row beginning with `u `.
    /// @return GitEntry marked as conflicted, or null when the row is malformed.
    /// @details Unmerged rows have more metadata fields than ordinary rows:
    ///          `u XY sub m1 m2 m3 mW h1 h2 h3 path`. The UI primarily needs
    ///          XY and path so it can surface conflict state without parsing labels.
    hide func ParseUnmergedLine(line: String) -> GitEntry {
        if Str.get_Length(line) < 5 { return null; }
        var e = new GitEntry();
        e.index = Str.MidLen(line, 3, 1);
        e.worktree = Str.MidLen(line, 4, 1);
        e.staged = false;
        e.conflicted = true;
        e.path = UnquotePath(RestAfterFields(line, 10));
        if e.path == "" { return null; }
        return e;
    }

    hide func ParseTrackedLine(line: String,
                               pathField: Integer,
                               renamed: Boolean) -> GitEntry {
        var e = new GitEntry();
        e.index = Str.MidLen(line, 3, 1);
        e.worktree = Str.MidLen(line, 4, 1);
        e.staged = e.index != ".";
        e.renamed = renamed;
        var pathText = RestAfterFields(line, pathField);
        if renamed {
            var parts = Str.Split(pathText, "\t");
            if Seq.get_Count(parts) > 0 {
                e.path = UnquotePath(Obj.ToString(Seq.Get(parts, 0)));
            }
            if Seq.get_Count(parts) > 1 {
                e.oldPath = UnquotePath(Obj.ToString(Seq.Get(parts, 1)));
            }
        } else {
            e.path = UnquotePath(pathText);
        }
        return e;
    }

    hide func RestAfterFields(line: String,
                              fieldCount: Integer) -> String {
        var pos = 1;
        var fields = 0;
        var n = Str.get_Length(line);
        while pos <= n and fields < fieldCount {
            while pos <= n and Str.MidLen(line, pos, 1) == " " {
                pos = pos + 1;
            }
            while pos <= n and Str.MidLen(line, pos, 1) != " " {
                pos = pos + 1;
            }
            fields = fields + 1;
        }
        while pos <= n and Str.MidLen(line, pos, 1) == " " {
            pos = pos + 1;
        }
        if pos > n { return ""; }
        return Str.Mid(line, pos);
    }

    hide func UnquotePath(pathText: String) -> String {
        var p = Str.Trim(pathText);
        if Str.get_Length(p) >= 2 and Str.Left(p, 1) == "\""
           and Str.MidLen(p, Str.get_Length(p), 1) == "\"" {
            p = Str.MidLen(p, 2, Str.get_Length(p) - 2);
            p = Str.Replace(p, "\\\"", "\"");
            p = Str.Replace(p, "\\\\", "\\");
            p = Str.Replace(p, "\\t", "\t");
            p = Str.Replace(p, "\\n", "\n");
        }
        return p;
    }

    hide func ResolveBinary(name: String) -> String {
        if name == "" { return ""; }
        if Path.IsAbsolute(name) {
            if IO.File.Exists(name) { return name; }
            return "";
        }
        var pathVar = EnvValue("PATH");
        if pathVar == "" { return ""; }
        var entries = Str.Split(pathVar, ListSep());
        var i = 0;
        while i < Seq.get_Count(entries) {
            var entry = Obj.ToString(Seq.Get(entries, i));
            if entry != "" {
                var cand = Path.Join(entry, name);
                if IO.File.Exists(cand) { return Path.Absolute(cand); }
            }
            i = i + 1;
        }
        return "";
    }

    hide func EnvValue(key: String) -> String {
        if Env.HasVariable(key) == false { return ""; }
        return Env.GetVariable(key);
    }

    hide func ListSep() -> String {
        if Machine.Os == "windows" { return ";"; }
        return ":";
    }
}

/// @brief Classify common Git failures into actionable recovery guidance.
expose func FailureHint(kind: String, output: String) -> String {
    return scm_git_support.FailureHint(kind, output);
}
