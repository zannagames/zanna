//
// File: zannastudio/src/scm/scm_view.zia
// Purpose: Coordinate asynchronous Git operations and Source Control UI state.
// Key invariants:
//   - Mutating Git jobs are serialized through a bounded visible queue.
//   - Push/pull authentication stays in configured Git/SSH credential brokers;
//     Studio never asks for or transports secret text.
//   - Worktree diff reads are bounded and non-trapping.
//   - Missing workspaces and non-repositories expose truthful disabled actions.
//   - Sidebar controls wrap, remain keyboard reachable, and reflect live context.
// Ownership/Lifetime: Owns queued jobs/widgets and borrows the diff overlay.
// Links: zannastudio/src/scm/scm_git.zia,
//        zannastudio/src/ui/diff_view.zia
//
//===----------------------------------------------------------------------===//

module scm_view;

bind "../scm/scm_view_base";
bind "../scm/scm_view_presenter" as Implementation;

bind "scm_git";
bind "../ui/diff_view";
bind "../services/safe_io";

bind Zanna.GUI as GUI;
bind Str = Zanna.String;
bind IO = Zanna.IO;
bind Path = Zanna.IO.Path;
bind Input = Zanna.Input;

// ============================================================================

final HISTORY_PAGE_SIZE = 50;
final MAX_PENDING_JOBS = 8;
final MAX_SCM_DIFF_BYTES = 8000000;
final SCM_CONTROLS_COMPACT_MAX_WIDTH = 360.0;

/// @brief Return whether Source Control should use narrow action bases.
func ScmUsesCompactControls(width: Number) -> Boolean {
    return scm_view_base.ScmUsesCompactControls(width);
}

/// @brief Source Control job and event controller.
class ScmView extends Implementation.ScmViewPresenterLayer {
    expose func init() {
        InitializeState();
    }

    /// @brief Point the view at a repository root and refresh.
    /// @details Any in-flight or queued jobs belong to the previous repository
    ///          and are dropped so a stale mutation can never land here.
    expose override func SetRepo(path: String) {
        if repoContextInitialized and path == repoPath and ready {
            if path == "" { ShowNoWorkspaceState(); }
            return;
        }
        repoContextInitialized = true;
        repositoryGeneration = repositoryGeneration + 1;
        if repositoryGeneration <= 0 { repositoryGeneration = 1; }
        repoPath = path;
        repoReady = false;
        if activeJob != null { activeJob.Kill(); activeJob = null; }
        pendingJobs = [];
        queuedDiffPath = "";
        pendingOldText = "";
        pendingDiffFile = "";
        pendingDiffStatus = "";
        viewMode = "status";
        historySha = "";
        historyLoaded = 0;
        operationState = "idle";
        ClearStatusRows();
        lastStatus = new scm_git.GitStatus();
        if loadMoreBtn != null { loadMoreBtn.SetVisible(false); }
        SetRepositoryActionsEnabled(false);
        git.SetRepo(path);
        if path == "" {
            ShowNoWorkspaceState();
            return;
        }
        Refresh();
    }

    /// @brief Kill every Git child without scheduling a final refresh.
    /// @details User cancellation refreshes status, but application shutdown
    ///          must be terminal: no queued or replacement process may start
    ///          after native GUI teardown begins.
    expose func Shutdown() -> Boolean {
        if activeJob != null {
            activeJob.Kill();
            activeJob = null;
        }
        pendingJobs = [];
        queuedDiffPath = "";
        pendingOldText = "";
        pendingDiffFile = "";
        pendingDiffStatus = "";
        return git.Shutdown();
    }

    /// @brief Per-frame: poll widgets first (so actions queue while a job is
    ///        running), then pump the active job, then start queued work.
    ///        Safe when hidden.
    expose func HandleEvents() {
        if ready == false { return; }
        ApplyResponsiveControls();
        UpdateActionStates();

        if cancelBtn != null and cancelBtn.WasClicked() {
            CancelAll();
            UpdateActionStates();
            return;
        }

        var refreshClicked = refreshBtn.WasClicked();
        if refreshClicked and repoPath != "" {
            if viewMode != "status" { ToggleHistory(); } else { Refresh(); }
        } else if refreshClicked and statusLabel != null {
            statusLabel.SetText("Open a workspace to use source control");
        }
        if historyBtn != null and historyBtn.WasClicked() and repoReady {
            ToggleHistory();
        }
        if loadMoreBtn != null and loadMoreBtn.WasClicked() and viewMode == "history" {
            RunOrQueue("log", "", "");
        }
        if fetchBtn != null and fetchBtn.WasClicked()
           and CanRunRepositoryAction("fetching") {
            RunOrQueue("fetch", "", "");
        }

        if sideBySideButton != null and sideBySideButton.WasClicked()
           and viewMode == "status" and CanRunRepositoryAction("side-by-side diff") {
            var sbsPath = SelectedPathForAction("side-by-side diff");
            if sbsPath != "" { RunOrQueue("show", sbsPath, ""); }
        }

        if stageAllBtn.WasClicked() and CanRunRepositoryAction("staging changes") {
            RunOrQueue("stageAll", "", "");
        }
        if stageBtn.WasClicked() and CanRunRepositoryAction("staging a file") {
            var p = SelectedPathForAction("stage");
            if p != "" { RunOrQueue("stage", p, ""); }
        }
        if unstageBtn.WasClicked() and CanRunRepositoryAction("unstaging a file") {
            var p2 = SelectedPathForAction("unstage");
            if p2 != "" { RunOrQueue("unstage", p2, ""); }
        }
        if takeCurrentBtn != null and takeCurrentBtn.WasClicked()
           and CanRunRepositoryAction("choosing a conflict side") {
            var currentPath = SelectedPathForAction("take current");
            if currentPath != "" { RunOrQueue("takeours", currentPath, ""); }
        }
        if takeIncomingBtn != null and takeIncomingBtn.WasClicked()
           and CanRunRepositoryAction("choosing a conflict side") {
            var incomingPath = SelectedPathForAction("take incoming");
            if incomingPath != "" { RunOrQueue("taketheirs", incomingPath, ""); }
        }
        if continueOperationBtn != null and continueOperationBtn.WasClicked() {
            if operationState == "merging" { RunOrQueue("mergeContinue", "", ""); }
            else if operationState == "rebasing" { RunOrQueue("rebaseContinue", "", ""); }
        }
        if skipRebaseBtn != null and skipRebaseBtn.WasClicked()
           and (operationState == "rebasing" or operationState == "conflict-rebase") {
            RunOrQueue("rebaseSkip", "", "");
        }
        var commitRequested = commitBtn.WasClicked();
        if commitInput.IsFocused()
           and Input.Keyboard.WasPressed(Zanna.Input.Key.Enter) {
            commitRequested = true;
        }
        if commitRequested and CanRunRepositoryAction("committing") {
            var msg = commitInput.get_Text();
            if HasConflicts() {
                statusLabel.SetText(
                    "Resolve and Stage every conflict before committing");
            } else if HasStagedChanges() == false {
                statusLabel.SetText("Stage at least one change before committing");
            } else if Str.get_Length(Str.Trim(msg)) > 0 {
                RunOrQueue("commit", "", msg);
            } else {
                statusLabel.SetText("Enter a commit message");
            }
        }
        if pushBtn.WasClicked() and CanRunRepositoryAction("pushing") { RunOrQueue("push", "", ""); }
        if pullBtn.WasClicked() and CanRunRepositoryAction("pulling") {
            var strategy = "pullFf";
            if pullStrategy != null and pullStrategy.Selected == 1 {
                strategy = "pullMerge";
            } else if pullStrategy != null and pullStrategy.Selected == 2 {
                strategy = "pullRebase";
            }
            RunOrQueue(strategy, "", "");
        }
        if abortOperationBtn != null and abortOperationBtn.WasClicked() {
            if operationState == "merging" or operationState == "conflict-merge" {
                RunOrQueue("mergeAbort", "", "");
            } else if operationState == "rebasing"
                      or operationState == "conflict-rebase" {
                RunOrQueue("rebaseAbort", "", "");
            }
        }

        if statusList.WasSelectionChanged() {
            HandleSelection();
        }
        UpdateActionStates();

        if activeJob != null {
            if activeJob.Pump() == false {
                CompleteJob(activeJob);
            } else {
                statusLabel.SetText(QueueSuffix("Running git " + activeJob.kind + "..."));
            }
            UpdateActionStates();
            return;
        }

        DrainQueue();
        UpdateActionStates();
    }

}
