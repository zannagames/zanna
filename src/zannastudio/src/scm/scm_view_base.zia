//
// File: zannastudio/src/scm/scm_view_base.zia
// Purpose: Coordinate asynchronous Git operations and Source Control UI state.
// Key invariants:
//   - Mutating Git jobs are serialized through a bounded visible queue.
//   - Network credentials remain in configured Git/SSH brokers and never enter
//     a Studio text field.
//   - Worktree diff reads are bounded and non-trapping.
//   - Missing workspaces and non-repositories expose truthful disabled actions.
//   - Sidebar controls wrap, remain keyboard reachable, and reflect live context.
// Ownership/Lifetime: Owns queued jobs/widgets and borrows the diff overlay.
// Links: zannastudio/src/scm/scm_git.zia,
//        zannastudio/src/ui/diff_view.zia
//
//===----------------------------------------------------------------------===//

module scm_view_base;

bind "scm_git";
bind "../ui/diff_view";
bind "../services/safe_io";

bind Zanna.GUI as GUI;
bind Str = Zanna.String;
bind IO = Zanna.IO;
bind Path = Zanna.IO.Path;
bind Input = Zanna.Input;

// ============================================================================
// MODULE: scm_view
// PURPOSE: Source Control panel controller for async Git operations.
//
// WHERE-THIS-FITS: Built into AppShell's `scmViewHost`. main.zia calls Setup()
//          once, SetRepo(rootPath) for the active project, and HandleEvents() each
//          frame. This module owns widget polling and the active GitJob lifecycle.
//
// KEY-DESIGN-CHOICES:
//   * SERIALIZED JOBS WITH A VISIBLE QUEUE. Git operations mutate shared
//     repository state; one runs at a time and later requests wait in a small
//     bounded queue (plan 11) instead of being rejected.
//   * STATUS REFRESH AFTER WRITES. Stage/unstage/commit/push/pull run in the
//     background, then enqueue a fresh status snapshot when they complete.
//   * STRUCTURED ROW DATA. The selected row stores the repo-relative path (or
//     sha, in history mode), so commands never parse display labels.
//   * NETWORK OPS USE CREDENTIAL BROKERS. Push/pull inherit Git Credential
//     Manager, credential-helper, askpass, SSH-agent, proxy, and certificate
//     configuration through a process environment overlay. Studio does not
//     collect password or passphrase text.
// ============================================================================

final HISTORY_PAGE_SIZE = 50;
final MAX_PENDING_JOBS = 8;
final MAX_SCM_DIFF_BYTES = 8000000;
final SCM_CONTROLS_COMPACT_MAX_WIDTH = 360.0;

/// @brief Return whether Source Control should use narrow action bases.
func ScmUsesCompactControls(width: Number) -> Boolean {
    return width > 0.0 and width <= SCM_CONTROLS_COMPACT_MAX_WIDTH;
}

/// @brief One queued SCM request waiting for the active job to finish.
class PendingAction {
    expose String kind;
    expose String path;
    expose String message;
    expose Integer repositoryGeneration;

    expose func init() {
        kind = "";
        path = "";
        message = "";
        repositoryGeneration = 0;
    }
}

/// @brief Source Control panel controller.
class ScmViewBase {
    expose scm_git.Git git;
    expose scm_git.GitJob activeJob;
    expose GUI.VBox host;
    expose GUI.Label branchLabel;
    expose GUI.Label statusLabel;
    expose GUI.Flex topRow;
    expose GUI.ListBox statusList;
    expose GUI.TextInput commitInput;
    expose GUI.Button refreshBtn;
    expose GUI.Button cancelBtn;
    expose GUI.Button fetchBtn;
    expose GUI.Button pushBtn;
    expose GUI.Button pullBtn;
    expose GUI.Dropdown pullStrategy;
    expose GUI.Button historyBtn;
    expose GUI.Button loadMoreBtn;
    expose GUI.Button stageBtn;
    expose GUI.Button unstageBtn;
    expose GUI.Button stageAllBtn;
    expose GUI.Button abortOperationBtn;
    expose GUI.Button takeCurrentBtn;
    expose GUI.Button takeIncomingBtn;
    expose GUI.Button continueOperationBtn;
    expose GUI.Button skipRebaseBtn;
    expose GUI.Flex stageRow;
    expose GUI.Flex commitRow;
    expose GUI.Button commitBtn;
    expose GUI.OutputPane diffPane;
    expose GUI.Button sideBySideButton;
    expose diff_view.DiffView diffOverlay;
    expose Boolean ready;
    expose Boolean repoReady;
    expose Boolean repoContextInitialized;
    expose String repoPath;
    expose String queuedDiffPath;
    expose List[PendingAction] pendingJobs;
    expose String viewMode;      // "status" | "history" | "commitfiles"
    expose Integer historyLoaded; // commits loaded so far (paging offset)
    expose String historySha;     // commit backing commitfiles mode
    expose String pendingOldText; // stash between showold and shownew jobs
    expose String pendingDiffFile;
    expose String pendingDiffStatus;
    expose scm_git.GitStatus lastStatus;
    expose Boolean compactControls;
    expose Integer repositoryGeneration;
    expose String operationState;
    expose GUI.VirtualList statusRows;
    expose List[String] statusRowData;
    expose List[String] statusRowMeta;

    expose func init() {
        InitializeState();
    }

    /// @brief Initialize Source Control state for the public job controller.
    expose func InitializeState() {
        git = new scm_git.Git();
        activeJob = null;
        host = null;
        ready = false;
        repoReady = false;
        repoContextInitialized = false;
        repoPath = "";
        queuedDiffPath = "";
        pendingJobs = [];
        viewMode = "status";
        historyLoaded = 0;
        historySha = "";
        pendingOldText = "";
        pendingDiffFile = "";
        pendingDiffStatus = "";
        lastStatus = new scm_git.GitStatus();
        compactControls = false;
        repositoryGeneration = 0;
        operationState = "idle";
        statusRows = GUI.VirtualList.New(0, 18, 100);
        statusRowData = [];
        statusRowMeta = [];
    }

    /// @brief Build the Source Control widgets into @p host.
    expose func Setup(hostArg: GUI.VBox) {
        if hostArg == null { return; }
        host = hostArg;

        branchLabel = GUI.Label.New(host, "Source Control");
        statusLabel = GUI.Label.New(host, "Idle");

        topRow = GUI.Flex.New();
        topRow.SetDirection(GUI.FlexDirection.Row);
        topRow.SetWrap(GUI.FlexWrap.Wrap);
        topRow.SetAlign(GUI.Align.Center);
        topRow.SetGap(4.0);
        host.AddChild(topRow);
        refreshBtn = GUI.Button.New(topRow, "Refresh");
        refreshBtn.SetAccessibleName("Refresh source control");
        refreshBtn.SetTooltip("Refresh repository status");
        cancelBtn = GUI.Button.New(topRow, "Cancel");
        cancelBtn.SetAccessibleName("Cancel source control jobs");
        cancelBtn.SetTooltip("Cancel the active Git job and queued operations");
        fetchBtn = GUI.Button.New(topRow, "Fetch");
        fetchBtn.SetAccessibleName("Fetch repository remotes");
        fetchBtn.SetTooltip("Fetch and prune remote tracking references");
        pushBtn = GUI.Button.New(topRow, "Push");
        pushBtn.SetAccessibleName("Push repository");
        pushBtn.SetTooltip(
            "Push using the configured Git credential helper or SSH agent");
        pullBtn = GUI.Button.New(topRow, "Pull");
        pullBtn.SetAccessibleName("Pull repository");
        pullBtn.SetTooltip(
            "Fetch and integrate using the selected explicit strategy");
        pullStrategy = GUI.Dropdown.New(topRow);
        pullStrategy.SetAccessibleName("Pull integration strategy");
        pullStrategy.SetTooltip("Choose fast-forward only, merge, or rebase");
        pullStrategy.AddItem("Fast-forward only");
        pullStrategy.AddItem("Merge");
        pullStrategy.AddItem("Rebase");
        pullStrategy.SetSelected(0);
        historyBtn = GUI.Button.New(topRow, "History");
        historyBtn.SetAccessibleName("Toggle repository history");
        historyBtn.SetTooltip("Switch between changes and commit history");
        loadMoreBtn = GUI.Button.New(topRow, "More");
        loadMoreBtn.SetAccessibleName("Load more repository history");
        loadMoreBtn.SetTooltip("Load the next page of commits");
        loadMoreBtn.SetVisible(false);

        statusList = GUI.ListBox.New(host);
        statusList.SetFlex(1.0);
        statusList.SetAccessibleName("Source control changes and history");
        if statusRows != null { statusRows.Bind(statusList); }

        stageRow = GUI.Flex.New();
        stageRow.SetDirection(GUI.FlexDirection.Row);
        stageRow.SetWrap(GUI.FlexWrap.Wrap);
        stageRow.SetAlign(GUI.Align.Center);
        stageRow.SetGap(4.0);
        host.AddChild(stageRow);
        stageBtn = GUI.Button.New(stageRow, "Stage");
        stageBtn.SetAccessibleName("Stage selected change");
        stageBtn.SetTooltip(
            "Stage the selected file; after resolving a conflict this marks it resolved");
        unstageBtn = GUI.Button.New(stageRow, "Unstage");
        unstageBtn.SetAccessibleName("Unstage selected change");
        unstageBtn.SetTooltip("Remove the selected file from the Git index");
        stageAllBtn = GUI.Button.New(stageRow, "Stage All");
        stageAllBtn.SetAccessibleName("Stage all changes");
        stageAllBtn.SetTooltip("Stage every current worktree change");
        abortOperationBtn = GUI.Button.New(stageRow, "Abort Operation");
        abortOperationBtn.SetAccessibleName("Abort merge or rebase");
        abortOperationBtn.SetTooltip("Abort the active merge or rebase operation");
        abortOperationBtn.SetVisible(false);
        takeCurrentBtn = GUI.Button.New(stageRow, "Take Current");
        takeCurrentBtn.SetAccessibleName("Use current version for selected conflict");
        takeCurrentBtn.SetTooltip("Replace the selected conflict with Git's current side; Stage to confirm");
        takeCurrentBtn.SetVisible(false);
        takeIncomingBtn = GUI.Button.New(stageRow, "Take Incoming");
        takeIncomingBtn.SetAccessibleName("Use incoming version for selected conflict");
        takeIncomingBtn.SetTooltip("Replace the selected conflict with Git's incoming side; Stage to confirm");
        takeIncomingBtn.SetVisible(false);
        continueOperationBtn = GUI.Button.New(stageRow, "Continue");
        continueOperationBtn.SetAccessibleName("Continue merge or rebase");
        continueOperationBtn.SetTooltip("Continue the active merge or rebase after every conflict is staged");
        continueOperationBtn.SetVisible(false);
        skipRebaseBtn = GUI.Button.New(stageRow, "Skip Commit");
        skipRebaseBtn.SetAccessibleName("Skip current rebase commit");
        skipRebaseBtn.SetTooltip("Skip the failing commit in the active rebase");
        skipRebaseBtn.SetVisible(false);

        commitRow = GUI.Flex.New();
        commitRow.SetDirection(GUI.FlexDirection.Row);
        commitRow.SetWrap(GUI.FlexWrap.Wrap);
        commitRow.SetAlign(GUI.Align.Center);
        commitRow.SetGap(4.0);
        host.AddChild(commitRow);
        commitInput = GUI.TextInput.New(commitRow);
        commitInput.SetFlex(1.0);
        commitInput.SetPreferredSize(140.0, 0.0);
        commitInput.SetPlaceholder("Commit message");
        commitInput.SetAccessibleName("Commit message");
        commitInput.SetTooltip("Commit staged changes (Enter)");
        commitBtn = GUI.Button.New(commitRow, "Commit");
        commitBtn.SetStyle(1);
        commitBtn.SetAccessibleName("Commit staged changes");
        commitBtn.SetTooltip("Commit staged changes with this message (Enter)");

        sideBySideButton = GUI.Button.New(host, "Side-by-Side Diff");
        sideBySideButton.SetIconName("split");
        sideBySideButton.SetAccessibleName("Open side-by-side source control diff");
        sideBySideButton.SetTooltip(
            "Compare the selected worktree file with HEAD");
        diffPane = GUI.OutputPane.New(host);
        diffPane.SetFlex(1.0);
        diffPane.SetAccessibleName("Source control diff and operation output");

        ready = true;
        SetRepo("");
    }


    /// @brief Point the concrete controller at a repository root.
    expose func SetRepo(_path: String) {}
}
