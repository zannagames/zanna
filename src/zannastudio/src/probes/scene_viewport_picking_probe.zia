//
// File: zannastudio/src/probes/scene_viewport_picking_probe.zia
// Purpose: Verify geometry-aware 3D picking, selection, and camera-plane pan.
// Key invariants:
//   - Visible mesh bounds, not only node origins, are selectable.
//   - The nearest overlapping visible mesh wins in shaded and wireframe modes.
//   - Meshless origin markers remain selectable after the mesh query misses.
//   - Replace, additive, toggle, and blank selection are workspace-only.
//   - Camera-plane pan follows pointer motion and never edits canonical VSCN.
// Ownership/Lifetime:
//   - The probe owns one hidden AppShell, document, editor, and input harness.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        docs/adr/0169-super-modifier-keys-and-studio-viewport-picking.md
//
//===----------------------------------------------------------------------===//

module scene_viewport_picking_probe;

// ============================================================================
// MODULE: scene_viewport_picking_probe
// PURPOSE: Keep rendered-geometry selection and camera navigation focused.
//
// WHERE-THIS-FITS: The broad editor probe owns content transactions. This
//          display probe owns the viewport's presentation-only hit behavior.
//
// TEACHING-NOTE: The fixture clicks away from every origin marker. A passing
//          test therefore proves the production camera ray selected geometry.
// ============================================================================

bind "../core/document_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_3d";
bind "../ui/scene_selection";
bind "scene_viewport_picking_routing_probe";

bind Convert = Zanna.Core.Convert;
bind GUI = Zanna.GUI;
bind Input = Zanna.Input;
bind Terminal = Zanna.Terminal;

func Near(actual: Number,
          expected: Number,
          tolerance: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference <= tolerance;
}

func HarnessCoordinate(shell: app_shell.AppShell,
                       logical: Number) -> Integer {
    var scale = shell.app.GetEffectiveScale();
    if scale <= 0.0 { scale = 1.0; }
    return Convert.NumToInt(logical * scale);
}

func ClickWidget(shell: app_shell.AppShell,
                 harness: GUI.TestHarness,
                 widget: GUI.Widget) {
    var x = HarnessCoordinate(
        shell, widget.GetScreenX() + widget.GetScreenWidth() / 2.0);
    var y = HarnessCoordinate(
        shell, widget.GetScreenY() + widget.GetScreenHeight() / 2.0);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

/// @brief Click one logical row center in a menu anchored below @p button.
func ClickCommandMenuOffset(shell: app_shell.AppShell,
                            harness: GUI.TestHarness,
                            button: GUI.Button,
                            offsetY: Number) {
    var x = HarnessCoordinate(shell, button.GetScreenX())
        + Convert.NumToInt(20.0);
    var y = HarnessCoordinate(
        shell, button.GetScreenY() + button.GetScreenHeight())
        + Convert.NumToInt(offsetY);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

func ClickViewport(shell: app_shell.AppShell,
                   harness: GUI.TestHarness,
                   editor: scene_editor_3d.SceneEditor3D,
                   localX: Integer,
                   localY: Integer) {
    var x = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenX() + localX);
    var y = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenY() + localY);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

func Fail(shell: app_shell.AppShell,
          harness: GUI.TestHarness,
          reason: String) {
    if harness != null { harness.UnbindApp(); }
    if shell != null { shell.Destroy(); }
    Terminal.Say("RESULT: fail " + reason);
}

/// @brief Typed fixture shared by serial viewport-picking scenarios.
class ViewportPickingProbeContext {
    expose app_shell.AppShell shell;
    expose scene_editor_3d.SceneEditor3D editor;
    expose document_manager.DocumentManager documents;
    expose document.Document sceneDoc;
    expose GUI.TestHarness harness;
    expose Integer emptyIndex;
    expose Integer centerX;
    expose Integer centerY;
    expose Integer meshX;
    expose String canonical;
    expose Integer revision;
    expose Integer undoCount;
}

/// @brief Run the VerifyInputAndInitialPicking viewport-picking scenario.
func VerifyInputAndInitialPicking(ctx: ViewportPickingProbeContext) -> Boolean {
    if Input.Key.LeftSuper != 343 or Input.Key.RightSuper != 347
       or Input.Keyboard.KeyName(Input.Key.LeftSuper) != "Left Super"
       or Input.Keyboard.KeyName(Input.Key.RightSuper) != "Right Super" {
        Terminal.Say("RESULT: fail public Super key constants");
        return false;
    }

    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Viewport Picking Probe", 1120, 760);

    var editor = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(editor,shell.workbench.scene3DHost, shell.app);
    var documents = new document_manager.DocumentManager();
    var sceneDoc = documents.NewScene3DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);
    editor.Activate(sceneDoc);
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    editor.Pump(sceneDoc);
    shell.Render();

    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, harness, "automation app binding");
        return false;
    }

    if editor.createMenuButton.IsVisible() == false
       or editor.addBoxButton.IsVisible() {
        Fail(shell, harness, "compact creation overflow visibility");
        return false;
    }
    ClickWidget(shell, harness, editor.createMenuButton);
    editor.Pump(sceneDoc);
    shell.Render();
    if editor.createMenu.IsVisible() == false {
        Fail(shell, harness, "creation menu did not open");
        return false;
    }
    // Two 28px rows, one 9px separator, then the Box row.
    ClickCommandMenuOffset(
        shell, harness, editor.createMenuButton, 83.0);
    if editor.Pump(sceneDoc) == false {
        Fail(shell, harness,
             "far box production action: button="
             + editor.createMenuButton.GetScreenX() + ","
             + editor.createMenuButton.GetScreenY() + ","
             + editor.createMenuButton.GetScreenHeight()
             + " menu=" + editor.createMenu.IsVisible()
             + " scale=" + shell.app.GetEffectiveScale()
             + " app=" + shell.app.GetWidth() + "x"
             + shell.app.GetHeight());
        return false;
    }
    shell.Render();
    shell.Poll();
    ClickWidget(shell, harness, editor.createMenuButton);
    editor.Pump(sceneDoc);
    shell.Render();
    ClickCommandMenuOffset(
        shell, harness, editor.createMenuButton, 83.0);
    if editor.Pump(sceneDoc) == false {
        Fail(shell, harness, "near box production action");
        return false;
    }
    shell.Render();
    shell.Poll();
    var emptyIndex = editor.AddEmptyNode("Meshless marker", -1);
    if emptyIndex != 2 {
        Fail(shell, harness, "meshless marker fixture: got=" + emptyIndex
             + " flat=" + editor.flatNodes.count()
             + " undo=" + editor.undoStack.count());
        return false;
    }

    editor.viewYawDegrees = 0;
    editor.viewPitchDegrees = 0;
    editor.viewScale = 40;
    editor.viewTargetX = 0.0;
    editor.viewTargetY = 0.0;
    editor.viewTargetZ = 0.0;
    if editor.SetNodeTransform(0, 0.0, 0.0, 0.0, 4.0, 4.0, 4.0)
          == false
       or editor.SetNodeTransform(1, 0.0, 0.0, 2.0, 4.0, 4.0, 4.0)
          == false
       or editor.SetNodeTransform(
              emptyIndex, 5.0, 0.0, 0.0, 1.0, 1.0, 1.0) == false {
        Fail(shell, harness, "overlapping depth fixture transforms");
        return false;
    }

    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    ctx.harness = harness;
    ctx.emptyIndex = emptyIndex;
    return true;
}

/// @brief Run the VerifyMeshPickingAndDragSetup viewport-picking scenario.
func VerifyMeshPickingAndDragSetup(ctx: ViewportPickingProbeContext) -> Boolean {
    var shell = ctx.shell;
    var editor = ctx.editor;
    var documents = ctx.documents;
    var sceneDoc = ctx.sceneDoc;
    var harness = ctx.harness;
    var emptyIndex = ctx.emptyIndex;

    editor.Pump(sceneDoc);
    shell.Render();

    var centerX = editor.renderedViewportWidth / 2;
    var centerY = editor.renderedViewportHeight / 2;
    var meshX = centerX + 30;
    var firstHit = editor.ViewportNodeAt(meshX, centerY);
    if editor.projectedX.count() != 3
       or firstHit != 1 {
        Fail(shell, harness,
             "nearest visible mesh bounds did not win away from origins: hit="
             + firstHit + " projected=" + editor.projectedX.count()
             + "/" + editor.projectedY.count()
             + " flat=" + editor.flatNodes.count()
             + " viewport=" + editor.renderedViewportWidth
             + "x" + editor.renderedViewportHeight
             + " sample=" + meshX + "," + centerY
             + " projected0=" + editor.projectedX.get(0)
             + "," + editor.projectedY.get(0)
             + " projected1=" + editor.projectedX.get(1)
             + "," + editor.projectedY.get(1)
             + " worldZ=" + editor.flatNodes.get(0).WorldPosition.Z
             + "/" + editor.flatNodes.get(1).WorldPosition.Z);
        return false;
    }

    editor.SelectSceneNodes([], -1);
    var canonical = sceneDoc.content;
    var revision = editor.GetRevision();
    var undoCount = editor.undoStack.count();
    var redoCount = editor.redoStack.count();
    var dirty = sceneDoc.isModified;
    ClickViewport(shell, harness, editor, meshX, centerY);
    if editor.Pump(sceneDoc)
       or editor.selectedIndex != 1
       or editor.selectedIndices.count() != 1
       or sceneDoc.content != canonical
       or editor.GetRevision() != revision
       or editor.undoStack.count() != undoCount
       or editor.redoStack.count() != redoCount
       or sceneDoc.isModified != dirty {
        Fail(shell, harness,
             "production geometry click changed content or missed near box");
        return false;
    }
    shell.Render();
    shell.Poll();

    if editor.ApplyViewportSelection(0, true, false) == false
       or editor.selectedIndex != 0
       or editor.selectedIndices.count() != 2
       or scene_selection.Contains(editor.selectedIndices, 0) == false
       or scene_selection.Contains(editor.selectedIndices, 1) == false {
        Fail(shell, harness, "additive viewport selection");
        return false;
    }
    if editor.ApplyViewportSelection(1, false, true) == false
       or editor.selectedIndex != 0
       or editor.selectedIndices.count() != 1
       or scene_selection.Contains(editor.selectedIndices, 0) == false {
        Fail(shell, harness, "primary-modifier selection toggle");
        return false;
    }
    if editor.ApplyViewportSelection(-1, true, false)
       or editor.selectedIndices.count() != 1 {
        Fail(shell, harness, "modified blank click did not preserve selection");
        return false;
    }
    if editor.ApplyViewportSelection(-1, false, false) == false
       or editor.selectedIndex != -1
       or editor.selectedIndices.count() != 0 {
        Fail(shell, harness, "plain blank click did not clear selection");
        return false;
    }

    var markerX = editor.projectedX.get(emptyIndex);
    var markerY = editor.projectedY.get(emptyIndex);
    var markerHit = editor.ViewportNodeAt(markerX, markerY);
    if markerHit != emptyIndex {
        Fail(shell, harness,
             "meshless marker fallback: hit=" + markerHit
             + " expected=" + emptyIndex
             + " marker=" + markerX + "," + markerY
             + " target=" + editor.viewTargetX + ","
             + editor.viewTargetY + "," + editor.viewTargetZ);
        return false;
    }

    editor.SetViewportMode(scene_editor_3d.VIEWPORT_MODE_WIREFRAME);
    editor.Pump(sceneDoc);
    shell.Render();
    if editor.ViewportNodeAt(meshX, centerY) != 1 {
        Fail(shell, harness, "wireframe picking diverged from shaded picking");
        return false;
    }
    editor.SetViewportMode(scene_editor_3d.VIEWPORT_MODE_SHADED);
    editor.Pump(sceneDoc);
    shell.Render();

    // Exact pixel-for-pixel pan displacement is an orthographic property:
    // perspective parallax legitimately moves off-target-plane points by a
    // depth-dependent amount (ADR 0183). Pin the exact contract in ortho.
    editor.SetViewProjection(false);
    editor.Pump(sceneDoc);
    shell.Render();
    var beforeX = editor.projectedX.get(1);
    var beforeY = editor.projectedY.get(1);
    canonical = sceneDoc.content;
    revision = editor.GetRevision();
    undoCount = editor.undoStack.count();
    redoCount = editor.redoStack.count();
    dirty = sceneDoc.isModified;
    if editor.PanViewportByPixels(40.0, 20.0) == false {
        Fail(shell, harness, "camera-plane pan rejected pointer delta");
        return false;
    }
    editor.Pump(sceneDoc);
    shell.Render();
    if Near(editor.viewTargetX, -1.0, 0.000001) == false
       or Near(editor.viewTargetY, 0.5, 0.000001) == false
       or Near(editor.viewTargetZ, 0.0, 0.000001) == false
       or Near(editor.projectedX.get(1), beforeX + 40, 1.0) == false
       or Near(editor.projectedY.get(1), beforeY + 20, 1.0) == false
       or sceneDoc.content != canonical
       or editor.GetRevision() != revision
       or editor.undoStack.count() != undoCount
       or editor.redoStack.count() != redoCount
       or sceneDoc.isModified != dirty
       or Near(sceneDoc.scene3DWorkspace.viewTargetX, -1.0, 0.000001)
            == false
       or Near(sceneDoc.scene3DWorkspace.viewTargetY, 0.5, 0.000001)
            == false {
        Fail(shell, harness,
             "camera-plane pan drifted or mutated canonical document state: "
             + "target=" + editor.viewTargetX + "," + editor.viewTargetY
             + "," + editor.viewTargetZ
             + " projected=" + editor.projectedX.get(1)
             + "," + editor.projectedY.get(1)
             + " expected=" + (beforeX + 40) + "," + (beforeY + 20)
             + " workspace="
             + sceneDoc.scene3DWorkspace.viewTargetX + ","
             + sceneDoc.scene3DWorkspace.viewTargetY + ","
             + sceneDoc.scene3DWorkspace.viewTargetZ
             + " content=" + (sceneDoc.content == canonical)
             + " revision=" + editor.GetRevision() + "/" + revision
             + " history=" + editor.undoStack.count() + "/" + undoCount
             + "," + editor.redoStack.count() + "/" + redoCount
             + " dirty=" + sceneDoc.isModified + "/" + dirty);
        return false;
    }
    editor.SetViewProjection(true);
    editor.Pump(sceneDoc);
    shell.Render();
    if editor.PanViewportByPixels(0.0, 0.0) {
        Fail(shell, harness, "zero camera-plane pan was not a no-op");
        return false;
    }

    if sceneDoc.content != canonical
       or editor.GetRevision() != revision
       or editor.undoStack.count() != undoCount
       or editor.redoStack.count() != redoCount
       or sceneDoc.isModified != dirty {
        Fail(shell, harness, "viewport interactions changed VSCN history");
        return false;
    }


    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    ctx.harness = harness;
    ctx.emptyIndex = emptyIndex;
    ctx.centerX = centerX;
    ctx.centerY = centerY;
    ctx.meshX = meshX;
    ctx.canonical = canonical;
    ctx.revision = revision;
    ctx.undoCount = undoCount;
    return true;
}

/// @brief Run the VerifyPointerDragsAndSelection viewport-picking scenario.
func VerifyPointerDragsAndSelection(ctx: ViewportPickingProbeContext) -> Boolean {
    var shell = ctx.shell;
    var editor = ctx.editor;
    var documents = ctx.documents;
    var sceneDoc = ctx.sceneDoc;
    var harness = ctx.harness;
    var canonical = ctx.canonical;
    var revision = ctx.revision;

    // Selection-scoped inspector: node groups appear only with a selection,
    // single-selection groups need exactly one node, and the Scene tab
    // discloses one complete topic at a time. Scoping is pure presentation.
    var emptySelection: List[Integer] = [];
    editor.SelectSceneNodes(emptySelection, -1);
    editor.Pump(sceneDoc);
    editor.SetSceneInspectorSection(
        scene_editor_3d.SCENE_INSPECTOR_WORLD, false);
    if editor.lightInspector.group.IsVisible()
       or editor.nameInput.IsVisible()
       or editor.cameraInspector.group.IsVisible()
       or editor.bakeGroup.IsVisible()
       or editor.envGroup.IsVisible() == false {
        Fail(shell, harness,
             "empty selection did not scope the inspector to World");
        return false;
    }
    editor.SetSceneInspectorSection(
        scene_editor_3d.SCENE_INSPECTOR_LIGHTING, false);
    if editor.bakeGroup.IsVisible() == false
       or editor.envGroup.IsVisible()
       or sceneDoc.content != canonical {
        Fail(shell, harness,
             "Lighting topic did not isolate its complete scene group");
        return false;
    }
    editor.SelectSceneNodes([0], 0);
    editor.Pump(sceneDoc);
    // Component groups are presence-scoped: this mesh node carries no light,
    // camera, or collider, so those groups stay hidden and the Add-component
    // row offers them instead.
    if editor.nameInput.IsVisible() == false
       or editor.metadataInspector.group.IsVisible() == false
       or editor.lightInspector.group.IsVisible()
       or editor.cameraInspector.group.IsVisible()
       or editor.colliderInspector.group.IsVisible()
       or editor.addComponentRow.IsVisible() == false {
        Fail(shell, harness,
             "single selection did not present presence-scoped groups");
        return false;
    }
    // Adding the Light choice creates a default light as one transaction and
    // reveals its group; Undo restores the canonical document exactly.
    editor.addComponentDropdown.SetSelected(0);
    if editor.AddSelectedComponentChoice() == false
       or editor.lightInspector.group.IsVisible() == false
       or editor.GetRevision() != revision + 1 {
        Fail(shell, harness,
             "Add component did not create a default light: revision="
             + editor.GetRevision() + "/" + (revision + 1));
        return false;
    }
    if editor.Undo() == false
       or sceneDoc.content != canonical
       or editor.lightInspector.group.IsVisible() {
        Fail(shell, harness,
             "undoing the added light did not restore canonical bytes");
        return false;
    }
    // Bytes are canonical again; the add/undo pair advanced the revision.
    revision = editor.GetRevision();
    editor.SelectSceneNodes([0], 0);
    editor.Pump(sceneDoc);
    var pairSelection: List[Integer] = [];
    pairSelection.add(0);
    pairSelection.add(1);
    editor.SelectSceneNodes(pairSelection, 0);
    editor.Pump(sceneDoc);
    if editor.lightInspector.group.IsVisible()
       or editor.cameraInspector.group.IsVisible()
       or editor.metadataInspector.group.IsVisible()
       or editor.addComponentRow.IsVisible() == false
       or sceneDoc.content != canonical
       or editor.GetRevision() != revision {
        Fail(shell, harness,
             "multi-selection scoping drifted or mutated the document");
        return false;
    }

    // Live transform editing: a differing spinner value commits exactly one
    // canonical transaction once the spinners are unfocused, and Undo
    // restores the exact prior bytes. Echo values equal to the node commit
    // nothing.
    editor.SelectSceneNodes([0], 0);
    editor.Pump(sceneDoc);
    var liveBaseline = sceneDoc.content;
    var liveRevision = editor.GetRevision();
    editor.positionX.SetValue(editor.positionX.Value);
    if editor.Pump(sceneDoc)
       or editor.GetRevision() != liveRevision {
        Fail(shell, harness,
             "an unchanged spinner echo created a live-edit commit");
        return false;
    }
    editor.positionX.SetValue(editor.positionX.Value + 2.0);
    if editor.Pump(sceneDoc) == false
       or editor.GetRevision() != liveRevision + 1
       or sceneDoc.content == liveBaseline {
        Fail(shell, harness,
             "a differing spinner value did not live-commit once: revision="
             + editor.GetRevision() + "/" + (liveRevision + 1));
        return false;
    }
    if editor.Undo() == false or sceneDoc.content != liveBaseline {
        Fail(shell, harness,
             "undoing the live transform edit did not restore exact bytes");
        return false;
    }

    // --- Triangle-accurate picking extras (ADR 0193) --------------------
    // Marquee, hover, and overlap cycling are workspace-only presentation.
    editor.viewTargetX = 0.0;
    editor.viewTargetY = 0.0;
    editor.viewTargetZ = 0.0;
    editor.SetViewProjection(false);

    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    ctx.harness = harness;
    ctx.canonical = canonical;
    ctx.revision = revision;
    return true;
}

/// @brief Run the VerifyCameraAndGizmoPicking viewport-picking scenario.
func VerifyCameraAndGizmoPicking(ctx: ViewportPickingProbeContext) -> Boolean {
    var shell = ctx.shell;
    var editor = ctx.editor;
    var documents = ctx.documents;
    var sceneDoc = ctx.sceneDoc;
    var harness = ctx.harness;
    var emptyIndex = ctx.emptyIndex;
    var centerX = ctx.centerX;
    var centerY = ctx.centerY;
    var meshX = ctx.meshX;
    var canonical = ctx.canonical;
    var revision = ctx.revision;
    var undoCount = ctx.undoCount;

    editor.SelectSceneNodes([], -1);
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    canonical = sceneDoc.content;
    revision = editor.GetRevision();
    undoCount = editor.undoStack.count();

    // A real marquee drag: press empty space, cross the threshold, release.
    // The rectangle covers both boxes' projected bounds but not the marker.
    var rectLeft = centerX - 140;
    var rectTop = centerY - 140;
    var rectRight = centerX + 100;
    var rectBottom = centerY + 100;
    var pressX = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenX() + rectLeft);
    var pressY = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenY() + rectTop);
    var releaseX = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenX() + rectRight);
    var releaseY = HarnessCoordinate(
        shell, editor.viewportImage.GetScreenY() + rectBottom);
    harness.SendMouse("move", pressX, pressY, 0);
    harness.SendMouse("down", pressX, pressY, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", releaseX, releaseY, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", releaseX, releaseY, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    if editor.selectedIndices.count() != 2
       or scene_selection.Contains(editor.selectedIndices, 0) == false
       or scene_selection.Contains(editor.selectedIndices, 1) == false
       or scene_selection.Contains(editor.selectedIndices, emptyIndex)
       or sceneDoc.content != canonical
       or editor.GetRevision() != revision
       or editor.undoStack.count() != undoCount {
        Fail(shell, harness,
             "marquee drag did not select exactly the covered boxes: count="
             + editor.selectedIndices.count()
             + " primary=" + editor.selectedIndex
             + " viewport=" + editor.renderedViewportWidth + "x"
             + editor.renderedViewportHeight
             + " cached-center=" + centerX + "," + centerY
             + " projected=" + editor.projectedX.get(0) + ","
             + editor.projectedY.get(0) + ";"
             + editor.projectedX.get(1) + ","
             + editor.projectedY.get(1) + ";"
             + editor.projectedX.get(emptyIndex) + ","
             + editor.projectedY.get(emptyIndex)
             + " rect=" + rectLeft + "," + rectTop + "-"
             + rectRight + "," + rectBottom
             + " scale=" + editor.viewScale);
        return false;
    }

    // Escape cancels an active marquee without clearing the selection.
    harness.SendMouse("move", pressX, pressY, 0);
    harness.SendMouse("down", pressX, pressY, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendMouse(
        "move", pressX + 60, pressY + 60, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendKey("escape", 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", pressX + 60, pressY + 60, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    if editor.selectedIndices.count() != 2
       or sceneDoc.content != canonical {
        Fail(shell, harness,
             "marquee Escape cleared the selection or changed content: count="
             + editor.selectedIndices.count());
        return false;
    }

    // Hover feedback follows the pointer without touching anything. The
    // selection clears first so the primary node's gizmo cannot claim the
    // sample point ahead of the hover query.
    editor.SelectSceneNodes([], -1);
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    harness.SendMouse(
        "move",
        HarnessCoordinate(
            shell, editor.viewportImage.GetScreenX() + meshX),
        HarnessCoordinate(
            shell, editor.viewportImage.GetScreenY() + centerY),
        0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    if editor.hoveredViewportNode != 1 {
        Fail(shell, harness,
             "hovering the front box did not track the hovered node: hover="
             + editor.hoveredViewportNode);
        return false;
    }
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", pressX, pressY, 0);
    harness.DispatchPending();
    editor.Pump(sceneDoc);
    if editor.hoveredViewportNode != -1
       or sceneDoc.content != canonical
       or editor.GetRevision() != revision {
        Fail(shell, harness,
             "hover over empty space did not clear or mutated state: hover="
             + editor.hoveredViewportNode);
        return false;
    }
    shell.Poll();
    shell.Render();

    // Overlap cycling walks front to back through stacked triangle hits.
    editor.SelectSceneNodes([1], 1);
    var cycled = editor.CycleViewportNodeAt(meshX, centerY, -1);
    if cycled != 0 {
        Fail(shell, harness,
             "cycling from the front box did not reach the back box: got="
             + cycled);
        return false;
    }
    editor.SelectSceneNodes([0], 0);
    cycled = editor.CycleViewportNodeAt(meshX, centerY, -1);
    if cycled != 1 {
        Fail(shell, harness,
             "cycling from the back box did not wrap to the front box: got="
             + cycled);
        return false;
    }

    // Creation ergonomics (1.4): the viewport spawn point resolves the
    // precise surface hit under the pointer, and falls back to the view
    // target over empty space with a camera-parallel ground plane.
    var spawn = editor.ViewportSpawnPoint(meshX, centerY);
    // The sample is deliberately off-center so viewport aspect changes can
    // reach either the front face or its adjacent side near the silhouette.
    if spawn.Z < 3.5 or spawn.Z > 4.05 {
        Fail(shell, harness,
             "surface spawn point missed the near box surface: z=" + spawn.Z);
        return false;
    }
    var emptySpawn = editor.ViewportSpawnPoint(rectLeft, rectTop);
    if Near(emptySpawn.X, editor.viewTargetX, 0.000001) == false
       or Near(emptySpawn.Y, editor.viewTargetY, 0.000001) == false
       or Near(emptySpawn.Z, editor.viewTargetZ, 0.000001) == false {
        Fail(shell, harness,
             "empty-space spawn point was not the view target: "
             + emptySpawn.X + "," + emptySpawn.Y + "," + emptySpawn.Z);
        return false;
    }


    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    ctx.harness = harness;
    ctx.centerY = centerY;
    ctx.meshX = meshX;
    ctx.canonical = canonical;
    return true;
}

/// @brief Run the VerifyScaledPickingAndCapture viewport-picking scenario.
func VerifyScaledPickingAndCapture(ctx: ViewportPickingProbeContext) -> Boolean {
    var shell = ctx.shell;
    var editor = ctx.editor;
    var documents = ctx.documents;
    var sceneDoc = ctx.sceneDoc;
    var harness = ctx.harness;
    var centerY = ctx.centerY;
    var meshX = ctx.meshX;
    var canonical = ctx.canonical;

    // The compact creation menu preserves every primitive and routes it
    // through the same view-target spawn transaction.
    editor.viewTargetX = 2.5;
    var beforeCount = editor.flatNodes.count();
    ClickWidget(shell, harness, editor.createMenuButton);
    editor.Pump(sceneDoc);
    shell.Render();
    // Cylinder follows Box, Sphere, and Plane in the same menu.
    ClickCommandMenuOffset(
        shell, harness, editor.createMenuButton, 167.0);
    if editor.Pump(sceneDoc) == false
       or editor.flatNodes.count() != beforeCount + 1 {
        Fail(shell, harness,
             "toolbar cylinder create did not add one node: count="
             + editor.flatNodes.count());
        return false;
    }
    var cylinderNode = editor.flatNodes.get(beforeCount);
    if cylinderNode.Mesh == null
       or Near(cylinderNode.WorldPosition.X, 2.5, 0.000001) == false {
        Fail(shell, harness,
             "cylinder did not spawn at the view target: x="
             + cylinderNode.WorldPosition.X);
        return false;
    }
    editor.viewTargetX = 0.0;
    if editor.Undo() == false or sceneDoc.content != canonical {
        Fail(shell, harness,
             "undoing the cylinder did not restore canonical bytes");
        return false;
    }

    // Snap inversion (2.3): without Ctrl held the effective state follows
    // the checkbox both ways. (The harness cannot hold modifier keys, so
    // the inverted branch is code-reviewed rather than gesture-driven.)
    editor.SetGizmoSnapEnabled(false);
    if editor.EffectiveSnapEnabled() {
        Fail(shell, harness, "snap-off did not read as effectively off");
        return false;
    }
    editor.SetGizmoSnapEnabled(true);
    if editor.EffectiveSnapEnabled() == false {
        Fail(shell, harness, "snap-on did not read as effectively on");
        return false;
    }
    editor.SetGizmoSnapEnabled(false);

    // Camera quick views and bookmarks (2.4): pure workspace state.
    var cameraCanonical = sceneDoc.content;
    editor.SetQuickView(0);
    if editor.viewYawDegrees != 0 or editor.viewPitchDegrees != 80 {
        Fail(shell, harness, "Top quick view did not set its pose");
        return false;
    }
    editor.SetQuickView(2);
    if editor.viewYawDegrees != 90 or editor.viewPitchDegrees != 0 {
        Fail(shell, harness, "Right quick view did not set its pose");
        return false;
    }
    if editor.StoreCameraBookmark(3) == false {
        Fail(shell, harness, "storing camera bookmark 3 failed");
        return false;
    }
    editor.SetQuickView(1);
    editor.viewScale = 60;
    if editor.RecallCameraBookmark(3) == false
       or editor.viewYawDegrees != 90
       or editor.viewPitchDegrees != 0 {
        Fail(shell, harness,
             "recalling camera bookmark 3 did not restore the pose: "
             + editor.viewYawDegrees + "/" + editor.viewPitchDegrees);
        return false;
    }
    if editor.RecallCameraBookmark(5)
       or sceneDoc.content != cameraCanonical {
        Fail(shell, harness,
             "an empty bookmark recalled or camera state touched content");
        return false;
    }

    // Pick-lock (2.5): a locked node yields viewport picks to whatever
    // sits behind it, marquee skips it, and unlocking restores it.
    editor.SetViewProjection(false);
    editor.viewYawDegrees = 0;
    editor.viewPitchDegrees = 0;
    editor.viewTargetX = 0.0;
    editor.viewTargetY = 0.0;
    editor.viewTargetZ = 0.0;
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    editor.SelectSceneNodes([1], 1);
    if editor.ToggleSelectedPickLock() == false
       or editor.NodePickLocked(1) == false {
        Fail(shell, harness, "pick lock did not engage on the front box");
        return false;
    }
    var lockedPick = editor.ViewportNodeAt(meshX, centerY);
    if lockedPick != 0 {
        Fail(shell, harness,
             "a locked front box did not yield the pick to the back box: "
             + lockedPick);
        return false;
    }
    if editor.ToggleSelectedPickLock()
       or editor.NodePickLocked(1) {
        Fail(shell, harness, "pick unlock did not release the node");
        return false;
    }
    if editor.ViewportNodeAt(meshX, centerY) != 1 {
        Fail(shell, harness, "unlocking did not restore normal picking");
        return false;
    }

    // Shaded+Wire and stats v2 (3.2): the combined mode renders, keeps
    // picking identical, and stats never touch canonical state.
    var fidelityBaseline = sceneDoc.content;
    editor.showStats = true;
    editor.SetViewportMode(scene_editor_3d.VIEWPORT_MODE_SHADED_WIRE);
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
    if editor.ViewportNodeAt(meshX, centerY) != 1
       or sceneDoc.content != fidelityBaseline {
        Fail(shell, harness,
             "Shaded+Wire changed picking or content");
        return false;
    }

    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    ctx.harness = harness;
    return true;
}

/// @brief Run final history, command-menu, and pane-routing scenarios.
func VerifyFinalPointerRouting(
    ctx: ViewportPickingProbeContext) -> Boolean {
    return scene_viewport_picking_routing_probe.Verify(
        ctx.shell, ctx.editor, ctx.documents, ctx.sceneDoc, ctx.harness);
}

func main() {
    var ctx = new ViewportPickingProbeContext();
    if VerifyInputAndInitialPicking(ctx) == false { return; }
    if VerifyMeshPickingAndDragSetup(ctx) == false { return; }
    if VerifyPointerDragsAndSelection(ctx) == false { return; }
    if VerifyCameraAndGizmoPicking(ctx) == false { return; }
    if VerifyScaledPickingAndCapture(ctx) == false { return; }
    if VerifyFinalPointerRouting(ctx) == false { return; }
}
