//
// File: zannastudio/src/probes/scene_context_menu_probe.zia
// Purpose: Verify right-click routing for the scene-surface context menus.
// Key invariants:
//   - A hierarchy right-click selects the row under the pointer and opens the
//     hierarchy menu with selection-truthful item enablement.
//   - A viewport right-click opens its menu only when released in place; a
//     right-drag (fly-look) never opens a menu.
//   - The 2D canvas right-click opens the tool menu; opening any menu never
//     changes scene content, history, or revision.
// Ownership/Lifetime:
//   - The probe owns one hidden AppShell per editor plus one input harness.
// Links: zannastudio/src/ui/scene_context_menus_2d.zia,
//        zannastudio/src/ui/scene_context_menus_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_context_menu_probe;

// ============================================================================
// MODULE: scene_context_menu_probe
// PURPOSE: Pin the right-click routing contract for scene surfaces.
//
// WHERE-THIS-FITS: Menu-item actions call the same editor transactions the
//          aggregate probes already pin; this display probe owns the gesture
//          routing, fly suppression, and enablement truth.
//
// TEACHING-NOTE: Matching the app-level menu probes, items are not clicked
//          through synthetic input — menu geometry belongs to the GUI theme.
// ============================================================================

bind "../core/document";
bind "../core/document_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_clipboard";
bind "../ui/scene_context_menus_2d";
bind "../ui/scene_context_menus_3d";
bind "../ui/scene_editor_2d";
bind "../ui/scene_panels_2d";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_3d";

bind Convert = Zanna.Core.Convert;
bind GUI = Zanna.GUI;
bind Str = Zanna.String;
bind Terminal = Zanna.Terminal;

func HarnessCoordinate(shell: app_shell.AppShell,
                       logical: Number) -> Integer {
    var scale = shell.app.GetEffectiveScale();
    if scale <= 0.0 { scale = 1.0; }
    return Convert.NumToInt(logical * scale + 0.999999);
}

func ClickWidget2D(shell: app_shell.AppShell,
                   harness: GUI.TestHarness,
                   widget: GUI.Widget) {
    var x = HarnessCoordinate(
        shell, widget.GetScreenX() + widget.GetScreenWidth() / 2.0);
    var y = HarnessCoordinate(
        shell, widget.GetScreenY() + widget.GetScreenHeight() / 2.0);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

func Fail(shell: app_shell.AppShell,
          harness: GUI.TestHarness,
          reason: String) {
    if harness != null { harness.UnbindApp(); }
    if shell != null { shell.Destroy(); }
    Terminal.Say("RESULT: fail " + reason);
}

func main() {
    // ------------------------------------------------------------------ 3D
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Scene Context Menu Probe", 1240, 800);
    var editor3d = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(editor3d,shell.workbench.scene3DHost, shell.app);
    var menus3d = new scene_context_menus_3d.SceneContextMenus3D();
    menus3d.Setup();
    var documents = new document_manager.DocumentManager();
    var doc3d = documents.NewScene3DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);
    editor3d.Activate(doc3d);
    editor3d.Pump(doc3d);
    shell.Poll();
    shell.Render();
    editor3d.Pump(doc3d);
    shell.Render();

    var nodeIndex = editor3d.AddEmptyNode("Marker", -1);
    if nodeIndex < 0 {
        Fail(shell, null, "3D node fixture");
        return;
    }
    editor3d.SelectSceneNodes([nodeIndex], nodeIndex);
    editor3d.Pump(doc3d);
    shell.Poll();
    shell.Render();

    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, null, "3D bind");
        return;
    }
    var canonical = doc3d.content;
    var revision = editor3d.GetRevision();

    // Hierarchy right-click opens the menu with truthful enablement.
    var treeX = HarnessCoordinate(
        shell, editor3d.hierarchyTree.GetScreenX() + 40.0);
    var treeY = HarnessCoordinate(
        shell, editor3d.hierarchyTree.GetScreenY() + 14.0);
    harness.SendMouse("move", treeX, treeY, 1);
    harness.SendMouse("down", treeX, treeY, 1);
    harness.SendMouse("up", treeX, treeY, 1);
    harness.DispatchPending();
    editor3d.Pump(doc3d);
    menus3d.Pump(editor3d);
    if menus3d.hierarchyMenu.IsVisible() == false {
        Fail(shell, harness, "3D hierarchy right-click did not open its menu");
        return;
    }
    if menus3d.hierarchyRename.IsEnabled() == false
       or menus3d.hierarchyCreateChild.IsEnabled() == false
       or menus3d.hierarchyDuplicate.IsEnabled() == false
       or menus3d.hierarchyDelete.IsEnabled() == false {
        Fail(shell, harness, "3D single-selection enablement was wrong");
        return;
    }
    menus3d.hierarchyMenu.Hide();
    shell.Poll();
    shell.Render();

    // A right-click released in place opens the viewport menu.
    var viewX = HarnessCoordinate(
        shell, editor3d.viewportImage.GetScreenX() + 30.0);
    var viewY = HarnessCoordinate(
        shell, editor3d.viewportImage.GetScreenY() + 30.0);
    harness.SendMouse("move", viewX, viewY, 1);
    harness.SendMouse("down", viewX, viewY, 1);
    harness.SendMouse("up", viewX, viewY, 1);
    harness.DispatchPending();
    editor3d.Pump(doc3d);
    menus3d.Pump(editor3d);
    if menus3d.viewportMenu.IsVisible() == false {
        Fail(shell, harness, "3D viewport right-click did not open its menu");
        return;
    }
    menus3d.viewportMenu.Hide();
    shell.Poll();
    shell.Render();

    // A right-drag is fly-look: no menu may open. The press and the
    // drag-release land in separate frames, as they do for a real user.
    harness.SendMouse("move", viewX, viewY, 1);
    harness.SendMouse("down", viewX, viewY, 1);
    harness.DispatchPending();
    editor3d.Pump(doc3d);
    menus3d.Pump(editor3d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", viewX + 40, viewY + 24, 1);
    harness.SendMouse("up", viewX + 40, viewY + 24, 1);
    harness.DispatchPending();
    editor3d.Pump(doc3d);
    menus3d.Pump(editor3d);
    if menus3d.viewportMenu.IsVisible() {
        Fail(shell, harness, "3D fly drag opened the viewport menu");
        return;
    }

    // Routing and enablement never touch canonical state.
    if doc3d.content != canonical
       or editor3d.GetRevision() != revision {
        Fail(shell, harness, "3D menu routing changed content or history");
        return;
    }

    // Menu-created primitives spawn at the view target with the inline
    // rename armed; Undo restores the exact canonical bytes.
    editor3d.viewTargetX = 2.5;
    var beforeNodes = editor3d.flatNodes.count();
    if editor3d.AddPrimitiveFromMenu(
           scene_editor_3d.PRIMITIVE_CYLINDER, false) == false
       or editor3d.flatNodes.count() != beforeNodes + 1 {
        Fail(shell, harness, "menu cylinder create did not add one node");
        return;
    }
    var createdNode = editor3d.flatNodes.get(beforeNodes);
    var spawnDeltaX = createdNode.WorldPosition.X - 2.5;
    if spawnDeltaX < 0.0 { spawnDeltaX = 0.0 - spawnDeltaX; }
    if createdNode.Mesh == null
       or spawnDeltaX > 0.000001
       or editor3d.hierarchyTree.IsEditing() == false {
        Fail(shell, harness,
             "menu create did not spawn a mesh at the view target with "
             + "rename armed: x=" + createdNode.WorldPosition.X);
        return;
    }
    editor3d.hierarchyTree.CancelEdit();
    editor3d.viewTargetX = 0.0;
    if editor3d.Undo() == false or doc3d.content != canonical {
        Fail(shell, harness,
             "undoing the menu-created cylinder did not restore bytes");
        return;
    }
    harness.UnbindApp();
    shell.Destroy();

    // ------------------------------------------------------------------ 2D
    shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Scene Context Menu Probe 2D", 1240, 800);
    var editor2d = new scene_editor_2d.SceneEditor2D();
    scene_panels_2d.Build(editor2d,shell.workbench.scene2DHost, shell.app);
    var menus2d = new scene_context_menus_2d.SceneContextMenus2D();
    menus2d.Setup();
    var doc2d = documents.NewScene2DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_2D);
    editor2d.Activate(doc2d);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    editor2d.Pump(doc2d);
    shell.Render();

    if editor2d.AddSceneObject("enemy", "left", 0, 0) != 0 {
        Fail(shell, null, "2D object fixture");
        return;
    }
    editor2d.SelectSceneObjects([0], 0);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();

    harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, null, "2D bind");
        return;
    }
    var canonical2d = doc2d.content;

    var objTreeX = HarnessCoordinate(
        shell, editor2d.objectTree.GetScreenX() + 40.0);
    var objTreeY = HarnessCoordinate(
        shell, editor2d.objectTree.GetScreenY() + 14.0);
    harness.SendMouse("move", objTreeX, objTreeY, 1);
    harness.SendMouse("down", objTreeX, objTreeY, 1);
    harness.SendMouse("up", objTreeX, objTreeY, 1);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    menus2d.Pump(editor2d);
    if menus2d.hierarchyMenu.IsVisible() == false {
        Fail(shell, harness, "2D hierarchy right-click did not open its menu");
        return;
    }
    if menus2d.hierarchyRename.IsEnabled() == false
       or menus2d.hierarchyAddChild.IsEnabled() == false {
        Fail(shell, harness, "2D single-selection enablement was wrong");
        return;
    }
    menus2d.hierarchyMenu.Hide();
    shell.Poll();
    shell.Render();

    var canvasX = HarnessCoordinate(
        shell, editor2d.canvasImage.GetScreenX() + 24.0);
    var canvasY = HarnessCoordinate(
        shell, editor2d.canvasImage.GetScreenY() + 24.0);
    harness.SendMouse("move", canvasX, canvasY, 1);
    harness.SendMouse("down", canvasX, canvasY, 1);
    harness.SendMouse("up", canvasX, canvasY, 1);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    menus2d.Pump(editor2d);
    if menus2d.canvasMenu.IsVisible() == false {
        Fail(shell, harness, "2D canvas right-click did not open the tool menu");
        return;
    }
    menus2d.canvasMenu.Hide();

    if doc2d.content != canonical2d {
        Fail(shell, harness, "2D menu routing changed content");
        return;
    }

    // "Add Object Here" enables over scene cells and creates one selected,
    // rename-armed entity at the recorded click cell as one transaction.
    var addCellX = editor2d.CanvasCellAtPointX(canvasX);
    var addCellY = editor2d.CanvasCellAtPointY(canvasY);
    if menus2d.canvasAddObjectHere.IsEnabled() == false
       or addCellX < 0 or addCellY < 0 {
        Fail(shell, harness,
             "Add Object Here was not enabled over a scene cell: cell="
             + addCellX + "," + addCellY);
        return;
    }
    var beforeObjects = editor2d.scene.ObjectCount();
    var created = editor2d.CreateObjectAtCanvasPoint(canvasX, canvasY);
    if created != beforeObjects
       or editor2d.scene.ObjectX(created)
          != addCellX * editor2d.scene.TileWidth
       or editor2d.scene.ObjectY(created)
          != addCellY * editor2d.scene.TileHeight
       or editor2d.selectedObject != created
       or editor2d.objectTree.IsEditing() == false {
        Fail(shell, harness,
             "Add Object Here did not create a selected rename-armed "
             + "entity at the click cell: index=" + created);
        return;
    }
    editor2d.objectTree.CancelEdit();
    if editor2d.Undo() == false or doc2d.content != canonical2d {
        Fail(shell, harness,
             "undoing Add Object Here did not restore canonical bytes");
        return;
    }

    // Free placement math scales content pixels to scene pixels exactly:
    // whole display cells map to whole tiles, and a half cell to a half
    // tile (scaled before dividing, so no truncation applies).
    if editor2d.CanvasFreePixelX(editor2d.displayCellSize)
          != editor2d.scene.TileWidth
       or editor2d.CanvasFreePixelY(editor2d.displayCellSize * 2)
          != editor2d.scene.TileHeight * 2
       or editor2d.CanvasFreePixelX(editor2d.displayCellSize * 3)
          != editor2d.scene.TileWidth * 3 {
        Fail(shell, harness,
             "free-placement pixel math diverged from the tile scale: cell="
             + editor2d.displayCellSize
             + " tile=" + editor2d.scene.TileWidth
             + " x1=" + editor2d.CanvasFreePixelX(
                   editor2d.displayCellSize));
        return;
    }
    // Tile region operations (2.1): paste records the region, copy encodes
    // the exact block, delete clears as one transaction, undo restores.
    var block = scene_clipboard.EncodeTileBlock(2, 1, [7, 8]);
    if block == "" or scene_clipboard.HasTileBlock(block) == false {
        Fail(shell, harness, "tile block encode failed");
        return;
    }
    GUI.ClipboardText.SetText(block);
    var regionBaseline = doc2d.content;
    var regionUndo = editor2d.undoStack.count();
    if editor2d.PasteTileBlockAt(1, 1) == false
       or editor2d.scene.GetTile(0, 1, 1) != 7
       or editor2d.scene.GetTile(0, 2, 1) != 8
       or editor2d.undoStack.count() != regionUndo + 1
       or editor2d.tileRegionMinX != 1 or editor2d.tileRegionMaxX != 2
       or editor2d.tileRegionMinY != 1 or editor2d.tileRegionMaxY != 1 {
        Fail(shell, harness,
             "tile paste did not write one region transaction: t="
             + editor2d.scene.GetTile(0, 1, 1) + ","
             + editor2d.scene.GetTile(0, 2, 1)
             + " region=" + editor2d.tileRegionMinX + ".."
             + editor2d.tileRegionMaxX);
        return;
    }
    GUI.ClipboardText.SetText("");
    if editor2d.CopyTileRegion() == false {
        Fail(shell, harness, "tile region copy failed");
        return;
    }
    var copied = scene_clipboard.DecodeTileBlock(
        GUI.ClipboardText.GetText());
    if copied.valid == false or copied.width != 2 or copied.height != 1
       or copied.tiles.get(0) != 7 or copied.tiles.get(1) != 8 {
        Fail(shell, harness, "copied tile block did not round-trip");
        return;
    }
    if editor2d.DeleteTileRegion() == false
       or editor2d.scene.GetTile(0, 1, 1) != 0
       or editor2d.undoStack.count() != regionUndo + 2 {
        Fail(shell, harness, "tile region delete was not one transaction");
        return;
    }
    if editor2d.Undo() == false
       or editor2d.scene.GetTile(0, 1, 1) != 7
       or editor2d.Undo() == false
       or doc2d.content != regionBaseline {
        Fail(shell, harness,
             "undoing tile region edits did not restore exact bytes");
        return;
    }

    // Region stamp (2.1b): adopt the region as a stamp, then one real
    // paint click writes the whole grid-anchored block as one stroke.
    GUI.ClipboardText.SetText(block);
    if editor2d.PasteTileBlockAt(1, 1) == false
       or editor2d.UseTileRegionAsStamp() == false
       or editor2d.stampActive == false
       or editor2d.stampWidth != 2 or editor2d.stampHeight != 1 {
        Fail(shell, harness, "region stamp capture failed");
        return;
    }
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    var stampUndo = editor2d.undoStack.count();
    var stampX = HarnessCoordinate(
        shell,
        editor2d.canvasImage.GetScreenX()
        + 5 * editor2d.displayCellSize + 2.0);
    var stampY = HarnessCoordinate(
        shell,
        editor2d.canvasImage.GetScreenY()
        + 3 * editor2d.displayCellSize + 2.0);
    harness.SendMouse("move", stampX, stampY, 0);
    harness.SendMouse("down", stampX, stampY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", stampX, stampY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    editor2d.Pump(doc2d);
    if editor2d.scene.GetTile(0, 4, 3) != 7
       or editor2d.scene.GetTile(0, 5, 3) != 8
       or editor2d.undoStack.count() != stampUndo + 1 {
        Fail(shell, harness,
             "stamp click did not write one anchored block: t="
             + editor2d.scene.GetTile(0, 4, 3) + ","
             + editor2d.scene.GetTile(0, 5, 3)
             + " undo=" + editor2d.undoStack.count()
             + "/" + (stampUndo + 1));
        return;
    }
    editor2d.ClearTileStamp();
    if editor2d.stampActive {
        Fail(shell, harness, "stamp did not clear");
        return;
    }
    if editor2d.Undo() == false or editor2d.Undo() == false
       or doc2d.content != regionBaseline {
        Fail(shell, harness,
             "undoing stamp edits did not restore exact bytes");
        return;
    }

    // Line and ellipse tools (2.1c): a real drag writes the rasterized
    // shape as one transaction; undo restores exact bytes.
    editor2d.SetToolMode(scene_editor_2d.MODE_LINE);
    editor2d.tileSpinner.SetValue(9.0);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    var shapeUndo = editor2d.undoStack.count();
    var cell = editor2d.displayCellSize;
    var canvasBaseX = editor2d.canvasImage.GetScreenX();
    var canvasBaseY = editor2d.canvasImage.GetScreenY();
    var lineStartX = HarnessCoordinate(shell, canvasBaseX + cell + 2.0);
    var lineStartY = HarnessCoordinate(shell, canvasBaseY + cell + 2.0);
    var lineEndX = HarnessCoordinate(
        shell, canvasBaseX + 4 * cell + 2.0);
    harness.SendMouse("move", lineStartX, lineStartY, 0);
    harness.SendMouse("down", lineStartX, lineStartY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", lineEndX, lineStartY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", lineEndX, lineStartY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    if editor2d.scene.GetTile(0, 1, 1) != 9
       or editor2d.scene.GetTile(0, 2, 1) != 9
       or editor2d.scene.GetTile(0, 3, 1) != 9
       or editor2d.scene.GetTile(0, 4, 1) != 9
       or editor2d.undoStack.count() != shapeUndo + 1 {
        Fail(shell, harness,
             "line drag did not write one four-cell transaction: t="
             + editor2d.scene.GetTile(0, 1, 1)
             + editor2d.scene.GetTile(0, 2, 1)
             + editor2d.scene.GetTile(0, 3, 1)
             + editor2d.scene.GetTile(0, 4, 1)
             + " undo=" + editor2d.undoStack.count());
        return;
    }
    editor2d.SetToolMode(scene_editor_2d.MODE_ELLIPSE);
    var ellipseStartX = HarnessCoordinate(
        shell, canvasBaseX + cell + 2.0);
    var ellipseStartY = HarnessCoordinate(
        shell, canvasBaseY + cell + 2.0);
    var ellipseEndX = HarnessCoordinate(
        shell, canvasBaseX + 5 * cell + 2.0);
    var ellipseEndY = HarnessCoordinate(
        shell, canvasBaseY + 5 * cell + 2.0);
    harness.SendMouse("move", ellipseStartX, ellipseStartY, 0);
    harness.SendMouse("down", ellipseStartX, ellipseStartY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", ellipseEndX, ellipseEndY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", ellipseEndX, ellipseEndY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    if editor2d.scene.GetTile(0, 1, 3) != 9
       or editor2d.scene.GetTile(0, 5, 3) != 9
       or editor2d.scene.GetTile(0, 3, 5) != 9
       or editor2d.scene.GetTile(0, 3, 3) == 9
       or editor2d.undoStack.count() != shapeUndo + 2 {
        Fail(shell, harness,
             "ellipse drag did not write its outline transaction: edge="
             + editor2d.scene.GetTile(0, 1, 3)
             + editor2d.scene.GetTile(0, 5, 3)
             + editor2d.scene.GetTile(0, 3, 5)
             + " center=" + editor2d.scene.GetTile(0, 3, 3)
             + " undo=" + editor2d.undoStack.count());
        return;
    }
    if editor2d.Undo() == false or editor2d.Undo() == false
       or doc2d.content != regionBaseline {
        Fail(shell, harness,
             "undoing shape edits did not restore exact bytes");
        return;
    }

    // Layers panel (2.2): opacity commits one first-class edit; lock is
    // workspace-only and refuses tile edits; solo is preview-only state.
    editor2d.SelectSceneObjects([], -1);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    var layerBaseline = doc2d.content;
    var layerUndo = editor2d.undoStack.count();
    editor2d.layerOpacitySpinner.SetValue(0.5);
    editor2d.Pump(doc2d);
    if editor2d.scene.LayerOpacity(0) != 0.5
       or editor2d.undoStack.count() != layerUndo + 1
       or Str.IndexOf(doc2d.content, "\"opacity\"") <= 0 {
        Fail(shell, harness,
             "layer opacity did not commit one first-class edit: o="
             + editor2d.scene.LayerOpacity(0)
             + " undo=" + editor2d.undoStack.count());
        return;
    }
    if editor2d.Undo() == false or doc2d.content != layerBaseline {
        Fail(shell, harness, "undoing layer opacity did not restore bytes");
        return;
    }
    editor2d.inspectorScroll.ScrollTo(editor2d.layerLockCheck);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    ClickWidget2D(shell, harness, editor2d.layerLockCheck);
    editor2d.Pump(doc2d);
    if editor2d.LayerLocked(0) == false {
        Fail(shell, harness, "lock click did not lock the active layer");
        return;
    }
    shell.Poll();
    shell.Render();
    GUI.ClipboardText.SetText(block);
    if editor2d.PasteTileBlockAt(1, 1)
       or doc2d.content != layerBaseline {
        Fail(shell, harness, "a locked layer accepted a tile paste");
        return;
    }
    ClickWidget2D(shell, harness, editor2d.layerLockCheck);
    editor2d.Pump(doc2d);
    if editor2d.LayerLocked(0) {
        Fail(shell, harness, "unlock click did not release the layer");
        return;
    }
    shell.Poll();
    shell.Render();
    ClickWidget2D(shell, harness, editor2d.layerSoloCheck);
    editor2d.Pump(doc2d);
    if editor2d.soloLayer != 0 or doc2d.content != layerBaseline {
        Fail(shell, harness,
             "solo did not set preview state or touched content: solo="
             + editor2d.soloLayer);
        return;
    }
    ClickWidget2D(shell, harness, editor2d.layerSoloCheck);
    editor2d.Pump(doc2d);
    if editor2d.soloLayer != -1 {
        Fail(shell, harness, "unsolo did not clear preview state");
        return;
    }

    harness.UnbindApp();
    shell.Destroy();
    Terminal.Say("RESULT: ok");
}
