//===----------------------------------------------------------------------===//
//
// File: zannastudio/src/probes/scene_editor_3d_probe.zia
// Purpose: Verify Studio VSCN hierarchy, transform tools, import, and view.
// Key invariants:
//   - 3D documents select the visual surface instead of the code editor.
//   - Hierarchy, degree rotation, and transform edits round-trip through VSCN.
//   - Move, Rotate, and Scale gizmos share deterministic picking and snapping.
//   - Move exposes stable XY/XZ/YZ plane handles whose two-axis edits remain
//     one transactional group action in both local and world space.
//   - Local/world transform space changes projected axes and applies exact
//     parent-relative TRS or rejects the complete group without mutation.
//   - Relative multi-node inspector transforms commit once and undo exactly.
//   - Multi-node visibility presents a truthful mixed state and commits the
//     complete selection once without losing selected identities.
//   - Existing hierarchy roots can be reparented without cycles or selection
//     loss; world transforms are preserved exactly by default, lossy
//     conversions roll back, and local-preserving mode remains explicit.
//   - The hierarchy uses true expandable TreeView parent/child rows, preserves
//     collapse state, and applies BEFORE/INTO/AFTER drops transactionally.
//   - Bounded hierarchy search matches names case-insensitively, wraps in both
//     directions, reveals nested rows, and never edits VSCN history or camera.
//   - Contiguous sibling selections move as one stable, undoable block while
//     boundary, gapped, and mixed-parent requests remain exact no-ops.
//   - Scene selection command focus never escapes inspector inputs.
//   - Material edits clone shared state, preserve PBR/maps through VSCN, and
//     show bounded canonical thumbnails after assignment, history, and reload.
//   - Typed gameplay metadata preserves exact scalar kinds through VSCN v6,
//     rejects invalid/no-op edits, and participates in canonical history.
//   - Project scene components add missing typed metadata across node groups,
//     preserve authored values, and abort atomically on type conflicts.
//   - Project 3D profiles apply typed first-open view, overlay, and atmosphere
//     defaults and can be reapplied after navigation without changing VSCN
//     content, revision, dirty state, history, or restored workspace choices.
//   - Version-6 sky palettes and sun/fill rigs plus version-7 lens, IBL, and
//     height fog resolve into bounded viewport-only presentation.
//   - Project node prefab previews render and pick through transient graphs
//     while variant/yaw/scale metadata leaves source VSCN bytes untouched.
//   - A failed preferred direct-model rule advances deterministically to the
//     next matching scene fallback and retains only that successful transform.
//   - Project-owned node-preview states filter only disposable preview art and
//     retain an explicit All option without changing VSCN or history.
//   - Transform tool/snap state follows its scene tab and session workspace.
//   - Compact windows wrap actions and show viewport or inspector at full width.
//   - Standard desktop windows expose three balanced panes with the viewport
//     wider than either supporting pane.
//   - Per-document hierarchy selection, camera, inspector split, and undo state
//     survive scene-to-scene tab switches without leaking across documents.
//   - Standard clipboard actions preserve selected subtrees across scene tabs.
//   - Undoing to the clean baseline clears dirty state and Save As adds .vscn.
//   - Asset import adds to the current scene only after a successful load.
//   - Invalid VSCN input remains byte-for-byte unchanged.
// Ownership/Lifetime:
//   - The probe owns one AppShell and deletes its unique temporary asset.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        zannastudio/src/ui/scene_clipboard.zia,
//        zannastudio/src/probes/scene_rotation_ring_probe.zia,
//        docs/graphics3d-guide.md,
//        docs/adr/0160-project-scene-component-schemas.md,
//        docs/adr/0161-stable-scenenode-sibling-reordering.md,
//        docs/adr/0162-exact-preserve-world-scenenode-reparenting.md,
//        docs/adr/0163-stable-multiselect-and-row-aware-treeview-editing.md,
//        docs/adr/0166-exact-scenenode-world-matrix-assignment.md,
//        docs/adr/0198-project-owned-3d-scene-preview-profiles.md,
//        docs/adr/0199-project-owned-3d-node-prefab-previews.md,
//        docs/adr/0200-project-owned-3d-sky-and-light-preview-rigs.md,
//        docs/adr/0201-project-owned-3d-lens-and-atmosphere-previews.md,
//        docs/adr/0215-project-owned-direct-model-previews.md,
//        docs/adr/0216-project-owned-3d-node-preview-states.md
//
//===----------------------------------------------------------------------===//

module scene_editor_3d_probe;

// ============================================================================
// MODULE: scene_editor_3d_probe
// PURPOSE: Regress responsive VSCN hierarchy, viewport transform contracts,
//          canonical history, import, and save behavior.
//
// WHERE-THIS-FITS: Display probe registered as
//          zia_zannastudio_scene_editor_3d.
//
// TEACHING-NOTE: Test transform math and then reload the authored VSCN. A
//          correct-looking live node or material does not prove a game can
//          import it.
// ============================================================================

bind "scene_editor_3d_probe_context" as Probe;
bind "scene_editor_3d_probe_part_1" as Part1;
bind "scene_editor_3d_probe_part_2" as Part2;
bind "scene_editor_3d_probe_part_3" as Part3;
bind "scene_editor_3d_probe_part_4" as Part4;

func main() {
    var ctx = new Probe.SceneEditor3DProbeContext();
    if Part1.VerifyInitialSurface(ctx) == false { return; }
    if Part1.VerifyTransformContracts(ctx) == false { return; }
    if Part1.VerifyPointerFocusAndShortcuts(ctx) == false { return; }
    if Part1.VerifyResponsiveToolbar(ctx) == false { return; }
    if Part1.VerifyDesktopPaneLayout(ctx) == false { return; }
    if Part1.VerifyInspectorAndTabContinuity(ctx) == false { return; }
    if Part2.VerifyNodeRoundTripAndMetadata(ctx) == false { return; }
    if Part2.StageComponentSchemas(ctx) == false { return; }
    if Part2.ApplyProjectPreviewProfile(ctx) == false { return; }
    if Part2.VerifyPreviewRenderingAndFilters(ctx) == false { return; }
    if Part2.VerifyPreviewFallbackAndSchemaIsolation(ctx) == false { return; }
    if Part2.VerifyComponentApplication(ctx) == false { return; }
    if Part3.VerifyTransformsAndHierarchySearch(ctx) == false { return; }
    if Part3.VerifyExactReparenting(ctx) == false { return; }
    if Part3.VerifyLocalReparentAndOrderingSetup(ctx) == false { return; }
    if Part3.VerifySiblingOrderingAndTreeDrops(ctx) == false { return; }
    if Part3.VerifyVisibilityAndInspectorGroups(ctx) == false { return; }
    if Part4.VerifyGroupTransformsAndClipboard(ctx) == false { return; }
    if Part4.VerifyClipboardRejectionsAndMaterialImport(ctx) == false { return; }
    if Part4.VerifyMaterialMapsAndRoundTrip(ctx) == false { return; }
    if Part4.VerifyWorldSpaceTransforms(ctx) == false { return; }
    if Part4.VerifyGroupPivotAndArrange(ctx) == false { return; }
    if Part4.VerifyTransformFailuresAndSaveSafety(ctx) == false { return; }
}
