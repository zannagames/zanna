//
// File: zannastudio/src/probes/autosave_job_probe.zia
// Purpose: Verify autosave normalization and durable compare/exchange run on a
//          bounded worker without clobbering a changed file.
// Key invariants:
//   - A valid baseline commits normalized content and publishes metadata.
//   - A stale baseline fails closed and preserves the external replacement.
//   - Oversized normalized snapshots are rejected before disk mutation.
// Ownership/Lifetime:
//   - The probe owns and removes one temporary directory and drains every job.
// Links: zannastudio/src/commands/autosave_job.zia
//
//===----------------------------------------------------------------------===//

module autosave_job_probe;

bind "../commands/autosave_job";
bind "../commands/autosave_commands";
bind "../commands/save_all_job";
bind "../core/document";
bind "../core/document_manager";
bind "../services/safe_io";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Hash = Zanna.Crypto.Hash;
bind Time = Zanna.Time;
bind Terminal = Zanna.Terminal;

func drain(job: autosave_job.AutoSaveJob,
           maxMs: Integer) -> autosave_job.AutoSaveRequest {
    var waited = 0;
    while job.IsBusy() and waited < maxMs {
        job.Pump();
        if job.IsBusy() {
            Time.Clock.Sleep(1);
            waited = waited + 1;
        }
    }
    job.Pump();
    return job.TakeCompleted();
}

func requestFor(path: String,
                source: String,
                maxBytes: Integer) -> autosave_job.AutoSaveRequest {
    var request = new autosave_job.AutoSaveRequest();
    request.owner = new document.Document();
    request.sourceRevision = 7;
    request.path = path;
    request.sourceContent = source;
    request.expectedModified = safe_io.Modified(path);
    request.expectedSize = safe_io.SizeBytes(path);
    request.expectedHash = Hash.Sha256(File.ReadAllText(path));
    request.maxBytes = maxBytes;
    request.trimTrailingWhitespace = true;
    request.ensureFinalNewline = true;
    return request;
}

func drainSaveAll(job: save_all_job.SaveAllJob,
                  maxMs: Integer) -> save_all_job.SaveAllRequest {
    var waited = 0;
    while job.IsBusy() and waited < maxMs {
        job.Pump();
        if job.IsBusy() {
            Time.Clock.Sleep(1);
            waited = waited + 1;
        }
    }
    job.Pump();
    return job.TakeCompleted();
}

func main() {
    var root = TempFile.CreateDirWithPrefix("zannastudio_autosave_");
    var path = Path.Join(root, "auto.zia");
    File.WriteAllText(path, "before\n");

    var job = new autosave_job.AutoSaveJob();
    var first = requestFor(path, "after   ", 4096);
    if job.Queue(first) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - worker did not start");
        return;
    }
    var firstDone = drain(job, 5000);
    if firstDone == null or firstDone.succeeded == false
       or firstDone.savedContent != "after\n"
       or firstDone.committedModified < 0
       or firstDone.committedSize != 6
       or File.ReadAllText(path) != "after\n" {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - normalized snapshot did not commit");
        return;
    }

    var stale = requestFor(path, "must not win\n", 4096);
    File.WriteAllText(path, "external\n");
    if job.Queue(stale) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - stale request did not start");
        return;
    }
    var staleDone = drain(job, 5000);
    if staleDone == null or staleDone.succeeded or staleDone.conflict == false
       or File.ReadAllText(path) != "external\n" {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - stale request clobbered external content");
        return;
    }

    var oversized = requestFor(path, "four", 3);
    if job.Queue(oversized) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - oversized request did not reach worker");
        return;
    }
    var oversizedDone = drain(job, 5000);
    if oversizedDone == null or oversizedDone.succeeded
       or File.ReadAllText(path) != "external\n"
       or job.WaitForShutdown() == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - oversized request changed disk state");
        return;
    }

    var inactivePath = Path.Join(root, "inactive.zia");
    var activePath = Path.Join(root, "active.zia");
    File.WriteAllText(inactivePath, "inactive before\n");
    File.WriteAllText(activePath, "active\n");
    var documents = new document_manager.DocumentManager();
    var inactiveDoc = documents.OpenFile(inactivePath);
    documents.OpenFile(activePath);
    inactiveDoc.content = "inactive after\n";
    inactiveDoc.isModified = true;
    if autosave_commands.QueueAutoSaveDocument(
           job, null, documents, null, 0, -1) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - inactive document did not queue");
        return;
    }
    var inactiveDone = drain(job, 5000);
    if inactiveDone == null or inactiveDone.succeeded == false
       or autosave_commands.CompleteAutoSave(
              null, documents, null, null, inactiveDone, -1)
       or inactiveDoc.isModified
       or File.ReadAllText(inactivePath) != "inactive after\n" {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - inactive document did not autosave");
        return;
    }

    var batchPath1 = Path.Join(root, "batch-1.zia");
    var batchPath2 = Path.Join(root, "batch-2.zia");
    File.WriteAllText(batchPath1, "one\n");
    File.WriteAllText(batchPath2, "two\n");
    var batch = new save_all_job.SaveAllRequest();
    var batchItem1 = new save_all_job.SaveAllItem();
    batchItem1.path = batchPath1;
    batchItem1.content = "ONE\n";
    batchItem1.expectedModified = safe_io.Modified(batchPath1);
    batchItem1.expectedSize = safe_io.SizeBytes(batchPath1);
    batchItem1.expectedHash = Hash.Sha256(File.ReadAllText(batchPath1));
    batchItem1.maxBytes = 4096;
    batch.items.add(batchItem1);
    var batchItem2 = new save_all_job.SaveAllItem();
    batchItem2.path = batchPath2;
    batchItem2.content = "TWO\n";
    batchItem2.expectedModified = safe_io.Modified(batchPath2);
    batchItem2.expectedSize = safe_io.SizeBytes(batchPath2);
    batchItem2.expectedHash = Hash.Sha256(File.ReadAllText(batchPath2));
    batchItem2.maxBytes = 4096;
    batch.items.add(batchItem2);
    var saveAllJob = new save_all_job.SaveAllJob();
    if saveAllJob.Queue(batch) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - Save All worker did not start");
        return;
    }
    var batchDone = drainSaveAll(saveAllJob, 5000);
    if batchDone == null or batchDone.succeeded == false
       or batchDone.savedCount != 2
       or File.ReadAllText(batchPath1) != "ONE\n"
       or File.ReadAllText(batchPath2) != "TWO\n" {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - Save All worker did not commit its batch");
        return;
    }

    safe_io.DeleteDirectoryTree(root);
    Terminal.Say("RESULT: ok");
}
