//
// File: zannastudio/src/probes/scene_editor_3d_probe_context.zia
// Purpose: Own shared fixture state and assertions for the 3D editor probe.
// Key invariants:
//   - Scenario modules share the same shell, document, editor, and history.
//   - A failed scenario destroys the shell and removes the staged VSCN.
// Ownership/Lifetime: The entry probe owns one context for its complete run.
// Links: zannastudio/src/probes/scene_editor_3d_probe.zia,
//        zannastudio/src/ui/scene_editor_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_editor_3d_probe_context;

bind "../core/document";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../editor/editor_engine";
bind "../services/safe_io";
bind "../ui/app_shell";
bind "../ui/scene_editor_3d";

bind SceneGraph = Zanna.Graphics3D.SceneGraph;
bind SceneNode = Zanna.Graphics3D.SceneNode;
bind Quat = Zanna.Math.Quat;
bind GUI = Zanna.GUI;
bind Dir = Zanna.IO.Dir;
bind Terminal = Zanna.Terminal;

/// @brief Typed state passed between serial 3D editor probe scenarios.
class SceneEditor3DProbeContext {
    expose String tempPath;
    expose app_shell.AppShell shell;
    expose scene_editor_3d.SceneEditor3D editor;
    expose editor_engine.EditorEngine hiddenEngine;
    expose document_manager.DocumentManager documents;
    expose document.Document sceneDoc;
    expose GUI.TestHarness focusHarness;

    expose String original;
    expose document.Document otherSceneDoc;
    expose Integer rootIndex;
    expose Integer childIndex;
    expose SceneNode child;
    expose String metadataContent;

    expose String componentDir;
    expose String componentPath;
    expose String componentScenePath;
    expose project_manager.ProjectManager componentProject;
    expose String previousComponentScenePath;

    expose SceneGraph previewGraph;
    expose document.Document previewDoc;
    expose String previewBaseline;
    expose Integer previewRevision;

    expose Quat transformedEuler;
    expose String transformedContent;
    expose Integer parentTargetIndex;
    expose String targetCreatedContent;
    expose String targetBaseline;
    expose List[Integer] childSelection;
    expose Integer reparentRevision;
    expose List[Integer] rootOnly;
    expose String orderingBaseline;
    expose Integer orderingRevision;
    expose List[Integer] groupSelection;

    expose SceneNode importedNode;
    expose SceneNode importedSibling;
    expose Integer importedIndex;
    expose String materialContent;

    expose Integer worldParentIndex;
    expose Integer worldChildIndex;
    expose List[Integer] worldSelection;
    expose SceneNode worldChild;
}

expose func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

expose func findNodeIndex(editor: scene_editor_3d.SceneEditor3D,
                          name: String) -> Integer {
    var index = 0;
    while index < editor.flatNodes.count() {
        if editor.flatNodes.get(index).Name == name { return index; }
        index = index + 1;
    }
    return -1;
}

expose func fail(shell: app_shell.AppShell,
                 tempPath: String,
                 reason: String) {
    if tempPath != "" { safe_io.DeleteFile(tempPath); }
    shell.Destroy();
    Terminal.Say("RESULT: fail " + reason);
}

expose func removeTempDir(path: String) {
    if path != "" { Dir.RemoveAll(path); }
}
