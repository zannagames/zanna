        + "{\"dirX\":1.0,\"dirZ\":0.3,\"speed\":0.05,"
        + "\"amplitude\":0.4,\"wavelength\":1.2},"
        + "{\"dirX\":-0.4,\"dirZ\":0.8,\"speed\":0.035,"
        + "\"amplitude\":0.7,\"wavelength\":0.8}]},"
        + "{\"matchProperty\":\"weather.kind\",\"matchValue\":3,"
        + "\"positionX\":4.0,\"positionY\":0.25,\"positionZ\":-2.0,"
        + "\"width\":8.0,\"depth\":12.0},"
        + "{\"matchProperty\":\"world.phase\",\"matchValue\":\"night\"}"
        + "]}}";
    var v15 = scene_component_schema.ParseText(
        v15Text, "v15-water-layers");
    var waterLayers = v15.scenePreview3D.waterLayers;
    if v15.valid == false or v15.version != 15
       or waterLayers.count() != 3
       or waterLayers.get(0).matchKind != "bool"
       or waterLayers.get(0).matchBoolean == false
       or waterLayers.get(0).positionXProperty != "af.watX"
       or waterLayers.get(0).widthProperty != "af.watW"
       or waterLayers.get(0).depthProperty != "af.watD"
       or near(waterLayers.get(0).widthMultiplier, 2.0) == false
       or near(waterLayers.get(0).depthMultiplier, 2.0) == false
       or waterLayers.get(0).hasColor == false
       or near(waterLayers.get(0).colorA, 0.5) == false
       or waterLayers.get(0).texture != "assets/water.png"
       or waterLayers.get(0).normalMap != "assets/water-normal.png"
       or waterLayers.get(0).resolution != 48
       or waterLayers.get(0).animate == false
       or waterLayers.get(0).waves.count() != 2
       or near(waterLayers.get(0).waves.get(0).amplitude, 0.4)
          == false
       or near(waterLayers.get(0).waves.get(1).wavelength, 0.8)
          == false
       or waterLayers.get(1).matchKind != "int"
       or waterLayers.get(1).matchInteger != 3
       or near(waterLayers.get(1).positionX, 4.0) == false
       or near(waterLayers.get(1).width, 8.0) == false
       or near(waterLayers.get(1).depth, 12.0) == false
       or waterLayers.get(2).matchKind != "string"
       or waterLayers.get(2).matchString != "night"
       or waterLayers.get(2).resolution != 64
       or waterLayers.get(2).waves.count() != 0 {
        fail("valid version-15 water layers did not round trip");
        return;
    }
    var v14Water = scene_component_schema.ParseText(
        "{\"version\":14,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true}]}}",
        "v14-water-layers");
    var unsafeWaterImage = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"texture\":\"../water.png\"}]}}",
        "unsafe-water-image");
    var orphanWaterMultiplier = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"widthMultiplier\":2.0}]}}",
        "orphan-water-multiplier");
    var incompleteWaterColor = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"colorR\":0.1,\"colorG\":0.2}]}}",
        "incomplete-water-color");
    var zeroWaterWave = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"waves\":[{\"dirX\":0.0,"
        + "\"dirZ\":0.0,\"speed\":1.0,\"amplitude\":0.1,"
        + "\"wavelength\":2.0}]}]}}",
        "zero-water-wave");
    var incompleteWaterWave = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"waves\":[{\"dirX\":1.0,"
        + "\"dirZ\":0.0,\"speed\":1.0,\"amplitude\":0.1}]}]}}",
        "incomplete-water-wave");
    var oversizedWaterGrid = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"resolution\":65}]}}",
        "oversized-water-grid");
    var undersizedWaterGrid = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"resolution\":7}]}}",
        "undersized-water-grid");
    var invalidWaterProperty = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"scenePreview3D\":{"
        + "\"waterLayers\":[{\"matchProperty\":\"water\","
        + "\"matchValue\":true,\"widthProperty\":\"../water.w\"}]}}",
        "invalid-water-property");
    if v14Water.valid or unsafeWaterImage.valid
       or orphanWaterMultiplier.valid or incompleteWaterColor.valid
       or zeroWaterWave.valid or incompleteWaterWave.valid
       or oversizedWaterGrid.valid or undersizedWaterGrid.valid
       or invalidWaterProperty.valid
       or unsafeWaterImage.scenePreview3D.waterLayers.count() != 0 {
        fail("invalid version-15 water layers were not fail-closed");
        return;
    }

    // ADR 0214: runtime-selected PBR presentation can be represented without
    // replacing canonical node materials or executing project code.
    var v16Text =
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"albedoMap\":\"assets/rock-albedo.png\","
        + "\"normalMap\":\"assets/rock-normal.ktx2\","
        + "\"metallicRoughnessMap\":\"assets/rock-mr.png\","
        + "\"ambientOcclusionMap\":\"assets/rock-ao.png\","
        + "\"emissiveMap\":\"assets/rock-emissive.png\","
        + "\"metallic\":0.0,\"roughness\":0.95,"
        + "\"ambientOcclusion\":0.8,\"normalScale\":1.25,"
        + "\"emissiveR\":0.02,\"emissiveG\":0.024,"
        + "\"emissiveB\":0.026,\"emissiveIntensity\":1.0,"
        + "\"useProjectEnvironment\":true,\"ssrEnabled\":false},"
        + "{\"matchProperty\":\"isAccent\",\"matchValue\":true,"
        + "\"emissiveRProperty\":\"env.accentR\","
        + "\"emissiveGProperty\":\"env.accentG\","
        + "\"emissiveBProperty\":\"env.accentB\","
        + "\"emissiveMultiplier\":0.5,"
        + "\"emissiveIntensity\":2.2},"
        + "{\"matchProperty\":\"surface.kind\",\"matchValue\":\"screen\","
        + "\"emissiveMap\":\"assets/screen.gif\"}"
        + "]}";
    var v16 = scene_component_schema.ParseText(
        v16Text, "v16-material-previews");
    var materialPreviews = v16.materialPreviews3D;
    if v16.valid == false or v16.version != 16
       or materialPreviews.count() != 3
       or materialPreviews.get(0).matchKind != "int"
       or materialPreviews.get(0).matchInteger != 3
       or materialPreviews.get(0).albedoMap
          != "assets/rock-albedo.png"
       or materialPreviews.get(0).normalMap
          != "assets/rock-normal.ktx2"
       or materialPreviews.get(0).metallicRoughnessMap
          != "assets/rock-mr.png"
       or materialPreviews.get(0).ambientOcclusionMap
          != "assets/rock-ao.png"
       or materialPreviews.get(0).emissiveMap
          != "assets/rock-emissive.png"
       or materialPreviews.get(0).hasMetallic == false
       or near(materialPreviews.get(0).metallic, 0.0) == false
       or materialPreviews.get(0).hasRoughness == false
       or near(materialPreviews.get(0).roughness, 0.95) == false
       or materialPreviews.get(0).hasAmbientOcclusion == false
       or near(materialPreviews.get(0).ambientOcclusion, 0.8) == false
       or materialPreviews.get(0).hasNormalScale == false
       or near(materialPreviews.get(0).normalScale, 1.25) == false
       or materialPreviews.get(0).hasEmissiveColor == false
       or near(materialPreviews.get(0).emissiveB, 0.026) == false
       or materialPreviews.get(0).hasEmissiveIntensity == false
       or materialPreviews.get(0).useProjectEnvironment == false
       or materialPreviews.get(0).hasSsrEnabled == false
       or materialPreviews.get(0).ssrEnabled
       or materialPreviews.get(1).matchKind != "bool"
       or materialPreviews.get(1).matchBoolean == false
       or materialPreviews.get(1).HasRootEmissive() == false
       or materialPreviews.get(1).emissiveGProperty
          != "env.accentG"
       or near(materialPreviews.get(1).emissiveMultiplier, 0.5)
          == false
       or materialPreviews.get(2).matchKind != "string"
       or materialPreviews.get(2).matchString != "screen"
       or materialPreviews.get(2).HasOverrides() == false {
        fail("valid version-16 material previews did not round trip");
        return;
    }
    var v15Materials = scene_component_schema.ParseText(
        "{\"version\":15,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"roughness\":0.9}]}",
        "v15-material-previews");
    var fractionalMaterialMatch = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":1.5,"
        + "\"roughness\":0.9}]}",
        "fractional-material-match");
    var unsafeMaterialMap = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"albedoMap\":\"../rock.png\"}]}",
        "unsafe-material-map");
    var incompleteMaterialEmissive = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"emissiveR\":0.1,\"emissiveG\":0.2}]}",
        "incomplete-material-emissive");
    var incompleteMaterialProperties = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"emissiveRProperty\":\"env.r\","
        + "\"emissiveGProperty\":\"env.g\"}]}",
        "incomplete-material-properties");
    var mixedMaterialEmissive = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"emissiveR\":0.1,\"emissiveG\":0.2,\"emissiveB\":0.3,"
        + "\"emissiveRProperty\":\"env.r\","
        + "\"emissiveGProperty\":\"env.g\","
        + "\"emissiveBProperty\":\"env.b\"}]}",
        "mixed-material-emissive");
    var orphanMaterialMultiplier = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"emissiveMultiplier\":2.0}]}",
        "orphan-material-multiplier");
    var outOfRangeMaterial = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"roughness\":1.1}]}",
        "out-of-range-material");
    var emptyMaterial = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3}]}",
        "empty-material-preview");
    var duplicateMaterial = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"materialPreviews3D\":["
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"roughness\":0.9},"
        + "{\"matchProperty\":\"surf\",\"matchValue\":3,"
        + "\"metallic\":0.1}]}",
        "duplicate-material-preview");
    if v15Materials.valid or fractionalMaterialMatch.valid
       or unsafeMaterialMap.valid or incompleteMaterialEmissive.valid
       or incompleteMaterialProperties.valid
       or mixedMaterialEmissive.valid or orphanMaterialMultiplier.valid
       or outOfRangeMaterial.valid or emptyMaterial.valid
       or duplicateMaterial.valid
       or unsafeMaterialMap.materialPreviews3D.count() != 0 {
        fail("invalid version-16 material previews were not fail-closed");
        return;
    }

    // ADR 0215: typed metadata can select imported project models directly,
    // with bounded fixed transforms composed over optional metadata mappings.
    var v17NodeText =
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"spawn.kind\",\"matchValue\":3,"
        + "\"prefab\":\"assets/enemy.glb\",\"scale\":0.85,"
        + "\"yawDegrees\":180,\"offsetX\":1.0,\"offsetY\":4.2,"
        + "\"offsetZ\":-2.0},"
        + "{\"matchProperty\":\"enabled\",\"matchValue\":true,"
        + "\"prefab\":\"assets/tree.fbx\"},"
        + "{\"matchProperty\":\"role\",\"matchValue\":\"boss unit\","
        + "\"prefab\":\"assets/boss.obj\"}]}";
    var v17Node = scene_component_schema.ParseText(
        v17NodeText, "v17-direct-model-node-previews");
    var directNodePreviews = v17Node.nodePreviews3D;
    if v17Node.valid == false or v17Node.version != 17
       or directNodePreviews.count() != 3
       or directNodePreviews.get(0).matchKind != "int"
       or directNodePreviews.get(0).matchInteger != 3
       or directNodePreviews.get(0).prefab != "assets/enemy.glb"
       or near(directNodePreviews.get(0).scale, 0.85) == false
       or near(directNodePreviews.get(0).yawDegrees, 180.0) == false
       or near(directNodePreviews.get(0).offsetX, 1.0) == false
       or near(directNodePreviews.get(0).offsetY, 4.2) == false
       or near(directNodePreviews.get(0).offsetZ, -2.0) == false
       or directNodePreviews.get(1).matchKind != "bool"
       or directNodePreviews.get(1).matchBoolean == false
       or directNodePreviews.get(1).prefab != "assets/tree.fbx"
       or directNodePreviews.get(2).matchKind != "string"
       or directNodePreviews.get(2).matchString != "boss unit"
       or directNodePreviews.get(2).prefab != "assets/boss.obj" {
        fail("valid version-17 direct-model node previews did not round trip");
        return;
    }
    var v16TypedNode = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"spawn.kind\",\"matchValue\":3,"
        + "\"prefab\":\"assets/enemy.scene3d\"}]}",
        "v16-typed-node-preview");
    var fractionalNodeMatch = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"spawn.kind\",\"matchValue\":1.5,"
        + "\"prefab\":\"assets/enemy.glb\"}]}",
        "fractional-node-match");
    var v16FixedNode = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.scene3d\",\"scale\":0.85}]}",
        "v16-fixed-node-preview");
    var v16DirectNode = scene_component_schema.ParseText(
        "{\"version\":16,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.gltf\"}]}",
        "v16-direct-model-node-preview");
    var zeroNodeScale = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.glb\",\"scale\":0.0}]}",
        "zero-node-scale");
    var excessiveNodeYaw = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.obj\",\"yawDegrees\":36001}]}",
        "excessive-node-yaw");
    var excessiveNodeOffset = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.stl\",\"offsetY\":1000001}]}",
        "excessive-node-offset");
    var unsafeDirectNode = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"../enemy.gltf\"}]}",
        "unsafe-direct-node-preview");
    var unsupportedDirectNode = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"kind\",\"matchValue\":\"enemy\","
        + "\"prefab\":\"assets/enemy.dae\"}]}",
        "unsupported-direct-node-preview");
    var duplicateTypedNode = scene_component_schema.ParseText(
        "{\"version\":17,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"spawn.kind\",\"matchValue\":3,"
        + "\"prefab\":\"assets/enemy.glb\"},"
        + "{\"matchProperty\":\"spawn.kind\",\"matchValue\":3,"
        + "\"prefab\":\"assets/enemy.obj\"}]}",
        "duplicate-typed-node-preview");
    if v16TypedNode.valid or fractionalNodeMatch.valid
       or v16FixedNode.valid or v16DirectNode.valid
       or zeroNodeScale.valid or excessiveNodeYaw.valid
       or excessiveNodeOffset.valid or unsafeDirectNode.valid
       or unsupportedDirectNode.valid or duplicateTypedNode.valid
       or duplicateTypedNode.nodePreviews3D.count() != 0 {
        fail("invalid version-17 direct-model node previews were not closed");
        return;
    }

    var v4NodePreview = scene_component_schema.ParseText(
        "{\"version\":4,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"assets/prop.scene3d\"}]}",
        "v4-node-preview");
    var duplicateNodePreview = scene_component_schema.ParseText(
        "{\"version\":5,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"assets/a.scene3d\"},"
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"assets/b.scene3d\"}]}",
        "duplicate-node-preview");
    var orphanVariants = scene_component_schema.ParseText(
        "{\"version\":5,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"variantPrefabs\":[\"assets/a.scene3d\"]}]}",
        "orphan-variants");
    var unsafePreviewPath = scene_component_schema.ParseText(
        "{\"version\":5,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"../outside.scene3d\"}]}",
        "unsafe-preview-path");
    if v4NodePreview.valid or duplicateNodePreview.valid
       or orphanVariants.valid or unsafePreviewPath.valid
       or duplicateNodePreview.nodePreviews3D.count() != 0 {
        fail("invalid version-5 node previews were not rejected fail-closed");
        return;
    }

    try { Dir.RemoveAll(LOCATOR_FIXTURE); } catch {}
    var nested = Path.Join(LOCATOR_FIXTURE, "assets/scenes");
    Dir.MakeAll(nested);
    File.WriteAllText(
        Path.Join(LOCATOR_FIXTURE, "zanna.project"),
        "project PreviewProbe\n");
    var nestedScene = Path.Join(nested, "region.scene2d");
    File.WriteAllText(nestedScene, "{}");
    var discovered =
        project_locator.NearestManifestRoot(nestedScene);
    var expectedRoot =
        Path.Normalize(Path.Absolute(LOCATOR_FIXTURE));
    if discovered != expectedRoot
       or project_locator.NearestManifestRoot(
              Path.Join(LOCATOR_FIXTURE, "missing.scene2d")) != expectedRoot
       or project_locator.NearestManifestRoot("") != "" {
        fail("nested explicit scene did not discover its nearest manifest");
        return;
    }
    Dir.RemoveAll(LOCATOR_FIXTURE);

    Terminal.Say("RESULT: ok");
}
