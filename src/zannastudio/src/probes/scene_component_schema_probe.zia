//===----------------------------------------------------------------------===//
//
// File: zannastudio/src/probes/scene_component_schema_probe.zia
// Purpose: Verify bounded project scene-component schema parsing and lookup.
// Key invariants:
//   - Scalar defaults retain their declared type and canonical editor text.
//   - Target filtering is deterministic and accepts explicitly shared schemas.
//   - Invalid versions, duplicate identities, and mismatched defaults fail
//     closed without publishing a partial component list.
//   - Version-3 project object previews are bounded, deterministic, and
//     property-driven without changing version-1/2 component behavior.
//   - Version-4 3D preview metadata mappings are complete and fail closed.
//   - Version-5 3D node prefab rules are variant-safe and project-relative.
//   - Version-6 sky palettes and sun/fill rigs are complete and fail closed.
//   - Version-7 gameplay lens, IBL, and typed height-fog controls are bounded.
//   - Version-8 2D scene backdrops are variant-safe and project-relative.
//   - Version-9 3D scene environment prefabs are variant-safe and transient.
//   - Version-10 portable post-FX groups are complete, bounded, and ordered.
//   - Version-11 object preview draw stacks are bounded and layer-aware.
//   - Version-12 game-output dimensions are paired, integral, and bounded.
//   - Version-13 component creation recipes are target-safe and bounded.
//   - Version-14 additive 3D environment layers retain typed conditions and
//     independent metadata-driven transforms while malformed layers fail closed.
//   - Version-15 runtime water layers retain bounded dimensions, images,
//     colors, animation intent, and complete Gerstner wave records.
//   - Version-16 3D material previews retain typed matches, safe PBR maps,
//     bounded scalar overlays, and complete fixed or root-mapped emissive data.
//   - Version-17 node previews retain typed matches, direct model assets, and
//     bounded fixed transforms while older schemas remain fail-closed.
//   - Explicitly opened nested scenes discover their nearest project manifest.
// Ownership/Lifetime: The probe owns only in-memory schema fixtures.
// Links: zannastudio/src/ui/scene_component_schema.zia,
//        docs/adr/0160-project-scene-component-schemas.md,
//        docs/adr/0197-project-owned-2d-object-preview-profiles.md,
//        docs/adr/0198-project-owned-3d-scene-preview-profiles.md,
//        docs/adr/0199-project-owned-3d-node-prefab-previews.md,
//        docs/adr/0200-project-owned-3d-sky-and-light-preview-rigs.md,
//        docs/adr/0201-project-owned-3d-lens-and-atmosphere-previews.md,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md,
//        docs/adr/0203-project-owned-3d-scene-environment-previews.md,
//        docs/adr/0204-project-owned-3d-post-processing-previews.md,
//        docs/adr/0206-project-owned-2d-object-preview-draw-stacks.md,
//        docs/adr/0208-project-authored-game-output-frames.md,
//        docs/adr/0209-project-component-creation-recipes.md,
//        docs/adr/0212-additive-3d-environment-preview-layers.md,
//        docs/adr/0213-runtime-backed-water-preview-layers.md,
//        docs/adr/0214-project-owned-3d-material-previews.md,
//        docs/adr/0215-project-owned-direct-model-previews.md
//
//===----------------------------------------------------------------------===//

module scene_component_schema_probe;

bind "../ui/scene_component_schema";
bind "../services/project_locator";

bind Terminal = Zanna.Terminal;
bind Dir = Zanna.IO.Dir;
bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;

final LOCATOR_FIXTURE: String = "__scene_project_locator_probe";

func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func fail(reason: String) {
    try { Dir.RemoveAll(LOCATOR_FIXTURE); } catch {}
    Terminal.Say("RESULT: fail " + reason);
}

func main() {
    var validText =
        "{"
        + "\"version\":1,"
        + "\"components\":["
        + "{"
        + "\"name\":\"enemy-spawn\","
        + "\"label\":\"Enemy Spawn\","
        + "\"target\":\"both\","
        + "\"description\":\"Reusable enemy placement data.\","
        + "\"fields\":["
        + "{\"key\":\"enemy.archetype\",\"label\":\"Archetype\","
        + "\"type\":\"string\",\"default\":\"grunt\"},"
        + "{\"key\":\"enemy.level\",\"type\":\"int\",\"default\":3},"
        + "{\"key\":\"enemy.radius\",\"type\":\"float\",\"default\":4.0},"
        + "{\"key\":\"enemy.active\",\"type\":\"bool\",\"default\":true},"
        + "{\"key\":\"enemy.target\",\"type\":\"null\"}"
        + "]"
        + "},"
        + "{"
        + "\"name\":\"checkpoint\","
        + "\"target\":\"3d-node\","
        + "\"fields\":["
        + "{\"key\":\"checkpoint.id\",\"type\":\"string\",\"default\":\"start\"}"
        + "]"
        + "}"
        + "]"
        + "}";
    var schema = scene_component_schema.ParseText(validText, "memory");
    if schema.found == false or schema.valid == false
       or schema.error != "" or schema.components.count() != 2
       or schema.CountForTarget(scene_component_schema.TARGET_2D_OBJECT) != 1
       or schema.CountForTarget(scene_component_schema.TARGET_3D_NODE) != 2 {
        fail("valid schema did not publish deterministic target components: "
             + schema.error);
        return;
    }

    var enemy = schema.Find(
        "enemy-spawn", scene_component_schema.TARGET_2D_OBJECT);
    if enemy == null or enemy.label != "Enemy Spawn"
       or enemy.fields.count() != 5
       or enemy.FieldNamed("enemy.archetype").defaultText != "grunt"
       or enemy.FieldNamed("enemy.level").defaultText != "3"
       or enemy.FieldNamed("enemy.radius").defaultText != "4"
       or enemy.FieldNamed("enemy.active").defaultText != "true"
       or enemy.FieldNamed("enemy.target").kind != "null"
       or enemy.FieldNamed("enemy.target").defaultText != "" {
        fail("typed defaults changed kind, lookup, or canonical text");
        return;
    }
    if schema.Find(
           "checkpoint", scene_component_schema.TARGET_2D_OBJECT) != null
       or schema.Find(
              "checkpoint", scene_component_schema.TARGET_3D_NODE) == null {
        fail("component target filtering accepted an incompatible scope");
        return;
    }

    var implicitDefaults = scene_component_schema.ParseText(
        "{\"version\":1,\"components\":["
        + "{\"name\":\"defaults\",\"target\":\"both\",\"fields\":["
        + "{\"key\":\"s\",\"type\":\"string\"},"
        + "{\"key\":\"i\",\"type\":\"int\"},"
        + "{\"key\":\"f\",\"type\":\"float\"},"
        + "{\"key\":\"b\",\"type\":\"bool\"},"
        + "{\"key\":\"n\",\"type\":\"null\"}]}"
        + "]}",
        "implicit-defaults");
    var defaults = implicitDefaults.Find(
        "defaults", scene_component_schema.TARGET_2D_OBJECT);
    if implicitDefaults.valid == false or defaults == null
       or defaults.FieldNamed("s").defaultText != ""
       or defaults.FieldNamed("i").defaultText != "0"
       or defaults.FieldNamed("f").defaultText != "0"
       or defaults.FieldNamed("b").defaultText != "false"
       or defaults.FieldNamed("n").defaultText != "" {
        fail("omitted scalar defaults were not canonical and applicable");
        return;
    }

    var duplicateName = scene_component_schema.ParseText(
        "{\"version\":1,\"components\":["
        + "{\"name\":\"Enemy\",\"target\":\"2d-object\","
        + "\"fields\":[{\"key\":\"a\",\"type\":\"int\"}]},"
        + "{\"name\":\"enemy\",\"target\":\"3d-node\","
        + "\"fields\":[{\"key\":\"b\",\"type\":\"int\"}]}"
        + "]}",
        "duplicate-name");
    var duplicateKey = scene_component_schema.ParseText(
        "{\"version\":1,\"components\":["
        + "{\"name\":\"enemy\",\"target\":\"2d-object\",\"fields\":["
        + "{\"key\":\"hp\",\"type\":\"int\"},"
        + "{\"key\":\"hp\",\"type\":\"float\"}]}"
        + "]}",
        "duplicate-key");
    var badDefault = scene_component_schema.ParseText(
        "{\"version\":1,\"components\":["
        + "{\"name\":\"enemy\",\"target\":\"2d-object\",\"fields\":["
        + "{\"key\":\"hp\",\"type\":\"int\",\"default\":1.5}]}"
        + "]}",
        "bad-default");
    var badVersion = scene_component_schema.ParseText(
        "{\"version\":18,\"components\":[]}", "bad-version");
    if duplicateName.valid or duplicateName.components.count() != 0
       or duplicateKey.valid or duplicateKey.components.count() != 0
       or badDefault.valid or badDefault.components.count() != 0
       or badVersion.valid or badVersion.components.count() != 0 {
        fail("invalid schema published partial component state");
        return;
    }

    var absent = scene_component_schema.LoadPath("");
    if absent.found or absent.valid == false
       or absent.components.count() != 0 {
        fail("absent schema was not a valid empty configuration");
        return;
    }

    // ADR 0178: version-2 enum and asset fields parse with full validation.
    var v2Text =
        "{"
        + "\"version\":2,"
        + "\"components\":[{"
        + "\"name\":\"spawn\",\"target\":\"both\",\"fields\":["
        + "{\"key\":\"spawn.archetype\",\"type\":\"enum\","
        + "\"choices\":[\"grunt\",\"ranged\",\"elite\"],"
        + "\"default\":\"ranged\"},"
        + "{\"key\":\"spawn.kind\",\"type\":\"enum\","
        + "\"choices\":[\"walker\"]},"
        + "{\"key\":\"spawn.sprite\",\"type\":\"asset\","
        + "\"assetKinds\":[\"image\"],\"default\":\"art/slime.png\"},"
        + "{\"key\":\"spawn.cue\",\"type\":\"asset\"}"
        + "]}]}";
    var v2 = scene_component_schema.ParseText(v2Text, "memory");
    if v2.valid == false or v2.version != 2 {
        fail("valid version-2 schema was rejected: " + v2.error);
        return;
    }
    var spawn = v2.Find("spawn", "2d-object");
    var archetype = spawn.FieldNamed("spawn.archetype");
    var kindField = spawn.FieldNamed("spawn.kind");
    var spriteField = spawn.FieldNamed("spawn.sprite");
    var cueField = spawn.FieldNamed("spawn.cue");
    if archetype.kind != "enum"
       or archetype.choices.count() != 3
       or archetype.defaultText != "ranged"
       or archetype.HasChoice("elite") == false
       or kindField.defaultText != "walker"
       or spriteField.kind != "asset"
       or spriteField.assetKinds.count() != 1
       or spriteField.assetKinds.get(0) != "image"
       or cueField.assetKinds.get(0) != "any"
       or scene_component_schema.ValueKind("enum") != "string"
       or scene_component_schema.ValueKind("asset") != "string"
       or scene_component_schema.ValueKind("int") != "int" {
        fail("version-2 enum/asset parsing lost validated structure");
        return;
    }

    // Version-1 files must reject version-2 kinds and stay fail-closed.
    var v1EnumText =
        "{\"version\":1,\"components\":[{\"name\":\"spawn\","
        + "\"target\":\"both\",\"fields\":[{\"key\":\"spawn.kind\","
        + "\"type\":\"enum\",\"choices\":[\"walker\"]}]}]}";
    var v1Enum = scene_component_schema.ParseText(v1EnumText, "memory");
    var v2BadDefaultText =
        "{\"version\":2,\"components\":[{\"name\":\"spawn\","
        + "\"target\":\"both\",\"fields\":[{\"key\":\"spawn.kind\","
        + "\"type\":\"enum\",\"choices\":[\"walker\"],"
        + "\"default\":\"flier\"}]}]}";
    var v2BadDefault = scene_component_schema.ParseText(v2BadDefaultText, "memory");
    var dupChoiceText =
        "{\"version\":2,\"components\":[{\"name\":\"spawn\","
        + "\"target\":\"both\",\"fields\":[{\"key\":\"spawn.kind\","
        + "\"type\":\"enum\",\"choices\":[\"walker\",\"Walker\"]}]}]}";
    var dupChoice = scene_component_schema.ParseText(dupChoiceText, "memory");
    var badKindText =
        "{\"version\":2,\"components\":[{\"name\":\"spawn\","
        + "\"target\":\"both\",\"fields\":[{\"key\":\"spawn.sprite\","
        + "\"type\":\"asset\",\"assetKinds\":[\"video\"]}]}]}";
    var badKind = scene_component_schema.ParseText(badKindText, "memory");
    if v1Enum.valid or v1Enum.components.count() != 0
       or v2BadDefault.valid or dupChoice.valid or badKind.valid {
        fail("invalid version-2 content was not rejected fail-closed");
        return;
    }

    // ADR 0197: one project-owned rule can select a linear or mapped atlas
    // frame from an existing integer object property.
    var v3Text =
        "{\"version\":3,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/actors.png\","
        + "\"frame\":7,\"frameProperty\":\"enemy.type\","
        + "\"frameOffset\":10},"
        + "{\"objectType\":\"pickup\",\"sprite\":\"art/items.png\","
        + "\"frame\":2,\"frameProperty\":\"pickup.type\","
        + "\"frameMap\":[4,8,12]}"
        + "]}";
    var v3 = scene_component_schema.ParseText(v3Text, "memory");
    var enemyPreview = v3.PreviewForObjectType("Enemy");
    var pickupPreview = v3.PreviewForObjectType("pickup");
    if v3.valid == false or v3.version != 3
       or v3.objectPreviews.count() != 2
       or enemyPreview == null
       or enemyPreview.sprite != "art/actors.png"
       or enemyPreview.FrameForValue(3) != 13
       or enemyPreview.FrameForValue(-1) != 7
       or pickupPreview == null
       or pickupPreview.FrameForValue(0) != 4
       or pickupPreview.FrameForValue(2) != 12
       or pickupPreview.FrameForValue(3) != 2
       or v3.PreviewForObjectType("missing") != null {
        fail("version-3 project preview mapping lost bounded lookup semantics");
        return;
    }

    var v2Preview = scene_component_schema.ParseText(
        "{\"version\":2,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/a.png\"}]}",
        "v2-preview");
    var duplicatePreview = scene_component_schema.ParseText(
        "{\"version\":3,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"Enemy\",\"sprite\":\"art/a.png\"},"
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/b.png\"}]}",
        "duplicate-preview");
    var orphanOffset = scene_component_schema.ParseText(
        "{\"version\":3,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/a.png\","
        + "\"frameOffset\":2}]}",
        "orphan-offset");
    var conflictingFrames = scene_component_schema.ParseText(
        "{\"version\":3,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/a.png\","
        + "\"frameProperty\":\"enemy.type\",\"frameOffset\":2,"
        + "\"frameMap\":[1,2]}]}",
        "conflicting-frames");
    var negativeFrame = scene_component_schema.ParseText(
        "{\"version\":3,\"components\":[],\"objectPreviews\":["
        + "{\"objectType\":\"enemy\",\"sprite\":\"art/a.png\","
        + "\"frame\":-1}]}",
        "negative-frame");
    if v2Preview.valid or duplicatePreview.valid or orphanOffset.valid
       or conflictingFrames.valid or negativeFrame.valid
       or duplicatePreview.objectPreviews.count() != 0 {
        fail("invalid version-3 preview content was not rejected fail-closed");
        return;
    }

    // ADR 0198: projects map their root metadata vocabulary onto a bounded
    // gameplay view and shaded environment without executing game code.
    var v4Text =
        "{\"version\":4,\"components\":[],\"scenePreview3D\":{"
        + "\"startXProperty\":\"af.startX\","
        + "\"startYProperty\":\"af.startY\","
        + "\"startZProperty\":\"af.startZ\","
        + "\"startYawProperty\":\"af.startYaw\","
        + "\"startEyeHeight\":1.62,"
        + "\"ambientRProperty\":\"lenv.ambR\","
        + "\"ambientGProperty\":\"lenv.ambG\","
        + "\"ambientBProperty\":\"lenv.ambB\","
        + "\"clearRProperty\":\"lenv.zenR\","
        + "\"clearGProperty\":\"lenv.zenG\","
        + "\"clearBProperty\":\"lenv.zenB\","
        + "\"fogRProperty\":\"lenv.horR\","
        + "\"fogGProperty\":\"lenv.horG\","
        + "\"fogBProperty\":\"lenv.horB\","
        + "\"fogNearProperty\":\"lenv.fogNear\","
        + "\"fogFarProperty\":\"lenv.fogFar\","
        + "\"showGrid\":false,\"showMarkers\":false,"
        + "\"showLights\":false,\"showCameras\":false,"
        + "\"showColliders\":false,\"showRoutes\":true}}";
    var v4 = scene_component_schema.ParseText(v4Text, "memory");
    var profile3D = v4.scenePreview3D;
    if v4.valid == false or v4.version != 4
       or profile3D == null or profile3D.present == false
       or profile3D.HasStart() == false
       or profile3D.startXProperty != "af.startX"
       or profile3D.startYawProperty != "af.startYaw"
       or profile3D.hasStartEyeHeight == false
       or near(profile3D.startEyeHeight, 1.62) == false
       or profile3D.HasAmbient() == false
       or profile3D.HasClear() == false
       or profile3D.HasFog() == false
       or profile3D.hasShowGrid == false
       or profile3D.showGrid
       or profile3D.hasShowMarkers == false
       or profile3D.showMarkers
       or profile3D.hasShowLights == false
       or profile3D.showLights
       or profile3D.hasShowCameras == false
       or profile3D.showCameras
       or profile3D.hasShowColliders == false
       or profile3D.showColliders
       or profile3D.hasShowRoutes == false
       or profile3D.showRoutes == false {
        fail("version-4 3D preview profile lost validated mappings");
        return;
    }

    var v3Profile = scene_component_schema.ParseText(
        "{\"version\":3,\"components\":[],\"scenePreview3D\":{"
        + "\"showMarkers\":false}}", "v3-profile");
    var partialAmbient = scene_component_schema.ParseText(
        "{\"version\":4,\"components\":[],\"scenePreview3D\":{"
        + "\"ambientRProperty\":\"a.r\"}}", "partial-ambient");
    var orphanYaw = scene_component_schema.ParseText(
        "{\"version\":4,\"components\":[],\"scenePreview3D\":{"
        + "\"startYawProperty\":\"view.yaw\"}}", "orphan-yaw");
    var wrongOverlay = scene_component_schema.ParseText(
        "{\"version\":4,\"components\":[],\"scenePreview3D\":{"
        + "\"showLights\":\"no\"}}", "wrong-overlay");
    var orphanEyeHeight = scene_component_schema.ParseText(
        "{\"version\":4,\"components\":[],\"scenePreview3D\":{"
        + "\"startXProperty\":\"view.x\","
        + "\"startYProperty\":\"view.y\","
        + "\"startZProperty\":\"view.z\","
        + "\"startEyeHeight\":1.6}}", "orphan-eye-height");
    if v3Profile.valid or partialAmbient.valid or orphanYaw.valid
       or wrongOverlay.valid or orphanEyeHeight.valid
       or partialAmbient.scenePreview3D.present {
        fail("invalid version-4 profile was not rejected fail-closed");
        return;
    }

    // ADR 0199: empty gameplay nodes select transient project prefabs by one
    // exact string discriminator and an optional bounded integer variant.
    var v5Text =
        "{\"version\":5,\"components\":[],\"nodePreviews3D\":["
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"assets/editor/props/default.scene3d\","
        + "\"variantProperty\":\"prop.kind\",\"variantPrefabs\":["
        + "\"assets/editor/props/crate.scene3d\","
        + "\"assets/editor/props/barrel.vscn\"],"
        + "\"yawProperty\":\"prop.yaw\",\"yawUnit\":\"radians\","
        + "\"scaleProperty\":\"prop.scale\"},"
        + "{\"matchProperty\":\"af.kind\",\"matchValue\":\"pickup\","
        + "\"prefab\":\"assets/editor/pickup.scene3d\"}]}";
    var v5 = scene_component_schema.ParseText(v5Text, "memory");
    var propPreview =
        v5.NodePreview3DForMatch("af.kind", "prop");
    var pickup3DPreview =
        v5.NodePreview3DForMatch("af.kind", "pickup");
    if v5.valid == false or v5.version != 5
       or v5.nodePreviews3D.count() != 2
       or propPreview == null
       or propPreview.variantProperty != "prop.kind"
       or propPreview.yawProperty != "prop.yaw"
       or propPreview.yawUnit != "radians"
       or propPreview.scaleProperty != "prop.scale"
       or propPreview.PrefabForVariant(0)
          != "assets/editor/props/crate.scene3d"
       or propPreview.PrefabForVariant(1)
          != "assets/editor/props/barrel.vscn"
       or propPreview.PrefabForVariant(2)
          != "assets/editor/props/default.scene3d"
       or propPreview.PrefabForVariant(-1)
          != "assets/editor/props/default.scene3d"
       or pickup3DPreview == null
       or pickup3DPreview.prefab
          != "assets/editor/pickup.scene3d"
       or v5.NodePreview3DForMatch("af.kind", "Prop") != null {
        fail("version-5 node prefab mapping lost exact variant semantics");
        return;
    }

    // ADR 0200: a complete project sky palette and directional key/fill rig
    // travel as portable root-metadata mappings without executing game code.
    var v6Text =
        "{\"version\":6,\"components\":[],\"scenePreview3D\":{"
        + "\"clearRProperty\":\"sky.horR\","
        + "\"clearGProperty\":\"sky.horG\","
        + "\"clearBProperty\":\"sky.horB\","
        + "\"zenithRProperty\":\"sky.zenR\","
        + "\"zenithGProperty\":\"sky.zenG\","
        + "\"zenithBProperty\":\"sky.zenB\","
        + "\"groundRProperty\":\"sky.grdR\","
        + "\"groundGProperty\":\"sky.grdG\","
        + "\"groundBProperty\":\"sky.grdB\","
        + "\"cloudProperty\":\"sky.cloud\","
        + "\"starsProperty\":\"sky.stars\","
        + "\"sunXProperty\":\"sun.x\","
        + "\"sunYProperty\":\"sun.y\","
        + "\"sunZProperty\":\"sun.z\","
        + "\"sunRProperty\":\"sun.r\","
        + "\"sunGProperty\":\"sun.g\","
        + "\"sunBProperty\":\"sun.b\","
        + "\"sunIntensityProperty\":\"sun.i\","
        + "\"fillXProperty\":\"fill.x\","
        + "\"fillYProperty\":\"fill.y\","
        + "\"fillZProperty\":\"fill.z\","
        + "\"fillRProperty\":\"fill.r\","
        + "\"fillGProperty\":\"fill.g\","
        + "\"fillBProperty\":\"fill.b\","
        + "\"fillIntensityProperty\":\"fill.i\"}}";
    var v6 = scene_component_schema.ParseText(v6Text, "memory");
    var profile6 = v6.scenePreview3D;
    if v6.valid == false or v6.version != 6
       or profile6 == null or profile6.present == false
       or profile6.HasSkyPalette() == false
       or profile6.HasSun() == false
       or profile6.HasFill() == false
       or profile6.zenithRProperty != "sky.zenR"
       or profile6.groundBProperty != "sky.grdB"
       or profile6.cloudProperty != "sky.cloud"
       or profile6.starsProperty != "sky.stars"
       or profile6.sunIntensityProperty != "sun.i"
       or profile6.fillIntensityProperty != "fill.i" {
        fail("version-6 sky/light preview mapping lost complete groups");
        return;
    }

    var v5Sky = scene_component_schema.ParseText(
        "{\"version\":5,\"components\":[],\"scenePreview3D\":{"
        + "\"zenithRProperty\":\"sky.r\"}}", "v5-sky");
    var partialSky = scene_component_schema.ParseText(
        "{\"version\":6,\"components\":[],\"scenePreview3D\":{"
        + "\"clearRProperty\":\"h.r\","
        + "\"clearGProperty\":\"h.g\","
        + "\"clearBProperty\":\"h.b\","
        + "\"zenithRProperty\":\"z.r\","
        + "\"zenithGProperty\":\"z.g\","
        + "\"zenithBProperty\":\"z.b\"}}", "partial-sky");
    var orphanCloud = scene_component_schema.ParseText(
        "{\"version\":6,\"components\":[],\"scenePreview3D\":{"
        + "\"cloudProperty\":\"sky.cloud\"}}", "orphan-cloud");
    var partialSun = scene_component_schema.ParseText(
        "{\"version\":6,\"components\":[],\"scenePreview3D\":{"
        + "\"sunXProperty\":\"sun.x\"}}", "partial-sun");
    var partialFill = scene_component_schema.ParseText(
        "{\"version\":6,\"components\":[],\"scenePreview3D\":{"
        + "\"fillXProperty\":\"fill.x\","
        + "\"fillYProperty\":\"fill.y\","
        + "\"fillZProperty\":\"fill.z\","
        + "\"fillRProperty\":\"fill.r\","
        + "\"fillGProperty\":\"fill.g\","
        + "\"fillBProperty\":\"fill.b\"}}", "partial-fill");
    if v5Sky.valid or partialSky.valid or orphanCloud.valid
       or partialSun.valid or partialFill.valid
       or partialSky.scenePreview3D.present {
        fail("invalid version-6 sky/light profiles were not fail-closed");
        return;
    }

    // ADR 0201: project lens and atmospheric parameters are static, bounded
