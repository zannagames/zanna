//
// File: zannastudio/src/probes/scene_gameplay_preview_2d_probe.zia
// Purpose: Verify a real project's gameplay-aligned Studio 2D scene preview.
// Key invariants:
//   - Xenoscape region 01 opens at native art scale around the player start.
//   - Project-owned biome and object art decode through the retained canvas.
//   - Project preview priorities reproduce Xenoscape's gameplay paint order.
//   - Project recipes can create correctly typed gameplay objects directly.
//   - Game View removes every editor marker, outline, grid, ruler, and guide.
//   - Game View fits and locks the project's exact 1280x720 output frame.
//   - The canonical 150x17 world, terrain, and 82 objects remain unchanged.
//   - The actual canvas remains capturable for editor/game visual comparison.
// Ownership/Lifetime:
//   - The probe owns one AppShell and ProjectManager until process exit.
//   - It reads repository fixtures and writes only one temporary screenshot.
// Links: zannastudio/src/ui/scene_editor_2d.zia,
//        examples/games/xenoscape-scenes/scene-components.json,
//        examples/games/xenoscape-scenes/assets/scenes/region-01.scene2d,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md,
//        docs/adr/0206-project-owned-2d-object-preview-draw-stacks.md,
//        docs/adr/0207-non-destructive-scene-game-view.md,
//        docs/adr/0208-project-authored-game-output-frames.md,
//        docs/adr/0209-project-component-creation-recipes.md
//
//===----------------------------------------------------------------------===//

module scene_gameplay_preview_2d_probe;

bind "../core/document";
bind "../core/project_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_component_schema";
bind "../ui/scene_component_schema_forms_model";
bind "../ui/scene_editor_2d";
bind "../ui/scene_panels_2d";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Pixels = Zanna.Graphics.Pixels;
bind Color = Zanna.Graphics.Color;
bind Terminal = Zanna.Terminal;
bind Env = Zanna.System.Environment;

final EXPECTED_TILE_SOURCE_PIXELS: Integer = 512 * 448;
final EXPECTED_BACKGROUND_SOURCE_PIXELS: Integer = 1280 * 720;

func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func HasArg(name: String) -> Boolean {
    // VM `zanna run -- ...` arguments begin at zero; native probe binaries may
    // include an executable slot, so scan every entry for this explicit flag.
    var index = 0;
    while index < Env.GetArgumentCount() {
        if Env.GetArgument(index) == name { return true; }
        index = index + 1;
    }
    return false;
}

func projectRoot() -> String {
    var fromProbe =
        "../../../../examples/games/xenoscape-scenes";
    if File.Exists(Path.Join(fromProbe, "scene-components.json")) {
        return fromProbe;
    }
    return "examples/games/xenoscape-scenes";
}

func fail(shell: app_shell.AppShell,
          project: project_manager.ProjectManager,
          reason: String) {
    project.CloseProject();
    shell.Destroy();
    Terminal.Say("RESULT: fail " + reason);
}

func pump(editor: scene_editor_2d.SceneEditor2D,
          doc: document.Document,
          shell: app_shell.AppShell) -> Boolean {
    var changed = editor.Pump(doc);
    shell.Render();
    return changed;
}

/// @brief Typed state shared by serial Xenoscape preview scenarios.
class GameplayPreview2DProbeContext {
    expose app_shell.AppShell shell;
    expose project_manager.ProjectManager project;
    expose scene_editor_2d.SceneEditor2D editor;
    expose document.Document sceneDoc;
    expose String baseline;
    expose scene_component_schema.SceneComponentDefinition enemyRecipe;
}

/// @brief Load the project and verify its preview schema and canonical scene.
func VerifyProjectPreviewSetup(
    ctx: GameplayPreview2DProbeContext) -> Boolean {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Xenoscape Preview Probe", 1180, 780);
    shell.SetSceneWorkspaceMode(true);

    var project = new project_manager.ProjectManager();
    project.Setup(null);
    var root = projectRoot();
    var scenePath =
        Path.Join(root, "assets/scenes/region-01.scene2d");
    if File.Exists(scenePath) == false
       or project.OpenFolder(root) == false {
        fail(shell, project,
             "could not open the Xenoscape project fixture at " + root);
        return false;
    }

    var editor = new scene_editor_2d.SceneEditor2D();
    scene_panels_2d.Build(
        editor, shell.workbench.scene2DHost, shell.app);
    editor.SetWorkspaceContext(project);
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_2D);

    var sceneDoc = new document.Document();
    sceneDoc.fileName = "region-01.scene2d";
    sceneDoc.filePath = scenePath;
    sceneDoc.language = "scene2d";
    sceneDoc.kind = file_utils.DOC_KIND_SCENE_2D;
    sceneDoc.content = File.ReadAllText(scenePath);
    var baseline = sceneDoc.content;
    editor.Activate(sceneDoc);
    var firstChanged = pump(editor, sceneDoc, shell);
    if sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.currentSerialized != baseline {
        fail(shell, project,
             "first production pump changed canonical state"
             + " returned=" + firstChanged
             + " content=" + (sceneDoc.content != baseline)
             + " modified=" + sceneDoc.isModified
             + " snapshot=" + (editor.currentSerialized != baseline));
        return false;
    }
    var secondChanged = pump(editor, sceneDoc, shell);
    if sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.currentSerialized != baseline {
        fail(shell, project,
             "second production pump changed canonical state"
             + " returned=" + secondChanged
             + " content=" + (sceneDoc.content != baseline)
             + " modified=" + sceneDoc.isModified
             + " snapshot=" + (editor.currentSerialized != baseline));
        return false;
    }
    var thirdChanged = pump(editor, sceneDoc, shell);
    if sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.currentSerialized != baseline {
        fail(shell, project,
             "third production pump changed canonical state"
             + " returned=" + thirdChanged
             + " content=" + (sceneDoc.content != baseline)
             + " modified=" + sceneDoc.isModified
             + " snapshot=" + (editor.currentSerialized != baseline));
        return false;
    }

    if editor.loadError != ""
       or editor.scene == null
       or editor.framePixels == null
       or editor.scene.Width != 150
       or editor.scene.Height != 17
       or editor.scene.TileWidth != 64
       or editor.scene.TileHeight != 64
       or editor.scene.LayerCount() != 1
       or editor.scene.ObjectCount() != 90 {
        fail(shell, project,
             "the Xenoscape region did not become its canonical "
             + "rendered Studio scene");
        return false;
    }

    var enemyRecipe:
        scene_component_schema.SceneComponentDefinition = null;
    if editor.componentSchema != null {
        enemyRecipe = editor.componentSchema.Find(
            "enemy-spawn", scene_component_schema.TARGET_2D_OBJECT);
    }
    if editor.componentSchema == null
       or editor.componentSchema.valid == false
       or editor.componentSchema.version
          != scene_component_schema_forms_model
              .SCENE_SETTINGS_SCHEMA_VERSION
       or enemyRecipe == null
       or enemyRecipe.createObjectType != "enemy"
       or enemyRecipe.CanCreateFor(
              scene_component_schema.TARGET_2D_OBJECT) == false
       or editor.componentSchema.scenePreview2D == null
       or editor.componentSchema.scenePreview2D.HasOutputSize() == false
       or editor.componentSchema.scenePreview2D.outputWidth != 1280
       or editor.componentSchema.scenePreview2D.outputHeight != 720
       or editor.componentSchema.scenePreview2D
              .BackgroundForVariant(1)
          != "assets/backgrounds/scene-region-01.png"
       or editor.showGrid
       or editor.tilesets.TileCount(0) != 56
       or editor.tilesets.sourcePixelCount
          < EXPECTED_TILE_SOURCE_PIXELS
              + EXPECTED_BACKGROUND_SOURCE_PIXELS {
        fail(shell, project,
             "the project-owned biome, tile, or grid profile "
             + "did not reach the production canvas");
        return false;
    }

    ctx.shell = shell;
    ctx.project = project;
    ctx.editor = editor;
    ctx.sceneDoc = sceneDoc;
    ctx.baseline = baseline;
    ctx.enemyRecipe = enemyRecipe;
    return true;
}

/// @brief Verify component recipes, draw order, and first-open framing.
func VerifyGameplayRecipeAndPresentation(
    ctx: GameplayPreview2DProbeContext) -> Boolean {
    var shell = ctx.shell;
    var project = ctx.project;
    var editor = ctx.editor;
    var sceneDoc = ctx.sceneDoc;
    var baseline = ctx.baseline;
    var enemyRecipe = ctx.enemyRecipe;

    // The project palette must create a runtime-valid Xenoscape record
    // directly, without first inserting a generic object or making the user
    // run Add Missing. The complete recipe is one canonical history entry.
    editor.SelectSceneObjects([], -1);
    editor.SetInspectorSceneTab(false);
    editor.componentPalette.SelectComponent("enemy-spawn");
    editor.selectedCellX = 4;
    editor.selectedCellY = 5;
    pump(editor, sceneDoc, shell);
    var recipeBaselineRevision = editor.GetRevision();
    var recipeBaselineUndo = editor.undoStack.count();
    var recipeBaselinePreviewCount = editor.ObjectPreviewStack().count();
    if editor.componentPalette.group.IsVisible() == false
       or editor.componentPalette.createButton.IsEnabled() == false
       or editor.componentPalette.applyButton.IsEnabled() {
        fail(shell, project,
             "the selection-free Xenoscape creation action was not truthful");
        return false;
    }
    var createdEnemy = editor.CreateObjectFromComponent(enemyRecipe);
    var createdContent = sceneDoc.content;
    var createdPreviewStack = editor.ObjectPreviewStack();
    if createdEnemy != 90
       or editor.scene.ObjectCount() != 91
       or editor.scene.ObjectType(createdEnemy) != "enemy"
       or editor.scene.ObjectX(createdEnemy) != 4 * 64
       or editor.scene.ObjectY(createdEnemy) != 5 * 64
       or editor.scene.ObjectGetInt(
              createdEnemy, "enemy.type", -1) != 0
       or editor.selectedObject != createdEnemy
       or editor.selectedObjects.count() != 1
       or editor.selectedObjects.get(0) != createdEnemy
       or editor.GetRevision() != recipeBaselineRevision + 1
       or editor.undoStack.count() != recipeBaselineUndo + 1
       or editor.redoStack.count() != 0
       or createdContent == baseline
       or createdPreviewStack.count()
          != recipeBaselinePreviewCount + 1
       or editor.ObjectPreviewDrawOrder(createdEnemy) != 30 {
        fail(shell, project,
             "direct Xenoscape object creation was not one exact "
             + "gameplay-ready transaction");
        return false;
    }
    if editor.Undo() == false
       or sceneDoc.content != baseline
       or editor.scene.ObjectCount() != 90
       or editor.undoStack.count() != recipeBaselineUndo
       or editor.redoStack.count() != 1
       or editor.Redo() == false
       or sceneDoc.content != createdContent
       or editor.scene.ObjectCount() != 91
       or editor.scene.ObjectType(90) != "enemy"
       or editor.scene.ObjectGetInt(90, "enemy.type", -1) != 0
       or editor.undoStack.count() != recipeBaselineUndo + 1
       or editor.redoStack.count() != 0
       or editor.Undo() == false
       or sceneDoc.content != baseline
       or editor.scene.ObjectCount() != 90
       or editor.undoStack.count() != recipeBaselineUndo
       or editor.redoStack.count() != 1
       or editor.GetRevision() != recipeBaselineRevision + 4
       or sceneDoc.isModified {
        fail(shell, project,
             "Xenoscape recipe undo/redo did not restore exact scene bytes");
        return false;
    }
    pump(editor, sceneDoc, shell);
    if editor.ObjectPreviewStack().count() != recipeBaselinePreviewCount {
        fail(shell, project,
             "undoing the Xenoscape recipe left transient preview content");
        return false;
    }

    // Xenoscape paints pickups, the player, enemies/bosses, interactions, then
    // editor markers. The source scene is grouped differently (enemies first),
    // so this exact stack proves the project profile, not canonical array order.
    var previewStack = editor.ObjectPreviewStack();
    if previewStack.count() != 90
       or previewStack.get(0) != 22
       or previewStack.get(39) != 61
       or previewStack.get(40) != 62
       or previewStack.get(41) != 63
       or previewStack.get(60) != 13
       or previewStack.get(61) != 14
       or previewStack.get(62) != 15
       or previewStack.get(74) != 72
       or previewStack.get(75) != 73
       or previewStack.get(76) != 74
       or previewStack.get(81) != 79
       or editor.ObjectPreviewDrawOrder(20) != 30
       or editor.ObjectPreviewDrawOrder(74) != 40
       or editor.ObjectPreviewDrawOrder(0) != 30
       or editor.ObjectPreviewDrawOrder(60) != 10
       or editor.ObjectPreviewDrawOrder(75) != 40 {
        fail(shell, project,
             "project preview stack diverged from gameplay paint order");
        return false;
    }

    // Large gameplay worlds must remain legible instead of opening as a
    // whole-world thumbnail. Region 01's authored player start is near the
    // left edge, so native-scale framing clamps horizontal scroll to zero and
    // centers vertically near the gameplay floor.
    if editor.zoomPercent != 100
       or editor.displayCellSize != 64
       or editor.viewOriginX != 0
       or editor.viewOriginY <= 0
       or editor.renderedColumns < 6
       or editor.renderedRows < 6 {
        fail(shell, project,
             "first-open gameplay framing diverged: zoom="
             + editor.zoomPercent + " cell=" + editor.displayCellSize
             + " origin=" + editor.viewOriginX + ","
             + editor.viewOriginY + " rendered="
             + editor.renderedColumns + "x" + editor.renderedRows);
        return false;
    }

    // Loading, background compositing, and sprite resolution are presentation
    // work. They must not add editor metadata or dirty the real game scene.
    if sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.currentSerialized != baseline {
        fail(shell, project,
             "rendering the real project changed canonical state"
             + " content=" + (sceneDoc.content != baseline)
             + " modified=" + sceneDoc.isModified
             + " snapshot=" + (editor.currentSerialized != baseline));
        return false;
    }

    return true;
}

/// @brief Verify clean output-framed Game View and camera restoration.
func VerifyGameplayGameView(
    ctx: GameplayPreview2DProbeContext) -> Boolean {
    var shell = ctx.shell;
    var project = ctx.project;
    var editor = ctx.editor;
    var sceneDoc = ctx.sceneDoc;
    var baseline = ctx.baseline;

    // The comparison artifact must contain gameplay pixels, not the object
    // rectangles that make the ordinary authoring canvas actionable.
    var baselineRevision = editor.GetRevision();
    var baselineUndo = editor.undoStack.count();
    var baselineZoom = editor.zoomPercent;
    var baselineScrollX = editor.canvasScroll.GetScrollX();
    var baselineScrollY = editor.canvasScroll.GetScrollY();
    editor.SetGameViewActive(true);
    pump(editor, sceneDoc, shell);
    pump(editor, sceneDoc, shell);
    var gameFrameWidth = editor.GameOutputFrameWidthFor(
        editor.framePixels.Width, editor.framePixels.Height);
    var gameFrameHeight = editor.GameOutputFrameHeightFor(
        editor.framePixels.Width, editor.framePixels.Height);
    var gameFrameX = editor.GameOutputFrameXFor(
        editor.framePixels.Width, editor.framePixels.Height);
    var gameFrameY = editor.GameOutputFrameYFor(
        editor.framePixels.Width, editor.framePixels.Height);
    var aspectError =
        gameFrameWidth * 720 - gameFrameHeight * 1280;
    if aspectError < 0 { aspectError = 0 - aspectError; }
    var mattePixel =
        editor.framePixels.GetColor(0, 0) % 16777216;
    var expectedMatte = Color.RGB(8, 10, 14) % 16777216;
    if editor.GameViewActive() == false
       or editor.gameViewOutputFramed == false
       or editor.GameOutputWidth() != 1280
       or editor.GameOutputHeight() != 720
       or aspectError >= 1280
       or ((gameFrameX > 0 or gameFrameY > 0)
           and mattePixel != expectedMatte)
       or editor.selectButton.IsEnabled()
       or editor.gridButton.IsEnabled()
       or editor.zoomOutButton.IsEnabled()
       or editor.zoomInButton.IsEnabled()
       or editor.fitButton.IsEnabled()
       or editor.actualSizeButton.IsEnabled()
       or editor.rulerTopRow.IsVisible()
       or editor.verticalRulerImage.IsVisible()
       or sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.currentSerialized != baseline
       or editor.GetRevision() != baselineRevision
       or editor.undoStack.count() != baselineUndo {
        fail(shell, project,
             "clean Game View changed state or retained editor canvas chrome"
             + " active=" + editor.GameViewActive()
             + " framed=" + editor.gameViewOutputFramed
             + " output=" + editor.GameOutputWidth()
             + "x" + editor.GameOutputHeight()
             + " frame=" + gameFrameX + "," + gameFrameY
             + " " + gameFrameWidth + "x" + gameFrameHeight
             + " aspectError=" + aspectError
             + " matte=" + mattePixel + "/" + expectedMatte
             + " controls=" + editor.selectButton.IsEnabled()
             + "/" + editor.gridButton.IsEnabled()
             + "/" + editor.zoomOutButton.IsEnabled()
             + "/" + editor.zoomInButton.IsEnabled()
             + "/" + editor.fitButton.IsEnabled()
             + "/" + editor.actualSizeButton.IsEnabled()
             + " rulers=" + editor.rulerTopRow.IsVisible()
             + "/" + editor.verticalRulerImage.IsVisible()
             + " bytes=" + (sceneDoc.content == baseline)
             + "/" + (editor.currentSerialized == baseline)
             + " revision=" + editor.GetRevision()
             + "/" + baselineRevision
             + " history=" + editor.undoStack.count()
             + "/" + baselineUndo);
        return false;
    }
    var gameZoom = editor.zoomPercent;
    var gameOriginX = editor.viewOriginX;
    var gameOriginY = editor.viewOriginY;

    var screenshotPath =
        Path.Join(TempFile.Dir(),
                  "zannastudio_xenoscape_gameplay_preview.png");
    if Pixels.SavePng(editor.framePixels, screenshotPath) != 1 {
        fail(shell, project,
             "could not capture the actual Studio 2D viewport");
        return false;
    }

    Terminal.Say(
        "METRIC: scene=150x17 tiles=530 objects=82"
        + " zoom=" + gameZoom
        + "% origin=" + gameOriginX + "," + gameOriginY
        + " viewport=" + editor.framePixels.Width
        + "x" + editor.framePixels.Height
        + " output=1280x720"
        + " frame=" + gameFrameWidth + "x" + gameFrameHeight
        + " decodedPixels=" + editor.tilesets.sourcePixelCount
        + " screenshot=" + screenshotPath);

    if HasArg("--visual-hold") {
        Terminal.Say(
            "VISUAL: Xenoscape production editor is held for screenshot QA");
        while true {
            shell.PollWait(16);
            if shell.WasCloseRequested() { break; }
            editor.Pump(sceneDoc);
            shell.Render();
        }
    } else {
        editor.SetGameViewActive(false);
        pump(editor, sceneDoc, shell);
        pump(editor, sceneDoc, shell);
        if editor.GameViewActive()
           or editor.gameViewOutputFramed
           or editor.zoomPercent != baselineZoom
           or near(
                  editor.canvasScroll.GetScrollX(),
                  baselineScrollX) == false
           or near(
                  editor.canvasScroll.GetScrollY(),
                  baselineScrollY) == false
           or sceneDoc.content != baseline
           or sceneDoc.isModified
           or editor.GetRevision() != baselineRevision
           or editor.undoStack.count() != baselineUndo {
            fail(shell, project,
                 "leaving output-framed Game View did not restore "
                 + "the exact editor camera and canonical state"
                 + " zoom=" + editor.zoomPercent + "/" + baselineZoom
                 + " scroll=" + editor.canvasScroll.GetScrollX()
                 + "," + editor.canvasScroll.GetScrollY()
                 + "/" + baselineScrollX + "," + baselineScrollY);
            return false;
        }
    }

    project.CloseProject();
    shell.Destroy();
    Terminal.Say("RESULT: ok");
    return true;
}

func main() {
    var ctx = new GameplayPreview2DProbeContext();
    if VerifyProjectPreviewSetup(ctx) == false { return; }
    if VerifyGameplayRecipeAndPresentation(ctx) == false { return; }
    if VerifyGameplayGameView(ctx) == false { return; }
}
