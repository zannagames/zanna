//
// File: zannastudio/src/probes/scene_gameplay_preview_probe.zia
// Purpose: Verify a real project's gameplay-aligned Studio scene preview.
// Key invariants:
//   - Ashfall mission 01 opens at the authored player eye and heading.
//   - The retained render camera, projection, and project profile agree.
//   - Runtime-generated terrain appears through a read-only environment prefab.
//   - Mission 05 composes its metadata-sized pool through the real Water3D
//     runtime path with production images, waves, and one-frame depth state.
//   - Project recipes can create runtime-discriminated gameplay nodes directly.
//   - The real project's portable post-FX chain is retained on the viewport.
//   - Finalized pixels retain Ashfall's pale high-key visual envelope.
//   - Applying Gameplay View is read-only and survives prior navigation.
//   - Game View removes navigator, gizmo, selection, and editor-light chrome.
//   - Game View renders the exact 1600x900 project output inside neutral matte.
//   - The actual shaded viewport remains capturable for visual comparison.
// Ownership/Lifetime:
//   - The probe owns one AppShell and ProjectManager until process exit.
//   - It reads repository fixtures and writes only one temporary screenshot.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        examples/games/ashfall-scenes/scene-components.json,
//        examples/games/ashfall-scenes/player/camera_rig.zia,
//        docs/adr/0203-project-owned-3d-scene-environment-previews.md,
//        docs/adr/0204-project-owned-3d-post-processing-previews.md,
//        docs/adr/0207-non-destructive-scene-game-view.md,
//        docs/adr/0208-project-authored-game-output-frames.md,
//        docs/adr/0209-project-component-creation-recipes.md,
//        docs/adr/0212-additive-3d-environment-preview-layers.md,
//        docs/adr/0213-runtime-backed-water-preview-layers.md
//
//===----------------------------------------------------------------------===//

module scene_gameplay_preview_probe;

bind "../core/document";
bind "../core/project_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_component_schema";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_3d";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Pixels = Zanna.Graphics.Pixels;
bind Terminal = Zanna.Terminal;
bind Env = Zanna.System.Environment;

func HasArg(name: String) -> Boolean {
    // VM `zanna run -- ...` arguments begin at zero; native probe binaries may
    // include an executable slot, so scan every entry for this explicit flag.
    var index = 0;
    while index < Env.GetArgumentCount() {
        if Env.GetArgument(index) == name { return true; }
        index = index + 1;
    }
    return false;
}

func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func luminance(pixel: Integer) -> Integer {
    var red = (pixel / 16777216) % 256;
    var green = (pixel / 65536) % 256;
    var blue = (pixel / 256) % 256;
    return (red * 30 + green * 59 + blue * 11) / 100;
}

/// @brief Sample the central frame without making the visual probe expensive.
func sceneMeanLuma(pixels: Pixels,
                   width: Integer,
                   height: Integer) -> Number {
    return sceneMeanLumaRegion(pixels, 0, 0, width, height);
}

/// @brief Sample one bounded content frame while excluding surrounding matte.
func sceneMeanLumaRegion(pixels: Pixels,
                         originX: Integer,
                         originY: Integer,
                         width: Integer,
                         height: Integer) -> Number {
    var samples = 0;
    var total = 0;
    var y = originY + height / 8;
    while y < originY + height * 7 / 8 {
        var x = originX + width / 8;
        while x < originX + width * 7 / 8 {
            total = total + luminance(Pixels.Get(pixels, x, y));
            samples = samples + 1;
            x = x + 6;
        }
        y = y + 6;
    }
    if samples <= 0 { return 0.0; }
    return (total + 0.0) / (samples + 0.0);
}

/// @brief Count changed pixels in a bounded square around one projected point.
func pixelDifferenceAround(first: Pixels,
                           second: Pixels,
                           centerX: Integer,
                           centerY: Integer,
                           radius: Integer) -> Integer {
    if first == null or second == null { return 0; }
    var left = centerX - radius;
    var top = centerY - radius;
    var right = centerX + radius;
    var bottom = centerY + radius;
    if left < 0 { left = 0; }
    if top < 0 { top = 0; }
    if right >= first.Width { right = first.Width - 1; }
    if bottom >= first.Height { bottom = first.Height - 1; }
    var changed = 0;
    var y = top;
    while y <= bottom {
        var x = left;
        while x <= right {
            if first.GetRgba(x, y) != second.GetRgba(x, y) {
                changed = changed + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return changed;
}

func projectRoot() -> String {
    var fromProbe =
        "../../../../examples/games/ashfall-scenes";
    if File.Exists(Path.Join(fromProbe, "scene-components.json")) {
        return fromProbe;
    }
    return "examples/games/ashfall-scenes";
}

func fail(shell: app_shell.AppShell,
          project: project_manager.ProjectManager,
          reason: String) {
    project.CloseProject();
    shell.Destroy();
    Terminal.Say("RESULT: fail " + reason);
}

func pump(editor: scene_editor_3d.SceneEditor3D,
          doc: document.Document,
          shell: app_shell.AppShell) {
    editor.Pump(doc);
    shell.Render();
}

func main() {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Gameplay Preview Probe", 1180, 780);
    shell.SetSceneWorkspaceMode(true);

    var project = new project_manager.ProjectManager();
    project.Setup(null);
    var root = projectRoot();
    var scenePath =
        Path.Join(root, "assets/scenes/mission-01.scene3d");
    if File.Exists(scenePath) == false
       or project.OpenFolder(root) == false {
        fail(shell, project,
             "could not open the Ashfall project fixture at " + root);
        return;
    }

    var editor = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(
        editor, shell.workbench.scene3DHost, shell.app);
    editor.SetWorkspaceContext(project);
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);

    var sceneDoc = new document.Document();
    sceneDoc.fileName = "mission-01.scene3d";
    sceneDoc.filePath = scenePath;
    sceneDoc.language = "scene3d";
    sceneDoc.kind = file_utils.DOC_KIND_SCENE_3D;
    sceneDoc.content = File.ReadAllText(scenePath);
    var baseline = sceneDoc.content;
    editor.Activate(sceneDoc);
    pump(editor, sceneDoc, shell);
    pump(editor, sceneDoc, shell);

    if editor.loadError != ""
       or editor.scene == null
       or editor.flatNodes.count() != 134
       or editor.viewportRenderCamera == null
       or editor.viewportPixels == null {
        fail(shell, project,
             "the Ashfall mission did not become a rendered Studio scene");
        return;
    }

    var hasEnvironmentPreview = false;
    if editor.projectPreviewScene != null
       and editor.projectPreviewScene.Root != null {
        var previewIndex = 0;
        while previewIndex
              < editor.projectPreviewScene.Root.ChildCount {
            if editor.projectPreviewScene.Root
                   .GetChild(previewIndex).Name
               == "Scene environment preview" {
                hasEnvironmentPreview = true;
            }
            previewIndex = previewIndex + 1;
        }
    }
    var enemyRecipe:
        scene_component_schema.SceneComponentDefinition = null;
    if editor.componentSchema != null {
        enemyRecipe = editor.componentSchema.Find(
            "enemy-spawn", scene_component_schema.TARGET_3D_NODE);
    }
    if editor.componentSchema == null
       or editor.componentSchema.version
          != scene_component_schema
              .RUNTIME_WATER_PREVIEW_3D_SCHEMA_VERSION
       or enemyRecipe == null
       or enemyRecipe.createNodeName != "Enemy Spawn"
       or enemyRecipe.FieldNamed("af.kind") == null
       or enemyRecipe.FieldNamed("af.kind").defaultText != "spawn"
       or enemyRecipe.CanCreateFor(
              scene_component_schema.TARGET_3D_NODE) == false
       or editor.componentSchema.scenePreview3D == null
       or editor.componentSchema.scenePreview3D.HasOutputSize() == false
       or editor.componentSchema.scenePreview3D.outputWidth != 1600
       or editor.componentSchema.scenePreview3D.outputHeight != 900
       or editor.componentSchema.scenePreview3D
              .environmentLayers.count() != 0
       or editor.componentSchema.scenePreview3D
              .waterLayers.count() != 1
       or editor.componentSchema.scenePreview3D
              .EnvironmentPrefabForVariant(1)
          != "assets/editor-previews/environment-terrain-01.scene3d"
       or hasEnvironmentPreview == false
       or editor.projectWaterPreviews.count() != 0
       or editor.projectPreviewInstanceCount <= 0
       or editor.projectPreviewMissingCount != 0
       or editor.projectPreviewClipped {
        fail(shell, project,
             "the runtime terrain did not become a bounded "
             + "scene environment preview");
        return;
    }

    // Create one real Ashfall spawn at the viewport target. The discriminator
    // and every gameplay default must exist before the node enters canonical
    // history, and its project prefab preview must appear immediately.
    editor.SelectSceneNodes([], -1);
    editor.SetInspectorSceneTab(false);
    editor.componentPalette.SelectComponent("enemy-spawn");
    pump(editor, sceneDoc, shell);
    editor.viewTargetX = 7.5;
    editor.viewTargetY = 2.25;
    editor.viewTargetZ = -11.0;
    var recipeBaselineRevision = editor.GetRevision();
    var recipeBaselineUndo = editor.undoStack.count();
    var recipeBaselinePreviewCount =
        editor.projectPreviewInstanceCount;
    if editor.componentPalette.group.IsVisible() == false
       or editor.componentPalette.createButton.IsEnabled() == false
       or editor.componentPalette.applyButton.IsEnabled() {
        fail(shell, project,
             "the selection-free Ashfall creation action was not truthful");
        return;
    }
    var createdSpawn = editor.CreateNodeFromComponent(enemyRecipe);
    var createdContent = sceneDoc.content;
    var createdNode = editor.flatNodes.get(createdSpawn);
    var createdName = "<null>";
    var createdPosition = "<null>";
    var createdKind = "<null>";
    var createdArchetype = "<null>";
    var createdWave = -1;
    var createdRouteX = 0.0;
    var createdRouteZ = 0.0;
    if createdNode != null {
        createdName = createdNode.Name;
        createdPosition =
            createdNode.Position.X + ","
            + createdNode.Position.Y + ","
            + createdNode.Position.Z;
        createdKind = createdNode.MetadataGetString("af.kind", "");
        createdArchetype =
            createdNode.MetadataGetString("spawn.archetype", "");
        createdWave = createdNode.MetadataGetInt("spawn.wave", -1);
        createdRouteX =
            createdNode.MetadataGetFloat("spawn.routeX", 0.0);
        createdRouteZ =
            createdNode.MetadataGetFloat("spawn.routeZ", 0.0);
    }
    if createdSpawn != 134
       or editor.flatNodes.count() != 135
       or createdNode == null
       or createdNode.Name != "Enemy Spawn"
       or near(createdNode.Position.X, 7.5) == false
       or near(createdNode.Position.Y, 2.25) == false
       or near(createdNode.Position.Z, -11.0) == false
       or createdNode.MetadataGetString("af.kind", "") != "spawn"
       or createdNode.MetadataGetString(
              "spawn.archetype", "") != "0"
       or createdNode.MetadataGetInt("spawn.wave", -1) != 0
       or near(createdNode.MetadataGetFloat(
                 "spawn.routeX", 0.0), 99999.0) == false
       or near(createdNode.MetadataGetFloat(
                 "spawn.routeZ", 0.0), 99999.0) == false
       or editor.selectedIndex != createdSpawn
       or editor.selectedIndices.count() != 1
       or editor.selectedIndices.get(0) != createdSpawn
       or editor.GetRevision() != recipeBaselineRevision + 1
       or editor.undoStack.count() != recipeBaselineUndo + 1
       or editor.redoStack.count() != 0
       or createdContent == baseline
       or editor.projectPreviewInstanceCount
          != recipeBaselinePreviewCount + 1
       or editor.projectPreviewMissingCount != 0 {
        fail(shell, project,
             "direct Ashfall node creation was not one exact "
             + "gameplay-ready preview transaction"
             + " index=" + createdSpawn
             + " nodes=" + editor.flatNodes.count()
             + " name=" + createdName
             + " position=" + createdPosition
             + " metadata=" + createdKind + "/"
             + createdArchetype + "/" + createdWave + "/"
             + createdRouteX + "/" + createdRouteZ
             + " selection=" + editor.selectedIndex + "/"
             + editor.selectedIndices.count()
             + " revision=" + editor.GetRevision() + "/"
             + (recipeBaselineRevision + 1)
             + " history=" + editor.undoStack.count() + "/"
             + (recipeBaselineUndo + 1)
             + " redo=" + editor.redoStack.count()
             + " bytesChanged=" + (createdContent != baseline)
             + " previews=" + editor.projectPreviewInstanceCount
             + "/" + (recipeBaselinePreviewCount + 1)
             + " missing=" + editor.projectPreviewMissingCount);
        return;
    }
    if editor.Undo() == false
       or sceneDoc.content != baseline
       or editor.flatNodes.count() != 134
       or editor.projectPreviewInstanceCount
          != recipeBaselinePreviewCount
       or editor.undoStack.count() != recipeBaselineUndo
       or editor.redoStack.count() != 1
       or editor.Redo() == false
       or sceneDoc.content != createdContent
       or editor.flatNodes.count() != 135
       or editor.flatNodes.get(134)
              .MetadataGetString("af.kind", "") != "spawn"
       or editor.projectPreviewInstanceCount
          != recipeBaselinePreviewCount + 1
       or editor.undoStack.count() != recipeBaselineUndo + 1
       or editor.redoStack.count() != 0
       or editor.Undo() == false
       or sceneDoc.content != baseline
       or editor.flatNodes.count() != 134
       or editor.projectPreviewInstanceCount
          != recipeBaselinePreviewCount
       or editor.undoStack.count() != recipeBaselineUndo
       or editor.redoStack.count() != 1
       or editor.GetRevision() != recipeBaselineRevision + 4
       or sceneDoc.isModified {
        fail(shell, project,
             "Ashfall recipe undo/redo did not restore exact scene bytes");
        return;
    }

    var previewProfile = editor.componentSchema.scenePreview3D;
    if previewProfile.HasPostFX() == false
       or previewProfile.PostFXEffectCount() != 5
       or editor.viewportRenderPostFX == null
       or editor.viewportRenderPostFX.EffectCount != 5
       or editor.viewportRenderCanvas.FrameFinalized == false
       or near(previewProfile.tonemapExposure, 1.17) == false
       or near(previewProfile.bloomIntensity, 0.25) == false
       or near(previewProfile.colorGradeBrightness, 0.03) == false
       or near(previewProfile.vignetteSoftness, 0.12) == false
       or previewProfile.fxaa == false {
        fail(shell, project,
             "the Ashfall runtime post-FX recipe did not reach "
             + "the retained Studio viewport");
        return;
    }
    var meanLuma = sceneMeanLuma(
        editor.viewportPixels,
        editor.renderedViewportWidth,
        editor.renderedViewportHeight);
    if meanLuma < 175.0 or meanLuma > 250.0 {
        fail(shell, project,
             "finalized Ashfall viewport escaped its pale visual "
             + "envelope (mean luma " + meanLuma + ")");
        return;
    }

    var eye = editor.viewportRenderCamera.Position;
    var forward = editor.viewportRenderCamera.Forward;
    var projectedCenter =
        editor.ProjectWorldPoint(0.0, 1.82, 0.0);
    var expectedCenterX = editor.renderedViewportWidth / 2;
    var expectedCenterY = editor.renderedViewportHeight / 2;
    if near(eye.X, 0.0) == false
       or near(eye.Y, 1.82) == false
       or near(eye.Z, 34.0) == false
       or near(forward.X, 0.0) == false
       or near(forward.Y, 0.0) == false
       or near(forward.Z, -1.0) == false
       or projectedCenter.visible == false
       or projectedCenter.x != expectedCenterX
       or projectedCenter.y != expectedCenterY {
        fail(shell, project,
             "gameplay camera diverged: eye="
             + eye.X + "," + eye.Y + "," + eye.Z
             + " forward="
             + forward.X + "," + forward.Y + "," + forward.Z
             + " center="
             + projectedCenter.x + "," + projectedCenter.y
             + " expected="
             + expectedCenterX + "," + expectedCenterY);
        return;
    }

    // A dock change replaces the retained camera at a different aspect.
    // Gameplay eye anchoring must survive that responsive layout transition.
    editor.ToggleInspectorPane();
    pump(editor, sceneDoc, shell);
    pump(editor, sceneDoc, shell);
    eye = editor.viewportRenderCamera.Position;
    if near(eye.X, 0.0) == false
       or near(eye.Y, 1.82) == false
       or near(eye.Z, 34.0) == false {
        fail(shell, project,
             "responsive dock layout moved the gameplay camera");
        return;
    }

    // Deliberately navigate away, then prove the user-facing recovery action
    // reinstates the real render camera without touching canonical bytes.
    editor.viewYawDegrees = 73;
    editor.viewPitchDegrees = -24;
    editor.viewTargetX = 80.0;
    editor.viewTargetY = 70.0;
    editor.viewTargetZ = 60.0;
    pump(editor, sceneDoc, shell);
    if editor.ApplyProjectPreviewView() == false {
        fail(shell, project, "Gameplay View action was unavailable");
        return;
    }
    pump(editor, sceneDoc, shell);
    eye = editor.viewportRenderCamera.Position;
    forward = editor.viewportRenderCamera.Forward;
    if near(eye.X, 0.0) == false
       or near(eye.Y, 1.82) == false
       or near(eye.Z, 34.0) == false
       or near(forward.X, 0.0) == false
       or near(forward.Y, 0.0) == false
       or near(forward.Z, -1.0) == false
       or sceneDoc.content != baseline
       or sceneDoc.isModified {
        fail(shell, project,
             "Gameplay View did not restore the read-only runtime pose");
        return;
    }

    var baselineRevision = editor.GetRevision();
    var baselineUndo = editor.undoStack.count();
    var baselineYaw = editor.viewYawDegrees;
    var baselinePitch = editor.viewPitchDegrees;
    var baselineScale = editor.viewScale;
    var baselineTargetX = editor.viewTargetX;
    var baselineTargetY = editor.viewTargetY;
    var baselineTargetZ = editor.viewTargetZ;
    editor.SetGameViewActive(true);
    pump(editor, sceneDoc, shell);
    pump(editor, sceneDoc, shell);
    var gameFrameWidth = editor.ViewportContentWidth();
    var gameFrameHeight = editor.ViewportContentHeight();
    var gameFrameX = editor.ViewportContentX();
    var gameFrameY = editor.ViewportContentY();
    meanLuma = sceneMeanLumaRegion(
        editor.viewportPixels,
        gameFrameX,
        gameFrameY,
        gameFrameWidth,
        gameFrameHeight);
    var aspectError =
        gameFrameWidth * 900 - gameFrameHeight * 1600;
    if aspectError < 0 { aspectError = 0 - aspectError; }
    var mattePixel =
        Pixels.Get(editor.viewportPixels, 0, 0) % 16777216;
    // Pixels.Get returns packed RGBA; modulo removes the red byte.
    var expectedMatte = 0x0A0EFF;
    if editor.GameViewActive() == false
       or editor.gameViewOutputFramed == false
       or editor.GameOutputWidth() != 1600
       or editor.GameOutputHeight() != 900
       or aspectError >= 1600
       or (gameFrameX <= 0 and gameFrameY <= 0)
       or mattePixel != expectedMatte
       or editor.ViewportTargetWidth() != gameFrameWidth
       or editor.ViewportTargetHeight() != gameFrameHeight
       or editor.OrientationNavigatorVisible()
       or editor.moveToolButton.IsEnabled()
       or editor.viewOptionsButton.IsEnabled()
       or editor.orbitLeftButton.IsEnabled()
       or editor.orbitRightButton.IsEnabled()
       or editor.zoomOutButton.IsEnabled()
       or editor.zoomInButton.IsEnabled()
       or editor.projectionButton.IsEnabled()
       or editor.projectViewButton.IsEnabled()
       or editor.viewportModeButton.GetAccessibleName()
          != "3D viewport mode: Shaded"
       or meanLuma < 175.0 or meanLuma > 250.0
       or sceneDoc.content != baseline
       or sceneDoc.isModified
       or editor.GetRevision() != baselineRevision
       or editor.undoStack.count() != baselineUndo {
        fail(shell, project,
             "clean Game View changed state, retained editor chrome, "
             + "or escaped the runtime visual envelope"
             + " active=" + editor.GameViewActive()
             + " framed=" + editor.gameViewOutputFramed
             + " output=" + editor.GameOutputWidth()
             + "x" + editor.GameOutputHeight()
             + " frame=" + gameFrameX + "," + gameFrameY
             + " " + gameFrameWidth + "x" + gameFrameHeight
             + " target=" + editor.ViewportTargetWidth()
             + "x" + editor.ViewportTargetHeight()
             + " aspectError=" + aspectError
             + " matte=" + mattePixel + "/" + expectedMatte
             + " luma=" + meanLuma
             + " navigator=" + editor.OrientationNavigatorVisible()
             + " controls=" + editor.moveToolButton.IsEnabled()
             + "/" + editor.viewOptionsButton.IsEnabled()
             + "/" + editor.orbitLeftButton.IsEnabled()
             + "/" + editor.orbitRightButton.IsEnabled()
             + "/" + editor.zoomOutButton.IsEnabled()
             + "/" + editor.zoomInButton.IsEnabled()
             + "/" + editor.projectionButton.IsEnabled()
             + "/" + editor.projectViewButton.IsEnabled()
             + " mode="
             + editor.viewportModeButton.GetAccessibleName()
             + " bytes=" + (sceneDoc.content == baseline)
             + " modified=" + sceneDoc.isModified
             + " revision=" + editor.GetRevision()
             + "/" + baselineRevision
             + " history=" + editor.undoStack.count()
             + "/" + baselineUndo);
        return;
    }

    var screenshotPath =
        Path.Join(TempFile.Dir(),
                  "zannastudio_ashfall_gameplay_preview.png");
    if Pixels.SavePng(editor.viewportPixels, screenshotPath) != 1 {
        fail(shell, project,
             "could not capture the actual Studio viewport");
        return;
    }

    Terminal.Say(
        "METRIC: camera=0,1.82,34 forward=0,0,-1"
        + " viewport=" + editor.renderedViewportWidth
        + "x" + editor.renderedViewportHeight
        + " output=1600x900"
        + " frame=" + gameFrameWidth + "x" + gameFrameHeight
        + " previews=" + editor.projectPreviewInstanceCount
        + " postfx=" + editor.viewportRenderPostFX.EffectCount
        + " mean_luma=" + meanLuma
        + " screenshot=" + screenshotPath);

    if HasArg("--visual-hold") {
        Terminal.Say(
            "VISUAL: Ashfall production editor is held for screenshot QA");
        while true {
            shell.PollWait(16);
            if shell.WasCloseRequested() { break; }
            editor.Pump(sceneDoc);
            shell.Render();
        }
    } else {
        editor.SetGameViewActive(false);
        pump(editor, sceneDoc, shell);
        pump(editor, sceneDoc, shell);
        if editor.GameViewActive()
           or editor.gameViewOutputFramed
           or editor.viewYawDegrees != baselineYaw
           or editor.viewPitchDegrees != baselinePitch
           or editor.viewScale != baselineScale
           or near(editor.viewTargetX, baselineTargetX) == false
           or near(editor.viewTargetY, baselineTargetY) == false
           or near(editor.viewTargetZ, baselineTargetZ) == false
           or sceneDoc.content != baseline
           or sceneDoc.isModified
           or editor.GetRevision() != baselineRevision
           or editor.undoStack.count() != baselineUndo {
            fail(shell, project,
                 "leaving output-framed Game View did not restore "
                 + "the exact editor camera and canonical state");
            return;
        }
    }

    // The real game builds mission 05's pool from these same root values,
    // production images, and wave records. Studio must construct one real
    // Water3D and submit it with canonical geometry in the same canvas frame.
    var waterScenePath =
        Path.Join(root, "assets/scenes/mission-05.scene3d");
    var waterDoc = new document.Document();
    waterDoc.fileName = "mission-05.scene3d";
    waterDoc.filePath = waterScenePath;
    waterDoc.language = "scene3d";
    waterDoc.kind = file_utils.DOC_KIND_SCENE_3D;
    waterDoc.content = File.ReadAllText(waterScenePath);
    var waterBaseline = waterDoc.content;
    var waterBaselineRevision = editor.GetRevision();
    editor.Activate(waterDoc);
    pump(editor, waterDoc, shell);
    pump(editor, waterDoc, shell);
    var hasLegacyWaterProxy = false;
    if editor.projectPreviewScene != null
       and editor.projectPreviewScene.Root != null {
        var waterPreviewIndex = 0;
        while waterPreviewIndex
              < editor.projectPreviewScene.Root.ChildCount {
            var candidate = editor.projectPreviewScene.Root.GetChild(
                waterPreviewIndex);
            if candidate != null
               and candidate.Name == "Scene environment layer 0" {
                hasLegacyWaterProxy = true;
            }
            waterPreviewIndex = waterPreviewIndex + 1;
        }
    }
    var waterDefinition =
        editor.componentSchema.scenePreview3D.waterLayers.get(0);
    var waterCenter = editor.ProjectWorldPoint(-12.0, 0.28, -14.0);
    if editor.componentSchema.version
          != scene_component_schema
              .RUNTIME_WATER_PREVIEW_3D_SCHEMA_VERSION
       or editor.componentSchema.scenePreview3D
              .environmentLayers.count() != 0
       or editor.componentSchema.scenePreview3D.waterLayers.count() != 1
       or waterDefinition.matchKind != "bool"
       or waterDefinition.matchBoolean == false
       or waterDefinition.positionXProperty != "af.watX"
       or waterDefinition.positionYProperty != "af.watY"
       or waterDefinition.positionZProperty != "af.watZ"
       or waterDefinition.widthProperty != "af.watW"
       or waterDefinition.depthProperty != "af.watD"
       or near(waterDefinition.widthMultiplier, 2.0) == false
       or near(waterDefinition.depthMultiplier, 2.0) == false
       or waterDefinition.texture
          != "assets/editor-previews/water-albedo.png"
       or waterDefinition.normalMap
          != "assets/editor-previews/water-normal.png"
       or waterDefinition.resolution != 64
       or waterDefinition.animate == false
       or waterDefinition.waves.count() != 2
       or near(waterDefinition.waves.get(0).dirX, 1.0) == false
       or near(waterDefinition.waves.get(0).dirZ, 0.3) == false
       or near(waterDefinition.waves.get(0).speed, 0.05) == false
       or near(waterDefinition.waves.get(0).amplitude, 0.4) == false
       or near(waterDefinition.waves.get(0).wavelength, 1.2) == false
       or near(waterDefinition.waves.get(1).dirX, -0.4) == false
       or near(waterDefinition.waves.get(1).dirZ, 0.8) == false
       or near(waterDefinition.waves.get(1).speed, 0.035) == false
       or near(waterDefinition.waves.get(1).amplitude, 0.7) == false
       or near(waterDefinition.waves.get(1).wavelength, 0.8) == false
       or editor.projectWaterPreviews.count() != 1
       or editor.projectWaterWidths.count() != 1
       or editor.projectWaterDepths.count() != 1
       or editor.projectWaterXs.count() != 1
       or editor.projectWaterYs.count() != 1
       or editor.projectWaterZs.count() != 1
       or near(editor.projectWaterWidths.get(0), 6.4) == false
       or near(editor.projectWaterDepths.get(0), 6.4) == false
       or near(editor.projectWaterXs.get(0), -12.0) == false
       or near(editor.projectWaterYs.get(0), 0.28) == false
       or near(editor.projectWaterZs.get(0), -14.0) == false
       or hasLegacyWaterProxy
       or waterCenter.visible == false
       or editor.projectPreviewMissingCount != 0
       or editor.projectPreviewClipped
       or editor.viewportRenderCanvas.FrameFinalized == false
       or editor.viewportRenderCanvas.DrawCount <= 1
       or waterDoc.content != waterBaseline
       or waterDoc.isModified
       or editor.GetRevision() != waterBaselineRevision
       or editor.undoStack.count() != 0
       or editor.redoStack.count() != 0 {
        fail(shell, project,
             "mission 05 water did not become one exact runtime-backed "
             + "one-frame preview");
        return;
    }
    editor.viewTargetX = -12.0;
    editor.viewTargetY = 0.28;
    editor.viewTargetZ = -14.0;
    editor.viewScale = 28;
    editor.SetViewProjection(false);
    editor.SetQuickView(0);
    editor.viewYawDegrees = 35;
    editor.viewPitchDegrees = 35;
    editor.SetViewProjection(true);
    pump(editor, waterDoc, shell);
    pump(editor, waterDoc, shell);
    var waterTopCenter =
        editor.ProjectWorldPoint(-12.0, 0.28, -14.0);
    var waterTopCorner =
        editor.ProjectWorldPoint(-8.8, 0.28, -10.8);
    if waterTopCenter.visible == false
       or waterTopCorner.visible == false {
        fail(shell, project,
             "mission 05 water footprint could not be framed for authoring");
        return;
    }
    var waterBefore = editor.viewportPixels.Clone() as Pixels;
    var waterStep = 0;
    while waterStep < 10 {
        if editor.AdvanceProjectWaterPreview(0.1) == false {
            fail(shell, project,
                 "mission 05 runtime water refused a bounded preview step");
            return;
        }
        waterStep = waterStep + 1;
    }
    pump(editor, waterDoc, shell);
    var changedWaterPixels = pixelDifferenceAround(
        waterBefore,
        editor.viewportPixels,
        waterTopCenter.x,
        waterTopCenter.y,
        128);
    if changedWaterPixels <= 0
       or editor.viewportRenderCanvas.FrameFinalized == false
       or editor.viewportRenderCanvas.DrawCount <= 1
       or waterDoc.content != waterBaseline
       or waterDoc.isModified
       or editor.GetRevision() != waterBaselineRevision
       or editor.undoStack.count() != 0
       or editor.redoStack.count() != 0 {
        var waterBeforePath =
            Path.Join(TempFile.Dir(), "zannastudio_water_before.png");
        var waterAfterPath =
            Path.Join(TempFile.Dir(), "zannastudio_water_after.png");
        Pixels.SavePng(waterBefore, waterBeforePath);
        Pixels.SavePng(editor.viewportPixels, waterAfterPath);
        fail(shell, project,
             "runtime water animation or one-frame composition changed "
             + "canonical state or produced no visible frame delta"
             + " changedPixels=" + changedWaterPixels
             + " draws=" + editor.viewportRenderCanvas.DrawCount
             + " before=" + waterBeforePath
             + " after=" + waterAfterPath);
        return;
    }
    var waterScreenshotPath =
        Path.Join(
            TempFile.Dir(),
            "zannastudio_ashfall_water_preview.png");
    if editor.viewportPixels == null
       or Pixels.SavePng(
              editor.viewportPixels, waterScreenshotPath) != 1 {
        fail(shell, project,
             "could not capture the mission 05 water preview");
        return;
    }
    Terminal.Say(
        "METRIC: water=-12,0.28,-14 size=6.4x6.4 runtime=Water3D"
        + " waves=2 resolution=64"
        + " changedPixels=" + changedWaterPixels
        + " composedDraws=" + editor.viewportRenderCanvas.DrawCount
        + " gameplayScreen=" + waterCenter.x + "," + waterCenter.y
        + " authoringScreen=" + waterTopCenter.x + "," + waterTopCenter.y
        + " screenshot=" + waterScreenshotPath);

    project.CloseProject();
    shell.Destroy();
    Terminal.Say("RESULT: ok");
}
