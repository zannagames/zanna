//===----------------------------------------------------------------------===//
//
// File: zannastudio/src/probes/scene_component_authoring_probe.zia
// Purpose: Verify structured project component-schema edits and persistence.
// Key invariants:
//   - Every proposed edit is reparsed before it can replace schema text.
//   - Unknown supported-version JSON members survive edits to known fields.
//   - Editing fields preserves version-3 object, version-4 scene, version-5
//     node prefab, version-6 sky/light, version-7 lens/atmosphere, and
//     version-8 2D backdrop, version-9 3D environment, and version-10 post-FX
//     previews.
//   - File writes are atomic, conflict-aware, and exactly undoable/redoable.
// Ownership/Lifetime: The probe owns only temporary schema files and records.
// Links: zannastudio/src/ui/scene_component_authoring.zia,
//        zannastudio/src/ui/scene_component_schema.zia,
//        docs/adr/0160-project-scene-component-schemas.md,
//        docs/adr/0197-project-owned-2d-object-preview-profiles.md,
//        docs/adr/0198-project-owned-3d-scene-preview-profiles.md,
//        docs/adr/0199-project-owned-3d-node-prefab-previews.md,
//        docs/adr/0200-project-owned-3d-sky-and-light-preview-rigs.md,
//        docs/adr/0201-project-owned-3d-lens-and-atmosphere-previews.md,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md,
//        docs/adr/0203-project-owned-3d-scene-environment-previews.md,
//        docs/adr/0204-project-owned-3d-post-processing-previews.md
//
//===----------------------------------------------------------------------===//

module scene_component_authoring_probe;

bind "../services/safe_io";
bind "../ui/scene_component_authoring";
bind "../ui/scene_component_schema";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Str = Zanna.String;
bind Terminal = Zanna.Terminal;

func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func fail(tempDir: String, reason: String) {
    safe_io.DeleteDirectoryTree(tempDir);
    Terminal.Say("RESULT: fail " + reason);
}

func main() {
    var empty = scene_component_authoring.EmptySchemaText();
    var emptySchema =
        scene_component_schema.ParseText(empty, "memory");
    if emptySchema.valid == false
       or emptySchema.components.count() != 0 {
        fail("", "empty authoring schema was not valid");
        return;
    }

    var added = scene_component_authoring.AddStarterComponent(
        empty, scene_component_schema.TARGET_2D_OBJECT);
    var addedSchema =
        scene_component_schema.ParseText(added.content, "memory");
    if added.ok == false or added.changed == false
       or added.componentName != "component"
       or addedSchema.valid == false
       or addedSchema.components.count() != 1
       or addedSchema.components.get(0).target
          != scene_component_schema.TARGET_2D_OBJECT
       or addedSchema.components.get(0).fields.count() != 1
       or addedSchema.components.get(0).fields.get(0).key
          != "component.enabled"
       or addedSchema.components.get(0).fields.get(0).kind != "bool"
       or addedSchema.components.get(0).fields.get(0).defaultText != "true" {
        fail("", "starter component was not complete and deterministic");
        return;
    }

    var renamed = scene_component_authoring.UpdateComponent(
        added.content,
        "component",
        "enemy",
        "Enemy",
        scene_component_schema.TARGET_BOTH,
        "Reusable enemy data.");
    var enemySchema =
        scene_component_schema.ParseText(renamed.content, "memory");
    var enemy = enemySchema.Find(
        "enemy", scene_component_schema.TARGET_2D_OBJECT);
    if renamed.ok == false or renamed.changed == false
       or renamed.componentName != "enemy"
       or enemy == null or enemy.label != "Enemy"
       or enemy.target != scene_component_schema.TARGET_BOTH
       or enemy.description != "Reusable enemy data."
       or enemy.fields.get(0).key != "component.enabled" {
        fail("", "component update changed unrelated stable field keys");
        return;
    }

    var fieldAdded = scene_component_authoring.AddStarterField(
        renamed.content, "enemy");
    if fieldAdded.ok == false or fieldAdded.fieldKey != "enemy.value" {
        fail("", "starter field did not receive a unique portable key");
        return;
    }
    var fieldUpdated = scene_component_authoring.UpdateField(
        fieldAdded.content,
        "enemy",
        "enemy.value",
        "enemy.hp",
        "Hit points",
        "int",
        "25",
        "Starting health.",
        "");
    var fieldSchema =
        scene_component_schema.ParseText(fieldUpdated.content, "memory");
    enemy = fieldSchema.Find(
        "enemy", scene_component_schema.TARGET_2D_OBJECT);
    if fieldUpdated.ok == false or fieldUpdated.changed == false
       or fieldUpdated.fieldKey != "enemy.hp"
       or enemy == null or enemy.fields.count() != 2
       or enemy.FieldNamed("enemy.hp") == null
       or enemy.FieldNamed("enemy.hp").kind != "int"
       or enemy.FieldNamed("enemy.hp").defaultText != "25"
       or enemy.FieldNamed("enemy.hp").description != "Starting health." {
        fail("", "typed field update did not round-trip exactly");
        return;
    }

    var moved = scene_component_authoring.MoveField(
        fieldUpdated.content, "enemy", "enemy.hp", -1);
    var movedSchema =
        scene_component_schema.ParseText(moved.content, "memory");
    enemy = movedSchema.Find(
        "enemy", scene_component_schema.TARGET_2D_OBJECT);
    if moved.ok == false or moved.changed == false
       or enemy.fields.get(0).key != "enemy.hp" {
        fail("", "field ordering was not a stable structured edit");
        return;
    }

    var duplicate = scene_component_authoring.UpdateField(
        moved.content,
        "enemy",
        "enemy.hp",
        "component.enabled",
        "Duplicate",
        "int",
        "1",
        "",
        "");
    if duplicate.ok or duplicate.changed
       or duplicate.content != moved.content {
        fail("", "duplicate field edit did not fail closed");
        return;
    }

    var removed = scene_component_authoring.RemoveField(
        moved.content, "enemy", "component.enabled");
    var rejectedLast = scene_component_authoring.RemoveField(
        removed.content, "enemy", "enemy.hp");
    if removed.ok == false or removed.changed == false
       or rejectedLast.ok or rejectedLast.changed
       or rejectedLast.content != removed.content {
        fail("", "field removal violated the non-empty component contract");
        return;
    }

    var second = scene_component_authoring.AddStarterComponent(
        removed.content, scene_component_schema.TARGET_3D_NODE);
    var secondMoved = scene_component_authoring.MoveComponent(
        second.content, second.componentName, -1);
    var secondSchema =
        scene_component_schema.ParseText(secondMoved.content, "memory");
    if second.ok == false or second.componentName != "component"
       or secondMoved.ok == false or secondMoved.changed == false
       or secondSchema.components.get(0).name != "component"
       or secondSchema.components.get(1).name != "enemy" {
        fail("", "component insertion or ordering was not deterministic");
        return;
    }

    var unknownText =
        "{\"version\":1,\"vendor\":{\"keep\":true},\"components\":["
        + "{\"name\":\"enemy\",\"target\":\"both\",\"custom\":\"keep\","
        + "\"fields\":[{\"key\":\"enemy.hp\",\"type\":\"int\","
        + "\"default\":10,\"editorHint\":\"keep\"}]}]}";
    var unknownEdit = scene_component_authoring.UpdateField(
        unknownText,
        "enemy",
        "enemy.hp",
        "enemy.hp",
        "Hit points",
        "int",
        "12",
        "",
        "");
    if unknownEdit.ok == false
       or Str.Contains(unknownEdit.content, "\"vendor\"") == false
       or Str.Contains(unknownEdit.content, "\"custom\"") == false
       or Str.Contains(unknownEdit.content, "\"editorHint\"") == false {
        fail("", "structured edit discarded unknown version-1 members");
        return;
    }

    var previewText =
        "{\"version\":3,\"components\":["
        + "{\"name\":\"enemy\",\"target\":\"2d-object\",\"fields\":["
        + "{\"key\":\"enemy.hp\",\"type\":\"int\",\"default\":10}]}],"
        + "\"objectPreviews\":[{\"objectType\":\"enemy\","
        + "\"sprite\":\"assets/enemies.png\",\"frame\":7,"
        + "\"frameProperty\":\"enemy.type\","
        + "\"frameMap\":[4,9]}],\"vendor\":{\"keep\":true}}";
    var previewEdit = scene_component_authoring.UpdateField(
        previewText,
        "enemy",
        "enemy.hp",
        "enemy.hp",
        "Hit points",
        "int",
        "12",
        "",
        "");
    var previewSchema =
        scene_component_schema.ParseText(previewEdit.content, "memory");
    var previewRule = previewSchema.PreviewForObjectType("enemy");
    if previewEdit.ok == false or previewEdit.changed == false
       or previewSchema.valid == false
       or previewSchema.version
          != scene_component_schema.OBJECT_PREVIEW_SCHEMA_VERSION
       or previewRule == null
       or previewRule.sprite != "assets/enemies.png"
       or previewRule.frame != 7
       or previewRule.frameProperty != "enemy.type"
       or previewRule.frameOffset != 0
       or previewRule.frameMap.count() != 2
       or previewRule.frameMap.get(0) != 4
       or previewRule.frameMap.get(1) != 9
       or Str.Contains(previewEdit.content, "\"vendor\"") == false {
        fail("", "component edit discarded a version-3 preview profile");
        return;
    }

    var preview3DText =
        "{\"version\":4,\"components\":["
        + "{\"name\":\"spawn\",\"target\":\"3d-node\",\"fields\":["
        + "{\"key\":\"spawn.kind\",\"type\":\"string\","
        + "\"default\":\"player\"}]}],"
        + "\"scenePreview3D\":{"
        + "\"startXProperty\":\"world.startX\","
        + "\"startYProperty\":\"world.startY\","
        + "\"startZProperty\":\"world.startZ\","
        + "\"ambientRProperty\":\"world.ambientR\","
        + "\"ambientGProperty\":\"world.ambientG\","
        + "\"ambientBProperty\":\"world.ambientB\","
        + "\"showMarkers\":false}}";
    var preview3DEdit = scene_component_authoring.UpdateField(
        preview3DText,
        "spawn",
        "spawn.kind",
        "spawn.kind",
        "Spawn kind",
        "string",
        "hero",
        "",
        "");
    var preview3DSchema =
        scene_component_schema.ParseText(preview3DEdit.content, "memory");
    if preview3DEdit.ok == false or preview3DEdit.changed == false
       or preview3DSchema.valid == false
       or preview3DSchema.version
          != scene_component_schema.SCENE_PREVIEW_3D_SCHEMA_VERSION
       or preview3DSchema.scenePreview3D.present == false
       or preview3DSchema.scenePreview3D.HasStart() == false
       or preview3DSchema.scenePreview3D.startXProperty != "world.startX"
       or preview3DSchema.scenePreview3D.HasAmbient() == false
       or preview3DSchema.scenePreview3D.hasShowMarkers == false
       or preview3DSchema.scenePreview3D.showMarkers {
        fail("", "component edit discarded a version-4 3D preview profile");
        return;
    }

    var nodePreviewText =
        "{\"version\":5,\"components\":["
        + "{\"name\":\"prop\",\"target\":\"3d-node\",\"fields\":["
        + "{\"key\":\"prop.kind\",\"type\":\"int\",\"default\":0}]}],"
        + "\"nodePreviews3D\":[{"
        + "\"matchProperty\":\"af.kind\",\"matchValue\":\"prop\","
        + "\"prefab\":\"assets/editor/default.scene3d\","
        + "\"variantProperty\":\"prop.kind\","
        + "\"variantPrefabs\":[\"assets/editor/crate.scene3d\"]}]}";
    var nodePreviewEdit = scene_component_authoring.UpdateField(
        nodePreviewText,
        "prop",
        "prop.kind",
        "prop.kind",
        "Prop kind",
        "int",
        "1",
        "",
        "");
    var nodePreviewSchema =
        scene_component_schema.ParseText(nodePreviewEdit.content, "memory");
    var nodePreviewRule =
        nodePreviewSchema.NodePreview3DForMatch("af.kind", "prop");
    if nodePreviewEdit.ok == false or nodePreviewEdit.changed == false
       or nodePreviewSchema.valid == false
       or nodePreviewSchema.version
          != scene_component_schema.NODE_PREVIEW_3D_SCHEMA_VERSION
       or nodePreviewRule == null
       or nodePreviewRule.variantProperty != "prop.kind"
       or nodePreviewRule.PrefabForVariant(0)
          != "assets/editor/crate.scene3d"
       or nodePreviewRule.PrefabForVariant(4)
          != "assets/editor/default.scene3d" {
        fail("", "component edit discarded a version-5 node preview profile");
        return;
    }

    var skyPreviewText =
        "{\"version\":6,\"components\":["
        + "{\"name\":\"environment\",\"target\":\"3d-node\",\"fields\":["
        + "{\"key\":\"env.tag\",\"type\":\"string\",\"default\":\"sky\"}]}],"
        + "\"scenePreview3D\":{"
        + "\"clearRProperty\":\"h.r\","
        + "\"clearGProperty\":\"h.g\","
        + "\"clearBProperty\":\"h.b\","
        + "\"zenithRProperty\":\"z.r\","
        + "\"zenithGProperty\":\"z.g\","
        + "\"zenithBProperty\":\"z.b\","
        + "\"groundRProperty\":\"g.r\","
        + "\"groundGProperty\":\"g.g\","
        + "\"groundBProperty\":\"g.b\","
        + "\"sunXProperty\":\"sun.x\","
        + "\"sunYProperty\":\"sun.y\","
        + "\"sunZProperty\":\"sun.z\","
        + "\"sunRProperty\":\"sun.r\","
        + "\"sunGProperty\":\"sun.g\","
        + "\"sunBProperty\":\"sun.b\","
        + "\"sunIntensityProperty\":\"sun.i\"}}";
    var skyPreviewEdit = scene_component_authoring.UpdateField(
        skyPreviewText,
        "environment",
        "env.tag",
        "env.tag",
        "Environment tag",
        "string",
        "preview",
        "",
        "");
    var skyPreviewSchema =
        scene_component_schema.ParseText(skyPreviewEdit.content, "memory");
    if skyPreviewEdit.ok == false or skyPreviewEdit.changed == false
       or skyPreviewSchema.valid == false
       or skyPreviewSchema.version
          != scene_component_schema.SKY_LIGHT_PREVIEW_3D_SCHEMA_VERSION
       or skyPreviewSchema.scenePreview3D.HasSkyPalette() == false
       or skyPreviewSchema.scenePreview3D.HasSun() == false
       or skyPreviewSchema.scenePreview3D.sunIntensityProperty != "sun.i" {
        fail("", "component edit discarded a version-6 sky/light profile");
        return;
    }

    var atmosphericPreviewText =
        "{\"version\":7,\"components\":["
        + "{\"name\":\"environment\",\"target\":\"3d-node\",\"fields\":["
        + "{\"key\":\"env.tag\",\"type\":\"string\",\"default\":\"fog\"}]}],"
        + "\"scenePreview3D\":{"
        + "\"clearRProperty\":\"h.r\","
        + "\"clearGProperty\":\"h.g\","
        + "\"clearBProperty\":\"h.b\","
        + "\"zenithRProperty\":\"z.r\","
        + "\"zenithGProperty\":\"z.g\","
        + "\"zenithBProperty\":\"z.b\","
        + "\"groundRProperty\":\"g.r\","
        + "\"groundGProperty\":\"g.g\","
        + "\"groundBProperty\":\"g.b\","
        + "\"cameraFov\":90,"
        + "\"iblIntensity\":0.28,"
        + "\"heightFogProperty\":\"fog.enabled\","
        + "\"heightFogBase\":1.6,"
        + "\"heightFogFalloff\":0.35,"
        + "\"heightFogDensity\":0.06,"
        + "\"heightFogOpacity\":0.65}}";
    var atmosphericPreviewEdit = scene_component_authoring.UpdateField(
        atmosphericPreviewText,
        "environment",
        "env.tag",
        "env.tag",
        "Environment tag",
        "string",
        "preview",
        "",
        "");
    var atmosphericPreviewSchema =
        scene_component_schema.ParseText(
            atmosphericPreviewEdit.content, "memory");
    if atmosphericPreviewEdit.ok == false
       or atmosphericPreviewEdit.changed == false
       or atmosphericPreviewSchema.valid == false
       or atmosphericPreviewSchema.version
          != scene_component_schema
              .LENS_ATMOSPHERE_PREVIEW_3D_SCHEMA_VERSION
       or atmosphericPreviewSchema.scenePreview3D.hasCameraFov == false
       or near(
              atmosphericPreviewSchema.scenePreview3D.cameraFov,
              90.0) == false
       or atmosphericPreviewSchema.scenePreview3D.hasIblIntensity == false
       or atmosphericPreviewSchema.scenePreview3D.HasHeightFog() == false {
        fail(
            "",
            "component edit discarded a version-7 atmosphere profile");
        return;
    }

    var backgroundPreviewText =
        "{\"version\":8,\"components\":["
        + "{\"name\":\"environment\",\"target\":\"2d-object\","
        + "\"fields\":[{\"key\":\"env.tag\",\"type\":\"string\","
        + "\"default\":\"preview\"}]}],"
        + "\"scenePreview2D\":{"
        + "\"variantProperty\":\"region\",\"variantOffset\":-1,"
        + "\"variantImages\":[\"assets/backgrounds/region-01.png\"],"
        + "\"fit\":\"cover\",\"showGrid\":false}}";
    var backgroundPreviewEdit = scene_component_authoring.UpdateField(
        backgroundPreviewText,
        "environment",
        "env.tag",
        "env.tag",
        "Environment tag",
        "string",
        "preview",
        "",
        "");
    var backgroundPreviewSchema =
        scene_component_schema.ParseText(
            backgroundPreviewEdit.content, "memory");
    if backgroundPreviewEdit.ok == false
       or backgroundPreviewEdit.changed == false
       or backgroundPreviewSchema.valid == false
       or backgroundPreviewSchema.version
          != scene_component_schema.SCENE_PREVIEW_2D_SCHEMA_VERSION
       or backgroundPreviewSchema.scenePreview2D.present == false
       or backgroundPreviewSchema.scenePreview2D.variantProperty
          != "region"
       or backgroundPreviewSchema.scenePreview2D.variantOffset != -1
       or backgroundPreviewSchema.scenePreview2D.variantImages.count() != 1
       or backgroundPreviewSchema.scenePreview2D.showGrid {
        fail(
            "",
            "component edit discarded a version-8 2D scene profile");
        return;
    }

    var environmentPreviewText =
        "{\"version\":9,\"components\":["
        + "{\"name\":\"environment\",\"target\":\"3d-node\","
        + "\"fields\":[{\"key\":\"env.tag\",\"type\":\"string\","
        + "\"default\":\"terrain\"}]}],"
        + "\"scenePreview3D\":{"
        + "\"environmentPrefab\":\"assets/editor/fallback.scene3d\","
        + "\"environmentVariantProperty\":\"terrain.kind\","
        + "\"environmentVariantOffset\":-1,"
        + "\"environmentVariantPrefabs\":["
        + "\"assets/editor/canyon.scene3d\"]}}";
    var environmentPreviewEdit =
        scene_component_authoring.UpdateField(
            environmentPreviewText,
            "environment",
            "env.tag",
            "env.tag",
            "Environment tag",
            "string",
            "preview",
            "",
            "");
    var environmentPreviewSchema =
        scene_component_schema.ParseText(
            environmentPreviewEdit.content, "memory");
    if environmentPreviewEdit.ok == false
       or environmentPreviewEdit.changed == false
       or environmentPreviewSchema.valid == false
       or environmentPreviewSchema.version
          != scene_component_schema
              .SCENE_ENVIRONMENT_PREVIEW_3D_SCHEMA_VERSION
       or environmentPreviewSchema.scenePreview3D
              .environmentVariantProperty
          != "terrain.kind"
       or environmentPreviewSchema.scenePreview3D
              .environmentVariantOffset
          != -1
       or environmentPreviewSchema.scenePreview3D
              .EnvironmentPrefabForVariant(1)
          != "assets/editor/canyon.scene3d"
       or environmentPreviewSchema.scenePreview3D
              .EnvironmentPrefabForVariant(2)
          != "assets/editor/fallback.scene3d" {
        fail(
            "",
            "component edit discarded a version-9 environment profile");
        return;
    }

    var postFXPreviewText =
        "{\"version\":10,\"components\":["
        + "{\"name\":\"environment\",\"target\":\"3d-node\","
        + "\"fields\":[{\"key\":\"env.tag\",\"type\":\"string\","
        + "\"default\":\"terrain\"}]}],"
        + "\"scenePreview3D\":{"
        + "\"tonemapMode\":2,\"tonemapExposure\":1.17,"
        + "\"bloomThreshold\":0.9,\"bloomIntensity\":0.25,"
        + "\"bloomPasses\":3,"
        + "\"colorGradeBrightness\":0.03,"
        + "\"colorGradeContrast\":1.03,"
        + "\"colorGradeSaturation\":1.07,"
        + "\"vignetteRadius\":0.98,\"vignetteSoftness\":0.12,"
        + "\"fxaa\":true}}";
    var postFXPreviewEdit =
        scene_component_authoring.UpdateField(
            postFXPreviewText,
            "environment",
            "env.tag",
            "env.tag",
            "Environment tag",
            "string",
            "preview",
            "",
            "");
    var postFXPreviewSchema =
        scene_component_schema.ParseText(
            postFXPreviewEdit.content, "memory");
    if postFXPreviewEdit.ok == false
       or postFXPreviewEdit.changed == false
       or postFXPreviewSchema.valid == false
       or postFXPreviewSchema.version
          != scene_component_schema
              .SCENE_POSTFX_PREVIEW_3D_SCHEMA_VERSION
       or postFXPreviewSchema.scenePreview3D.HasPostFX() == false
       or postFXPreviewSchema.scenePreview3D.PostFXEffectCount() != 5
       or near(
              postFXPreviewSchema.scenePreview3D.tonemapExposure,
              1.17) == false
       or postFXPreviewSchema.scenePreview3D.bloomPasses != 3
       or near(
              postFXPreviewSchema.scenePreview3D
                  .colorGradeBrightness,
              0.03) == false
       or postFXPreviewSchema.scenePreview3D.fxaa == false {
        fail(
            "",
            "component edit discarded a version-10 post-FX profile");
        return;
    }

    var omittedDefaultText =
        "{\"version\":1,\"components\":["
        + "{\"name\":\"counter\",\"target\":\"both\",\"fields\":["
        + "{\"key\":\"counter.value\",\"type\":\"int\"}]}]}";
    var labelOnlyEdit = scene_component_authoring.UpdateField(
        omittedDefaultText,
        "counter",
        "counter.value",
        "counter.value",
        "Counter value",
        "int",
        "0",
        "",
        "");
    if labelOnlyEdit.ok == false or labelOnlyEdit.changed == false
       or Str.Contains(labelOnlyEdit.content, "\"label\"") == false
       or Str.Contains(labelOnlyEdit.content, "\"default\"") {
        fail("", "label-only edit materialized an omitted field default");
        return;
    }
    var fieldDescriptionOnly = scene_component_authoring.UpdateField(
        omittedDefaultText,
        "counter",
        "counter.value",
        "counter.value",
        "counter.value",
        "int",
        "0",
        "Counts accepted events.",
        "");
    if fieldDescriptionOnly.ok == false
       or Str.Contains(fieldDescriptionOnly.content, "\"description\"")
          == false
       or Str.Contains(fieldDescriptionOnly.content, "\"label\"")
       or Str.Contains(fieldDescriptionOnly.content, "\"default\"") {
        fail("", "field edit materialized unchanged optional members");
        return;
    }
    var componentDescriptionOnly =
        scene_component_authoring.UpdateComponent(
            omittedDefaultText,
            "counter",
            "counter",
            "counter",
            scene_component_schema.TARGET_BOTH,
            "Shared counter data.");
    if componentDescriptionOnly.ok == false
       or Str.Contains(componentDescriptionOnly.content, "\"description\"")
          == false
       or Str.Contains(componentDescriptionOnly.content, "\"label\"") {
        fail("", "component edit materialized an unchanged optional label");
        return;
    }

    var tempDir =
        TempFile.CreateDirWithPrefix("zannastudio_component_authoring_");
    var schemaPath = Path.Join(
        tempDir, scene_component_schema.SCHEMA_FILE_NAME);
    if tempDir == "" {
        fail(tempDir, "could not create schema authoring fixture");
        return;
    }
    var session =
        new scene_component_authoring.SceneComponentAuthoringSession();
    if session.Load(schemaPath) == false or session.found
       or session.currentText != empty
       or session.CanUndo() or session.CanRedo()
       or session.Apply(unknownEdit.content) == false
       or session.found == false
       or File.Exists(schemaPath) == false
       or File.ReadAllText(schemaPath) != unknownEdit.content
       or session.CanUndo() == false
       or session.CanRedo() {
        fail(tempDir, "schema session did not atomically create its file");
        return;
    }
    if session.Undo() == false or File.Exists(schemaPath)
       or session.found or session.currentText != empty
       or session.CanRedo() == false
       or session.Redo() == false
       or File.ReadAllText(schemaPath) != unknownEdit.content
       or session.found == false {
        fail(tempDir, "schema file creation was not exactly undoable");
        return;
    }

    var external = unknownEdit.content + "\n";
    if safe_io.WriteAllTextAtomic(schemaPath, external) == false
       or session.HasExternalChange() == false {
        fail(tempDir, "schema session did not notice an external edit");
        return;
    }
    var localEdit = scene_component_authoring.UpdateComponent(
        session.currentText,
        "enemy",
        "enemy",
        "Enemy changed locally",
        scene_component_schema.TARGET_BOTH,
        "");
    if localEdit.ok == false or session.Apply(localEdit.content)
       or File.ReadAllText(schemaPath) != external
       or session.error == ""
       or session.Reload() == false
       or session.currentText != external
       or session.CanUndo() or session.CanRedo() {
        fail(tempDir, "external conflict was overwritten or retained stale history");
        return;
    }

    safe_io.DeleteDirectoryTree(tempDir);
    Terminal.Say("RESULT: ok");
}
