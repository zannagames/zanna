//
// File: zannastudio/src/probes/scene_command_bar_probe.zia
// Purpose: Verify progressive 2D/3D scene command bars and menu dispatch.
// Key invariants:
//   - Complete secondary command sets remain in bounded, stateful menus at
//     compact, medium, and wide scene widths.
//   - Wider lanes enlarge the authored canvas/viewport instead of restoring
//     every historical direct control.
//   - Menu item clicks route through the same canonical editor commands.
// Ownership/Lifetime:
//   - The probe owns one AppShell, both editors, documents, and input harness.
// Links: zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/scene_editor_3d.zia,
//        zannastudio/src/ui/scene_panels_2d.zia,
//        zannastudio/src/ui/scene_panels_3d.zia,
//        zannastudio/src/ui/scene_terrain_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_command_bar_probe;

// ============================================================================
// MODULE: scene_command_bar_probe
// PURPOSE: Pin responsive command reachability and real popup interaction.
//
// WHERE-THIS-FITS: Broad editor probes own serialization and gesture depth;
//          this focused display probe owns command-bar layout and dispatch.
//
// TEACHING-NOTE: Popup rows are clicked through the real input harness. The
//          offsets follow ContextMenu's public visual contract: 28px command
//          rows, 9px separators, and 4px outer padding.
// ============================================================================

bind "../core/document";
bind "../core/document_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "scene_probe_support";
bind "../ui/scene_editor_2d";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_2d";
bind "../ui/scene_panels_3d";
bind "../ui/scene_terrain_3d";

bind Convert = Zanna.Core.Convert;
bind GUI = Zanna.GUI;
bind Terminal = Zanna.Terminal;

func HarnessCoordinate(shell: app_shell.AppShell,
                       logical: Number) -> Integer {
    var scale = shell.app.GetEffectiveScale();
    if scale <= 0.0 { scale = 1.0; }
    return Convert.NumToInt(logical * scale);
}

func ClickWidget(shell: app_shell.AppShell,
                 harness: GUI.TestHarness,
                 widget: GUI.Widget) {
    var x = HarnessCoordinate(
        shell, widget.GetScreenX() + widget.GetScreenWidth() / 2.0);
    var y = HarnessCoordinate(
        shell, widget.GetScreenY() + widget.GetScreenHeight() / 2.0);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

func Fail(shell: app_shell.AppShell,
          harness: GUI.TestHarness,
          reason: String) {
    if harness != null { harness.UnbindApp(); }
    if shell != null { shell.Destroy(); }
    Terminal.Say("RESULT: fail " + reason);
}

func Pump2D(shell: app_shell.AppShell,
            editor: scene_editor_2d.SceneEditor2D,
            sceneDoc: document.Document) {
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
}

func Pump3D(shell: app_shell.AppShell,
            editor: scene_editor_3d.SceneEditor3D,
            sceneDoc: document.Document) {
    editor.Pump(sceneDoc);
    shell.Poll();
    shell.Render();
}

/// @brief Verify responsive 2D command menus and progressive controls.
func VerifyCommandBar2D() -> Boolean {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Scene Command Bar Probe", 1120, 720);
    var documents = new document_manager.DocumentManager();

    var editor2d = new scene_editor_2d.SceneEditor2D();
    scene_panels_2d.Build(
        editor2d, shell.workbench.scene2DHost, shell.app);
    var doc2d = documents.NewScene2DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_2D);
    editor2d.Activate(doc2d);
    Pump2D(shell, editor2d, doc2d);
    Pump2D(shell, editor2d, doc2d);

    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, harness, "input harness binding");
        return false;
    }

    if scene_editor_2d.UsesSceneCommandMenus(
           editor2d.root.GetLogicalWidth()) == false
       or editor2d.sceneMenuButton.IsVisible() == false
       or editor2d.toolMenuButton.IsVisible() == false
       or editor2d.viewMenuButton.IsVisible() == false
       or editor2d.newSceneButton.IsVisible()
       or editor2d.importButton.IsVisible()
       or editor2d.previewButton.IsVisible()
       or editor2d.runSceneButton.IsVisible()
       or editor2d.rectangleButton.IsVisible()
       or editor2d.gridButton.IsVisible()
       or editor2d.canvasScroll.GetScreenHeight()
           < scene_probe_support.MIN_CANVAS_SCROLL_HEIGHT
       or editor2d.toolbar.GetScreenHeight()
           > scene_probe_support.MAX_COMMAND_TOOLBAR_HEIGHT
       or editor2d.viewToolbar.GetScreenHeight()
           > scene_probe_support.MAX_VIEW_TOOLBAR_HEIGHT {
        Fail(shell, harness, "2D medium command-bar geometry");
        return false;
    }

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.sceneMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.sceneMenu.IsVisible() == false
       or editor2d.sceneNewItem.IsEnabled() == false
       or editor2d.sceneImportItem.IsEnabled() == false
       or editor2d.scenePreviewItem.IsCheckable() == false
       or editor2d.scenePreviewItem.IsChecked()
       or editor2d.sceneRunItem.IsEnabled() == false {
        Fail(shell, harness, "2D Scene menu state");
        return false;
    }
    // Preview Animations, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(
        shell, harness, editor2d.scenePreviewItem);
    editor2d.Pump(doc2d);
    if editor2d.PreviewActive() == false {
        Fail(shell, harness, "2D Scene Preview dispatch");
        return false;
    }
    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.sceneMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.scenePreviewItem.IsChecked() == false {
        Fail(shell, harness, "2D Scene Preview check state");
        return false;
    }
    editor2d.sceneMenu.Hide();
    editor2d.SetPreviewActive(false);

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.sceneMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    // Run Scene, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(shell, harness, editor2d.sceneRunItem);
    editor2d.Pump(doc2d);
    if editor2d.TakeRunSceneRequested() == false {
        Fail(shell, harness, "2D Scene Run dispatch");
        return false;
    }

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.toolMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.toolMenu.IsVisible() == false
       or editor2d.toolSelectItem.IsChecked() == false {
        Fail(shell, harness, "2D Tools menu state");
        return false;
    }
    // Rectangle tool, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(
        shell, harness, editor2d.toolRectangleItem);
    editor2d.Pump(doc2d);
    if editor2d.mode != scene_editor_2d.MODE_RECTANGLE {
        Fail(shell, harness, "2D Rectangle menu dispatch");
        return false;
    }
    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.toolMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.toolRectangleItem.IsChecked() == false
       or editor2d.toolSelectItem.IsChecked() {
        Fail(shell, harness, "2D active tool check state");
        return false;
    }
    editor2d.toolMenu.Hide();

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.viewMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.viewMenu.IsVisible() == false
       or editor2d.viewGridItem.IsChecked() == false
       or editor2d.viewRulersItem.IsChecked() == false
       or editor2d.viewWorkspaceItem.IsCheckable() == false {
        Fail(shell, harness, "2D View menu state");
        return false;
    }
    // Grid toggle, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(shell, harness, editor2d.viewGridItem);
    editor2d.Pump(doc2d);
    if editor2d.showGrid {
        Fail(shell, harness, "2D Grid menu dispatch");
        return false;
    }
    scene_probe_support.ClickToolbarItem(
        shell, harness, editor2d.viewMenuButton);
    editor2d.Pump(doc2d);
    shell.Render();
    if editor2d.viewGridItem.IsChecked() {
        Fail(shell, harness, "2D Grid menu check did not refresh");
        return false;
    }
    editor2d.viewMenu.Hide();

    shell.SetSceneWorkspaceMode(true);
    shell.app.SetWindowSize(1500, 900);
    Pump2D(shell, editor2d, doc2d);
    Pump2D(shell, editor2d, doc2d);
    if scene_editor_2d.UsesSceneCommandMenus(
           editor2d.root.GetLogicalWidth()) == false
       or editor2d.sceneMenuButton.IsVisible() == false
       or editor2d.toolMenuButton.IsVisible() == false
       or editor2d.viewMenuButton.IsVisible() == false
       or editor2d.newSceneButton.IsVisible()
       or editor2d.previewButton.IsVisible()
       or editor2d.rectangleButton.IsVisible()
       or editor2d.gridButton.IsVisible()
       or editor2d.selectButton.IsVisible() == false
       or editor2d.paintButton.IsVisible() == false
       or editor2d.eraseButton.IsVisible() == false
       or editor2d.gameViewButton.IsVisible() == false {
        Fail(shell, harness, "2D wide progressive commands expanded");
        return false;
    }

    harness.UnbindApp();
    shell.Destroy();
    return true;
}

/// @brief Verify responsive 3D command menus and progressive controls.
func VerifyCommandBar3D() -> Boolean {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio 3D Command Bar Probe", 1120, 720);
    var documents = new document_manager.DocumentManager();
    var editor3d = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(
        editor3d, shell.workbench.scene3DHost, shell.app);
    var doc3d = documents.NewScene3DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);
    editor3d.Activate(doc3d);
    Pump3D(shell, editor3d, doc3d);
    Pump3D(shell, editor3d, doc3d);
    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, harness, "3D input harness binding");
        return false;
    }
    if editor3d.AddPrimitiveFromMenu(
           scene_editor_3d.PRIMITIVE_BOX, false) == false {
        Fail(shell, harness, "3D placement fixture");
        return false;
    }
    Pump3D(shell, editor3d, doc3d);

    if scene_editor_3d.UsesSceneCommandMenus(
           editor3d.root.GetLogicalWidth()) == false
       or editor3d.sceneMenuButton.IsVisible() == false
       or editor3d.createMenuButton.IsVisible() == false
       or editor3d.placementMenuButton.IsVisible() == false
       or editor3d.viewMenuButton.IsVisible() == false
       or editor3d.newSceneButton.IsVisible()
       or editor3d.importAssetButton.IsVisible()
       or editor3d.importInstanceButton.IsVisible()
       or editor3d.duplicateNodeButton.IsVisible()
       or editor3d.deleteNodeButton.IsVisible()
       or editor3d.runSceneButton.IsVisible()
       or editor3d.addTerrainButton.IsVisible()
       or editor3d.vertexSnapCheck.IsVisible()
       or editor3d.frameSelectedButton.IsVisible()
       or editor3d.viewportScroll.GetScreenHeight()
           < scene_probe_support.MIN_CANVAS_SCROLL_HEIGHT
       or editor3d.toolbar.GetScreenHeight()
           > scene_probe_support.MAX_COMMAND_TOOLBAR_HEIGHT
       or editor3d.viewToolbar.GetScreenHeight()
           > scene_probe_support.MAX_VIEW_TOOLBAR_HEIGHT {
        Fail(shell, harness, "3D medium command-bar geometry");
        return false;
    }

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.sceneMenuButton);
    editor3d.Pump(doc3d);
    shell.Render();
    if editor3d.sceneMenu.IsVisible() == false
       or editor3d.sceneNewItem.IsEnabled() == false
       or editor3d.sceneImportAssetItem.IsEnabled() == false
       or editor3d.sceneImportInstanceItem.IsEnabled() == false
       or editor3d.sceneRunItem.IsEnabled() == false {
        Fail(shell, harness, "3D Scene menu state");
        return false;
    }
    // Run Scene, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(shell, harness, editor3d.sceneRunItem);
    editor3d.Pump(doc3d);
    if editor3d.TakeRunSceneRequested() == false {
        Fail(shell, harness, "3D Scene Run dispatch");
        return false;
    }

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.createMenuButton);
    editor3d.Pump(doc3d);
    shell.Render();
    if editor3d.createMenu.IsVisible() == false
       or editor3d.createTerrainItem.IsEnabled() == false {
        Fail(shell, harness, "3D Create Terrain menu state");
        return false;
    }
    // Create Terrain, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(
        shell, harness, editor3d.createTerrainItem);
    editor3d.Pump(doc3d);
    if editor3d.flatNodes.count() != 2
       or editor3d.selectedIndex < 0
       or scene_terrain_3d.IsTerrainNode(
              editor3d.flatNodes.get(editor3d.selectedIndex)) == false
       or editor3d.IsTerrainSculptEnabled() == false {
        Fail(shell, harness, "3D Create Terrain menu dispatch");
        return false;
    }

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.placementMenuButton);
    // ToolbarItem click edges clear on read (ADR 0220), so the pump must be
    // the only consumer; the diagnostic below reads the already-drained edge.
    editor3d.Pump(doc3d);
    var placementButtonClicked =
        editor3d.placementMenuButton.WasClicked();
    shell.Render();
    if editor3d.placementMenu.IsVisible() == false
       or editor3d.placementVertexItem.IsChecked() {
        Fail(shell, harness,
             "3D Placement menu state visible="
             + editor3d.placementMenu.IsVisible()
             + " button-enabled="
             + editor3d.placementMenuButton.IsEnabled()
             + " clicked=" + placementButtonClicked
             + " bounds=" + editor3d.placementMenuButton.GetScreenX()
             + "," + editor3d.placementMenuButton.GetScreenY()
             + " " + editor3d.placementMenuButton.GetScreenWidth()
             + "x" + editor3d.placementMenuButton.GetScreenHeight()
             + " selected=" + editor3d.selectedIndices.count()
             + " vertex=" + editor3d.vertexSnapEnabled + "/"
             + editor3d.placementVertexItem.IsChecked());
        return false;
    }
    // Vertex Move, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(
        shell, harness, editor3d.placementVertexItem);
    editor3d.Pump(doc3d);
    if editor3d.vertexSnapEnabled == false {
        Fail(shell, harness, "3D Vertex Move menu dispatch");
        return false;
    }
    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.placementMenuButton);
    editor3d.Pump(doc3d);
    shell.Render();
    if editor3d.placementVertexItem.IsChecked() == false {
        Fail(shell, harness, "3D Vertex Move check did not refresh");
        return false;
    }
    editor3d.placementMenu.Hide();

    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.viewMenuButton);
    editor3d.Pump(doc3d);
    shell.Render();
    if editor3d.viewMenu.IsVisible() == false
       or editor3d.viewProjectionItem.IsChecked() == false
       or editor3d.viewFocusItem.IsCheckable() == false
       or editor3d.viewWorkspaceItem.IsCheckable() == false {
        Fail(shell, harness, "3D View menu state");
        return false;
    }
    // Perspective Projection, clicked by handle (ADR 0219).
    scene_probe_support.ClickMenuItem(
        shell, harness, editor3d.viewProjectionItem);
    editor3d.Pump(doc3d);
    if editor3d.viewPerspective {
        Fail(shell, harness, "3D Projection menu dispatch");
        return false;
    }
    scene_probe_support.ClickToolbarItem(
        shell, harness, editor3d.viewMenuButton);
    editor3d.Pump(doc3d);
    shell.Render();
    if editor3d.viewProjectionItem.IsChecked() {
        Fail(shell, harness, "3D Projection check did not refresh");
        return false;
    }
    editor3d.viewMenu.Hide();

    shell.app.SetMinimumSize(1, 1);
    shell.app.SetWindowSize(560, 420);
    Pump3D(shell, editor3d, doc3d);
    Pump3D(shell, editor3d, doc3d);
    if editor3d.viewMenuButton.IsVisible() == false
       or editor3d.viewportScroll.GetScreenHeight()
           < scene_probe_support.MIN_COMPACT_VIEWPORT_HEIGHT {
        Fail(shell, harness, "3D compact View access or viewport height");
        return false;
    }

    shell.SetSceneWorkspaceMode(true);
    shell.app.SetWindowSize(1500, 900);
    Pump3D(shell, editor3d, doc3d);
    Pump3D(shell, editor3d, doc3d);
    if scene_editor_3d.UsesSceneCommandMenus(
           editor3d.root.GetLogicalWidth()) == false
       or editor3d.sceneMenuButton.IsVisible() == false
       or editor3d.createMenuButton.IsVisible() == false
       or editor3d.placementMenuButton.IsVisible() == false
       or editor3d.viewMenuButton.IsVisible() == false
       or editor3d.newSceneButton.IsVisible()
       or editor3d.importAssetButton.IsVisible()
       or editor3d.duplicateNodeButton.IsVisible()
       or editor3d.deleteNodeButton.IsVisible()
       or editor3d.addBoxButton.IsVisible()
       or editor3d.addTerrainButton.IsVisible()
       or editor3d.vertexSnapCheck.IsVisible()
       or editor3d.frameSelectedButton.IsVisible()
       or editor3d.moveToolButton.IsVisible() == false
       or editor3d.rotateToolButton.IsVisible() == false
       or editor3d.scaleToolButton.IsVisible() == false
       or editor3d.gameViewButton.IsVisible() == false {
        Fail(shell, harness, "3D wide progressive commands expanded");
        return false;
    }

    harness.UnbindApp();
    shell.Destroy();
    return true;
}

func main() {
    if VerifyCommandBar2D() == false { return; }
    if VerifyCommandBar3D() == false { return; }
    Terminal.Say("RESULT: ok");
}
