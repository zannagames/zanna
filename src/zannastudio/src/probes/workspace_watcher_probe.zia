//
// File: zannastudio/src/probes/workspace_watcher_probe.zia
// Purpose: Prove workspace watcher startup and degraded rescans remain bounded
//          across frames instead of recursively blocking Open Folder.
// Key invariants:
//   - The first watcher pump installs at most one bounded directory page.
//   - Ordinary directory modification events preserve live watcher handles.
//   - Degraded fingerprints advance one bounded FileIndex page per pump.
// Ownership/Lifetime:
//   - The probe owns and removes one temporary workspace and all its watchers.
// Links: zannastudio/src/app/workspace_watcher.zia
//
//===----------------------------------------------------------------------===//

module workspace_watcher_probe;

bind "../app/workspace_watcher";
bind "../app/workspace_watcher_fallback";
bind "../app/file_watch_controller";
bind "../core/document";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../services/locations";
bind "../services/safe_io";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Map = Zanna.Collections.Map;
bind Seq = Zanna.Collections.Seq;
bind Terminal = Zanna.Terminal;
bind Clock = Zanna.Time.Clock;

func fail(state: workspace_watcher.WorkspaceWatcherState,
          root: String,
          reason: String) {
    workspace_watcher.StopWorkspaceWatcher(state);
    safe_io.DeleteDirectoryTree(root);
    Terminal.Say("RESULT: fail - " + reason);
}

func watcherEvent(path: String,
                  typeName: String,
                  requiresRescan: Boolean) -> Any {
    var event = Map.New();
    Map.SetStr(event, "path", path);
    Map.SetStr(event, "oldPath", "");
    Map.SetStr(event, "newPath", "");
    Map.SetStr(event, "typeName", typeName);
    Map.SetBool(event, "requiresRescan", requiresRescan);
    return event;
}

func renameEvent(oldPath: String,
                 newPath: String) -> Any {
    var event = watcherEvent(newPath, "renamed",
                             oldPath == "" or newPath == "");
    Map.SetStr(event, "oldPath", oldPath);
    Map.SetStr(event, "newPath", newPath);
    return event;
}

/// @brief State shared by active-file and workspace watcher scenarios.
class WorkspaceWatcherProbeContext {
    expose String root;
    expose project_manager.ProjectManager projMgr;
}

/// @brief Verify active and inactive document watcher lifecycle and budgets.
func VerifyDocumentWatchers(
    ctx: WorkspaceWatcherProbeContext) -> Boolean {
    var root = TempFile.CreateDirWithPrefix("zannastudio_workspace_watcher_");
    var i = 0;
    while i < 100 {
        safe_io.MakeAll(Path.Join(root, "folder_" + i));
        i = i + 1;
    }
    i = 0;
    while i < 300 {
        File.WriteAllText(Path.Join(root, "file_" + i + ".zia"), "module WatchProbe;\n");
        i = i + 1;
    }

    var projMgr = new project_manager.ProjectManager();
    if projMgr.OpenFolder(root) == false {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - temporary workspace did not open");
        return false;
    }
    var fileWatch = new file_watch_controller.FileWatchController();
    if fileWatch.hasWatcher or fileWatch.fileWatcher != null {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - active-file watcher created a CWD placeholder");
        return false;
    }
    var fileDocs = new document_manager.DocumentManager();
    var watchedFilePath = Path.Join(root, "file_0.zia");
    fileDocs.OpenFile(watchedFilePath);
    fileWatch.Pump(null, fileDocs, 0);
    if fileWatch.watchedPath != watchedFilePath {
        fileWatch.Destroy();
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - active-file watcher did not remember its path");
        return false;
    }
    if fileWatch.hasWatcher and fileWatch.lastOpenDocPollMetadataCount != 0 {
        fileWatch.Destroy();
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - native active watcher did not suppress duplicate metadata polling");
        return false;
    }
    fileWatch.Destroy();
    if fileWatch.hasWatcher or fileWatch.fileWatcher != null or fileWatch.watchedPath != "" {
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - active-file watcher cleanup retained state");
        return false;
    }

    // Inactive-tab metadata checks are a resumable pass, not an O(open tabs)
    // filesystem burst. Modify a late tab so detection also proves the cursor
    // eventually reaches beyond the first frame's four-document budget.
    var manyDocs = new document_manager.DocumentManager();
    i = 0;
    while i < 24 {
        manyDocs.OpenFile(Path.Join(root, "file_" + i + ".zia"));
        i = i + 1;
    }
    File.WriteAllText(Path.Join(root, "file_17.zia"),
                      "module WatchProbeChangedAcrossFrames;\n");
    var manyFileWatch = new file_watch_controller.FileWatchController();
    manyFileWatch.Pump(null, manyDocs, 0);
    if manyFileWatch.lastOpenDocPollCount != 4
       or manyFileWatch.openDocPollActive == false
       or manyFileWatch.openDocPollIndex != 4 {
        manyFileWatch.Destroy();
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - open-document metadata poll was not frame-bounded");
        return false;
    }
    var metadataFrames = 1;
    while manyFileWatch.openDocPollActive and metadataFrames < 20 {
        manyFileWatch.Pump(null, manyDocs, 0);
        if manyFileWatch.lastOpenDocPollCount > 4 {
            manyFileWatch.Destroy();
            safe_io.DeleteDirectoryTree(root);
            Terminal.Say("RESULT: fail - open-document metadata budget was exceeded");
            return false;
        }
        metadataFrames = metadataFrames + 1;
    }
    var changedDoc = manyDocs.GetDocument(17);
    if manyFileWatch.openDocPollActive or metadataFrames != 6
       or changedDoc == null
       or changedDoc!.externalState != document.EXTERNAL_STATE_CHANGED
       or changedDoc!.externalChangeNotified == false {
        manyFileWatch.Destroy();
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - resumable metadata poll missed a late changed tab");
        return false;
    }
    manyFileWatch.Destroy();

    // A missing active path is remembered after the first failed watcher
    // attempt. The next frame must not repeat an Exists/Watcher.New cycle.
    var missingPath = Path.Join(root, "transient_missing.zia");
    File.WriteAllText(missingPath, "module TransientMissing;\n");
    var missingDocs = new document_manager.DocumentManager();
    missingDocs.OpenFile(missingPath);
    File.Delete(missingPath);
    var missingWatch = new file_watch_controller.FileWatchController();
    missingWatch.Pump(null, missingDocs, 0);
    var firstAttemptMs = missingWatch.lastWatcherAttemptMs;
    missingWatch.Pump(null, missingDocs, 0);
    if missingWatch.watchedPath != missingPath or missingWatch.hasWatcher
       or missingWatch.lastWatcherAttemptMs != firstAttemptMs {
        missingWatch.Destroy();
        safe_io.DeleteDirectoryTree(root);
        Terminal.Say("RESULT: fail - missing active file retried its watcher every frame");
        return false;
    }
    missingWatch.Destroy();

    ctx.root = root;
    ctx.projMgr = projMgr;
    return true;
}

/// @brief Verify cooperative discovery, topology events, and fallback scans.
func VerifyWorkspaceWatchers(
    ctx: WorkspaceWatcherProbeContext) -> Boolean {
    var root = ctx.root;
    var projMgr = ctx.projMgr;

    // Diagnostics preserve the first actionable degradation cause instead of
    // replacing it with a less useful downstream fallback symptom.
    var telemetryState = new workspace_watcher.WorkspaceWatcherState();
    workspace_watcher.MarkDegraded(telemetryState, "native watcher limit reached");
    workspace_watcher.MarkDegraded(telemetryState, "fallback scan failed");
    if telemetryState.degraded == false
       or telemetryState.degradationReason != "native watcher limit reached" {
        fail(telemetryState, root, "watcher degradation diagnostics were unstable");
        return false;
    }

    var duplicateEvents = Seq.New();
    Seq.Push(duplicateEvents, watcherEvent(Path.Join(root, "same.zia"), "modified", false));
    Seq.Push(duplicateEvents, watcherEvent(Path.Join(root, "same.zia"), "modified", false));
    Seq.Push(duplicateEvents, watcherEvent(Path.Join(root, "same.zia"), "created", false));
    var coalescedEvents = workspace_watcher.CoalesceWorkspaceEvents(duplicateEvents);
    if Seq.get_Count(coalescedEvents) != 2 {
        fail(telemetryState, root, "duplicate workspace events were not coalesced");
        return false;
    }

    // A rename can preserve every metadata field. The fallback digest must
    // therefore include normalized path identity, not only id/time/size.
    var fingerprintState = new workspace_watcher.WorkspaceWatcherState();
    var fingerprintEntry = Map.New();
    Map.SetInt(fingerprintEntry, "id", 77);
    Map.SetInt(fingerprintEntry, "modified", 88);
    Map.SetInt(fingerprintEntry, "size", 99);
    Map.SetBool(fingerprintEntry, "isDirectory", false);
    Map.SetStr(fingerprintEntry, "path", Path.Join(root, "before.zia"));
    workspace_watcher_fallback.Accumulate(fingerprintState,
                                           fingerprintEntry);
    var beforePathFingerprint = fingerprintState.fallbackCurrentFingerprint;
    fingerprintState.fallbackCurrentFingerprint = 0;
    Map.SetStr(fingerprintEntry, "path", Path.Join(root, "after.zia"));
    workspace_watcher_fallback.Accumulate(fingerprintState,
                                           fingerprintEntry);
    if fingerprintState.fallbackCurrentFingerprint == beforePathFingerprint {
        fail(fingerprintState, root, "fallback fingerprint omitted entry path");
        return false;
    }

    var narrowLocations = new locations.LocationStore();
    var staleId = narrowLocations.Add(Path.Join(root, "folder_1/stale.zia"),
                                      1, 1, 1, 2, locations.KIND_SEARCH, "stale");
    var keptId = narrowLocations.Add(Path.Join(root, "folder_2/kept.zia"),
                                     1, 1, 1, 2, locations.KIND_SEARCH, "kept");
    var nextLocationId = narrowLocations.nextId;
    if narrowLocations.InvalidatePath(Path.Join(root, "folder_1")) != 1
       or narrowLocations.Get(staleId) != null
       or narrowLocations.Get(keptId) == null
       or narrowLocations.nextId != nextLocationId {
        fail(fingerprintState, root, "path-scoped location invalidation widened scope");
        return false;
    }

    var state = new workspace_watcher.WorkspaceWatcherState();
    workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
    if state.watchers.count() <= 0 or state.watchers.count() > 65
       or state.discoveryActive == false {
        fail(state, root, "watcher startup was not frame-bounded");
        return false;
    }

    var rounds = 0;
    while state.discoveryActive and rounds < 16 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        rounds = rounds + 1;
    }
    if state.discoveryActive
       or (state.watchers.count() != 101 and state.degraded == false)
       or state.watchers.count() <= 0
       or state.watching == false {
        fail(state, root, "cooperative watcher discovery did not complete"
             + ": active=" + state.discoveryActive
             + " watchers=" + state.watchers.count()
             + " watching=" + state.watching
             + " root=" + state.discoveryRootIndex
             + " offset=" + state.discoveryPageOffset
             + " rounds=" + rounds);
        return false;
    }
    workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
    if state.lastWatcherPollCount <= 0 or state.lastWatcherPollCount > 32 {
        fail(state, root, "quiet watcher rotation exceeded its frame budget");
        return false;
    }

    var modificationEvents = Seq.New();
    Seq.Push(modificationEvents, watcherEvent(root, "modified", false));
    var watcherCount = state.watchers.count();
    if workspace_watcher.ObserveWorkspaceTopologyEvents(state, modificationEvents)
       or state.watchers.count() != watcherCount or state.discoveryActive == false {
        fail(state, root, "ordinary directory modification rebuilt live watchers");
        return false;
    }
    rounds = 0;
    while state.discoveryActive and rounds < 16 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        rounds = rounds + 1;
    }
    if state.discoveryActive or state.watchers.count() != watcherCount {
        fail(state, root, "additive topology discovery did not preserve watchers");
        return false;
    }
    var completeRenameEvents = Seq.New();
    var renamedDirectory = Path.Join(root, "folder_1");
    Seq.Push(completeRenameEvents,
             renameEvent(renamedDirectory, Path.Join(root, "renamed-folder")));
    if workspace_watcher.EventsRequireFallback(completeRenameEvents)
       or workspace_watcher.ObserveWorkspaceTopologyEvents(state,
                                                            completeRenameEvents) == false
       or state.watchers.count() < watcherCount - 1
       or workspace_watcher.WatcherPathKnown(state, renamedDirectory) {
        fail(state, root, "complete rename endpoints were not handled narrowly");
        return false;
    }
    rounds = 0;
    while state.discoveryActive and rounds < 16 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        rounds = rounds + 1;
    }
    if state.discoveryActive or state.watchers.count() != watcherCount {
        fail(state, root, "renamed subtree reconciliation dropped unrelated watchers");
        return false;
    }
    var incompleteRenameEvents = Seq.New();
    Seq.Push(incompleteRenameEvents, renameEvent(root, ""));
    if workspace_watcher.EventsRequireFallback(incompleteRenameEvents) == false {
        fail(state, root, "incomplete rename did not request a conservative rescan");
        return false;
    }
    var overflowEvents = Seq.New();
    Seq.Push(overflowEvents, watcherEvent(root, "overflow", true));
    if workspace_watcher.ObserveWorkspaceTopologyEvents(state, overflowEvents) == false {
        fail(state, root, "overflow did not request cooperative rediscovery");
        return false;
    }
    if state.watchers.count() != watcherCount {
        fail(state, root, "overflow dropped live watcher coverage");
        return false;
    }
    rounds = 0;
    while state.discoveryActive and rounds < 16 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        rounds = rounds + 1;
    }

    state.degraded = true;
    state.rescanThrottle.Reset();
    workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
    if state.fallbackScanActive == false or state.fallbackFuture == null
       or state.fallbackPageOffset != 0 {
        fail(state, root, "fallback scan did not leave traversal on its worker"
             + ": active=" + state.fallbackScanActive
             + " offset=" + state.fallbackPageOffset
             + " root=" + state.fallbackRootIndex
             + " discovery=" + state.discoveryActive
             + " roots=" + state.rootPaths.count()
             + " degraded=" + state.degraded);
        return false;
    }
    rounds = 0;
    while state.fallbackScanActive and rounds < 20000 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        Clock.Sleep(1);
        rounds = rounds + 1;
    }
    if state.fallbackScanActive or state.fallbackBaselineReady == false
       or state.lastEntryCount != 400 {
        fail(state, root, "fallback baseline did not complete");
        return false;
    }

    var firstFingerprint = state.lastFingerprint;
    // Keep the exact byte length and rewrite immediately. Nanosecond metadata
    // plus bounded content sampling must detect what whole-second mtime+size
    // aggregation could miss.
    File.WriteAllText(Path.Join(root, "file_0.zia"), "module MatchProbe;\n");
    state.rescanThrottle.Reset();
    workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
    rounds = 0;
    while state.discoveryActive and rounds < 16 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        rounds = rounds + 1;
    }
    if state.fallbackScanActive == false {
        state.rescanThrottle.Reset();
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
    }
    rounds = 0;
    while state.fallbackScanActive and rounds < 20000 {
        workspace_watcher.PumpWorkspaceWatcher(null, projMgr, null, null, null, null, state);
        Clock.Sleep(1);
        rounds = rounds + 1;
    }
    if state.fallbackScanActive or state.lastFingerprint == firstFingerprint {
        fail(state, root, "fallback fingerprint missed a file modification");
        return false;
    }

    workspace_watcher.StopWorkspaceWatcher(state);
    safe_io.DeleteDirectoryTree(root);
    return true;
}

func main() {
    var ctx = new WorkspaceWatcherProbeContext();
    if VerifyDocumentWatchers(ctx) == false { return; }
    if VerifyWorkspaceWatchers(ctx) == false { return; }

    Terminal.Say("RESULT: ok");
}
