//
// File: zannastudio/src/probes/scene_editor_2d_probe.zia
// Purpose: Verify Studio's 2D scene surface, visual tilesets, edits, and round
//          trip.
// Key invariants:
//   - Scene documents select the visual surface instead of the code editor.
//   - Tile/object edits immediately update the shared dirty Document JSON.
//   - Tiny scenes fit above 400%, canvases center, and strokes commit once.
//   - Large worlds first open at native art scale around the authored start.
//   - Compact windows wrap actions and show canvas or inspector at full width.
//   - Standard desktop windows expose three balanced panes with the canvas
//     wider than either supporting pane.
//   - Scene metadata, object metadata, typed-property duplication,
//     transactional batch property edits, precision nudging, selection
//     arrangement, reusable project components, retained hierarchy, and draw
//     ordering round trip.
//   - Bounded hierarchy search matches object ids/types case-insensitively,
//     wraps in both directions, reveals nested rows, and never edits history.
//   - Scene selection command focus never escapes inspector inputs.
//   - Standard clipboard actions preserve typed multi-object data across tabs.
//   - Relative layer images render source-over tiles, drive a visual palette,
//     and create one no-op-safe asset history transaction.
//   - Per-document tools, canvas framing, inspector layout, and undo survive
//     scene-to-scene tab switches without leaking into the other scene.
//   - Undoing to the clean baseline clears dirty state and Save As adds .scene.
//   - Invalid JSON is preserved and never replaced by an empty scene.
// Ownership/Lifetime:
//   - The probe owns and destroys one isolated AppShell window.
// Links: zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/scene_clipboard.zia,
//        zannastudio/src/ui/scene_tileset_2d.zia,
//        zannastudio/src/core/document_manager.zia,
//        docs/adr/0174-scene-object-authoring-metadata-and-duplication.md,
//        docs/adr/0158-scene-level-property-authoring.md,
//        docs/adr/0160-project-scene-component-schemas.md,
//        docs/adr/0164-backward-compatible-2d-scene-object-hierarchy.md
//
//===----------------------------------------------------------------------===//

module scene_editor_2d_probe;

bind "scene_editor_2d_probe_context" as Probe;
bind "scene_editor_2d_probe_part_1" as Part1;
bind "scene_editor_2d_probe_part_2" as Part2;

func main() {
    var ctx = new Probe.SceneEditor2DProbeContext();
    if Part1.VerifyInitialSurfaceAndWorldFraming(ctx) == false { return; }
    if Part1.VerifyCanvasFramingAndTransformContracts(ctx) == false { return; }
    if Part1.VerifyResponsiveLayoutSetup(ctx) == false { return; }
    if Part1.VerifyCompactAndDesktopLayout(ctx) == false { return; }
    if Part1.VerifyDocumentTabContinuity(ctx) == false { return; }
    if Part1.VerifyScenePropertiesAndObjectEditing(ctx) == false { return; }
    if Part1.StageComponentSchemas(ctx) == false { return; }
    if Part2.VerifyComponentsAndBatchProperties(ctx) == false { return; }
    if Part2.VerifyAlignmentAndClipboard(ctx) == false { return; }
    if Part2.VerifyHierarchyRoundTrip(ctx) == false { return; }
    if Part2.VerifyHierarchySelectionAndHistory(ctx) == false { return; }
    if Part2.VerifyHierarchyAuthoringAndTilesetSetup(ctx) == false { return; }
    if Part2.VerifyTilesetImportAndRefresh(ctx) == false { return; }
    if Part2.VerifySaveAndInvalidDocument(ctx) == false { return; }
}
