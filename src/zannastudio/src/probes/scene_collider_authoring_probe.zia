//
// File: zannastudio/src/probes/scene_collider_authoring_probe.zia
// Purpose: Verify collider convention authoring and gameplay overlays.
// Key invariants:
//   - Collider drafts normalize kind-aware into strictly positive bounds and
//     round-trip through the metadata token vocabulary.
//   - Apply writes only kind-applicable keys, removes stale dimension keys,
//     refuses exact no-ops, and is one canonical transaction with exact undo.
//   - Remove deletes the complete key set while preserving the node.
//   - Route components draw from schema recognition: nodes carrying every
//     field of the project route component gain badges without mutation.
//   - Overlay toggles and route/collider drawing never change canonical
//     content, history, or dirty state.
//   - Asset-kind schema fields open the bounded filtered browser while
//     scalar fields do not (ADR 0178 deferral closed).
// Ownership/Lifetime:
//   - The probe owns one AppShell and its temporary component workspace.
// Links: zannastudio/src/ui/scene_collider_3d.zia,
//        zannastudio/src/ui/scene_collider_inspector_3d.zia,
//        docs/adr/0185-collider-authoring-and-gameplay-overlays.md
//
//===----------------------------------------------------------------------===//

module scene_collider_authoring_probe;

// ============================================================================
// MODULE: scene_collider_authoring_probe
// PURPOSE: Regress ADR 0185 — collider convention edits, route/badge
//          recognition, overlay neutrality — plus the ADR 0178 asset-field
//          browser wiring.
//
// WHERE-THIS-FITS: Display probe registered as
//          zia_zannastudio_scene_collider_authoring.
//
// TEACHING-NOTE: Every collider expectation reads back through typed node
//          metadata; a correct-looking inspector proves nothing until the
//          keys round-trip through VSCN.
// ============================================================================

bind "../core/document";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_asset_browser";
bind "../ui/scene_collider_3d";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_3d";

bind GUI = Zanna.GUI;
bind Str = Zanna.String;
bind Terminal = Zanna.Terminal;
bind TempFile = Zanna.IO.TempFile;
bind Dir = Zanna.IO.Dir;
bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;

func near(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func fail(shell: app_shell.AppShell,
          componentDir: String,
          reason: String) {
    if componentDir != "" { Dir.RemoveAll(componentDir); }
    shell.Destroy();
    Terminal.Say("RESULT: fail " + reason);
}

func pump(editor: scene_editor_3d.SceneEditor3D,
          doc: document.Document,
          shell: app_shell.AppShell) {
    editor.Pump(doc);
    shell.Render();
}

/// @brief Typed state shared by serial collider-authoring scenarios.
class ColliderAuthoringProbeContext {
    expose app_shell.AppShell shell;
    expose scene_editor_3d.SceneEditor3D editor;
    expose document_manager.DocumentManager documents;
    expose document.Document sceneDoc;
}

/// @brief Verify collider vocabulary, transactions, removal, and exact undo.
func VerifyColliderTransactions(
    ctx: ColliderAuthoringProbeContext) -> Boolean {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Collider Authoring Probe", 1180, 780);

    // ------------------------------------------------------------------
    // Vocabulary and normalization.
    // ------------------------------------------------------------------
    if scene_collider_3d.KindFromToken("box")
          != scene_collider_3d.COLLIDER_BOX
       or scene_collider_3d.KindFromToken("MESH-BOUNDS")
          != scene_collider_3d.COLLIDER_MESH_BOUNDS
       or scene_collider_3d.KindFromToken("wedge")
          != scene_collider_3d.COLLIDER_NONE
       or scene_collider_3d.KindToken(
              scene_collider_3d.COLLIDER_CAPSULE) != "capsule" {
        fail(shell, "", "collider kind vocabulary drifted");
        return false;
    }
    var draft = new scene_collider_3d.ColliderState3D();
    draft.kind = scene_collider_3d.COLLIDER_BOX;
    draft.halfX = -4.0;
    draft.halfY = 0.0;
    var normalized = scene_collider_3d.Normalize(draft);
    if near(normalized.halfX, scene_collider_3d.MIN_DIMENSION) == false
       or near(normalized.halfY, scene_collider_3d.MIN_DIMENSION) == false {
        fail(shell, "", "collider dimension bounds drifted");
        return false;
    }
    if file_utils.AssetKindExtensions("image")
          != ".png,.jpg,.jpeg,.bmp,.gif"
       or file_utils.AssetKindExtensions("audio") != ".wav,.ogg"
       or Str.Contains(
              file_utils.AssetKindExtensions("scene"), ".scene3d") == false
       or Str.Contains(
              file_utils.AssetKindExtensions("unknown"), ".gltf") == false {
        fail(shell, "", "asset kind extension map drifted");
        return false;
    }

    var editor = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(editor,shell.workbench.scene3DHost, shell.app);
    var documents = new document_manager.DocumentManager();
    var sceneDoc = documents.NewScene3DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);
    editor.Activate(sceneDoc);
    pump(editor, sceneDoc, shell);

    if editor.AddEmptyNode("Blocker", -1) < 0 {
        fail(shell, "", "could not author the collider probe node");
        return false;
    }
    pump(editor, sceneDoc, shell);
    var node = editor.flatNodes.get(0);
    editor.ApplyViewportSelection(0, false, false);
    pump(editor, sceneDoc, shell);

    // ------------------------------------------------------------------
    // Box apply: one transaction, exact keys, exact undo.
    // ------------------------------------------------------------------
    var applyBaseline = sceneDoc.content;
    var applyRevision = editor.GetRevision();
    var boxDraft = new scene_collider_3d.ColliderState3D();
    boxDraft.kind = scene_collider_3d.COLLIDER_BOX;
    boxDraft.halfX = 2.0;
    boxDraft.halfY = 1.0;
    boxDraft.halfZ = 3.0;
    boxDraft.trigger = false;
    if editor.ApplyNodeCollider(0, boxDraft) == false
       or editor.GetRevision() != applyRevision + 1
       or node.MetadataGetString("collider.kind", "") != "box"
       or near(node.MetadataGetFloat("collider.halfX", 0.0), 2.0) == false
       or near(node.MetadataGetFloat("collider.halfY", 0.0), 1.0) == false
       or near(node.MetadataGetFloat("collider.halfZ", 0.0), 3.0) == false
       or node.MetadataGetBool("collider.trigger", true)
       or node.MetadataHas("collider.radius")
       or Str.Contains(sceneDoc.content, "collider.kind") == false {
        fail(shell, "", "box collider apply was not one exact transaction");
        return false;
    }
    if editor.ApplyNodeCollider(0, boxDraft)
       or editor.GetRevision() != applyRevision + 1 {
        fail(shell, "", "exact no-op collider apply still created history");
        return false;
    }

    // ------------------------------------------------------------------
    // Kind switch removes stale keys; trigger latches.
    // ------------------------------------------------------------------
    var sphereDraft = new scene_collider_3d.ColliderState3D();
    sphereDraft.kind = scene_collider_3d.COLLIDER_SPHERE;
    sphereDraft.radius = 1.75;
    sphereDraft.trigger = true;
    if editor.ApplyNodeCollider(0, sphereDraft) == false
       or node.MetadataGetString("collider.kind", "") != "sphere"
       or near(node.MetadataGetFloat("collider.radius", 0.0), 1.75) == false
       or node.MetadataGetBool("collider.trigger", false) == false
       or node.MetadataHas("collider.halfX")
       or node.MetadataHas("collider.halfY")
       or node.MetadataHas("collider.halfZ")
       or node.MetadataHas("collider.height") {
        fail(shell, "",
             "kind switch did not rewrite the exact key set");
        return false;
    }
    if editor.Undo() == false
       or editor.flatNodes.get(0).MetadataGetString(
              "collider.kind", "") != "box"
       or editor.Undo() == false
       or sceneDoc.content != applyBaseline
       or editor.flatNodes.get(0).MetadataHas("collider.kind") {
        fail(shell, "", "collider applies did not undo exactly");
        return false;
    }
    pump(editor, sceneDoc, shell);

    ctx.shell = shell;
    ctx.editor = editor;
    ctx.documents = documents;
    ctx.sceneDoc = sceneDoc;
    return true;
}

/// @brief Verify route recognition, overlays, and asset-field browsing.
func VerifyRouteAndAssetFieldAuthoring(
    ctx: ColliderAuthoringProbeContext) -> Boolean {
    var shell = ctx.shell;
    var editor = ctx.editor;
    var sceneDoc = ctx.sceneDoc;

    // ------------------------------------------------------------------
    // Remove: complete key set deleted, node preserved.
    // ------------------------------------------------------------------
    var node = editor.flatNodes.get(0);
    var capsuleDraft = new scene_collider_3d.ColliderState3D();
    capsuleDraft.kind = scene_collider_3d.COLLIDER_CAPSULE;
    capsuleDraft.radius = 0.5;
    capsuleDraft.height = 2.0;
    if editor.ApplyNodeCollider(0, capsuleDraft) == false
       or node.MetadataHas("collider.height") == false
       or editor.RemoveNodeColliderConvention(0) == false
       or node.MetadataHas("collider.kind")
       or node.MetadataHas("collider.radius")
       or node.MetadataHas("collider.height")
       or node.MetadataHas("collider.trigger")
       or editor.flatNodes.count() != 1 {
        fail(shell, "", "collider removal left stale keys or lost the node");
        return false;
    }
    if editor.RemoveNodeColliderConvention(0) {
        fail(shell, "", "removing an absent collider still claimed success");
        return false;
    }
    pump(editor, sceneDoc, shell);

    // ------------------------------------------------------------------
    // Route recognition, badges, and overlay neutrality need a project
    // schema; mirror the component fixture pattern.
    // ------------------------------------------------------------------
    var componentDir =
        TempFile.CreateDirWithPrefix("zannastudio_collider_probe_");
    var componentPath = Path.Join(componentDir, "scene-components.json");
    var componentScenePath = Path.Join(componentDir, "patrol.scene3d");
    var schemaText =
        "{"
        + "\"version\":2,"
        + "\"components\":["
        + "{"
        + "\"name\":\"route\","
        + "\"label\":\"Patrol Route\","
        + "\"target\":\"3d-node\","
        + "\"fields\":["
        + "{\"key\":\"route.id\",\"type\":\"string\",\"default\":\"r1\"},"
        + "{\"key\":\"route.loop\",\"type\":\"bool\",\"default\":true}"
        + "]"
        + "},"
        + "{"
        + "\"name\":\"briefing\","
        + "\"label\":\"Briefing\","
        + "\"target\":\"3d-node\","
        + "\"fields\":["
        + "{\"key\":\"brief.text\",\"type\":\"string\",\"default\":\"\"},"
        + "{\"key\":\"brief.image\",\"type\":\"asset\","
        + "\"assetKinds\":[\"image\"],\"default\":\"\"}"
        + "]"
        + "}"
        + "]"
        + "}";
    File.WriteAllText(componentPath, schemaText);
    var componentProject = new project_manager.ProjectManager();
    componentProject.Setup(null);
    var previousScenePath = sceneDoc.filePath;
    sceneDoc.filePath = componentScenePath;
    if componentDir == "" or File.Exists(componentPath) == false
       or componentProject.OpenFolder(componentDir) == false {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir, "could not create the route fixture");
        return false;
    }
    editor.SetWorkspaceContext(componentProject);
    pump(editor, sceneDoc, shell);

    var routeIndex = editor.AddEmptyNode("Patrol A", -1);
    if routeIndex < 0
       or editor.AddEmptyNode("WP 1", routeIndex) < 0
       or editor.AddEmptyNode("WP 2", routeIndex) < 0 {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir, "could not author the route nodes");
        return false;
    }
    pump(editor, sceneDoc, shell);
    routeIndex = -1;
    var scan = 0;
    while scan < editor.flatNodes.count() {
        if editor.flatNodes.get(scan).Name == "Patrol A" {
            routeIndex = scan;
        }
        scan = scan + 1;
    }
    var routeSelection: List[Integer] = [];
    routeSelection.add(routeIndex);
    editor.componentPalette.SelectComponent("route");
    editor.SelectSceneNodes(routeSelection, routeIndex);
    var routeComponent = editor.componentPalette.SelectedComponent();
    if routeComponent == null
       or editor.ApplySelectedComponent(routeComponent) == false {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir, "could not apply the route component");
        return false;
    }
    pump(editor, sceneDoc, shell);
    var routeRow = GUI.TreeView.Node.GetText(
        editor.hierarchyTreeNodes.get(routeIndex));
    if Str.Contains(routeRow, "[route]") == false {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir,
             "route badge missing from hierarchy row: " + routeRow);
        return false;
    }

    // Overlay toggles must redraw without touching canonical bytes.
    var overlayBaseline = sceneDoc.content;
    editor.collidersCheck.SetChecked(false);
    editor.routesCheck.SetChecked(false);
    pump(editor, sceneDoc, shell);
    editor.collidersCheck.SetChecked(true);
    editor.routesCheck.SetChecked(true);
    pump(editor, sceneDoc, shell);
    if sceneDoc.content != overlayBaseline
       or editor.showColliderOverlays == false
       or editor.showRouteOverlays == false {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir,
             "overlay toggles dirtied content or did not latch");
        return false;
    }

    // ------------------------------------------------------------------
    // Asset-kind schema fields open the filtered browser; scalars do not.
    // ------------------------------------------------------------------
    editor.componentPalette.SelectComponent("briefing");
    editor.componentPalette.SelectField("brief.image");
    if editor.EditSelectedComponentField() == false
       or editor.componentAssetBrowser.group == null
       or editor.componentAssetBrowser.group.IsVisible() == false {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir,
             "asset field edit did not open the bounded browser");
        return false;
    }
    editor.componentAssetBrowser.Close();
    editor.componentPalette.SelectField("brief.text");
    if editor.EditSelectedComponentField() == false
       or editor.componentAssetBrowser.group.IsVisible() {
        sceneDoc.filePath = previousScenePath;
        fail(shell, componentDir,
             "scalar field edit opened the asset browser");
        return false;
    }

    sceneDoc.filePath = previousScenePath;
    componentProject.CloseProject();
    editor.SetWorkspaceContext(null);
    Dir.RemoveAll(componentDir);
    return true;
}

func main() {
    var ctx = new ColliderAuthoringProbeContext();
    if VerifyColliderTransactions(ctx) == false { return; }
    if VerifyRouteAndAssetFieldAuthoring(ctx) == false { return; }
    ctx.shell.Destroy();
    Terminal.Say("RESULT: ok");
}
