//
// File: zannastudio/src/probes/scm_view_probe.zia
// Purpose: Exercise the responsive Source Control panel against a real Git repo.
// Key invariants:
//   - Wrapped controls remain reachable at the minimum supported sidebar width.
//   - Stage, Unstage, diff, and Commit reflect structured selection/index state.
//   - Focused Enter submission performs exactly one real commit.
//   - Conflicts support explicit side selection, Stage confirmation, and a
//     noninteractive merge continuation while ordinary Commit stays blocked.
// Ownership/Lifetime: The probe owns its temporary repo, shell, and harness.
// Links: zannastudio/src/scm/scm_view.zia,
//        zannastudio/src/scm/scm_git.zia
//
//===----------------------------------------------------------------------===//

module scm_view_probe;

bind "../scm/scm_git";
bind "../scm/scm_git_support";
bind "../scm/scm_view";
bind "../ui/activity_bar";
bind "../ui/app_shell";

bind Convert = Zanna.Core.Convert;
bind Exec = Zanna.System.Exec;
bind File = Zanna.IO.File;
bind GUI = Zanna.GUI;
bind Path = Zanna.IO.Path;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;
bind TempFile = Zanna.IO.TempFile;
bind Terminal = Zanna.Terminal;
bind Time = Zanna.Time;

/// @brief Configure one local-only Git setting in the temporary repository.
func GitConfig(dir: String,
               key: String,
               value: String) {
    var args = Seq.New();
    Seq.Push(args, "-C");
    Seq.Push(args, dir);
    Seq.Push(args, "config");
    Seq.Push(args, key);
    Seq.Push(args, value);
    Exec.RunArgs("git", args);
}

/// @brief Run `git mv` with exact argument-vector paths in the temporary repository.
func GitMove(dir: String,
             source: String,
             destination: String) -> Boolean {
    var args = Seq.New();
    Seq.Push(args, "-C");
    Seq.Push(args, dir);
    Seq.Push(args, "mv");
    Seq.Push(args, source);
    Seq.Push(args, destination);
    return Exec.RunArgs("git", args) == 0;
}

/// @brief Verify operation discovery through Git's linked-worktree pointer format.
func VerifyLinkedWorktreeOperationDiscovery() -> Boolean {
    var worktree = TempFile.CreateDirWithPrefix("zannastudio_git_worktree_");
    var control = TempFile.CreateDirWithPrefix("zannastudio_git_control_");
    File.WriteAllText(Path.Join(worktree, ".git"), "gitdir: " + control + "\n");
    File.WriteAllText(Path.Join(control, "MERGE_HEAD"), "probe\n");
    if scm_git_support.CurrentOperation(worktree) != "merging" {
        Terminal.Say("RESULT: fail linked-worktree merge operation discovery");
        return false;
    }
    File.Delete(Path.Join(control, "MERGE_HEAD"));
    if scm_git_support.CurrentOperation(worktree) != "idle" {
        Terminal.Say("RESULT: fail linked-worktree idle operation discovery");
        return false;
    }
    return true;
}

/// @brief Return whether one rendered child remains inside its panel.
func ContainsWidget(parent: GUI.Widget,
                    child: GUI.Widget) -> Boolean {
    if parent == null or child == null { return false; }
    return child.GetScreenX() >= parent.GetScreenX() - 1.0
        and child.GetScreenY() >= parent.GetScreenY() - 1.0
        and child.GetScreenX() + child.GetScreenWidth()
            <= parent.GetScreenX() + parent.GetScreenWidth() + 1.0
        and child.GetScreenY() + child.GetScreenHeight()
            <= parent.GetScreenY() + parent.GetScreenHeight() + 1.0;
}

/// @brief Return whether every always-visible Source Control action is reachable.
func ControlsContained(view: scm_view.ScmView) -> Boolean {
    return ContainsWidget(view.host, view.refreshBtn)
        and ContainsWidget(view.host, view.cancelBtn)
        and ContainsWidget(view.host, view.pushBtn)
        and ContainsWidget(view.host, view.pullBtn)
        and ContainsWidget(view.host, view.historyBtn)
        and ContainsWidget(view.host, view.stageBtn)
        and ContainsWidget(view.host, view.unstageBtn)
        and ContainsWidget(view.host, view.stageAllBtn)
        and ContainsWidget(view.host, view.commitInput)
        and ContainsWidget(view.host, view.commitBtn)
        and ContainsWidget(view.host, view.sideBySideButton);
}

/// @brief Convert public logical widget geometry to harness framebuffer pixels.
func HarnessCoordinate(shell: app_shell.AppShell,
                       logical: Number) -> Integer {
    var scale = shell.app.GetEffectiveScale();
    if scale <= 0.0 { scale = 1.0; }
    return Convert.NumToInt(logical * scale);
}

/// @brief Dispatch one real pointer click to a rendered button center.
func Click(shell: app_shell.AppShell,
           harness: GUI.TestHarness,
           button: GUI.Button) {
    var x = HarnessCoordinate(shell,
        button.GetScreenX() + button.GetScreenWidth() / 2.0);
    var y = HarnessCoordinate(shell,
        button.GetScreenY() + button.GetScreenHeight() / 2.0);
    harness.SendMouse("move", x, y, 0);
    harness.SendMouse("down", x, y, 0);
    harness.SendMouse("up", x, y, 0);
    harness.DispatchPending();
}

/// @brief Pump UI and Git jobs until the Source Control queue becomes idle.
func PumpUntilIdle(shell: app_shell.AppShell,
                   view: scm_view.ScmView,
                   budgetMs: Integer) -> Boolean {
    var waited = 0;
    while (view.Busy() or view.pendingJobs.count() > 0) and waited < budgetMs {
        shell.Poll();
        view.HandleEvents();
        shell.Render();
        if view.Busy() or view.pendingJobs.count() > 0 {
            Time.Clock.Sleep(5);
            waited = waited + 5;
        }
    }
    shell.Poll();
    view.HandleEvents();
    shell.Render();
    return view.Busy() == false and view.pendingJobs.count() == 0;
}

/// @brief Locate one exact status path without relying on Git's row ordering.
func StatusIndexForPath(view: scm_view.ScmView,
                        path: String) -> Integer {
    var i = 0;
    while i < view.lastStatus.entries.count() {
        if view.lastStatus.entries.get(i).path == path { return i; }
        i = i + 1;
    }
    return -1;
}

func Fail(shell: app_shell.AppShell,
          harness: GUI.TestHarness,
          reason: String) {
    if harness != null { harness.UnbindApp(); }
    if shell != null { shell.Destroy(); }
    Terminal.Say("RESULT: fail " + reason);
}

/// @brief State shared by ordinary and conflicted SCM workflows.
class ScmViewProbeContext {
    expose Boolean skipped = false;
    expose String dir;
    expose String filePath;
    expose scm_git.Git git;
    expose app_shell.AppShell shell;
    expose scm_view.ScmView view;
    expose GUI.TestHarness harness;
}

/// @brief Verify layout, selection, staging, and ordinary commit input.
func VerifyOrdinaryScmWorkflow(ctx: ScmViewProbeContext) -> Boolean {
    var versionArgs = Seq.New();
    Seq.Push(versionArgs, "--version");
    if Exec.RunArgs("git", versionArgs) != 0 {
        Terminal.Say("RESULT: ok (git unavailable, skipped)");
        ctx.skipped = true;
        return true;
    }

    var dir = TempFile.CreateDirWithPrefix("zannastudio_scm_view_");
    var initArgs = Seq.New();
    Seq.Push(initArgs, "-C");
    Seq.Push(initArgs, dir);
    Seq.Push(initArgs, "init");
    if Exec.RunArgs("git", initArgs) != 0 {
        Terminal.Say("RESULT: fail git init");
        return false;
    }
    GitConfig(dir, "user.email", "probe@example.com");
    GitConfig(dir, "user.name", "Source Control Probe");
    GitConfig(dir, "commit.gpgsign", "false");

    var git = new scm_git.Git();
    git.SetRepo(dir);
    var filePath = Path.Join(dir, "game.zia");
    File.WriteAllText(filePath, "module Game; // base\n");
    if git.StageAll() == false or git.Commit("seed") == false {
        Terminal.Say("RESULT: fail seed repository");
        return false;
    }
    File.WriteAllText(filePath, "module Game; // edited in Studio\n");

    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Source Control Probe", 1100, 720);
    var activity = new activity_bar.ActivityBar();
    activity.Setup(shell.workbench.explorerView,
                   shell.workbench.scmViewHost,
                   shell.workbench.runDebugViewHost,
                   shell.workbench.abExplorer,
                   shell.workbench.abSourceControl,
                   shell.workbench.abRunDebug);
    activity.ShowView(activity_bar.VIEW_SCM);

    var view = new scm_view.ScmView();
    view.Setup(shell.workbench.scmViewHost);
    view.SetRepo(dir);
    if PumpUntilIdle(shell, view, 10000) == false or view.repoReady == false
       or view.lastStatus.entries.count() != 1 {
        Fail(shell, null, "initial repository status");
        return false;
    }

    // No row is selected yet: only the aggregate Stage All action is honest.
    if view.stageBtn.IsEnabled() or view.unstageBtn.IsEnabled()
       or view.sideBySideButton.IsEnabled()
       or view.stageAllBtn.IsEnabled() == false
       or view.commitBtn.IsEnabled()
       or view.commitInput.IsEnabled() == false {
        Fail(shell, null, "initial selection-aware actions");
        return false;
    }

    // Exercise the minimum supported sidebar share after a completed layout.
    shell.workbench.SetSidebarWidthPct(15);
    shell.Poll();
    shell.Render();
    view.HandleEvents();
    shell.Poll();
    shell.Render();
    if view.IsCompactControls() == false or ControlsContained(view) == false {
        Terminal.Say(
            "DETAIL: host=" + view.host.GetScreenX() + ","
            + view.host.GetScreenY() + " "
            + view.host.GetScreenWidth() + "x" + view.host.GetScreenHeight()
            + " top=" + view.topRow.GetScreenX() + ","
            + view.topRow.GetScreenY() + " "
            + view.topRow.GetScreenWidth() + "x" + view.topRow.GetScreenHeight()
            + " commitRight="
            + (view.commitBtn.GetScreenX() + view.commitBtn.GetScreenWidth()));
        Fail(shell, null, "controls overflowed the narrow sidebar");
        return false;
    }
    shell.workbench.SetSidebarWidthPct(30);
    shell.Poll();
    shell.Render();
    view.HandleEvents();
    shell.Render();

    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, harness, "automation app binding");
        return false;
    }

    // Selecting a modified worktree row enables Stage and both diff surfaces,
    // but never advertises Unstage for an index-clean file.
    view.statusList.SelectIndex(0);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.stageBtn.IsEnabled() == false
       or view.unstageBtn.IsEnabled()
       or view.sideBySideButton.IsEnabled() == false {
        Fail(shell, harness, "modified-row action state");
        return false;
    }

    // Stage through the real hit-test path. The refreshed staged-only snapshot
    // has no remaining worktree action and still requires a commit message.
    Click(shell, harness, view.stageBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 1
       or view.lastStatus.entries.get(0).staged == false
       or view.stageAllBtn.IsEnabled()
       or view.commitBtn.IsEnabled() {
        Fail(shell, harness, "pointer Stage workflow");
        return false;
    }

    // Focused Enter submits one commit; the successful refresh clears both the
    // input and worktree without leaking Enter into another focused surface.
    view.commitInput.SetText("commit from focused Enter");
    view.commitInput.Focus();
    view.HandleEvents();
    if view.commitBtn.IsEnabled() == false {
        Fail(shell, harness, "typed staged commit was not enabled");
        return false;
    }
    harness.SendKey("enter", 0);
    harness.DispatchPending();
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 0
       or view.commitInput.get_Text() != ""
       or git.Status().entries.count() != 0 {
        Fail(shell, harness, "focused Enter commit workflow");
        return false;
    }

    ctx.dir = dir;
    ctx.filePath = filePath;
    ctx.git = git;
    ctx.shell = shell;
    ctx.view = view;
    ctx.harness = harness;
    return true;
}

/// @brief Verify conflict guidance, staging, and resolution commit.
func VerifyConflictedScmWorkflow(ctx: ScmViewProbeContext) -> Boolean {
    var dir = ctx.dir;
    var filePath = ctx.filePath;
    var git = ctx.git;
    var shell = ctx.shell;
    var view = ctx.view;
    var harness = ctx.harness;

    // Produce a real two-branch conflict outside the view, then refresh it.
    var baseBranch = git.CurrentBranch();
    var branchArgs = Seq.New();
    Seq.Push(branchArgs, "-C");
    Seq.Push(branchArgs, dir);
    Seq.Push(branchArgs, "checkout");
    Seq.Push(branchArgs, "-b");
    Seq.Push(branchArgs, "scm-view-conflict");
    if Exec.RunArgs("git", branchArgs) != 0 {
        Fail(shell, harness, "create conflict branch");
        return false;
    }
    File.WriteAllText(filePath, "module Game; // branch version\n");
    if git.StageAll() == false or git.Commit("branch version") == false
       or git.Checkout(baseBranch) == false {
        Fail(shell, harness, "seed conflict branch");
        return false;
    }
    File.WriteAllText(filePath, "module Game; // base version\n");
    if git.StageAll() == false or git.Commit("base version") == false {
        Fail(shell, harness, "seed conflict base");
        return false;
    }
    var mergeArgs = Seq.New();
    Seq.Push(mergeArgs, "-C");
    Seq.Push(mergeArgs, dir);
    Seq.Push(mergeArgs, "merge");
    Seq.Push(mergeArgs, "scm-view-conflict");
    if Exec.RunArgs("git", mergeArgs) == 0 {
        Fail(shell, harness, "expected merge conflict");
        return false;
    }

    view.Refresh();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 1
       or view.lastStatus.entries.get(0).conflicted == false
       or view.stageAllBtn.IsEnabled() == false {
        Terminal.Say(
            "DETAIL: conflict idle=" + (view.Busy() == false)
            + " queued=" + view.pendingJobs.count()
            + " ready=" + view.repoReady
            + " entries=" + view.lastStatus.entries.count()
            + " stageAll=" + view.stageAllBtn.IsEnabled());
        if view.lastStatus.entries.count() > 0 {
            Terminal.Say(
                "DETAIL: entry path=" + view.lastStatus.entries.get(0).path
                + " index=" + view.lastStatus.entries.get(0).index
                + " worktree=" + view.lastStatus.entries.get(0).worktree
                + " conflicted=" + view.lastStatus.entries.get(0).conflicted);
        }
        Fail(shell, harness, "conflict status");
        return false;
    }
    view.commitInput.SetText("resolve conflict from Studio");
    view.commitInput.Focus();
    view.HandleEvents();
    if view.commitBtn.IsEnabled() {
        Fail(shell, harness, "unresolved conflict enabled Commit");
        return false;
    }

    view.statusList.SelectIndex(0);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.stageBtn.IsEnabled() == false
       or view.sideBySideButton.IsEnabled() == false
       or view.takeCurrentBtn.IsEnabled() == false
       or view.takeIncomingBtn.IsEnabled() == false {
        Fail(shell, harness, "selected conflict actions");
        return false;
    }
    view.diffPane.SelectAll();
    var conflictDiff = view.diffPane.GetSelection();
    if Str.Contains(conflictDiff, "edit the markers") == false
       or Str.Contains(conflictDiff, "Take Current/Take Incoming") == false
       or Str.Contains(conflictDiff, "then Stage") == false {
        Fail(shell, harness, "conflict guidance missing from diff");
        return false;
    }

    // Choosing a side is deliberately non-destructive to the index: the row
    // remains conflicted until a separate Stage confirms that resolution.
    Click(shell, harness, view.takeIncomingBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or File.ReadAllText(filePath) != "module Game; // branch version\n"
       or view.lastStatus.entries.count() != 1
       or view.lastStatus.entries.get(0).conflicted == false {
        Fail(shell, harness, "take incoming conflict side");
        return false;
    }

    // Stage confirms the chosen side. The active merge now exposes Continue;
    // ordinary Commit remains disabled so a rebase cannot be committed by hand.
    view.statusList.SelectIndex(0);
    view.HandleEvents();
    Click(shell, harness, view.stageBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 1
       or view.lastStatus.entries.get(0).conflicted
       or view.lastStatus.entries.get(0).staged == false
       or view.commitInput.get_Text() != "resolve conflict from Studio"
       or view.operationState != "merging"
       or view.continueOperationBtn.IsEnabled() == false
       or view.commitBtn.IsEnabled() {
        Fail(shell, harness, "stage-confirmed conflict resolution");
        return false;
    }

    Click(shell, harness, view.continueOperationBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 0
       or view.operationState != "idle"
       or git.Status().entries.count() != 0 {
        Fail(shell, harness, "noninteractive merge continue");
        return false;
    }

    return true;
}

/// @brief Resolve two simultaneous real conflicts in reverse path order.
/// @details This proves row identity, mixed-side selection, partial resolution,
///   commit gating, and noninteractive continuation without assuming Git's
///   status ordering.
func VerifyMultiFileConflictWorkflow(ctx: ScmViewProbeContext) -> Boolean {
    var dir = ctx.dir;
    var git = ctx.git;
    var shell = ctx.shell;
    var view = ctx.view;
    var harness = ctx.harness;
    var baseBranch = git.CurrentBranch();
    var firstPath = Path.Join(dir, "multi_first.zia");
    var secondPath = Path.Join(dir, "multi_second.zia");
    File.WriteAllText(firstPath, "module First; // common\n");
    File.WriteAllText(secondPath, "module Second; // common\n");
    if git.StageAll() == false or git.Commit("seed multi conflict") == false {
        Fail(shell, harness, "seed multi-file conflict");
        return false;
    }

    var branchArgs = Seq.New();
    Seq.Push(branchArgs, "-C");
    Seq.Push(branchArgs, dir);
    Seq.Push(branchArgs, "checkout");
    Seq.Push(branchArgs, "-b");
    Seq.Push(branchArgs, "scm-view-multi-conflict");
    if Exec.RunArgs("git", branchArgs) != 0 {
        Fail(shell, harness, "create multi-file conflict branch");
        return false;
    }
    File.WriteAllText(firstPath, "module First; // incoming\n");
    File.WriteAllText(secondPath, "module Second; // incoming\n");
    if git.StageAll() == false or git.Commit("incoming multi-file edits") == false
       or git.Checkout(baseBranch) == false {
        Fail(shell, harness, "seed incoming multi-file edits");
        return false;
    }
    File.WriteAllText(firstPath, "module First; // current\n");
    File.WriteAllText(secondPath, "module Second; // current\n");
    if git.StageAll() == false or git.Commit("current multi-file edits") == false {
        Fail(shell, harness, "seed current multi-file edits");
        return false;
    }
    var mergeArgs = Seq.New();
    Seq.Push(mergeArgs, "-C");
    Seq.Push(mergeArgs, dir);
    Seq.Push(mergeArgs, "merge");
    Seq.Push(mergeArgs, "scm-view-multi-conflict");
    if Exec.RunArgs("git", mergeArgs) == 0 {
        Fail(shell, harness, "expected multi-file merge conflict");
        return false;
    }

    view.Refresh();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 2
       or StatusIndexForPath(view, "multi_first.zia") < 0
       or StatusIndexForPath(view, "multi_second.zia") < 0
       or view.operationState != "conflict-merge" {
        Terminal.Say("DETAIL: multi rows=" + view.lastStatus.entries.count()
            + " first=" + StatusIndexForPath(view, "multi_first.zia")
            + " second=" + StatusIndexForPath(view, "multi_second.zia")
            + " operation=" + view.operationState
            + " busy=" + view.Busy());
        var detailIndex = 0;
        while detailIndex < view.lastStatus.entries.count() {
            Terminal.Say("DETAIL: multi entry " + detailIndex + " path="
                + view.lastStatus.entries.get(detailIndex).path + " conflicted="
                + view.lastStatus.entries.get(detailIndex).conflicted);
            detailIndex = detailIndex + 1;
        }
        Fail(shell, harness, "multi-file conflict rows");
        return false;
    }

    // Resolve the second path first with the incoming side.
    view.statusList.SelectIndex(StatusIndexForPath(view, "multi_second.zia"));
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.takeIncomingBtn.IsEnabled() == false {
        Fail(shell, harness, "select incoming multi-file conflict");
        return false;
    }
    Click(shell, harness, view.takeIncomingBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or File.ReadAllText(secondPath) != "module Second; // incoming\n" {
        Fail(shell, harness, "take incoming in multi-file conflict");
        return false;
    }
    view.statusList.SelectIndex(StatusIndexForPath(view, "multi_second.zia"));
    view.HandleEvents();
    Click(shell, harness, view.stageBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or StatusIndexForPath(view, "multi_first.zia") < 0
       or view.commitBtn.IsEnabled() {
        Fail(shell, harness, "partial multi-file conflict resolution");
        return false;
    }

    // Resolve the remaining first path with the current side.
    view.statusList.SelectIndex(StatusIndexForPath(view, "multi_first.zia"));
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.takeCurrentBtn.IsEnabled() == false {
        Fail(shell, harness, "select current multi-file conflict");
        return false;
    }
    Click(shell, harness, view.takeCurrentBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or File.ReadAllText(firstPath) != "module First; // current\n" {
        Fail(shell, harness, "take current in multi-file conflict");
        return false;
    }
    view.statusList.SelectIndex(StatusIndexForPath(view, "multi_first.zia"));
    view.HandleEvents();
    Click(shell, harness, view.stageBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.operationState != "merging"
       or view.continueOperationBtn.IsEnabled() == false
       or view.commitBtn.IsEnabled() {
        Fail(shell, harness, "complete multi-file conflict staging");
        return false;
    }
    Click(shell, harness, view.continueOperationBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.operationState != "idle"
       or git.Status().entries.count() != 0 {
        Fail(shell, harness, "continue multi-file merge");
        return false;
    }
    return true;
}

/// @brief Recover a real rename/rename conflict through rendered Studio controls.
func VerifyRenameConflictWorkflow(ctx: ScmViewProbeContext) -> Boolean {
    var dir = ctx.dir;
    var git = ctx.git;
    var shell = ctx.shell;
    var view = ctx.view;
    var harness = ctx.harness;
    var baseBranch = git.CurrentBranch();
    var sourceName = "rename_source.zia";
    var currentName = "rename_current.zia";
    var incomingName = "rename_incoming.zia";
    File.WriteAllText(Path.Join(dir, sourceName), "module RenameProbe; // common\n");
    if git.StageAll() == false or git.Commit("seed rename conflict") == false {
        Fail(shell, harness, "seed rename conflict");
        return false;
    }

    var branchArgs = Seq.New();
    Seq.Push(branchArgs, "-C");
    Seq.Push(branchArgs, dir);
    Seq.Push(branchArgs, "checkout");
    Seq.Push(branchArgs, "-b");
    Seq.Push(branchArgs, "scm-view-rename-conflict");
    if Exec.RunArgs("git", branchArgs) != 0
       or GitMove(dir, sourceName, incomingName) == false
       or git.Commit("incoming rename") == false
       or git.Checkout(baseBranch) == false
       or GitMove(dir, sourceName, currentName) == false
       or git.Commit("current rename") == false {
        Fail(shell, harness, "seed rename branches");
        return false;
    }
    var mergeArgs = Seq.New();
    Seq.Push(mergeArgs, "-C");
    Seq.Push(mergeArgs, dir);
    Seq.Push(mergeArgs, "merge");
    Seq.Push(mergeArgs, "scm-view-rename-conflict");
    if Exec.RunArgs("git", mergeArgs) == 0 {
        Fail(shell, harness, "expected rename conflict");
        return false;
    }

    view.Refresh();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.lastStatus.entries.count() != 3
       or StatusIndexForPath(view, currentName) < 0
       or StatusIndexForPath(view, incomingName) < 0
       or StatusIndexForPath(view, sourceName) < 0
       or view.operationState != "conflict-merge" {
        Fail(shell, harness, "rename conflict rows");
        return false;
    }
    view.statusList.SelectIndex(StatusIndexForPath(view, currentName));
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.takeCurrentBtn.IsEnabled() == false {
        Fail(shell, harness, "select current rename side");
        return false;
    }
    Click(shell, harness, view.takeCurrentBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or File.Exists(Path.Join(dir, currentName)) == false {
        Fail(shell, harness, "take current rename side");
        return false;
    }
    // A rename/rename conflict legitimately leaves both destination paths in
    // the worktree. Model the documented user edit: keep Current and delete
    // the unwanted Incoming destination before staging the complete resolution.
    if File.Exists(Path.Join(dir, incomingName)) {
        File.Delete(Path.Join(dir, incomingName));
    }
    Click(shell, harness, view.stageAllBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or view.operationState != "merging"
       or view.continueOperationBtn.IsEnabled() == false
       or view.commitBtn.IsEnabled() {
        Fail(shell, harness, "stage rename resolution");
        return false;
    }
    Click(shell, harness, view.continueOperationBtn);
    view.HandleEvents();
    if PumpUntilIdle(shell, view, 10000) == false
       or git.Status().entries.count() != 0
       or File.Exists(Path.Join(dir, currentName)) == false
       or File.Exists(Path.Join(dir, incomingName))
       or File.Exists(Path.Join(dir, sourceName)) {
        Fail(shell, harness, "continue rename merge");
        return false;
    }
    return true;
}

func main() {
    if VerifyLinkedWorktreeOperationDiscovery() == false { return; }
    var ctx = new ScmViewProbeContext();
    if VerifyOrdinaryScmWorkflow(ctx) == false { return; }
    if ctx.skipped { return; }
    if VerifyConflictedScmWorkflow(ctx) == false { return; }
    if VerifyMultiFileConflictWorkflow(ctx) == false { return; }
    if VerifyRenameConflictWorkflow(ctx) == false { return; }

    ctx.harness.UnbindApp();
    ctx.shell.Destroy();
    Terminal.Say("RESULT: ok");
}
