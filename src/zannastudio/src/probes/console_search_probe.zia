//
// File: zannastudio/src/probes/console_search_probe.zia
// Purpose: Regress Studio output, search, command chrome, and navigation.
// Key invariants:
//   - Visible menu shortcuts match the active platform command registry.
//   - Tool-panel state and structured search locations remain coherent.
//   - Search and Preferences take intentional focus and never misroute Enter.
//   - Preferences finds settings and commands or shows an explicit empty state.
//   - Background search completion never steals the active Terminal panel.
//   - Repeated search/build requests reveal active work without canceling it.
//   - Durable Build/Search completion never becomes a transient popup.
//   - Workspace-symbol parsing remains bounded and honors dirty live buffers.
//   - Floating workbench forms stay inside the effective viewport at UI zoom.
//   - Focus-taking forms replace one another without stale-owner interference.
// Ownership/Lifetime: The probe owns and destroys its shell and temporary data.
// Links: zannastudio/src/ui/app_shell.zia,
//        zannastudio/src/commands/command_registry.zia
//
//===----------------------------------------------------------------------===//

module console_search_probe;

// ============================================================================
// MODULE: console_search_probe
// PURPOSE: Regression probe for output panels, console helpers, search, and
//          Quick Open scoring/navigation behavior.
//
// WHERE-THIS-FITS: This probe validates user-facing tool-panel behavior without
//          routing through the full main loop. It constructs focused controllers
//          and uses real temporary files where path behavior matters.
//
// TEACHING-NOTE: Search rows carry structured location ids. Probe assertions
//          should check both displayed rows and the data needed for navigation.
// ============================================================================

bind "console_search_probe_support" as Probe;
bind "console_search_probe_part_1" as Part1;
bind "console_search_probe_part_2" as Part2;

func main() {
    var ctx = new Probe.ConsoleSearchProbeContext();
    if Part1.VerifyNotificationAndCommandChrome(ctx) == false { return; }
    if Part1.VerifyShortcutContextsAndQuickOpen(ctx) == false { return; }
    if Part1.VerifyToolPanelRowsAndClipboard(ctx) == false { return; }
    if Part1.VerifyToolPanelVisibilityAndScaling(ctx) == false { return; }
    if Part1.VerifySettingsOverlay(ctx) == false { return; }
    if Part1.VerifyFocusedOverlays(ctx) == false { return; }
    if Part2.VerifyOverlayResetAndSearchHelpers(ctx) == false { return; }
    if Part2.VerifyQuickOpenAndWorkspaceSymbols(ctx) == false { return; }
    if Part2.VerifySearchModesAndWorkspaceIndex(ctx) == false { return; }
    if Part2.VerifySearchNavigationAndAsyncResults(ctx) == false { return; }
    if Part2.VerifyAsyncDiffAndCleanup(ctx) == false { return; }
}
