//
// File: zannastudio/src/probes/scene_dnd_probe.zia
// Purpose: Verify typed asset drag-and-drop into the scene surfaces.
// Key invariants:
//   - Dragging a project image from the asset browser onto the 2D canvas
//     creates one sprite object at the drop cell with a portable
//     editor.sprite reference, as exactly one undoable transaction.
//   - Dropping a non-image asset onto the canvas is refused without history.
//   - Dropping a 3D scene asset onto the 3D viewport imports it through the
//     standard one-transaction import path.
// Ownership/Lifetime:
//   - The probe owns temp project dirs, one hidden AppShell per editor, and
//     one input harness; everything is destroyed or removed at exit.
// Links: zannastudio/src/ui/scene_asset_browser.zia,
//        zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/scene_editor_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_dnd_probe;

// ============================================================================
// MODULE: scene_dnd_probe
// PURPOSE: Pin the cross-widget drag contract end to end through the real
//          compositor drag path: press a browser thumbnail, cross the threshold,
//          release over a scene surface.
//
// WHERE-THIS-FITS: The dock system pins widget-level DnD mechanics; this
//          probe owns the scene wirings built on the same typed payloads.
//
// TEACHING-NOTE: The browser populates from the project file cache and renders
//          at most one thumbnail per frame, so the probe pumps until its real
//          image card appears before pressing it.
// ============================================================================

bind "../core/document";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../services/file_utils";
bind "../ui/app_shell";
bind "../ui/scene_editor_2d";
bind "../ui/scene_panels_2d";
bind "../ui/scene_editor_3d";
bind "../ui/scene_panels_3d";

bind Convert = Zanna.Core.Convert;
bind Color = Zanna.Graphics.Color;
bind Dir = Zanna.IO.Dir;
bind File = Zanna.IO.File;
bind GUI = Zanna.GUI;
bind Path = Zanna.IO.Path;
bind Pixels = Zanna.Graphics.Pixels;
bind Str = Zanna.String;
bind TempFile = Zanna.IO.TempFile;
bind Terminal = Zanna.Terminal;

func HarnessCoordinate(shell: app_shell.AppShell,
                       logical: Number) -> Integer {
    var scale = shell.app.GetEffectiveScale();
    if scale <= 0.0 { scale = 1.0; }
    return Convert.NumToInt(logical * scale + 0.999999);
}

func NumbersNear(actual: Number, expected: Number) -> Boolean {
    var difference = actual - expected;
    if difference < 0.0 { difference = 0.0 - difference; }
    return difference < 0.000001;
}

func removeTempDir(path: String) {
    if path != "" { Dir.RemoveAll(path); }
}

func Fail(shell: app_shell.AppShell,
          harness: GUI.TestHarness,
          tempDir: String,
          reason: String) {
    if harness != null { harness.UnbindApp(); }
    if shell != null { shell.Destroy(); }
    removeTempDir(tempDir);
    Terminal.Say("RESULT: fail " + reason);
}

/// @brief Fixture state shared by the 2D and 3D drop scenarios.
class SceneDndProbeContext {
    expose String tempDir;
    expose String notesPath;
    expose project_manager.ProjectManager project;
    expose document_manager.DocumentManager documents;
}

/// @brief Verify asset-card dropping and rectangular rotation in 2D.
func VerifyScene2DDrops(ctx: SceneDndProbeContext) -> Boolean {
    // Temp project with one tiny image asset and one saved 3D scene asset.
    var tempDir = TempFile.CreateDirWithPrefix("zannastudio_dnd_");
    var spritePath = Path.Join(tempDir, "hero.png");
    var sprite = Pixels.New(4, 4);
    sprite.DrawBox(0, 0, 4, 4, Color.RGB(255, 0, 0));
    if Pixels.SavePng(sprite, spritePath) != 1 {
        removeTempDir(tempDir);
        Terminal.Say("RESULT: fail sprite fixture");
        return false;
    }
    var notesPath = Path.Join(tempDir, "notes.txt");
    File.WriteAllText(notesPath, "not an image\n");
    // ------------------------------------------------------------------ 2D
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Scene DnD Probe", 1240, 800);
    shell.SetSceneWorkspaceMode(true);
    var editor2d = new scene_editor_2d.SceneEditor2D();
    scene_panels_2d.Build(editor2d,shell.workbench.scene2DHost, shell.app);
    var project = new project_manager.ProjectManager();
    if project.OpenFolder(tempDir) == false {
        Fail(shell, null, tempDir, "temp project open");
        return false;
    }
    editor2d.SetWorkspaceContext(project);
    var documents = new document_manager.DocumentManager();
    var doc2d = documents.NewScene2DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_2D);
    editor2d.Activate(doc2d);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();

    // The component asset browser lives on the Object tab and is scoped to
    // a selection, so create and select one object before opening it.
    if editor2d.AddSceneObject("anchor", "anchor", 0, 0) != 0 {
        Fail(shell, null, tempDir, "2D anchor fixture");
        return false;
    }
    editor2d.SelectSceneObjects([0], 0);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    editor2d.componentAssetBrowser.SetExtensions(".png");
    editor2d.componentAssetBrowser.Open();
    var warm = 0;
    while warm < 240
          and editor2d.componentAssetBrowser.assetList.Count == 0 {
        editor2d.Pump(doc2d);
        shell.Poll();
        shell.Render();
        warm = warm + 1;
    }
    if editor2d.componentAssetBrowser.assetList.Count == 0
       or editor2d.componentAssetBrowser.thumbnailCards.count() == 0 {
        Fail(shell, null, tempDir, "asset cache did not surface hero.png");
        return false;
    }
    editor2d.componentAssetBrowser.assetList.SelectIndex(0);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();

    var harness = GUI.TestHarness.New();
    if harness.BindApp(shell.app) == false {
        Fail(shell, null, tempDir, "2D bind");
        return false;
    }
    // The asset browser sits low in the inspector column: reveal it first,
    // exactly as a user would scroll to it before dragging.
    var dragCard =
        editor2d.componentAssetBrowser.thumbnailCards.get(0);
    editor2d.inspectorScroll.ScrollTo(dragCard.host);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();

    var objectsBefore = editor2d.scene.ObjectCount();
    var undoBefore = editor2d.undoStack.count();
    var listX = 0;
    var listY = 0;
    if dragCard.image.IsVisible() {
        listX = HarnessCoordinate(
            shell, dragCard.image.GetScreenX() + 40.0);
        listY = HarnessCoordinate(
            shell, dragCard.image.GetScreenY() + 40.0);
    } else {
        listX = HarnessCoordinate(
            shell, dragCard.placeholder.GetScreenX() + 40.0);
        listY = HarnessCoordinate(
            shell, dragCard.placeholder.GetScreenY() + 40.0);
    }
    var canvasX = HarnessCoordinate(
        shell, editor2d.canvasImage.GetScreenX() + 40.0);
    var canvasY = HarnessCoordinate(
        shell, editor2d.canvasImage.GetScreenY() + 40.0);

    // Real drag: press the row, cross the threshold, release on the canvas.
    harness.SendMouse("move", listX, listY, 0);
    harness.SendMouse("down", listX, listY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("move", listX + 24, listY + 8, 0);
    harness.SendMouse("move", canvasX, canvasY, 0);
    harness.SendMouse("up", canvasX, canvasY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    editor2d.Pump(doc2d);

    if editor2d.scene.ObjectCount() != objectsBefore + 1 {
        Fail(shell, harness, tempDir,
             "asset drop did not create one object (count="
             + editor2d.scene.ObjectCount() + ")");
        return false;
    }
    var dropped = editor2d.scene.ObjectCount() - 1;
    if editor2d.scene.ObjectType(dropped) != "sprite"
       or editor2d.scene.ObjectGetStr(dropped, "editor.sprite", "") == "" {
        Fail(shell, harness, tempDir,
             "dropped sprite lost its type or editor.sprite reference");
        return false;
    }
    if editor2d.undoStack.count() != undoBefore + 1 {
        Fail(shell, harness, tempDir,
             "sprite drop was not exactly one undoable transaction");
        return false;
    }

    // A non-image drop is refused without touching history.
    var refusedContent = doc2d.content;
    if editor2d.CreateSpriteObjectFromDrop(notesPath, canvasX, canvasY) != -1
       or doc2d.content != refusedContent
       or editor2d.undoStack.count() != undoBefore + 1 {
        Fail(shell, harness, tempDir, "non-image drop was not refused");
        return false;
    }
    // Rect-tool rotate: drag the rotation handle a quarter turn around the
    // dropped sprite's pivot and commit exactly one undoable transaction.
    editor2d.SetToolMode(scene_editor_2d.MODE_SELECT);
    editor2d.SelectSceneObjects([dropped], dropped);
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    var undoBeforeRotate = editor2d.undoStack.count();
    var rotateHandle = editor2d.RectHandlePoint(dropped, 4);
    var canvasOriginX = editor2d.canvasImage.GetScreenX();
    var canvasOriginY = editor2d.canvasImage.GetScreenY();
    var handleX = HarnessCoordinate(shell, canvasOriginX + rotateHandle.x);
    var handleY = HarnessCoordinate(shell, canvasOriginY + rotateHandle.y);
    harness.SendMouse("move", handleX, handleY, 0);
    harness.SendMouse("down", handleX, handleY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    // A diagonal drag swings the handle about the pivot by a nonzero angle.
    var quarterX = HarnessCoordinate(
        shell, canvasOriginX + rotateHandle.x + 40.0);
    var quarterY = HarnessCoordinate(
        shell, canvasOriginY + rotateHandle.y + 40.0);
    harness.SendMouse("move", quarterX, quarterY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    harness.SendMouse("up", quarterX, quarterY, 0);
    harness.DispatchPending();
    editor2d.Pump(doc2d);
    shell.Poll();
    shell.Render();
    if NumbersNear(editor2d.scene.ObjectRotation(dropped), 0.0)
       or editor2d.undoStack.count() != undoBeforeRotate + 1 {
        Fail(shell, harness, tempDir,
             "rotate handle drag did not commit one rotation: rot="
             + editor2d.scene.ObjectRotation(dropped)
             + " undo=" + editor2d.undoStack.count()
             + "/" + (undoBeforeRotate + 1));
        return false;
    }
    if editor2d.Undo() == false
       or NumbersNear(editor2d.scene.ObjectRotation(dropped), 0.0) == false {
        Fail(shell, harness, tempDir,
             "undoing the rotation did not restore the default");
        return false;
    }

    ctx.tempDir = tempDir;
    ctx.notesPath = notesPath;
    ctx.project = project;
    ctx.documents = documents;
    harness.UnbindApp();
    shell.Destroy();
    return true;
}

/// @brief Verify typed scene-asset import and refusal in 3D.
func VerifyScene3DDrops(ctx: SceneDndProbeContext) -> Boolean {
    var tempDir = ctx.tempDir;
    var notesPath = ctx.notesPath;
    var project = ctx.project;
    var documents = ctx.documents;

    // ------------------------------------------------------------------ 3D
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Scene DnD Probe 3D", 1240, 800);
    shell.SetSceneWorkspaceMode(true);
    var editor3d = new scene_editor_3d.SceneEditor3D();
    scene_panels_3d.Build(editor3d,shell.workbench.scene3DHost, shell.app);
    editor3d.SetWorkspaceContext(project);
    var doc3d = documents.NewScene3DDocument();
    shell.SelectSurface(file_utils.DOC_KIND_SCENE_3D);
    editor3d.Activate(doc3d);
    editor3d.Pump(doc3d);
    shell.Poll();
    shell.Render();

    // The viewport accepts typed drops; a saved scene asset imports through
    // the standard path when dropped (invoked via the drop handler's public
    // effect: node count grows by the asset's nodes in one transaction).
    if editor3d.AddEmptyNode("Anchor", -1) < 0 {
        Fail(shell, null, tempDir, "3D fixture node");
        return false;
    }
    var assetScenePath = Path.Join(tempDir, "prop.scene3d");
    File.WriteAllText(assetScenePath, editor3d.scene.SaveToText());
    if File.Exists(assetScenePath) == false {
        Fail(shell, null, tempDir, "3D asset fixture write");
        return false;
    }
    editor3d.Pump(doc3d);
    shell.Poll();
    shell.Render();
    var nodesBefore = editor3d.flatNodes.count();
    var undo3dBefore = editor3d.undoStack.count();
    if editor3d.ImportAssetDrop(assetScenePath) == false {
        Fail(shell, null, tempDir, "3D dropped-asset import failed");
        return false;
    }
    editor3d.Pump(doc3d);
    if editor3d.flatNodes.count() <= nodesBefore
       or editor3d.undoStack.count() != undo3dBefore + 1 {
        Fail(shell, null, tempDir,
             "3D asset import was not one growing transaction");
        return false;
    }

    // A non-3D asset drop is refused by the extension gate without history.
    if editor3d.ImportAssetDrop(notesPath) != false
       or editor3d.undoStack.count() != undo3dBefore + 1 {
        Fail(shell, null, tempDir, "3D non-asset drop was not refused");
        return false;
    }

    // Placement-aware import: the drop pump resolves the pointer to a world
    // spawn and routes here; a meshless import moves its pivot to the spawn
    // point, still as one transaction.
    var placedBefore = editor3d.scene.Root.ChildCount;
    var undoPlacedBefore = editor3d.undoStack.count();
    if editor3d.ImportAssetPathAt(assetScenePath, true, 5.0, 0.5, -7.0) == false {
        Fail(shell, null, tempDir, "3D placed import failed");
        return false;
    }
    editor3d.Pump(doc3d);
    if editor3d.scene.Root.ChildCount <= placedBefore
       or editor3d.undoStack.count() != undoPlacedBefore + 1 {
        Fail(shell, null, tempDir, "3D placed import was not one transaction");
        return false;
    }
    var placedNode = editor3d.scene.Root.GetChild(
        editor3d.scene.Root.ChildCount - 1);
    var placedPos = placedNode.Position;
    if placedPos.X < 4.9 or placedPos.X > 5.1
       or placedPos.Y < 0.4 or placedPos.Y > 0.6
       or placedPos.Z < -7.1 or placedPos.Z > -6.9 {
        Fail(shell, null, tempDir,
             "3D placed import did not land on the spawn point");
        return false;
    }

    // Import settings: the view-options scale factor and Z-up conversion
    // apply to imported roots inside the same import transaction. The
    // fixture root sits at the origin with identity scale, so a 2x factor
    // reads back directly and the Z-up conversion shows in the rotation.
    editor3d.importScaleSpinner.SetValue(2.0);
    editor3d.importZUpCheck.SetChecked(true);
    var adjustedBefore = editor3d.scene.Root.ChildCount;
    var undoAdjustedBefore = editor3d.undoStack.count();
    if editor3d.ImportAssetPath(assetScenePath) == false {
        Fail(shell, null, tempDir, "3D adjusted import failed");
        return false;
    }
    editor3d.Pump(doc3d);
    if editor3d.scene.Root.ChildCount <= adjustedBefore
       or editor3d.undoStack.count() != undoAdjustedBefore + 1 {
        Fail(shell, null, tempDir, "3D adjusted import was not one transaction");
        return false;
    }
    var adjustedNode = editor3d.scene.Root.GetChild(
        editor3d.scene.Root.ChildCount - 1);
    var adjustedScale = adjustedNode.Scale;
    if adjustedScale.X < 1.99 or adjustedScale.X > 2.01
       or adjustedScale.Y < 1.99 or adjustedScale.Y > 2.01 {
        Fail(shell, null, tempDir,
             "import scale factor did not multiply the merged root scale");
        return false;
    }
    // -90 degrees about X: the rotation quaternion carries X = -sin(45).
    var adjustedRotation = adjustedNode.Rotation;
    if adjustedRotation.X > -0.6 and adjustedRotation.X < 0.6 {
        Fail(shell, null, tempDir,
             "Z-up conversion did not rotate the merged root about X");
        return false;
    }
    editor3d.importScaleSpinner.SetValue(1.0);
    editor3d.importZUpCheck.SetChecked(false);

    // Animation preview: importing an animated glTF adopts its clips onto
    // the scene carrier; the preview plays workspace-only and Stop restores
    // the canonical bytes exactly.
    // Probe working directory is src/zannastudio/src/probes.
    if editor3d.ImportAssetPath(
           "../../../../examples/3d/openworld_slice/assets/models/"
           + "skinned_agent.gltf") == false {
        Fail(shell, null, tempDir, "animated glTF import failed");
        return false;
    }
    editor3d.Pump(doc3d);
    if editor3d.scene.AnimationCount < 1
       or editor3d.scene.GetAnimationName(0) == ""
       or editor3d.scene.GetAnimationDuration(0) <= 0.0 {
        Fail(shell, null, tempDir,
             "the imported glTF's clips did not enumerate by name/duration");
        return false;
    }
    // The skinned agent's clips are skeletal Animation3D entries: the typed
    // rigid-clip getter refuses them, and the workspace preview refuses to
    // start — cleanly, with no document or history change.
    if editor3d.scene.GetAnimation(0) != null {
        Fail(shell, null, tempDir,
             "a skeletal clip leaked through the NodeAnimation3D getter");
        return false;
    }
    var animSelection: List[Integer] = [];
    var animRootFlat = editor3d.flatNodes.count() - 1;
    animSelection.add(animRootFlat);
    editor3d.SelectSceneNodes(animSelection, animRootFlat);
    var previewBaseline = doc3d.content;
    var previewRevision = editor3d.GetRevision();
    editor3d.StartAnimationPreview();
    var tick = 0;
    while tick < 3 {
        editor3d.Pump(doc3d);
        shell.Render();
        tick = tick + 1;
    }
    if editor3d.animPreviewActive
       or doc3d.content != previewBaseline
       or editor3d.GetRevision() != previewRevision {
        Fail(shell, null, tempDir,
             "the skeletal-clip preview refusal changed workspace state");
        return false;
    }
    shell.Destroy();
    return true;
}

func main() {
    var ctx = new SceneDndProbeContext();
    if VerifyScene2DDrops(ctx) == false { return; }
    if VerifyScene3DDrops(ctx) == false { return; }

    var tempDir = ctx.tempDir;
    removeTempDir(tempDir);
    Terminal.Say("RESULT: ok");
}
