//
// File: zannastudio/src/probes/phase2_phase3_probe.zia
// Purpose: Exercise Studio build, run, debug, manifest, and scene boundaries.
// Key invariants:
//   - Process and debugger lifecycle contracts remain deterministic headlessly.
//   - Build chains preserve output and publish typed, incremental results.
//   - Persistent debug state fails safely under malformed filesystem state.
// Ownership/Lifetime: Owns all temporary projects, processes, and model values.
// Links: zannastudio/src/build/build_system.zia,
//        zannastudio/src/build/breakpoints.zia
//
//===----------------------------------------------------------------------===//

module phase2_phase3_probe;

// ============================================================================
// MODULE: phase2_phase3_probe
// PURPOSE: Headless regression coverage for build/run/debug boundary helpers.
//
// WHERE-THIS-FITS: This probe checks RunConfig, BuildSystem parsing/timing,
//          breakpoint stores, project manifest behavior, and scene data contracts
//          without launching the whole IDE shell.
//
// TEACHING-NOTE: Boundary probes should preserve public compatibility wrappers.
//          If production code moves to a leaf helper, keep this probe on the
//          caller-facing API unless the caller contract intentionally changes.
// ============================================================================

bind "../build/build_system";
bind "../build/breakpoints";
bind "../build/debug_session";
bind "../build/run_config";
bind "../commands/build_commands";
bind "../commands/debug_commands";
bind "../core/document";
bind "../core/document_manager";
bind "../core/project";
bind "../core/project_manager";
bind "../services/file_utils";

bind Terminal = Zanna.Terminal;
bind File = Zanna.IO.File;
bind Dir = Zanna.IO.Dir;
bind Path = Zanna.IO.Path;
bind TempFile = Zanna.IO.TempFile;
bind Env = Zanna.System.Environment;
bind Clock = Zanna.Time.Clock;
bind SceneDocument = Zanna.Game2D.SceneDocument;
bind Seq = Zanna.Collections.Seq;
bind Map = Zanna.Collections.Map;
bind Obj = Zanna.Core.Object;
bind Str = Zanna.String;

func fail(msg: String) {
    Terminal.Say("RESULT: fail " + msg);
}

func assertTrue(cond: Boolean, msg: String) -> Boolean {
    if cond == false {
        fail(msg);
        return false;
    }
    return true;
}

func ArgValue(name: String) -> String {
    var i = 0;
    while i < Env.GetArgumentCount() - 1 {
        if Env.GetArgument(i) == name {
            return Env.GetArgument(i + 1);
        }
        i = i + 1;
    }
    return "";
}

/// @brief Typed state shared by serial phase-2/phase-3 scenarios.
class Phase23ProbeContext {
    expose String root;
    expose String spacedDir;
    expose String sourcePath;
    expose String ziaBin;
    expose String zannaBin;
    expose build_system.BuildSystem buildSys;
}

/// @brief Verify run configuration, compiler resolution, and process output.
func VerifyRunConfigurationAndProcess(
    ctx: Phase23ProbeContext) -> Boolean {
    var root = TempFile.CreateDirWithPrefix("zannastudio_phase23_probe_");
    var spacedDir = Path.Join(root, "dir with spaces");
    Dir.MakeAll(spacedDir);
    var sourcePath = Path.Join(spacedDir, "main file.zia");
    File.WriteAllText(sourcePath,
        "module Child;\n"
        + "bind Zanna.Terminal as Terminal;\n"
        + "func main() { Terminal.Say(\"PHASE2-RUN\"); }\n");

    var doc = new document.Document();
    doc.filePath = sourcePath;
    doc.fileName = "main file.zia";
    doc.language = "zia";
    doc.kind = file_utils.DOC_KIND_CODE;
    doc.isNew = false;

    var cfg = run_config.ForDocument(run_config.ACTION_RUN, doc, null);
    if assertTrue(cfg.program == "zanna"
                  and Seq.get_Count(cfg.args) == 3
                  and Obj.ToString(Seq.Get(cfg.args, 1)) == "--diagnostic-format=json",
                  "default run config uses argument vector") == false { return false; }
    if assertTrue(Obj.ToString(Seq.Get(cfg.args, 2)) == sourcePath,
                  "run config preserves path with spaces as one arg") == false { return false; }

    var split = run_config.SplitArgs("run \"path with spaces\" {target}");
    if assertTrue(Seq.get_Count(split) == 3
                  and Obj.ToString(Seq.Get(split, 1)) == "path with spaces",
                  "split args preserves quoted token") == false { return false; }
    var splitEscaped = run_config.SplitArgs("run 'single quoted' escaped\\ token");
    if assertTrue(Seq.get_Count(splitEscaped) == 3
                  and Obj.ToString(Seq.Get(splitEscaped, 1)) == "single quoted"
                  and Obj.ToString(Seq.Get(splitEscaped, 2)) == "escaped token",
                  "split args preserves single quotes and escapes") == false { return false; }
    var splitWindows = run_config.SplitArgs(
        "run \"C:\\Program Files\\Zanna\\zanna.exe\" C:\\tmp\\main.zia \\\\server\\share \"\"");
    if assertTrue(Seq.get_Count(splitWindows) == 5
                  and Obj.ToString(Seq.Get(splitWindows, 1))
                      == "C:\\Program Files\\Zanna\\zanna.exe"
                  and Obj.ToString(Seq.Get(splitWindows, 2)) == "C:\\tmp\\main.zia"
                  and Obj.ToString(Seq.Get(splitWindows, 3)) == "\\\\server\\share"
                  and Obj.ToString(Seq.Get(splitWindows, 4)) == "",
                  "split args preserves Windows paths and empty args") == false { return false; }
    if assertTrue(run_config.SplitArgs("run \"unterminated") == null,
                  "split args rejects unmatched quotes") == false { return false; }

    var projMgr = new project_manager.ProjectManager();
    projMgr.project = new project.Project();
    projMgr.project.Open(root);
    projMgr.project.runProgram = "custom-runner";
    projMgr.project.runArgs = "run \"{target}\" --flag";
    var custom = run_config.ForDocument(run_config.ACTION_RUN, doc, projMgr);
    if assertTrue(custom.program == "custom-runner"
                  and custom.kind == run_config.KIND_CUSTOM
                  and Obj.ToString(Seq.Get(custom.args, 1)) == root,
                  "project run config override") == false { return false; }
    projMgr.project.runArgs = "run \"unterminated";
    var invalidCustom = run_config.ForDocument(run_config.ACTION_RUN, doc, projMgr);
    if assertTrue(invalidCustom.validationError != ""
                  and Seq.get_Count(invalidCustom.args) == 0,
                  "invalid project arguments fail closed") == false { return false; }

    var buildSys = new build_system.BuildSystem();
    var diag = buildSys.ParseDiagnosticLine("C:\\tmp\\a file.zia:12:3: warning[W123]: careful");
    if assertTrue(diag != null
                  and diag!.filePath == "C:\\tmp\\a file.zia"
                  and diag!.line == 12
                  and diag!.column == 3
                  and diag!.severity == 1
                  and diag!.code == "W123",
                  "problem matcher preserves colon and space path") == false { return false; }

    if assertTrue(buildSys.FormatDuration(850) == "850ms"
                  and buildSys.FormatDuration(0) == "0ms"
                  and buildSys.FormatDuration(1000) == "1.0s"
                  and buildSys.FormatDuration(1234) == "1.2s"
                  and buildSys.FormatDuration(12340) == "12.3s",
                  "build duration formats sub-second as ms and longer as seconds") == false { return false; }

    var ziaBin = ArgValue("--zia-bin");
    if assertTrue(ziaBin != "", "zia binary argument provided") == false { return false; }
    var zannaBin = ArgValue("--zanna-bin");
    if assertTrue(zannaBin != "", "zanna binary argument provided") == false { return false; }

    // Compiler resolution: the IDE spawns through Process/execve(), which neither
    // searches PATH nor resolves a bare name, so a bare "zanna" never starts a
    // build. ResolveCompiler must turn the default into an existing absolute path,
    // and report "" for a program that is nowhere to be found.
    var expectedZanna = Path.Absolute(zannaBin);
    Env.SetVariable("ZANNA_BINARY", zannaBin);
    var resolvedZanna = buildSys.ResolveCompiler("zanna");
    if assertTrue(resolvedZanna == expectedZanna
                  and Path.IsAbsolute(resolvedZanna)
                  and File.Exists(resolvedZanna),
                  "default zanna resolves to an existing absolute path") == false { return false; }
    if assertTrue(buildSys.ResolveCompiler("zanna_missing_binary_zzz_404") == "",
                  "an unfindable program resolves to empty") == false { return false; }
    var toolDir = Path.Join(spacedDir, "tools");
    Dir.MakeAll(toolDir);
    var localTool = Path.Join(toolDir, "project-tool");
    File.WriteAllText(localTool, "fixture");
    if assertTrue(buildSys.ResolveProgram(Path.Join("tools", "project-tool"),
                                         spacedDir) == Path.Absolute(localTool),
                  "project-relative executable resolves against job cwd") == false { return false; }

    var procCfg = new run_config.RunConfig();
    procCfg.name = "Probe Run";
    procCfg.action = run_config.ACTION_RUN;
    procCfg.program = ziaBin;
    procCfg.workingDirectory = spacedDir;
    Seq.Push(procCfg.args, sourcePath);
    if assertTrue(buildSys.StartConfig(procCfg), "process job starts") == false { return false; }
    // Use elapsed time rather than poll counts: Sleep(1) is allowed to wake
    // later than requested on Windows, and cold process startup can include
    // executable scanning.  A poll-count deadline therefore varied with host
    // timer granularity and made the full test suite flaky.
    var processDeadlineMs = Clock.NowMs() + 15000;
    while buildSys.IsActive() and Clock.NowMs() < processDeadlineMs {
        buildSys.Update();
        Clock.Sleep(1);
    }
    if buildSys.IsActive() {
        buildSys.Stop();
        fail("process job timed out: " + buildSys.GetOutput());
        return false;
    }
    if assertTrue(buildSys.lastBuildSuccess and Str.IndexOf(buildSys.GetOutput(), "PHASE2-RUN") != 0,
                  "process job streams child output") == false { return false; }

    // RunConfig environments are additive overrides. Embedded Play uses this
    // path with only two ZANNA_* entries, so the child must still inherit host
    // variables needed by PATH, locale, loaders, certificates, and agents.
    Env.SetVariable("ZANNA_STUDIO_OVERLAY_PARENT", "inherited");
    var envProbePath = Path.Join(spacedDir, "env_overlay.zia");
    File.WriteAllText(envProbePath,
        "module EnvOverlay;\n"
        + "bind Env = Zanna.System.Environment;\n"
        + "func main() { Zanna.Terminal.Say("
        + "Env.GetVariable(\"ZANNA_STUDIO_OVERLAY_PARENT\") + \"|\" + "
        + "Env.GetVariable(\"ZANNA_STUDIO_OVERLAY_CHILD\")); }\n");
    var envCfg = new run_config.RunConfig();
    envCfg.name = "Environment Overlay Probe";
    envCfg.action = run_config.ACTION_RUN;
    envCfg.program = ziaBin;
    envCfg.workingDirectory = spacedDir;
    Seq.Push(envCfg.args, envProbePath);
    var envOverlay = Seq.New();
    envCfg.env = envOverlay;
    Seq.Push(envOverlay, "ZANNA_STUDIO_OVERLAY_CHILD=override");
    if assertTrue(buildSys.StartConfig(envCfg),
                  "environment overlay process starts") == false { return false; }
    var envDeadlineMs = Clock.NowMs() + 15000;
    while buildSys.IsActive() and Clock.NowMs() < envDeadlineMs {
        buildSys.Update();
        Clock.Sleep(1);
    }
    if buildSys.IsActive() {
        buildSys.Stop();
        fail("environment overlay process timed out");
        return false;
    }
    if assertTrue(buildSys.lastBuildSuccess
                  and Str.IndexOf(buildSys.GetOutput(), "inherited|override") != 0,
                  "build/run environment overlays preserve inherited variables") == false {
        return false;
    }

    // A two-stage job is one user-visible transaction: output, diagnostics,
    // timing, and the typed completion survive the continuation handoff.
    var stageOnePath = Path.Join(spacedDir, "stage_one.zia");
    var stageTwoPath = Path.Join(spacedDir, "stage_two.zia");
    File.WriteAllText(stageOnePath,
        "module StageOne;\n"
        + "func main() { Zanna.Terminal.Say(\"CHAIN-STAGE-ONE\"); }\n");
    File.WriteAllText(stageTwoPath,
        "module StageTwo;\n"
        + "func main() { Zanna.Terminal.Say(\"CHAIN-STAGE-TWO\"); }\n");
    var firstStage = new run_config.RunConfig();
    firstStage.name = "Chain build";
    firstStage.action = run_config.ACTION_BUILD;
    firstStage.program = ziaBin;
    firstStage.workingDirectory = spacedDir;
    Seq.Push(firstStage.args, stageOnePath);
    var secondStage = new run_config.RunConfig();
    secondStage.name = "Chain run";
    secondStage.action = run_config.ACTION_RUN;
    secondStage.program = ziaBin;
    secondStage.workingDirectory = spacedDir;
    Seq.Push(secondStage.args, stageTwoPath);
    firstStage.next = secondStage;
    if assertTrue(buildSys.StartConfig(firstStage), "build chain starts") == false { return false; }
    var chainDeadlineMs = Clock.NowMs() + 15000;
    while buildSys.IsActive() and Clock.NowMs() < chainDeadlineMs {
        buildSys.Update();
        Clock.Sleep(1);
    }
    var chainResult = buildSys.TakeCompletedResult();
    if assertTrue(buildSys.IsActive() == false
                  and buildSys.processHandle == null
                  and Str.IndexOf(buildSys.GetOutput(), "CHAIN-STAGE-ONE") != 0
                  and Str.IndexOf(buildSys.GetOutput(), "[stage] Chain run") != 0
                  and Str.IndexOf(buildSys.GetOutput(), "CHAIN-STAGE-TWO") != 0
                  and chainResult != null
                  and chainResult!.success
                  and chainResult!.name == "Chain run",
                  "multi-stage output and typed completion remain one chain") == false { return false; }

    // Diagnostics become available while the child is still running, rather
    // than being reconstructed from a possibly truncated log only at exit.
    var liveDiagPath = Path.Join(spacedDir, "live_diagnostic.zia");
    File.WriteAllText(liveDiagPath,
        "module LiveDiagnostic;\n"
        + "func main() {\n"
        + "    Zanna.Terminal.Say(\"probe.zia:2:3: warning[W-LIVE]: streamed\");\n"
        + "    Zanna.Time.Clock.Sleep(400);\n"
        + "}\n");
    var liveCfg = new run_config.RunConfig();
    liveCfg.name = "Live diagnostics";
    liveCfg.action = run_config.ACTION_BUILD;
    liveCfg.program = ziaBin;
    liveCfg.workingDirectory = spacedDir;
    Seq.Push(liveCfg.args, liveDiagPath);
    if assertTrue(buildSys.StartConfig(liveCfg), "live diagnostic job starts") == false { return false; }
    var sawDiagnosticWhileRunning = false;
    var liveDeadlineMs = Clock.NowMs() + 15000;
    while buildSys.IsActive() and Clock.NowMs() < liveDeadlineMs {
        buildSys.Update();
        if buildSys.IsActive() and buildSys.diagnostics.count() == 1 {
            sawDiagnosticWhileRunning = true;
        }
        Clock.Sleep(1);
    }
    var liveResult = buildSys.TakeCompletedResult();
    if assertTrue(sawDiagnosticWhileRunning
                  and buildSys.diagnostics.count() == 1
                  and buildSys.diagnostics.get(0).code == "W-LIVE"
                  and buildSys.TakeDiagnosticsChanged()
                  and liveResult != null and liveResult!.success,
                  "diagnostics parse incrementally and publish typed result") == false { return false; }

    ctx.root = root;
    ctx.spacedDir = spacedDir;
    ctx.sourcePath = sourcePath;
    ctx.ziaBin = ziaBin;
    ctx.zannaBin = zannaBin;
    ctx.buildSys = buildSys;
    return true;
}

/// @brief Verify project-entry execution and process termination.
func VerifyProjectExecutionAndStop(
    ctx: Phase23ProbeContext) -> Boolean {
    var root = ctx.root;
    var spacedDir = ctx.spacedDir;
    var ziaBin = ctx.ziaBin;
    var zannaBin = ctx.zannaBin;
    var buildSys = ctx.buildSys;

    var projectRoot = Path.Join(root, "project with spaces");
    var projectSrc = Path.Join(projectRoot, "src");
    Dir.MakeAll(projectSrc);
    var entryPath = Path.Join(projectSrc, "main.zia");
    File.WriteAllText(Path.Join(projectRoot, "zanna.project"),
        "project ProbeProject\n"
        + "entry src/main.zia\n"
        + "lang zia\n");
    File.WriteAllText(entryPath,
        "module ProjectEntry;\n"
        + "bind Zanna.Terminal as Terminal;\n"
        + "func main() { Terminal.Say(\"DIR-RUN-OK\"); }\n");
    var entryDoc = new document.Document();
    entryDoc.filePath = entryPath;
    entryDoc.fileName = "main.zia";
    entryDoc.language = "zia";
    entryDoc.kind = file_utils.DOC_KIND_CODE;
    entryDoc.isNew = false;
    var entryProj = new project_manager.ProjectManager();
    entryProj.project = new project.Project();
    entryProj.project.Open(projectRoot);
    var emptyProjectDocs = new document_manager.DocumentManager();
    if assertTrue(build_commands.HasExecutionTarget(emptyProjectDocs, entryProj)
                  and build_commands.HasExecutionTarget(emptyProjectDocs, null) == false
                  and debug_commands.HasDebugTarget(emptyProjectDocs) == false,
                  "open projects are executable without an editor document") == false { return false; }
    var untitledDocs = new document_manager.DocumentManager();
    untitledDocs.NewDocument();
    if assertTrue(build_commands.HasExecutionTarget(untitledDocs, null) == false
                  and debug_commands.HasDebugTarget(untitledDocs) == false,
                  "untitled buffers are not advertised as execution targets") == false { return false; }
    emptyProjectDocs.OpenFile(entryPath);
    if assertTrue(build_commands.HasExecutionTarget(emptyProjectDocs, null)
                  and debug_commands.HasDebugTarget(emptyProjectDocs),
                  "saved source files are build and debug targets") == false { return false; }
    var projectOnlyCfg = run_config.ForDocument(run_config.ACTION_BUILD, null, entryProj);
    if assertTrue(projectOnlyCfg.kind == run_config.KIND_PROJECT_ENTRY
                  and projectOnlyCfg.targetPath == projectRoot,
                  "project-only build config targets the workspace root") == false { return false; }
    var entryCfg = run_config.ForDocument(run_config.ACTION_RUN, entryDoc, entryProj);
    entryCfg.program = zannaBin;
    if assertTrue(entryCfg.kind == run_config.KIND_PROJECT_ENTRY
                  and entryCfg.targetPath == projectRoot
                  and entryProj.project.entryFile == "src/main.zia",
                  "project entry run config targets manifest root") == false { return false; }
    if assertTrue(buildSys.StartConfig(entryCfg), "project entry process starts") == false { return false; }
    var processDeadlineMs = Clock.NowMs() + 15000;
    while buildSys.IsActive() and Clock.NowMs() < processDeadlineMs {
        buildSys.Update();
        Clock.Sleep(1);
    }
    if buildSys.IsActive() {
        buildSys.Stop();
        fail("project entry run timed out: " + buildSys.GetOutput());
        return false;
    }
    if assertTrue(buildSys.lastBuildSuccess and Str.IndexOf(buildSys.GetOutput(), "DIR-RUN-OK") != 0,
                  "project entry run executes manifest entry") == false { return false; }

    var longPath = Path.Join(spacedDir, "long_running.zia");
    File.WriteAllText(longPath,
        "module LongRunning;\n"
        + "func main() {\n"
        + "    while true {\n"
        + "        Zanna.Time.Clock.Sleep(10);\n"
        + "    }\n"
        + "}\n");
    var stopCfg = new run_config.RunConfig();
    stopCfg.name = "Long Run";
    stopCfg.action = run_config.ACTION_RUN;
    stopCfg.program = ziaBin;
    stopCfg.workingDirectory = spacedDir;
    Seq.Push(stopCfg.args, longPath);
    if assertTrue(buildSys.StartConfig(stopCfg), "long-running process starts") == false { return false; }
    Clock.Sleep(50);
    buildSys.Update();
    if buildSys.IsActive() == false {
        fail("long-running process exited early: " + buildSys.GetOutput());
        return false;
    }
    var killed = buildSys.Stop();
    var stoppedResult = buildSys.TakeCompletedResult();
    if assertTrue(killed
                  and buildSys.IsActive() == false
                  and buildSys.processHandle == null
                  and buildSys.exitCode == -1
                  and stoppedResult != null and stoppedResult!.stopped
                  and Str.IndexOf(buildSys.GetOutput(), "[stopped]") != 0,
                  "stop uses unified finalization and typed completion") == false { return false; }

    return true;
}

/// @brief Verify bounded and failure-safe breakpoint persistence.
func VerifyBreakpointPersistence(
    ctx: Phase23ProbeContext) -> Boolean {
    var root = ctx.root;
    var sourcePath = ctx.sourcePath;

    var bpPath = Path.Join(root, "settings.ini");
    var bpStore = new breakpoints.BreakpointStore();
    bpStore.Setup(bpPath);
    bpStore.Toggle(sourcePath, 2);
    bpStore.Toggle(sourcePath, 3);
    if assertTrue(bpStore.Save(), "breakpoint store saves ordinary state") == false { return false; }
    bpStore.Toggle(sourcePath, 3);
    if assertTrue(bpStore.Save(), "breakpoint store saves compacted state") == false { return false; }
    var bpText = File.ReadAllText(bpPath);
    if assertTrue(Str.IndexOf(bpText, "[breakpoint.1]") == 0,
                  "breakpoint save removes stale higher-numbered sections") == false { return false; }
    var loadedBps = new breakpoints.BreakpointStore();
    loadedBps.Setup(bpPath);
    if assertTrue(loadedBps.Load(), "breakpoint store reload succeeds") == false { return false; }
    if assertTrue(loadedBps.Count() == 1
                  and loadedBps.GetPath(0) == sourcePath
                  and loadedBps.GetLine(0) == 2,
                  "breakpoints persist by structured path and line") == false { return false; }
    if assertTrue(loadedBps.RemoveAtLocation(sourcePath, 999) == false
                  and loadedBps.Count() == 1,
                  "removing a stale breakpoint never toggles it on") == false { return false; }
    if assertTrue(loadedBps.RemoveAtLocation(sourcePath, 2)
                  and loadedBps.Count() == 0,
                  "exact breakpoint removal updates the durable store") == false { return false; }

    var settingsOnlyPath = Path.Join(root, "settings-only.ini");
    File.WriteAllText(settingsOnlyPath, "[settings]\ntheme=dark\nfontSize=15\n");
    var emptyBps = new breakpoints.BreakpointStore();
    emptyBps.Setup(settingsOnlyPath);
    emptyBps.Load();
    if assertTrue(emptyBps.Count() == 0,
                  "breakpoint load tolerates settings file without breakpoint section") == false { return false; }

    // The writer must obey the same count cap as the loader. Otherwise a
    // generated/debug-heavy session can create a settings file that startup
    // deliberately refuses to reconstruct in full.
    var cappedBpPath = Path.Join(root, "capped-breakpoints.ini");
    var cappedBps = new breakpoints.BreakpointStore();
    cappedBps.Setup(cappedBpPath);
    var cappedBpIndex = 0;
    while cappedBpIndex < breakpoints.MAX_PERSISTED_BREAKPOINTS + 1 {
        var cappedBp = new breakpoints.Breakpoint();
        cappedBp.path = sourcePath;
        cappedBp.line = cappedBpIndex + 1;
        cappedBps.items.add(cappedBp);
        cappedBpIndex = cappedBpIndex + 1;
    }
    if assertTrue(cappedBps.Save(), "bounded breakpoint store saves") == false { return false; }
    var cappedBpIni = Ini.Parse(File.ReadAllText(cappedBpPath));
    if assertTrue(Ini.Get(cappedBpIni, "breakpoints", "count") == "4096"
                  and Ini.Get(cappedBpIni, "breakpoint.4095", "line") == "4096"
                  and Ini.Get(cappedBpIni, "breakpoint.4096", "line") == "",
                  "breakpoint writer caps records at the restore limit") == false { return false; }

    var invalidBps = new breakpoints.BreakpointStore();
    invalidBps.Setup(root);
    invalidBps.Toggle(sourcePath, 9);
    if assertTrue(invalidBps.Save() == false,
                  "breakpoint persistence failure returns without trapping") == false { return false; }

    return true;
}

/// @brief Verify the VM debug adapter and owned scene persistence.
func VerifyDebugAdapterAndScene(
    ctx: Phase23ProbeContext) -> Boolean {
    var root = ctx.root;
    var spacedDir = ctx.spacedDir;
    var zannaBin = ctx.zannaBin;

    // Real VM debug adapter: launch a program, stop at a breakpoint with a call
    // stack and locals, then continue to exit. Drives the same DebugSession the IDE
    // uses, so the out-of-process protocol is exercised end-to-end without a GUI.
    var dbgFile = Path.Join(spacedDir, "debuggee.zia");
    File.WriteAllText(dbgFile,
        "module Debuggee;\n"
        + "bind Zanna.Terminal as Terminal;\n"
        + "func main() {\n"
        + "    var total = 7;\n"
        + "    Terminal.Say(\"before-bp\");\n"
        + "    Terminal.Say(\"after-bp=\" + total);\n"
        + "}\n");
    var dbgStore = new breakpoints.BreakpointStore();
    dbgStore.Setup(Path.Join(root, "debuggee-bp.ini"));
    dbgStore.Toggle(dbgFile, 5);

    var dbg = new debug_session.DebugSession();
    if assertTrue(dbg.Launch(zannaBin, dbgFile, dbgStore),
                  "debug adapter launches") == false { return false; }
    var debugDeadlineMs = Clock.NowMs() + 20000;
    while dbg.IsActive() and dbg.stopped == false and Clock.NowMs() < debugDeadlineMs {
        dbg.Poll();
        Clock.Sleep(1);
    }
    if dbg.IsActive() and dbg.stopped == false {
        dbg.Terminate();
        fail("debug adapter breakpoint wait timed out");
        return false;
    }
    if assertTrue(dbg.stopped and dbg.lastLine == 5 and dbg.lastReason == "breakpoint",
                  "debug adapter stops at the breakpoint line") == false { return false; }
    if assertTrue(Str.IndexOf(dbg.FormatConsole(), "Call stack") != 0
                  and Str.IndexOf(dbg.FormatConsole(), "total = 7") != 0,
                  "debug stop reports a call stack and locals") == false { return false; }

    dbg.Continue();
    // Pump until the adapter handle is released, not merely until the session
    // stops being active. The terminated event reaches stderr before the child
    // exits, and the program's stdout is still buffered inside the adapter until
    // that exit flushes it; stopping at IsActive() drops the program output.
    debugDeadlineMs = Clock.NowMs() + 20000;
    while dbg.NeedsPump() and Clock.NowMs() < debugDeadlineMs {
        dbg.Poll();
        Clock.Sleep(1);
    }
    if dbg.NeedsPump() {
        dbg.Terminate();
        fail("debug adapter termination wait timed out");
        return false;
    }
    if assertTrue(dbg.terminated
                  and Str.IndexOf(dbg.programOutput, "before-bp") != 0
                  and Str.IndexOf(dbg.programOutput, "after-bp") != 0,
                  "debug adapter runs the program and terminates after continue") == false { return false; }

    var scene = SceneDocument.New(3, 2, 16, 16);
    scene.SetStr("theme", "cavern");
    scene.SetInt("spawnX", 32);
    var layer = scene.AddLayer("fg");
    scene.SetLayerAsset(layer, "tiles/fg.png");
    scene.SetTile(layer, 1, 1, 7);
    var obj = scene.AddObject("enemy", "slime-1", 64, 48);
    scene.ObjectSetInt(obj, "hp", 3);
    scene.ObjectSetBool(obj, "awake", true);
    var scenePath = Path.Join(root, "level.scene");
    if assertTrue(scene.Save(scenePath), "scene save file") == false { return false; }
    var loaded = SceneDocument.Load(scenePath);
    if assertTrue(loaded.HasErrors() == false
                  and loaded.GetTile(1, 1, 1) == 7
                  and loaded.ObjectGetInt(0, "hp", -1) == 3
                  and loaded.ObjectGetBool(0, "awake", false),
                  "scene load/save preserves owned edits") == false { return false; }
    if assertTrue(loaded.BuildTilemap() != null,
                  "scene builds render tilemap copy") == false { return false; }
    var bad = SceneDocument.LoadJson("{\"version\":1,");
    if assertTrue(bad.HasErrors()
                  and Seq.get_Count(bad.DiagnosticRecords()) > 0,
                  "scene malformed json reports diagnostics") == false { return false; }

    Dir.RemoveAll(root);
    Terminal.Say("RESULT: ok");
    return true;
}

func main() {
    var ctx = new Phase23ProbeContext();
    if VerifyRunConfigurationAndProcess(ctx) == false { return; }
    if VerifyProjectExecutionAndStop(ctx) == false { return; }
    if VerifyBreakpointPersistence(ctx) == false { return; }
    if VerifyDebugAdapterAndScene(ctx) == false { return; }
}
