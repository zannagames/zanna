//
// File: zannastudio/src/probes/tool_panel_virtualization_probe.zia
// Purpose: Verify large Studio tool panels switch to viewport-backed rows.
// Key invariants:
//   - Small-list compatibility gives way to virtualization at one fixed threshold.
//   - Selection text and durable navigation data survive the mode transition.
//   - Clearing a panel detaches and resets its virtual presentation.
// Ownership/Lifetime: The probe owns and destroys one hidden AppShell.
// Links: zannastudio/src/ui/tool_panel_model.zia,
//        zannastudio/src/ui/tool_panel_shell.zia
//
//===----------------------------------------------------------------------===//

module tool_panel_virtualization_probe;

bind "../ui/app_shell";
bind "../ui/tool_panel_model";

bind Str = Zanna.String;
bind Terminal = Zanna.Terminal;

func Fail(shell: app_shell.AppShell,
          reason: String) {
    if shell != null { shell.Destroy(); }
    Terminal.Say("RESULT: fail " + reason);
}

func VerifySearch(shell: app_shell.AppShell) -> Boolean {
    shell.toolPanels.ClearToolRows(shell.toolPanels.searchListBox);
    var rowCount = tool_panel_model.VIRTUALIZE_AFTER_ROWS + 48;
    var i = 0;
    while i < rowCount {
        var item = shell.toolPanels.AddToolLocationRow(
            shell.toolPanels.searchListBox,
            "match", "text", "line " + (i + 1), "-",
            "virtual search row " + i, "");
        shell.toolPanels.SetAddedToolRowLocationData(
            shell.toolPanels.searchListBox, item, "search-data:" + i);
        i = i + 1;
    }
    shell.toolPanels.ShowSearchPanel();
    shell.Render();

    if shell.toolPanels.searchRows.virtualized == false
       or shell.toolPanels.searchListBox.Count != rowCount {
        Fail(shell, "search did not virtualize");
        return false;
    }
    var realized = shell.toolPanels.searchListBox.GetVisibleCount();
    if realized <= 0 or realized >= rowCount {
        Fail(shell, "search viewport realization was not bounded");
        return false;
    }

    shell.toolPanels.searchListBox.SelectIndex(rowCount - 1);
    if shell.toolPanels.GetSelectedToolRowData(
           shell.toolPanels.searchListBox) != "search-data:" + (rowCount - 1)
       or Str.Contains(shell.toolPanels.searchListBox.GetSelectedText(),
                       "virtual search row " + (rowCount - 1)) == false {
        Fail(shell, "search selection metadata");
        return false;
    }

    shell.toolPanels.ClearToolRows(shell.toolPanels.searchListBox);
    if shell.toolPanels.searchRows.virtualized
       or shell.toolPanels.searchListBox.Count != 0 {
        Fail(shell, "search virtual reset");
        return false;
    }
    return true;
}

func VerifyProblems(shell: app_shell.AppShell) -> Boolean {
    shell.toolPanels.BeginProblems();
    var problemCount = tool_panel_model.VIRTUALIZE_AFTER_ROWS + 16;
    var i = 0;
    while i < problemCount {
        var item = shell.toolPanels.AddProblem(
            "warning", "probe", "virtual.zia", i + 1, 1,
            "P-VIRTUAL", "virtual problem " + i, "");
        shell.toolPanels.SetAddedProblemLocationData(item, "problem-data:" + i);
        i = i + 1;
    }
    shell.toolPanels.FinishProblems(problemCount);
    shell.Render();
    if shell.toolPanels.problemsRows.virtualized == false
       or shell.toolPanels.diagListBox.Count != problemCount + 1 {
        Fail(shell, "problems did not virtualize");
        return false;
    }
    shell.toolPanels.diagListBox.SelectIndex(problemCount);
    if shell.toolPanels.GetSelectedProblemLocationData()
       != "problem-data:" + (problemCount - 1) {
        Fail(shell, "problem selection metadata");
        return false;
    }
    return true;
}

func VerifyDebugConsole(shell: app_shell.AppShell) -> Boolean {
    var output = "";
    var lineCount = tool_panel_model.VIRTUALIZE_AFTER_ROWS + 24;
    var i = 0;
    while i < lineCount {
        output = output + "debug virtual row " + i + "\n";
        i = i + 1;
    }
    shell.toolPanels.SetDebugOutput(output);
    shell.Render();
    if shell.toolPanels.debugRows.virtualized == false
       or shell.toolPanels.debugListBox.Count != lineCount {
        Fail(shell, "debug console did not virtualize");
        return false;
    }
    shell.toolPanels.debugListBox.SelectIndex(lineCount - 1);
    if shell.toolPanels.debugListBox.GetSelectedText()
       != "debug virtual row " + (lineCount - 1) {
        Fail(shell, "debug console selection text");
        return false;
    }
    return true;
}

func main() {
    var shell = new app_shell.AppShell();
    shell.Build("Zanna Studio Tool Panel Virtualization Probe", 880, 620);
    shell.Poll();
    shell.Render();

    if VerifySearch(shell) == false { return; }
    if VerifyProblems(shell) == false { return; }
    if VerifyDebugConsole(shell) == false { return; }

    shell.Destroy();
    Terminal.Say("RESULT: ok");
}
