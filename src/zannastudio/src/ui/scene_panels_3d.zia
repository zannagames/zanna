//===----------------------------------------------------------------------===//
//
// File: zannastudio/src/ui/scene_panels_3d.zia
// Purpose: Construct the complete 3D scene editor widget tree (0.5d split).
// Key invariants:
//   - Build is a verbatim relocation of SceneEditor3D.Setup's construction
//     body: identical widgets, order, properties, and defaults.
//   - Every widget lands on the editor's own fields; this module retains
//     no state and is safe to call exactly once per editor instance.
//   - Game View is a first-class view action, separate from the project camera
//     reset and reversible Focus/layout presentation.
//   - Scene, Create, Placement, and View menus are built once with stable item
//     handles; the editor owns their state and command dispatch.
//   - Progressive disclosure is stable across widths: wider lanes enlarge the
//     viewport instead of repopulating chrome with secondary commands.
//   - Desktop defaults bound both supporting panes so the viewport is wider
//     than the Hierarchy and Inspector without overriding persisted dividers.
//   - One compact Scene-topic dropdown owns mutually exclusive complete
//     scene-wide inspector groups; the controller owns its live visibility.
//   - A project preview-state dropdown exists only when schema v18 supplies
//     it; its redundant label hides before the contextual control does.
// Ownership/Lifetime:
//   - The editor owns every constructed widget; this module owns nothing.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        docs/adr/0216-project-owned-3d-node-preview-states.md
//
//===----------------------------------------------------------------------===//

module scene_panels_3d;

// ============================================================================
// MODULE: scene_panels_3d
// PURPOSE: Keep widget construction out of the editor mega-module so the
//          editor file carries behavior, not layout scaffolding.
//
// WHERE-THIS-FITS: Callers construct SceneEditor3D and delegate the build
//          here; behavior (pumps, commits, rendering) stays with the
//          editor class, which owns all constructed widgets as fields.
//
// TEACHING-NOTE: The dispatcher pattern — Zia modules cannot extend a
//          class, so the builder takes the editor and assigns its exposed
//          fields directly.
// ============================================================================

bind "../services/file_utils";
bind "scene_bake_3d";
bind "scene_editor_3d";
bind "scene_panels_3d_inspector";
bind "scene_pane_docking";

bind GUI = Zanna.GUI;

/// @brief Build the full 3D editor widget tree onto @p editor's fields.
/// @details Construction is grouped by owned surface so each helper has one
///          layout responsibility while preserving the historical widget order.
expose func Build(editor: scene_editor_3d.SceneEditor3D,
                  host: GUI.VBox,
                  app: GUI.App) {
    BuildCommandToolbar(editor, host, app);
    BuildViewToolbar(editor);
    var inspector = BuildWorkspaceScaffold(editor);
    scene_panels_3d_inspector.BuildInspectorHeader(editor, inspector, app);
    scene_panels_3d_inspector.BuildHierarchy(editor, app);
    scene_panels_3d_inspector.BuildNodeInspector(editor, inspector);
    scene_panels_3d_inspector.BuildBakeInspector(editor, inspector);
    scene_panels_3d_inspector.BuildEnvironmentInspector(editor, inspector);
    scene_panels_3d_inspector.FinishInspector(editor, inspector);
}

/// @brief Construct the editor root and primary scene-command toolbar.
func BuildCommandToolbar(editor: scene_editor_3d.SceneEditor3D,
                         host: GUI.VBox,
                         app: GUI.App) {
        editor.guiApp = app;
        editor.root = GUI.VBox.New();
        editor.root.SetSpacing(0.0);
        editor.root.SetPadding(0.0);
        editor.root.SetFlex(1.0);
        editor.root.SetName("scene-editor-3d");
        editor.root.SetAccessibleName("3D scene editor");
        host.AddChild(editor.root);

        editor.toolbar = GUI.Flex.New();
        editor.toolbar.SetDirection(GUI.FlexDirection.Row);
        editor.toolbar.SetWrap(GUI.FlexWrap.Wrap);
        editor.toolbar.SetAlign(GUI.Align.Center);
        editor.toolbar.SetGap(4.0);
        editor.toolbar.SetPadding(4.0);
        editor.root.AddChild(editor.toolbar);

        editor.sceneMenuButton =
            GUI.Button.New(editor.toolbar, "Scene...");
        editor.sceneMenuButton.SetAccessibleName(
            "Open 3D scene document commands");
        editor.sceneMenuButton.SetTooltip(
            "New, import, instance, and run commands");
        editor.sceneMenu = GUI.ContextMenu.New();
        editor.sceneNewItem =
            editor.sceneMenu.AddItem("New Empty Scene");
        editor.sceneImportAssetItem =
            editor.sceneMenu.AddItem("Import Asset...");
        editor.sceneImportInstanceItem =
            editor.sceneMenu.AddItem("Import Scene Instance...");
        editor.sceneMenu.AddSeparator();
        editor.sceneRunItem =
            editor.sceneMenu.AddItemWithShortcut("Run Scene", "Ctrl+R");

        editor.newSceneButton = GUI.Button.New(editor.toolbar, "New");
        editor.newSceneButton.SetTooltip("Replace this document with an empty 3D scene");
        editor.newSceneButton.SetVisible(false);
        editor.importAssetButton = GUI.Button.New(editor.toolbar, "Import Asset...");
        editor.importAssetButton.SetTooltip(
            "Import Scene3D/VSCN, glTF, GLB, FBX, OBJ, or STL into this scene document");
        editor.importAssetButton.SetVisible(false);
        editor.importInstanceButton = GUI.Button.New(editor.toolbar, "Import Instance...");
        editor.importInstanceButton.SetTooltip(
            "Place a scene by reference (VSCN v7 prefab): the file stores "
            + "only the reference plus this node's overrides");
        editor.importInstanceButton.SetVisible(false);
        editor.createMenuButton =
            GUI.Button.New(editor.toolbar, "Create...");
        editor.createMenuButton.SetAccessibleName(
            "Open 3D scene creation commands");
        editor.createMenuButton.SetTooltip(
            "Create nodes and primitives without expanding the command bar");
        editor.createMenuButton.SetVisible(false);
        editor.createMenu = GUI.ContextMenu.New();
        editor.createEmptyItem =
            editor.createMenu.AddItem("Create Empty Node");
        editor.createChildItem =
            editor.createMenu.AddItem("Create Child Node");
        editor.createMenu.AddSeparator();
        editor.createBoxItem = editor.createMenu.AddItem("Create Box");
        editor.createSphereItem =
            editor.createMenu.AddItem("Create Sphere");
        editor.createPlaneItem =
            editor.createMenu.AddItem("Create Plane");
        editor.createCylinderItem =
            editor.createMenu.AddItem("Create Cylinder");
        editor.createTerrainItem =
            editor.createMenu.AddItem("Create Terrain");
        editor.createLightItem =
            editor.createMenu.AddItem("Create Point Light");
        editor.createCameraItem =
            editor.createMenu.AddItem("Create Camera");
        editor.createMenu.AddSeparator();
        editor.createDuplicateItem =
            editor.createMenu.AddItemWithShortcut("Duplicate Selection", "Ctrl+D");
        editor.createDeleteItem =
            editor.createMenu.AddItemWithShortcut("Delete Selection", "Delete");
        editor.addEmptyButton = GUI.Button.New(editor.toolbar, "+ Empty");
        editor.addChildButton = GUI.Button.New(editor.toolbar, "+ Child");
        editor.addBoxButton = GUI.Button.New(editor.toolbar, "+ Box");
        editor.addSphereButton = GUI.Button.New(editor.toolbar, "+ Sphere");
        editor.addPlaneButton = GUI.Button.New(editor.toolbar, "+ Plane");
        editor.addCylinderButton = GUI.Button.New(editor.toolbar, "+ Cylinder");
        editor.addTerrainButton = GUI.Button.New(editor.toolbar, "+ Terrain");
        editor.addTerrainButton.SetTooltip(
            "Create a centered canonical terrain mesh ready for viewport sculpting");
        editor.addLightButton = GUI.Button.New(editor.toolbar, "+ Light");
        editor.addLightButton.SetTooltip(
            "Create a top-level Point light node in one undoable edit");
        editor.addCameraButton = GUI.Button.New(editor.toolbar, "+ Camera");
        editor.addCameraButton.SetTooltip(
            "Create a top-level camera node in one undoable edit");
        editor.duplicateNodeButton = GUI.Button.New(editor.toolbar, "Duplicate");
        editor.duplicateNodeButton.SetTooltip(
            "Duplicate selected hierarchy roots with their complete subtrees");
        editor.duplicateNodeButton.SetVisible(false);
        editor.deleteNodeButton = GUI.Button.New(editor.toolbar, "Delete");
        editor.deleteNodeButton.SetVisible(false);
        editor.runSceneButton = GUI.Button.New(editor.toolbar, "Run Scene");
        editor.runSceneButton.SetTooltip(
            "Save and run the owning project with this scene (Ctrl+R)");
        editor.runSceneButton.SetVisible(false);
        editor.toolbarStatus = GUI.Label.New(editor.toolbar, "Open or create a 3D scene");
        editor.toolbarStatus.SetFlex(1.0);
        editor.toolbarStatus.SetPreferredSize(180.0, 0.0);
}

/// @brief Construct viewport, transform, placement, and view-option chrome.
func BuildViewToolbar(editor: scene_editor_3d.SceneEditor3D) {
    BuildTransformToolbar(editor);
    BuildNavigationToolbar(editor);
    BuildViewOptions(editor);
}

/// @brief Construct the view host and transform/placement controls.
func BuildTransformToolbar(editor: scene_editor_3d.SceneEditor3D) {
        editor.viewToolbar = GUI.Flex.New();
        editor.viewToolbar.SetDirection(GUI.FlexDirection.Row);
        editor.viewToolbar.SetWrap(GUI.FlexWrap.Wrap);
        editor.viewToolbar.SetAlign(GUI.Align.Center);
        editor.viewToolbar.SetGap(4.0);
        editor.viewToolbar.SetPadding(4.0);
        editor.root.AddChild(editor.viewToolbar);
        editor.viewSectionLabel =
            GUI.Label.New(editor.viewToolbar, "View");
        editor.viewportModeButton = GUI.Button.New(editor.viewToolbar, "Shaded");
        editor.UpdateViewportModeControls();
        editor.hierarchyButton =
            GUI.Button.New(editor.viewToolbar, "Hierarchy");
        editor.hierarchyButton.SetStyle(2);
        editor.hierarchyButton.SetTooltip(
            "Open the scene hierarchy at the full editor width");
        editor.hierarchyButton.SetVisible(false);
        editor.inspectorButton = GUI.Button.New(editor.viewToolbar, "Hide Inspector");
        editor.inspectorButton.SetStyle(2);
        editor.inspectorButton.SetTooltip(
            "Hide the node inspector and give the viewport the full width");
        editor.focusButton = GUI.Button.New(editor.viewToolbar, "Focus");
        editor.focusButton.SetStyle(2);
        editor.focusButton.SetTooltip(
            "Hide outer Studio docks and maximize the scene viewport");
        editor.transformSectionLabel =
            GUI.Label.New(editor.viewToolbar, "Transform");
        editor.moveToolButton = GUI.Button.New(editor.viewToolbar, "Move");
        editor.moveToolButton.SetTooltip(
            "Move the selected node along one axis (W in viewport)");
        editor.rotateToolButton = GUI.Button.New(editor.viewToolbar, "Rotate");
        editor.rotateToolButton.SetTooltip(
            "Rotate the selected node around one axis (E in viewport)");
        editor.scaleToolButton = GUI.Button.New(editor.viewToolbar, "Scale");
        editor.scaleToolButton.SetTooltip(
            "Scale the selected node along one axis (R in viewport)");
        editor.dropToSurfaceButton =
            GUI.Button.New(editor.viewToolbar, "Drop");
        editor.dropToSurfaceButton.SetTooltip(
            "Drop selected hierarchy roots onto the nearest visible surface; "
            + "Align can also orient them to its normal (End in viewport)");
        editor.placementMenuButton =
            GUI.Button.New(editor.viewToolbar, "Placement...");
        editor.placementMenuButton.SetAccessibleName(
            "Open precise 3D placement commands");
        editor.placementMenuButton.SetTooltip(
            "Drop, surface-follow, normal-align, and vertex-snap controls");
        editor.placementMenuButton.SetVisible(false);
        editor.placementMenu = GUI.ContextMenu.New();
        editor.placementDropItem =
            editor.placementMenu.AddItemWithShortcut(
                "Drop Selection to Surface", "End");
        editor.placementMenu.AddSeparator();
        editor.placementSurfaceItem =
            editor.placementMenu.AddItem("Surface Move");
        editor.placementSurfaceItem.SetCheckable(true);
        editor.placementAlignItem =
            editor.placementMenu.AddItem("Align to Surface Normal");
        editor.placementAlignItem.SetCheckable(true);
        editor.placementVertexItem =
            editor.placementMenu.AddItemWithShortcut("Vertex Move", "Shift+V");
        editor.placementVertexItem.SetCheckable(true);
        editor.transformSpaceButton = GUI.Button.New(editor.viewToolbar, "Local");
        editor.transformSpaceButton.SetTooltip(
            "Use parent-relative local axes; choose World for global axes");
        editor.snapTransformCheck = GUI.Checkbox.New(editor.viewToolbar, "Snap");
        editor.snapTransformCheck.SetTooltip(
            "Quantize the resulting transform using the current tool's step");
        editor.snapTransformCheck.SetChecked(false);
        editor.snapTransformRevision = editor.snapTransformCheck.GetRevision();
        editor.surfaceSnapCheck =
            GUI.Checkbox.New(editor.viewToolbar, "Surface");
        editor.surfaceSnapCheck.SetTooltip(
            "Keep X, Z, and XZ Move drags grounded on authored or project "
            + "preview surfaces");
        editor.surfaceSnapCheck.SetChecked(false);
        editor.surfaceSnapRevision =
            editor.surfaceSnapCheck.GetRevision();
        editor.surfaceAlignCheck =
            GUI.Checkbox.New(editor.viewToolbar, "Align");
        editor.surfaceAlignCheck.SetTooltip(
            "Preserve twist while aligning each dropped or Surface-moved "
            + "hierarchy root's up axis to the precise terrain normal");
        editor.surfaceAlignCheck.SetChecked(false);
        editor.surfaceAlignRevision =
            editor.surfaceAlignCheck.GetRevision();
        editor.vertexSnapCheck =
            GUI.Checkbox.New(editor.viewToolbar, "Vertex");
        editor.vertexSnapCheck.SetTooltip(
            "Hold V for transient vertex snapping or use Shift+V to toggle. "
            + "Drag a selected mesh vertex or pivot onto another vertex "
            + "or visible surface.");
        editor.vertexSnapCheck.SetChecked(false);
        editor.vertexSnapRevision =
            editor.vertexSnapCheck.GetRevision();
        editor.UpdateGizmoModeControls();
}

