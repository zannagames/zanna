/// @brief Construct the collapsible viewport-overlay option row.
func BuildViewOptions(editor: scene_editor_3d.SceneEditor3D) {
        editor.viewOptionsRow = GUI.Flex.New();
        editor.viewOptionsRow.SetDirection(GUI.FlexDirection.Row);
        editor.viewOptionsRow.SetWrap(GUI.FlexWrap.Wrap);
        editor.viewOptionsRow.SetAlign(GUI.Align.Center);
        editor.viewOptionsRow.SetGap(4.0);
        editor.viewOptionsRow.SetPadding(layout_metrics.PAD_ROW);
        editor.root.AddChild(editor.viewOptionsRow);
        editor.gridCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Grid");
        editor.gridCheck.SetTooltip("Show the ground grid overlay");
        editor.gridCheck.SetChecked(true);
        editor.markersCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Markers");
        editor.markersCheck.SetTooltip(
            "Show node origin markers and hierarchy links");
        editor.markersCheck.SetChecked(true);
        editor.lightsCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Lights");
        editor.lightsCheck.SetTooltip("Show light glyph overlays");
        editor.lightsCheck.SetChecked(true);
        editor.camerasCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Cameras");
        editor.camerasCheck.SetTooltip(
            "Show camera markers, frusta, and the preview inset");
        editor.camerasCheck.SetChecked(true);
        editor.collidersCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Colliders");
        editor.collidersCheck.SetTooltip("Show collider convention wireframes");
        editor.collidersCheck.SetChecked(true);
        editor.routesCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Routes");
        editor.routesCheck.SetTooltip("Show route waypoint polylines");
        editor.routesCheck.SetChecked(true);
        editor.statsCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Stats");
        editor.statsCheck.SetTooltip(
            "Append visible/culled node counts to the view status");
        editor.statsCheck.SetChecked(false);
        editor.editorLightCheck = GUI.Checkbox.New(editor.viewOptionsRow, "Editor light");
        editor.editorLightCheck.SetTooltip(
            "Boost viewport ambient so authored content stays visible when "
            + "scene lights are dim or game-driven; never affects VSCN or "
            + "the camera preview");
        editor.editorLightCheck.SetChecked(true);
        GUI.Label.New(editor.viewOptionsRow, "Snap move");
        editor.snapMoveSpinner = editor.AddSnapSpinner(
            0.001, 1000.0, 0.1, 0.5, "Move snap increment");
        GUI.Label.New(editor.viewOptionsRow, "rotate");
        editor.snapRotateSpinner = editor.AddSnapSpinner(
            0.001, 180.0, 1.0, 15.0, "Rotate snap increment");
        GUI.Label.New(editor.viewOptionsRow, "scale");
        editor.snapScaleSpinner = editor.AddSnapSpinner(
            0.001, 10.0, 0.05, 0.1, "Scale snap increment");
        editor.viewOptionsRow.SetVisible(false);
}

/// @brief Construct the three-pane hierarchy, viewport, and inspector frame.
/// @return The inspector content box borrowed by the remaining builders.
func BuildWorkspaceScaffold(editor: scene_editor_3d.SceneEditor3D)
    -> GUI.VBox {
        // Three-pane workbench: Hierarchy | Viewport | Inspector. The outer
        // split owns the hierarchy pane; the inner split keeps its historical
        // name so persisted fractions and probes stay stable.
        editor.hierarchySplit = GUI.SplitPane.New(editor.root, 1);
        editor.hierarchySplit.SetFlex(1.0);
        editor.hierarchySplit.SetPosition(0.18);
        editor.hierarchySplit.SetMinFirst(220.0);
        editor.hierarchySplit.SetMinSecond(540.0);

        editor.hierarchyPaneBox = GUI.VBox.New();
        var hierarchyPane = editor.hierarchyPaneBox;
        hierarchyPane.SetSpacing(layout_metrics.GAP_GROUP);
        hierarchyPane.SetPadding(layout_metrics.PAD_PANE);
        hierarchyPane.SetFlex(1.0);
        editor.hierarchySplit.First.AddChild(hierarchyPane);

        editor.bodySplit = GUI.SplitPane.New(editor.hierarchySplit.Second, 1);
        editor.bodySplit.SetFlex(1.0);
        editor.bodySplit.SetPosition(0.70);
        editor.bodySplit.SetMinFirst(320.0);
        editor.bodySplit.SetMinSecond(320.0);

        editor.viewportScroll = GUI.ScrollView.New(editor.bodySplit.First);
        editor.viewportScroll.SetFlex(1.0);
        editor.viewportImage = GUI.Image.New(editor.viewportScroll);
        editor.viewportImage.SetScaleMode(0);
        editor.viewportImage.SetFilter(0);
        editor.viewportImage.SetName("scene-3d-viewport");
        editor.viewportImage.SetAccessibleName("3D scene viewport");
        // The viewport is a real focusable surface: clicking it takes
        // keyboard focus, so W/E/R/F, Escape, Delete, and Duplicate belong
        // to the viewport the user is actually working in.
        editor.viewportImage.SetFocusable(true);
        // Project assets and library materials drop onto the viewport
        // (Phase 1.2): 3D assets import, materials apply to the node hit.
        editor.viewportImage.SetDropTarget(true);
        editor.viewportImage.SetAcceptedDropTypes("zanna/asset,zanna/material");
        editor.viewportImage.SetTooltip(
            "Click visible meshes to select; Shift adds and Ctrl/Cmd toggles. "
            + "Drag colored transform handles. Middle/right-drag to orbit, "
            + "or add Shift to pan. Use the wheel to zoom. W/E/R switch "
            + "tools, F frames, and Escape clears the selection while the "
            + "viewport owns focus.");

        editor.inspectorScroll = GUI.ScrollView.New(editor.bodySplit.Second);
        editor.inspectorScroll.SetFlex(1.0);
        var inspector = GUI.VBox.New();
        inspector.SetSpacing(layout_metrics.GAP_GROUP);
        inspector.SetPadding(layout_metrics.PAD_PANE);
        editor.inspectorScroll.AddChild(inspector);
        return inspector;
}
