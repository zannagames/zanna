//
// File: zannastudio/src/ui/scene_property_inspector_2d.zia
// Purpose: Present bounded typed scene-level metadata rows for Studio's 2D
//          scene inspector.
// Key invariants:
//   - This presentation object never mutates SceneDocument or Document state.
//   - Every property is an always-editable row; commit/remove intents latch
//     for SceneEditor2D, which owns validation, mutation, and history.
//   - Rows preserve exact keys and scalar kinds from SceneDocument.
// Ownership/Lifetime: SceneEditor2D owns one inspector; GUI owns its widgets.
// Links: zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/property_rows.zia,
//        docs/adr/0158-scene-level-property-authoring.md
//
//===----------------------------------------------------------------------===//

module scene_property_inspector_2d;

bind "property_rows";

bind GUI = Zanna.GUI;
bind SceneDocument = Zanna.Game2D.SceneDocument;
bind Seq = Zanna.Collections.Seq;
bind Fmt = Zanna.Text.Fmt;

// ============================================================================
// MODULE: scene_property_inspector_2d
// PURPOSE: Keep scene-wide metadata widgets outside the already-large
//          SceneEditor2D document coordinator.
//
// WHERE-THIS-FITS: SceneDocument owns typed property truth. SceneEditor2D owns
//          validation, mutation, dirty state, and canonical history.
//
// TEACHING-NOTE: Widget text is only a draft. Refresh always reconstructs
//          rows from the live runtime scene model.
// ============================================================================

final SCENE_PROPERTY_TYPE_STRING: Integer = 0;
final SCENE_PROPERTY_TYPE_INT: Integer = 1;
final SCENE_PROPERTY_TYPE_FLOAT: Integer = 2;
final SCENE_PROPERTY_TYPE_BOOL: Integer = 3;
final SCENE_PROPERTY_TYPE_NULL: Integer = 4;
final MAX_VISIBLE_SCENE_PROPERTIES: Integer = 512;

/// @brief Presentation-only per-row scene metadata editor for the 2D inspector.
class ScenePropertyInspector2D {
    expose GUI.GroupBox group;
    expose GUI.Label summary;
    expose property_rows.PropertyRows rows;
    expose List[String] keys;
    expose Integer selectedProperty;
    hide Boolean editorEnabled;

    expose func init() {
        group = null;
        summary = null;
        rows = null;
        keys = [];
        selectedProperty = -1;
        editorEnabled = false;
    }

    /// @brief Build the per-row scene-wide property surface.
    expose func Setup(parent: GUI.VBox) {
        group = GUI.GroupBox.New(parent, "Scene properties");
        summary = GUI.Label.New(
            group,
            "Level-wide typed metadata for game adapters and scene settings.");
        summary.SetWordWrap(true);
        rows = new property_rows.PropertyRows();
        rows.Setup(
            group,
            ["String", "Integer", "Float", "Boolean", "Null"],
            "New scene property",
            "scene property");
        SetEnabled(false);
    }

    /// @brief Rebuild bounded rows from canonical runtime state.
    expose func Refresh(scene: SceneDocument, enabled: Boolean) {
        selectedProperty = -1;
        keys = [];
        editorEnabled = enabled and scene != null;
        if scene == null {
            rows.SetRows([], [], []);
            summary.SetText("No valid scene metadata is available.");
            rows.SetEnabled(false);
            return;
        }

        var sceneKeys = scene.Keys();
        var total = Seq.get_Count(sceneKeys);
        var visible = total;
        if visible > MAX_VISIBLE_SCENE_PROPERTIES {
            visible = MAX_VISIBLE_SCENE_PROPERTIES;
        }
        var rowKinds: List[Integer] = [];
        var rowValues: List[String] = [];
        var index = 0;
        while index < visible {
            var key = Seq.GetStr(sceneKeys, index);
            var kind = scene.PropertyKind(key);
            keys.add(key);
            rowKinds.add(KindIndexFor(kind));
            rowValues.add(ValueText(scene, key, kind));
            index = index + 1;
        }
        rows.SetRows(keys, rowKinds, rowValues);

        if total == 0 {
            summary.SetText(
                "No scene properties. Add level-wide metadata for game adapters.");
        } else if total > visible {
            summary.SetText(
                visible + " of " + total + " scene properties shown");
        } else if total == 1 {
            summary.SetText("1 scene property");
        } else {
            summary.SetText(total + " scene properties");
        }
        rows.SetEnabled(editorEnabled);
    }

    /// @brief Poll per-row edges; commit/remove intents latch for the editor.
    expose func Pump(scene: SceneDocument) {
        if scene == null { return; }
        rows.Pump();
    }

    /// @brief Consume the committed row index, or -1.
    expose func TakeCommitRow() -> Integer {
        return rows.TakeCommitRow();
    }

    /// @brief Consume the removed row index, or -1.
    expose func TakeRemoveRow() -> Integer {
        return rows.TakeRemoveRow();
    }

    /// @brief The canonical key one row represented, or empty for a draft.
    expose func CanonicalKeyAt(row: Integer) -> String {
        return rows.CanonicalKeyAt(row);
    }

    /// @brief The row's current key draft.
    expose func KeyTextAt(row: Integer) -> String {
        return rows.KeyTextAt(row);
    }

    /// @brief The row's current scalar-kind token ("string", "int", ...).
    expose func KindTokenAt(row: Integer) -> String {
        var kind = rows.KindIndexAt(row);
        if kind == SCENE_PROPERTY_TYPE_INT { return "int"; }
        if kind == SCENE_PROPERTY_TYPE_FLOAT { return "float"; }
        if kind == SCENE_PROPERTY_TYPE_BOOL { return "bool"; }
        if kind == SCENE_PROPERTY_TYPE_NULL { return "null"; }
        return "string";
    }

    /// @brief The row's current value draft.
    expose func ValueTextAt(row: Integer) -> String {
        return rows.ValueTextAt(row);
    }

    /// @brief Focus one live property row's value by exact key.
    expose func SelectByKey(key: String) {
        var index = RowIndexOf(key);
        if index < 0 { return; }
        var row = rows.rows.get(index);
        row.valueInput.Focus();
    }

    /// @brief Reconcile all controls with scene validity.
    expose func SetEnabled(enabled: Boolean) {
        editorEnabled = enabled;
        if rows == null { return; }
        rows.SetEnabled(enabled);
    }

    /// @brief Resolve a live key to its visible row index, or -1.
    hide func RowIndexOf(key: String) -> Integer {
        var index = 0;
        while index < keys.count() {
            if keys.get(index) == key { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Map a scalar-kind token to its dropdown row.
    hide func KindIndexFor(kind: String) -> Integer {
        if kind == "int" { return SCENE_PROPERTY_TYPE_INT; }
        if kind == "float" { return SCENE_PROPERTY_TYPE_FLOAT; }
        if kind == "bool" { return SCENE_PROPERTY_TYPE_BOOL; }
        if kind == "null" { return SCENE_PROPERTY_TYPE_NULL; }
        return SCENE_PROPERTY_TYPE_STRING;
    }

    /// @brief Format one live scalar value without changing its kind.
    hide func ValueText(scene: SceneDocument,
                        key: String,
                        kind: String) -> String {
        if kind == "string" { return scene.GetStr(key, ""); }
        if kind == "int" { return Fmt.Int(scene.GetInt(key, 0)); }
        if kind == "float" {
            return Fmt.Num(scene.GetFloat(key, 0.0));
        }
        if kind == "bool" { return Fmt.Bool(scene.GetBool(key, false)); }
        return "";
    }
}
