module style_tokens;

/// @brief Default button presentation.
final STYLE_DEFAULT: Integer = 0;

/// @brief Accented primary-action presentation.
final STYLE_PRIMARY: Integer = 1;

/// @brief Quiet secondary-action presentation.
final STYLE_SECONDARY: Integer = 2;
