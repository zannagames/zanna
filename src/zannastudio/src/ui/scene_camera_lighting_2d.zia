//
// File: zannastudio/src/ui/scene_camera_lighting_2d.zia
// Purpose: Labeled live-commit camera/lighting section forms (ADR 0221).
// Key invariants:
//   - Every input is individually labeled; captions never encode field order.
//   - Editing any field commits the complete typed section once on Enter or
//     blur, preserving ADR 0177's blank-means-absent semantics; programmatic
//     Refresh re-baselines drafts without raising edges.
//   - Clear remains an explicit verb; there is no modal Apply.
// Ownership/Lifetime:
//   - SceneEditor2D owns validation, mutation, dirty state, and history.
// Links: zannastudio/src/ui/scene_field_rows.zia,
//        zannastudio/src/ui/scene_editor_2d_game_preview.zia,
//        docs/adr/0221-live-commit-inspector-contract.md
//
//===----------------------------------------------------------------------===//

module scene_camera_lighting_2d;

bind "inspector_rows";
bind "scene_field_rows";

bind GUI = Zanna.GUI;
bind SceneDocument = Zanna.Game2D.SceneDocument;
bind Fmt = Zanna.Text.Fmt;

// ============================================================================
// MODULE: scene_camera_lighting_2d
// PURPOSE: Keep camera/lighting section widgets and draft presentation outside
//          the already-large SceneEditor2D document coordinator.
//
// WHERE-THIS-FITS: SceneDocument owns typed camera/lighting truth (ADR 0177).
//          SceneEditor2D owns validation, mutation, dirty state, and history.
//
// TEACHING-NOTE: A committed field re-authors its complete section, so each
//          gesture is one undoable transaction and blank fields stay absent —
//          identical semantics to the retired Apply button, minus the modal
//          step (ADR 0221).
// ============================================================================

final CAMERA_MODE_UNSET: Integer = 0;
final CAMERA_MODE_FOLLOW: Integer = 1;
final CAMERA_MODE_FIXED: Integer = 2;

/// @brief Presentation-only camera/lighting forms embedded in the inspector.
class SceneCameraLighting2D {
    expose GUI.GroupBox cameraGroup;
    expose GUI.Dropdown cameraModeDropdown;
    expose scene_field_rows.TextField cameraMinXField;
    expose scene_field_rows.TextField cameraMinYField;
    expose scene_field_rows.TextField cameraMaxXField;
    expose scene_field_rows.TextField cameraMaxYField;
    expose scene_field_rows.TextField cameraDeadzoneWidthField;
    expose scene_field_rows.TextField cameraDeadzoneHeightField;
    expose scene_field_rows.TextField cameraLerpField;
    expose scene_field_rows.TextField cameraZoomField;
    expose GUI.Button cameraClearButton;
    expose GUI.GroupBox lightingGroup;
    expose scene_field_rows.TextField lightingDarknessField;
    expose scene_field_rows.TextField lightingTintField;
    expose scene_field_rows.TextField lightingPlayerRadiusField;
    expose scene_field_rows.TextField lightingPlayerColorField;
    expose GUI.Button lightingClearButton;
    hide Boolean controlsEnabled;

    expose func init() {
        cameraGroup = null;
        cameraModeDropdown = null;
        cameraMinXField = new scene_field_rows.TextField();
        cameraMinYField = new scene_field_rows.TextField();
        cameraMaxXField = new scene_field_rows.TextField();
        cameraMaxYField = new scene_field_rows.TextField();
        cameraDeadzoneWidthField = new scene_field_rows.TextField();
        cameraDeadzoneHeightField = new scene_field_rows.TextField();
        cameraLerpField = new scene_field_rows.TextField();
        cameraZoomField = new scene_field_rows.TextField();
        cameraClearButton = null;
        lightingGroup = null;
        lightingDarknessField = new scene_field_rows.TextField();
        lightingTintField = new scene_field_rows.TextField();
        lightingPlayerRadiusField = new scene_field_rows.TextField();
        lightingPlayerColorField = new scene_field_rows.TextField();
        lightingClearButton = null;
        controlsEnabled = false;
    }

    /// @brief Build both bounded section forms with labeled live fields.
    expose func Setup(parent: GUI.VBox) {
        cameraGroup = GUI.GroupBox.New(parent, "Camera");
        var cameraSummary = GUI.Label.New(
            cameraGroup,
            "Scene-global framing for the game camera adapter. Fields "
            + "commit on Enter or blur; a blank field stays absent.");
        cameraSummary.SetWordWrap(true);

        var modeRow = inspector_rows.NewWrapRow();
        cameraGroup.AddChild(modeRow);
        GUI.Label.New(modeRow, "Mode");
        cameraModeDropdown = GUI.Dropdown.New(modeRow);
        cameraModeDropdown.SetAccessibleName("Camera mode");
        cameraModeDropdown.AddItem("Unset");
        cameraModeDropdown.AddItem("Follow");
        cameraModeDropdown.AddItem("Fixed");
        cameraModeDropdown.SetSelected(CAMERA_MODE_UNSET);
        cameraModeDropdown.WasChanged();

        GUI.Label.New(cameraGroup, "Bounds (world px)");
        var boundsRow = scene_field_rows.NewFieldRow(cameraGroup);
        cameraMinXField.Build(
            boundsRow, "Min X", "Camera bounds min X", "—");
        cameraMinYField.Build(
            boundsRow, "Min Y", "Camera bounds min Y", "—");
        cameraMaxXField.Build(
            boundsRow, "Max X", "Camera bounds max X", "—");
        cameraMaxYField.Build(
            boundsRow, "Max Y", "Camera bounds max Y", "—");

        GUI.Label.New(cameraGroup, "Follow tuning");
        var tuningRow = scene_field_rows.NewFieldRow(cameraGroup);
        cameraDeadzoneWidthField.Build(
            tuningRow, "Deadzone W", "Camera deadzone width", "—");
        cameraDeadzoneHeightField.Build(
            tuningRow, "Deadzone H", "Camera deadzone height", "—");
        cameraLerpField.Build(
            tuningRow, "Lerp %", "Camera follow lerp percent", "—");
        cameraZoomField.Build(
            tuningRow, "Zoom %", "Camera zoom percent", "—");

        var cameraActions = inspector_rows.NewWrapRow();
        cameraGroup.AddChild(cameraActions);
        cameraClearButton = GUI.Button.New(cameraActions, "Clear Camera");
        cameraClearButton.SetTooltip(
            "Remove every camera field as one undoable edit");

        lightingGroup = GUI.GroupBox.New(parent, "Lighting");
        var lightingSummary = GUI.Label.New(
            lightingGroup,
            "Scene-global atmosphere for the game lighting adapter. Point "
            + "lights are objects with a light component.");
        lightingSummary.SetWordWrap(true);

        var lightingRow = scene_field_rows.NewFieldRow(lightingGroup);
        lightingDarknessField.Build(
            lightingRow, "Darkness", "Lighting darkness (0-255)", "—");
        lightingTintField.Build(
            lightingRow, "Tint ARGB", "Lighting tint color", "—");
        var lightingPlayerRow = scene_field_rows.NewFieldRow(lightingGroup);
        lightingPlayerRadiusField.Build(
            lightingPlayerRow, "Light px", "Player light radius", "—");
        lightingPlayerColorField.Build(
            lightingPlayerRow, "Light ARGB", "Player light color", "—");

        var lightingActions = inspector_rows.NewWrapRow();
        lightingGroup.AddChild(lightingActions);
        lightingClearButton = GUI.Button.New(lightingActions, "Clear Lighting");
        lightingClearButton.SetTooltip(
            "Remove every lighting field as one undoable edit");

        SetEnabled(false);
    }

    /// @brief Rebuild every draft from canonical typed section state.
    expose func Refresh(scene: SceneDocument, enabled: Boolean) {
        var usable = enabled and scene != null;
        SetEnabled(usable);
        if usable == false {
            cameraModeDropdown.SetSelected(CAMERA_MODE_UNSET);
            cameraModeDropdown.WasChanged();
            ClearDrafts();
            return;
        }
        var mode = scene.CameraGetStr("mode", "");
        if mode == "follow" {
            cameraModeDropdown.SetSelected(CAMERA_MODE_FOLLOW);
        } else if mode == "fixed" {
            cameraModeDropdown.SetSelected(CAMERA_MODE_FIXED);
        } else {
            cameraModeDropdown.SetSelected(CAMERA_MODE_UNSET);
        }
        cameraModeDropdown.WasChanged();
        SetDraft(cameraMinXField, scene, "camera", "minX");
        SetDraft(cameraMinYField, scene, "camera", "minY");
        SetDraft(cameraMaxXField, scene, "camera", "maxX");
        SetDraft(cameraMaxYField, scene, "camera", "maxY");
        SetDraft(cameraDeadzoneWidthField, scene, "camera", "deadzoneWidth");
        SetDraft(cameraDeadzoneHeightField, scene, "camera", "deadzoneHeight");
        SetDraft(cameraLerpField, scene, "camera", "followLerpPct");
        SetDraft(cameraZoomField, scene, "camera", "zoomPct");
        SetDraft(lightingDarknessField, scene, "lighting", "darkness");
        SetDraft(lightingTintField, scene, "lighting", "tint");
        SetDraft(
            lightingPlayerRadiusField, scene, "lighting", "playerLightRadius");
        SetDraft(
            lightingPlayerColorField, scene, "lighting", "playerLightColor");
    }

    /// @brief Consume one live camera edit (any field or the mode).
    expose func TakeCameraEditCommitted() -> Boolean {
        if controlsEnabled == false { return false; }
        var committed = cameraModeDropdown.WasChanged();
        if cameraMinXField.TakeCommit() { committed = true; }
        if cameraMinYField.TakeCommit() { committed = true; }
        if cameraMaxXField.TakeCommit() { committed = true; }
        if cameraMaxYField.TakeCommit() { committed = true; }
        if cameraDeadzoneWidthField.TakeCommit() { committed = true; }
        if cameraDeadzoneHeightField.TakeCommit() { committed = true; }
        if cameraLerpField.TakeCommit() { committed = true; }
        if cameraZoomField.TakeCommit() { committed = true; }
        return committed;
    }

    /// @brief Consume one live lighting edit (any field).
    expose func TakeLightingEditCommitted() -> Boolean {
        if controlsEnabled == false { return false; }
        var committed = lightingDarknessField.TakeCommit();
        if lightingTintField.TakeCommit() { committed = true; }
        if lightingPlayerRadiusField.TakeCommit() { committed = true; }
        if lightingPlayerColorField.TakeCommit() { committed = true; }
        return committed;
    }

    /// @brief Consume the camera Clear intent.
    expose func TakeCameraClearRequested() -> Boolean {
        return cameraClearButton.WasClicked();
    }

    /// @brief Consume the lighting Clear intent.
    expose func TakeLightingClearRequested() -> Boolean {
        return lightingClearButton.WasClicked();
    }

    /// @brief Return the drafted camera mode token: "", "follow", or "fixed".
    expose func DraftCameraMode() -> String {
        if cameraModeDropdown.Selected == CAMERA_MODE_FOLLOW {
            return "follow";
        }
        if cameraModeDropdown.Selected == CAMERA_MODE_FIXED { return "fixed"; }
        return "";
    }

    /// @brief Reconcile all controls with scene validity.
    expose func SetEnabled(enabled: Boolean) {
        if cameraGroup == null { return; }
        controlsEnabled = enabled;
        cameraModeDropdown.SetEnabled(enabled);
        cameraMinXField.SetEnabled(enabled);
        cameraMinYField.SetEnabled(enabled);
        cameraMaxXField.SetEnabled(enabled);
        cameraMaxYField.SetEnabled(enabled);
        cameraDeadzoneWidthField.SetEnabled(enabled);
        cameraDeadzoneHeightField.SetEnabled(enabled);
        cameraLerpField.SetEnabled(enabled);
        cameraZoomField.SetEnabled(enabled);
        cameraClearButton.SetEnabled(enabled);
        lightingDarknessField.SetEnabled(enabled);
        lightingTintField.SetEnabled(enabled);
        lightingPlayerRadiusField.SetEnabled(enabled);
        lightingPlayerColorField.SetEnabled(enabled);
        lightingClearButton.SetEnabled(enabled);
    }

    /// @brief Load one integer field draft, or blank when absent.
    hide func SetDraft(field: scene_field_rows.TextField,
                       scene: SceneDocument,
                       section: String,
                       key: String) {
        var kind = "";
        if section == "camera" {
            kind = scene.CameraFieldKind(key);
            if kind == "int" {
                field.SetCanonical(Fmt.Int(scene.CameraGetInt(key, 0)));
                return;
            }
        } else {
            kind = scene.LightingFieldKind(key);
            if kind == "int" {
                field.SetCanonical(Fmt.Int(scene.LightingGetInt(key, 0)));
                return;
            }
        }
        field.SetCanonical("");
    }

    /// @brief Blank every draft and its canonical baseline.
    hide func ClearDrafts() {
        cameraMinXField.SetCanonical("");
        cameraMinYField.SetCanonical("");
        cameraMaxXField.SetCanonical("");
        cameraMaxYField.SetCanonical("");
        cameraDeadzoneWidthField.SetCanonical("");
        cameraDeadzoneHeightField.SetCanonical("");
        cameraLerpField.SetCanonical("");
        cameraZoomField.SetCanonical("");
        lightingDarknessField.SetCanonical("");
        lightingTintField.SetCanonical("");
        lightingPlayerRadiusField.SetCanonical("");
        lightingPlayerColorField.SetCanonical("");
    }
}
