bind Camera3D = Zanna.Graphics3D.Camera3D;
bind PostFX3D = Zanna.Graphics3D.PostFX3D;
bind LightBaker3D = Zanna.Graphics3D.LightBaker3D;
bind LightProbeGrid3D = Zanna.Graphics3D.LightProbeGrid3D;
