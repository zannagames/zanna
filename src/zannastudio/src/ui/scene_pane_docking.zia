//
// File: zannastudio/src/ui/scene_pane_docking.zia
// Purpose: Float scene panes into the dock substrate's FloatingPanel and
//          dock them back (Phase 5), preserving widget identity throughout.
// Key invariants:
//   - Floating reparents the pane's single content container; every child
//     widget keeps its identity, so editor pumps and probes stay valid.
//   - The fixed split layout remains the default; floating is opt-in and
//     reversible, and the split cell collapses while its pane is away.
//   - This module never touches canonical scene bytes, history, or
//     revision — pane placement is pure workspace presentation.
// Ownership/Lifetime:
//   - The owning editor holds the PaneDock; the FloatingPanel is created
//     once on first float and reused; content is owned by whichever host
//     currently displays it.
// Links: zannastudio/src/ui/scene_panels_2d.zia,
//        zannastudio/src/ui/scene_panels_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_pane_docking;

// ============================================================================
// MODULE: scene_pane_docking
// PURPOSE: One reusable float/dock mechanism for the scene editors' panes,
//          built on the same FloatingPanel surface the IDE's floating tool
//          group uses.
//
// WHERE-THIS-FITS: Full membership in the eight-panel dock tab model is a
//          separate program; this delivers the dock substrate's floating
//          half for per-scene-document panes with the fixed layout as the
//          default preset.
//
// TEACHING-NOTE: Widgets reparent with RemoveChild + AddChild; the split
//          cell collapses while its content floats so the layout never
//          shows an empty pane.
// ============================================================================

bind GUI = Zanna.GUI;

final DEFAULT_FLOAT_WIDTH: Number = 320.0;
final DEFAULT_FLOAT_HEIGHT: Number = 460.0;

/// @brief Float/dock state for one scene pane.
class PaneDock {
    expose Boolean floating;
    expose GUI.FloatingPanel panel;
    expose GUI.Button floatButton;
    expose GUI.Button dockButton;
    hide GUI.App app;
    hide GUI.Widget dockedHost;
    hide GUI.Widget content;
    hide GUI.SplitPane split;
    hide Integer collapseSide;
    hide Number splitRestorePosition;
    hide String title;

    expose func init() {
        floating = false;
        panel = null;
        floatButton = null;
        dockButton = null;
        app = null;
        dockedHost = null;
        content = null;
        split = null;
        collapseSide = 1;
        splitRestorePosition = 0.22;
        title = "";
    }

    /// @brief Bind one pane: its docked host cell, content, and split.
    /// @details Adds a small "Float" button into @p buttonRow; the caller
    ///          pumps this dock each frame. @p splitPane may be null for
    ///          panes whose hosts do not collapse.
    expose func Setup(nextApp: GUI.App,
                      host: GUI.Widget,
                      paneContent: GUI.Widget,
                      splitPane: GUI.SplitPane,
                      side: Integer,
                      restorePosition: Number,
                      paneTitle: String,
                      buttonRow: GUI.Widget) {
        app = nextApp;
        dockedHost = host;
        content = paneContent;
        split = splitPane;
        collapseSide = side;
        splitRestorePosition = restorePosition;
        title = paneTitle;
        floatButton = GUI.Button.New(buttonRow, "Float");
        floatButton.SetTooltip(
            "Move the " + paneTitle + " pane into a floating window; "
            + "Dock returns it (workspace-only)");
    }

    /// @brief Move the pane content into its floating panel.
    expose func Float() -> Boolean {
        if floating or content == null or dockedHost == null {
            return false;
        }
        if panel == null {
            panel = GUI.FloatingPanel.New(app);
            panel.SetSize(DEFAULT_FLOAT_WIDTH, DEFAULT_FLOAT_HEIGHT);
            panel.CenterInParent();
            var chrome = GUI.HBox.New();
            chrome.SetSpacing(4.0);
            panel.AddChild(chrome);
            GUI.Label.New(chrome, title);
            dockButton = GUI.Button.New(chrome, "Dock");
            dockButton.SetTooltip(
                "Return the " + title + " pane to its fixed layout slot");
        }
        if dockedHost.RemoveChild(content) == false { return false; }
        panel.AddChild(content);
        panel.SetVisible(true);
        if split != null {
            if collapseSide == 2 { split.CollapseSecond(); }
            else { split.CollapseFirst(); }
        }
        floating = true;
        return true;
    }

    /// @brief Return the pane content to its fixed layout cell.
    expose func Dock() -> Boolean {
        if floating == false or panel == null { return false; }
        if panel.RemoveChild(content) == false { return false; }
        dockedHost.AddChild(content);
        panel.SetVisible(false);
        if split != null {
            split.Restore();
            split.SetPosition(splitRestorePosition);
        }
        floating = false;
        return true;
    }

    /// @brief Route the float/dock button edges; true when state changed.
    expose func Pump() -> Boolean {
        if floatButton != null and floatButton.WasClicked() {
            return Float();
        }
        if dockButton != null and dockButton.WasClicked() {
            return Dock();
        }
        return false;
    }
}
