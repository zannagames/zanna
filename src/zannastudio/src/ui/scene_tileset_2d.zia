//
// File: zannastudio/src/ui/scene_tileset_2d.zia
// Purpose: Bounded tileset/background loading, palette rendering, and canvas
//          blitting for Studio's editable 2D scene surface.
// Key invariants:
//   - Authored relative paths resolve beside the saved scene document.
//   - Image source, decoded-pixel, palette, scaled-tile, and scene-background
//     caches are bounded.
//   - Translucent frames composite source-over; opaque frames use a fast copy.
//   - Zero-rotation sprite fast paths use an epsilon-safe degree comparison.
//   - Invalid or missing assets produce ordinary inline state, never traps.
//   - Tile IDs remain SceneDocument's one-based tileset frame indexes.
// Ownership/Lifetime: SceneEditor2D owns one library; entries own decoded
//                     Pixels handles until the scene or layer assets change.
// Links: zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/probes/scene_editor_2d_probe.zia,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md,
//        docs/zannalib/game/scene.md
//
//===----------------------------------------------------------------------===//

module scene_tileset_2d;

bind "../services/safe_io";

bind SceneDocument = Zanna.Game2D.SceneDocument;
bind Pixels = Zanna.Graphics.Pixels;
bind Color = Zanna.Graphics.Color;
bind Map = Zanna.Collections.Map;
bind Path = Zanna.IO.Path;
bind Str = Zanna.String;
bind Clock = Zanna.Time.Clock;
bind Math = Zanna.Math;
bind Convert = Zanna.Core.Convert;

// ============================================================================
// MODULE: scene_tileset_2d
// PURPOSE: Turn SceneDocument layer asset references into bounded visual
//          previews without adding filesystem or cache policy to SceneEditor2D.
//
// WHERE-THIS-FITS: SceneDocument remains the canonical model and stores only
//          paths/tile IDs. SceneEditor2D owns widgets, history, and selection.
//
// TEACHING-NOTE: A layer image is an external editor preview dependency, not
//          embedded scene data. Loading failure must therefore leave the
//          authored JSON untouched and render a deterministic fallback.
// ============================================================================

final MAX_TILESET_SOURCE_BYTES: Integer = 16000000;
final MAX_TILESET_SOURCE_PIXELS: Integer = 4194304;
final MAX_SCENE_TILESET_PIXELS: Integer = 8388608;
final MAX_SCALED_CACHE_PIXELS: Integer = 8388608;
final MAX_PALETTE_TILES: Integer = 512;
final MAX_SPRITE_ENTRIES: Integer = 64;
final MAX_TRANSFORMED_SPRITE_AXIS: Integer = 4096;
final MAX_BACKGROUND_SCALED_AXIS: Integer = 4096;
final MAX_BACKGROUND_SCALED_PIXELS: Integer = 8388608;
final ROTATION_ZERO_EPSILON_DEGREES: Number = 0.000001;
final TINT_NONE_2D: Integer = 4294967295;
final PALETTE_COLUMNS: Integer = 8;
final PALETTE_TILE_SIZE: Integer = 28;
final PALETTE_STRIDE: Integer = 30;

/// @brief Whether a degree rotation is visually indistinguishable from zero.
func RotationIsEffectivelyZero(rotation: Number) -> Boolean {
    return rotation > 0.0 - ROTATION_ZERO_EPSILON_DEGREES
        and rotation < ROTATION_ZERO_EPSILON_DEGREES;
}

/// @brief One decoded layer tileset plus truthful load metadata.
class TilesetEntry2D {
    expose String authoredPath;
    expose String resolvedPath;
    expose Pixels pixels;
    expose Integer width;
    expose Integer height;
    expose Integer tileWidth;
    expose Integer tileHeight;
    expose Integer columns;
    expose Integer rows;
    expose Integer tileCount;
    expose Integer sourceBytes;
    expose Integer sourceModified;
    expose String error;
    expose String warning;

    expose func init() {
        authoredPath = "";
        resolvedPath = "";
        pixels = null;
        width = 0;
        height = 0;
        tileWidth = 0;
        tileHeight = 0;
        columns = 0;
        rows = 0;
        tileCount = 0;
        sourceBytes = -1;
        sourceModified = -1;
        error = "";
        warning = "";
    }
}

/// @brief One scaled frame plus the compositing decision cached with it.
class ScaledTile2D {
    expose Pixels pixels;
    expose Boolean hasTransparency;

    expose func init() {
        pixels = null;
        hasTransparency = false;
    }
}

/// @brief Resolve one authored path without changing the persisted spelling.
expose func ResolveAssetPath(authoredPath: String,
                             documentPath: String) -> String {
    var clean = Str.Trim(authoredPath);
    if clean == "" { return ""; }
    try {
        if Path.IsAbsolute(clean) {
            return Path.Normalize(clean);
        }
        if Str.Trim(documentPath) != "" {
            return Path.Normalize(
                Path.Join(Path.Directory(documentPath), clean));
        }
        return Path.Normalize(Path.Absolute(clean));
    } catch {
        return "";
    }
    return "";
}

/// @brief Convert a palette-local point to a one-based tile ID.
/// @return Zero when the point is outside the bounded visible palette.
expose func PaletteTileAt(tileCount: Integer,
                          x: Integer,
                          y: Integer) -> Integer {
    if tileCount <= 0 or x < 0 or y < 0 { return 0; }
    var column = x / PALETTE_STRIDE;
    var row = y / PALETTE_STRIDE;
    if column < 0 or column >= PALETTE_COLUMNS { return 0; }
    var tile = row * PALETTE_COLUMNS + column + 1;
    var shown = tileCount;
    if shown > MAX_PALETTE_TILES { shown = MAX_PALETTE_TILES; }
    if tile < 1 or tile > shown { return 0; }
    return tile;
}

/// @brief Decoded asset library and bounded scaled-tile cache for one scene.
class SceneTilesetLibrary2D {
    expose List[TilesetEntry2D] entries;
    expose String documentPath;
    expose Integer sourcePixelCount;
    expose Integer revision;
    expose Boolean cacheSaturated;
    hide Map scaledTileCache;
    hide Integer cacheCellSize;
    hide Integer cachedPixelCount;
    hide Integer lastExternalPollMs;
    hide Integer externalPollLayer;
    hide List[String] spritePaths;
    hide List[TilesetEntry2D] spriteEntries;
    hide Integer spriteTileWidth;
    hide Integer spriteTileHeight;
    hide TilesetEntry2D backgroundEntry;
    hide String backgroundReferencePath;
    hide Pixels scaledBackground;
    hide String scaledBackgroundFit;
    hide Integer scaledBackgroundViewportWidth;
    hide Integer scaledBackgroundViewportHeight;
    hide Integer scaledBackgroundX;
    hide Integer scaledBackgroundY;
    hide Boolean scaledBackgroundHasTransparency;

    expose func init() {
        entries = [];
        documentPath = "";
        sourcePixelCount = 0;
        revision = 0;
        cacheSaturated = false;
        scaledTileCache = Map.New();
        cacheCellSize = 0;
        cachedPixelCount = 0;
        lastExternalPollMs = -1;
        externalPollLayer = 0;
        spritePaths = [];
        spriteEntries = [];
        spriteTileWidth = 0;
        spriteTileHeight = 0;
        backgroundEntry = null;
        backgroundReferencePath = "";
        scaledBackground = null;
        scaledBackgroundFit = "";
        scaledBackgroundViewportWidth = 0;
        scaledBackgroundViewportHeight = 0;
        scaledBackgroundX = 0;
        scaledBackgroundY = 0;
        scaledBackgroundHasTransparency = false;
    }

    /// @brief Rebuild every layer preview from the current canonical scene.
    expose func Reload(scene: SceneDocument, nextDocumentPath: String) {
        ClearSceneBackground();
        entries = [];
        documentPath = nextDocumentPath;
        sourcePixelCount = 0;
        revision = revision + 1;
        ClearScaledCache();
        lastExternalPollMs = Clock.NowMs();
        externalPollLayer = 0;
        spritePaths = [];
        spriteEntries = [];
        spriteTileWidth = 0;
        spriteTileHeight = 0;
        if scene == null { return; }
        spriteTileWidth = scene.TileWidth;
        spriteTileHeight = scene.TileHeight;

        var layer = 0;
        while layer < scene.LayerCount() {
            var entry = DecodeEntry(
                scene.LayerAsset(layer),
                nextDocumentPath,
                scene.TileWidth,
                scene.TileHeight);
            if entry.pixels != null {
                var pixelCount = entry.width * entry.height;
                if sourcePixelCount + pixelCount
                   > MAX_SCENE_TILESET_PIXELS {
                    entry.pixels = null;
                    entry.columns = 0;
                    entry.rows = 0;
                    entry.tileCount = 0;
                    entry.error =
                        "Scene tileset previews exceed the 32 MB decoded limit.";
                } else {
                    sourcePixelCount = sourcePixelCount + pixelCount;
                }
            }
            entries.add(entry);
            layer = layer + 1;
        }
    }

    /// @brief Check one referenced image for an external metadata change.
    /// @details At most one filesystem entry is statted per eligible call.
    ///          The caller owns reloading because this check never mutates the
    ///          decoded library or authored scene state.
    expose func PollExternalChanges(intervalMs: Integer) -> Boolean {
        var interval = intervalMs;
        if interval < 0 { interval = 0; }
        var now = Clock.NowMs();
        if lastExternalPollMs >= 0
           and now - lastExternalPollMs < interval {
            return false;
        }
        lastExternalPollMs = now;
        var backgroundCount = 0;
        if backgroundEntry != null
           and backgroundEntry.authoredPath != "" {
            backgroundCount = 1;
        }
        var total =
            entries.count() + spriteEntries.count() + backgroundCount;
        if total == 0 { return false; }

        var visited = 0;
        while visited < total {
            if externalPollLayer >= total {
                externalPollLayer = 0;
            }
            var entry: TilesetEntry2D = null;
            if externalPollLayer < entries.count() {
                entry = entries.get(externalPollLayer);
            } else if externalPollLayer
                      < entries.count() + spriteEntries.count() {
                entry = spriteEntries.get(
                    externalPollLayer - entries.count());
            } else {
                entry = backgroundEntry;
            }
            externalPollLayer = externalPollLayer + 1;
            visited = visited + 1;
            if entry != null and entry.authoredPath != "" {
                return safe_io.SizeBytes(entry.resolvedPath)
                           != entry.sourceBytes
                    or safe_io.Modified(entry.resolvedPath)
                           != entry.sourceModified;
            }
        }
        return false;
    }

    /// @brief Decode a candidate without changing the loaded scene library.
    expose func ValidateCandidate(authoredPath: String,
                                  nextDocumentPath: String,
                                  tileWidth: Integer,
                                  tileHeight: Integer) -> TilesetEntry2D {
        return DecodeEntry(
            authoredPath, nextDocumentPath, tileWidth, tileHeight);
    }

    /// @brief Validate a replacement against the scene-wide decoded budget.
    expose func ValidateCandidateForLayer(
        layer: Integer,
        authoredPath: String,
        nextDocumentPath: String,
        tileWidth: Integer,
        tileHeight: Integer) -> TilesetEntry2D {
        var candidate = ValidateCandidate(
            authoredPath, nextDocumentPath, tileWidth, tileHeight);
        if candidate.pixels == null { return candidate; }
        var retainedPixels = sourcePixelCount;
        var current = Entry(layer);
        if current != null and current.pixels != null {
            retainedPixels =
                retainedPixels - current.width * current.height;
        }
        if retainedPixels + candidate.width * candidate.height
           > MAX_SCENE_TILESET_PIXELS {
            candidate.pixels = null;
            candidate.columns = 0;
            candidate.rows = 0;
            candidate.tileCount = 0;
            candidate.error =
                "Scene tileset previews exceed the 32 MB decoded limit.";
        }
        return candidate;
    }

    /// @brief Return one layer entry, or null when the layer is invalid.
    expose func Entry(layer: Integer) -> TilesetEntry2D {
        if layer < 0 or layer >= entries.count() { return null; }
        return entries.get(layer);
    }

    /// @brief Return the number of usable one-based frames for one layer.
    expose func TileCount(layer: Integer) -> Integer {
        var entry = Entry(layer);
        if entry == null { return 0; }
        return entry.tileCount;
    }

    /// @brief Return a compact, truthful inspector summary for one layer.
    expose func Status(layer: Integer) -> String {
        var entry = Entry(layer);
        if entry == null or entry.authoredPath == "" {
            return "No tileset image. Choose one to preview and paint visually.";
        }
        if entry.error != "" { return entry.error; }
        var status = Path.Name(entry.resolvedPath)
            + "  •  " + entry.width + "x" + entry.height
            + "  •  " + entry.tileCount + " tiles ("
            + entry.columns + "x" + entry.rows + ")";
        if entry.tileCount > MAX_PALETTE_TILES {
            status = status + "  •  showing first " + MAX_PALETTE_TILES;
        }
        if entry.warning != "" { status = status + "\n" + entry.warning; }
        return status;
    }

    /// @brief Render a scrollable, bounded palette for one layer.
    expose func RenderPalette(layer: Integer,
                              selectedTile: Integer) -> Pixels {
        return RenderPaletteMarked(layer, selectedTile, []);
    }

    /// @brief Render the bounded palette with behavior badges on marked tiles.
    /// @details Marked tile ids receive a small corner badge so authored
    ///          collision/data/animation/autotile rules are visible at a
    ///          glance (ADR 0176). Marks never affect hit testing.
    expose func RenderPaletteMarked(layer: Integer,
                                    selectedTile: Integer,
                                    marked: List[Integer]) -> Pixels {
        var entry = Entry(layer);
        if entry == null or entry.pixels == null or entry.tileCount <= 0 {
            return null;
        }
        var shown = entry.tileCount;
        if shown > MAX_PALETTE_TILES { shown = MAX_PALETTE_TILES; }
        var rowCount = (shown + PALETTE_COLUMNS - 1) / PALETTE_COLUMNS;
        var width = PALETTE_COLUMNS * PALETTE_STRIDE;
        var height = rowCount * PALETTE_STRIDE;
        var palette = Pixels.New(width, height);
        if palette == null { return null; }
        palette.FillColor(Color.RGB(29, 34, 43));

        var tile = 1;
        while tile <= shown {
            var index = tile - 1;
            var column = index % PALETTE_COLUMNS;
            var row = index / PALETTE_COLUMNS;
            var x = column * PALETTE_STRIDE;
            var y = row * PALETTE_STRIDE;
            palette.DrawFrame(
                x, y, PALETTE_STRIDE, PALETTE_STRIDE,
                Color.RGB(68, 76, 90));
            if DrawTile(
                   palette, layer, tile, x + 1, y + 1,
                   PALETTE_TILE_SIZE) == false {
                palette.DrawBox(
                    x + 2, y + 2,
                    PALETTE_TILE_SIZE - 2, PALETTE_TILE_SIZE - 2,
                    Color.RGB(87, 58, 92));
            }
            if TileIsMarked(marked, tile) {
                palette.DrawBox(
                    x + PALETTE_STRIDE - 8, y + 2, 6, 6,
                    Color.RGB(255, 190, 72));
            }
            if tile == selectedTile {
                palette.DrawFrame(
                    x, y, PALETTE_STRIDE, PALETTE_STRIDE,
                    Color.RGB(104, 220, 255));
                palette.DrawFrame(
                    x + 1, y + 1,
                    PALETTE_STRIDE - 2, PALETTE_STRIDE - 2,
                    Color.RGB(255, 255, 255));
            }
            tile = tile + 1;
        }
        return palette;
    }

    /// @brief Return whether one tile id appears in the bounded marked list.
    hide func TileIsMarked(marked: List[Integer], tile: Integer) -> Boolean {
        var index = 0;
        while index < marked.count() {
            if marked.get(index) == tile { return true; }
            index = index + 1;
        }
        return false;
    }

    /// @brief Composite one project-owned screen-space scene backdrop.
    /// @details The image resolves beside `referencePath`, normally the
    ///          project's scene-components.json. Scaling is cached per image,
    ///          fit mode, and visible render-window size. Failure leaves the
    ///          caller's existing opaque editor clear color untouched.
    expose func DrawSceneBackground(destination: Pixels,
                                    authoredPath: String,
                                    referencePath: String,
                                    fit: String) -> Boolean {
        if destination == null or destination.Width <= 0
           or destination.Height <= 0 {
            return false;
        }
        var entry = EnsureSceneBackground(
            authoredPath, referencePath);
        if entry == null or entry.pixels == null
           or entry.width <= 0 or entry.height <= 0 {
            return false;
        }
        var mode = Str.ToLower(Str.Trim(fit));
        if mode != "contain" and mode != "stretch" {
            mode = "cover";
        }
        var viewportWidth = destination.Width;
        var viewportHeight = destination.Height;
        if scaledBackground == null
           or scaledBackgroundFit != mode
           or scaledBackgroundViewportWidth != viewportWidth
           or scaledBackgroundViewportHeight != viewportHeight {
            if ScaleSceneBackground(
                   entry, mode, viewportWidth, viewportHeight) == false {
                return false;
            }
        }
        if scaledBackground == null { return false; }

        var sourceX = 0;
        var sourceY = 0;
        var destinationX = scaledBackgroundX;
        var destinationY = scaledBackgroundY;
        var width = scaledBackground.Width;
        var height = scaledBackground.Height;
        if destinationX < 0 {
            sourceX = 0 - destinationX;
            width = width - sourceX;
            destinationX = 0;
        }
        if destinationY < 0 {
            sourceY = 0 - destinationY;
            height = height - sourceY;
            destinationY = 0;
        }
        if destinationX + width > viewportWidth {
            width = viewportWidth - destinationX;
        }
        if destinationY + height > viewportHeight {
            height = viewportHeight - destinationY;
        }
        if width <= 0 or height <= 0 { return false; }
        if scaledBackgroundHasTransparency {
            CompositeImageRegion(
                destination, scaledBackground,
                destinationX, destinationY,
                sourceX, sourceY, width, height);
        } else {
            destination.Copy(
                destinationX, destinationY,
                scaledBackground, sourceX, sourceY, width, height);
        }
        return true;
    }

    /// @brief Drop one decoded/scaled project scene background.
    expose func ClearSceneBackground() {
        if backgroundEntry != null and backgroundEntry.pixels != null {
            sourcePixelCount = sourcePixelCount
                - backgroundEntry.width * backgroundEntry.height;
            if sourcePixelCount < 0 { sourcePixelCount = 0; }
        }
        backgroundEntry = null;
        backgroundReferencePath = "";
        ClearScaledSceneBackground();
    }

    /// @brief Blit one tileset frame into a square editor-preview cell.
    /// @return False for missing assets, invalid IDs, or exhausted cache budget.
    expose func DrawTile(destination: Pixels,
                         layer: Integer,
                         tileId: Integer,
                         x: Integer,
                         y: Integer,
                         cellSize: Integer) -> Boolean {
        return DrawEntryFrame(
            destination, Entry(layer), layer + ":", tileId, x, y, cellSize);
    }

    /// @brief Blit one layer tile with a layer opacity multiply (ADR 0195).
    /// @details Full opacity routes through the cached fast path; anything
    ///          less composites per pixel with the alpha scaled.
    expose func DrawTileWithOpacity(destination: Pixels,
                                    layer: Integer,
                                    tileId: Integer,
                                    x: Integer,
                                    y: Integer,
                                    cellSize: Integer,
                                    opacity: Number) -> Boolean {
        if opacity >= 0.999 {
            return DrawTile(destination, layer, tileId, x, y, cellSize);
        }
        if opacity <= 0.001 { return true; }
        var entry = Entry(layer);
        if destination == null or entry == null or entry.pixels == null
           or cellSize <= 0 or tileId <= 0 or tileId > entry.tileCount {
            return false;
        }
        if cacheCellSize != cellSize {
            ClearScaledCache();
            cacheCellSize = cellSize;
        }
        var cached = ResolveScaledTile(
            entry, layer + ":", tileId, cellSize);
        if cached == null or cached.pixels == null { return false; }
        var alphaScale = Convert.NumToInt(opacity * 256.0);
        var row = 0;
        while row < cellSize {
            var column = 0;
            while column < cellSize {
                var rgba = cached.pixels.GetRgba(column, row);
                var alpha = rgba % 256 * alphaScale / 256;
                if alpha > 0 {
                    destination.BlendPixel(
                        x + column, y + row, rgba / 256, alpha);
                }
                column = column + 1;
            }
            row = row + 1;
        }
        return true;
    }

    /// @brief Blit one frame of a cached object-sprite image (ADR 0179).
    /// @details `frame` is zero-based and addresses the image on the scene's
    ///          tile grid, exactly like layer-atlas frames. Sprite images share
    ///          the layer-preview decode and scaled-cache budgets, so a
    ///          sprite-heavy scene degrades to markers deterministically.
    expose func DrawSpriteFrame(destination: Pixels,
                                authoredPath: String,
                                frame: Integer,
                                x: Integer,
                                y: Integer,
                                cellSize: Integer) -> Boolean {
        var index = SpriteEntryIndex(authoredPath);
        if index < 0 { return false; }
        return DrawEntryFrame(
            destination,
            spriteEntries.get(index),
            "s" + index + ":",
            frame + 1,
            x,
            y,
            cellSize);
    }

    /// @brief Draw one sprite frame with the full ADR 0192 object transform.
    /// @details The frame renders at its native size scaled by the display
    ///          zoom (cellSize over the authored tile size) and the object
    ///          scale, mirrored, tinted, and rotated about the normalized
    ///          pivot; the untransformed footprint's top-left stays at the
    ///          anchor so legacy defaults draw exactly like DrawSpriteFrame's
    ///          one-cell placement never did — at true frame size.
    ///          Transformed frames are composed per draw (no scaled-cache
    ///          entry); the canvas re-renders only when marked dirty.
    /// @return True when the frame was drawn.
    expose func DrawSpriteFrameTransformed(destination: Pixels,
                                           authoredPath: String,
                                           frame: Integer,
                                           anchorX: Integer,
                                           anchorY: Integer,
                                           cellSize: Integer,
                                           tileWidth: Integer,
                                           tileHeight: Integer,
                                           scaleX: Number,
                                           scaleY: Number,
                                           rotation: Number,
                                           flipX: Boolean,
                                           flipY: Boolean,
                                           tint: Integer,
                                           pivotX: Number,
                                           pivotY: Number) -> Boolean {
        if destination == null or cellSize <= 0
           or tileWidth <= 0 or tileHeight <= 0 {
            return false;
        }
        var index = SpriteEntryIndex(authoredPath);
        if index < 0 { return false; }
        var entry = spriteEntries.get(index);
        if entry == null or entry.pixels == null { return false; }
        var tileId = frame + 1;
        if tileId <= 0 or tileId > entry.tileCount { return false; }
        var baseWidth =
            entry.tileWidth * cellSize * 1.0 / tileWidth;
        var baseHeight =
            entry.tileHeight * cellSize * 1.0 / tileHeight;
        var magnitudeX = scaleX;
        if magnitudeX < 0.0 { magnitudeX = 0.0 - magnitudeX; }
        var magnitudeY = scaleY;
        if magnitudeY < 0.0 { magnitudeY = 0.0 - magnitudeY; }
        var scaledWidth = Convert.NumToInt(
            baseWidth * magnitudeX + 0.5);
        var scaledHeight = Convert.NumToInt(
            baseHeight * magnitudeY + 0.5);
        if scaledWidth <= 0 or scaledHeight <= 0
           or scaledWidth > MAX_TRANSFORMED_SPRITE_AXIS
           or scaledHeight > MAX_TRANSFORMED_SPRITE_AXIS {
            return false;
        }
        // Negative scale mirrors; an explicit flip mirrors again.
        var mirrorX = flipX;
        if scaleX < 0.0 { mirrorX = mirrorX == false; }
        var mirrorY = flipY;
        if scaleY < 0.0 { mirrorY = mirrorY == false; }
        var working = ComposeSpriteStages(
            entry, tileId, scaledWidth, scaledHeight,
            mirrorX, mirrorY, tint);
        if working == null { return false; }

        // The pivot stays fixed through scaling: the scaled top-left is
        // the anchor plus the pivot's base offset minus its scaled one.
        var pivotCanvasX = anchorX + baseWidth * pivotX;
        var pivotCanvasY = anchorY + baseHeight * pivotY;
        if RotationIsEffectivelyZero(rotation) {
            CompositeRect(
                destination, working,
                Convert.NumToInt(pivotCanvasX - scaledWidth * pivotX),
                Convert.NumToInt(pivotCanvasY - scaledHeight * pivotY),
                scaledWidth, scaledHeight);
            return true;
        }

        // Rotation happens about the image center; re-anchor so the
        // pivot point stays fixed on the canvas.
        var rotated = RotateSprite(working, rotation);
        if rotated == null { return false; }
        var rotatedWidth = rotated.Width;
        var rotatedHeight = rotated.Height;
        var centerOffsetX = scaledWidth * 0.5 - scaledWidth * pivotX;
        var centerOffsetY = scaledHeight * 0.5 - scaledHeight * pivotY;
        var radians = rotation * 3.14159265358979323846 / 180.0;
        var cosine = Math.Cos(radians);
        var sine = Math.Sin(radians);
        var rotatedOffsetX =
            centerOffsetX * cosine - centerOffsetY * sine;
        var rotatedOffsetY =
            centerOffsetX * sine + centerOffsetY * cosine;
        CompositeRect(
            destination, rotated,
            Convert.NumToInt(
                pivotCanvasX + rotatedOffsetX - rotatedWidth * 0.5),
            Convert.NumToInt(
                pivotCanvasY + rotatedOffsetY - rotatedHeight * 0.5),
            rotatedWidth, rotatedHeight);
        return true;
    }

    /// @brief Return one sprite's native frame width, or 0 when unloadable.
    expose func SpriteNativeWidth(authoredPath: String) -> Integer {
        var index = SpriteEntryIndex(authoredPath);
        if index < 0 { return 0; }
        var entry = spriteEntries.get(index);
        if entry == null or entry.pixels == null { return 0; }
        return entry.tileWidth;
    }

    /// @brief Return one sprite's native frame height, or 0 when unloadable.
    expose func SpriteNativeHeight(authoredPath: String) -> Integer {
        var index = SpriteEntryIndex(authoredPath);
        if index < 0 { return 0; }
        var entry = spriteEntries.get(index);
        if entry == null or entry.pixels == null { return 0; }
        return entry.tileHeight;
    }

    /// @brief Rotate one composed frame, or return null on failure.
    hide func RotateSprite(source: Pixels, rotation: Number) -> Pixels {
        try {
            return source.Rotate(rotation);
        } catch {
            return null;
        }
        return null;
    }

    /// @brief Extract, scale, mirror, and tint one frame; null on failure.
    /// @details Early-return style: every stage output is a fresh single
    ///          assignment, which the IL verifier requires for object
    ///          variables under exception scopes.
    hide func ComposeSpriteStages(entry: TilesetEntry2D,
                                  tileId: Integer,
                                  scaledWidth: Integer,
                                  scaledHeight: Integer,
                                  mirrorX: Boolean,
                                  mirrorY: Boolean,
                                  tint: Integer) -> Pixels {
        try {
            var source = Pixels.New(entry.tileWidth, entry.tileHeight);
            if source == null { return null; }
            var sourceIndex = tileId - 1;
            source.Copy(
                0, 0, entry.pixels,
                (sourceIndex % entry.columns) * entry.tileWidth,
                (sourceIndex / entry.columns) * entry.tileHeight,
                entry.tileWidth, entry.tileHeight);
            var sized = source.Scale(scaledWidth, scaledHeight);
            var mirrored = MirrorSprite(sized, mirrorX, mirrorY);
            if tint != TINT_NONE_2D { return mirrored.Tint(tint); }
            return mirrored;
        } catch {
            return null;
        }
        return null;
    }

    /// @brief Mirror one frame horizontally and/or vertically.
    hide func MirrorSprite(source: Pixels,
                           mirrorX: Boolean,
                           mirrorY: Boolean) -> Pixels {
        if mirrorX and mirrorY { return source.FlipH().FlipV(); }
        if mirrorX { return source.FlipH(); }
        if mirrorY { return source.FlipV(); }
        return source;
    }

    /// @brief Source-over composite one arbitrary-size image region.
    hide func CompositeRect(destination: Pixels,
                            source: Pixels,
                            destinationX: Integer,
                            destinationY: Integer,
                            width: Integer,
                            height: Integer) {
        var y = 0;
        while y < height {
            var x = 0;
            while x < width {
                var rgba = source.GetRgba(x, y);
                var alpha = rgba % 256;
                if alpha > 0 {
                    destination.BlendPixel(
                        destinationX + x,
                        destinationY + y,
                        rgba / 256,
                        alpha);
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    /// @brief Source-over composite one clipped arbitrary-size image region.
    hide func CompositeImageRegion(destination: Pixels,
                                   source: Pixels,
                                   destinationX: Integer,
                                   destinationY: Integer,
                                   sourceX: Integer,
                                   sourceY: Integer,
                                   width: Integer,
                                   height: Integer) {
        var y = 0;
        while y < height {
            var x = 0;
            while x < width {
                var rgba = source.GetRgba(sourceX + x, sourceY + y);
                var alpha = rgba % 256;
                if alpha > 0 {
                    destination.BlendPixel(
                        destinationX + x,
                        destinationY + y,
                        rgba / 256,
                        alpha);
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    /// @brief Decode or reuse the one active project scene backdrop.
    hide func EnsureSceneBackground(
        authoredPath: String,
        referencePath: String) -> TilesetEntry2D {
        var path = Str.Trim(authoredPath);
        var reference = Str.Trim(referencePath);
        if backgroundEntry != null
           and backgroundEntry.authoredPath == path
           and backgroundReferencePath == reference {
            return backgroundEntry;
        }
        ClearSceneBackground();
        if path == "" { return null; }
        backgroundReferencePath = reference;
        backgroundEntry =
            DecodeSceneBackground(path, reference);
        if backgroundEntry.pixels != null {
            var pixelCount =
                backgroundEntry.width * backgroundEntry.height;
            if sourcePixelCount + pixelCount
               > MAX_SCENE_TILESET_PIXELS {
                backgroundEntry.pixels = null;
                backgroundEntry.error =
                    "Scene image previews exceed the 32 MB decoded limit.";
            } else {
                sourcePixelCount = sourcePixelCount + pixelCount;
            }
        }
        return backgroundEntry;
    }

    /// @brief Scale one background according to a bounded viewport fit mode.
    hide func ScaleSceneBackground(entry: TilesetEntry2D,
                                   fit: String,
                                   viewportWidth: Integer,
                                   viewportHeight: Integer) -> Boolean {
        ClearScaledSceneBackground();
        if entry == null or entry.pixels == null
           or viewportWidth <= 0 or viewportHeight <= 0 {
            return false;
        }
        var width = viewportWidth;
        var height = viewportHeight;
        if fit != "stretch" {
            var sourceWider =
                entry.width * viewportHeight
                    > entry.height * viewportWidth;
            if (fit == "contain" and sourceWider)
               or (fit == "cover" and sourceWider == false) {
                width = viewportWidth;
                height =
                    entry.height * viewportWidth / entry.width;
                if fit == "cover"
                   and entry.height * viewportWidth % entry.width != 0 {
                    height = height + 1;
                }
            } else {
                height = viewportHeight;
                width =
                    entry.width * viewportHeight / entry.height;
                if fit == "cover"
                   and entry.width * viewportHeight % entry.height != 0 {
                    width = width + 1;
                }
            }
        }
        if width < 1 { width = 1; }
        if height < 1 { height = 1; }
        if width > MAX_BACKGROUND_SCALED_AXIS
           or height > MAX_BACKGROUND_SCALED_AXIS
           or width * height > MAX_BACKGROUND_SCALED_PIXELS {
            return false;
        }
        try {
            if width == entry.width and height == entry.height {
                scaledBackground = entry.pixels.Clone();
            } else {
                scaledBackground = entry.pixels.Resize(width, height);
            }
        } catch {
            scaledBackground = null;
        }
        if scaledBackground == null { return false; }
        scaledBackgroundFit = fit;
        scaledBackgroundViewportWidth = viewportWidth;
        scaledBackgroundViewportHeight = viewportHeight;
        scaledBackgroundX = (viewportWidth - width) / 2;
        scaledBackgroundY = (viewportHeight - height) / 2;
        scaledBackgroundHasTransparency =
            ImageHasTransparency(scaledBackground, width, height);
        return true;
    }

    /// @brief Drop the active scaled backdrop without touching decoded art.
    hide func ClearScaledSceneBackground() {
        scaledBackground = null;
        scaledBackgroundFit = "";
        scaledBackgroundViewportWidth = 0;
        scaledBackgroundViewportHeight = 0;
        scaledBackgroundX = 0;
        scaledBackgroundY = 0;
        scaledBackgroundHasTransparency = false;
    }

    /// @brief Return one cached sprite entry index, decoding on first use.
    hide func SpriteEntryIndex(authoredPath: String) -> Integer {
        var path = Str.Trim(authoredPath);
        if path == "" or spriteTileWidth <= 0 { return -1; }
        var index = 0;
        while index < spritePaths.count() {
            if spritePaths.get(index) == path { return index; }
            index = index + 1;
        }
        if spritePaths.count() >= MAX_SPRITE_ENTRIES { return -1; }
        var entry = DecodeEntry(
            path, documentPath, spriteTileWidth, spriteTileHeight);
        if entry.pixels != null {
            var pixelCount = entry.width * entry.height;
            if sourcePixelCount + pixelCount > MAX_SCENE_TILESET_PIXELS {
                entry.pixels = null;
                entry.columns = 0;
                entry.rows = 0;
                entry.tileCount = 0;
                entry.error =
                    "Scene tileset previews exceed the 32 MB decoded limit.";
            } else {
                sourcePixelCount = sourcePixelCount + pixelCount;
            }
        }
        spritePaths.add(path);
        spriteEntries.add(entry);
        return spritePaths.count() - 1;
    }

    /// @brief Shared bounded scale-cache blit for layer and sprite frames.
    hide func DrawEntryFrame(destination: Pixels,
                             entry: TilesetEntry2D,
                             keyPrefix: String,
                             tileId: Integer,
                             x: Integer,
                             y: Integer,
                             cellSize: Integer) -> Boolean {
        if destination == null or entry == null or entry.pixels == null
           or cellSize <= 0 or tileId <= 0 or tileId > entry.tileCount {
            return false;
        }
        if cacheCellSize != cellSize {
            ClearScaledCache();
            cacheCellSize = cellSize;
        }

        var cachedTile = ResolveScaledTile(
            entry, keyPrefix, tileId, cellSize);
        if cachedTile == null or cachedTile.pixels == null { return false; }
        if cachedTile.hasTransparency {
            CompositeTile(
                destination, cachedTile.pixels, x, y, cellSize);
        } else {
            destination.Copy(
                x, y, cachedTile.pixels, 0, 0, cellSize, cellSize);
        }
        return true;
    }

    /// @brief Drop scaled previews after an asset or zoom change.
    expose func ClearScaledCache() {
        scaledTileCache = Map.New();
        cacheCellSize = 0;
        cachedPixelCount = 0;
        cacheSaturated = false;
    }

    /// @brief Extract and nearest-scale one source frame without leaking traps.
    hide func ScaleTile(entry: TilesetEntry2D,
                        tileId: Integer,
                        cellSize: Integer) -> Pixels {
        try {
            var source = Pixels.New(entry.tileWidth, entry.tileHeight);
            if source == null { return null; }
            var sourceIndex = tileId - 1;
            var sourceX =
                (sourceIndex % entry.columns) * entry.tileWidth;
            var sourceY =
                (sourceIndex / entry.columns) * entry.tileHeight;
            source.Copy(
                0, 0, entry.pixels,
                sourceX, sourceY, entry.tileWidth, entry.tileHeight);
            if entry.tileWidth == cellSize
               and entry.tileHeight == cellSize {
                return source;
            }
            return source.Scale(cellSize, cellSize);
        } catch {
            return null;
        }
        return null;
    }

    /// @brief Resolve one scaled frame through the bounded cache.
    hide func ResolveScaledTile(entry: TilesetEntry2D,
                                keyPrefix: String,
                                tileId: Integer,
                                cellSize: Integer) -> ScaledTile2D {
        var key = keyPrefix + tileId;
        if Map.Has(scaledTileCache, key) {
            return Map.Get(scaledTileCache, key) as ScaledTile2D;
        }
        var neededPixels = cellSize * cellSize;
        if neededPixels <= 0
           or cachedPixelCount + neededPixels > MAX_SCALED_CACHE_PIXELS {
            cacheSaturated = true;
            return null;
        }
        var scaled = ScaleTile(entry, tileId, cellSize);
        if scaled == null { return null; }
        var cachedTile = new ScaledTile2D();
        cachedTile.pixels = scaled;
        cachedTile.hasTransparency = HasTransparency(scaled, cellSize);
        Map.Set(scaledTileCache, key, cachedTile);
        cachedPixelCount = cachedPixelCount + neededPixels;
        return cachedTile;
    }

    /// @brief Decide once whether a cached frame needs source-over blending.
    hide func HasTransparency(pixels: Pixels,
                              cellSize: Integer) -> Boolean {
        return ImageHasTransparency(pixels, cellSize, cellSize);
    }

    /// @brief Return whether any pixel in one bounded image has partial alpha.
    hide func ImageHasTransparency(pixels: Pixels,
                                   width: Integer,
                                   height: Integer) -> Boolean {
        if pixels == null or width <= 0 or height <= 0 { return true; }
        var y = 0;
        while y < height {
            var x = 0;
            while x < width {
                if pixels.GetRgba(x, y) % 256 < 255 { return true; }
                x = x + 1;
            }
            y = y + 1;
        }
        return false;
    }

    /// @brief Composite a translucent cached frame over existing layer pixels.
    hide func CompositeTile(destination: Pixels,
                            source: Pixels,
                            destinationX: Integer,
                            destinationY: Integer,
                            cellSize: Integer) {
        var y = 0;
        while y < cellSize {
            var x = 0;
            while x < cellSize {
                var rgba = source.GetRgba(x, y);
                var alpha = rgba % 256;
                if alpha > 0 {
                    destination.BlendPixel(
                        destinationX + x,
                        destinationY + y,
                        rgba / 256,
                        alpha);
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    /// @brief Decode one project scene backdrop independently of scene data.
    hide func DecodeSceneBackground(
        authoredPath: String,
        referencePath: String) -> TilesetEntry2D {
        var entry = new TilesetEntry2D();
        entry.authoredPath = Str.Trim(authoredPath);
        if entry.authoredPath == "" { return entry; }
        entry.resolvedPath = ResolveAssetPath(
            entry.authoredPath, referencePath);
        if entry.resolvedPath == "" {
            entry.error = "The scene background path could not be resolved.";
            return entry;
        }
        entry.sourceBytes = safe_io.SizeBytes(entry.resolvedPath);
        entry.sourceModified = safe_io.Modified(entry.resolvedPath);
        if entry.sourceBytes < 0 {
            entry.error = "Scene background is missing or unreadable: "
                + entry.authoredPath;
            return entry;
        }
        if entry.sourceBytes > MAX_TILESET_SOURCE_BYTES {
            entry.error = "Scene background exceeds the 16 MB source limit.";
            return entry;
        }
        try {
            entry.pixels = Pixels.Load(entry.resolvedPath);
        } catch {
            entry.pixels = null;
        }
        if entry.pixels == null {
            entry.error =
                "Scene background is not a valid PNG, JPEG, BMP, or GIF.";
            return entry;
        }
        entry.width = entry.pixels.Width;
        entry.height = entry.pixels.Height;
        if entry.width <= 0 or entry.height <= 0
           or entry.width * entry.height > MAX_TILESET_SOURCE_PIXELS {
            entry.pixels = null;
            entry.error =
                "Scene background exceeds the 4,194,304 decoded-pixel limit.";
            return entry;
        }
        return entry;
    }

    /// @brief Decode and validate one image independently of scene mutation.
    hide func DecodeEntry(authoredPath: String,
                          nextDocumentPath: String,
                          tileWidth: Integer,
                          tileHeight: Integer) -> TilesetEntry2D {
        var entry = new TilesetEntry2D();
        entry.authoredPath = Str.Trim(authoredPath);
        entry.tileWidth = tileWidth;
        entry.tileHeight = tileHeight;
        if entry.authoredPath == "" { return entry; }
        if tileWidth <= 0 or tileHeight <= 0 {
            entry.error = "The scene has invalid tile dimensions.";
            return entry;
        }

        entry.resolvedPath = ResolveAssetPath(
            entry.authoredPath, nextDocumentPath);
        if entry.resolvedPath == "" {
            entry.error = "The tileset path could not be resolved.";
            return entry;
        }
        entry.sourceBytes = safe_io.SizeBytes(entry.resolvedPath);
        entry.sourceModified = safe_io.Modified(entry.resolvedPath);
        if entry.sourceBytes < 0 {
            entry.error = "Tileset image is missing or unreadable: "
                + entry.authoredPath;
            return entry;
        }
        if entry.sourceBytes > MAX_TILESET_SOURCE_BYTES {
            entry.error = "Tileset image exceeds the 16 MB source limit.";
            return entry;
        }

        try {
            entry.pixels = Pixels.Load(entry.resolvedPath);
        } catch {
            entry.pixels = null;
        }
        if entry.pixels == null {
            entry.error =
                "Tileset is not a valid PNG, JPEG, BMP, or GIF image.";
            return entry;
        }
        entry.width = entry.pixels.Width;
        entry.height = entry.pixels.Height;
        if entry.width <= 0 or entry.height <= 0
           or entry.width * entry.height > MAX_TILESET_SOURCE_PIXELS {
            entry.pixels = null;
            entry.error =
                "Tileset exceeds the 4,194,304 decoded-pixel limit.";
            return entry;
        }
        entry.columns = entry.width / tileWidth;
        entry.rows = entry.height / tileHeight;
        entry.tileCount = entry.columns * entry.rows;
        if entry.tileCount <= 0 {
            entry.pixels = null;
            entry.columns = 0;
            entry.rows = 0;
            entry.error =
                "Tileset is smaller than the scene's tile dimensions.";
            return entry;
        }
        if entry.width % tileWidth != 0 or entry.height % tileHeight != 0 {
            entry.warning =
                "Partial edge pixels are ignored because the image is not an "
                + "exact multiple of the scene tile size.";
        }
        return entry;
    }
}
