//
// File: zannastudio/src/ui/scene_metadata_inspector_3d.zia
// Purpose: Present bounded typed gameplay metadata rows for a 3D node.
// Key invariants:
//   - This presentation object never mutates SceneNode or Document state.
//   - Every value is an always-editable row; commit/remove intents latch for
//     SceneEditor3D, which owns validation, mutation, and history.
//   - Rows preserve exact keys and scalar kinds from the runtime node.
// Ownership/Lifetime: SceneEditor3D owns one inspector; GUI owns its widgets.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        zannastudio/src/ui/property_rows.zia,
//        docs/adr/0159-typed-scenenode-metadata-and-vscn-v6.md
//
//===----------------------------------------------------------------------===//

module scene_metadata_inspector_3d;

bind "property_rows";

bind GUI = Zanna.GUI;
bind SceneNode = Zanna.Graphics3D.SceneNode;
bind Seq = Zanna.Collections.Seq;
bind Fmt = Zanna.Text.Fmt;

// ============================================================================
// MODULE: scene_metadata_inspector_3d
// PURPOSE: Keep node-gameplay metadata widgets outside the large SceneEditor3D
//          document coordinator.
//
// WHERE-THIS-FITS: SceneNode owns typed metadata truth. SceneEditor3D owns
//          validation, mutation, dirty state, and canonical VSCN history.
//
// TEACHING-NOTE: Widget text is a draft. Refresh reconstructs every row from
//          the live runtime node after each transaction.
// ============================================================================

final NODE_METADATA_TYPE_STRING: Integer = 0;
final NODE_METADATA_TYPE_INT: Integer = 1;
final NODE_METADATA_TYPE_FLOAT: Integer = 2;
final NODE_METADATA_TYPE_BOOL: Integer = 3;
final NODE_METADATA_TYPE_NULL: Integer = 4;
final MAX_VISIBLE_NODE_METADATA: Integer = 256;

/// @brief Presentation-only per-row typed metadata editor for the 3D inspector.
class SceneMetadataInspector3D {
    expose GUI.GroupBox group;
    expose GUI.Label summary;
    expose property_rows.PropertyRows rows;
    expose List[String] keys;
    expose Integer selectedProperty;
    hide Boolean editorEnabled;

    expose func init() {
        group = null;
        summary = null;
        rows = null;
        keys = [];
        selectedProperty = -1;
        editorEnabled = false;
    }

    /// @brief Build the per-row gameplay-metadata authoring surface.
    expose func Setup(parent: GUI.VBox) {
        group = GUI.GroupBox.New(parent, "Gameplay metadata");
        summary = GUI.Label.New(
            group,
            "Typed node data for roles, IDs, triggers, spawns, and components.");
        summary.SetWordWrap(true);
        rows = new property_rows.PropertyRows();
        rows.Setup(
            group,
            ["String", "Integer", "Float", "Boolean", "Null"],
            "New metadata",
            "metadata");
        SetEnabled(false);
    }

    /// @brief Rebuild bounded rows from canonical runtime state.
    expose func Refresh(node: SceneNode, enabled: Boolean) {
        selectedProperty = -1;
        keys = [];
        editorEnabled = enabled and node != null;
        if node == null {
            rows.SetRows([], [], []);
            summary.SetText("Select one node to author gameplay metadata.");
            rows.SetEnabled(false);
            return;
        }

        var metadataKeys = node.MetadataKeys();
        var total = Seq.get_Count(metadataKeys);
        var visible = total;
        if visible > MAX_VISIBLE_NODE_METADATA {
            visible = MAX_VISIBLE_NODE_METADATA;
        }
        var rowKinds: List[Integer] = [];
        var rowValues: List[String] = [];
        var index = 0;
        while index < visible {
            var key = Seq.GetStr(metadataKeys, index);
            var kind = node.MetadataKind(key);
            keys.add(key);
            rowKinds.add(KindIndexFor(kind));
            rowValues.add(ValueText(node, key, kind));
            index = index + 1;
        }
        rows.SetRows(keys, rowKinds, rowValues);

        if enabled == false {
            summary.SetText(
                "Select exactly one node to edit its gameplay metadata.");
        } else if total == 0 {
            summary.SetText(
                "No gameplay metadata. Add roles, IDs, triggers, or components.");
        } else if total > visible {
            summary.SetText(
                visible + " of " + total + " gameplay metadata values shown");
        } else if total == 1 {
            summary.SetText("1 gameplay metadata value");
        } else {
            summary.SetText(total + " gameplay metadata values");
        }
        rows.SetEnabled(editorEnabled);
    }

    /// @brief Poll per-row edges; commit/remove intents latch for the editor.
    expose func Pump(node: SceneNode) {
        if node == null { return; }
        rows.Pump();
    }

    /// @brief Consume the committed row index, or -1.
    expose func TakeCommitRow() -> Integer {
        return rows.TakeCommitRow();
    }

    /// @brief Consume the removed row index, or -1.
    expose func TakeRemoveRow() -> Integer {
        return rows.TakeRemoveRow();
    }

    /// @brief The canonical key one row represented, or empty for a draft.
    expose func CanonicalKeyAt(row: Integer) -> String {
        return rows.CanonicalKeyAt(row);
    }

    /// @brief The row's current key draft.
    expose func KeyTextAt(row: Integer) -> String {
        return rows.KeyTextAt(row);
    }

    /// @brief The row's current scalar-kind token ("string", "int", ...).
    expose func KindTokenAt(row: Integer) -> String {
        var kind = rows.KindIndexAt(row);
        if kind == NODE_METADATA_TYPE_INT { return "int"; }
        if kind == NODE_METADATA_TYPE_FLOAT { return "float"; }
        if kind == NODE_METADATA_TYPE_BOOL { return "bool"; }
        if kind == NODE_METADATA_TYPE_NULL { return "null"; }
        return "string";
    }

    /// @brief The row's current value draft.
    expose func ValueTextAt(row: Integer) -> String {
        return rows.ValueTextAt(row);
    }

    /// @brief Focus one live metadata row's value by exact key.
    expose func SelectByKey(key: String) {
        var index = RowIndexOf(key);
        if index < 0 { return; }
        var row = rows.rows.get(index);
        row.valueInput.Focus();
    }

    /// @brief Copy one typed schema field into an editable row draft.
    /// @details An existing same-kind live value wins over the supplied
    ///          default and the row's value gains focus; a missing key
    ///          appends a pre-filled draft row that Enter creates.
    expose func SetDraft(node: SceneNode,
                         key: String,
                         kind: String,
                         defaultValue: String) -> Boolean {
        if editorEnabled == false or node == null or key == "" {
            return false;
        }
        var value = defaultValue;
        if node.MetadataHas(key) and node.MetadataKind(key) == kind {
            value = ValueText(node, key, kind);
        }
        var index = RowIndexOf(key);
        if index >= 0 {
            var row = rows.rows.get(index);
            row.kindDropdown.SetSelected(KindIndexFor(kind));
            row.valueInput.SetText(value);
            if kind == "null" { row.keyInput.Focus(); }
            else { row.valueInput.Focus(); }
            return true;
        }
        rows.AddDraftRow();
        var draft = rows.rows.get(rows.rows.count() - 1);
        draft.keyInput.SetText(key);
        draft.kindDropdown.SetSelected(KindIndexFor(kind));
        draft.valueInput.SetText(value);
        if kind == "null" { draft.keyInput.Focus(); }
        else { draft.valueInput.Focus(); }
        return true;
    }

    /// @brief Reconcile all controls with scene and single-selection validity.
    expose func SetEnabled(enabled: Boolean) {
        editorEnabled = enabled;
        if rows == null { return; }
        rows.SetEnabled(enabled);
    }

    /// @brief Resolve a live key to its visible row index, or -1.
    hide func RowIndexOf(key: String) -> Integer {
        var index = 0;
        while index < keys.count() {
            if keys.get(index) == key { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Map a scalar-kind token to its dropdown row.
    hide func KindIndexFor(kind: String) -> Integer {
        if kind == "int" { return NODE_METADATA_TYPE_INT; }
        if kind == "float" { return NODE_METADATA_TYPE_FLOAT; }
        if kind == "bool" { return NODE_METADATA_TYPE_BOOL; }
        if kind == "null" { return NODE_METADATA_TYPE_NULL; }
        return NODE_METADATA_TYPE_STRING;
    }

    /// @brief Format one live scalar value without changing its kind.
    hide func ValueText(node: SceneNode,
                        key: String,
                        kind: String) -> String {
        if kind == "string" { return node.MetadataGetString(key, ""); }
        if kind == "int" { return Fmt.Int(node.MetadataGetInt(key, 0)); }
        if kind == "float" {
            return Fmt.Num(node.MetadataGetFloat(key, 0.0));
        }
        if kind == "bool" {
            return Fmt.Bool(node.MetadataGetBool(key, false));
        }
        return "";
    }
}
