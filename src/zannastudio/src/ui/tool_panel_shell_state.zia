    /// @brief Initialize one cohesive ToolPanelShell state segment.
    hide func InitializeDockingState() {        workspaceDropTarget = null;
        bottomDockHost = null;
        leftDockHost = null;
        rightDockHost = null;
        leftDockSplit = null;
        rightDockSplit = null;
        editorSplit = null;
        bottomSplitFraction = 0.7;
        splitFractionDirty = false;
        appliedSplitFraction = 0.7;
        sidePanelFraction = 0.30;
        sideFractionDirty = false;
        appliedSideSplitPosition = 0.30;
        dockLocation = workspace_dock.DOCK_BOTTOM;
        dockLocationDirty = false;
        dockDragWasActive = false;
        dockTargetsVisible = false;
        dockTargetHoverLocation = workspace_dock.DOCK_NONE;
        compactToolTabs = false;
        compactDockHeader = false;
        compactProblemsToolbar = false;
        compactOutputToolbar = false;
        compactReferencesToolbar = false;
        compactDebugToolbar = false;
        compactCallStackToolbar = false;
        compactSearchControls = false;
        compactTerminalActions = false;
        compactWatchToolbar = false;
        dockHeaderLocation = workspace_dock.DOCK_NONE;
        toolTabOrderDirty = false;
        toolPanelGroups = new tool_panel_groups.ToolPanelGroups();
        toolPanelGroupLayoutDirty = false;
        activeLeftToolPanelKind = tool_panel_model.PANEL_NONE;
        activeBottomToolPanelKind = tool_panel_model.PANEL_NONE;
        activeRightToolPanelKind = tool_panel_model.PANEL_NONE;
        activeFloatingToolPanelKind = tool_panel_model.PANEL_NONE;
        focusPresentationActive = false;
        focusRestoreLeftToolPanelKind = tool_panel_model.PANEL_NONE;
        focusRestoreBottomToolPanelKind = tool_panel_model.PANEL_NONE;
        focusRestoreRightToolPanelKind = tool_panel_model.PANEL_NONE;
        focusRestoreFloatingToolPanelKind = tool_panel_model.PANEL_NONE;
        focusRestoreActiveToolPanelKind = tool_panel_model.PANEL_NONE;
        floatingPanelX = ToolPanelModel.FLOATING_PANEL_DEFAULT_X;
        floatingPanelY = ToolPanelModel.FLOATING_PANEL_DEFAULT_Y;
        floatingPanelWidth = ToolPanelModel.FLOATING_PANEL_DEFAULT_WIDTH;
        floatingPanelHeight = ToolPanelModel.FLOATING_PANEL_DEFAULT_HEIGHT;
        floatingPanelGeometryDirty = false;
        floatingPanelMoving = false;
        floatingPanelResizing = false;
        floatingPanelManipulationChanged = false;
        floatingPointerOffsetX = 0.0;
        floatingPointerOffsetY = 0.0;
        floatingMoveStartX = ToolPanelModel.FLOATING_PANEL_DEFAULT_X;
        floatingMoveStartY = ToolPanelModel.FLOATING_PANEL_DEFAULT_Y;
        floatingResizeStartPointerX = 0.0;
        floatingResizeStartPointerY = 0.0;
        floatingResizeStartWidth = ToolPanelModel.FLOATING_PANEL_DEFAULT_WIDTH;
        floatingResizeStartHeight = ToolPanelModel.FLOATING_PANEL_DEFAULT_HEIGHT;
        floatingViewportWidth = 0;
        floatingViewportHeight = 0;
        floatingViewportScale = 0.0;
    }

    /// @brief Initialize one cohesive ToolPanelShell state segment.
    hide func InitializePanelDataState() {        activeToolPanelKind = tool_panel_model.PANEL_NONE;
        panelSelectionRevision = 0;
        lastBuildOutput = "";
        outputContentGeneration = 0;
        outputResetGeneration = 0;
        outputPartialLine = "";
        outputPartialItem = null;
        outputFilterText = "";
        outputWrapLines = false;
        outputAutoScroll = true;
        outputPaneMode = true;
        problemsHaveDiagnostics = false;
        problemsFilterText = "";
        problemsShowErrors = true;
        problemsShowWarnings = true;
        problemsShowInfo = true;
        problemsErrorCount = 0;
        problemsWarningCount = 0;
        problemsInfoCount = 0;
        visibleProblemCount = 0;
        problemsActionBusy = false;
        problemRecords = [];
        visibleProblemRecords = [];
        outputRenderedItems = new List();
        outputRenderedRowCount = 0;
        outputBulkRows = false;
        referencesFilterText = "";
        referencesResultCount = 0;
        visibleReferenceCount = 0;
        currentReferenceGroupId = "";
        debugConsoleSource = "";
        debugFilterText = "";
        debugWrapLines = false;
        debugConsoleCanClear = false;
        debugConsoleLineCount = 0;
        visibleDebugConsoleLineCount = 0;
        debugConsoleClearRequested = false;
        callStackFilterText = "";
        callStackStateText = "Idle";
        visibleCallStackFrameCount = 0;
        outputRows = new tool_panel_model.ToolPanelRows();
        problemsRows = new tool_panel_model.ToolPanelRows();
        searchRows = new tool_panel_model.ToolPanelRows();
        referencesRows = new tool_panel_model.ToolPanelRows();
        debugRows = new tool_panel_model.ToolPanelRows();
        variablesRows = new tool_panel_model.ToolPanelRows();
        callStackRows = new tool_panel_model.ToolPanelRows();
    }

    /// @brief Publish one Output-model mutation to every window host.
    /// @param reset True when consumers must replace rather than append.
    hide func NoteOutputContentChanged(reset: Boolean) {
        outputContentGeneration = outputContentGeneration + 1;
        if reset { outputResetGeneration = outputResetGeneration + 1; }
    }
}
