    // Vertical splitter shared with the editor: First = editor, Second = panels.
    // The panel area's height is the splitter's bottom fraction, uniform across
    // every panel tab. Collapsed (position 1.0) when no panel is shown.
    expose GUI.SplitPane editorSplit;
    expose Number bottomSplitFraction; // editor's fraction while a panel is open
    expose Boolean splitFractionDirty; // set on user drag; consumed for persistence
    hide Number appliedSplitFraction;  // last controller-authored splitter position
    expose Number sidePanelFraction;   // panel's width fraction in either side dock
