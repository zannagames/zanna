    /// @brief Initialize detached panel state.
    /// @details Setup must be called after AppShell constructs the GUI widgets.
    hide func InitializeState() {
        InitializeShellWidgetState();
        InitializePanelWidgetState();
        InitializeDockingState();
        InitializePanelDataState();
    }

    /// @brief Initialize one cohesive ToolPanelShell state segment.
    hide func InitializeShellWidgetState() {
        app = null;
        panelRoot = null;
        dockHeader = null;
        dockDragHandle = null;
        dockLeftButton = null;
        dockBottomButton = null;
        dockRightButton = null;
