//
// File: zannastudio/src/ui/tool_panel_shell_state.zia
// Purpose: Persistent fields and deterministic ToolPanelShell initialization.
// Key invariants:
//   - Focused layers preserve stable ToolPanelShell state and bounded row behavior.
// Ownership/Lifetime:
//   - AppShell owns widgets; the public facade owns inherited controller state.
// Links: zannastudio/src/ui/tool_panel_shell.zia
//
//===----------------------------------------------------------------------===//

module tool_panel_shell_state;

