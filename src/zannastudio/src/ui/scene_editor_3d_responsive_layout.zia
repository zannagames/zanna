bind "scene_editor_3d_model" as SceneEditor3DModel;
bind "scene_editor_3d_workspace" as PreviousLayer;

/// @brief Layout implementation layer.
class SceneEditor3DResponsiveLayoutLayer extends PreviousLayer.SceneEditor3DWorkspaceLayer {

    /// @brief Toggle the inspector without making either compact pane unusable.
    expose override func ToggleInspectorPane() {
        if focusModeActive and inspectorDock.floating == false { return; }
        if compactHierarchyShown {
            compactHierarchyShown = false;
            if compactLayout {
                compactInspectorShown = true;
            } else {
                inspectorRequestedVisible = true;
            }
            ApplyInspectorLayout();
            CaptureWorkspaceState();
            return;
        }
        if compactLayout {
            compactInspectorShown = !compactInspectorShown;
        } else {
            inspectorRequestedVisible = !inspectorRequestedVisible;
        }
        ApplyInspectorLayout();
        CaptureWorkspaceState();
    }

    /// @brief Toggle a full-width hierarchy in viewport-priority layouts.
    /// @details Wide hosts keep the ordinary three-pane split. Narrow hosts
    ///          collapse the hierarchy by default but never make it
    ///          unreachable; this action swaps it with the viewport/inspector.
    expose override func ToggleHierarchyPane() {
        if focusModeActive or hierarchyDock.floating
           or SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) {
            return;
        }
        compactHierarchyShown = compactHierarchyShown == false;
        if compactHierarchyShown { compactInspectorShown = false; }
        ApplyInspectorLayout();
        CaptureWorkspaceState();
    }

    /// @brief Reconcile wrapping chrome and master/detail layout after resize.
    expose override func RefreshResponsiveLayout() {
        if root == null or bodySplit == null { return; }
        var width = root.GetLogicalWidth();
        if guiApp != null {
            var scale = guiApp.GetEffectiveScale();
            if scale <= 0.0 { scale = 1.0; }
            var viewportWidth = guiApp.GetWidth() / scale;
            if viewportWidth > 0.0
               and (width <= 0.0 or viewportWidth < width) {
                width = viewportWidth;
            }
        }
        if width <= 0.0 { return; }
        var widthDelta = width - lastHostWidth;
        if widthDelta < 0.0 { widthDelta = 0.0 - widthDelta; }
        var widthChanged = widthDelta > SceneEditor3DModel.RESPONSIVE_WIDTH_EPSILON;
        lastHostWidth = width;
        var nextCompact = SceneEditor3DModel.UsesCompactLayout(width);
        var nextCompactChrome = SceneEditor3DModel.UsesCompactChrome(width);
        var layoutChanged = nextCompact != compactLayout;
        var chromeChanged = nextCompactChrome != compactChrome;
        if layoutChanged {
            compactLayout = nextCompact;
            renderDirty = true;
        }
        compactChrome = nextCompactChrome;
        if layoutChanged or chromeChanged or widthChanged {
            // Wide-mode toolbar height reservations depend on the lane
            // width bracket, so re-apply chrome on width changes too.
            ApplyResponsiveChrome();
        }
        if layoutChanged or widthChanged {
            ApplyInspectorLayout();
        }
    }

    /// @brief Publish a one-shot request for outer-only scene layout.
    expose override func RequestWorkspaceModeToggle() {
        workspaceModeToggleRequested = true;
    }

    /// @brief Consume one outer-only scene-layout toggle request.
    expose override func TakeWorkspaceModeToggleRequested() -> Boolean {
        var requested = workspaceModeToggleRequested;
        workspaceModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the shell's outer-only scene layout state.
    expose override func SetWorkspaceModeActive(active: Boolean) {
        if workspaceModeActive == active { return; }
        workspaceModeActive = active;
        UpdateWorkspaceButton();
    }

    /// @brief Return whether outer-only Scene Layout is active.
    expose override func IsWorkspaceModeActive() -> Boolean {
        return workspaceModeActive;
    }

    /// @brief Publish a one-shot request for the outer shell focus presentation.
    expose override func RequestFocusModeToggle() {
        focusModeToggleRequested = true;
    }

    /// @brief Consume one focus-mode toggle request.
    expose override func TakeFocusModeToggleRequested() -> Boolean {
        var requested = focusModeToggleRequested;
        focusModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the outer shell's focus-presentation state.
    expose override func SetFocusModeActive(active: Boolean) {
        if focusModeActive == active { return; }
        focusModeActive = active;
        ApplyInspectorLayout();
        UpdateFocusButton();
    }

    /// @brief Return whether the outer shell is presenting this scene in focus.
    expose override func IsFocusModeActive() -> Boolean {
        return focusModeActive;
    }

    /// @brief Open one persistent command menu beneath its owning button.
    hide override func ShowCommandMenu(button: GUI.Button,
                              menu: GUI.ContextMenu) {
        if button == null or menu == null { return; }
        var scale = 1.0;
        if guiApp != null {
            scale = guiApp.GetEffectiveScale();
            if scale <= 0.0 { scale = 1.0; }
        }
        menu.Show(
            Convert.NumToInt(button.GetScreenX() * scale),
            Convert.NumToInt(
                (button.GetScreenY() + button.GetScreenHeight()) * scale));
    }

    /// @brief Mirror document-level availability into the Scene menu.
    hide override func ConfigureSceneMenu() {
        var hasDocument = currentDoc != null;
        var hasScene = scene != null;
        sceneNewItem.SetEnabled(hasDocument);
        sceneImportAssetItem.SetEnabled(hasDocument);
        sceneImportInstanceItem.SetEnabled(hasDocument);
        sceneRunItem.SetEnabled(hasScene);
    }

    /// @brief Mirror current scene/selection state into creation commands.
    hide override func ConfigureCreateMenu() {
        var enabled = scene != null;
        var hasSelection =
            enabled and selectedIndices.count() > 0;
        var hasSingle = hasSelection
            and selectedIndices.count() == 1;
        createEmptyItem.SetEnabled(enabled);
        createChildItem.SetEnabled(hasSingle);
        createBoxItem.SetEnabled(enabled);
        createSphereItem.SetEnabled(enabled);
        createPlaneItem.SetEnabled(enabled);
        createCylinderItem.SetEnabled(enabled);
        createTerrainItem.SetEnabled(enabled);
        createLightItem.SetEnabled(enabled);
        createCameraItem.SetEnabled(enabled);
        createDuplicateItem.SetEnabled(hasSelection);
        createDeleteItem.SetEnabled(hasSelection);
    }

    /// @brief Mirror precise-placement state into checkable menu commands.
    hide override func ConfigurePlacementMenu() {
        var enabled =
            scene != null
            and selectedIndices.count() > 0
            and gameViewActive == false;
        placementDropItem.SetEnabled(enabled);
        placementSurfaceItem.SetEnabled(enabled);
        placementAlignItem.SetEnabled(enabled);
        placementVertexItem.SetEnabled(enabled);
        placementSurfaceItem.SetChecked(surfaceSnapEnabled);
        placementAlignItem.SetChecked(surfaceAlignEnabled);
        placementVertexItem.SetChecked(vertexSnapEnabled);
    }

    /// @brief Mirror camera, projection, pane, and presentation state.
    hide override func ConfigureViewMenu() {
        var enabled = scene != null;
        var navigationEnabled =
            enabled and gameViewOutputFramed == false;
        viewTopItem.SetEnabled(navigationEnabled);
        viewFrontItem.SetEnabled(navigationEnabled);
        viewRightItem.SetEnabled(navigationEnabled);
        viewGameplayItem.SetEnabled(
            navigationEnabled and CanApplyProjectPreviewView());
        viewOrbitLeftItem.SetEnabled(navigationEnabled);
        viewOrbitRightItem.SetEnabled(navigationEnabled);
        viewOrbitUpItem.SetEnabled(navigationEnabled);
        viewOrbitDownItem.SetEnabled(navigationEnabled);
        viewZoomOutItem.SetEnabled(navigationEnabled);
        viewZoomInItem.SetEnabled(navigationEnabled);
        viewFrameSelectedItem.SetEnabled(
            navigationEnabled and selectedIndices.count() > 0);
        viewFrameAllItem.SetEnabled(navigationEnabled);
        viewProjectionItem.SetEnabled(navigationEnabled);
        viewProjectionItem.SetChecked(viewPerspective);
        viewOptionsItem.SetEnabled(enabled and gameViewActive == false);
        viewOptionsItem.SetChecked(viewOptionsVisible);

        var canToggleHierarchy =
            SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) == false
            and focusModeActive == false
            and hierarchyDock.floating == false;
        viewHierarchyItem.SetEnabled(canToggleHierarchy);
        viewHierarchyItem.SetText(
            compactHierarchyShown
            ? "Return to Viewport"
            : "Open Hierarchy");
        viewInspectorItem.SetEnabled(
            focusModeActive == false or inspectorDock.floating);
        viewInspectorItem.SetText(
            compactInspectorShown
            ? "Return to Viewport"
            : "Toggle Inspector");
        viewFocusItem.SetEnabled(
            focusButton != null and focusButton.IsEnabled());
        viewFocusItem.SetChecked(focusModeActive);
        viewFocusItem.SetText(
            focusModeActive ? "Exit Focus" : "Focus Viewport");
        viewWorkspaceItem.SetEnabled(true);
        viewWorkspaceItem.SetChecked(workspaceModeActive);
        viewWorkspaceItem.SetText(
            workspaceModeActive ? "Exit Scene Layout" : "Scene Layout");
    }

    /// @brief Open requested overflow menus after responsive visibility settles.
    hide override func PumpCommandMenuButtons() {
        if sceneMenuButton.WasClicked() {
            ConfigureSceneMenu();
            ShowCommandMenu(sceneMenuButton, sceneMenu);
        }
        if createMenuButton.WasClicked() {
            ConfigureCreateMenu();
            ShowCommandMenu(createMenuButton, createMenu);
        }
        if placementMenuButton.WasClicked() {
            ConfigurePlacementMenu();
            ShowCommandMenu(placementMenuButton, placementMenu);
        }
        if viewMenuButton.WasClicked() {
            ConfigureViewMenu();
            ShowCommandMenu(viewMenuButton, viewMenu);
        }
    }

    /// @brief Keep compact menu affordances visibly truthful.
    hide override func UpdateCommandMenuButtons() {
        if placementMenuButton != null {
            var placementActive =
                surfaceSnapEnabled
                or surfaceAlignEnabled
                or vertexSnapEnabled;
            placementMenuButton.SetStyle(placementActive ? 1 : 0);
            placementMenuButton.SetAccessibleDescription(
                "Surface Move " + (surfaceSnapEnabled ? "on" : "off")
                + ", normal alignment "
                + (surfaceAlignEnabled ? "on" : "off")
                + ", Vertex Move "
                + (vertexSnapEnabled ? "on" : "off") + ".");
        }
        if viewMenuButton != null {
            var presentationActive =
                viewOptionsVisible
                or focusModeActive
                or workspaceModeActive;
            viewMenuButton.SetStyle(presentationActive ? 1 : 2);
            viewMenuButton.SetAccessibleDescription(
                "Viewport options "
                + (viewOptionsVisible ? "open" : "closed")
                + ", Focus " + (focusModeActive ? "on" : "off")
                + ", Scene Layout "
                + (workspaceModeActive ? "on" : "off") + ".");
        }
    }

    /// @brief Swap dense secondary actions for complete progressive menus.
    /// @details Active transforms, gameplay presentation, and contextual pane
    ///          navigation remain direct. Width changes viewport capacity
    ///          rather than repopulating chrome with historical controls.
    hide override func ApplyCommandMenuVisibility(useMenus: Boolean) {
        sceneMenuButton.SetVisible(useMenus);
        newSceneButton.SetVisible(!useMenus);
        importAssetButton.SetVisible(!useMenus);
        importInstanceButton.SetVisible(!useMenus);
        runSceneButton.SetVisible(!useMenus);
        duplicateNodeButton.SetVisible(!useMenus);
        deleteNodeButton.SetVisible(!useMenus);

        createMenuButton.SetVisible(useMenus);
        addEmptyButton.SetVisible(!useMenus);
        addChildButton.SetVisible(!useMenus);
        addBoxButton.SetVisible(!useMenus);
        addSphereButton.SetVisible(!useMenus);
        addPlaneButton.SetVisible(!useMenus);
        addCylinderButton.SetVisible(!useMenus);
        addTerrainButton.SetVisible(!useMenus);
        addLightButton.SetVisible(!useMenus);
        addCameraButton.SetVisible(!useMenus);

        placementMenuButton.SetVisible(useMenus);
        dropToSurfaceButton.SetVisible(!useMenus);
        surfaceSnapCheck.SetVisible(!useMenus);
        surfaceAlignCheck.SetVisible(!useMenus);
        vertexSnapCheck.SetVisible(!useMenus);

        viewMenuButton.SetVisible(useMenus);
        topViewButton.SetVisible(!useMenus);
        frontViewButton.SetVisible(!useMenus);
        rightViewButton.SetVisible(!useMenus);
        projectViewButton.SetVisible(!useMenus);
        orbitLeftButton.SetVisible(!useMenus);
        orbitRightButton.SetVisible(!useMenus);
        orbitUpButton.SetVisible(!useMenus);
        orbitDownButton.SetVisible(!useMenus);
        zoomOutButton.SetVisible(!useMenus);
        zoomInButton.SetVisible(!useMenus);
        projectionButton.SetVisible(!useMenus);
        viewOptionsButton.SetVisible(!useMenus);
        frameButton.SetVisible(!useMenus);
        frameSelectedButton.SetVisible(!useMenus);
        focusButton.SetVisible(!useMenus);
        workspaceButton.SetVisible(!useMenus);
    }

    /// @brief Keep all scene creation and navigation actions reachable.
    hide override func ApplyResponsiveChrome() {
        var useCommandMenus = SceneEditor3DModel.UsesSceneCommandMenus(lastHostWidth);
        ApplyCommandMenuVisibility(useCommandMenus);
        if compactChrome {
            // The progressive compact set fits one command row and at most two
            // context rows, leaving the majority of a small window to the
            // authored scene rather than toolbar chrome.
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 40.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 89.0);
            viewSectionLabel.SetVisible(false);
            transformSectionLabel.SetVisible(false);
            zoomSectionLabel.SetVisible(false);
            sceneMenuButton.SetText("Scene");
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import...");
            importInstanceButton.SetText("Instance...");
            createMenuButton.SetText("Create");
            addEmptyButton.SetText("+ Node");
            placementMenuButton.SetText("Place");
            viewMenuButton.SetText("View");
            moveToolButton.SetText("M");
            rotateToolButton.SetText("R");
            scaleToolButton.SetText("S");
            orbitLeftButton.SetText("←");
            orbitRightButton.SetText("→");
            orbitUpButton.SetText("↑");
            orbitDownButton.SetText("↓");
            frameButton.SetText("All");
            frameSelectedButton.SetText("Selected");
            projectViewButton.SetText("Game");
            viewOptionsButton.SetText("View");
            runSceneButton.SetText("Run");
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else if SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) == false {
            // Laptop lanes use complete overflow menus and need at most two
            // view rows. Just above the overflow threshold, Flex can measure
            // the familiar direct controls without a defensive empty row.
            toolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            if useCommandMenus {
                toolbar.SetMinSize(0.0, 40.0);
                viewToolbar.SetMinSize(0.0, 76.0);
            } else {
                toolbar.SetMinSize(0.0, 0.0);
                viewToolbar.SetMinSize(0.0, 0.0);
            }
            viewSectionLabel.SetVisible(false);
            transformSectionLabel.SetVisible(false);
            zoomSectionLabel.SetVisible(false);
            sceneMenuButton.SetText("Scene");
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import");
            importInstanceButton.SetText("Instance");
            createMenuButton.SetText("Create...");
            addEmptyButton.SetText("+ Node");
            placementMenuButton.SetText("Placement...");
            viewMenuButton.SetText("View...");
            moveToolButton.SetText("M");
            rotateToolButton.SetText("R");
            scaleToolButton.SetText("S");
            orbitLeftButton.SetText("←");
            orbitRightButton.SetText("→");
            orbitUpButton.SetText("↑");
            orbitDownButton.SetText("↓");
            frameButton.SetText("All");
            frameSelectedButton.SetText("Selected");
            projectViewButton.SetText("Game");
            viewOptionsButton.SetText("View");
            runSceneButton.SetText("Run");
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else {
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 0.0);
            viewSectionLabel.SetVisible(false);
            transformSectionLabel.SetVisible(false);
            zoomSectionLabel.SetVisible(false);
            sceneMenuButton.SetText("Scene...");
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import Asset...");
            importInstanceButton.SetText("Import Instance...");
            createMenuButton.SetText("Create...");
            addEmptyButton.SetText("+ Empty");
            placementMenuButton.SetText("Placement...");
            viewMenuButton.SetText("View...");
            moveToolButton.SetText("Move");
            rotateToolButton.SetText("Rotate");
            scaleToolButton.SetText("Scale");
            orbitLeftButton.SetText("Yaw -");
            orbitRightButton.SetText("Yaw +");
            orbitUpButton.SetText("Pitch +");
            orbitDownButton.SetText("Pitch -");
            frameButton.SetText("Frame all");
            frameSelectedButton.SetText("Frame selected");
            projectViewButton.SetText("Gameplay");
            viewOptionsButton.SetText("View...");
            runSceneButton.SetText("Run Scene");
            toolbarStatus.SetVisible(true);
            viewStatusLabel.SetVisible(true);
        }
        UpdateProjectionControls();
        UpdateViewOptionsChrome();
        UpdateGizmoModeControls();
        UpdateProjectViewButton();
        UpdateHierarchyButton();
        UpdateInspectorButton();
        UpdateWorkspaceButton();
        UpdateGameViewButton();
        UpdateCommandMenuButtons();
        SyncProjectPreviewFilterControls();
    }

    /// @brief Apply wide three-pane or compact one-pane-at-a-time layout.
    /// @details The hierarchy pane needs real width to be useful, so narrow
    ///          hosts present it as an explicit full-width master alongside
    ///          the viewport/inspector detail cycle.
    hide override func ApplyInspectorLayout() {
        if bodySplit == null { return; }
        var wantHierarchyPane = false;
        var showHierarchyMaster = false;
        if hierarchySplit != null {
            wantHierarchyPane =
                compactLayout == false
                and focusModeActive == false
                and hierarchyDock.floating == false
                and SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth);
            showHierarchyMaster =
                compactHierarchyShown
                and focusModeActive == false
                and hierarchyDock.floating == false
                and SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) == false;
            var desiredHierarchySide = 1;
            if wantHierarchyPane { desiredHierarchySide = 0; }
            else if showHierarchyMaster { desiredHierarchySide = 2; }
            var currentHierarchySide =
                hierarchySplit.GetCollapsedSide();
            if desiredHierarchySide == 0 {
                hierarchySplit.Restore();
            } else if desiredHierarchySide == 2 {
                hierarchySplit.CollapseSecond();
            } else {
                hierarchySplit.CollapseFirst();
            }
            if currentHierarchySide != desiredHierarchySide {
                renderDirty = true;
            }
        }
        if hierarchyPaneBox != null {
            hierarchyPaneBox.SetVisible(
                wantHierarchyPane or showHierarchyMaster
                    or hierarchyDock.floating);
        }
        var desiredSide = 0;
        if focusModeActive and inspectorDock.floating == false {
            desiredSide = 2;
        } else if compactLayout {
            desiredSide = 2;
            if compactInspectorShown { desiredSide = 1; }
        } else if !inspectorRequestedVisible or inspectorDock.floating {
            desiredSide = 2;
        }

        var currentSide = bodySplit.GetCollapsedSide();
        if desiredSide == 1 {
            bodySplit.CollapseFirst();
        } else if desiredSide == 2 {
            bodySplit.CollapseSecond();
        } else {
            bodySplit.Restore();
        }
        if currentSide != desiredSide {
            renderDirty = true;
        }
        if viewportScroll != null {
            viewportScroll.SetVisible(desiredSide != 1);
        }
        if inspectorScroll != null {
            inspectorScroll.SetVisible(
                desiredSide != 2 or inspectorDock.floating);
        }
        UpdateHierarchyButton();
        UpdateInspectorButton();
        UpdateWorkspaceButton();
        UpdateFocusButton();
    }

    /// @brief Keep the narrow hierarchy master action truthful.
    hide override func UpdateHierarchyButton() {
        if hierarchyButton == null { return; }
        var needsMaster =
            lastHostWidth > 0.0
            and SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) == false;
        hierarchyButton.SetVisible(needsMaster);
        if needsMaster == false { return; }
        if focusModeActive {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Hierarchy hidden");
            hierarchyButton.SetTooltip(
                "Exit Focus to open the scene hierarchy");
            hierarchyButton.SetStyle(0);
        } else if hierarchyDock.floating {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Hierarchy floating");
            hierarchyButton.SetTooltip(
                "The scene hierarchy is already available in its floating pane");
            hierarchyButton.SetStyle(2);
        } else if compactHierarchyShown {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Viewport");
            hierarchyButton.SetTooltip(
                "Return to the 3D viewport and inspector");
            hierarchyButton.SetStyle(1);
        } else {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Hierarchy");
            hierarchyButton.SetTooltip(
                "Open the scene hierarchy at the full editor width");
            hierarchyButton.SetStyle(2);
        }
    }

    /// @brief Describe the destination of the inspector toggle.
    hide override func UpdateInspectorButton() {
        if inspectorButton == null { return; }
        inspectorButton.SetVisible(
            compactLayout or inspectorRequestedVisible == false);
        if focusModeActive and inspectorDock.floating == false {
            inspectorButton.SetEnabled(false);
            inspectorButton.SetText("Inspector hidden");
            inspectorButton.SetTooltip(
                "Exit Focus to restore the node inspector");
            inspectorButton.SetStyle(0);
            return;
        }
        inspectorButton.SetEnabled(true);
        if compactHierarchyShown {
            inspectorButton.SetText("Inspector");
            inspectorButton.SetTooltip(
                "Switch from the hierarchy to the node inspector");
            inspectorButton.SetStyle(2);
            return;
        }
        if compactLayout {
            if compactInspectorShown {
                inspectorButton.SetText("Viewport");
                inspectorButton.SetTooltip("Return to the full-width 3D viewport");
                inspectorButton.SetStyle(1);
            } else {
                inspectorButton.SetText("Inspector");
                inspectorButton.SetTooltip("Show the node inspector at full width");
                inspectorButton.SetStyle(2);
            }
        } else if inspectorRequestedVisible {
            inspectorButton.SetText("Hide Inspector");
            inspectorButton.SetTooltip(
                "Hide the node inspector and give the viewport the full width");
            inspectorButton.SetStyle(2);
        } else {
            inspectorButton.SetText("Show Inspector");
            inspectorButton.SetTooltip("Restore the node inspector");
            inspectorButton.SetStyle(1);
        }
    }

    /// @brief Keep the reversible outer-only scene-layout action truthful.
    hide override func UpdateWorkspaceButton() {
        if workspaceButton == null { return; }
        if workspaceModeActive {
            workspaceButton.SetText("Exit Layout");
            workspaceButton.SetTooltip(
                "Restore the Studio sidebar and tool docks while keeping "
                    + "this scene's internal pane layout");
            workspaceButton.SetStyle(1);
        } else {
            if compactChrome
               or SceneEditor3DModel.UsesDockedHierarchy(lastHostWidth) == false {
                workspaceButton.SetText("Layout");
            } else {
                workspaceButton.SetText("Scene Layout");
            }
            workspaceButton.SetTooltip(
                "Hide outer Studio docks but keep the scene hierarchy, "
                    + "viewport, and inspector available");
            workspaceButton.SetStyle(2);
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Keep the reversible outer-workbench action truthful.
    hide override func UpdateFocusButton() {
        if focusButton == null { return; }
        if focusModeActive {
            focusButton.SetText("Exit Focus");
            focusButton.SetTooltip(
                "Restore scene panes, sidebar, and tool panels (Shift+Space)");
            focusButton.SetStyle(1);
        } else {
            focusButton.SetText("Focus");
            focusButton.SetTooltip(
                "Hide scene panes and outer Studio docks to maximize the viewport "
                + "(Shift+Space)");
            focusButton.SetStyle(2);
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Apply deferred inspector scroll after hierarchy layout is known.
    hide override func ApplyPendingWorkspaceScroll() {
        if restoreInspectorScrollPending == false { return; }
        if inspectorScroll != null {
            SetLogicalScroll(
                inspectorScroll, 0.0, pendingInspectorScrollY);
        }
        restoreInspectorScrollPending = false;
    }

}
