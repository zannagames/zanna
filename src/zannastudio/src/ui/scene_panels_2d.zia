//===----------------------------------------------------------------------===//
//
// File: zannastudio/src/ui/scene_panels_2d.zia
// Purpose: Construct the complete 2D scene editor widget tree (0.5d split).
// Key invariants:
//   - Build is a verbatim relocation of SceneEditor2D.Setup's construction
//     body: identical widgets, order, properties, and defaults.
//   - Every widget lands on the editor's own fields; this module retains
//     no state and is safe to call exactly once per editor instance.
//   - Inspector rows wrap before they can overflow the narrow detail pane.
//   - Game View is a first-class view action, separate from animation Preview
//     and reversible Focus/layout presentation.
//   - Scene, Tools, and View menus are built once with stable item handles;
//     the editor owns state synchronization and command dispatch.
//   - Progressive disclosure is stable across widths: wider lanes enlarge the
//     canvas instead of repopulating the chrome with secondary commands.
//   - Desktop defaults bound both supporting panes so the canvas is wider than
//     the Objects pane and Inspector without overriding persisted dividers.
//   - One compact Scene-topic dropdown owns mutually exclusive complete
//     scene-wide inspector groups; the controller owns its live visibility.
// Ownership/Lifetime:
//   - The editor owns every constructed widget; this module owns nothing.
// Links: zannastudio/src/ui/scene_editor_2d.zia
//
//===----------------------------------------------------------------------===//

module scene_panels_2d;

// ============================================================================
// MODULE: scene_panels_2d
// PURPOSE: Keep widget construction out of the editor mega-module so the
//          editor file carries behavior, not layout scaffolding.
//
// WHERE-THIS-FITS: SceneEditor2D.Setup delegates here after recording its
//          app handle; behavior (pumps, commits, rendering) stays with the
//          editor class, which owns all constructed widgets as fields.
//
// TEACHING-NOTE: The dispatcher pattern — Zia modules cannot extend a
//          class, so the builder takes the editor and assigns its exposed
//          fields directly.
// ============================================================================

bind "../services/file_utils";
bind "inspector_rows";
bind "property_rows";
bind "scene_component_schema";
bind "scene_editor_2d";
bind "scene_pane_docking";
bind "scene_layout_2d";
bind "layout_metrics";
bind "scene_collider_inspector_2d";
bind "scene_sprite_clip_2d";
bind "scene_settings_inspector_2d";

bind GUI = Zanna.GUI;

/// @brief Build the full 2D editor widget tree onto @p editor's fields.
/// @details Construction is grouped by owned surface so each helper has one
///          layout responsibility while preserving the historical widget order.
expose func Build(editor: scene_editor_2d.SceneEditor2D,
                  host: GUI.VBox,
                  app: GUI.App) {
    BuildCommandToolbar(editor, host, app);
    BuildViewToolbar(editor);
    var inspector = BuildWorkspaceScaffold(editor);
    BuildInspectorHeader(editor, inspector, app);
    BuildSceneInspector(editor, app);
    BuildHierarchy(editor, app);
    BuildObjectTransformInspector(editor);
    BuildObjectMetadataInspector(editor);
    FinishInspector(editor, inspector);
}

/// @brief Construct the editor root and primary scene/tool command bar.
func BuildCommandToolbar(editor: scene_editor_2d.SceneEditor2D,
                         host: GUI.VBox,
                         app: GUI.App) {
        editor.guiApp = app;
        editor.root = GUI.VBox.New();
        editor.root.SetSpacing(0.0);
        editor.root.SetPadding(0.0);
        editor.root.SetFlex(1.0);
        editor.root.SetName("scene-editor-2d");
        editor.root.SetAccessibleName("2D scene editor");
        host.AddChild(editor.root);

        editor.toolbar = GUI.Toolbar.New(editor.root);
        editor.sceneMenuButton = editor.toolbar.AddNamedButtonWithText(
            "scene-2d", "Scene...",
            "New, import, animation preview, and run commands");
        editor.sceneMenu = GUI.ContextMenu.New();
        editor.sceneNewItem =
            editor.sceneMenu.AddItem("New Empty Scene");
        editor.sceneImportItem =
            editor.sceneMenu.AddItem("Import Tiled...");
        editor.sceneMenu.AddSeparator();
        editor.scenePreviewItem =
            editor.sceneMenu.AddItem("Preview Animations");
        editor.scenePreviewItem.SetCheckable(true);
        editor.sceneRunItem =
            editor.sceneMenu.AddItemWithShortcut("Run Scene", "Ctrl+R");

        editor.newSceneButton = editor.toolbar.AddNamedButtonWithText(
            "new-file", "New Scene",
            "Replace this document using the inspector dimensions (undoable)");
        editor.newSceneButton.SetVisible(false);
        editor.importButton = editor.toolbar.AddNamedButtonWithText(
            "open-folder", "Import Tiled...",
            "Import a Tiled JSON or TMX map into this document");
        editor.importButton.SetVisible(false);
        editor.toolbar.AddSeparator();
        editor.selectButton = editor.toolbar.AddNamedToggle(
            "tool-select",
            "Select and drag objects; Arrow keys nudge one pixel and "
            + "Shift+Arrow nudges one tile");
        editor.paintButton = editor.toolbar.AddNamedToggle(
            "tool-paint",
            "Preview the selected atlas tile, then freehand paint; Escape "
            + "cancels a captured stroke");
        editor.eraseButton = editor.toolbar.AddNamedToggle(
            "tool-erase",
            "Freehand clear tiles; Escape cancels a captured stroke");
        editor.toolMenuButton = editor.toolbar.AddNamedButtonWithText(
            "chevron-down", "Tools...",
            "Choose shape, fill, tile-pick, and object editing tools");
        editor.toolMenuButton.SetVisible(false);
        editor.toolMenu = GUI.ContextMenu.New();
        editor.toolSelectItem = editor.toolMenu.AddItem("Select");
        editor.toolPaintItem = editor.toolMenu.AddItem("Paint");
        editor.toolEraseItem = editor.toolMenu.AddItem("Erase");
        editor.toolMenu.AddSeparator();
        editor.toolRectangleItem =
            editor.toolMenu.AddItem("Rectangle");
        editor.toolLineItem = editor.toolMenu.AddItem("Line");
        editor.toolEllipseItem = editor.toolMenu.AddItem("Ellipse");
        editor.toolFillItem = editor.toolMenu.AddItem("Flood Fill");
        editor.toolPickerItem = editor.toolMenu.AddItem("Pick Tile");
        editor.toolObjectItem = editor.toolMenu.AddItem("Object");
        editor.toolSelectItem.SetCheckable(true);
        editor.toolPaintItem.SetCheckable(true);
        editor.toolEraseItem.SetCheckable(true);
        editor.toolRectangleItem.SetCheckable(true);
        editor.toolLineItem.SetCheckable(true);
        editor.toolEllipseItem.SetCheckable(true);
        editor.toolFillItem.SetCheckable(true);
        editor.toolPickerItem.SetCheckable(true);
        editor.toolObjectItem.SetCheckable(true);
        editor.rectangleButton = editor.toolbar.AddNamedToggle(
            "tool-rect",
            "Preview and drag an inclusive atlas-tile rectangle; tile 0 clears");
        editor.lineButton = editor.toolbar.AddNamedToggle(
            "tool-line",
            "Preview and drag a straight atlas-tile line; tile 0 clears");
        editor.ellipseButton = editor.toolbar.AddNamedToggle(
            "tool-ellipse",
            "Preview and drag an atlas-tile ellipse outline; tile 0 clears");
        editor.fillButton = editor.toolbar.AddNamedToggle(
            "tool-fill",
            "Preview the selected atlas tile, then replace the clicked "
            + "four-connected active-layer region");
        editor.pickerButton = editor.toolbar.AddNamedToggle(
            "tool-pick",
            "Sample one active-layer tile and return to Paint");
        editor.objectButton = editor.toolbar.AddNamedToggle(
            "tool-object",
            "Create, select, and edit placed scene objects");
        editor.toolbar.AddSeparator();
        editor.previewButton = editor.toolbar.AddNamedToggle(
            "eye",
            "Play authored tile animations and framing overlays without "
            + "changing the scene");
        editor.previewButton.SetVisible(false);
        editor.runSceneButton = editor.toolbar.AddNamedButtonWithText(
            "run", "Run Scene",
            "Run the owning project with this saved scene's path appended");
        editor.runSceneButton.SetVisible(false);
        editor.playSceneButton = editor.toolbar.AddNamedButtonWithText(
            "game-view", "Play",
            "Play this scene embedded in the editor canvas; press "
            + "again to stop");
        editor.playSceneButton.SetVisible(false);
}

/// @brief Construct zoom, view, and responsive-layout controls.
func BuildViewToolbar(editor: scene_editor_2d.SceneEditor2D) {
        editor.viewToolbar = GUI.VBox.New();
        editor.viewToolbar.SetSpacing(layout_metrics.GAP_TIGHT);
        editor.viewToolbar.SetPadding(0.0);
        editor.root.AddChild(editor.viewToolbar);
        editor.viewBar = GUI.Toolbar.New(editor.viewToolbar);
        var viewControlRow = GUI.Flex.New();
        viewControlRow.SetDirection(GUI.FlexDirection.Row);
        viewControlRow.SetAlign(GUI.Align.Center);
        viewControlRow.SetGap(4.0);
        viewControlRow.SetPadding(layout_metrics.PAD_CHROME);
        editor.viewToolbar.AddChild(viewControlRow);
        GUI.Label.New(viewControlRow, "Tile");
        editor.tileSpinner = GUI.Spinner.New(viewControlRow);
        editor.tileSpinner.SetAccessibleName("Selected tile ID");
        editor.tileSpinner.SetRange(0.0, 1000000.0);
        editor.tileSpinner.SetStep(1.0);
        editor.tileSpinner.SetDecimals(0);
        editor.tileSpinner.SetValue(1.0);
        editor.tileSpinner.SetPreferredSize(88.0, 0.0);
        editor.toolbarStatus = GUI.Label.New(
            viewControlRow, "Open or create a 2D scene");
        editor.toolbarStatus.SetMinSize(0.0, 0.0);
        editor.toolbarStatus.SetPreferredSize(96.0, 0.0);
        editor.toolbarStatus.SetEllipsis(true);
        editor.toolbarStatus.SetMaxLines(1);
        editor.toolbarStatus.SetFlex(1.0);
        editor.zoomOutButton = editor.viewBar.AddNamedButton(
            "minus", "Zoom out");
        editor.zoomInButton = editor.viewBar.AddNamedButton(
            "plus", "Zoom in");
        editor.fitButton = editor.viewBar.AddNamedButton(
            "fit-view", "Fit the complete scene in the current viewport");
        editor.actualSizeButton = editor.viewBar.AddNamedButton(
            "zoom-actual",
            "Show artwork at its native tile resolution (100% zoom)");
        editor.viewBar.AddSeparator();
        editor.gridButton = editor.viewBar.AddNamedToggle(
            "grid", "Toggle the tile grid overlay");
        editor.rulersButton = editor.viewBar.AddNamedToggle(
            "rulers",
            "Toggle scroll-aware canvas rulers; click to toggle a guide "
            + "or drag one to move it");
        editor.viewMenuButton = editor.viewBar.AddNamedButtonWithText(
            "chevron-down", "View...",
            "Framing, overlays, pane visibility, Focus, and Scene Layout");
        editor.viewMenuButton.SetVisible(false);
        editor.viewMenu = GUI.ContextMenu.New();
        editor.viewFitItem =
            editor.viewMenu.AddItemWithShortcut("Fit Scene", "F");
        editor.viewActualSizeItem =
            editor.viewMenu.AddItem("Actual Size (1:1)");
        editor.viewMenu.AddSeparator();
        editor.viewGridItem = editor.viewMenu.AddItem("Grid");
        editor.viewGridItem.SetCheckable(true);
        editor.viewRulersItem = editor.viewMenu.AddItem("Rulers");
        editor.viewRulersItem.SetCheckable(true);
        editor.viewGameItem = editor.viewMenu.AddItem("Game View");
        editor.viewGameItem.SetCheckable(true);
        editor.viewMenu.AddSeparator();
        editor.viewHierarchyItem =
            editor.viewMenu.AddItem("Open Objects");
        editor.viewInspectorItem =
            editor.viewMenu.AddItem("Toggle Inspector");
        editor.viewPaletteItem =
            editor.viewMenu.AddItem("Toggle Palette");
        editor.viewFocusItem =
            editor.viewMenu.AddItemWithShortcut("Focus Canvas", "Shift+Space");
        editor.viewFocusItem.SetCheckable(true);
        editor.viewWorkspaceItem =
            editor.viewMenu.AddItem("Scene Layout");
        editor.viewWorkspaceItem.SetCheckable(true);
        editor.viewBar.AddSeparator();
        editor.gameViewButton = editor.viewBar.AddNamedToggle(
            "game-view",
            "Game View: show only authored gameplay pixels; keep pan and "
            + "zoom, and restore every editor overlay and tool on exit");
        editor.hierarchyButton = editor.viewBar.AddNamedButtonWithText(
            "node-group", "Objects",
            "Open the object hierarchy at the full editor width");
        editor.hierarchyButton.SetVisible(false);
        editor.inspectorButton = editor.viewBar.AddNamedButtonWithText(
            "split", "Hide Inspector",
            "Hide the scene inspector and give the canvas the full width");
        editor.paletteButton = editor.viewBar.AddNamedButtonWithText(
            "file-image", "Hide Palette",
            "Hide the tile palette and give the canvas the full height");
        editor.focusButton = editor.viewBar.AddButtonWithText(
            "", "Focus",
            "Hide outer Studio docks and maximize the scene canvas");
        editor.workspaceButton = editor.viewBar.AddButtonWithText(
            "", "Scene Layout",
            "Hide outer Studio docks but keep scene panes available");
        editor.viewStatusLabel = GUI.Label.New(viewControlRow, "");
        editor.viewStatusLabel.SetMinSize(0.0, 0.0);
        editor.viewStatusLabel.SetPreferredSize(96.0, 0.0);
        editor.viewStatusLabel.SetEllipsis(true);
        editor.viewStatusLabel.SetMaxLines(1);
        editor.viewStatusLabel.SetFlex(1.0);
        editor.UpdateModeButtons();
}

/// @brief Construct the objects, canvas/palette, and inspector frame.
/// @return The inspector content box borrowed by the remaining builders.
func BuildWorkspaceScaffold(editor: scene_editor_2d.SceneEditor2D)
    -> GUI.VBox {
        // Three-pane workbench: Objects | Canvas+Palette | Inspector. The
        // outer split owns the object hierarchy pane; the inner split keeps
        // its historical name so persisted fractions and probes stay stable,
        // and a vertical split gives the tile palette a real strip under the
        // canvas instead of an inspector slot.
        editor.hierarchySplit = GUI.SplitPane.New(editor.root, 1);
        editor.hierarchySplit.SetFlex(1.0);
        editor.hierarchySplit.SetPosition(0.18);
        editor.hierarchySplit.SetMinFirst(220.0);
        editor.hierarchySplit.SetMinSecond(520.0);

        editor.objectPaneBox = GUI.VBox.New();
        var objectPane = editor.objectPaneBox;
        objectPane.SetSpacing(layout_metrics.GAP_GROUP);
        objectPane.SetPadding(layout_metrics.PAD_PANE);
        objectPane.SetFlex(1.0);
        editor.hierarchySplit.First.AddChild(objectPane);

        editor.bodySplit = GUI.SplitPane.New(editor.hierarchySplit.Second, 1);
        editor.bodySplit.SetFlex(1.0);
        editor.bodySplit.SetPosition(0.72);
        editor.bodySplit.SetMinFirst(280.0);
        editor.bodySplit.SetMinSecond(300.0);

        editor.canvasSplit = GUI.SplitPane.New(editor.bodySplit.First, 0);
        editor.canvasSplit.SetFlex(1.0);
        editor.canvasSplit.SetPosition(0.72);
        editor.canvasSplit.SetMinFirst(220.0);
        editor.canvasSplit.SetMinSecond(140.0);

        editor.canvasFrame = GUI.VBox.New();
        editor.canvasFrame.SetSpacing(0.0);
        editor.canvasFrame.SetFlex(1.0);
        editor.canvasSplit.First.AddChild(editor.canvasFrame);

        editor.rulerTopRow = GUI.HBox.New();
        editor.rulerTopRow.SetSpacing(0.0);
        editor.canvasFrame.AddChild(editor.rulerTopRow);
        editor.rulerCornerImage =
            GUI.Image.New(editor.rulerTopRow);
        editor.rulerCornerImage.SetSize(
            scene_editor_2d.CANVAS_RULER_LEFT_WIDTH,
            scene_editor_2d.CANVAS_RULER_TOP_HEIGHT);
        editor.rulerCornerImage.SetScaleMode(0);
        editor.rulerCornerImage.SetFilter(0);
        editor.rulerCornerImage.SetAccessibleName(
            "2D canvas ruler units");
        editor.horizontalRulerImage =
            GUI.Image.New(editor.rulerTopRow);
        editor.horizontalRulerImage.SetFlex(1.0);
        editor.horizontalRulerImage.SetSize(
            1, scene_editor_2d.CANVAS_RULER_TOP_HEIGHT);
        editor.horizontalRulerImage.SetScaleMode(0);
        editor.horizontalRulerImage.SetFilter(0);
        editor.horizontalRulerImage.SetFocusable(true);
        editor.horizontalRulerImage.SetAccessibleName(
            "Horizontal scene ruler");
        editor.horizontalRulerImage.SetTooltip(
            "Click to toggle a vertical guide; drag to create or move, "
            + "drag outside to remove, Escape to cancel");

        editor.canvasContentRow = GUI.HBox.New();
        editor.canvasContentRow.SetSpacing(0.0);
        editor.canvasContentRow.SetFlex(1.0);
        editor.canvasFrame.AddChild(editor.canvasContentRow);
        editor.verticalRulerImage =
            GUI.Image.New(editor.canvasContentRow);
        editor.verticalRulerImage.SetSize(
            scene_editor_2d.CANVAS_RULER_LEFT_WIDTH, 1);
        editor.verticalRulerImage.SetScaleMode(0);
        editor.verticalRulerImage.SetFilter(0);
        editor.verticalRulerImage.SetFocusable(true);
        editor.verticalRulerImage.SetAccessibleName(
            "Vertical scene ruler");
        editor.verticalRulerImage.SetTooltip(
            "Click to toggle a horizontal guide; drag to create or move, "
            + "drag outside to remove, Escape to cancel");

        editor.canvasScroll = GUI.ScrollView.New(editor.canvasContentRow);
        editor.canvasScroll.SetFlex(1.0);
        // The stage carries the full-editor.scene logical extent for the scrollbars
        // while the image renders only the visible window. Start alignment
        // lets per-frame image margins pin the window under the viewport.
        editor.canvasStage = GUI.VBox.New();
        editor.canvasStage.SetAlign(GUI.Align.Start);
        editor.canvasStage.SetJustify(GUI.Justify.Start);
        editor.canvasScroll.AddChild(editor.canvasStage);
        editor.canvasImage = GUI.Image.New(editor.canvasStage);
        editor.canvasImage.SetScaleMode(0);
        editor.canvasImage.SetFilter(0);
        editor.canvasImage.SetName("scene-2d-canvas");
        editor.canvasImage.SetAccessibleName("2D scene canvas");
        // The canvas is a real focusable surface: clicking it takes keyboard
        // focus, so arrow nudges, Delete, Duplicate, and Escape belong to
        // the canvas the user is actually working in.
        editor.canvasImage.SetFocusable(true);
        // Assets dragged from the project browser drop onto the canvas to
        // create sprite objects at the drop cell (Phase 1.2).
        editor.canvasImage.SetDropTarget(true);
        editor.canvasImage.SetAcceptedDropTypes("zanna/asset");
        editor.canvasImage.SetTooltip(
            "Paint or erase freehand, drag Rectangle, click Fill or Pick; "
            + "Escape cancels captured tile gestures. In Select mode click or "
            + "drag a box, Shift adds, Control/Command toggles, and object "
            + "drags move the selection. The wheel zooms around the pointer "
            + "and middle-drag pans.");

        editor.paletteStripBox = GUI.VBox.New();
        var paletteStrip = editor.paletteStripBox;
        paletteStrip.SetSpacing(layout_metrics.GAP_ROW);
        paletteStrip.SetPadding(layout_metrics.PAD_GROUP);
        paletteStrip.SetFlex(1.0);
        editor.canvasSplit.Second.AddChild(paletteStrip);

        editor.inspectorScroll = GUI.ScrollView.New(editor.bodySplit.Second);
        editor.inspectorScroll.SetFlex(1.0);
        var inspector = GUI.VBox.New();
        inspector.SetSpacing(layout_metrics.GAP_GROUP);
        inspector.SetPadding(layout_metrics.PAD_PANE);
        editor.inspectorScroll.AddChild(inspector);
        return inspector;
}

/// @brief Construct inspector tabs, pane docking, and the topic selector.
func BuildInspectorHeader(editor: scene_editor_2d.SceneEditor2D,
                          inspector: GUI.VBox,
                          app: GUI.App) {
        var paletteStrip = editor.paletteStripBox;
        // Object | Scene inspector tabs: object fields and component groups
        // live on the Object tab; editor.scene-wide groups (setup, imports, editor.scene
        // properties, camera/lighting, layers, tile behavior) on the Scene
        // tab. Selection changes auto-follow, and a manual choice holds
        // until the next selection change.
        var inspectorTabRow = GUI.HBox.New();
        inspectorTabRow.SetSpacing(layout_metrics.GAP_ROW);
        inspector.AddChild(inspectorTabRow);
        editor.inspectorDock.Setup(
            app,
            editor.bodySplit.Second,
            editor.inspectorScroll,
            editor.bodySplit,
            2,
            0.72,
            "Inspector",
            inspectorTabRow);
        editor.paletteDock.Setup(
            app,
            editor.canvasSplit.Second,
            editor.paletteStripBox,
            editor.canvasSplit,
            2,
            0.72,
            "Palette",
            paletteStrip);
        editor.objectTabButton = GUI.Button.New(inspectorTabRow, "Object");
        editor.objectTabButton.SetTooltip("Inspect the selected objects");
        editor.sceneTabButton = GUI.Button.New(inspectorTabRow, "Scene");
        editor.sceneTabButton.SetTooltip(
            "Author scene setup, imports, properties, camera/lighting, "
            + "layers, and tile behavior");
        editor.objectTabHost = GUI.VBox.New();
        editor.objectTabHost.SetSpacing(layout_metrics.GAP_GROUP);
        inspector.AddChild(editor.objectTabHost);
        editor.sceneTabHost = GUI.VBox.New();
        editor.sceneTabHost.SetSpacing(layout_metrics.GAP_GROUP);
        inspector.AddChild(editor.sceneTabHost);

        editor.sceneSectionRow = GUI.HBox.New();
        editor.sceneSectionRow.SetSpacing(layout_metrics.GAP_ROW);
        editor.sceneTabHost.AddChild(editor.sceneSectionRow);
        GUI.Label.New(editor.sceneSectionRow, "Topic");
        editor.sceneSectionDropdown =
            GUI.Dropdown.New(editor.sceneSectionRow);
        editor.sceneSectionDropdown.SetFlex(1.0);
        editor.sceneSectionDropdown.SetAccessibleName(
            "2D Scene inspector topic");
        editor.sceneSectionDropdown.SetTooltip(
            "Show one scene-wide authoring topic at a time");
        editor.sceneSectionDropdown.AddItem("Setup & Import");
        editor.sceneSectionDropdown.AddItem("Properties");
        editor.sceneSectionDropdown.AddItem("Camera & Lighting");
        editor.sceneSectionDropdown.AddItem("Layers");
        editor.sceneSectionDropdown.AddItem("Tile Behavior");
        editor.sceneSectionDropdown.AddItem("History");
        editor.sceneSectionDropdown.SetSelected(
            scene_editor_2d.SCENE_INSPECTOR_SETUP);
        editor.sceneSectionDropdown.WasChanged();
}

/// @brief Construct scene setup, history, properties, layers, and tile tools.
func BuildSceneInspector(editor: scene_editor_2d.SceneEditor2D,
                         app: GUI.App) {
        var paletteStrip = editor.paletteStripBox;
        editor.sceneSetupGroup =
            GUI.GroupBox.New(editor.sceneTabHost, "Scene setup");
        var sceneSizeRow = GUI.HBox.New();
        sceneSizeRow.SetSpacing(layout_metrics.GAP_ROW);
        editor.sceneSetupGroup.AddChild(sceneSizeRow);
        GUI.Label.New(sceneSizeRow, "W");
        editor.sceneWidthSpinner = GUI.Spinner.New(sceneSizeRow);
        editor.ConfigureSceneSpinner(editor.sceneWidthSpinner, scene_editor_2d.DEFAULT_SCENE_WIDTH, 256);
        GUI.Label.New(sceneSizeRow, "H");
        editor.sceneHeightSpinner = GUI.Spinner.New(sceneSizeRow);
        editor.ConfigureSceneSpinner(editor.sceneHeightSpinner, scene_editor_2d.DEFAULT_SCENE_HEIGHT, 256);
        var tileSizeRow = GUI.HBox.New();
        tileSizeRow.SetSpacing(layout_metrics.GAP_ROW);
        editor.sceneSetupGroup.AddChild(tileSizeRow);
        GUI.Label.New(tileSizeRow, "Tile size");
        editor.sceneTileSizeSpinner = GUI.Spinner.New(tileSizeRow);
        editor.ConfigureSceneSpinner(editor.sceneTileSizeSpinner, scene_editor_2d.DEFAULT_TILE_SIZE, 512);
        editor.sceneInfoLabel =
            GUI.Label.New(editor.sceneSetupGroup, "No scene loaded");
        editor.sceneInfoLabel.SetWordWrap(true);
        editor.sceneInfoLabel.SetMaxLines(2);

        editor.sceneImportGroup =
            GUI.GroupBox.New(editor.sceneTabHost, "Project map imports");
        editor.tiledAssetBrowser.Setup(
            editor.sceneImportGroup,
            "Import Project Tiled Map...",
            ".tmj,.json,.tmx",
            "Import Map");

        editor.historyGroup =
            GUI.GroupBox.New(editor.sceneTabHost, "History");
        editor.historyList = GUI.ListBox.New(editor.historyGroup);
        editor.historyList.SetPreferredSize(0.0, 110.0);
        editor.historyList.SetAccessibleName(
            "Undoable 2D scene edits oldest first; click a row to jump");

        editor.sceneSettingsGroup =
            GUI.GroupBox.New(editor.sceneTabHost, "Scene Settings");
        editor.sceneSettingsHost = GUI.VBox.New();
        editor.sceneSettingsHost.SetSpacing(
            layout_metrics.GAP_ROW);
        editor.sceneSettingsGroup.AddChild(
            editor.sceneSettingsHost);
        editor.sceneSettingsInspector.Setup(
            editor.sceneSettingsHost);
        editor.sceneProperties.Setup(editor.sceneTabHost);
        editor.cameraLighting.Setup(editor.sceneTabHost);

        editor.layersGroup =
            GUI.GroupBox.New(editor.sceneTabHost, "Layers");
        editor.layerList = GUI.ListBox.New(editor.layersGroup);
        editor.layerList.SetAccessibleName("Scene layers");
        editor.layerList.SetAccessibleDescription(
            "Visible, hidden, locked, solo, and opacity state. "
            + "Drag or press Alt+Up/Down to reorder. "
            + "Double-click or press Enter to toggle layer visibility.");
        editor.layerList.SetTooltip(
            "● visible, ○ hidden, ⊘ locked, SOLO isolated. "
            + "Drag or press Alt+Up/Down to reorder; "
            + "double-click or press Enter to toggle visibility.");
        editor.layerList.SetReorderable(true);
        editor.layerList.SetPreferredSize(0.0, 132.0);
        var layerButtons = GUI.Flex.New();
        layerButtons.SetDirection(GUI.FlexDirection.Row);
        layerButtons.SetWrap(GUI.FlexWrap.Wrap);
        layerButtons.SetAlign(GUI.Align.Center);
        layerButtons.SetGap(4.0);
        editor.layersGroup.AddChild(layerButtons);
        editor.addLayerButton = GUI.Button.New(layerButtons, "Add");
        editor.addLayerButton.SetAccessibleName("Add 2D scene layer");
        editor.addLayerButton.SetTooltip(
            "Append a new layer as one undoable scene edit");
        editor.removeLayerButton = GUI.Button.New(layerButtons, "Remove");
        editor.removeLayerButton.SetAccessibleName(
            "Remove active 2D scene layer");
        editor.removeLayerButton.SetTooltip(
            "Remove the active layer; the final layer cannot be removed");
        editor.layerUpButton = GUI.Button.New(layerButtons, "Up");
        editor.layerUpButton.SetAccessibleName(
            "Move active 2D scene layer up");
        editor.layerUpButton.SetTooltip(
            "Move the active layer one draw-order position earlier");
        editor.layerDownButton = GUI.Button.New(layerButtons, "Down");
        editor.layerDownButton.SetAccessibleName(
            "Move active 2D scene layer down");
        editor.layerDownButton.SetTooltip(
            "Move the active layer one draw-order position later");
        editor.layerVisibleCheck =
            GUI.Checkbox.New(editor.layersGroup, "Layer visible");
        var layerStateRow = inspector_rows.NewWrapRow();
        editor.layersGroup.AddChild(layerStateRow);
        GUI.Label.New(layerStateRow, "Opacity");
        editor.layerOpacitySpinner = GUI.Spinner.New(layerStateRow);
        editor.layerOpacitySpinner.SetRange(0.0, 1.0);
        editor.layerOpacitySpinner.SetStep(0.05);
        editor.layerOpacitySpinner.SetDecimals(2);
        editor.layerOpacitySpinner.SetTooltip(
            "Authored layer opacity (ADR 0195); each change is one "
            + "undoable edit");
        editor.layerLockCheck = GUI.Checkbox.New(layerStateRow, "Lock");
        editor.layerLockCheck.SetTooltip(
            "Workspace-only: a locked layer refuses tile edits");
        editor.layerSoloCheck = GUI.Checkbox.New(layerStateRow, "Solo");
        editor.layerSoloCheck.SetTooltip(
            "Workspace-only: preview only this layer; never saves");
        editor.layerNameInput = GUI.TextInput.New(editor.layersGroup);
        editor.layerNameInput.SetPlaceholder("Layer name");
        editor.layerAssetInput = GUI.TextInput.New(editor.layersGroup);
        editor.layerAssetInput.SetPlaceholder("Layer asset path");
        editor.chooseLayerAssetButton =
            GUI.Button.New(editor.layersGroup, "Choose Layer Image...");
        editor.chooseLayerAssetButton.SetTooltip(
            "Reference a PNG, JPEG, BMP, or GIF tileset for this layer");

        // The tile palette lives in the strip under the canvas where painting
        // happens; per-tile behavior authoring stays on the Scene tab.
        editor.tilesetInspector.Setup(paletteStrip, app);
        editor.tileBehavior.Setup(editor.sceneTabHost);
}

/// @brief Construct object hierarchy search, reparent, and ordering controls.
func BuildHierarchy(editor: scene_editor_2d.SceneEditor2D,
                    app: GUI.App) {
        var objectPane = editor.objectPaneBox;
        GUI.Label.New(objectPane, "Objects");
        var hierarchySearchRow = GUI.HBox.New();
        hierarchySearchRow.SetSpacing(layout_metrics.GAP_ROW);
        objectPane.AddChild(hierarchySearchRow);
        editor.hierarchyDock.Setup(
            app,
            editor.hierarchySplit.First,
            editor.objectPaneBox,
            editor.hierarchySplit,
            1,
            0.18,
            "Objects",
            hierarchySearchRow);
        editor.hierarchySearchInput = GUI.TextInput.New(hierarchySearchRow);
        editor.hierarchySearchInput.SetFlex(1.0);
        editor.hierarchySearchInput.SetPlaceholder("Find object id or type");
        editor.hierarchySearchInput.SetAccessibleName(
            "Find 2D scene object by id or type");
        editor.hierarchySearchInput.SetTooltip(
            "Keep the hierarchy intact and jump between matching visible rows");
        editor.hierarchySearchPreviousButton =
            GUI.Button.New(hierarchySearchRow, "Prev");
        editor.hierarchySearchPreviousButton.SetAccessibleName(
            "Previous matching 2D scene object");
        editor.hierarchySearchPreviousButton.SetTooltip(
            "Select and reveal the previous matching object");
        editor.hierarchySearchNextButton =
            GUI.Button.New(hierarchySearchRow, "Next");
        editor.hierarchySearchNextButton.SetAccessibleName(
            "Next matching 2D scene object");
        editor.hierarchySearchNextButton.SetTooltip(
            "Select and reveal the next matching object");
        editor.hierarchySearchStatus = GUI.Label.New(
            objectPane, "Find by object id or type");
        editor.hierarchySearchStatus.SetWordWrap(true);
        editor.objectTree = GUI.TreeView.New(objectPane);
        editor.objectTree.SetAccessibleName("Scene object hierarchy");
        // The dedicated pane gives the tree the full remaining height
        // instead of a fixed inspector slot.
        editor.objectTree.SetFlex(1.0);
        editor.objectTree.SetMultiSelect(true);
        editor.objectTree.SetDragDropMode(2);
        editor.objectTree.SetTooltip(
            "Expand object groups; Ctrl/Command-click or Shift-click selects "
            + "several rows; drag before, into, or after another row");
        editor.objectHierarchyStatus = GUI.Label.New(objectPane, "");
        editor.objectHierarchyStatus.SetWordWrap(true);
        var objectParentRow = GUI.HBox.New();
        objectParentRow.SetSpacing(layout_metrics.GAP_ROW);
        objectPane.AddChild(objectParentRow);
        GUI.Label.New(objectParentRow, "Parent");
        editor.objectParentDropdown = GUI.Dropdown.New(objectParentRow);
        editor.objectParentDropdown.SetFlex(1.0);
        editor.objectParentDropdown.SetAccessibleName(
            "Selected 2D object parent target");
        editor.objectParentDropdown.SetTooltip(
            "Choose a cycle-safe parent; absolute object positions stay unchanged");
        editor.reparentObjectButton =
            GUI.Button.New(objectParentRow, "Reparent");
        editor.reparentObjectButton.SetTooltip(
            "Move selected object subtrees beneath this parent as one undoable edit");
        // Creation, duplication, removal, and ordering act on the hierarchy
        // and live in its pane; identity and position editing stay with the
        // inspector's selected-object fields.
        var objectButtons = GUI.HBox.New();
        objectButtons.SetSpacing(layout_metrics.GAP_ROW);
        objectPane.AddChild(objectButtons);
        editor.addObjectButton = GUI.Button.New(objectButtons, "Add Root");
        editor.addObjectButton.SetTooltip(
            "Create a new root object at the selected canvas cell");
        editor.addChildObjectButton =
            GUI.Button.New(objectButtons, "Add Child");
        editor.addChildObjectButton.SetTooltip(
            "Create one child beneath the selected object in a single undo step");
        // Wrapping row: four ordering buttons exceed the narrow hierarchy
        // pane, so they wrap instead of bleeding into the canvas pane.
        var objectOrderButtons = GUI.Flex.New();
        objectOrderButtons.SetDirection(GUI.FlexDirection.Row);
        objectOrderButtons.SetWrap(GUI.FlexWrap.Wrap);
        objectOrderButtons.SetAlign(GUI.Align.Center);
        objectOrderButtons.SetGap(4.0);
        objectPane.AddChild(objectOrderButtons);
        editor.duplicateObjectButton = GUI.Button.New(objectOrderButtons, "Duplicate");
        editor.duplicateObjectButton.SetTooltip(
            "Duplicate the selected object and all of its typed properties");
        editor.removeObjectButton = GUI.Button.New(objectOrderButtons, "Remove");
        editor.objectUpButton = GUI.Button.New(objectOrderButtons, "Up");
        editor.objectUpButton.SetTooltip(
            "Move the selected object subtree before its previous sibling");
        editor.objectDownButton = GUI.Button.New(objectOrderButtons, "Down");
        editor.objectDownButton.SetTooltip(
            "Move the selected object subtree after its next sibling");
}

/// @brief Construct selected-object identity and transform controls.
func BuildObjectTransformInspector(
    editor: scene_editor_2d.SceneEditor2D) {
        editor.objectFieldsLabel = GUI.Label.New(editor.objectTabHost, "Selected object");
        editor.objectTypeInput = GUI.TextInput.New(editor.objectTabHost);
        editor.objectTypeInput.SetPlaceholder("Object type");
        editor.objectIdInput = GUI.TextInput.New(editor.objectTabHost);
        editor.objectIdInput.SetPlaceholder("Object id");
        editor.objectPositionRow = GUI.HBox.New();
        editor.objectPositionRow.SetSpacing(layout_metrics.GAP_ROW);
        editor.objectTabHost.AddChild(editor.objectPositionRow);
        GUI.Label.New(editor.objectPositionRow, "X");
        editor.objectXSpinner = GUI.Spinner.New(editor.objectPositionRow);
        editor.objectXSpinner.SetRange(-1000000.0, 1000000.0);
        editor.objectXSpinner.SetStep(1.0);
        editor.objectXSpinner.SetDecimals(0);
        GUI.Label.New(editor.objectPositionRow, "Y");
        editor.objectYSpinner = GUI.Spinner.New(editor.objectPositionRow);
        editor.objectYSpinner.SetRange(-1000000.0, 1000000.0);
        editor.objectYSpinner.SetStep(1.0);
        editor.objectYSpinner.SetDecimals(0);
        editor.applyObjectButton = GUI.Button.New(editor.objectPositionRow, "Set Object");
        // Type/id/position edits commit live (ADR 0221); the retained
        // hidden button keeps the probe-visible enable contract truthful.
        editor.applyObjectButton.SetVisible(false);
        editor.objectTransformRow = inspector_rows.NewWrapRow();
        editor.objectTabHost.AddChild(editor.objectTransformRow);
        GUI.Label.New(editor.objectTransformRow, "Rot");
        editor.objectRotationSpinner = GUI.Spinner.New(editor.objectTransformRow);
        editor.objectRotationSpinner.SetRange(0.0, 359.9);
        editor.objectRotationSpinner.SetStep(1.0);
        editor.objectRotationSpinner.SetDecimals(1);
        editor.objectRotationSpinner.SetTooltip(
            "Rotation in degrees about the object pivot");
        GUI.Label.New(editor.objectTransformRow, "SX");
        editor.objectScaleXSpinner = GUI.Spinner.New(editor.objectTransformRow);
        editor.objectScaleXSpinner.SetRange(-10000.0, 10000.0);
        editor.objectScaleXSpinner.SetStep(0.1);
        editor.objectScaleXSpinner.SetDecimals(2);
        editor.objectScaleXSpinner.SetTooltip("Horizontal scale factor");
        GUI.Label.New(editor.objectTransformRow, "SY");
        editor.objectScaleYSpinner = GUI.Spinner.New(editor.objectTransformRow);
        editor.objectScaleYSpinner.SetRange(-10000.0, 10000.0);
        editor.objectScaleYSpinner.SetStep(0.1);
        editor.objectScaleYSpinner.SetDecimals(2);
        editor.objectScaleYSpinner.SetTooltip("Vertical scale factor");
        editor.objectFlipXCheck = GUI.Checkbox.New(editor.objectTransformRow, "Flip X");
        editor.objectFlipXCheck.SetTooltip(
            "Mirror horizontally about the pivot (one undoable edit)");
        editor.objectFlipYCheck = GUI.Checkbox.New(editor.objectTransformRow, "Flip Y");
        editor.objectFlipYCheck.SetTooltip(
            "Mirror vertically about the pivot (one undoable edit)");
        GUI.Label.New(editor.objectTransformRow, "PX");
        editor.objectPivotXSpinner = GUI.Spinner.New(editor.objectTransformRow);
        editor.objectPivotXSpinner.SetRange(0.0, 1.0);
        editor.objectPivotXSpinner.SetStep(0.05);
        editor.objectPivotXSpinner.SetDecimals(2);
        editor.objectPivotXSpinner.SetTooltip(
            "Normalized horizontal pivot within the sprite");
        GUI.Label.New(editor.objectTransformRow, "PY");
        editor.objectPivotYSpinner = GUI.Spinner.New(editor.objectTransformRow);
        editor.objectPivotYSpinner.SetRange(0.0, 1.0);
        editor.objectPivotYSpinner.SetStep(0.05);
        editor.objectPivotYSpinner.SetDecimals(2);
        editor.objectPivotYSpinner.SetTooltip(
            "Normalized vertical pivot within the sprite");
        GUI.Label.New(editor.objectTransformRow, "Tint");
        editor.objectTintInput = GUI.TextInput.New(editor.objectTransformRow);
        editor.objectTintInput.SetPlaceholder("RRGGBBAA");
        editor.objectTintInput.SetTooltip(
            "RGBA multiply tint in hex; FFFFFFFF means no tint. "
            + "Enter commits one undoable edit.");
}

/// @brief Construct object preview ordering, properties, and components.
func BuildObjectMetadataInspector(
    editor: scene_editor_2d.SceneEditor2D) {
        editor.objectDrawStackGroup =
            GUI.GroupBox.New(editor.objectTabHost, "Preview draw stack");
        editor.objectDrawStackSummary = GUI.Label.New(
            editor.objectDrawStackGroup,
            "Select one object to inspect its game-like preview order.");
        editor.objectDrawStackSummary.SetWordWrap(true);
        editor.objectAfterLayerDropdown =
            GUI.Dropdown.New(editor.objectDrawStackGroup);
        editor.objectAfterLayerDropdown.SetAccessibleName(
            "Tile layer after which the object preview draws");
        editor.objectAfterLayerDropdown.SetTooltip(
            "Place this object's preview before all tiles or after one "
            + "authored tile layer");
        var objectDrawStackActions = inspector_rows.NewWrapRow();
        editor.objectDrawStackGroup.AddChild(objectDrawStackActions);
        GUI.Label.New(objectDrawStackActions, "Priority");
        editor.objectDrawOrderSpinner =
            GUI.Spinner.New(objectDrawStackActions);
        editor.objectDrawOrderSpinner.SetRange(
            scene_component_schema.MIN_PREVIEW_DRAW_ORDER,
            scene_component_schema.MAX_PREVIEW_DRAW_ORDER);
        editor.objectDrawOrderSpinner.SetStep(1.0);
        editor.objectDrawOrderSpinner.SetDecimals(0);
        editor.objectDrawOrderSpinner.SetTooltip(
            "Smaller previews paint first; document order breaks ties");
        editor.objectDrawStackApplyButton =
            GUI.Button.New(objectDrawStackActions, "Set Draw Order");
        editor.objectDrawStackApplyButton.SetTooltip(
            "Store editor.afterLayer and editor.drawOrder together "
            + "as one undoable object edit");
        // Layer/priority edits commit live (ADR 0221); the retained hidden
        // button keeps the probe-visible enable contract truthful.
        editor.objectDrawStackApplyButton.SetVisible(false);
        editor.objectDrawStackResetButton =
            GUI.Button.New(objectDrawStackActions, "Use Project");
        editor.objectDrawStackResetButton.SetTooltip(
            "Remove per-object preview-stack overrides and inherit the "
            + "project rule");
        editor.objectArrangeRow = GUI.HBox.New();
        editor.objectArrangeRow.SetSpacing(layout_metrics.GAP_ROW);
        editor.objectTabHost.AddChild(editor.objectArrangeRow);
        editor.objectArrangeDropdown = GUI.Dropdown.New(editor.objectArrangeRow);
        editor.objectArrangeDropdown.AddItem(
            scene_layout_2d.OperationLabel(scene_editor_2d.ARRANGE_ALIGN_X));
        editor.objectArrangeDropdown.AddItem(
            scene_layout_2d.OperationLabel(scene_editor_2d.ARRANGE_ALIGN_Y));
        editor.objectArrangeDropdown.AddItem(
            scene_layout_2d.OperationLabel(scene_editor_2d.ARRANGE_DISTRIBUTE_X));
        editor.objectArrangeDropdown.AddItem(
            scene_layout_2d.OperationLabel(scene_editor_2d.ARRANGE_DISTRIBUTE_Y));
        editor.objectArrangeDropdown.SetSelected(scene_editor_2d.ARRANGE_ALIGN_X);
        editor.objectArrangeDropdown.SetFlex(1.0);
        editor.objectArrangeDropdown.SetTooltip(
            "Align to the primary object or distribute authored point positions");
        editor.arrangeObjectButton = GUI.Button.New(editor.objectArrangeRow, "Arrange");
        editor.arrangeObjectButton.SetTooltip(
            "Apply one undoable layout operation to the selected objects");

        editor.colliderInspector.Setup(editor.objectTabHost);
        editor.clipInspector.Setup(editor.objectTabHost);
        editor.objectPropertyLabel =
            GUI.Label.New(editor.objectTabHost, "Object properties");
        editor.objectProperties = new property_rows.PropertyRows();
        editor.objectProperties.Setup(
            editor.objectTabHost,
            ["String", "Integer", "Float", "Boolean", "Null"],
            "New property",
            "object property");
        // Batch editor.mode keeps one explicit remove-by-key affordance beside the
        // shared draft row; single-object rows remove through their own ×.
        editor.removeObjectPropertyButton =
            GUI.Button.New(editor.objectTabHost, "Remove");
        editor.removeObjectPropertyButton.SetTooltip(
            "Remove this property from the current selection");
        editor.removeObjectPropertyButton.SetVisible(false);

        editor.componentPalette.Setup(
            editor.objectTabHost,
            "Project components",
            "2D object component template");
        editor.componentAssetHost =
            GUI.GroupBox.New(editor.objectTabHost, "Component asset field");
        editor.componentAssetBrowser.Setup(
            editor.componentAssetHost,
            "Browse Asset Field...",
            file_utils.AssetKindExtensions("any"),
            "Use In Field Draft");
}

/// @brief Add trailing status rows and publish the initial disabled state.
func FinishInspector(editor: scene_editor_2d.SceneEditor2D,
                     inspector: GUI.VBox) {
        editor.detailLabel = GUI.Label.New(inspector, "");
        editor.detailLabel.SetWordWrap(true);
        editor.SetEditorControlsEnabled(false);
    }
