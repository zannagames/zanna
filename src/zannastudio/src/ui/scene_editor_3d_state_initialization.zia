/// @brief Deterministic initialization layer for retained 3D editor state.
class SceneEditor3DStateInitialization extends PreviousLayer.SceneEditor3DState {
    hide func InitializeState() {
        InitializePrimaryControlState();
        InitializeBakeAndToolbarState();
        InitializeInspectorControlState();
        InitializeProjectPreviewState();
        InitializeSceneViewportState();
        InitializeViewOptionState();
        InitializeHistoryAndGizmoState();
        InitializeSnapAndHierarchyState();
    }

