final ADDITIVE_ENVIRONMENT_LAYERS_SCHEMA_VERSION: Integer = 14;
final RUNTIME_WATER_PREVIEW_3D_SCHEMA_VERSION: Integer = 15;
final MATERIAL_PREVIEW_3D_SCHEMA_VERSION: Integer = 16;
final DIRECT_MODEL_PREVIEW_3D_SCHEMA_VERSION: Integer = 17;
