//
// File: zannastudio/src/ui/scene_component_schema.zia
// Purpose: Load and validate project-defined typed scene-component templates.
// Key invariants:
//   - A malformed, oversized, or racing file publishes no partial components.
//   - Component names are case-insensitively unique and field keys are unique
//     within one component.
//   - Every default is validated against its declared scalar kind before use.
//   - Version-3 object, version-4 scene, version-5 node, version-6 sky/light,
//     version-7 lens/atmosphere, version-8 2D backdrops, version-9 scene
//     environment prefabs, and version-10 post-FX chains are bounded and fail
//     closed.
//   - Limits are below the backing 2D/3D scene metadata limits.
// Ownership/Lifetime: Returned schemas own value-only component/field records.
// Links: zannastudio/src/ui/scene_component_authoring.zia,
//        zannastudio/src/ui/scene_component_authoring_controller.zia,
//        zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/scene_editor_3d.zia,
//        docs/adr/0160-project-scene-component-schemas.md,
//        docs/adr/0197-project-owned-2d-object-preview-profiles.md,
//        docs/adr/0198-project-owned-3d-scene-preview-profiles.md,
//        docs/adr/0199-project-owned-3d-node-prefab-previews.md,
//        docs/adr/0200-project-owned-3d-sky-and-light-preview-rigs.md,
//        docs/adr/0201-project-owned-3d-lens-and-atmosphere-previews.md,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md,
//        docs/adr/0203-project-owned-3d-scene-environment-previews.md,
//        docs/adr/0204-project-owned-3d-post-processing-previews.md
//
//===----------------------------------------------------------------------===//

module scene_component_schema;

bind "../services/safe_io";

bind File = Zanna.IO.File;
bind Path = Zanna.IO.Path;
bind Json = Zanna.Data.Json;
bind Map = Zanna.Collections.Map;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;
bind Parse = Zanna.Core.Parse;
bind Fmt = Zanna.Text.Fmt;

final SCHEMA_FILE_NAME: String = "scene-components.json";
final SCHEMA_VERSION: Integer = 1;
final SCHEMA_VERSION_MAX: Integer = 10;
final OBJECT_PREVIEW_SCHEMA_VERSION: Integer = 3;
final SCENE_PREVIEW_3D_SCHEMA_VERSION: Integer = 4;
final NODE_PREVIEW_3D_SCHEMA_VERSION: Integer = 5;
final SKY_LIGHT_PREVIEW_3D_SCHEMA_VERSION: Integer = 6;
final LENS_ATMOSPHERE_PREVIEW_3D_SCHEMA_VERSION: Integer = 7;
final SCENE_PREVIEW_2D_SCHEMA_VERSION: Integer = 8;
final SCENE_ENVIRONMENT_PREVIEW_3D_SCHEMA_VERSION: Integer = 9;
final SCENE_POSTFX_PREVIEW_3D_SCHEMA_VERSION: Integer = 10;
final MAX_ENUM_CHOICES: Integer = 64;
final MAX_ENUM_CHOICE_CHARS: Integer = 64;
final MAX_ASSET_KINDS: Integer = 4;
final TARGET_2D_OBJECT: String = "2d-object";
final TARGET_3D_NODE: String = "3d-node";
final TARGET_BOTH: String = "both";
final MAX_SCHEMA_BYTES: Integer = 1000000;
final MAX_COMPONENTS: Integer = 128;
final MAX_FIELDS_PER_COMPONENT: Integer = 64;
final MAX_TOTAL_FIELDS: Integer = 2048;
final MAX_COMPONENT_NAME_CHARS: Integer = 64;
final MAX_LABEL_CHARS: Integer = 128;
final MAX_DESCRIPTION_CHARS: Integer = 1024;
final MAX_FIELD_KEY_CHARS: Integer = 128;
final MAX_DEFAULT_STRING_CHARS: Integer = 16384;
final MAX_OBJECT_PREVIEWS: Integer = 128;
final MAX_PREVIEW_SPRITE_CHARS: Integer = 1024;
final MAX_PREVIEW_FRAME_MAP: Integer = 256;
final MAX_PREVIEW_FRAME: Integer = 1000000;
final MIN_PREVIEW_FRAME_OFFSET: Integer = -1000000;
final MAX_PREVIEW_FRAME_OFFSET: Integer = 1000000;
final MAX_NODE_PREVIEWS_3D: Integer = 128;
final MAX_NODE_PREVIEW_VARIANTS: Integer = 256;
final MAX_NODE_PREVIEW_PREFAB_CHARS: Integer = 1024;
final MAX_SCENE_PREVIEW_2D_VARIANTS: Integer = 64;
final MAX_SCENE_PREVIEW_2D_IMAGE_CHARS: Integer = 1024;
final MIN_SCENE_PREVIEW_2D_OFFSET: Integer = -1000000;
final MAX_SCENE_PREVIEW_2D_OFFSET: Integer = 1000000;
final MAX_SCENE_ENVIRONMENT_PREVIEW_VARIANTS: Integer = 64;
final MIN_SCENE_ENVIRONMENT_PREVIEW_OFFSET: Integer = -1000000;
final MAX_SCENE_ENVIRONMENT_PREVIEW_OFFSET: Integer = 1000000;
final BACKGROUND_FIT_COVER: String = "cover";
final BACKGROUND_FIT_CONTAIN: String = "contain";
final BACKGROUND_FIT_STRETCH: String = "stretch";

/// @brief One validated typed field in a project scene-component template.
class SceneComponentField {
    expose String key;
    expose String label;
    expose String kind;
    expose String defaultText;
    expose String description;
    expose List[String] choices;
    expose List[String] assetKinds;

    expose func init() {
        key = "";
        label = "";
        kind = "";
        defaultText = "";
        description = "";
        choices = [];
        assetKinds = [];
    }

    /// @brief Return whether one exact value is a declared enum choice.
    expose func HasChoice(value: String) -> Boolean {
        var index = 0;
        while index < choices.count() {
            if choices.get(index) == value { return true; }
            index = index + 1;
        }
        return false;
    }
}

/// @brief One named project template applicable to 2D objects, 3D nodes, or both.
class SceneComponentDefinition {
    expose String name;
    expose String label;
    expose String target;
    expose String description;
    expose List[SceneComponentField] fields;

    expose func init() {
        name = "";
        label = "";
        target = "";
        description = "";
        fields = [];
    }

    /// @brief Return whether this definition may be applied to one editor target.
    expose func SupportsTarget(requested: String) -> Boolean {
        return target == TARGET_BOTH or target == requested;
    }

    /// @brief Find one exact field key, or null when absent.
    expose func FieldNamed(key: String) -> SceneComponentField {
        var index = 0;
        while index < fields.count() {
            var field = fields.get(index);
            if field != null and field.key == key { return field; }
            index = index + 1;
        }
        return null;
    }
}

/// @brief One deterministic project-owned 2D object visualization rule.
class SceneObjectPreviewDefinition {
    expose String objectType;
    expose String sprite;
    expose Integer frame;
    expose String frameProperty;
    expose Integer frameOffset;
    expose List[Integer] frameMap;

    expose func init() {
        objectType = "";
        sprite = "";
        frame = 0;
        frameProperty = "";
        frameOffset = 0;
        frameMap = [];
    }

    /// @brief Resolve one property value to a bounded atlas frame.
    /// @details Negative, unmapped, or overflowing values use the authored
    ///          fallback frame instead of producing an invalid image lookup.
    expose func FrameForValue(value: Integer) -> Integer {
        if value < 0 { return frame; }
        if frameMap.count() > 0 {
            if value >= frameMap.count() { return frame; }
            return frameMap.get(value);
        }
        var resolved = value + frameOffset;
        if resolved < 0 or resolved > MAX_PREVIEW_FRAME {
            return frame;
        }
        return resolved;
    }
}

/// @brief One bounded project-owned gameplay-like 2D scene backdrop profile.
/// @details Images resolve beside the project schema, not beside scene files.
///          Integer variants are read-only editor presentation conventions.
class ScenePreview2DDefinition {
    expose Boolean present;
    expose String background;
    expose String variantProperty;
    expose Integer variantOffset;
    expose List[String] variantImages;
    expose String fit;
    expose Boolean hasShowGrid;
    expose Boolean showGrid;

    expose func init() {
        present = false;
        background = "";
        variantProperty = "";
        variantOffset = 0;
        variantImages = [];
        fit = BACKGROUND_FIT_COVER;
        hasShowGrid = false;
        showGrid = false;
    }

    /// @brief Resolve one integer variant or the optional fallback image.
    expose func BackgroundForVariant(value: Integer) -> String {
        var index = value + variantOffset;
        if index >= 0 and index < variantImages.count() {
            return variantImages.get(index);
        }
        return background;
    }
}

/// @brief Project root-metadata mappings for a gameplay-like 3D preview.
/// @details Property groups are either complete or absent. The editor reads
///          only typed scalar metadata and never executes project code.
class ScenePreview3DDefinition {
    expose Boolean present;
    expose String startXProperty;
    expose String startYProperty;
    expose String startZProperty;
    expose String startYawProperty;
    expose Boolean hasStartEyeHeight;
    expose Number startEyeHeight;
    expose String ambientRProperty;
    expose String ambientGProperty;
    expose String ambientBProperty;
    expose String clearRProperty;
    expose String clearGProperty;
    expose String clearBProperty;
    expose String fogRProperty;
    expose String fogGProperty;
    expose String fogBProperty;
    expose String fogNearProperty;
    expose String fogFarProperty;
    expose String zenithRProperty;
    expose String zenithGProperty;
    expose String zenithBProperty;
    expose String groundRProperty;
    expose String groundGProperty;
    expose String groundBProperty;
    expose String cloudProperty;
    expose String starsProperty;
    expose String sunXProperty;
    expose String sunYProperty;
    expose String sunZProperty;
    expose String sunRProperty;
    expose String sunGProperty;
    expose String sunBProperty;
    expose String sunIntensityProperty;
    expose String fillXProperty;
    expose String fillYProperty;
    expose String fillZProperty;
    expose String fillRProperty;
    expose String fillGProperty;
    expose String fillBProperty;
    expose String fillIntensityProperty;
    expose Boolean hasCameraFov;
    expose Number cameraFov;
    expose Boolean hasIblIntensity;
    expose Number iblIntensity;
    expose String heightFogProperty;
    expose Boolean hasHeightFogBase;
    expose Number heightFogBase;
    expose Boolean hasHeightFogFalloff;
    expose Number heightFogFalloff;
    expose Boolean hasHeightFogDensity;
    expose Number heightFogDensity;
    expose Boolean hasHeightFogOpacity;
    expose Number heightFogOpacity;
    expose Boolean hasShowGrid;
    expose Boolean showGrid;
    expose Boolean hasShowMarkers;
    expose Boolean showMarkers;
    expose Boolean hasShowLights;
    expose Boolean showLights;
    expose Boolean hasShowCameras;
    expose Boolean showCameras;
    expose Boolean hasShowColliders;
    expose Boolean showColliders;
    expose Boolean hasShowRoutes;
    expose Boolean showRoutes;
    expose String environmentPrefab;
    expose String environmentVariantProperty;
    expose List[String] environmentVariantPrefabs;
    expose Integer environmentVariantOffset;
    expose Boolean hasTonemap;
    expose Integer tonemapMode;
    expose Number tonemapExposure;
    expose Boolean hasBloom;
    expose Number bloomThreshold;
    expose Number bloomIntensity;
    expose Integer bloomPasses;
    expose Boolean hasColorGrade;
    expose Number colorGradeBrightness;
    expose Number colorGradeContrast;
    expose Number colorGradeSaturation;
    expose Boolean hasVignette;
    expose Number vignetteRadius;
    expose Number vignetteSoftness;
    expose Boolean hasFxaa;
    expose Boolean fxaa;

    expose func init() {
        present = false;
        startXProperty = "";
        startYProperty = "";
        startZProperty = "";
        startYawProperty = "";
        hasStartEyeHeight = false;
        startEyeHeight = 0.0;
        ambientRProperty = "";
        ambientGProperty = "";
        ambientBProperty = "";
        clearRProperty = "";
        clearGProperty = "";
        clearBProperty = "";
        fogRProperty = "";
        fogGProperty = "";
        fogBProperty = "";
        fogNearProperty = "";
        fogFarProperty = "";
        zenithRProperty = "";
        zenithGProperty = "";
        zenithBProperty = "";
        groundRProperty = "";
        groundGProperty = "";
        groundBProperty = "";
        cloudProperty = "";
        starsProperty = "";
        sunXProperty = "";
        sunYProperty = "";
        sunZProperty = "";
        sunRProperty = "";
        sunGProperty = "";
        sunBProperty = "";
        sunIntensityProperty = "";
        fillXProperty = "";
        fillYProperty = "";
        fillZProperty = "";
        fillRProperty = "";
        fillGProperty = "";
        fillBProperty = "";
        fillIntensityProperty = "";
        hasCameraFov = false;
        cameraFov = 60.0;
        hasIblIntensity = false;
        iblIntensity = 0.0;
        heightFogProperty = "";
        hasHeightFogBase = false;
        heightFogBase = 0.0;
        hasHeightFogFalloff = false;
        heightFogFalloff = 0.0;
        hasHeightFogDensity = false;
        heightFogDensity = 0.0;
        hasHeightFogOpacity = false;
        heightFogOpacity = 0.0;
        hasShowGrid = false;
        showGrid = false;
        hasShowMarkers = false;
        showMarkers = false;
        hasShowLights = false;
        showLights = false;
        hasShowCameras = false;
        showCameras = false;
        hasShowColliders = false;
        showColliders = false;
        hasShowRoutes = false;
        showRoutes = false;
        environmentPrefab = "";
        environmentVariantProperty = "";
        environmentVariantPrefabs = [];
        environmentVariantOffset = 0;
        hasTonemap = false;
        tonemapMode = 0;
        tonemapExposure = 1.0;
        hasBloom = false;
        bloomThreshold = 0.8;
        bloomIntensity = 1.0;
        bloomPasses = 3;
        hasColorGrade = false;
        colorGradeBrightness = 0.0;
        colorGradeContrast = 1.0;
        colorGradeSaturation = 1.0;
        hasVignette = false;
        vignetteRadius = 0.7;
        vignetteSoftness = 0.3;
        hasFxaa = false;
        fxaa = false;
    }

    expose func HasStart() -> Boolean {
        return startXProperty != "" and startYProperty != ""
            and startZProperty != "";
    }

    expose func HasAmbient() -> Boolean {
        return ambientRProperty != "" and ambientGProperty != ""
            and ambientBProperty != "";
    }

    expose func HasClear() -> Boolean {
        return clearRProperty != "" and clearGProperty != ""
            and clearBProperty != "";
    }

    expose func HasFog() -> Boolean {
        return fogRProperty != "" and fogGProperty != ""
            and fogBProperty != "" and fogNearProperty != ""
            and fogFarProperty != "";
    }

    expose func HasSkyPalette() -> Boolean {
        return HasClear()
            and zenithRProperty != "" and zenithGProperty != ""
            and zenithBProperty != ""
            and groundRProperty != "" and groundGProperty != ""
            and groundBProperty != "";
    }

    expose func HasSun() -> Boolean {
        return sunXProperty != "" and sunYProperty != ""
            and sunZProperty != ""
            and sunRProperty != "" and sunGProperty != ""
            and sunBProperty != "" and sunIntensityProperty != "";
    }

    expose func HasFill() -> Boolean {
        return fillXProperty != "" and fillYProperty != ""
            and fillZProperty != ""
            and fillRProperty != "" and fillGProperty != ""
            and fillBProperty != "" and fillIntensityProperty != "";
    }

    expose func HasHeightFog() -> Boolean {
        return heightFogProperty != ""
            and hasHeightFogBase
            and hasHeightFogFalloff
            and hasHeightFogDensity
            and hasHeightFogOpacity;
    }

    /// @brief Number of enabled deterministic post-processing passes.
    expose func PostFXEffectCount() -> Integer {
        var count = 0;
        if hasTonemap { count = count + 1; }
        if hasBloom { count = count + 1; }
        if hasColorGrade { count = count + 1; }
        if hasVignette { count = count + 1; }
        if hasFxaa and fxaa { count = count + 1; }
        return count;
    }

    /// @brief Return whether this profile owns any active post-processing.
    expose func HasPostFX() -> Boolean {
        return PostFXEffectCount() > 0;
    }

    /// @brief Resolve one root-metadata environment variant or its fallback.
    expose func EnvironmentPrefabForVariant(value: Integer) -> String {
        var index = value + environmentVariantOffset;
        if index >= 0 and index < environmentVariantPrefabs.count() {
            return environmentVariantPrefabs.get(index);
        }
        return environmentPrefab;
    }
}

/// @brief One metadata-matched transient 3D prefab visualization rule.
class SceneNodePreview3DDefinition {
    expose String matchProperty;
    expose String matchValue;
    expose String prefab;
    expose String variantProperty;
    expose List[String] variantPrefabs;
    expose String yawProperty;
    expose String yawUnit;
    expose String scaleProperty;

    expose func init() {
        matchProperty = "";
        matchValue = "";
        prefab = "";
        variantProperty = "";
        variantPrefabs = [];
        yawProperty = "";
        yawUnit = "";
        scaleProperty = "";
    }

    /// @brief Resolve a bounded integer variant or the authored fallback.
    expose func PrefabForVariant(value: Integer) -> String {
        if value >= 0 and value < variantPrefabs.count() {
            return variantPrefabs.get(value);
        }
        return prefab;
    }
}

/// @brief Complete fail-closed result of loading one project schema.
class SceneComponentSchema {
    expose Boolean found;
    expose Boolean valid;
    expose String sourcePath;
    expose String error;
    expose Integer version;
    expose List[SceneComponentDefinition] components;
    expose List[SceneObjectPreviewDefinition] objectPreviews;
    expose ScenePreview2DDefinition scenePreview2D;
    expose ScenePreview3DDefinition scenePreview3D;
    expose List[SceneNodePreview3DDefinition] nodePreviews3D;

    expose func init() {
        found = false;
        valid = true;
        sourcePath = "";
        error = "";
        version = SCHEMA_VERSION;
        components = [];
        objectPreviews = [];
        scenePreview2D = new ScenePreview2DDefinition();
        scenePreview3D = new ScenePreview3DDefinition();
        nodePreviews3D = [];
    }

    /// @brief Count definitions compatible with one editor target.
    expose func CountForTarget(target: String) -> Integer {
        var count = 0;
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    /// @brief Return one compatible component by filtered index.
    expose func AtForTarget(
        target: String,
        filteredIndex: Integer) -> SceneComponentDefinition {
        if filteredIndex < 0 { return null; }
        var seen = 0;
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target) {
                if seen == filteredIndex { return component; }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find a compatible component by case-insensitive stable name.
    expose func Find(name: String,
                     target: String) -> SceneComponentDefinition {
        var folded = Str.ToLower(Str.Trim(name));
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target)
               and Str.ToLower(component.name) == folded {
                return component;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find one project preview rule by case-insensitive object type.
    expose func PreviewForObjectType(
        objectType: String) -> SceneObjectPreviewDefinition {
        var folded = Str.ToLower(Str.Trim(objectType));
        var index = 0;
        while index < objectPreviews.count() {
            var preview = objectPreviews.get(index);
            if preview != null
               and Str.ToLower(preview.objectType) == folded {
                return preview;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find one exact string-metadata 3D node preview rule.
    expose func NodePreview3DForMatch(
        metadataKey: String,
        metadataValue: String) -> SceneNodePreview3DDefinition {
        var index = 0;
        while index < nodePreviews3D.count() {
            var preview = nodePreviews3D.get(index);
            if preview != null
               and preview.matchProperty == metadataKey
               and preview.matchValue == metadataValue {
                return preview;
            }
            index = index + 1;
        }
        return null;
    }
}

/// @brief Return the fixed schema path beneath a workspace root.
expose func PathForRoot(root: String) -> String {
    if root == "" { return ""; }
    return Path.Join(root, SCHEMA_FILE_NAME);
}

/// @brief Load one bounded schema path without propagating filesystem failures.
/// @details Missing files are valid empty configurations. Existing unreadable
///          or oversized files are found-but-invalid so Studio can surface the
///          problem without applying stale definitions.
expose func LoadPath(path: String) -> SceneComponentSchema {
    var empty = new SceneComponentSchema();
    empty.sourcePath = path;
    if path == "" { return empty; }

    var exists = false;
    try {
        exists = File.Exists(path);
    } catch {
        empty.found = true;
        return Reject(empty, "Could not inspect the component schema file.");
    }
    if exists == false { return empty; }

    empty.found = true;
    var read = safe_io.ReadAllTextBounded(path, MAX_SCHEMA_BYTES);
    if read.ok == false {
        return Reject(
            empty,
            "Could not read the component schema within the 1 MB limit.");
    }
    return ParseText(read.text, path);
}

/// @brief Parse one complete schema string into staged value records.
/// @return A valid complete schema, or a fail-closed result with no components.
expose func ParseText(text: String,
                      sourcePath: String) -> SceneComponentSchema {
    var schema = new SceneComponentSchema();
    schema.found = true;
    schema.sourcePath = sourcePath;
    if Str.get_Length(text) > MAX_SCHEMA_BYTES {
        return Reject(schema, "Component schema exceeds the 1 MB limit.");
    }
    if Json.IsValid(text) == false {
        return Reject(schema, "Component schema is not valid JSON.");
    }

    var root = Json.Parse(text);
    if Json.TypeOf(root) != "object" {
        return Reject(schema, "Component schema root must be an object.");
    }
    if Map.Has(root, "version") == false
       or Json.TypeOf(Map.Get(root, "version")) != "number" {
        return Reject(schema, "Component schema requires numeric version 1.");
    }
    var parsedVersion =
        Parse.TryInt(Json.Format(Map.Get(root, "version")));
    if parsedVersion.IsNone
       or parsedVersion.UnwrapI64() < SCHEMA_VERSION
       or parsedVersion.UnwrapI64() > SCHEMA_VERSION_MAX {
        return Reject(schema, "Unsupported component schema version.");
    }
    schema.version = parsedVersion.UnwrapI64();

    var rawComponents = Map.Get(root, "components");
    if rawComponents == null or Json.TypeOf(rawComponents) != "array" {
        return Reject(schema, "Component schema requires a components array.");
    }
    var componentCount = Seq.get_Count(rawComponents);
    if componentCount > MAX_COMPONENTS {
        return Reject(schema, "Component schema exceeds 128 components.");
    }

    var staged: List[SceneComponentDefinition] = [];
    var componentNames = Map.New();
    var totalFields = 0;
    var componentIndex = 0;
    while componentIndex < componentCount {
        var rawComponent = Seq.Get(rawComponents, componentIndex);
        var component = ParseComponent(
            rawComponent, componentIndex, componentNames, schema);
        if component == null { return schema; }
        totalFields = totalFields + component.fields.count();
        if totalFields > MAX_TOTAL_FIELDS {
            return Reject(schema, "Component schema exceeds 2,048 fields.");
        }
        staged.add(component);
        componentIndex = componentIndex + 1;
    }

    schema.components = staged;
    if ParseObjectPreviews(root, schema) == false { return schema; }
    if ParseScenePreview2D(root, schema) == false { return schema; }
    if ParseScenePreview3D(root, schema) == false { return schema; }
    if ParseNodePreviews3D(root, schema) == false { return schema; }
    schema.valid = true;
    schema.error = "";
    return schema;
}

/// @brief Parse optional schema-v5 transient 3D node prefab rules.
func ParseNodePreviews3D(root: Any,
                         schema: SceneComponentSchema) -> Boolean {
    if Map.Has(root, "nodePreviews3D") == false { return true; }
    if schema.version < NODE_PREVIEW_3D_SCHEMA_VERSION {
        Reject(schema, "Project 3D node previews require schema version 5.");
        return false;
    }
    var rawPreviews = Map.Get(root, "nodePreviews3D");
    if rawPreviews == null or Json.TypeOf(rawPreviews) != "array" {
        Reject(schema, "nodePreviews3D must be an array.");
        return false;
    }
    var count = Seq.get_Count(rawPreviews);
    if count > MAX_NODE_PREVIEWS_3D {
        Reject(schema, "Component schema exceeds 128 3D node previews.");
        return false;
    }
    var staged: List[SceneNodePreview3DDefinition] = [];
    var seenMatches = Map.New();
    var index = 0;
    while index < count {
        var preview = ParseNodePreview3D(
            Seq.Get(rawPreviews, index), index, seenMatches, schema);
        if preview == null { return false; }
        staged.add(preview);
        index = index + 1;
    }
    schema.nodePreviews3D = staged;
    return true;
}

/// @brief Validate one metadata match and its bounded prefab variants.
func ParseNodePreview3D(
    raw: Any,
    index: Integer,
    seenMatches: Any,
    schema: SceneComponentSchema) -> SceneNodePreview3DDefinition {
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(schema, "3D node preview " + index + " must be an object.");
        return null;
    }
    var preview = new SceneNodePreview3DDefinition();
    preview.matchProperty = Str.Trim(Map.GetStr(raw, "matchProperty"));
    preview.matchValue = Str.Trim(Map.GetStr(raw, "matchValue"));
    if PortableIdentifier(
           preview.matchProperty, MAX_FIELD_KEY_CHARS) == false {
        Reject(
            schema,
            "3D node preview " + index
                + " requires a portable matchProperty.");
        return null;
    }
    if PortableIdentifier(
           preview.matchValue, MAX_FIELD_KEY_CHARS) == false {
        Reject(
            schema,
            "3D node preview " + index
                + " requires a portable matchValue.");
        return null;
    }
    var matchKey = preview.matchProperty + "\n" + preview.matchValue;
    if Map.Has(seenMatches, matchKey) {
        Reject(
            schema,
            "Duplicate 3D node preview match \""
                + preview.matchProperty + "=" + preview.matchValue + "\".");
        return null;
    }
    Map.SetBool(seenMatches, matchKey, true);

    if Map.Has(raw, "prefab") {
        if Json.TypeOf(Map.Get(raw, "prefab")) != "string" {
            Reject(schema, "3D node preview prefab must be a string.");
            return null;
        }
        preview.prefab = Str.Trim(Map.GetStr(raw, "prefab"));
        if PortablePreviewPrefab(preview.prefab) == false {
            Reject(
                schema,
                "3D node preview prefab must be a safe project-relative "
                + ".scene3d or .vscn path.");
            return null;
        }
    }

    var hasVariantProperty = Map.Has(raw, "variantProperty");
    var hasVariantPrefabs = Map.Has(raw, "variantPrefabs");
    if hasVariantProperty != hasVariantPrefabs {
        Reject(
            schema,
            "3D node preview variantProperty and variantPrefabs "
                + "must be supplied together.");
        return null;
    }
    if hasVariantProperty {
        if Json.TypeOf(Map.Get(raw, "variantProperty")) != "string" {
            Reject(
                schema,
                "3D node preview variantProperty must be a string.");
            return null;
        }
        preview.variantProperty =
            Str.Trim(Map.GetStr(raw, "variantProperty"));
        if PortableIdentifier(
               preview.variantProperty, MAX_FIELD_KEY_CHARS) == false {
            Reject(
                schema,
                "3D node preview variantProperty must be a portable key.");
            return null;
        }
        var variants = Map.Get(raw, "variantPrefabs");
        if variants == null or Json.TypeOf(variants) != "array" {
            Reject(
                schema,
                "3D node preview variantPrefabs must be an array.");
            return null;
        }
        var variantCount = Seq.get_Count(variants);
        if variantCount <= 0
           or variantCount > MAX_NODE_PREVIEW_VARIANTS {
            Reject(
                schema,
                "3D node preview requires between 1 and 256 variants.");
            return null;
        }
        var variantIndex = 0;
        while variantIndex < variantCount {
            var rawPath = Seq.Get(variants, variantIndex);
            if rawPath == null or Json.TypeOf(rawPath) != "string" {
                Reject(
                    schema,
                    "3D node preview variant paths must be strings.");
                return null;
            }
            var path = Str.Trim(Seq.GetStr(variants, variantIndex));
            if PortablePreviewPrefab(path) == false {
                Reject(
                    schema,
                    "3D node preview variants must be safe "
                    + "project-relative scene paths.");
                return null;
            }
            preview.variantPrefabs.add(path);
            variantIndex = variantIndex + 1;
        }
    }
    var hasYawProperty = Map.Has(raw, "yawProperty");
    var hasYawUnit = Map.Has(raw, "yawUnit");
    if hasYawProperty != hasYawUnit {
        Reject(
            schema,
            "3D node preview yawProperty and yawUnit "
                + "must be supplied together.");
        return null;
    }
    if hasYawProperty {
        if Json.TypeOf(Map.Get(raw, "yawProperty")) != "string"
           or Json.TypeOf(Map.Get(raw, "yawUnit")) != "string" {
            Reject(
                schema,
                "3D node preview yawProperty/yawUnit must be strings.");
            return null;
        }
        preview.yawProperty =
            Str.Trim(Map.GetStr(raw, "yawProperty"));
        preview.yawUnit =
            Str.ToLower(Str.Trim(Map.GetStr(raw, "yawUnit")));
        if PortableIdentifier(
               preview.yawProperty, MAX_FIELD_KEY_CHARS) == false
           or (preview.yawUnit != "degrees"
               and preview.yawUnit != "radians") {
            Reject(
                schema,
                "3D node preview yaw requires a portable property and "
                + "degrees or radians unit.");
            return null;
        }
    }
    if Map.Has(raw, "scaleProperty") {
        if Json.TypeOf(Map.Get(raw, "scaleProperty")) != "string" {
            Reject(
                schema,
                "3D node preview scaleProperty must be a string.");
            return null;
        }
        preview.scaleProperty =
            Str.Trim(Map.GetStr(raw, "scaleProperty"));
        if PortableIdentifier(
               preview.scaleProperty, MAX_FIELD_KEY_CHARS) == false {
            Reject(
                schema,
                "3D node preview scaleProperty must be a portable key.");
            return null;
        }
    }
    if preview.prefab == "" and preview.variantPrefabs.count() == 0 {
        Reject(
            schema,
            "3D node preview requires a prefab or variantPrefabs.");
        return null;
    }
    return preview;
}

/// @brief Validate one project-relative VSCN preview reference.
func PortablePreviewPrefab(value: String) -> Boolean {
    var length = Str.get_Length(value);
    if length <= 0 or length > MAX_NODE_PREVIEW_PREFAB_CHARS {
        return false;
    }
    if Path.IsAbsolute(value)
       or Str.Contains(value, "\\")
       or Str.Contains(value, ":")
       or value == ".."
       or Str.StartsWith(value, "../")
       or Str.Contains(value, "/../")
       or Str.EndsWith(value, "/..") {
        return false;
    }
    var folded = Str.ToLower(value);
    return Str.EndsWith(folded, ".scene3d")
        or Str.EndsWith(folded, ".vscn");
}

/// @brief Validate one project-root-relative 2D preview image reference.
func PortablePreviewImage(value: String) -> Boolean {
    var length = Str.get_Length(value);
    if length <= 0 or length > MAX_SCENE_PREVIEW_2D_IMAGE_CHARS {
        return false;
    }
    if Path.IsAbsolute(value)
       or Str.Contains(value, "\\")
       or Str.Contains(value, ":")
       or value == ".."
       or Str.StartsWith(value, "../")
       or Str.Contains(value, "/../")
       or Str.EndsWith(value, "/..") {
        return false;
    }
    var folded = Str.ToLower(value);
    return Str.EndsWith(folded, ".png")
        or Str.EndsWith(folded, ".jpg")
        or Str.EndsWith(folded, ".jpeg")
        or Str.EndsWith(folded, ".bmp")
        or Str.EndsWith(folded, ".gif");
}

/// @brief Parse the optional schema-v4 project 3D preview profile.
func ParseScenePreview3D(root: Any,
                         schema: SceneComponentSchema) -> Boolean {
    if Map.Has(root, "scenePreview3D") == false { return true; }
    if schema.version < SCENE_PREVIEW_3D_SCHEMA_VERSION {
        Reject(schema, "Project 3D previews require schema version 4.");
        return false;
    }
    var raw = Map.Get(root, "scenePreview3D");
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(schema, "scenePreview3D must be an object.");
        return false;
    }
    var versionSixNames: List[String] = [
        "zenithRProperty", "zenithGProperty", "zenithBProperty",
        "groundRProperty", "groundGProperty", "groundBProperty",
        "cloudProperty", "starsProperty",
        "sunXProperty", "sunYProperty", "sunZProperty",
        "sunRProperty", "sunGProperty", "sunBProperty",
        "sunIntensityProperty",
        "fillXProperty", "fillYProperty", "fillZProperty",
        "fillRProperty", "fillGProperty", "fillBProperty",
        "fillIntensityProperty"
    ];
    var versionSixIndex = 0;
    while versionSixIndex < versionSixNames.count() {
        if Map.Has(raw, versionSixNames.get(versionSixIndex))
           and schema.version < SKY_LIGHT_PREVIEW_3D_SCHEMA_VERSION {
            Reject(
                schema,
                "Project 3D sky/light previews require schema version 6.");
            return false;
        }
        versionSixIndex = versionSixIndex + 1;
    }
    var versionSevenNames: List[String] = [
        "cameraFov", "iblIntensity", "heightFogProperty",
        "heightFogBase", "heightFogFalloff",
        "heightFogDensity", "heightFogOpacity"
    ];
    var versionSevenIndex = 0;
    while versionSevenIndex < versionSevenNames.count() {
        if Map.Has(raw, versionSevenNames.get(versionSevenIndex))
           and schema.version
               < LENS_ATMOSPHERE_PREVIEW_3D_SCHEMA_VERSION {
            Reject(
                schema,
                "Project 3D lens/atmosphere previews require "
                    + "schema version 7.");
            return false;
        }
        versionSevenIndex = versionSevenIndex + 1;
    }
    var versionNineNames: List[String] = [
        "environmentPrefab",
        "environmentVariantProperty",
        "environmentVariantPrefabs",
        "environmentVariantOffset"
    ];
    var versionNineIndex = 0;
    while versionNineIndex < versionNineNames.count() {
        if Map.Has(raw, versionNineNames.get(versionNineIndex))
           and schema.version
               < SCENE_ENVIRONMENT_PREVIEW_3D_SCHEMA_VERSION {
            Reject(
                schema,
                "Project 3D scene environment previews require "
                    + "schema version 9.");
            return false;
        }
        versionNineIndex = versionNineIndex + 1;
    }
    var versionTenNames: List[String] = [
        "tonemapMode", "tonemapExposure",
        "bloomThreshold", "bloomIntensity", "bloomPasses",
        "colorGradeBrightness", "colorGradeContrast",
        "colorGradeSaturation",
        "vignetteRadius", "vignetteSoftness",
        "fxaa"
    ];
    var versionTenIndex = 0;
    while versionTenIndex < versionTenNames.count() {
        if Map.Has(raw, versionTenNames.get(versionTenIndex))
           and schema.version
               < SCENE_POSTFX_PREVIEW_3D_SCHEMA_VERSION {
            Reject(
                schema,
                "Project 3D post-processing previews require "
                    + "schema version 10.");
            return false;
        }
        versionTenIndex = versionTenIndex + 1;
    }

    var profile = new ScenePreview3DDefinition();
    if ParseSceneEnvironmentPreview3D(
           raw, profile, schema) == false {
        return false;
    }
    if ParseScenePostFXPreview3D(raw, profile, schema) == false {
        return false;
    }
    profile.startXProperty =
        ParsePreview3DProperty(raw, "startXProperty", schema);
    profile.startYProperty =
        ParsePreview3DProperty(raw, "startYProperty", schema);
    profile.startZProperty =
        ParsePreview3DProperty(raw, "startZProperty", schema);
    profile.startYawProperty =
        ParsePreview3DProperty(raw, "startYawProperty", schema);
    profile.ambientRProperty =
        ParsePreview3DProperty(raw, "ambientRProperty", schema);
    profile.ambientGProperty =
        ParsePreview3DProperty(raw, "ambientGProperty", schema);
    profile.ambientBProperty =
        ParsePreview3DProperty(raw, "ambientBProperty", schema);
    profile.clearRProperty =
        ParsePreview3DProperty(raw, "clearRProperty", schema);
    profile.clearGProperty =
        ParsePreview3DProperty(raw, "clearGProperty", schema);
    profile.clearBProperty =
        ParsePreview3DProperty(raw, "clearBProperty", schema);
    profile.fogRProperty =
        ParsePreview3DProperty(raw, "fogRProperty", schema);
    profile.fogGProperty =
        ParsePreview3DProperty(raw, "fogGProperty", schema);
    profile.fogBProperty =
        ParsePreview3DProperty(raw, "fogBProperty", schema);
    profile.fogNearProperty =
        ParsePreview3DProperty(raw, "fogNearProperty", schema);
    profile.fogFarProperty =
        ParsePreview3DProperty(raw, "fogFarProperty", schema);
    profile.zenithRProperty =
        ParsePreview3DProperty(raw, "zenithRProperty", schema);
    profile.zenithGProperty =
        ParsePreview3DProperty(raw, "zenithGProperty", schema);
    profile.zenithBProperty =
        ParsePreview3DProperty(raw, "zenithBProperty", schema);
    profile.groundRProperty =
        ParsePreview3DProperty(raw, "groundRProperty", schema);
    profile.groundGProperty =
        ParsePreview3DProperty(raw, "groundGProperty", schema);
    profile.groundBProperty =
        ParsePreview3DProperty(raw, "groundBProperty", schema);
    profile.cloudProperty =
        ParsePreview3DProperty(raw, "cloudProperty", schema);
    profile.starsProperty =
        ParsePreview3DProperty(raw, "starsProperty", schema);
    profile.sunXProperty =
        ParsePreview3DProperty(raw, "sunXProperty", schema);
    profile.sunYProperty =
        ParsePreview3DProperty(raw, "sunYProperty", schema);
    profile.sunZProperty =
        ParsePreview3DProperty(raw, "sunZProperty", schema);
    profile.sunRProperty =
        ParsePreview3DProperty(raw, "sunRProperty", schema);
    profile.sunGProperty =
        ParsePreview3DProperty(raw, "sunGProperty", schema);
    profile.sunBProperty =
        ParsePreview3DProperty(raw, "sunBProperty", schema);
    profile.sunIntensityProperty =
        ParsePreview3DProperty(raw, "sunIntensityProperty", schema);
    profile.fillXProperty =
        ParsePreview3DProperty(raw, "fillXProperty", schema);
    profile.fillYProperty =
        ParsePreview3DProperty(raw, "fillYProperty", schema);
    profile.fillZProperty =
        ParsePreview3DProperty(raw, "fillZProperty", schema);
    profile.fillRProperty =
        ParsePreview3DProperty(raw, "fillRProperty", schema);
    profile.fillGProperty =
        ParsePreview3DProperty(raw, "fillGProperty", schema);
    profile.fillBProperty =
        ParsePreview3DProperty(raw, "fillBProperty", schema);
    profile.fillIntensityProperty =
        ParsePreview3DProperty(raw, "fillIntensityProperty", schema);
    profile.heightFogProperty =
        ParsePreview3DProperty(raw, "heightFogProperty", schema);
    if schema.valid == false { return false; }

    if ParsePreview3DNumber(
           raw, "cameraFov", 1.0, 179.0, profile, schema) == false
       or ParsePreview3DNumber(
           raw, "iblIntensity", 0.0, 8.0, profile, schema) == false
       or ParsePreview3DNumber(
           raw, "heightFogBase",
           -1000000.0, 1000000.0, profile, schema) == false
       or ParsePreview3DNumber(
           raw, "heightFogFalloff",
           0.0, 100.0, profile, schema) == false
       or ParsePreview3DNumber(
           raw, "heightFogDensity",
           0.0, 100.0, profile, schema) == false
       or ParsePreview3DNumber(
           raw, "heightFogOpacity",
           0.0, 1.0, profile, schema) == false {
        return false;
    }

    var startCount = PresentCount3(
        profile.startXProperty,
        profile.startYProperty,
        profile.startZProperty);
    if startCount != 0 and startCount != 3 {
        Reject(
            schema,
            "scenePreview3D start X/Y/Z properties must be complete.");
        return false;
    }
    if profile.startYawProperty != "" and startCount != 3 {
        Reject(
            schema,
            "scenePreview3D start yaw requires complete X/Y/Z properties.");
        return false;
    }
    if Map.Has(raw, "startEyeHeight") {
        var rawEyeHeight = Map.Get(raw, "startEyeHeight");
        if Json.TypeOf(rawEyeHeight) != "number" {
            Reject(
                schema,
                "scenePreview3D startEyeHeight must be a number.");
            return false;
        }
        var parsedEyeHeight =
            Parse.TryDouble(Json.Format(rawEyeHeight));
        if parsedEyeHeight.IsNone
           or parsedEyeHeight.UnwrapF64() < -1000.0
           or parsedEyeHeight.UnwrapF64() > 1000.0 {
            Reject(
                schema,
                "scenePreview3D startEyeHeight must be between "
                + "-1,000 and 1,000.");
            return false;
        }
        if startCount != 3 or profile.startYawProperty == "" {
            Reject(
                schema,
                "scenePreview3D startEyeHeight requires complete "
                + "start X/Y/Z/yaw properties.");
            return false;
        }
        profile.hasStartEyeHeight = true;
        profile.startEyeHeight = parsedEyeHeight.UnwrapF64();
    }
    var ambientCount = PresentCount3(
        profile.ambientRProperty,
        profile.ambientGProperty,
        profile.ambientBProperty);
    if ambientCount != 0 and ambientCount != 3 {
        Reject(
            schema,
            "scenePreview3D ambient RGB properties must be complete.");
        return false;
    }
    var clearCount = PresentCount3(
        profile.clearRProperty,
        profile.clearGProperty,
        profile.clearBProperty);
    if clearCount != 0 and clearCount != 3 {
        Reject(
            schema,
            "scenePreview3D clear RGB properties must be complete.");
        return false;
    }
    var fogCount =
        PresentCount3(
            profile.fogRProperty,
            profile.fogGProperty,
            profile.fogBProperty);
    if profile.fogNearProperty != "" { fogCount = fogCount + 1; }
    if profile.fogFarProperty != "" { fogCount = fogCount + 1; }
    if fogCount != 0 and fogCount != 5 {
        Reject(
            schema,
            "scenePreview3D fog RGB/near/far properties must be complete.");
        return false;
    }
    var skyCount =
        PresentCount3(
            profile.zenithRProperty,
            profile.zenithGProperty,
            profile.zenithBProperty)
        + PresentCount3(
            profile.groundRProperty,
            profile.groundGProperty,
            profile.groundBProperty);
    if skyCount != 0
       and (skyCount != 6 or clearCount != 3) {
        Reject(
            schema,
            "scenePreview3D sky zenith/ground/horizon RGB properties "
                + "must be complete.");
        return false;
    }
    if (profile.cloudProperty != ""
        or profile.starsProperty != "")
       and skyCount != 6 {
        Reject(
            schema,
            "scenePreview3D cloud/stars properties require a complete "
                + "sky palette.");
        return false;
    }
    var sunCount =
        PresentCount3(
            profile.sunXProperty,
            profile.sunYProperty,
            profile.sunZProperty)
        + PresentCount3(
            profile.sunRProperty,
            profile.sunGProperty,
            profile.sunBProperty);
    if profile.sunIntensityProperty != "" {
        sunCount = sunCount + 1;
    }
    if sunCount != 0 and sunCount != 7 {
        Reject(
            schema,
            "scenePreview3D sun direction/RGB/intensity properties "
                + "must be complete.");
        return false;
    }
    var fillCount =
        PresentCount3(
            profile.fillXProperty,
            profile.fillYProperty,
            profile.fillZProperty)
        + PresentCount3(
            profile.fillRProperty,
            profile.fillGProperty,
            profile.fillBProperty);
    if profile.fillIntensityProperty != "" {
        fillCount = fillCount + 1;
    }
    if fillCount != 0 and fillCount != 7 {
        Reject(
            schema,
            "scenePreview3D fill direction/RGB/intensity properties "
                + "must be complete.");
        return false;
    }
    if profile.hasIblIntensity and skyCount != 6 {
        Reject(
            schema,
            "scenePreview3D iblIntensity requires a complete sky palette.");
        return false;
    }
    var heightFogCount = 0;
    if profile.heightFogProperty != "" {
        heightFogCount = heightFogCount + 1;
    }
    if profile.hasHeightFogBase {
        heightFogCount = heightFogCount + 1;
    }
    if profile.hasHeightFogFalloff {
        heightFogCount = heightFogCount + 1;
    }
    if profile.hasHeightFogDensity {
        heightFogCount = heightFogCount + 1;
    }
    if profile.hasHeightFogOpacity {
        heightFogCount = heightFogCount + 1;
    }
    if heightFogCount != 0 and heightFogCount != 5 {
        Reject(
            schema,
            "scenePreview3D height fog property/base/falloff/density/"
                + "opacity members must be complete.");
        return false;
    }

    var booleanNames: List[String] = [
        "showGrid",
        "showMarkers",
        "showLights",
        "showCameras",
        "showColliders",
        "showRoutes"
    ];
    var booleanIndex = 0;
    while booleanIndex < booleanNames.count() {
        if ParsePreview3DBoolean(
               raw,
               booleanNames.get(booleanIndex),
               profile,
               schema) == false {
            return false;
        }
        booleanIndex = booleanIndex + 1;
    }
    profile.present = true;
    schema.scenePreview3D = profile;
    return true;
}

/// @brief Parse one optional schema-v9 transient scene-environment prefab.
/// @details Paths remain project-relative and variants resolve only from exact
///          integer root metadata; no project code executes in Studio.
func ParseSceneEnvironmentPreview3D(
    raw: Any,
    profile: ScenePreview3DDefinition,
    schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, "environmentPrefab") {
        if Json.TypeOf(Map.Get(raw, "environmentPrefab")) != "string" {
            Reject(
                schema,
                "scenePreview3D environmentPrefab must be a string.");
            return false;
        }
        profile.environmentPrefab =
            Str.Trim(Map.GetStr(raw, "environmentPrefab"));
        if PortablePreviewPrefab(profile.environmentPrefab) == false {
            Reject(
                schema,
                "scenePreview3D environmentPrefab must be a safe "
                    + "project-relative scene path.");
            return false;
        }
    }

    var hasVariantProperty =
        Map.Has(raw, "environmentVariantProperty");
    var hasVariantPrefabs =
        Map.Has(raw, "environmentVariantPrefabs");
    if hasVariantProperty != hasVariantPrefabs {
        Reject(
            schema,
            "scenePreview3D environmentVariantProperty and "
                + "environmentVariantPrefabs must be supplied together.");
        return false;
    }
    if hasVariantProperty {
        if Json.TypeOf(
               Map.Get(raw, "environmentVariantProperty")) != "string" {
            Reject(
                schema,
                "scenePreview3D environmentVariantProperty "
                    + "must be a string.");
            return false;
        }
        profile.environmentVariantProperty =
            Str.Trim(Map.GetStr(raw, "environmentVariantProperty"));
        if PortableIdentifier(
               profile.environmentVariantProperty,
               MAX_FIELD_KEY_CHARS) == false {
            Reject(
                schema,
                "scenePreview3D environmentVariantProperty "
                    + "must be a portable key.");
            return false;
        }
        var variants =
            Map.Get(raw, "environmentVariantPrefabs");
        if variants == null or Json.TypeOf(variants) != "array" {
            Reject(
                schema,
                "scenePreview3D environmentVariantPrefabs "
                    + "must be an array.");
            return false;
        }
        var count = Seq.get_Count(variants);
        if count <= 0
           or count > MAX_SCENE_ENVIRONMENT_PREVIEW_VARIANTS {
            Reject(
                schema,
                "scenePreview3D requires between 1 and 64 "
                    + "environment variants.");
            return false;
        }
        var index = 0;
        while index < count {
            var rawPath = Seq.Get(variants, index);
            if rawPath == null
               or Json.TypeOf(rawPath) != "string" {
                Reject(
                    schema,
                    "scenePreview3D environment variant paths "
                        + "must be strings.");
                return false;
            }
            var path = Str.Trim(Seq.GetStr(variants, index));
            if PortablePreviewPrefab(path) == false {
                Reject(
                    schema,
                    "scenePreview3D environment variants must be "
                        + "safe project-relative scene paths.");
                return false;
            }
            profile.environmentVariantPrefabs.add(path);
            index = index + 1;
        }
    }
    if Map.Has(raw, "environmentVariantOffset") {
        if hasVariantPrefabs == false
           or Json.TypeOf(
               Map.Get(raw, "environmentVariantOffset")) != "number" {
            Reject(
                schema,
                "scenePreview3D environmentVariantOffset requires "
                    + "variant prefabs and must be an integer.");
            return false;
        }
        var parsed = Parse.TryInt(
            Json.Format(Map.Get(raw, "environmentVariantOffset")));
        if parsed.IsNone
           or parsed.UnwrapI64()
              < MIN_SCENE_ENVIRONMENT_PREVIEW_OFFSET
           or parsed.UnwrapI64()
              > MAX_SCENE_ENVIRONMENT_PREVIEW_OFFSET {
            Reject(
                schema,
                "scenePreview3D environmentVariantOffset "
                    + "exceeds the supported range.");
            return false;
        }
        profile.environmentVariantOffset = parsed.UnwrapI64();
    }
    return true;
}

/// @brief Parse deterministic schema-v10 viewport post-processing passes.
/// @details Each parameter group is complete or absent. The fixed chain order
///          matches the portable runtime path and excludes depth-dependent
///          effects whose availability differs by backend.
func ParseScenePostFXPreview3D(
    raw: Any,
    profile: ScenePreview3DDefinition,
    schema: SceneComponentSchema) -> Boolean {
    var hasTonemapMode = Map.Has(raw, "tonemapMode");
    var hasTonemapExposure = Map.Has(raw, "tonemapExposure");
    if hasTonemapMode != hasTonemapExposure {
        Reject(
            schema,
            "scenePreview3D tonemapMode and tonemapExposure "
                + "must be supplied together.");
        return false;
    }
    if hasTonemapMode {
        if ParsePreview3DInteger(
               raw, "tonemapMode", 0, 2, profile, schema) == false
           or ParsePreview3DNumber(
               raw, "tonemapExposure", 0.0, 16.0,
               profile, schema) == false {
            return false;
        }
        profile.hasTonemap = true;
    }

    var hasBloomThreshold = Map.Has(raw, "bloomThreshold");
    var hasBloomIntensity = Map.Has(raw, "bloomIntensity");
    var hasBloomPasses = Map.Has(raw, "bloomPasses");
    var bloomCount = 0;
    if hasBloomThreshold { bloomCount = bloomCount + 1; }
    if hasBloomIntensity { bloomCount = bloomCount + 1; }
    if hasBloomPasses { bloomCount = bloomCount + 1; }
    if bloomCount != 0 and bloomCount != 3 {
        Reject(
            schema,
            "scenePreview3D bloom threshold/intensity/passes "
                + "must be complete.");
        return false;
    }
    if bloomCount == 3 {
        if ParsePreview3DNumber(
               raw, "bloomThreshold", 0.0, 16.0,
               profile, schema) == false
           or ParsePreview3DNumber(
               raw, "bloomIntensity", 0.0, 16.0,
               profile, schema) == false
           or ParsePreview3DInteger(
               raw, "bloomPasses", 0, 32,
               profile, schema) == false {
            return false;
        }
        profile.hasBloom = true;
    }

    var hasGradeBrightness =
        Map.Has(raw, "colorGradeBrightness");
    var hasGradeContrast =
        Map.Has(raw, "colorGradeContrast");
    var hasGradeSaturation =
        Map.Has(raw, "colorGradeSaturation");
    var gradeCount = 0;
    if hasGradeBrightness { gradeCount = gradeCount + 1; }
    if hasGradeContrast { gradeCount = gradeCount + 1; }
    if hasGradeSaturation { gradeCount = gradeCount + 1; }
    if gradeCount != 0 and gradeCount != 3 {
        Reject(
            schema,
            "scenePreview3D color-grade brightness/contrast/saturation "
                + "must be complete.");
        return false;
    }
    if gradeCount == 3 {
        if ParsePreview3DNumber(
               raw, "colorGradeBrightness", -1.0, 1.0,
               profile, schema) == false
           or ParsePreview3DNumber(
               raw, "colorGradeContrast", 0.0, 4.0,
               profile, schema) == false
           or ParsePreview3DNumber(
               raw, "colorGradeSaturation", 0.0, 4.0,
               profile, schema) == false {
            return false;
        }
        profile.hasColorGrade = true;
    }

    var hasVignetteRadius = Map.Has(raw, "vignetteRadius");
    var hasVignetteSoftness = Map.Has(raw, "vignetteSoftness");
    if hasVignetteRadius != hasVignetteSoftness {
        Reject(
            schema,
            "scenePreview3D vignetteRadius and vignetteSoftness "
                + "must be supplied together.");
        return false;
    }
    if hasVignetteRadius {
        if ParsePreview3DNumber(
               raw, "vignetteRadius", 0.0, 1.0,
               profile, schema) == false
           or ParsePreview3DNumber(
               raw, "vignetteSoftness", 0.001, 1.0,
               profile, schema) == false {
            return false;
        }
        profile.hasVignette = true;
    }

    if Map.Has(raw, "fxaa") {
        if Json.TypeOf(Map.Get(raw, "fxaa")) != "boolean" {
            Reject(schema, "scenePreview3D fxaa must be a boolean.");
            return false;
        }
        profile.hasFxaa = true;
        profile.fxaa = Map.GetBool(raw, "fxaa");
    }
    return true;
}

/// @brief Parse one optional portable metadata key from a 3D preview profile.
func ParsePreview3DProperty(raw: Any,
                            name: String,
                            schema: SceneComponentSchema) -> String {
    if Map.Has(raw, name) == false { return ""; }
    if Json.TypeOf(Map.Get(raw, name)) != "string" {
        Reject(
            schema,
            "scenePreview3D " + name + " must be a string.");
        return "";
    }
    var value = Str.Trim(Map.GetStr(raw, name));
    if PortableIdentifier(value, MAX_FIELD_KEY_CHARS) == false {
        Reject(
            schema,
            "scenePreview3D " + name
                + " must be a portable key of at most 128 characters.");
        return "";
    }
    return value;
}

/// @brief Parse one bounded schema-v7 preview scalar into its typed slot.
func ParsePreview3DNumber(
    raw: Any,
    name: String,
    minimum: Number,
    maximum: Number,
    profile: ScenePreview3DDefinition,
    schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, name) == false { return true; }
    if Json.TypeOf(Map.Get(raw, name)) != "number" {
        Reject(
            schema,
            "scenePreview3D " + name + " must be a number.");
        return false;
    }
    var parsed = Parse.TryDouble(Json.Format(Map.Get(raw, name)));
    if parsed.IsNone
       or parsed.UnwrapF64() < minimum
       or parsed.UnwrapF64() > maximum {
        Reject(
            schema,
            "scenePreview3D " + name + " is outside its supported range.");
        return false;
    }
    var value = parsed.UnwrapF64();
    if name == "cameraFov" {
        profile.hasCameraFov = true;
        profile.cameraFov = value;
    } else if name == "iblIntensity" {
        profile.hasIblIntensity = true;
        profile.iblIntensity = value;
    } else if name == "heightFogBase" {
        profile.hasHeightFogBase = true;
        profile.heightFogBase = value;
    } else if name == "heightFogFalloff" {
        profile.hasHeightFogFalloff = true;
        profile.heightFogFalloff = value;
    } else if name == "heightFogDensity" {
        profile.hasHeightFogDensity = true;
        profile.heightFogDensity = value;
    } else if name == "heightFogOpacity" {
        profile.hasHeightFogOpacity = true;
        profile.heightFogOpacity = value;
    } else if name == "tonemapExposure" {
        profile.tonemapExposure = value;
    } else if name == "bloomThreshold" {
        profile.bloomThreshold = value;
    } else if name == "bloomIntensity" {
        profile.bloomIntensity = value;
    } else if name == "colorGradeBrightness" {
        profile.colorGradeBrightness = value;
    } else if name == "colorGradeContrast" {
        profile.colorGradeContrast = value;
    } else if name == "colorGradeSaturation" {
        profile.colorGradeSaturation = value;
    } else if name == "vignetteRadius" {
        profile.vignetteRadius = value;
    } else if name == "vignetteSoftness" {
        profile.vignetteSoftness = value;
    } else {
        Reject(schema, "Unsupported numeric 3D preview member.");
        return false;
    }
    return true;
}

/// @brief Parse one exact bounded schema-v10 post-processing integer.
func ParsePreview3DInteger(
    raw: Any,
    name: String,
    minimum: Integer,
    maximum: Integer,
    profile: ScenePreview3DDefinition,
    schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, name) == false { return true; }
    if Json.TypeOf(Map.Get(raw, name)) != "number" {
        Reject(
            schema,
            "scenePreview3D " + name + " must be an integer.");
        return false;
    }
    var parsed = Parse.TryInt(Json.Format(Map.Get(raw, name)));
    if parsed.IsNone
       or parsed.UnwrapI64() < minimum
       or parsed.UnwrapI64() > maximum {
        Reject(
            schema,
            "scenePreview3D " + name
                + " is outside its supported integer range.");
        return false;
    }
    if name == "tonemapMode" {
        profile.tonemapMode = parsed.UnwrapI64();
    } else if name == "bloomPasses" {
        profile.bloomPasses = parsed.UnwrapI64();
    } else {
        Reject(schema, "Unsupported integer 3D preview member.");
        return false;
    }
    return true;
}

/// @brief Count non-empty members in one three-key property group.
func PresentCount3(a: String,
                   b: String,
                   c: String) -> Integer {
    var count = 0;
    if a != "" { count = count + 1; }
    if b != "" { count = count + 1; }
    if c != "" { count = count + 1; }
    return count;
}

/// @brief Parse one optional 3D preview visibility default.
func ParsePreview3DBoolean(
    raw: Any,
    name: String,
    profile: ScenePreview3DDefinition,
    schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, name) == false { return true; }
    if Json.TypeOf(Map.Get(raw, name)) != "boolean" {
        Reject(
            schema,
            "scenePreview3D " + name + " must be a boolean.");
        return false;
    }
    var value = Map.GetBool(raw, name);
    if name == "showGrid" {
        profile.hasShowGrid = true;
        profile.showGrid = value;
    } else if name == "showMarkers" {
        profile.hasShowMarkers = true;
        profile.showMarkers = value;
    } else if name == "showLights" {
        profile.hasShowLights = true;
        profile.showLights = value;
    } else if name == "showCameras" {
        profile.hasShowCameras = true;
        profile.showCameras = value;
    } else if name == "showColliders" {
        profile.hasShowColliders = true;
        profile.showColliders = value;
    } else {
        profile.hasShowRoutes = true;
        profile.showRoutes = value;
    }
    return true;
}

/// @brief Parse the optional schema-v8 project 2D scene backdrop profile.
func ParseScenePreview2D(root: Any,
                         schema: SceneComponentSchema) -> Boolean {
    if Map.Has(root, "scenePreview2D") == false { return true; }
    if schema.version < SCENE_PREVIEW_2D_SCHEMA_VERSION {
        Reject(schema, "Project 2D scene previews require schema version 8.");
        return false;
    }
    var raw = Map.Get(root, "scenePreview2D");
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(schema, "scenePreview2D must be an object.");
        return false;
    }

    var profile = new ScenePreview2DDefinition();
    if Map.Has(raw, "background") {
        if Json.TypeOf(Map.Get(raw, "background")) != "string" {
            Reject(schema, "scenePreview2D background must be a string.");
            return false;
        }
        profile.background = Str.Trim(Map.GetStr(raw, "background"));
        if PortablePreviewImage(profile.background) == false {
            Reject(
                schema,
                "scenePreview2D background must be a safe project-relative "
                    + "image path.");
            return false;
        }
    }

    var hasVariantProperty = Map.Has(raw, "variantProperty");
    var hasVariantImages = Map.Has(raw, "variantImages");
    if hasVariantProperty != hasVariantImages {
        Reject(
            schema,
            "scenePreview2D variantProperty and variantImages "
                + "must be supplied together.");
        return false;
    }
    if hasVariantProperty {
        if Json.TypeOf(Map.Get(raw, "variantProperty")) != "string" {
            Reject(
                schema,
                "scenePreview2D variantProperty must be a string.");
            return false;
        }
        profile.variantProperty =
            Str.Trim(Map.GetStr(raw, "variantProperty"));
        if PortableIdentifier(
               profile.variantProperty, MAX_FIELD_KEY_CHARS) == false {
            Reject(
                schema,
                "scenePreview2D variantProperty must be a portable key.");
            return false;
        }
        var variants = Map.Get(raw, "variantImages");
        if variants == null or Json.TypeOf(variants) != "array" {
            Reject(
                schema,
                "scenePreview2D variantImages must be an array.");
            return false;
        }
        var count = Seq.get_Count(variants);
        if count <= 0 or count > MAX_SCENE_PREVIEW_2D_VARIANTS {
            Reject(
                schema,
                "scenePreview2D requires between 1 and 64 variant images.");
            return false;
        }
        var index = 0;
        while index < count {
            var rawPath = Seq.Get(variants, index);
            if rawPath == null or Json.TypeOf(rawPath) != "string" {
                Reject(
                    schema,
                    "scenePreview2D variant image paths must be strings.");
                return false;
            }
            var path = Str.Trim(Seq.GetStr(variants, index));
            if PortablePreviewImage(path) == false {
                Reject(
                    schema,
                    "scenePreview2D variants must be safe project-relative "
                        + "image paths.");
                return false;
            }
            profile.variantImages.add(path);
            index = index + 1;
        }
    }

    if Map.Has(raw, "variantOffset") {
        if hasVariantImages == false
           or Json.TypeOf(Map.Get(raw, "variantOffset")) != "number" {
            Reject(
                schema,
                "scenePreview2D variantOffset requires variant images "
                    + "and must be an integer.");
            return false;
        }
        var parsed =
            Parse.TryInt(Json.Format(Map.Get(raw, "variantOffset")));
        if parsed.IsNone
           or parsed.UnwrapI64() < MIN_SCENE_PREVIEW_2D_OFFSET
           or parsed.UnwrapI64() > MAX_SCENE_PREVIEW_2D_OFFSET {
            Reject(
                schema,
                "scenePreview2D variantOffset exceeds the supported range.");
            return false;
        }
        profile.variantOffset = parsed.UnwrapI64();
    }

    if Map.Has(raw, "fit") {
        if Json.TypeOf(Map.Get(raw, "fit")) != "string" {
            Reject(schema, "scenePreview2D fit must be a string.");
            return false;
        }
        profile.fit = Str.ToLower(Str.Trim(Map.GetStr(raw, "fit")));
        if profile.fit != BACKGROUND_FIT_COVER
           and profile.fit != BACKGROUND_FIT_CONTAIN
           and profile.fit != BACKGROUND_FIT_STRETCH {
            Reject(
                schema,
                "scenePreview2D fit must be cover, contain, or stretch.");
            return false;
        }
        if profile.background == "" and profile.variantImages.count() == 0 {
            Reject(
                schema,
                "scenePreview2D fit requires a background image.");
            return false;
        }
    }

    if Map.Has(raw, "showGrid") {
        if Json.TypeOf(Map.Get(raw, "showGrid")) != "boolean" {
            Reject(schema, "scenePreview2D showGrid must be a boolean.");
            return false;
        }
        profile.hasShowGrid = true;
        profile.showGrid = Map.GetBool(raw, "showGrid");
    }
    if profile.background == "" and profile.variantImages.count() == 0
       and profile.hasShowGrid == false {
        Reject(
            schema,
            "scenePreview2D requires a background mapping or showGrid.");
        return false;
    }
    profile.present = true;
    schema.scenePreview2D = profile;
    return true;
}

/// @brief Parse the optional schema-v3 project object-preview collection.
func ParseObjectPreviews(root: Any,
                         schema: SceneComponentSchema) -> Boolean {
    if Map.Has(root, "objectPreviews") == false { return true; }
    if schema.version < OBJECT_PREVIEW_SCHEMA_VERSION {
        Reject(schema, "Project object previews require schema version 3.");
        return false;
    }
    var rawPreviews = Map.Get(root, "objectPreviews");
    if rawPreviews == null or Json.TypeOf(rawPreviews) != "array" {
        Reject(schema, "objectPreviews must be an array.");
        return false;
    }
    var count = Seq.get_Count(rawPreviews);
    if count > MAX_OBJECT_PREVIEWS {
        Reject(schema, "Component schema exceeds 128 object previews.");
        return false;
    }
    var staged: List[SceneObjectPreviewDefinition] = [];
    var seenTypes = Map.New();
    var index = 0;
    while index < count {
        var preview = ParseObjectPreview(
            Seq.Get(rawPreviews, index), index, seenTypes, schema);
        if preview == null { return false; }
        staged.add(preview);
        index = index + 1;
    }
    schema.objectPreviews = staged;
    return true;
}

/// @brief Validate one project object-preview definition atomically.
func ParseObjectPreview(raw: Any,
                        index: Integer,
                        seenTypes: Any,
                        schema: SceneComponentSchema)
    -> SceneObjectPreviewDefinition {
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(schema, "Object preview " + index + " must be an object.");
        return null;
    }
    var preview = new SceneObjectPreviewDefinition();
    preview.objectType = Str.Trim(Map.GetStr(raw, "objectType"));
    if PortableIdentifier(
           preview.objectType, MAX_FIELD_KEY_CHARS) == false {
        Reject(
            schema,
            "Object preview " + index
                + " requires a portable objectType of at most 128 characters.");
        return null;
    }
    var foldedType = Str.ToLower(preview.objectType);
    if Map.Has(seenTypes, foldedType) {
        Reject(
            schema,
            "Duplicate object preview type \"" + preview.objectType + "\".");
        return null;
    }
    Map.SetBool(seenTypes, foldedType, true);

    if Map.Has(raw, "sprite") == false
       or Json.TypeOf(Map.Get(raw, "sprite")) != "string" {
        Reject(
            schema,
            "Object preview \"" + preview.objectType
                + "\" requires a sprite string.");
        return null;
    }
    preview.sprite = Str.Trim(Map.GetStr(raw, "sprite"));
    if preview.sprite == ""
       or Str.get_Length(preview.sprite) > MAX_PREVIEW_SPRITE_CHARS {
        Reject(
            schema,
            "Object preview \"" + preview.objectType
                + "\" sprite must contain at most 1,024 characters.");
        return null;
    }

    if Map.Has(raw, "frame") {
        var rawFrame = Map.Get(raw, "frame");
        if Json.TypeOf(rawFrame) != "number" {
            Reject(schema, "Object preview frame must be an integer.");
            return null;
        }
        var parsedFrame = Parse.TryInt(Json.Format(rawFrame));
        if parsedFrame.IsNone
           or parsedFrame.UnwrapI64() < 0
           or parsedFrame.UnwrapI64() > MAX_PREVIEW_FRAME {
            Reject(
                schema,
                "Object preview frame must be between 0 and 1,000,000.");
            return null;
        }
        preview.frame = parsedFrame.UnwrapI64();
    }

    if Map.Has(raw, "frameProperty") {
        if Json.TypeOf(Map.Get(raw, "frameProperty")) != "string" {
            Reject(schema, "Object preview frameProperty must be a string.");
            return null;
        }
        preview.frameProperty =
            Str.Trim(Map.GetStr(raw, "frameProperty"));
        if PortableIdentifier(
               preview.frameProperty, MAX_FIELD_KEY_CHARS) == false {
            Reject(
                schema,
                "Object preview frameProperty must be a portable key "
                + "of at most 128 characters.");
            return null;
        }
    }

    var hasOffset = Map.Has(raw, "frameOffset");
    var hasMap = Map.Has(raw, "frameMap");
    if (hasOffset or hasMap) and preview.frameProperty == "" {
        Reject(
            schema,
            "Object preview frameOffset/frameMap requires frameProperty.");
        return null;
    }
    if hasOffset and hasMap {
        Reject(
            schema,
            "Object preview frameOffset and frameMap are mutually exclusive.");
        return null;
    }
    if hasOffset {
        var rawOffset = Map.Get(raw, "frameOffset");
        if Json.TypeOf(rawOffset) != "number" {
            Reject(schema, "Object preview frameOffset must be an integer.");
            return null;
        }
        var parsedOffset = Parse.TryInt(Json.Format(rawOffset));
        if parsedOffset.IsNone
           or parsedOffset.UnwrapI64() < MIN_PREVIEW_FRAME_OFFSET
           or parsedOffset.UnwrapI64() > MAX_PREVIEW_FRAME_OFFSET {
            Reject(
                schema,
                "Object preview frameOffset exceeds the supported range.");
            return null;
        }
        preview.frameOffset = parsedOffset.UnwrapI64();
    }
    if hasMap and ParsePreviewFrameMap(raw, preview, schema) == false {
        return null;
    }
    return preview;
}

/// @brief Parse one bounded non-negative atlas-frame map.
func ParsePreviewFrameMap(raw: Any,
                          preview: SceneObjectPreviewDefinition,
                          schema: SceneComponentSchema) -> Boolean {
    var rawMap = Map.Get(raw, "frameMap");
    if rawMap == null or Json.TypeOf(rawMap) != "array" {
        Reject(schema, "Object preview frameMap must be an array.");
        return false;
    }
    var count = Seq.get_Count(rawMap);
    if count <= 0 or count > MAX_PREVIEW_FRAME_MAP {
        Reject(
            schema,
            "Object preview frameMap requires between 1 and 256 entries.");
        return false;
    }
    var index = 0;
    while index < count {
        var rawFrame = Seq.Get(rawMap, index);
        if rawFrame == null or Json.TypeOf(rawFrame) != "number" {
            Reject(schema, "Object preview frameMap entries must be integers.");
            return false;
        }
        var parsed = Parse.TryInt(Json.Format(rawFrame));
        if parsed.IsNone or parsed.UnwrapI64() < 0
           or parsed.UnwrapI64() > MAX_PREVIEW_FRAME {
            Reject(
                schema,
                "Object preview frameMap entries must be between "
                + "0 and 1,000,000.");
            return false;
        }
        preview.frameMap.add(parsed.UnwrapI64());
        index = index + 1;
    }
    return true;
}

/// @brief Parse and validate one component without publishing it to the schema.
func ParseComponent(raw: Any,
                    index: Integer,
                    seenNames: Any,
                    schema: SceneComponentSchema)
    -> SceneComponentDefinition {
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(schema, "Component " + index + " must be an object.");
        return null;
    }

    var component = new SceneComponentDefinition();
    component.name = Str.Trim(Map.GetStr(raw, "name"));
    if PortableIdentifier(component.name, MAX_COMPONENT_NAME_CHARS) == false {
        Reject(
            schema,
            "Component " + index
                + " requires a portable name of at most 64 characters.");
        return null;
    }
    var foldedName = Str.ToLower(component.name);
    if Map.Has(seenNames, foldedName) {
        Reject(
            schema,
            "Duplicate component name \"" + component.name + "\".");
        return null;
    }
    Map.SetBool(seenNames, foldedName, true);

    component.target = Str.ToLower(Str.Trim(Map.GetStr(raw, "target")));
    if component.target != TARGET_2D_OBJECT
       and component.target != TARGET_3D_NODE
       and component.target != TARGET_BOTH {
        Reject(
            schema,
            "Component \"" + component.name
                + "\" target must be 2d-object, 3d-node, or both.");
        return null;
    }

    component.label = component.name;
    if Map.Has(raw, "label") {
        if Json.TypeOf(Map.Get(raw, "label")) != "string" {
            Reject(
                schema,
                "Component \"" + component.name + "\" label must be a string.");
            return null;
        }
        component.label = Str.Trim(Map.GetStr(raw, "label"));
        if component.label == ""
           or Str.get_Length(component.label) > MAX_LABEL_CHARS {
            Reject(
                schema,
                "Component \"" + component.name
                    + "\" label must contain at most 128 characters.");
            return null;
        }
    }
    if Map.Has(raw, "description") {
        if Json.TypeOf(Map.Get(raw, "description")) != "string" {
            Reject(
                schema,
                "Component \"" + component.name
                    + "\" description must be a string.");
            return null;
        }
        component.description = Map.GetStr(raw, "description");
        if Str.get_Length(component.description) > MAX_DESCRIPTION_CHARS {
            Reject(
                schema,
                "Component \"" + component.name
                    + "\" description exceeds 1,024 characters.");
            return null;
        }
    }

    var rawFields = Map.Get(raw, "fields");
    if rawFields == null or Json.TypeOf(rawFields) != "array" {
        Reject(
            schema,
            "Component \"" + component.name + "\" requires a fields array.");
        return null;
    }
    var fieldCount = Seq.get_Count(rawFields);
    if fieldCount <= 0 or fieldCount > MAX_FIELDS_PER_COMPONENT {
        Reject(
            schema,
            "Component \"" + component.name
                + "\" requires between 1 and 64 fields.");
        return null;
    }

    var seenKeys = Map.New();
    var fieldIndex = 0;
    while fieldIndex < fieldCount {
        var field = ParseField(
            Seq.Get(rawFields, fieldIndex),
            component.name,
            fieldIndex,
            seenKeys,
            schema);
        if field == null { return null; }
        component.fields.add(field);
        fieldIndex = fieldIndex + 1;
    }
    return component;
}

/// @brief Parse one scalar field and canonicalize its default as editor text.
func ParseField(raw: Any,
                componentName: String,
                index: Integer,
                seenKeys: Any,
                schema: SceneComponentSchema) -> SceneComponentField {
    if raw == null or Json.TypeOf(raw) != "object" {
        Reject(
            schema,
            "Field " + index + " in \"" + componentName
                + "\" must be an object.");
        return null;
    }

    var field = new SceneComponentField();
    field.key = Str.Trim(Map.GetStr(raw, "key"));
    if PortableIdentifier(field.key, MAX_FIELD_KEY_CHARS) == false {
        Reject(
            schema,
            "Field " + index + " in \"" + componentName
                + "\" requires a portable key of at most 128 characters.");
        return null;
    }
    if Map.Has(seenKeys, field.key) {
        Reject(
            schema,
            "Duplicate field key \"" + field.key
                + "\" in component \"" + componentName + "\".");
        return null;
    }
    Map.SetBool(seenKeys, field.key, true);

    field.kind = Str.ToLower(Str.Trim(Map.GetStr(raw, "type")));
    var versionTwoKind = field.kind == "enum" or field.kind == "asset";
    if versionTwoKind and schema.version < 2 {
        Reject(
            schema,
            "Field \"" + field.key
                + "\" uses type " + field.kind
                + ", which requires schema version 2.");
        return null;
    }
    if IsScalarKind(field.kind) == false and versionTwoKind == false {
        Reject(
            schema,
            "Field \"" + field.key
                + "\" type must be string, int, float, bool, null, enum, "
                + "or asset.");
        return null;
    }
    if field.kind == "enum" and ParseEnumChoices(raw, field, schema) == false {
        return null;
    }
    if field.kind == "asset" and ParseAssetKinds(raw, field, schema) == false {
        return null;
    }

    field.label = field.key;
    if Map.Has(raw, "label") {
        if Json.TypeOf(Map.Get(raw, "label")) != "string" {
            Reject(
                schema,
                "Field \"" + field.key + "\" label must be a string.");
            return null;
        }
        field.label = Str.Trim(Map.GetStr(raw, "label"));
        if field.label == ""
           or Str.get_Length(field.label) > MAX_LABEL_CHARS {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" label must contain at most 128 characters.");
            return null;
        }
    }
    if Map.Has(raw, "description") {
        if Json.TypeOf(Map.Get(raw, "description")) != "string" {
            Reject(
                schema,
                "Field \"" + field.key + "\" description must be a string.");
            return null;
        }
        field.description = Map.GetStr(raw, "description");
        if Str.get_Length(field.description) > MAX_DESCRIPTION_CHARS {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" description exceeds 1,024 characters.");
            return null;
        }
    }

    if CanonicalizeDefault(raw, field, schema) == false {
        if schema.error == "" {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" has a default that does not match " + field.kind + ".");
        }
        return null;
    }
    return field;
}

/// @brief Parse and validate one enum field's declared choice list (ADR 0178).
func ParseEnumChoices(raw: Any,
                      field: SceneComponentField,
                      schema: SceneComponentSchema) -> Boolean {
    var rawChoices = Map.Get(raw, "choices");
    if rawChoices == null or Json.TypeOf(rawChoices) != "array" {
        Reject(
            schema,
            "Field \"" + field.key + "\" requires a choices array.");
        return false;
    }
    var count = Seq.get_Count(rawChoices);
    if count <= 0 or count > MAX_ENUM_CHOICES {
        Reject(
            schema,
            "Field \"" + field.key
                + "\" requires between 1 and 64 choices.");
        return false;
    }
    var seen = Map.New();
    var index = 0;
    while index < count {
        var value = Seq.Get(rawChoices, index);
        if value == null or Json.TypeOf(value) != "string" {
            Reject(
                schema,
                "Field \"" + field.key + "\" choices must be strings.");
            return false;
        }
        var choice = Str.Trim(Seq.GetStr(rawChoices, index));
        if PortableIdentifier(choice, MAX_ENUM_CHOICE_CHARS) == false {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" choices must be portable identifiers of at most "
                    + "64 characters.");
            return false;
        }
        var folded = Str.ToLower(choice);
        if Map.Has(seen, folded) {
            Reject(
                schema,
                "Field \"" + field.key + "\" has duplicate choice \""
                    + choice + "\".");
            return false;
        }
        Map.SetBool(seen, folded, true);
        field.choices.add(choice);
        index = index + 1;
    }
    return true;
}

/// @brief Parse one asset field's optional browser-kind filter (ADR 0178).
func ParseAssetKinds(raw: Any,
                     field: SceneComponentField,
                     schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, "assetKinds") == false {
        field.assetKinds.add("any");
        return true;
    }
    var rawKinds = Map.Get(raw, "assetKinds");
    if Json.TypeOf(rawKinds) != "array" {
        Reject(
            schema,
            "Field \"" + field.key + "\" assetKinds must be an array.");
        return false;
    }
    var count = Seq.get_Count(rawKinds);
    if count <= 0 or count > MAX_ASSET_KINDS {
        Reject(
            schema,
            "Field \"" + field.key
                + "\" assetKinds needs between 1 and 4 entries.");
        return false;
    }
    var index = 0;
    while index < count {
        var value = Seq.Get(rawKinds, index);
        if value == null or Json.TypeOf(value) != "string" {
            Reject(
                schema,
                "Field \"" + field.key + "\" assetKinds must be strings.");
            return false;
        }
        var kind = Str.ToLower(Str.Trim(Seq.GetStr(rawKinds, index)));
        if kind != "image" and kind != "audio" and kind != "scene"
           and kind != "any" {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" assetKinds must be image, audio, scene, or any.");
            return false;
        }
        var existing = 0;
        while existing < field.assetKinds.count() {
            if field.assetKinds.get(existing) == kind {
                Reject(
                    schema,
                    "Field \"" + field.key
                        + "\" has duplicate asset kind \"" + kind + "\".");
                return false;
            }
            existing = existing + 1;
        }
        field.assetKinds.add(kind);
        index = index + 1;
    }
    return true;
}

/// @brief Validate one optional JSON default and produce exact editor text.
func CanonicalizeDefault(raw: Any,
                         field: SceneComponentField,
                         schema: SceneComponentSchema) -> Boolean {
    if Map.Has(raw, "default") == false {
        if field.kind == "int" or field.kind == "float" {
            field.defaultText = "0";
        }
        if field.kind == "bool" { field.defaultText = "false"; }
        if field.kind == "enum" and field.choices.count() > 0 {
            field.defaultText = field.choices.get(0);
        }
        return true;
    }

    var value = Map.Get(raw, "default");
    var valueType = Json.TypeOf(value);
    if field.kind == "enum" {
        if valueType != "string" { return false; }
        field.defaultText = Str.Trim(Map.GetStr(raw, "default"));
        if field.HasChoice(field.defaultText) == false {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" default must be one of its declared choices.");
            return false;
        }
        return true;
    }
    if field.kind == "string" or field.kind == "asset" {
        if valueType != "string" { return false; }
        field.defaultText = Map.GetStr(raw, "default");
        if Str.get_Length(field.defaultText) > MAX_DEFAULT_STRING_CHARS {
            Reject(
                schema,
                "Field \"" + field.key
                    + "\" string default exceeds 16,384 characters.");
            return false;
        }
        return true;
    }
    if field.kind == "int" {
        if valueType != "number" { return false; }
        var parsedInt = Parse.TryInt(Json.Format(value));
        if parsedInt.IsNone { return false; }
        field.defaultText = Fmt.Int(parsedInt.UnwrapI64());
        return true;
    }
    if field.kind == "float" {
        if valueType != "number" { return false; }
        var parsedFloat = Parse.TryDouble(Json.Format(value));
        if parsedFloat.IsNone { return false; }
        field.defaultText = Fmt.Num(parsedFloat.UnwrapF64());
        return true;
    }
    if field.kind == "bool" {
        if valueType != "boolean" { return false; }
        field.defaultText = Fmt.Bool(Map.GetBool(raw, "default"));
        return true;
    }
    if valueType != "null" { return false; }
    field.defaultText = "";
    return true;
}

/// @brief Return whether one schema kind maps to supported runtime metadata.
expose func IsScalarKind(kind: String) -> Boolean {
    return kind == "string" or kind == "int" or kind == "float"
        or kind == "bool" or kind == "null";
}

/// @brief Return the runtime scalar kind one schema field authors (ADR 0178).
/// @details Enum and asset values are ordinary string properties at runtime;
///          every other kind maps to itself.
expose func ValueKind(kind: String) -> String {
    if kind == "enum" or kind == "asset" { return "string"; }
    return kind;
}

/// @brief Return the lowest schema version a field kind requires.
expose func KindVersion(kind: String) -> Integer {
    if kind == "enum" or kind == "asset" { return 2; }
    return SCHEMA_VERSION;
}

/// @brief Restrict stable schema identities to single-byte portable characters.
/// @details Labels and descriptions remain Unicode. Keys stay ASCII so the
///          character limit is also an exact UTF-8 byte limit for both runtimes.
func PortableIdentifier(value: String,
                        maximum: Integer) -> Boolean {
    var length = Str.get_Length(value);
    if length <= 0 or length > maximum { return false; }
    var allowed =
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:-";
    var index = 1;
    while index <= length {
        if Str.IndexOf(allowed, Str.MidLen(value, index, 1)) == 0 {
            return false;
        }
        index = index + 1;
    }
    return true;
}

/// @brief Invalidate a schema and erase any staged/public component state.
func Reject(schema: SceneComponentSchema,
            message: String) -> SceneComponentSchema {
    schema.valid = false;
    schema.error = message;
    schema.components = [];
    schema.objectPreviews = [];
    schema.scenePreview2D = new ScenePreview2DDefinition();
    schema.scenePreview3D = new ScenePreview3DDefinition();
    schema.nodePreviews3D = [];
    return schema;
}
