final MAX_NODE_PREVIEW_YAW_DEGREES: Number = 36000.0;
final MAX_NODE_PREVIEW_OFFSET: Number = 1000000.0;
final MAX_MATERIAL_PREVIEWS_3D: Integer = 128;
final MAX_MATERIAL_PREVIEW_TEXTURE_CHARS: Integer = 1024;
final MAX_MATERIAL_PREVIEW_NORMAL_SCALE: Number = 8.0;
final MAX_MATERIAL_PREVIEW_EMISSIVE_INTENSITY: Number = 64.0;
final MAX_MATERIAL_PREVIEW_EMISSIVE_MULTIPLIER: Number = 64.0;
final MAX_SCENE_PREVIEW_2D_VARIANTS: Integer = 64;
final MAX_SCENE_PREVIEW_2D_IMAGE_CHARS: Integer = 1024;
final MIN_SCENE_PREVIEW_2D_OFFSET: Integer = -1000000;
final MAX_SCENE_PREVIEW_2D_OFFSET: Integer = 1000000;
final MAX_SCENE_ENVIRONMENT_PREVIEW_VARIANTS: Integer = 64;
final MAX_SCENE_ENVIRONMENT_PREVIEW_LAYERS: Integer = 32;
final MAX_SCENE_WATER_PREVIEW_LAYERS: Integer = 8;
