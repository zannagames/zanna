type SceneComponentField = SceneComponentModel.SceneComponentField;
type SceneComponentDefinition = SceneComponentModel.SceneComponentDefinition;
type SceneObjectPreviewDefinition = SceneComponentModel.SceneObjectPreviewDefinition;
