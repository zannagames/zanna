final CALL_STACK_CONTROLS_COMPACT_MAX_WIDTH = ToolPanelModel.CALL_STACK_CONTROLS_COMPACT_MAX_WIDTH;
final TERMINAL_ACTIONS_COMPACT_MAX_WIDTH = ToolPanelModel.TERMINAL_ACTIONS_COMPACT_MAX_WIDTH;
final WATCH_TOOLBAR_COMPACT_MAX_WIDTH = ToolPanelModel.WATCH_TOOLBAR_COMPACT_MAX_WIDTH;
final TOOL_TABS_COMPACT_MAX_WIDTH = ToolPanelModel.TOOL_TABS_COMPACT_MAX_WIDTH;
final FLOATING_PANEL_DEFAULT_X = ToolPanelModel.FLOATING_PANEL_DEFAULT_X;
final FLOATING_PANEL_DEFAULT_Y = ToolPanelModel.FLOATING_PANEL_DEFAULT_Y;
final FLOATING_PANEL_DEFAULT_WIDTH = ToolPanelModel.FLOATING_PANEL_DEFAULT_WIDTH;
final FLOATING_PANEL_DEFAULT_HEIGHT = ToolPanelModel.FLOATING_PANEL_DEFAULT_HEIGHT;
