final MAX_OUTPUT_ROW_COUNT = ToolPanelModel.MAX_OUTPUT_ROW_COUNT;
final SEARCH_PANEL_MIN_LOGICAL_HEIGHT = ToolPanelModel.SEARCH_PANEL_MIN_LOGICAL_HEIGHT;
