//
// File: zannastudio/src/ui/scene_asset_browser.zia
// Purpose: Bounded, searchable list/grid project-asset selection shared by
//          Studio's visual scene editors.
// Key invariants:
//   - Project discovery is cooperative and consumes a fixed per-frame budget.
//   - At most 512 rows, 48 thumbnail cards, and one detail preview are retained.
//   - Thumbnail decoding/rendering advances at most one asset per frame.
//   - Selection reports intent; this module never mutates scene documents.
//   - Multi-root labels are unambiguous and paths remain absolute in row data.
// Ownership/Lifetime: A scene inspector owns each browser; ProjectManager owns
//                     the borrowed workspace file cache.
// Links: zannastudio/src/core/project_manager.zia,
//        zannastudio/src/ui/scene_editor_2d.zia,
//        zannastudio/src/ui/scene_editor_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_asset_browser;

bind "../core/project_manager";
bind "../services/asset_library";
bind "../services/safe_io";
bind "inspector_rows";
bind "scene_asset_thumbnails";

bind GUI = Zanna.GUI;
bind Pixels = Zanna.Graphics.Pixels;
bind Path = Zanna.IO.Path;
bind File = Zanna.IO.File;
bind Str = Zanna.String;
bind Seq = Zanna.Collections.Seq;
bind Obj = Zanna.Core.Object;
bind Parse = Zanna.Core.Parse;
bind Convert = Zanna.Core.Convert;

// ============================================================================
// MODULE: scene_asset_browser
// PURPOSE: Present workspace-backed scene assets without adding file discovery,
//          filtering, thumbnails, or multi-root labeling to scene controllers.
//
// WHERE-THIS-FITS: ProjectManager owns bounded file discovery. Scene inspectors
//          own widgets. SceneEditor2D/3D validate and commit selected paths.
//
// TEACHING-NOTE: A browser selection is only intent. Validation can still fail
//          after selection because files may change or disappear asynchronously.
// ============================================================================

final MAX_VISIBLE_SCENE_ASSETS: Integer = 512;
final MAX_VISIBLE_ASSET_THUMBNAILS: Integer = 48;
final ASSET_CACHE_WORK_PER_FRAME: Integer = 128;
final ASSET_ROW_WORK_PER_FRAME: Integer = 256;
final MAX_ASSET_PREVIEW_SOURCE_BYTES: Integer = 16000000;
final MAX_ASSET_PREVIEW_PIXELS: Integer = 4194304;
final MAX_ASSET_PREVIEW_EDGE: Integer = 128;
final ASSET_THUMBNAIL_EDGE: Integer = 80;
final ASSET_CARD_WIDTH: Integer = 96;
final ASSET_CARD_HEIGHT: Integer = 116;
final ASSET_CARD_GAP: Integer = 6;

/// @brief One bounded, clickable, draggable asset-grid card.
class SceneAssetThumbnailCard {
    expose GUI.VBox host;
    expose GUI.Image image;
    expose GUI.Button placeholder;
    expose GUI.Button labelButton;
    expose String path;
    expose Integer rowIndex;
    expose Boolean thumbnailAttempted;
    expose Boolean thumbnailReady;

    expose func init() {
        host = null;
        image = null;
        placeholder = null;
        labelButton = null;
        path = "";
        rowIndex = -1;
        thumbnailAttempted = false;
        thumbnailReady = false;
    }

    /// @brief Build a fixed-size card whose controls share one drag payload.
    expose func Build(parent: GUI.Flex,
                      assetPath: String,
                      assetLabel: String,
                      listRow: Integer) {
        path = assetPath;
        rowIndex = listRow;
        host = GUI.VBox.New();
        host.SetSpacing(3.0);
        host.SetAlign(GUI.Align.Center);
        host.SetPreferredSize(
            ASSET_CARD_WIDTH + 0.0, ASSET_CARD_HEIGHT + 0.0);
        host.SetMinSize(
            ASSET_CARD_WIDTH + 0.0, ASSET_CARD_HEIGHT + 0.0);
        host.SetMaxSize(
            ASSET_CARD_WIDTH + 0.0, ASSET_CARD_HEIGHT + 0.0);
        parent.AddChild(host);

        image = GUI.Image.New(host);
        image.SetPreferredSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        image.SetMinSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        image.SetMaxSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        image.SetScaleMode(0);
        image.SetFilter(1);
        image.SetFocusable(true);
        image.SetAccessibleName(
            "Thumbnail for " + assetLabel);
        image.SetTooltip(assetLabel);
        image.SetDraggable(true);
        image.SetDragData("zanna/asset", path);
        image.SetVisible(false);

        placeholder = GUI.Button.New(host, "");
        placeholder.SetPreferredSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        placeholder.SetMinSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        placeholder.SetMaxSize(
            ASSET_THUMBNAIL_EDGE + 0.0,
            ASSET_THUMBNAIL_EDGE + 0.0);
        placeholder.SetStyle(2);
        if scene_asset_thumbnails.IsImageAsset(path) {
            placeholder.SetIconName("file-image");
        } else {
            placeholder.SetIconName("file");
        }
        placeholder.SetAccessibleName(
            "Asset preview placeholder for " + assetLabel);
        placeholder.SetTooltip(assetLabel);
        placeholder.SetDraggable(true);
        placeholder.SetDragData("zanna/asset", path);

        labelButton = GUI.Button.New(host, Path.Name(path));
        labelButton.SetPreferredSize(ASSET_CARD_WIDTH + 0.0, 28.0);
        labelButton.SetMinSize(ASSET_CARD_WIDTH + 0.0, 28.0);
        labelButton.SetMaxSize(ASSET_CARD_WIDTH + 0.0, 28.0);
        labelButton.SetStyle(2);
        labelButton.SetAccessibleName("Select asset " + assetLabel);
        labelButton.SetTooltip(assetLabel);
        labelButton.SetDraggable(true);
        labelButton.SetDragData("zanna/asset", path);
    }

    /// @brief Replace the placeholder with one widget-owned pixel upload.
    expose func SetThumbnail(pixels: Pixels) {
        if pixels == null or image == null { return; }
        image.SetPixels(pixels, pixels.Width, pixels.Height);
        image.SetVisible(true);
        placeholder.SetVisible(false);
        thumbnailReady = true;
    }

    /// @brief Drain click edges from every interactive part of the card.
    expose func TakeClicked() -> Boolean {
        var clickedImage = image != null and image.WasClicked();
        var clickedPlaceholder =
            placeholder != null and placeholder.WasClicked();
        var clickedLabel =
            labelButton != null and labelButton.WasClicked();
        return clickedImage or clickedPlaceholder or clickedLabel;
    }

    /// @brief Present the hidden list's canonical selection on this card.
    expose func SetSelected(selected: Boolean) {
        if labelButton == null { return; }
        if selected { labelButton.SetStyle(1); }
        else { labelButton.SetStyle(2); }
    }
}

/// @brief Normalize a comma/semicolon extension list for exact membership.
expose func NormalizeAssetExtensions(extensions: String) -> String {
    var value = Str.ToLower(Str.Trim(extensions));
    value = Str.Replace(value, ";", ",");
    value = Str.Replace(value, " ", "");
    value = Str.Replace(value, "*", "");
    while Str.IndexOf(value, ",,") > 0 {
        value = Str.Replace(value, ",,", ",");
    }
    if value == "" { return ","; }
    if Str.StartsWith(value, ",") == false { value = "," + value; }
    if Str.EndsWith(value, ",") == false { value = value + ","; }
    return value;
}

/// @brief Return whether one path belongs to an exact extension allow-list.
expose func AssetExtensionAllowed(path: String,
                                  normalizedExtensions: String) -> Boolean {
    var extension = Str.ToLower(Path.Extension(path));
    if extension == "" { return false; }
    return Str.IndexOf(
        normalizedExtensions, "," + extension + ",") > 0;
}

/// @brief Match a case-insensitive browser query against label and full path.
expose func AssetMatchesFilter(label: String,
                               path: String,
                               filter: String) -> Boolean {
    var query = Str.ToLower(Str.Trim(filter));
    if query == "" { return true; }
    return Str.IndexOf(Str.ToLower(label), query) > 0
        or Str.IndexOf(Str.ToLower(path), query) > 0;
}

/// @brief Return a portable scene-relative reference when roots are compatible.
/// @details Unsaved documents and incompatible roots retain an absolute path.
expose func PortableReferencePath(assetPath: String,
                                  documentPath: String) -> String {
    var cleanAsset = Str.Trim(assetPath);
    if cleanAsset == "" { return ""; }
    if Path.IsAbsolute(cleanAsset) == false {
        return PortableSeparators(cleanAsset);
    }

    var target = Path.Normalize(Path.Absolute(cleanAsset));
    if Str.Trim(documentPath) == "" {
        return PortableSeparators(target);
    }
    var base = Path.Normalize(
        Path.Absolute(Path.Directory(documentPath)));
    var baseParts = AssetPathParts(base);
    var targetParts = AssetPathParts(target);
    if Seq.get_Count(baseParts) == 0
       or Seq.get_Count(targetParts) == 0 {
        return PortableSeparators(target);
    }

    var baseRoot = Obj.ToString(Seq.Get(baseParts, 0));
    var targetRoot = Obj.ToString(Seq.Get(targetParts, 0));
    var rootsMatch = baseRoot == targetRoot;
    if rootsMatch == false
       and Str.EndsWith(baseRoot, ":")
       and Str.EndsWith(targetRoot, ":") {
        rootsMatch = Str.ToLower(baseRoot) == Str.ToLower(targetRoot);
    }
    if rootsMatch == false { return PortableSeparators(target); }

    var common = 1;
    while common < Seq.get_Count(baseParts)
          and common < Seq.get_Count(targetParts)
          and Obj.ToString(Seq.Get(baseParts, common))
              == Obj.ToString(Seq.Get(targetParts, common)) {
        common = common + 1;
    }

    var relative = "";
    var baseIndex = common;
    while baseIndex < Seq.get_Count(baseParts) {
        relative = AppendAssetPath(relative, "..");
        baseIndex = baseIndex + 1;
    }
    var targetIndex = common;
    while targetIndex < Seq.get_Count(targetParts) {
        relative = AppendAssetPath(
            relative,
            Obj.ToString(Seq.Get(targetParts, targetIndex)));
        targetIndex = targetIndex + 1;
    }
    if relative == "" { relative = Path.Name(target); }
    return relative;
}

/// @brief Presentation-only project asset chooser.
class SceneAssetBrowser {
    expose GUI.Button openButton;
    expose GUI.GroupBox group;
    expose GUI.TextInput filterInput;
    expose GUI.Button clearFilterButton;
    expose GUI.Button viewModeButton;
    expose GUI.Button refreshButton;
    expose GUI.Button closeButton;
    expose GUI.ListBox assetList;
    expose GUI.ScrollView thumbnailScroll;
    expose GUI.Flex thumbnailGrid;
    expose List[SceneAssetThumbnailCard] thumbnailCards;
    expose Boolean gridView;
    expose Integer thumbnailAttemptedCount;
    expose Integer thumbnailReadyCount;
    expose GUI.Label statusLabel;
    expose GUI.VBox previewStage;
    expose GUI.Image previewImage;
    expose GUI.Label selectionLabel;
    expose GUI.Button useButton;
    expose Pixels previewPixels;
    expose Integer realizedCount;
    expose Integer matchedCount;
    expose Boolean resultTruncated;
    expose GUI.Button libraryOnlyButton;
    expose GUI.TextInput tagFilterInput;
    expose GUI.TextInput entryTagsInput;
    expose GUI.TextInput entryTileWidthInput;
    expose GUI.TextInput entryTileHeightInput;
    expose GUI.Button saveEntryButton;
    expose GUI.Button removeEntryButton;
    expose GUI.Label libraryStatusLabel;
    hide asset_library.AssetLibrary library;
    hide asset_library.AssetLibrarySession librarySession;
    hide String libraryRoot;
    hide Boolean libraryOnly;
    hide String tagFilterText;
    hide String normalizedExtensions;
    hide String filterText;
    hide Integer cacheGeneration;
    hide Integer scanIndex;
    hide Boolean canUseSelection;
    hide Boolean selectedUsable;
    hide String selectedLabel;

    expose func init() {
        libraryOnlyButton = null;
        tagFilterInput = null;
        entryTagsInput = null;
        entryTileWidthInput = null;
        entryTileHeightInput = null;
        saveEntryButton = null;
        removeEntryButton = null;
        libraryStatusLabel = null;
        library = new asset_library.AssetLibrary();
        librarySession = new asset_library.AssetLibrarySession();
        libraryRoot = "";
        libraryOnly = false;
        tagFilterText = "";
        openButton = null;
        group = null;
        filterInput = null;
        clearFilterButton = null;
        viewModeButton = null;
        refreshButton = null;
        closeButton = null;
        assetList = null;
        thumbnailScroll = null;
        thumbnailGrid = null;
        thumbnailCards = [];
        gridView = true;
        thumbnailAttemptedCount = 0;
        thumbnailReadyCount = 0;
        statusLabel = null;
        previewStage = null;
        previewImage = null;
        selectionLabel = null;
        useButton = null;
        previewPixels = null;
        realizedCount = 0;
        matchedCount = 0;
        resultTruncated = false;
        normalizedExtensions = ",";
        filterText = "";
        cacheGeneration = -1;
        scanIndex = 0;
        canUseSelection = false;
        selectedUsable = false;
        selectedLabel = "";
    }

    /// @brief Build one collapsed asset browser inside a scene inspector group.
    expose func Setup(parent: GUI.GroupBox,
                      openLabel: String,
                      extensions: String,
                      useLabel: String) {
        normalizedExtensions = NormalizeAssetExtensions(extensions);
        openButton = GUI.Button.New(parent, openLabel);
        openButton.SetAccessibleName(openLabel);
        openButton.SetTooltip(
            "Search supported assets already inside the open workspace");

        group = GUI.GroupBox.New(parent, "Project assets");
        var filterRow = inspector_rows.NewWrapRow();
        group.AddChild(filterRow);
        filterInput = GUI.TextInput.New(filterRow);
        filterInput.SetFlex(1.0);
        filterInput.SetPlaceholder("Filter project assets");
        filterInput.SetAccessibleName("Filter project scene assets");
        clearFilterButton = GUI.Button.New(filterRow, "Clear");
        clearFilterButton.SetAccessibleName("Clear project asset filter");
        viewModeButton = GUI.Button.New(filterRow, "Grid");
        viewModeButton.SetStyle(1);
        viewModeButton.SetAccessibleName(
            "Switch project asset browser to list view");
        viewModeButton.SetTooltip(
            "Toggle between visual thumbnails and the compact asset list");

        var libraryRow = inspector_rows.NewWrapRow();
        group.AddChild(libraryRow);
        tagFilterInput = GUI.TextInput.New(libraryRow);
        tagFilterInput.SetFlex(1.0);
        tagFilterInput.SetPlaceholder("Filter by library tag");
        tagFilterInput.SetAccessibleName("Filter assets by library tag");
        libraryOnlyButton = GUI.Button.New(libraryRow, "Library: all");
        libraryOnlyButton.SetTooltip(
            "Toggle between all discovered assets and library entries only");

        statusLabel = GUI.Label.New(group, "Open a workspace folder to browse assets.");
        statusLabel.SetWordWrap(true);
        assetList = GUI.ListBox.New(group);
        assetList.SetPreferredSize(0.0, 150.0);
        assetList.SetAccessibleName("Project scene assets");
        // The selected row is a typed drag source: scene surfaces accept
        // "zanna/asset" payloads carrying the absolute workspace path.
        assetList.SetDraggable(true);
        assetList.SetDragData("zanna/asset", "");
        assetList.SetVisible(false);

        thumbnailScroll = GUI.ScrollView.New(group);
        thumbnailScroll.SetPreferredSize(0.0, 238.0);
        thumbnailScroll.SetAccessibleName("Project asset thumbnail grid");
        thumbnailGrid = GUI.Flex.New();
        thumbnailGrid.SetDirection(GUI.FlexDirection.Row);
        thumbnailGrid.SetWrap(GUI.FlexWrap.Wrap);
        thumbnailGrid.SetAlign(GUI.Align.Start);
        thumbnailGrid.SetJustify(GUI.Justify.Start);
        thumbnailGrid.SetGap(ASSET_CARD_GAP + 0.0);
        thumbnailGrid.SetPadding(2.0);
        thumbnailScroll.AddChild(thumbnailGrid);

        previewStage = GUI.VBox.New();
        previewStage.SetAlign(GUI.Align.Center);
        group.AddChild(previewStage);
        previewImage = GUI.Image.New(previewStage);
        previewImage.SetScaleMode(0);
        previewImage.SetFilter(1);
        previewImage.SetAccessibleName("Selected project asset preview");
        previewImage.SetVisible(false);
        selectionLabel = GUI.Label.New(group, "Select an asset to inspect it.");
        selectionLabel.SetWordWrap(true);
        libraryStatusLabel = GUI.Label.New(group, "");
        libraryStatusLabel.SetWordWrap(true);
        var entryRow = inspector_rows.NewWrapRow();
        group.AddChild(entryRow);
        entryTagsInput = GUI.TextInput.New(entryRow);
        entryTagsInput.SetFlex(1.0);
        entryTagsInput.SetPlaceholder("Library tags (comma-separated)");
        entryTagsInput.SetAccessibleName("Selected asset library tags");
        entryTileWidthInput = GUI.TextInput.New(entryRow);
        entryTileWidthInput.SetPreferredSize(64.0, 0.0);
        entryTileWidthInput.SetPlaceholder("tile w");
        entryTileWidthInput.SetAccessibleName("Library entry tile width");
        entryTileHeightInput = GUI.TextInput.New(entryRow);
        entryTileHeightInput.SetPreferredSize(64.0, 0.0);
        entryTileHeightInput.SetPlaceholder("tile h");
        entryTileHeightInput.SetAccessibleName("Library entry tile height");

        var actions = GUI.Flex.New();
        actions.SetDirection(GUI.FlexDirection.Row);
        actions.SetWrap(GUI.FlexWrap.Wrap);
        actions.SetGap(4.0);
        group.AddChild(actions);
        useButton = GUI.Button.New(actions, useLabel);
        useButton.SetAccessibleName(useLabel);
        saveEntryButton = GUI.Button.New(actions, "Save Entry");
        saveEntryButton.SetTooltip(
            "Create or update this asset's library tags and grid");
        removeEntryButton = GUI.Button.New(actions, "Remove Entry");
        removeEntryButton.SetTooltip(
            "Remove this asset's library entry; the file is untouched");
        refreshButton = GUI.Button.New(actions, "Refresh");
        refreshButton.SetAccessibleName("Refresh project asset index");
        closeButton = GUI.Button.New(actions, "Close");
        closeButton.SetAccessibleName("Close project asset browser");
        useButton.SetEnabled(false);
        group.SetVisible(false);
    }

    /// @brief Retarget the accepted extension list for the next discovery.
    /// @details Schema asset fields carry per-field kind filters (ADR 0178),
    ///          so one retained browser serves every field by refiltering.
    expose func SetExtensions(extensions: String) {
        var next = NormalizeAssetExtensions(extensions);
        if next == normalizedExtensions { return; }
        normalizedExtensions = next;
        ResetRows();
    }

    /// @brief Switch between the visual grid and complete compact list.
    /// @details The hidden list remains the canonical selection model in both
    ///          modes, preserving accessibility, keyboard selection, and drag
    ///          payload identity without duplicating project state.
    expose func SetGridView(enabled: Boolean) {
        gridView = enabled;
        if assetList != null { assetList.SetVisible(enabled == false); }
        if thumbnailScroll != null { thumbnailScroll.SetVisible(enabled); }
        if viewModeButton != null {
            if enabled {
                viewModeButton.SetText("Grid");
                viewModeButton.SetStyle(1);
                viewModeButton.SetAccessibleName(
                    "Switch project asset browser to list view");
            } else {
                viewModeButton.SetText("List");
                viewModeButton.SetStyle(1);
                viewModeButton.SetAccessibleName(
                    "Switch project asset browser to grid view");
            }
        }
        RefreshCardSelection();
    }

    /// @brief Show and focus the browser without creating document state.
    expose func Open() {
        if group == null { return; }
        group.SetVisible(true);
        SetGridView(gridView);
        if filterInput != null { filterInput.Focus(); }
    }

    /// @brief Hide the browser and release its decoded thumbnail.
    expose func Close() {
        if group != null { group.SetVisible(false); }
        ClearPreview();
    }

    /// @brief Pump cooperative discovery and return one activated absolute path.
    expose func Pump(
        projectManager: project_manager.ProjectManager,
        canUse: Boolean) -> String {
        if group == null { return ""; }
        if openButton.WasClicked() {
            if group.IsVisible() { Close(); } else { Open(); }
        }
        if group.IsVisible() == false { return ""; }
        if viewModeButton.WasClicked() {
            SetGridView(gridView == false);
        }

        canUseSelection = canUse;
        var projectOpen =
            projectManager != null and projectManager.IsOpen();
        refreshButton.SetEnabled(projectOpen);
        if projectOpen == false {
            ResetRows();
            statusLabel.SetText(
                "Open a workspace folder to browse project assets. "
                + "The system file picker remains available.");
            selectionLabel.SetText("No project assets are available.");
            useButton.SetEnabled(false);
            if closeButton.WasClicked() { Close(); }
            return "";
        }

        if refreshButton.WasClicked() {
            projectManager.StartFileCacheRefresh();
            cacheGeneration = -1;
        }
        projectManager.WarmFileCache(ASSET_CACHE_WORK_PER_FRAME);
        var generation = projectManager.FileCacheGeneration();
        var nextFilter = Str.ToLower(Str.Trim(filterInput.get_Text()));
        if generation != cacheGeneration or nextFilter != filterText {
            cacheGeneration = generation;
            filterText = nextFilter;
            ResetRows();
        }
        if clearFilterButton.WasClicked() {
            filterInput.SetText("");
            filterText = "";
            ResetRows();
            filterInput.Focus();
        }
        if libraryOnlyButton.WasClicked() {
            libraryOnly = libraryOnly == false;
            if libraryOnly {
                libraryOnlyButton.SetText("Library: only");
            } else {
                libraryOnlyButton.SetText("Library: all");
            }
            ResetRows();
        }
        var nextTagFilter =
            Str.ToLower(Str.Trim(tagFilterInput.get_Text()));
        if nextTagFilter != tagFilterText {
            tagFilterText = nextTagFilter;
            ResetRows();
        }
        PumpLibraryEntryActions();

        PumpRows(projectManager);
        RefreshThumbnailGeometry();
        PumpThumbnailPreviews();
        var cardSelectionChanged = PumpThumbnailCards();
        var listSelectionChanged = assetList.WasSelectionChanged();
        if cardSelectionChanged or listSelectionChanged {
            RefreshSelection(projectManager);
            assetList.SetDragData("zanna/asset", SelectedPath());
            RefreshCardSelection();
        } else {
            useButton.SetEnabled(
                canUseSelection and selectedUsable
                and SelectedPath() != "");
        }
        RefreshStatus(projectManager);

        var activated = gridView == false and assetList.WasActivated();
        var useRequested = useButton.WasClicked() or activated;
        if closeButton.WasClicked() {
            Close();
            return "";
        }
        if useRequested and canUseSelection and selectedUsable {
            return SelectedPath();
        }
        return "";
    }

    /// @brief Point the browser at one workspace root's asset library.
    /// @details Reloading is cheap and bounded; an unchanged root keeps the
    ///          published entries and file history.
    expose func SetLibraryRoot(root: String) {
        var clean = Str.Trim(root);
        if clean == libraryRoot { return; }
        libraryRoot = clean;
        var libraryPath = asset_library.PathForRoot(libraryRoot);
        librarySession.Load(libraryPath);
        library = asset_library.LoadPath(libraryPath);
        ResetRows();
        RefreshLibraryStatus("");
    }

    /// @brief Return the library entry for one absolute asset path, or null.
    expose func LibraryEntryForAbsolutePath(
        path: String) -> asset_library.AssetLibraryEntry {
        if library == null or library.valid == false { return null; }
        var relative = LibraryRelativePath(path);
        if relative == "" { return null; }
        return library.EntryForPath(relative);
    }

    /// @brief Convert one absolute path to a root-relative library path.
    hide func LibraryRelativePath(path: String) -> String {
        if libraryRoot == "" or path == "" { return ""; }
        var normalizedRoot =
            PortableSeparators(Path.Normalize(Path.Absolute(libraryRoot)));
        var normalizedPath =
            PortableSeparators(Path.Normalize(Path.Absolute(path)));
        var prefix = normalizedRoot + "/";
        if Str.StartsWith(normalizedPath, prefix) == false { return ""; }
        return Str.MidLen(
            normalizedPath,
            Str.get_Length(prefix) + 1,
            Str.get_Length(normalizedPath) - Str.get_Length(prefix));
    }

    /// @brief Return whether library-only and tag filters accept one path.
    hide func LibraryAllowsPath(path: String) -> Boolean {
        if libraryOnly == false and tagFilterText == "" { return true; }
        var entry = LibraryEntryForAbsolutePath(path);
        if entry == null { return false; }
        if tagFilterText != "" and entry.HasTag(tagFilterText) == false {
            return false;
        }
        return true;
    }

    /// @brief Append library tags to one realized row label.
    hide func LibraryBadgedLabel(label: String, path: String) -> String {
        var entry = LibraryEntryForAbsolutePath(path);
        if entry == null or entry.tags.count() == 0 { return label; }
        var out = label + "  [";
        var index = 0;
        while index < entry.tags.count() {
            if index > 0 { out = out + ", "; }
            out = out + entry.tags.get(index);
            index = index + 1;
        }
        return out + "]";
    }

    /// @brief Apply one Save Entry or Remove Entry intent transactionally.
    hide func PumpLibraryEntryActions() {
        var selected = SelectedPath();
        var relative = LibraryRelativePath(selected);
        var editable = relative != "" and librarySession.path != "";
        saveEntryButton.SetEnabled(editable);
        removeEntryButton.SetEnabled(
            editable and library != null
            and library.EntryForPath(relative) != null);
        if editable == false { return; }
        if saveEntryButton.WasClicked() {
            var tileWidth = ParseGridDraft(entryTileWidthInput.get_Text());
            var tileHeight = ParseGridDraft(entryTileHeightInput.get_Text());
            if tileWidth < 0 or tileHeight < 0 {
                RefreshLibraryStatus(
                    "Grid dimensions must be whole numbers from 1 to 4096.");
                return;
            }
            var errors: List[String] = [];
            var next = asset_library.UpsertEntryText(
                librarySession.currentText,
                relative,
                entryTagsInput.get_Text(),
                tileWidth,
                tileHeight,
                "",
                errors);
            CommitLibraryText(next, errors, "Saved library entry.");
        }
        if removeEntryButton.WasClicked() {
            var errors: List[String] = [];
            var next = asset_library.RemoveEntryText(
                librarySession.currentText, relative, errors);
            CommitLibraryText(next, errors, "Removed library entry.");
        }
    }

    /// @brief Persist one validated library text as one file transition.
    hide func CommitLibraryText(next: String,
                                errors: List[String],
                                successText: String) {
        if next == "" {
            if errors.count() > 0 {
                RefreshLibraryStatus(errors.get(0));
            }
            return;
        }
        if librarySession.Apply(next) == false {
            RefreshLibraryStatus(librarySession.error);
            return;
        }
        library = asset_library.ParseText(next, librarySession.path);
        ResetRows();
        RefreshLibraryStatus(successText);
    }

    /// @brief Parse one optional grid draft: 0 when blank, -1 when invalid.
    hide func ParseGridDraft(text: String) -> Integer {
        var clean = Str.Trim(text);
        if clean == "" { return 0; }
        var parsed = Parse.TryInt(clean);
        if parsed.IsNone { return -1; }
        var value = parsed.UnwrapI64();
        if value < 1 or value > 4096 { return -1; }
        return value;
    }

    /// @brief Refill the entry drafts from the selected asset's library row.
    hide func RefreshEntryDrafts(path: String) {
        if entryTagsInput == null { return; }
        var entry = LibraryEntryForAbsolutePath(path);
        if entry == null {
            entryTagsInput.SetText("");
            entryTileWidthInput.SetText("");
            entryTileHeightInput.SetText("");
            return;
        }
        var tags = "";
        var index = 0;
        while index < entry.tags.count() {
            if index > 0 { tags = tags + ", "; }
            tags = tags + entry.tags.get(index);
            index = index + 1;
        }
        entryTagsInput.SetText(tags);
        if entry.tileWidth > 0 {
            entryTileWidthInput.SetText("" + entry.tileWidth);
            entryTileHeightInput.SetText("" + entry.tileHeight);
        } else {
            entryTileWidthInput.SetText("");
            entryTileHeightInput.SetText("");
        }
    }

    /// @brief Publish library validity or action feedback.
    hide func RefreshLibraryStatus(actionText: String) {
        if libraryStatusLabel == null { return; }
        if library != null and library.found and library.valid == false {
            libraryStatusLabel.SetText(
                "Asset library error: " + library.error);
            return;
        }
        libraryStatusLabel.SetText(actionText);
    }

    /// @brief Absolute data path of the selected row, or empty.
    expose func SelectedPath() -> String {
        if assetList == null or assetList.Selected == null { return ""; }
        return GUI.ListBox.ItemGetData(assetList.Selected);
    }

    /// @brief Rebuild browser state for a changed query or cache generation.
    hide func ResetRows() {
        if assetList != null { assetList.Clear(); }
        if thumbnailGrid != null { thumbnailGrid.ClearChildren(); }
        thumbnailCards = [];
        scanIndex = 0;
        thumbnailAttemptedCount = 0;
        thumbnailReadyCount = 0;
        realizedCount = 0;
        matchedCount = 0;
        resultTruncated = false;
        selectedUsable = false;
        selectedLabel = "";
        ClearPreview();
        if selectionLabel != null {
            selectionLabel.SetText("Select an asset to inspect it.");
        }
        if useButton != null { useButton.SetEnabled(false); }
    }

    /// @brief Scan a bounded page of known files and append matching rows.
    hide func PumpRows(projectManager: project_manager.ProjectManager) {
        var known = projectManager.PeekCachedFileCount();
        var work = 0;
        while scanIndex < known and work < ASSET_ROW_WORK_PER_FRAME {
            var path = projectManager.CachedFileAt(scanIndex);
            scanIndex = scanIndex + 1;
            work = work + 1;
            if AssetExtensionAllowed(path, normalizedExtensions) {
                var label = AssetLabel(projectManager, path);
                if AssetMatchesFilter(label, path, filterText)
                   and LibraryAllowsPath(path) {
                    matchedCount = matchedCount + 1;
                    if realizedCount < MAX_VISIBLE_SCENE_ASSETS {
                        var listRow = realizedCount;
                        var item =
                            assetList.AddItem(LibraryBadgedLabel(label, path));
                        GUI.ListBox.ItemSetData(item, path);
                        realizedCount = realizedCount + 1;
                        if thumbnailCards.count()
                           < MAX_VISIBLE_ASSET_THUMBNAILS {
                            var card =
                                new SceneAssetThumbnailCard();
                            card.Build(
                                thumbnailGrid,
                                path,
                                label,
                                listRow);
                            thumbnailCards.add(card);
                        }
                    } else {
                        resultTruncated = true;
                    }
                }
            }
        }
    }

    /// @brief Keep the wrapping content width equal to its scroll viewport.
    /// @details ScrollView otherwise measures a detached wrapping Flex at its
    ///          unconstrained one-row width. Explicit logical geometry gives
    ///          compact inspectors two columns and wider docks more.
    hide func RefreshThumbnailGeometry() {
        if thumbnailScroll == null or thumbnailGrid == null { return; }
        var available =
            Convert.NumToInt(thumbnailScroll.GetLogicalWidth()) - 12;
        if available < ASSET_CARD_WIDTH {
            available = Convert.NumToInt(group.GetLogicalWidth()) - 24;
        }
        if available < ASSET_CARD_WIDTH {
            available = ASSET_CARD_WIDTH;
        }
        var columns =
            (available + ASSET_CARD_GAP)
            / (ASSET_CARD_WIDTH + ASSET_CARD_GAP);
        if columns < 1 { columns = 1; }
        var rows = 0;
        if thumbnailCards.count() > 0 {
            rows =
                (thumbnailCards.count() + columns - 1) / columns;
        }
        var contentHeight = 1;
        if rows > 0 {
            contentHeight =
                rows * ASSET_CARD_HEIGHT
                + (rows - 1) * ASSET_CARD_GAP + 4;
        }
        thumbnailGrid.SetSize(available, contentHeight);
        thumbnailScroll.SetContentSize(
            available + 0.0, contentHeight + 0.0);
    }

    /// @brief Decode or render at most one visible thumbnail this frame.
    /// @details Offscreen cards remain cheap placeholders until scrolling
    ///          reveals them. This keeps large model folders responsive
    ///          without background-threading GUI or Canvas3D work.
    hide func PumpThumbnailPreviews() {
        if gridView == false { return; }
        var index = 0;
        while index < thumbnailCards.count() {
            var card = thumbnailCards.get(index);
            if card.thumbnailAttempted == false
               and ThumbnailCardVisible(card, index) {
                card.thumbnailAttempted = true;
                thumbnailAttemptedCount =
                    thumbnailAttemptedCount + 1;
                var pixels = scene_asset_thumbnails.Load(
                    card.path, ASSET_THUMBNAIL_EDGE);
                if pixels != null {
                    card.SetThumbnail(pixels);
                    thumbnailReadyCount = thumbnailReadyCount + 1;
                }
                return;
            }
            index = index + 1;
        }
    }

    /// @brief Return whether one card intersects the live grid viewport.
    hide func ThumbnailCardVisible(
        card: SceneAssetThumbnailCard,
        index: Integer) -> Boolean {
        if card == null or card.host == null { return false; }
        var viewportHeight = thumbnailScroll.GetScreenHeight();
        var viewportWidth = thumbnailScroll.GetScreenWidth();
        // Before the first native layout, seed only the first visible row.
        if viewportHeight <= 1.0 or viewportWidth <= 1.0 {
            return index < 4;
        }
        var viewportTop = thumbnailScroll.GetScreenY();
        var viewportBottom = viewportTop + viewportHeight;
        var cardTop = card.host.GetScreenY();
        var cardBottom = cardTop + card.host.GetScreenHeight();
        return cardBottom > viewportTop and cardTop < viewportBottom;
    }

    /// @brief Route card clicks into the complete hidden list model.
    hide func PumpThumbnailCards() -> Boolean {
        if gridView == false { return false; }
        var selectedCard = -1;
        var index = 0;
        while index < thumbnailCards.count() {
            if thumbnailCards.get(index).TakeClicked()
               and selectedCard < 0 {
                selectedCard = index;
            }
            index = index + 1;
        }
        if selectedCard < 0 { return false; }
        assetList.SelectIndex(
            thumbnailCards.get(selectedCard).rowIndex);
        return true;
    }

    /// @brief Mirror canonical list selection into card button styling.
    hide func RefreshCardSelection() {
        var selectedRow = -1;
        if assetList != null { selectedRow = assetList.SelectedIndex; }
        var index = 0;
        while index < thumbnailCards.count() {
            var card = thumbnailCards.get(index);
            card.SetSelected(card.rowIndex == selectedRow);
            index = index + 1;
        }
    }

    /// @brief Publish honest indexing, match, and truncation status.
    hide func RefreshStatus(projectManager: project_manager.ProjectManager) {
        if statusLabel == null { return; }
        var text = "" + matchedCount + " matching project assets";
        if resultTruncated {
            text = "Showing first " + MAX_VISIBLE_SCENE_ASSETS
                + " matching assets; narrow the filter";
        } else if projectManager.IsFileCacheComplete() == false {
            text = text + " • indexing "
                + projectManager.PeekCachedFileCount() + " known files";
        } else if matchedCount == 0 {
            text = "No supported project assets match this filter.";
        }
        if projectManager.IsFileCacheComplete()
           and projectManager.fileCacheTruncated {
            text = text + " • workspace index truncated";
        }
        if gridView and thumbnailCards.count() > 0 {
            text = text + " • previews "
                + thumbnailAttemptedCount + "/"
                + thumbnailCards.count();
            if thumbnailAttemptedCount < thumbnailCards.count() {
                text = text + " (scroll to load more)";
            }
            if realizedCount > thumbnailCards.count() {
                text = text + " • List shows all "
                    + realizedCount + " rows";
            }
        }
        statusLabel.SetText(text);
    }

    /// @brief Load one bounded thumbnail and update selection enablement.
    hide func RefreshSelection(
        projectManager: project_manager.ProjectManager) {
        ClearPreview();
        selectedUsable = false;
        var path = SelectedPath();
        RefreshEntryDrafts(path);
        if path == "" {
            selectionLabel.SetText("Select an asset to inspect it.");
            useButton.SetEnabled(false);
            return;
        }
        selectedLabel = AssetLabel(projectManager, path);
        var sourceBytes = safe_io.SizeBytes(path);
        if sourceBytes < 0 {
            selectionLabel.SetText(
                selectedLabel + "\nThe file is missing or unreadable.");
            useButton.SetEnabled(false);
            return;
        }
        selectedUsable = true;
        if sourceBytes > MAX_ASSET_PREVIEW_SOURCE_BYTES {
            selectionLabel.SetText(
                selectedLabel + "\nPreview omitted above 16 MB.");
            useButton.SetEnabled(canUseSelection);
            return;
        }
        if scene_asset_thumbnails.IsModelAsset(path) {
            previewPixels = scene_asset_thumbnails.Load(
                path, MAX_ASSET_PREVIEW_EDGE);
            if previewPixels != null {
                previewImage.SetPixels(
                    previewPixels,
                    previewPixels.Width,
                    previewPixels.Height);
                previewImage.SetSize(
                    previewPixels.Width, previewPixels.Height);
                previewStage.SetSize(
                    previewPixels.Width, previewPixels.Height);
                previewImage.SetVisible(true);
                selectionLabel.SetText(
                    selectedLabel
                    + "\nDeterministic framed 3D preview");
            } else {
                selectionLabel.SetText(
                    selectedLabel
                    + "\nThe 3D preview could not be rendered.");
            }
            useButton.SetEnabled(canUseSelection);
            return;
        }
        var extension = Str.ToLower(Path.Extension(path));
        if extension != ".png" and extension != ".jpg"
           and extension != ".jpeg" and extension != ".bmp"
           and extension != ".gif" {
            selectionLabel.SetText(
                selectedLabel + "\nPreview is unavailable for "
                + extension + " assets.");
            useButton.SetEnabled(canUseSelection);
            return;
        }

        var source = LoadAssetPreview(path);
        if source == null {
            selectionLabel.SetText(
                selectedLabel + "\nThe image preview could not be decoded.");
            useButton.SetEnabled(canUseSelection);
            return;
        }
        var sourcePixels = source.Width * source.Height;
        if sourcePixels <= 0 or sourcePixels > MAX_ASSET_PREVIEW_PIXELS {
            selectionLabel.SetText(
                selectedLabel + "\nPreview omitted above 4,194,304 pixels.");
            useButton.SetEnabled(canUseSelection);
            return;
        }

        previewPixels = ScalePreview(source);
        if previewPixels != null {
            previewImage.SetPixels(
                previewPixels, previewPixels.Width, previewPixels.Height);
            previewImage.SetSize(previewPixels.Width, previewPixels.Height);
            previewStage.SetSize(
                previewPixels.Width, previewPixels.Height);
            previewImage.SetVisible(true);
            selectionLabel.SetText(
                selectedLabel + "\n" + source.Width + " × " + source.Height
                + " pixels");
        } else {
            selectionLabel.SetText(
                selectedLabel + "\nThe image preview could not be scaled.");
        }
        useButton.SetEnabled(canUseSelection);
    }

    /// @brief Drop the selected thumbnail and clear its widget.
    hide func ClearPreview() {
        previewPixels = null;
        if previewImage != null {
            previewImage.Clear();
            previewImage.SetVisible(false);
        }
    }

    /// @brief Scale one valid source into the bounded preview square.
    hide func ScalePreview(source: Pixels) -> Pixels {
        if source == null or source.Width <= 0 or source.Height <= 0 {
            return null;
        }
        if source.Width <= MAX_ASSET_PREVIEW_EDGE
           and source.Height <= MAX_ASSET_PREVIEW_EDGE {
            return source.Clone();
        }
        var width = MAX_ASSET_PREVIEW_EDGE;
        var height = source.Height * MAX_ASSET_PREVIEW_EDGE / source.Width;
        if source.Height > source.Width {
            height = MAX_ASSET_PREVIEW_EDGE;
            width = source.Width * MAX_ASSET_PREVIEW_EDGE / source.Height;
        }
        if width < 1 { width = 1; }
        if height < 1 { height = 1; }
        try {
            return source.Resize(width, height);
        } catch {
            return null;
        }
        return null;
    }

    /// @brief Root-aware row label for single- and multi-root workspaces.
    hide func AssetLabel(
        projectManager: project_manager.ProjectManager,
        path: String) -> String {
        var relative = projectManager.RelativePath(path);
        if projectManager.RootCount() <= 1 { return relative; }
        var owner = projectManager.WorkspaceRootPathForPath(path);
        var i = 0;
        while i < projectManager.RootCount() {
            if Path.Normalize(projectManager.RootPathAt(i))
               == Path.Normalize(owner) {
                return projectManager.RootNameAt(i) + "/" + relative;
            }
            i = i + 1;
        }
        return relative;
    }
}

/// @brief Convert platform separators to portable forward slashes.
func PortableSeparators(path: String) -> String {
    var value = Str.Replace(path, "\\", "/");
    var separator = Path.Separator();
    if separator != "/" {
        value = Str.Replace(value, separator, "/");
    }
    return value;
}

/// @brief Split a normalized filesystem path into meaningful components.
func AssetPathParts(path: String) -> Any {
    var parts = Seq.New();
    var raw = Str.Split(PortableSeparators(path), "/");
    var i = 0;
    while i < Seq.get_Count(raw) {
        var part = Obj.ToString(Seq.Get(raw, i));
        if part != "" and part != "." {
            Seq.Push(parts, part);
        }
        i = i + 1;
    }
    return parts;
}

/// @brief Append one portable path component.
func AppendAssetPath(path: String, component: String) -> String {
    if path == "" { return component; }
    return path + "/" + component;
}

/// @brief Decode one preview without leaking loader exceptions into UI state.
func LoadAssetPreview(path: String) -> Pixels {
    try {
        return Pixels.Load(path);
    } catch {
        return null;
    }
    return null;
}
