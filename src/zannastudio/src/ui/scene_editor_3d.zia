    /// @brief Build the editor into WorkbenchShell.scene3DHost.

    /// @brief Borrow Studio's multi-root project index for non-modal assets.
    expose func SetWorkspaceContext(
        nextProjectManager: project_manager.ProjectManager) {
        projectManager = nextProjectManager;
        ReloadComponentSchema();
        if scene != null { RebuildProjectNodePreviews(); }
    }

    /// @brief Reload project component templates for the active document root.
    expose func ReloadComponentSchema() {
        var rootPath = ComponentSchemaRoot();
        componentSchemaPath =
            scene_component_schema.PathForRoot(rootPath);
        if componentPalette != null and componentPalette.group != null
           and componentAuthoring != null {
            componentAuthoring.Load(
                componentSchemaPath,
                scene_component_schema.TARGET_3D_NODE,
                componentPalette);
            componentSchema = componentAuthoring.schema;
            RefreshComponentPalette();
        } else {
            componentSchema =
                scene_component_schema.LoadPath(componentSchemaPath);
        }
        viewportPostFXDirty = true;
        renderDirty = true;
    }

    /// @brief Keep multi-root schema ownership aligned with document ownership.
    hide func EnsureComponentSchema(force: Boolean) {
        var nextPath = scene_component_schema.PathForRoot(
            ComponentSchemaRoot());
        if force or nextPath != componentSchemaPath {
            ReloadComponentSchema();
        }
    }

    /// @brief Resolve the unambiguous workspace root for the current scene.
    hide func ComponentSchemaRoot() -> String {
        if projectManager == null { return ""; }
        if currentDoc != null and currentDoc.filePath != "" {
            var owner =
                projectManager.WorkspaceRootPathForPath(currentDoc.filePath);
            if owner != "" { return owner; }
            return project_locator.NearestManifestRoot(
                currentDoc.filePath);
        }
        if projectManager.RootCount() == 1 {
            return projectManager.RootPathAt(0);
        }
        return "";
    }

    /// @brief Find the first project rule matching one exact string metadata.
    hide func ProjectNodePreviewRule(
        node: SceneNode) -> scene_component_schema.SceneNodePreview3DDefinition {
        if node == null or componentSchema == null
           or componentSchema.valid == false {
            return null;
        }
        var index = 0;
        while index < componentSchema.nodePreviews3D.count() {
            var rule = componentSchema.nodePreviews3D.get(index);
            if rule != null
               and node.MetadataHas(rule.matchProperty)
               and node.MetadataKind(rule.matchProperty) == "string"
               and node.MetadataGetString(rule.matchProperty, "")
                  == rule.matchValue {
                return rule;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Resolve one rule's integer variant with its authored fallback.
    hide func ProjectNodePreviewPrefab(
        node: SceneNode,
        rule: scene_component_schema.SceneNodePreview3DDefinition)
        -> String {
        if node == null or rule == null { return ""; }
        if rule.variantProperty != ""
           and node.MetadataHas(rule.variantProperty)
           and node.MetadataKind(rule.variantProperty) == "int" {
            return rule.PrefabForVariant(
                node.MetadataGetInt(rule.variantProperty, -1));
        }
        return rule.prefab;
    }

    /// @brief Resolve one scene-level environment prefab from root metadata.
    hide func ProjectEnvironmentPreviewPrefab() -> String {
        if scene == null or scene.Root == null
           or componentSchema == null
           or componentSchema.valid == false
           or componentSchema.scenePreview3D == null {
            return "";
        }
        var profile = componentSchema.scenePreview3D;
        if profile.environmentVariantProperty != ""
           and scene.Root.MetadataHas(
               profile.environmentVariantProperty)
           and scene.Root.MetadataKind(
               profile.environmentVariantProperty) == "int" {
            return profile.EnvironmentPrefabForVariant(
                scene.Root.MetadataGetInt(
                    profile.environmentVariantProperty, 0));
        }
        return profile.environmentPrefab;
    }

    /// @brief Load and cache one validated project preview asset.
    hide func ProjectNodePreviewAsset(path: String) -> SceneAsset {
        var index = 0;
        while index < projectPreviewAssetPaths.count() {
            if projectPreviewAssetPaths.get(index) == path {
                return projectPreviewAssets.get(index);
            }
            index = index + 1;
        }
        if projectPreviewAssetPaths.count()
           >= MAX_PROJECT_PREVIEW_ASSETS {
            projectPreviewClipped = true;
            return null;
        }
        var asset: SceneAsset = null;
        var read = safe_io.ReadAllTextBounded(path, MAX_SCENE_BYTES);
        if read.ok {
            var loaded = SceneAsset.LoadTextResult(path, read.text);
            if loaded != null and loaded.IsOk {
                asset = loaded.Unwrap() as SceneAsset;
            }
        }
        projectPreviewAssetPaths.add(path);
        projectPreviewAssets.add(asset);
        return asset;
    }

    /// @brief Record transient subtree identities that map to one source node.
    hide func AppendProjectPreviewOwners(node: SceneNode,
                                         owner: Integer) {
        if node == null
           or projectPreviewNodes.count() >= MAX_PROJECT_PREVIEW_NODES {
            projectPreviewClipped = true;
            return;
        }
        projectPreviewNodes.add(node);
        projectPreviewOwners.add(owner);
        var child = 0;
        while child < node.ChildCount
              and projectPreviewNodes.count()
                  < MAX_PROJECT_PREVIEW_NODES {
            AppendProjectPreviewOwners(node.GetChild(child), owner);
            child = child + 1;
        }
        if child < node.ChildCount { projectPreviewClipped = true; }
    }

    /// @brief Compose optional project metadata rotation/scale after source TRS.
    hide func ProjectPreviewWorldMatrix(
        node: SceneNode,
        rule: scene_component_schema.SceneNodePreview3DDefinition) -> Mat4 {
        var result = node.WorldMatrix;
        var yaw = 0.0;
        if rule.yawProperty != ""
           and node.MetadataHas(rule.yawProperty)
           and node.MetadataKind(rule.yawProperty) == "float" {
            yaw = node.MetadataGetFloat(rule.yawProperty, 0.0);
            if rule.yawUnit == "degrees" { yaw = yaw * DEG_TO_RAD; }
        }
        var scale = 1.0;
        if rule.scaleProperty != ""
           and node.MetadataHas(rule.scaleProperty)
           and node.MetadataKind(rule.scaleProperty) == "float" {
            scale = ClampNumber3D(
                node.MetadataGetFloat(rule.scaleProperty, 1.0),
                -1000.0,
                1000.0);
        }
        return Mat4.Mul(
            result,
            Mat4.Mul(Mat4.RotateY(yaw), Mat4.ScaleUniform(scale)));
    }

    /// @brief Rebuild every project preview in a disposable scene graph.
    /// @details No transient node ever enters the canonical scene or history.
    hide func RebuildProjectNodePreviews() {
        projectPreviewScene = null;
        projectPreviewInstanceCount = 0;
        projectPreviewMissingCount = 0;
        projectPreviewClipped = false;
        projectPreviewAssetPaths = [];
        projectPreviewAssets = [];
        projectPreviewNodes = [];
        projectPreviewOwners = [];
        var environmentReference =
            ProjectEnvironmentPreviewPrefab();
        if scene == null or componentSchema == null
           or componentSchema.valid == false
           or (componentSchema.nodePreviews3D.count() == 0
               and environmentReference == "") {
            return;
        }
        var projectRoot = ComponentSchemaRoot();
        if projectRoot == "" { return; }
        projectPreviewScene = SceneGraph.New();
        if environmentReference != "" {
            var environmentPath = Path.Normalize(Path.Absolute(
                Path.Join(projectRoot, environmentReference)));
            var environmentAsset =
                ProjectNodePreviewAsset(environmentPath);
            var environmentInstance: SceneGraph = null;
            if environmentAsset != null {
                environmentInstance =
                    environmentAsset.InstantiateScene() as SceneGraph;
            }
            if environmentInstance == null
               or environmentInstance.Root == null
               or environmentInstance.Root.ChildCount == 0 {
                projectPreviewMissingCount =
                    projectPreviewMissingCount + 1;
            } else if environmentInstance.NodeCount
                      > MAX_PROJECT_PREVIEW_NODES {
                projectPreviewClipped = true;
            } else {
                var environmentWrapper = SceneNode.New();
                environmentWrapper.Name = "Scene environment preview";
                var environmentRoot = environmentInstance.Root;
                while environmentRoot.ChildCount > 0 {
                    var environmentChild =
                        environmentRoot.GetChild(0);
                    environmentRoot.RemoveChild(environmentChild);
                    environmentWrapper.AddChild(environmentChild);
                }
                projectPreviewScene.Add(environmentWrapper);
                AppendProjectPreviewOwners(
                    environmentWrapper, -1);
                projectPreviewInstanceCount =
                    projectPreviewInstanceCount + 1;
            }
        }
        var sourceIndex = 0;
        while sourceIndex < flatNodes.count()
              and projectPreviewNodes.count()
                  < MAX_PROJECT_PREVIEW_NODES {
            var source = flatNodes.get(sourceIndex);
            var rule = ProjectNodePreviewRule(source);
            var reference =
                ProjectNodePreviewPrefab(source, rule);
            if reference != "" {
                var path = Path.Normalize(Path.Absolute(
                    Path.Join(projectRoot, reference)));
                var asset = ProjectNodePreviewAsset(path);
                var instance: SceneGraph = null;
                if asset != null {
                    instance = asset.InstantiateScene() as SceneGraph;
                }
                if instance == null
                   or instance.Root == null
                   or instance.Root.ChildCount == 0 {
                    projectPreviewMissingCount =
                        projectPreviewMissingCount + 1;
                } else if projectPreviewNodes.count()
                          + instance.NodeCount
                          > MAX_PROJECT_PREVIEW_NODES {
                    projectPreviewClipped = true;
                    break;
                } else {
                    var wrapper = SceneNode.New();
                    wrapper.Name = "Preview " + sourceIndex;
                    var prefabRoot = instance.Root;
                    while prefabRoot.ChildCount > 0 {
                        var child = prefabRoot.GetChild(0);
                        prefabRoot.RemoveChild(child);
                        wrapper.AddChild(child);
                    }
                    if wrapper.TrySetWorldMatrix(
                           ProjectPreviewWorldMatrix(
                               source, rule)) == false {
                        projectPreviewMissingCount =
                            projectPreviewMissingCount + 1;
                    } else {
                        projectPreviewScene.Add(wrapper);
                        AppendProjectPreviewOwners(
                            wrapper, sourceIndex);
                        projectPreviewInstanceCount =
                            projectPreviewInstanceCount + 1;
                    }
                }
            }
            sourceIndex = sourceIndex + 1;
        }
        if sourceIndex < flatNodes.count() {
            projectPreviewClipped = true;
        }
        if projectPreviewInstanceCount == 0 {
            projectPreviewScene = null;
        }
        renderDirty = true;
    }

    /// @brief Map one transient preview hit back to its canonical marker.
    hide func ProjectPreviewOwner(node: SceneNode) -> Integer {
        var index = 0;
        while index < projectPreviewNodes.count()
              and index < projectPreviewOwners.count() {
            if projectPreviewNodes.get(index) == node {
                return projectPreviewOwners.get(index);
            }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Pump the active document and return true when VSCN content changed.
    expose func Pump(activeDoc: document.Document) -> Boolean {
        if activeDoc == null or activeDoc.kind != file_utils.DOC_KIND_SCENE_3D {
            return false;
        }
        insetFrameCounter = insetFrameCounter + 1;
        if activeDoc != currentDoc or activeDoc.content != currentSerialized {
            Activate(activeDoc);
        }
        EnsureComponentSchema(false);
        UpdateProjectViewButton();
        if activeDoc == currentDoc and activeDoc.isModified == false
           and activeDoc.content == currentSerialized {
            cleanSerialized = currentSerialized;
        }

        RefreshResponsiveLayout();
        if hierarchyButton.WasClicked() { ToggleHierarchyPane(); }
        if inspectorButton.WasClicked() { ToggleInspectorPane(); }
        if workspaceButton.WasClicked() {
            RequestWorkspaceModeToggle();
        }
        if focusButton.WasClicked() { RequestFocusModeToggle(); }
        if objectTabButton.WasClicked() { SetInspectorSceneTab(false); }
        if sceneTabButton.WasClicked() { SetInspectorSceneTab(true); }

        var changed = false;
        // Commit or cancel a pending live transform edit before selection
        // and document handlers can observe uncommitted live-node state.
        changed = PumpTransformDraft() or changed;
        if addComponentButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = AddSelectedComponentChoice() or changed;
        }
        if newSceneButton.WasClicked() {
            scene = SceneGraph.New();
            loadError = "";
            selectedIndex = -1;
            selectedIndices = [];
            selectedNodeMetadata = -1;
            metadataOwnerIndex = -1;
            viewTargetX = 0.0;
            viewTargetY = 0.0;
            viewTargetZ = 0.0;
            ReleaseGameplayViewAnchor();
            SetEditorControlsEnabled(true);
            RefreshHierarchy(null);
            changed = CommitScene("Created empty 3D scene") or changed;
        }
        if importAssetButton.WasClicked() {
            importBrowserInstanceMode = false;
            importAssetBrowser.SetExtensions(
                ".scene3d,.vscn,.gltf,.glb,.fbx,.obj,.stl");
            changed = ImportAsset() or changed;
        }
        if importInstanceButton.WasClicked() {
            importBrowserInstanceMode = true;
            importAssetBrowser.SetExtensions(".scene3d,.vscn");
            importAssetBrowser.Open();
        }
        var projectImportPath = importAssetBrowser.Pump(
            projectManager, currentDoc != null);
        if projectImportPath != "" {
            if envBrowseMode {
                envBrowseMode = false;
                var documentPath = "";
                if currentDoc != null {
                    documentPath = currentDoc.filePath;
                }
                envSkyboxInput.SetText(
                    scene_asset_browser.PortableReferencePath(
                        projectImportPath, documentPath));
                importAssetBrowser.Close();
            } else if importBrowserInstanceMode {
                changed = ImportInstancePath(projectImportPath) or changed;
            } else {
                changed = ImportAssetPath(projectImportPath) or changed;
            }
        }
        if openPrefabSourceButton.WasClicked() {
            RequestOpenPrefabSource();
        }
        if reloadInstancesButton.WasClicked() {
            ReloadPrefabInstances();
        }
        if unpackInstanceButton.WasClicked()
           and selectedIndices.count() == 1 {
            changed = UnpackSelectedInstance() or changed;
        }
        if relinkInstanceButton.WasClicked()
           and selectedIndices.count() == 1 {
            importBrowserInstanceMode = true;
            importAssetBrowser.SetExtensions(".scene3d,.vscn");
            importAssetBrowser.Open();
            detailLabel.SetText(
                "Choose the new referenced scene for "
                + NodeDisplayName(SelectedNode()) + ".");
        }
        PumpBakeControls();
        changed = PumpBakeSteps() or changed;
        var projectMapPath = materialInspector.assetBrowser.Pump(
            projectManager,
            scene != null and SelectedNode() != null
            and selectedIndices.count() > 0);
        if projectMapPath != "" {
            changed = ApplySelectedMaterialMapPath(
                materialInspector.mapSlot.Selected,
                projectMapPath) or changed;
        }
        UpdateViewportSize();
        if initialProjectPreviewPending {
            ApplyInitialProjectPreview();
            initialProjectPreviewPending = false;
        }
        if viewportModeButton.WasClicked() {
            var nextViewportMode = VIEWPORT_MODE_WIREFRAME;
            if viewportMode == VIEWPORT_MODE_WIREFRAME {
                nextViewportMode = VIEWPORT_MODE_SHADED_WIRE;
            } else if viewportMode == VIEWPORT_MODE_SHADED_WIRE {
                nextViewportMode = VIEWPORT_MODE_SHADED;
            }
            SetViewportMode(nextViewportMode);
        }
        if moveToolButton.WasClicked() { SetGizmoMode(GIZMO_MODE_MOVE); }
        if rotateToolButton.WasClicked() { SetGizmoMode(GIZMO_MODE_ROTATE); }
        if scaleToolButton.WasClicked() { SetGizmoMode(GIZMO_MODE_SCALE); }
        if transformSpaceButton.WasClicked() {
            var nextSpace = scene_transform_3d.TRANSFORM_SPACE_WORLD;
            if gizmoTransformSpace
               == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                nextSpace = scene_transform_3d.TRANSFORM_SPACE_LOCAL;
            }
            SetGizmoTransformSpace(nextSpace);
        }
        var nextSnapRevision = snapTransformCheck.GetRevision();
        if nextSnapRevision != snapTransformRevision {
            snapTransformRevision = nextSnapRevision;
            SetGizmoSnapEnabled(snapTransformCheck.IsChecked());
        }
        if projectionButton.WasClicked() {
            SetViewProjection(!viewPerspective);
        }
        if projectViewButton.WasClicked() {
            ApplyProjectPreviewView();
        }
        if viewOptionsButton.WasClicked() {
            SetViewOptionsVisible(!viewOptionsVisible);
        }
        PumpViewOptionControls();
        if scene == null {
            if renderDirty { RenderViewport(); }
            ApplyPendingWorkspaceScroll();
            ApplyInspectorLayout();
            CaptureWorkspaceState();
            return changed;
        }

        PumpHierarchySearchControls();
        if hierarchyShowButton.WasClicked() {
            changed = ApplySelectedVisibility(true) or changed;
        }
        if hierarchyHideButton.WasClicked() {
            changed = ApplySelectedVisibility(false) or changed;
        }
        if hierarchyPickLockButton.WasClicked() {
            ToggleSelectedPickLocks();
        }
        if addEmptyButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_EMPTY, false) or changed;
        }
        if addChildButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_EMPTY, true) or changed;
        }
        if addBoxButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_BOX, false) or changed;
        }
        if addSphereButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_SPHERE, false) or changed;
        }
        if addPlaneButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_PLANE, false) or changed;
        }
        if addCylinderButton.WasClicked() {
            changed = AddPrimitive(PRIMITIVE_CYLINDER, false) or changed;
        }
        if addLightButton.WasClicked() {
            changed = AddLightNode(
                "Point Light " + scene.NodeCount, -1) >= 0 or changed;
        }
        if addCameraButton.WasClicked() {
            changed = AddCameraNode(
                "Camera " + scene.NodeCount, -1) >= 0 or changed;
        }
        if duplicateNodeButton.WasClicked() {
            changed = DuplicateSelectedNodes() > 0 or changed;
        }
        if deleteNodeButton.WasClicked() {
            changed = DeleteSelectedNodes() or changed;
        }
        if hierarchyTree.WasSelectionChanged() {
            var primaryRow = hierarchyTree.GetSelected();
            selectedIndex = -1;
            if primaryRow != null {
                selectedIndex = Parse.IntOr(
                    GUI.TreeView.Node.GetData(primaryRow), -1);
            }
            selectedIndices = ResolveInstanceOwnerSelection(
                scene_selection.FromData(
                    hierarchyTree.GetSelectedData(),
                    flatNodes.count(),
                    selectedIndex));
            selectedIndex = ResolveInstanceOwnerIndex(selectedIndex);
            if selectedIndex < 0 and selectedIndices.count() > 0 {
                selectedIndex = selectedIndices.get(0);
            }
            RefreshSelectedFields();
            SetEditorControlsEnabled(scene != null);
            renderDirty = true;
        }
        if hierarchyTree.WasDropReceived() {
            var sourceIndex = Parse.IntOr(
                hierarchyTree.GetDropSourceData(), -1);
            var targetIndex = Parse.IntOr(
                hierarchyTree.GetDropTargetData(), -1);
            var dropPosition = hierarchyTree.GetDropPosition();
            hierarchyTree.ClearDrop();
            changed = ApplyHierarchyDrop(
                sourceIndex, targetIndex, dropPosition) or changed;
        }
        if hierarchyTree.WasEditCommitted() {
            changed = ApplyHierarchyRename() or changed;
        }
        changed = PumpViewportDrops() or changed;
        var metadataNode = SelectedNode();
        metadataInspector.Pump(metadataNode);
        selectedNodeMetadata = metadataInspector.selectedProperty;
        var metadataCommitRow = metadataInspector.TakeCommitRow();
        if metadataCommitRow >= 0
           and selectedIndices.count() == 1 {
            changed = SetNodeMetadata(
                selectedIndex,
                metadataInspector.CanonicalKeyAt(metadataCommitRow),
                metadataInspector.KeyTextAt(metadataCommitRow),
                metadataInspector.KindTokenAt(metadataCommitRow),
                metadataInspector.ValueTextAt(metadataCommitRow)) or changed;
        }
        var metadataRemoveRow = metadataInspector.TakeRemoveRow();
        if metadataRemoveRow >= 0
           and selectedIndices.count() == 1 {
            changed = RemoveNodeMetadata(
                selectedIndex,
                metadataInspector.CanonicalKeyAt(metadataRemoveRow)) or changed;
        }
        changed = PumpComponentControls() or changed;
        if parentDropdown.WasChanged() {
            UpdateParentControlAvailability();
        }
        if preserveWorldReparentCheck.WasChanged() {
            UpdateParentControlAvailability();
        }
        if reparentButton.WasClicked() {
            changed = ReparentSelectedNodes(
                SelectedParentTargetIndex()) or changed;
        }
        if moveSiblingEarlierButton.WasClicked() {
            changed = MoveSelectedSiblings(-1) or changed;
        }
        if moveSiblingLaterButton.WasClicked() {
            changed = MoveSelectedSiblings(1) or changed;
        }
        if applyTransformButton.WasClicked() {
            if selectedIndices.count() > 1 {
                changed = ApplySelectedTransformDeltas(
                    positionX.Value, positionY.Value, positionZ.Value,
                    rotationX.Value, rotationY.Value, rotationZ.Value,
                    scaleX.Value, scaleY.Value, scaleZ.Value) or changed;
            } else if selectedIndices.count() == 1 {
                changed = ApplySelectedNode() or changed;
            }
        }
        if nameInput.WasSubmitted() and selectedIndices.count() == 1 {
            changed = ApplySelectedNode() or changed;
        }
        if lightInspector.typeDropdown.WasChanged() {
            lightInspector.UpdateTypeControls();
        }
        lightInspector.PumpDraftIntent();
        if lightInspector.applyButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = ApplySelectedLightFromControls() or changed;
        }
        if lightInspector.removeButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = RemoveSelectedLights() or changed;
        }
        if cameraInspector.projectionDropdown.WasChanged() {
            cameraInspector.UpdateProjectionControls();
        }
        if cameraInspector.applyButton.WasClicked()
           and selectedIndices.count() == 1 {
            changed = ApplySelectedCameraFromControls() or changed;
        }
        if cameraInspector.removeButton.WasClicked()
           and selectedIndices.count() == 1 {
            changed = RemoveNodeCamera(selectedIndex) or changed;
        }
        if cameraInspector.lookThroughButton.WasClicked() {
            ToggleLookThrough();
        }
        if cameraInspector.previewCheck.WasChanged() {
            insetEnabled = cameraInspector.previewCheck.IsChecked();
            renderDirty = true;
        }
        if colliderInspector.kindDropdown.WasChanged() {
            colliderInspector.UpdateKindControls();
        }
        if colliderInspector.applyButton.WasClicked()
           and selectedIndices.count() == 1 {
            changed = ApplySelectedColliderFromControls() or changed;
        }
        if colliderInspector.removeButton.WasClicked()
           and selectedIndices.count() == 1 {
            changed = RemoveNodeColliderConvention(selectedIndex) or changed;
        }
        var componentAssetPath = componentAssetBrowser.Pump(
            projectManager,
            scene != null and selectedIndices.count() == 1
            and SelectedAssetComponentField() != null);
        if componentAssetPath != "" {
            ApplyComponentAssetPath(componentAssetPath);
        }
        materialInspector.PumpDraftIntent();
        PumpMaterialLibraryControls();
        if materialInspector.applyButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = ApplySelectedMaterialFromControls() or changed;
        }
        if materialInspector.removeButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = RemoveSelectedMaterials() or changed;
        }
        if materialInspector.mapSlot.WasChanged() {
            materialInspector.RefreshMapSummarySelection(
                SelectedMaterialNodes());
            UpdateMaterialControls(true);
        }
        if materialInspector.chooseMapButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = ChooseMaterialMap() or changed;
        }
        if materialInspector.clearMapButton.WasClicked()
           and selectedIndices.count() > 0 {
            changed = ClearSelectedMaterialMap(
                materialInspector.mapSlot.Selected) or changed;
        }
        var nextVisibleRevision = visibleCheck.GetRevision();
        if nextVisibleRevision != visibleRevision {
            visibleRevision = nextVisibleRevision;
            if selectedIndices.count() > 0
               and visibleCheck.IsIndeterminate() == false {
                changed = ApplySelectedVisibility(
                    visibleCheck.IsChecked()) or changed;
            }
        }
        var nextStaticRevision = staticCheck.GetRevision();
        if nextStaticRevision != staticRevision {
            staticRevision = nextStaticRevision;
            if selectedIndices.count() > 0
               and staticCheck.IsIndeterminate() == false {
                changed = ApplySelectedStatic(
                    staticCheck.IsChecked()) or changed;
            }
        }

        if runSceneButton.WasClicked() { runSceneRequested = true; }
        if topViewButton.WasClicked() { SetQuickView(0); }
        if frontViewButton.WasClicked() { SetQuickView(1); }
        if rightViewButton.WasClicked() { SetQuickView(2); }
        if orbitLeftButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewYawDegrees = NormalizeYawDegrees(viewYawDegrees - 15);
            renderDirty = true;
        }
        if orbitRightButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewYawDegrees = NormalizeYawDegrees(viewYawDegrees + 15);
            renderDirty = true;
        }
        if orbitUpButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewPitchDegrees = ClampInt3D(viewPitchDegrees + 10, -80, 80);
            renderDirty = true;
        }
        if orbitDownButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewPitchDegrees = ClampInt3D(viewPitchDegrees - 10, -80, 80);
            renderDirty = true;
        }
        if zoomOutButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewScale = ClampInt3D(viewScale - 4, 4, 120);
            renderDirty = true;
        }
        if zoomInButton.WasClicked() {
            ReleaseGameplayViewAnchor();
            viewScale = ClampInt3D(viewScale + 4, 4, 120);
            renderDirty = true;
        }
        if frameButton.WasClicked() {
            FrameAll();
            renderDirty = true;
        }
        if frameSelectedButton.WasClicked() {
            FrameSelected();
            renderDirty = true;
        }

        PumpCameraBookmarks();
        PumpHistoryPanel();
        if hierarchyDock.Pump() {
            ApplyInspectorLayout();
            renderDirty = true;
        }
        if inspectorDock.Pump() {
            ApplyInspectorLayout();
            renderDirty = true;
        }
        if changed { RefreshHistoryPanel(); }
        changed = PumpViewportNavigation() or changed;
        if viewportTargetWidth != 0
           and InteractiveDegradeActive() == false
           and (viewportTargetWidth != renderedViewportWidth
                or viewportTargetHeight != renderedViewportHeight) {
            // The last interactive frame rendered at reduced resolution;
            // re-render once at full resolution now that the drag ended.
            renderDirty = true;
        }
        if renderDirty { RenderViewport(); }
        ApplyPendingWorkspaceScroll();
        // User input only arrives between frames, so any transform-spinner
        // change edges still set here came from this pump's programmatic
        // refreshes; drain them so the live-edit path never mistakes them
        // for user edits.
        DrainTransformSpinnerEdges();
        CaptureWorkspaceState();
        return changed;
    }

    /// @brief Load one document transactionally through the runtime VSCN loader.
    expose func Activate(doc: document.Document) {
        LoadDocumentModel(doc, false);
    }

    /// @brief Return whether a committed VSCN edit can be undone.
    expose func CanUndo() -> Boolean {
        return undoStack.count() > 0;
    }

    /// @brief Return whether an undone VSCN edit can be redone.
    expose func CanRedo() -> Boolean {
        return redoStack.count() > 0;
    }

    /// @brief Restore the preceding canonical VSCN snapshot.
    expose func Undo() -> Boolean {
        if currentDoc == null or undoStack.count() == 0 { return false; }
        var index = undoStack.count() - 1;
        var target = undoStack.get(index);
        undoStack.removeAt(index);
        PushHistory(redoStack, currentSerialized);
        if undoLabels.count() > 0 {
            redoLabels.add(undoLabels.get(undoLabels.count() - 1));
            undoLabels.removeAt(undoLabels.count() - 1);
        }
        currentDoc.content = target;
        currentDoc.isModified = target != cleanSerialized;
        revision = revision + 1;
        LoadDocumentModel(currentDoc, true);
        toolbarStatus.SetText("Undid 3D scene edit");
        return true;
    }

    /// @brief Reapply the next canonical VSCN snapshot.
    expose func Redo() -> Boolean {
        if currentDoc == null or redoStack.count() == 0 { return false; }
        var index = redoStack.count() - 1;
        var target = redoStack.get(index);
        redoStack.removeAt(index);
        PushHistory(undoStack, currentSerialized);
        if redoLabels.count() > 0 {
            undoLabels.add(redoLabels.get(redoLabels.count() - 1));
            redoLabels.removeAt(redoLabels.count() - 1);
        }
        currentDoc.content = target;
        currentDoc.isModified = target != cleanSerialized;
        revision = revision + 1;
        LoadDocumentModel(currentDoc, true);
        toolbarStatus.SetText("Redid 3D scene edit");
        return true;
    }

    /// @brief Load one document model with optional undo-history retention.
    hide func LoadDocumentModel(doc: document.Document,
                                preserveHistory: Boolean) {
        var switchingDocument = currentDoc != doc;
        lastViewportClickNode = -1;
        lastViewportClickMs = 0;
        hoveredViewportNode = -1;
        marqueeCandidate = false;
        marqueeActive = false;
        marqueeCancelled = false;
        if currentDoc != null { CaptureWorkspaceState(); }
        if preserveHistory == false {
            var savedState = doc.scene3DWorkspace;
            var canRestoreHistory = switchingDocument
                and savedState != null
                and savedState.historyContent == doc.content;
            if canRestoreHistory {
                undoStack = savedState.undoStack;
                redoStack = savedState.redoStack;
                cleanSerialized = savedState.cleanSerialized;
            } else {
                undoStack = [];
                redoStack = [];
                if doc.isModified == false { cleanSerialized = doc.content; }
                else { cleanSerialized = ""; }
            }
        }
        currentDoc = doc;
        currentSerialized = doc.content;
        EnsureComponentSchema(false);
        RestoreWorkspaceState(doc);
        // Restoring divider positions intentionally clears SplitPane collapse
        // state. Reconcile the current responsive presentation once here so
        // activation, Undo, and Redo cannot reopen hidden compact panes when
        // the host dimensions—and therefore the resize cache—did not change.
        ApplyInspectorLayout();
        gizmoHoverAxis = GIZMO_AXIS_NONE;
        ResetGizmoDrag(true);
        lookThroughNode = null;
        insetPixels = null;
        insetSourceRevision = -1;
        insetSourceNode = null;
        loadError = "";
        scene = LoadGraphFromContent(doc.content);
        if scene == null {
            SetEditorControlsEnabled(false);
            toolbarStatus.SetText("Scene needs repair");
            detailLabel.SetText("The VSCN asset could not be loaded. The original "
                                + "document is preserved.\n\n" + loadError);
        } else {
            SetEditorControlsEnabled(true);
            toolbarStatus.SetText("3D scene ready");
            detailLabel.SetText("");
        }
        RefreshHierarchy(null);
        renderDirty = true;
    }

    /// @brief Snapshot live hierarchy, camera, inspector, and undo state.
    hide func CaptureWorkspaceState() {
        if currentDoc == null or currentDoc.scene3DWorkspace == null { return; }
        var state = currentDoc.scene3DWorkspace;
        state.initialized = true;
        state.selectedIndex = selectedIndex;
        state.selectedIndices = selectedIndices;
        state.selectedNodeMetadata = selectedNodeMetadata;
        state.transformMode = gizmoMode;
        state.transformSpace = gizmoTransformSpace;
        state.transformSnapEnabled = gizmoSnapEnabled;
        state.cameraBookmarks = cameraBookmarks;
        state.viewYawDegrees = NormalizeYawDegrees(viewYawDegrees);
        state.viewPitchDegrees = ClampInt3D(viewPitchDegrees, -80, 80);
        state.viewScale = ClampInt3D(viewScale, 4, 120);
        state.viewportMode = ClampInt3D(
            viewportMode, VIEWPORT_MODE_SHADED, VIEWPORT_MODE_SHADED_WIRE);
        state.viewTargetX = ClampNumber3D(
            viewTargetX, -1000000.0, 1000000.0);
        state.viewTargetY = ClampNumber3D(
            viewTargetY, -1000000.0, 1000000.0);
        state.viewTargetZ = ClampNumber3D(
            viewTargetZ, -1000000.0, 1000000.0);
        state.gameplayViewAnchored = gameplayViewAnchored;
        state.gameplayEyeX = ClampNumber3D(
            gameplayEyeX, -1000000.0, 1000000.0);
        state.gameplayEyeY = ClampNumber3D(
            gameplayEyeY, -1000000.0, 1000000.0);
        state.gameplayEyeZ = ClampNumber3D(
            gameplayEyeZ, -1000000.0, 1000000.0);
        state.viewPerspective = viewPerspective;
        state.showGrid = showGrid;
        state.showMarkers = showMarkers;
        state.showLightOverlays = showLightOverlays;
        state.showCameraOverlays = showCameraOverlays;
        state.showColliderOverlays = showColliderOverlays;
        state.showRouteOverlays = showRouteOverlays;
        state.showStats = showStats;
        state.snapMoveIncrement = scene_transform_3d.BoundSnapIncrement(
            snapMoveIncrement,
            scene_transform_3d.MAX_MOVE_SNAP_INCREMENT);
        state.snapRotateIncrement = scene_transform_3d.BoundSnapIncrement(
            snapRotateIncrement,
            scene_transform_3d.MAX_ROTATE_SNAP_INCREMENT);
        state.snapScaleIncrement = scene_transform_3d.BoundSnapIncrement(
            snapScaleIncrement,
            scene_transform_3d.MAX_SCALE_SNAP_INCREMENT);
        if bodySplit != null {
            state.splitPosition = ClampNumber3D(
                bodySplit.GetPosition(), 0.20, 0.85);
        }
        if hierarchySplit != null {
            state.hierarchySplitPosition = ClampNumber3D(
                hierarchySplit.GetPosition(), 0.10, 0.45);
        }
        if inspectorScroll != null {
            state.inspectorScrollY = ClampNumber3D(
                LogicalScrollY(inspectorScroll), 0.0, 1000000.0);
        }
        state.inspectorRequestedVisible = inspectorRequestedVisible;
        state.compactInspectorShown = compactInspectorShown;
        state.pickLockedPaths = pickLockedPaths;
        state.undoStack = undoStack;
        state.redoStack = redoStack;
        state.cleanSerialized = cleanSerialized;
        state.historyContent = currentSerialized;
    }

    /// @brief Restore a document's validated hierarchy, camera, and inspector.
    hide func RestoreWorkspaceState(doc: document.Document) {
        var state = doc.scene3DWorkspace;
        if state == null or state.initialized == false {
            initialProjectPreviewPending = true;
            selectedIndex = -1;
            selectedIndices = [];
            selectedNodeMetadata = -1;
            metadataOwnerIndex = -1;
            gizmoMode = GIZMO_MODE_MOVE;
            gizmoTransformSpace =
                scene_transform_3d.TRANSFORM_SPACE_LOCAL;
            gizmoSnapEnabled = false;
            viewYawDegrees = 35;
            viewPitchDegrees = 25;
            viewScale = 28;
            viewportMode = VIEWPORT_MODE_SHADED;
            viewTargetX = 0.0;
            viewTargetY = 0.0;
            viewTargetZ = 0.0;
            gameplayViewAnchored = false;
            gameplayEyeX = 0.0;
            gameplayEyeY = 0.0;
            gameplayEyeZ = 0.0;
            viewPerspective = true;
            showGrid = true;
            showMarkers = true;
            showLightOverlays = true;
            showCameraOverlays = true;
            showColliderOverlays = true;
            showRouteOverlays = true;
            showStats = false;
            snapMoveIncrement =
                scene_transform_3d.DEFAULT_MOVE_SNAP_INCREMENT;
            snapRotateIncrement =
                scene_transform_3d.DEFAULT_ROTATE_SNAP_INCREMENT;
            snapScaleIncrement =
                scene_transform_3d.DEFAULT_SCALE_SNAP_INCREMENT;
            flyActive = false;
            flyLastMs = -1;
            if bodySplit != null { bodySplit.SetPosition(0.62); }
            if hierarchySplit != null { hierarchySplit.SetPosition(0.22); }
            pendingInspectorScrollY = 0.0;
            inspectorRequestedVisible = true;
            compactHierarchyShown = false;
            compactInspectorShown = false;
            pickLockedPaths = [];
            restoreInspectorScrollPending = true;
            SyncGizmoModeControls();
            UpdateViewportModeControls();
            SyncViewOptionControls();
            return;
        }

        initialProjectPreviewPending = false;
        selectedIndex = ClampInt3D(
            state.selectedIndex, -1, MAX_EDITOR_NODES - 1);
        selectedIndices = state.selectedIndices;
        selectedNodeMetadata = ClampInt3D(
            state.selectedNodeMetadata, -1, 255);
        metadataOwnerIndex = selectedIndex;
        gizmoMode = ClampInt3D(
            state.transformMode, GIZMO_MODE_MOVE, GIZMO_MODE_SCALE);
        gizmoTransformSpace = ClampInt3D(
            state.transformSpace,
            scene_transform_3d.TRANSFORM_SPACE_LOCAL,
            scene_transform_3d.TRANSFORM_SPACE_WORLD);
        gizmoSnapEnabled = state.transformSnapEnabled;
        viewYawDegrees = NormalizeYawDegrees(
            ClampInt3D(state.viewYawDegrees, -36000, 36000));
        viewPitchDegrees = ClampInt3D(state.viewPitchDegrees, -80, 80);
        viewScale = ClampInt3D(state.viewScale, 4, 120);
        viewportMode = ClampInt3D(
            state.viewportMode,
            VIEWPORT_MODE_SHADED, VIEWPORT_MODE_WIREFRAME);
        viewTargetX = ClampNumber3D(
            state.viewTargetX, -1000000.0, 1000000.0);
        viewTargetY = ClampNumber3D(
            state.viewTargetY, -1000000.0, 1000000.0);
        viewTargetZ = ClampNumber3D(
            state.viewTargetZ, -1000000.0, 1000000.0);
        gameplayViewAnchored = state.gameplayViewAnchored;
        gameplayEyeX = ClampNumber3D(
            state.gameplayEyeX, -1000000.0, 1000000.0);
        gameplayEyeY = ClampNumber3D(
            state.gameplayEyeY, -1000000.0, 1000000.0);
        gameplayEyeZ = ClampNumber3D(
            state.gameplayEyeZ, -1000000.0, 1000000.0);
        viewPerspective = state.viewPerspective;
        showGrid = state.showGrid;
        showMarkers = state.showMarkers;
        showLightOverlays = state.showLightOverlays;
        showCameraOverlays = state.showCameraOverlays;
        showColliderOverlays = state.showColliderOverlays;
        showRouteOverlays = state.showRouteOverlays;
        showStats = state.showStats;
        snapMoveIncrement = state.snapMoveIncrement;
        snapRotateIncrement = state.snapRotateIncrement;
        snapScaleIncrement = state.snapScaleIncrement;
        flyActive = false;
        flyLastMs = -1;
        if bodySplit != null {
            bodySplit.SetPosition(ClampNumber3D(
                state.splitPosition, 0.20, 0.85));
        }
        if hierarchySplit != null {
            hierarchySplit.SetPosition(ClampNumber3D(
                state.hierarchySplitPosition, 0.10, 0.45));
        }
        pendingInspectorScrollY = ClampNumber3D(
            state.inspectorScrollY, 0.0, 1000000.0);
        inspectorRequestedVisible = state.inspectorRequestedVisible;
        compactHierarchyShown = false;
        compactInspectorShown = state.compactInspectorShown;
        pickLockedPaths = state.pickLockedPaths;
        restoreInspectorScrollPending = true;
        SyncGizmoModeControls();
        UpdateViewportModeControls();
        SyncViewOptionControls();
    }

    /// @brief Apply project first-open camera and overlay defaults read-only.
    /// @details The caller invokes this only for a document without persisted
    ///          workspace state. Missing or wrong-typed start metadata retains
    ///          the ordinary editor view, while independent overlay defaults
    ///          remain useful.
    hide func ApplyInitialProjectPreview() {
        gameplayViewAnchored = false;
        if scene == null or componentSchema == null
           or componentSchema.valid == false {
            return;
        }
        var profile = componentSchema.scenePreview3D;
        if profile == null or profile.present == false { return; }
        var rootNode = scene.Root;
        if rootNode == null { return; }

        if profile.HasStart()
           and RootHasFloat(rootNode, profile.startXProperty)
           and RootHasFloat(rootNode, profile.startYProperty)
           and RootHasFloat(rootNode, profile.startZProperty) {
            var startX = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.startXProperty, viewTargetX),
                -1000000.0,
                1000000.0);
            var startY = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.startYProperty, viewTargetY),
                -1000000.0,
                1000000.0);
            var startZ = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.startZProperty, viewTargetZ),
                -1000000.0,
                1000000.0);
            var hasMappedYaw = profile.startYawProperty != ""
                and RootHasFloat(rootNode, profile.startYawProperty);
            if profile.hasStartEyeHeight and hasMappedYaw {
                var mappedYaw = ClampNumber3D(
                    rootNode.MetadataGetFloat(
                        profile.startYawProperty, viewYawDegrees),
                    -36000.0,
                    36000.0);
                viewYawDegrees =
                    NormalizeYawDegrees(
                        0 - Convert.NumToInt(mappedYaw));
                viewPitchDegrees = 0;
                gameplayEyeX = startX;
                gameplayEyeY = startY + profile.startEyeHeight;
                gameplayEyeZ = startZ;
                gameplayViewAnchored = true;
                ReanchorGameplayViewTarget();
            } else {
                viewTargetX = startX;
                viewTargetY = startY;
                viewTargetZ = startZ;
                if hasMappedYaw {
                    var targetYaw = ClampNumber3D(
                        rootNode.MetadataGetFloat(
                            profile.startYawProperty, viewYawDegrees),
                        -36000.0,
                        36000.0);
                    viewYawDegrees =
                        NormalizeYawDegrees(Convert.NumToInt(targetYaw));
                }
            }
        }
        if profile.hasShowGrid {
            showGrid = profile.showGrid;
        }
        if profile.hasShowMarkers {
            showMarkers = profile.showMarkers;
        }
        if profile.hasShowLights {
            showLightOverlays = profile.showLights;
        }
        if profile.hasShowCameras {
            showCameraOverlays = profile.showCameras;
        }
        if profile.hasShowColliders {
            showColliderOverlays = profile.showColliders;
        }
        if profile.hasShowRoutes {
            showRouteOverlays = profile.showRoutes;
        }
        SyncViewOptionControls();
        renderDirty = true;
    }

    /// @brief Recompute the orbit target without moving the gameplay eye.
    /// @details The editor stores orbit target + pixels-per-unit while game
    ///          profiles store an eye pose. Responsive layout can change the
    ///          derived orbit distance, so the target must follow that distance
    ///          to keep the actual retained camera at the runtime spawn.
    hide func ReanchorGameplayViewTarget() {
        if gameplayViewAnchored == false or viewPerspective == false {
            return;
        }
        var eyeUnit = ViewportEyeUnit();
        var eyeDistance = PerspectiveEyeDistance();
        viewTargetX = ClampNumber3D(
            gameplayEyeX - eyeUnit.X * eyeDistance,
            -1000000.0, 1000000.0);
        viewTargetY = ClampNumber3D(
            gameplayEyeY - eyeUnit.Y * eyeDistance,
            -1000000.0, 1000000.0);
        viewTargetZ = ClampNumber3D(
            gameplayEyeZ - eyeUnit.Z * eyeDistance,
            -1000000.0, 1000000.0);
    }

    /// @brief Leave exact runtime-eye mode once the user navigates manually.
    hide func ReleaseGameplayViewAnchor() {
        gameplayViewAnchored = false;
    }

    /// @brief Return whether this scene owns a valid project preview profile.
    expose func CanApplyProjectPreviewView() -> Boolean {
        return scene != null
            and scene.Root != null
            and componentSchema != null
            and componentSchema.valid
            and componentSchema.scenePreview3D != null
            and componentSchema.scenePreview3D.present;
    }

    /// @brief Reapply project gameplay camera and overlay defaults read-only.
    /// @details This explicit workspace action recovers from manual navigation
    ///          and older persisted view state. It exits camera look-through,
    ///          never serializes VSCN, and never creates an undo entry.
    expose func ApplyProjectPreviewView() -> Boolean {
        if CanApplyProjectPreviewView() == false { return false; }
        flyActive = false;
        flyLastMs = -1;
        if lookThroughNode != null {
            lookThroughNode = null;
            RefreshCameraFields(SelectedNode());
        }
        ApplyInitialProjectPreview();
        toolbarStatus.SetText("Gameplay view restored");
        return true;
    }

    /// @brief Keep the gameplay-view affordance truthful for the active root.
    hide func UpdateProjectViewButton() {
        if projectViewButton != null {
            projectViewButton.SetEnabled(
                CanApplyProjectPreviewView());
        }
    }

    /// @brief Resolve project atmosphere metadata for the shaded viewport.
    /// @details Complete groups with any wrong-typed member remain absent so
    ///          callers can use the ordinary Studio fallback deterministically.
    expose func ProjectPreviewRenderState()
        -> ScenePreview3DRenderState {
        var result = new ScenePreview3DRenderState();
        if scene == null or scene.Root == null
           or componentSchema == null
           or componentSchema.valid == false {
            return result;
        }
        var profile = componentSchema.scenePreview3D;
        if profile == null or profile.present == false { return result; }
        var rootNode = scene.Root;

        if profile.hasCameraFov {
            result.hasCameraFov = true;
            result.cameraFov = profile.cameraFov;
        }
        if profile.hasIblIntensity {
            result.hasIblIntensity = true;
            result.iblIntensity = profile.iblIntensity;
        }
        if profile.HasAmbient()
           and RootHasFloat(rootNode, profile.ambientRProperty)
           and RootHasFloat(rootNode, profile.ambientGProperty)
           and RootHasFloat(rootNode, profile.ambientBProperty) {
            result.hasAmbient = true;
            result.ambientR = RootColor(
                rootNode, profile.ambientRProperty);
            result.ambientG = RootColor(
                rootNode, profile.ambientGProperty);
            result.ambientB = RootColor(
                rootNode, profile.ambientBProperty);
        }
        if profile.HasClear()
           and RootHasFloat(rootNode, profile.clearRProperty)
           and RootHasFloat(rootNode, profile.clearGProperty)
           and RootHasFloat(rootNode, profile.clearBProperty) {
            result.hasClear = true;
            result.clearR = RootColor(
                rootNode, profile.clearRProperty);
            result.clearG = RootColor(
                rootNode, profile.clearGProperty);
            result.clearB = RootColor(
                rootNode, profile.clearBProperty);
        }
        if profile.HasFog()
           and RootHasFloat(rootNode, profile.fogRProperty)
           and RootHasFloat(rootNode, profile.fogGProperty)
           and RootHasFloat(rootNode, profile.fogBProperty)
           and RootHasFloat(rootNode, profile.fogNearProperty)
           and RootHasFloat(rootNode, profile.fogFarProperty) {
            result.hasFog = true;
            result.fogR = RootColor(rootNode, profile.fogRProperty);
            result.fogG = RootColor(rootNode, profile.fogGProperty);
            result.fogB = RootColor(rootNode, profile.fogBProperty);
            result.fogNear = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fogNearProperty, 0.0),
                0.0,
                999999999.0);
            result.fogFar = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fogFarProperty, result.fogNear + 1.0),
                0.0,
                1000000000.0);
            if result.fogFar <= result.fogNear {
                result.fogFar = result.fogNear + 1.0;
            }
        }
        if profile.HasSkyPalette()
           and RootHasFloat(rootNode, profile.zenithRProperty)
           and RootHasFloat(rootNode, profile.zenithGProperty)
           and RootHasFloat(rootNode, profile.zenithBProperty)
           and RootHasFloat(rootNode, profile.groundRProperty)
           and RootHasFloat(rootNode, profile.groundGProperty)
           and RootHasFloat(rootNode, profile.groundBProperty)
           and result.hasClear {
            result.hasSky = true;
            result.zenithR =
                RootColor(rootNode, profile.zenithRProperty);
            result.zenithG =
                RootColor(rootNode, profile.zenithGProperty);
            result.zenithB =
                RootColor(rootNode, profile.zenithBProperty);
            result.groundR =
                RootColor(rootNode, profile.groundRProperty);
            result.groundG =
                RootColor(rootNode, profile.groundGProperty);
            result.groundB =
                RootColor(rootNode, profile.groundBProperty);
            if profile.cloudProperty != ""
               and RootHasFloat(rootNode, profile.cloudProperty) {
                result.cloudDensity = ClampNumber3D(
                    rootNode.MetadataGetFloat(
                        profile.cloudProperty, 0.0),
                    0.0,
                    1.0);
            }
            if profile.starsProperty != ""
               and RootHasBool(rootNode, profile.starsProperty) {
                result.stars = rootNode.MetadataGetBool(
                    profile.starsProperty, false);
            }
        }
        if profile.HasSun()
           and RootHasFloat(rootNode, profile.sunXProperty)
           and RootHasFloat(rootNode, profile.sunYProperty)
           and RootHasFloat(rootNode, profile.sunZProperty)
           and RootHasFloat(rootNode, profile.sunRProperty)
           and RootHasFloat(rootNode, profile.sunGProperty)
           and RootHasFloat(rootNode, profile.sunBProperty)
           and RootHasFloat(rootNode, profile.sunIntensityProperty) {
            result.hasSun = true;
            result.sunX = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.sunXProperty, 0.0),
                -1000.0,
                1000.0);
            result.sunY = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.sunYProperty, -1.0),
                -1000.0,
                1000.0);
            result.sunZ = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.sunZProperty, 0.0),
                -1000.0,
                1000.0);
            result.sunR = RootColor(rootNode, profile.sunRProperty);
            result.sunG = RootColor(rootNode, profile.sunGProperty);
            result.sunB = RootColor(rootNode, profile.sunBProperty);
            result.sunIntensity = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.sunIntensityProperty, 0.0),
                0.0,
                100.0);
        }
        if profile.HasFill()
           and RootHasFloat(rootNode, profile.fillXProperty)
           and RootHasFloat(rootNode, profile.fillYProperty)
           and RootHasFloat(rootNode, profile.fillZProperty)
           and RootHasFloat(rootNode, profile.fillRProperty)
           and RootHasFloat(rootNode, profile.fillGProperty)
           and RootHasFloat(rootNode, profile.fillBProperty)
           and RootHasFloat(rootNode, profile.fillIntensityProperty) {
            result.hasFill = true;
            result.fillX = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fillXProperty, 0.0),
                -1000.0,
                1000.0);
            result.fillY = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fillYProperty, -1.0),
                -1000.0,
                1000.0);
            result.fillZ = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fillZProperty, 0.0),
                -1000.0,
                1000.0);
            result.fillR = RootColor(rootNode, profile.fillRProperty);
            result.fillG = RootColor(rootNode, profile.fillGProperty);
            result.fillB = RootColor(rootNode, profile.fillBProperty);
            result.fillIntensity = ClampNumber3D(
                rootNode.MetadataGetFloat(
                    profile.fillIntensityProperty, 0.0),
                0.0,
                100.0);
        }
        if profile.HasHeightFog()
           and RootHasBool(rootNode, profile.heightFogProperty) {
            result.hasHeightFog = true;
            result.heightFogEnabled = rootNode.MetadataGetBool(
                profile.heightFogProperty, false);
            result.heightFogBase = profile.heightFogBase;
            result.heightFogFalloff = profile.heightFogFalloff;
            result.heightFogDensity = profile.heightFogDensity;
            result.heightFogOpacity = profile.heightFogOpacity;
        }
        return result;
    }

    /// @brief Return whether one root key is exact typed float metadata.
    hide func RootHasFloat(rootNode: SceneNode,
                           key: String) -> Boolean {
        return rootNode != null and key != ""
            and rootNode.MetadataHas(key)
            and rootNode.MetadataKind(key) == "float";
    }

    /// @brief Return whether one root key is exact typed boolean metadata.
    hide func RootHasBool(rootNode: SceneNode,
                          key: String) -> Boolean {
        return rootNode != null and key != ""
            and rootNode.MetadataHas(key)
            and rootNode.MetadataKind(key) == "bool";
    }

    /// @brief Read one normalized project color channel from root metadata.
    hide func RootColor(rootNode: SceneNode,
                        key: String) -> Number {
        return ClampNumber3D(
            rootNode.MetadataGetFloat(key, 0.0), 0.0, 1.0);
    }

    /// @brief Toggle the inspector without making either compact pane unusable.
    expose func ToggleInspectorPane() {
        if focusModeActive and inspectorDock.floating == false { return; }
        if compactHierarchyShown {
            compactHierarchyShown = false;
            if compactLayout {
                compactInspectorShown = true;
            } else {
                inspectorRequestedVisible = true;
            }
            ApplyInspectorLayout();
            CaptureWorkspaceState();
            return;
        }
        if compactLayout {
            compactInspectorShown = !compactInspectorShown;
        } else {
            inspectorRequestedVisible = !inspectorRequestedVisible;
        }
        ApplyInspectorLayout();
        CaptureWorkspaceState();
    }

    /// @brief Toggle a full-width hierarchy in viewport-priority layouts.
    /// @details Wide hosts keep the ordinary three-pane split. Narrow hosts
    ///          collapse the hierarchy by default but never make it
    ///          unreachable; this action swaps it with the viewport/inspector.
    expose func ToggleHierarchyPane() {
        if focusModeActive or hierarchyDock.floating
           or UsesDockedHierarchy(lastHostWidth) {
            return;
        }
        compactHierarchyShown = compactHierarchyShown == false;
        if compactHierarchyShown { compactInspectorShown = false; }
        ApplyInspectorLayout();
        CaptureWorkspaceState();
    }

    /// @brief Reconcile wrapping chrome and master/detail layout after resize.
    expose func RefreshResponsiveLayout() {
        if root == null or bodySplit == null { return; }
        var width = root.GetLogicalWidth();
        if guiApp != null {
            var scale = guiApp.GetEffectiveScale();
            if scale <= 0.0 { scale = 1.0; }
            var viewportWidth = guiApp.GetWidth() / scale;
            if viewportWidth > 0.0
               and (width <= 0.0 or viewportWidth < width) {
                width = viewportWidth;
            }
        }
        if width <= 0.0 { return; }
        var widthDelta = width - lastHostWidth;
        if widthDelta < 0.0 { widthDelta = 0.0 - widthDelta; }
        var widthChanged = widthDelta > RESPONSIVE_WIDTH_EPSILON;
        lastHostWidth = width;
        var nextCompact = UsesCompactLayout(width);
        var nextCompactChrome = UsesCompactChrome(width);
        var layoutChanged = nextCompact != compactLayout;
        var chromeChanged = nextCompactChrome != compactChrome;
        if layoutChanged {
            compactLayout = nextCompact;
            renderDirty = true;
        }
        compactChrome = nextCompactChrome;
        if layoutChanged or chromeChanged or widthChanged {
            // Wide-mode toolbar height reservations depend on the lane
            // width bracket, so re-apply chrome on width changes too.
            ApplyResponsiveChrome();
        }
        if layoutChanged or widthChanged {
            ApplyInspectorLayout();
        }
    }

    /// @brief Publish a one-shot request for outer-only scene layout.
    expose func RequestWorkspaceModeToggle() {
        workspaceModeToggleRequested = true;
    }

    /// @brief Consume one outer-only scene-layout toggle request.
    expose func TakeWorkspaceModeToggleRequested() -> Boolean {
        var requested = workspaceModeToggleRequested;
        workspaceModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the shell's outer-only scene layout state.
    expose func SetWorkspaceModeActive(active: Boolean) {
        if workspaceModeActive == active { return; }
        workspaceModeActive = active;
        UpdateWorkspaceButton();
    }

    /// @brief Return whether outer-only Scene Layout is active.
    expose func IsWorkspaceModeActive() -> Boolean {
        return workspaceModeActive;
    }

    /// @brief Publish a one-shot request for the outer shell focus presentation.
    expose func RequestFocusModeToggle() {
        focusModeToggleRequested = true;
    }

    /// @brief Consume one focus-mode toggle request.
    expose func TakeFocusModeToggleRequested() -> Boolean {
        var requested = focusModeToggleRequested;
        focusModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the outer shell's focus-presentation state.
    expose func SetFocusModeActive(active: Boolean) {
        if focusModeActive == active { return; }
        focusModeActive = active;
        ApplyInspectorLayout();
        UpdateFocusButton();
    }

    /// @brief Return whether the outer shell is presenting this scene in focus.
    expose func IsFocusModeActive() -> Boolean {
        return focusModeActive;
    }

    /// @brief Keep all scene creation and navigation actions reachable.
    hide func ApplyResponsiveChrome() {
        if compactChrome {
            // Keep a defensive row floor while allowing Flex's measured wrap
            // height to grow beyond it. An exact preferred height clipped the
            // trailing workspace action at widths between responsive tiers.
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 128.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 198.0);
            viewSectionLabel.SetVisible(false);
            transformSectionLabel.SetVisible(false);
            zoomSectionLabel.SetVisible(false);
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import...");
            importInstanceButton.SetText("Instance...");
            addEmptyButton.SetText("+ Node");
            moveToolButton.SetText("M");
            rotateToolButton.SetText("R");
            scaleToolButton.SetText("S");
            orbitLeftButton.SetText("←");
            orbitRightButton.SetText("→");
            orbitUpButton.SetText("↑");
            orbitDownButton.SetText("↓");
            frameButton.SetText("All");
            frameSelectedButton.SetText("Selected");
            projectViewButton.SetText("Game");
            viewOptionsButton.SetText("View");
            runSceneButton.SetText("Run");
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else if UsesDockedHierarchy(lastHostWidth) == false {
            // Concise labels keep the production dock-heavy lane reachable.
            // Narrow lanes retain a defensive two-row floor; laptop-width
            // lanes use Flex's measured height so a one-row creation strip
            // does not consume a second empty row.
            toolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            if lastHostWidth < WRAPPED_SCENE_3D_CREATION_WIDTH {
                toolbar.SetMinSize(0.0, 76.0);
            } else {
                toolbar.SetMinSize(0.0, 0.0);
            }
            if lastHostWidth < WRAPPED_SCENE_3D_VIEW_WIDTH {
                viewToolbar.SetMinSize(0.0, 76.0);
            } else {
                viewToolbar.SetMinSize(0.0, 0.0);
            }
            viewSectionLabel.SetVisible(false);
            transformSectionLabel.SetVisible(false);
            zoomSectionLabel.SetVisible(false);
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import");
            importInstanceButton.SetText("Instance");
            addEmptyButton.SetText("+ Node");
            moveToolButton.SetText("M");
            rotateToolButton.SetText("R");
            scaleToolButton.SetText("S");
            orbitLeftButton.SetText("←");
            orbitRightButton.SetText("→");
            orbitUpButton.SetText("↑");
            orbitDownButton.SetText("↓");
            frameButton.SetText("All");
            frameSelectedButton.SetText("Selected");
            projectViewButton.SetText("Game");
            viewOptionsButton.SetText("View");
            runSceneButton.SetText("Run");
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else {
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 0.0);
            viewSectionLabel.SetVisible(true);
            transformSectionLabel.SetVisible(true);
            zoomSectionLabel.SetVisible(true);
            newSceneButton.SetText("New");
            importAssetButton.SetText("Import Asset...");
            importInstanceButton.SetText("Import Instance...");
            addEmptyButton.SetText("+ Empty");
            moveToolButton.SetText("Move");
            rotateToolButton.SetText("Rotate");
            scaleToolButton.SetText("Scale");
            orbitLeftButton.SetText("Yaw -");
            orbitRightButton.SetText("Yaw +");
            orbitUpButton.SetText("Pitch +");
            orbitDownButton.SetText("Pitch -");
            frameButton.SetText("Frame all");
            frameSelectedButton.SetText("Frame selected");
            projectViewButton.SetText("Gameplay");
            viewOptionsButton.SetText("View...");
            runSceneButton.SetText("Run Scene");
            toolbarStatus.SetVisible(true);
            viewStatusLabel.SetVisible(true);
        }
        UpdateProjectionControls();
        UpdateViewOptionsChrome();
        UpdateGizmoModeControls();
        UpdateProjectViewButton();
        UpdateHierarchyButton();
        UpdateInspectorButton();
        UpdateWorkspaceButton();
    }

    /// @brief Apply wide three-pane or compact one-pane-at-a-time layout.
    /// @details The hierarchy pane needs real width to be useful, so narrow
    ///          hosts present it as an explicit full-width master alongside
    ///          the viewport/inspector detail cycle.
    hide func ApplyInspectorLayout() {
        if bodySplit == null { return; }
        var wantHierarchyPane = false;
        var showHierarchyMaster = false;
        if hierarchySplit != null {
            wantHierarchyPane =
                compactLayout == false
                and focusModeActive == false
                and hierarchyDock.floating == false
                and UsesDockedHierarchy(lastHostWidth);
            showHierarchyMaster =
                compactHierarchyShown
                and focusModeActive == false
                and hierarchyDock.floating == false
                and UsesDockedHierarchy(lastHostWidth) == false;
            var desiredHierarchySide = 1;
            if wantHierarchyPane { desiredHierarchySide = 0; }
            else if showHierarchyMaster { desiredHierarchySide = 2; }
            var currentHierarchySide =
                hierarchySplit.GetCollapsedSide();
            if desiredHierarchySide == 0 {
                hierarchySplit.Restore();
            } else if desiredHierarchySide == 2 {
                hierarchySplit.CollapseSecond();
            } else {
                hierarchySplit.CollapseFirst();
            }
            if currentHierarchySide != desiredHierarchySide {
                renderDirty = true;
            }
        }
        if hierarchyPaneBox != null {
            hierarchyPaneBox.SetVisible(
                wantHierarchyPane or showHierarchyMaster
                    or hierarchyDock.floating);
        }
        var desiredSide = 0;
        if focusModeActive and inspectorDock.floating == false {
            desiredSide = 2;
        } else if compactLayout {
            desiredSide = 2;
            if compactInspectorShown { desiredSide = 1; }
        } else if !inspectorRequestedVisible or inspectorDock.floating {
            desiredSide = 2;
        }

        var currentSide = bodySplit.GetCollapsedSide();
        if desiredSide == 1 {
            bodySplit.CollapseFirst();
        } else if desiredSide == 2 {
            bodySplit.CollapseSecond();
        } else {
            bodySplit.Restore();
        }
        if currentSide != desiredSide {
            renderDirty = true;
        }
        if viewportScroll != null {
            viewportScroll.SetVisible(desiredSide != 1);
        }
        if inspectorScroll != null {
            inspectorScroll.SetVisible(
                desiredSide != 2 or inspectorDock.floating);
        }
        UpdateHierarchyButton();
        UpdateInspectorButton();
        UpdateWorkspaceButton();
        UpdateFocusButton();
    }

    /// @brief Keep the narrow hierarchy master action truthful.
    hide func UpdateHierarchyButton() {
        if hierarchyButton == null { return; }
        var needsMaster =
            lastHostWidth > 0.0
            and UsesDockedHierarchy(lastHostWidth) == false;
        hierarchyButton.SetVisible(needsMaster);
        if needsMaster == false { return; }
        if focusModeActive {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Hierarchy hidden");
            hierarchyButton.SetTooltip(
                "Exit Focus to open the scene hierarchy");
            hierarchyButton.SetStyle(0);
        } else if hierarchyDock.floating {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Hierarchy floating");
            hierarchyButton.SetTooltip(
                "The scene hierarchy is already available in its floating pane");
            hierarchyButton.SetStyle(2);
        } else if compactHierarchyShown {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Viewport");
            hierarchyButton.SetTooltip(
                "Return to the 3D viewport and inspector");
            hierarchyButton.SetStyle(1);
        } else {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Hierarchy");
            hierarchyButton.SetTooltip(
                "Open the scene hierarchy at the full editor width");
            hierarchyButton.SetStyle(2);
        }
    }

    /// @brief Describe the destination of the inspector toggle.
    hide func UpdateInspectorButton() {
        if inspectorButton == null { return; }
        if focusModeActive and inspectorDock.floating == false {
            inspectorButton.SetEnabled(false);
            inspectorButton.SetText("Inspector hidden");
            inspectorButton.SetTooltip(
                "Exit Focus to restore the node inspector");
            inspectorButton.SetStyle(0);
            return;
        }
        inspectorButton.SetEnabled(true);
        if compactHierarchyShown {
            inspectorButton.SetText("Inspector");
            inspectorButton.SetTooltip(
                "Switch from the hierarchy to the node inspector");
            inspectorButton.SetStyle(2);
            return;
        }
        if compactLayout {
            if compactInspectorShown {
                inspectorButton.SetText("Viewport");
                inspectorButton.SetTooltip("Return to the full-width 3D viewport");
                inspectorButton.SetStyle(1);
            } else {
                inspectorButton.SetText("Inspector");
                inspectorButton.SetTooltip("Show the node inspector at full width");
                inspectorButton.SetStyle(2);
            }
        } else if inspectorRequestedVisible {
            inspectorButton.SetText("Hide Inspector");
            inspectorButton.SetTooltip(
                "Hide the node inspector and give the viewport the full width");
            inspectorButton.SetStyle(2);
        } else {
            inspectorButton.SetText("Show Inspector");
            inspectorButton.SetTooltip("Restore the node inspector");
            inspectorButton.SetStyle(1);
        }
    }

    /// @brief Keep the reversible outer-only scene-layout action truthful.
    hide func UpdateWorkspaceButton() {
        if workspaceButton == null { return; }
        if workspaceModeActive {
            workspaceButton.SetText("Exit Layout");
            workspaceButton.SetTooltip(
                "Restore the Studio sidebar and tool docks while keeping "
                    + "this scene's internal pane layout");
            workspaceButton.SetStyle(1);
        } else {
            if compactChrome
               or UsesDockedHierarchy(lastHostWidth) == false {
                workspaceButton.SetText("Layout");
            } else {
                workspaceButton.SetText("Scene Layout");
            }
            workspaceButton.SetTooltip(
                "Hide outer Studio docks but keep the scene hierarchy, "
                    + "viewport, and inspector available");
            workspaceButton.SetStyle(2);
        }
    }

    /// @brief Keep the reversible outer-workbench action truthful.
    hide func UpdateFocusButton() {
        if focusButton == null { return; }
        if focusModeActive {
            focusButton.SetText("Exit Focus");
            focusButton.SetTooltip(
                "Restore scene panes, sidebar, and tool panels (Shift+Space)");
            focusButton.SetStyle(1);
        } else {
            focusButton.SetText("Focus");
            focusButton.SetTooltip(
                "Hide scene panes and outer Studio docks to maximize the viewport "
                + "(Shift+Space)");
            focusButton.SetStyle(2);
        }
    }

    /// @brief Apply deferred inspector scroll after hierarchy layout is known.
    hide func ApplyPendingWorkspaceScroll() {
        if restoreInspectorScrollPending == false { return; }
        if inspectorScroll != null {
            SetLogicalScroll(
                inspectorScroll, 0.0, pendingInspectorScrollY);
        }
        restoreInspectorScrollPending = false;
    }

    /// @brief Select truthful shaded meshes or authored mesh wireframes.
    /// @details This is per-document presentation state. It never mutates the
    ///          live SceneGraph, canonical VSCN bytes, or edit history.
    expose func SetViewportMode(nextMode: Integer) {
        if (nextMode != VIEWPORT_MODE_SHADED
            and nextMode != VIEWPORT_MODE_WIREFRAME
            and nextMode != VIEWPORT_MODE_SHADED_WIRE)
           or nextMode == viewportMode {
            return;
        }
        viewportMode = nextMode;
        UpdateViewportModeControls();
        toolbarStatus.SetText(
            ViewportModeLabel(viewportMode) + " viewport selected");
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Return the concise user-facing viewport mode label.
    /// @brief One render pass's CPU milliseconds at tenth precision.
    hide func PassMsTenths(pass: Integer) -> String {
        var tenths = Convert.NumToInt(
            viewportRenderCanvas.PassCpuMs(pass) * 10.0);
        if tenths < 0 { tenths = 0; }
        return (tenths / 10) + "." + (tenths % 10);
    }

    hide func ViewportModeLabel(mode: Integer) -> String {
        if mode == VIEWPORT_MODE_WIREFRAME { return "Wireframe"; }
        if mode == VIEWPORT_MODE_SHADED_WIRE { return "Shaded+Wire"; }
        return "Shaded";
    }

    /// @brief Keep the mode button, tooltip, and accessibility state truthful.
    expose func UpdateViewportModeControls() {
        if viewportModeButton == null { return; }
        var label = ViewportModeLabel(viewportMode);
        viewportModeButton.SetText(label);
        viewportModeButton.SetStyle(
            viewportMode == VIEWPORT_MODE_SHADED ? 1 : 0);
        viewportModeButton.SetAccessibleName(
            "3D viewport mode: " + label);
        if viewportMode == VIEWPORT_MODE_WIREFRAME {
            viewportModeButton.SetTooltip(
                "Show authored triangle edges; click for shaded PBR materials");
            viewportModeButton.SetAccessibleDescription(
                "Authored meshes render as triangle wireframes. "
                + "Activate for shaded PBR materials.");
        } else {
            viewportModeButton.SetTooltip(
                "Show authored PBR materials; click for triangle wireframes");
            viewportModeButton.SetAccessibleDescription(
                "Authored meshes render with their PBR materials. "
                + "Activate for triangle wireframes.");
        }
    }

    /// @brief Select one viewport transform tool without mutating scene data.
    expose func SetGizmoMode(nextMode: Integer) {
        if scene_transform_3d.IsValidMode(nextMode) == false
           or nextMode == gizmoMode {
            return;
        }
        if gizmoDragAxis != GIZMO_AXIS_NONE { CancelGizmoDrag(); }
        gizmoMode = nextMode;
        gizmoHoverAxis = GIZMO_AXIS_NONE;
        UpdateGizmoModeControls();
        toolbarStatus.SetText(
            scene_transform_3d.ModeLabel(gizmoMode) + " tool selected");
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Select parent-relative local axes or absolute world axes.
    expose func SetGizmoTransformSpace(nextSpace: Integer) {
        if scene_transform_3d.IsValidSpace(nextSpace) == false
           or nextSpace == gizmoTransformSpace {
            return;
        }
        if gizmoDragAxis != GIZMO_AXIS_NONE { CancelGizmoDrag(); }
        gizmoTransformSpace = nextSpace;
        gizmoHoverAxis = GIZMO_AXIS_NONE;
        UpdateGizmoModeControls();
        toolbarStatus.SetText(
            scene_transform_3d.SpaceLabel(gizmoTransformSpace)
            + " transform axes selected");
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Toggle mode-aware snapping and keep the native checkbox in sync.
    expose func SetGizmoSnapEnabled(enabled: Boolean) {
        if enabled == gizmoSnapEnabled
           and snapTransformCheck != null
           and snapTransformCheck.IsChecked() == enabled {
            return;
        }
        gizmoSnapEnabled = enabled;
        SyncGizmoModeControls();
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Reconcile persisted gizmo fields with their native widgets.
    hide func SyncGizmoModeControls() {
        if snapTransformCheck == null { return; }
        snapTransformCheck.SetChecked(gizmoSnapEnabled);
        snapTransformRevision = snapTransformCheck.GetRevision();
        UpdateGizmoModeControls();
    }

    /// @brief Present an unambiguous active transform mode and snap precision.
    expose func UpdateGizmoModeControls() {
        if moveToolButton == null { return; }
        moveToolButton.SetStyle(0);
        rotateToolButton.SetStyle(0);
        scaleToolButton.SetStyle(0);
        if gizmoMode == GIZMO_MODE_ROTATE {
            rotateToolButton.SetStyle(1);
        } else if gizmoMode == GIZMO_MODE_SCALE {
            scaleToolButton.SetStyle(1);
        } else {
            moveToolButton.SetStyle(1);
        }
        if transformSpaceButton != null {
            var spaceLabel =
                scene_transform_3d.SpaceLabel(gizmoTransformSpace);
            transformSpaceButton.SetText(spaceLabel);
            transformSpaceButton.SetStyle(
                gizmoTransformSpace
                    == scene_transform_3d.TRANSFORM_SPACE_WORLD
                ? 1 : 0);
            transformSpaceButton.SetTooltip(
                spaceLabel
                + " axes. Click to switch coordinate space. "
                + "Impossible parent-relative TRS conversions are rejected.");
        }
        var snapState = "off";
        if gizmoSnapEnabled {
            snapState = scene_transform_3d.SnapDescription(gizmoMode);
        }
        snapTransformCheck.SetTooltip(
            scene_transform_3d.ModeLabel(gizmoMode)
            + " snap: " + snapState);
        if viewportImage != null {
            var handleHint = "colored axes";
            if gizmoMode == GIZMO_MODE_MOVE {
                handleHint = "colored axes or XY/XZ/YZ plane squares";
            } else if gizmoMode == GIZMO_MODE_ROTATE {
                handleHint = "X/Y/Z rotation rings";
            } else if gizmoMode == GIZMO_MODE_SCALE {
                handleHint = "boxed axes or XY/XZ/YZ crossed scale squares";
            }
            viewportImage.SetTooltip(
                "Drag " + handleHint + " to "
                + Str.ToLower(scene_transform_3d.ModeLabel(gizmoMode))
                + " in "
                + Str.ToLower(
                    scene_transform_3d.SpaceLabel(gizmoTransformSpace))
                + " space. Click meshes to select; Shift adds and Ctrl/Cmd "
                + "toggles. Middle/right-drag to orbit, or add Shift to pan. "
                + "Use the wheel to zoom. The top-right View navigator snaps "
                + "six directions and toggles perspective/orthographic.");
        }
    }

    /// @brief Return the monotonic accepted-edit revision.
    expose func GetRevision() -> Integer {
        return revision;
    }

    /// @brief Add a named empty node through the normal committed edit path.
    /// @return New flattened node index, or -1 on failure.
    expose func AddEmptyNode(name: String,
                             parentIndex: Integer) -> Integer {
        if scene == null { return -1; }
        if parentIndex >= 0 and parentIndex < flatNodes.count()
           and ParentAcceptsAuthoredChildren(
                   flatNodes.get(parentIndex)) == false {
            return -1;
        }
        var parent: SceneNode = null;
        if parentIndex >= 0 and parentIndex < flatNodes.count() {
            parent = flatNodes.get(parentIndex);
        }
        var node = SceneNode.New();
        var nodeName = Str.Trim(name);
        if nodeName == "" { nodeName = "Node " + scene.NodeCount; }
        node.Name = nodeName;
        if parent != null {
            parent.AddChild(node);
        } else {
            scene.Add(node);
        }
        if CommitScene("Added " + nodeName) == false { return -1; }
        RefreshHierarchy(node);
        return selectedIndex;
    }

    /// @brief Create one named point-light node through canonical VSCN history.
    /// @details The light is staged before hierarchy mutation. A valid parent
    ///          index creates a light child; -1 creates a top-level node.
    expose func AddLightNode(name: String,
                             parentIndex: Integer) -> Integer {
        if scene == null { return -1; }
        if parentIndex >= 0 and parentIndex < flatNodes.count()
           and ParentAcceptsAuthoredChildren(
                   flatNodes.get(parentIndex)) == false {
            return -1;
        }
        var state = new scene_light_3d.LightState3D();
        var light = scene_light_3d.BuildLight(state);
        if light == null {
            toolbarStatus.SetText("Light creation failed");
            detailLabel.SetText(
                "Studio could not allocate the Point light component.");
            GUI.Toast.Error("3D light creation failed");
            return -1;
        }
        var parent: SceneNode = null;
        if parentIndex >= 0 and parentIndex < flatNodes.count() {
            parent = flatNodes.get(parentIndex);
        }
        var node = SceneNode.New();
        if node == null {
            toolbarStatus.SetText("Light creation failed");
            detailLabel.SetText("Studio could not allocate a scene node.");
            GUI.Toast.Error("3D light creation failed");
            return -1;
        }
        var nodeName = Str.Trim(name);
        if nodeName == "" { nodeName = "Point Light " + scene.NodeCount; }
        node.Name = nodeName;
        node.Light = light;
        if parent != null {
            parent.AddChild(node);
        } else {
            scene.Add(node);
        }
        if CommitScene("Added " + nodeName) == false { return -1; }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Created a Point light. Use the Light component inspector "
            + "to change its type and local emission fields.");
        return selectedIndex;
    }

    /// @brief Create, rename, or update one typed node metadata value.
    expose func SetNodeMetadata(nodeIndex: Integer,
                                previousKey: String,
                                key: String,
                                kind: String,
                                value: String) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var nextKey = Str.Trim(key);
        if nextKey == "" {
            detailLabel.SetText("Node metadata key cannot be empty.");
            return false;
        }
        if previousKey != "" and node.MetadataHas(previousKey) == false {
            detailLabel.SetText(
                "The selected node metadata value no longer exists.");
            return false;
        }
        if previousKey != nextKey and node.MetadataHas(nextKey) {
            detailLabel.SetText(
                "Node metadata \"" + nextKey + "\" already exists.");
            return false;
        }

        var intValue = 0;
        var floatValue = 0.0;
        var boolValue = false;
        if kind == "int" {
            var parsedInt = Parse.TryInt(Str.Trim(value));
            if parsedInt.IsNone {
                detailLabel.SetText("Enter a valid whole number.");
                return false;
            }
            intValue = parsedInt.UnwrapI64();
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(Str.Trim(value));
            if parsedFloat.IsNone {
                detailLabel.SetText("Enter a valid finite number.");
                return false;
            }
            floatValue = parsedFloat.UnwrapF64();
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(Str.Trim(value));
            if parsedBool.IsNone {
                detailLabel.SetText(
                    "Enter true/false, yes/no, on/off, or 1/0.");
                return false;
            }
            boolValue = parsedBool.UnwrapI1();
        } else if kind != "string" and kind != "null" {
            detailLabel.SetText("Choose a supported node metadata type.");
            return false;
        }

        if previousKey == nextKey
           and NodeMetadataMatches(
               node, nextKey, kind, value,
               intValue, floatValue, boolValue) {
            detailLabel.SetText("Node metadata is already up to date.");
            return false;
        }

        var applied = false;
        if kind == "string" {
            applied = node.MetadataSetString(nextKey, value);
        } else if kind == "int" {
            applied = node.MetadataSetInt(nextKey, intValue);
        } else if kind == "float" {
            applied = node.MetadataSetFloat(nextKey, floatValue);
        } else if kind == "bool" {
            applied = node.MetadataSetBool(nextKey, boolValue);
        } else {
            applied = node.MetadataSetNull(nextKey);
        }
        if applied == false
           or NodeMetadataMatches(
               node, nextKey, kind, value,
               intValue, floatValue, boolValue) == false {
            RestoreNodeMetadataEdit(
                nodeIndex,
                "The metadata value was rejected. Keys are limited to "
                + "128 bytes, nodes to 256 values, and strings to 64 KiB.");
            return false;
        }
        if previousKey != "" and previousKey != nextKey
           and node.MetadataRemove(previousKey) == false {
            RestoreNodeMetadataEdit(
                nodeIndex,
                "Studio could not complete the metadata rename.");
            return false;
        }
        if CommitScene("Updated node metadata " + nextKey) == false {
            RestoreNodeMetadataEdit(
                nodeIndex,
                "The node metadata update could not be committed.");
            return false;
        }

        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        metadataOwnerIndex = nodeIndex;
        detailLabel.SetText("");
        // Metadata keys feed component badges; rebuild rows in place.
        RefreshHierarchy(node);
        RefreshMetadataFields(node);
        metadataInspector.SelectByKey(nextKey);
        selectedNodeMetadata = metadataInspector.selectedProperty;
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Remove one typed node metadata value through canonical history.
    expose func RemoveNodeMetadata(nodeIndex: Integer,
                                   key: String) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var nextKey = Str.Trim(key);
        if nextKey == "" or node.MetadataHas(nextKey) == false {
            return false;
        }
        if node.MetadataRemove(nextKey) == false {
            detailLabel.SetText("The node rejected the metadata removal.");
            return false;
        }
        if CommitScene("Removed node metadata " + nextKey) == false {
            RestoreNodeMetadataEdit(
                nodeIndex,
                "The node metadata removal could not be committed.");
            return false;
        }
        selectedNodeMetadata = -1;
        metadataOwnerIndex = nodeIndex;
        detailLabel.SetText("");
        RefreshHierarchy(node);
        RefreshMetadataFields(node);
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Add every missing field from one project component transactionally.
    /// @details Existing same-kind values are preserved. Any type conflict,
    ///          rejected runtime write, or failed VSCN commit restores the
    ///          complete canonical document.
    expose func ApplySelectedComponent(
        component: scene_component_schema.SceneComponentDefinition)
        -> Boolean {
        if scene == null or component == null
           or component.SupportsTarget(
               scene_component_schema.TARGET_3D_NODE) == false {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 {
            detailLabel.SetText(
                "Select one or more nodes before adding a component.");
            return false;
        }

        var missing = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node = flatNodes.get(selectedIndices.get(selectionIndex));
            var fieldIndex = 0;
            while fieldIndex < component.fields.count() {
                var field = component.fields.get(fieldIndex);
                if node.MetadataHas(field.key) {
                    if node.MetadataKind(field.key)
                       != scene_component_schema.ValueKind(field.kind) {
                        detailLabel.SetText(
                            "Component \"" + component.label
                            + "\" conflicts with metadata \"" + field.key
                            + "\". No nodes were changed.");
                        RefreshComponentPalette();
                        return false;
                    }
                } else {
                    missing = missing + 1;
                }
                fieldIndex = fieldIndex + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if missing == 0 {
            detailLabel.SetText(
                "Component \"" + component.label
                + "\" is already complete on the selection.");
            RefreshComponentPalette();
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node = flatNodes.get(selectedIndices.get(selectionIndex));
            var fieldIndex = 0;
            while fieldIndex < component.fields.count() {
                var field = component.fields.get(fieldIndex);
                if node.MetadataHas(field.key) == false
                   and WriteNodeComponentField(node, field) == false {
                    RestoreNodeComponentEdit(
                        previousSelection,
                        previousPrimary,
                        "Component \"" + component.label
                        + "\" was rejected. No nodes were changed.");
                    return false;
                }
                fieldIndex = fieldIndex + 1;
            }
            selectionIndex = selectionIndex + 1;
        }

        if CommitScene(
               "Added " + component.label + " to "
               + selectedIndices.count() + " node(s)") == false {
            RestoreNodeComponentEdit(
                previousSelection,
                previousPrimary,
                "The component could not be committed. No nodes were changed.");
            return false;
        }
        selectedNodeMetadata = -1;
        metadataOwnerIndex = selectedIndex;
        // Component membership feeds hierarchy badges and viewport tints;
        // rebuild rows while preserving the batch selection.
        RefreshHierarchy(null);
        SetEditorControlsEnabled(true);
        detailLabel.SetText(
            "Added " + missing + " missing field(s) from "
            + component.label + ".");
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Copy one schema field into the single-node raw metadata editor.
    expose func EditSelectedComponentField() -> Boolean {
        if scene == null or componentPalette == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var field = componentPalette.SelectedField();
        if field == null or selectedIndices.count() != 1 {
            return false;
        }
        var node = SelectedNode();
        if node == null
           or metadataInspector.SetDraft(
               node,
               field.key,
               scene_component_schema.ValueKind(field.kind),
               field.defaultText) == false {
            return false;
        }
        selectedNodeMetadata = metadataInspector.selectedProperty;
        if field.kind == "asset" {
            componentAssetBrowser.SetExtensions(
                file_utils.AssetKindListExtensions(field.assetKinds));
            componentAssetBrowser.Open();
            detailLabel.SetText(
                "Editing " + field.label
                + ". Browse the filtered project assets or type a "
                + "reference in the raw typed-metadata controls.");
        } else {
            detailLabel.SetText(
                "Editing " + field.label
                + " in the raw typed-metadata controls.");
        }
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Write and verify one already-validated schema default.
    hide func WriteNodeComponentField(
        node: SceneNode,
        field: scene_component_schema.SceneComponentField) -> Boolean {
        var intValue = 0;
        var floatValue = 0.0;
        var boolValue = false;
        var applied = false;
        var kind = scene_component_schema.ValueKind(field.kind);
        if kind == "string" {
            applied =
                node.MetadataSetString(field.key, field.defaultText);
        } else if kind == "int" {
            var parsedInt = Parse.TryInt(field.defaultText);
            if parsedInt.IsNone { return false; }
            intValue = parsedInt.UnwrapI64();
            applied = node.MetadataSetInt(field.key, intValue);
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(field.defaultText);
            if parsedFloat.IsNone { return false; }
            floatValue = parsedFloat.UnwrapF64();
            applied = node.MetadataSetFloat(field.key, floatValue);
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(field.defaultText);
            if parsedBool.IsNone { return false; }
            boolValue = parsedBool.UnwrapI1();
            applied = node.MetadataSetBool(field.key, boolValue);
        } else if kind == "null" {
            applied = node.MetadataSetNull(field.key);
        } else {
            return false;
        }
        return applied and NodeMetadataMatches(
            node,
            field.key,
            kind,
            field.defaultText,
            intValue,
            floatValue,
            boolValue);
    }

    /// @brief Reload the canonical document after a partial component write.
    hide func RestoreNodeComponentEdit(
        previousSelection: List[Integer],
        previousPrimary: Integer,
        message: String) {
        var doc = currentDoc;
        if doc != null { LoadDocumentModel(doc, true); }
        SelectSceneNodes(previousSelection, previousPrimary);
        detailLabel.SetText(message + " The document was restored.");
        toolbarStatus.SetText("Component edit rolled back");
        RefreshComponentPalette();
    }

    /// @brief Verify one just-written value without scalar string coercion.
    hide func NodeMetadataMatches(node: SceneNode,
                                  key: String,
                                  kind: String,
                                  stringValue: String,
                                  intValue: Integer,
                                  floatValue: Number,
                                  boolValue: Boolean) -> Boolean {
        if node == null or node.MetadataHas(key) == false
           or node.MetadataKind(key) != kind {
            return false;
        }
        if kind == "string" {
            return node.MetadataGetString(key, "") == stringValue;
        }
        if kind == "int" {
            return node.MetadataGetInt(key, 0) == intValue;
        }
        if kind == "float" {
            var delta = node.MetadataGetFloat(key, 0.0) - floatValue;
            if delta < 0.0 { delta = 0.0 - delta; }
            return delta < 0.000000000001;
        }
        if kind == "bool" {
            return node.MetadataGetBool(key, false) == boolValue;
        }
        return kind == "null";
    }

    /// @brief Reload canonical VSCN after any partial metadata transaction.
    hide func RestoreNodeMetadataEdit(nodeIndex: Integer,
                                      message: String) {
        var doc = currentDoc;
        if doc != null { LoadDocumentModel(doc, true); }
        if nodeIndex >= 0 and nodeIndex < flatNodes.count() {
            SelectIndex(nodeIndex);
        }
        detailLabel.SetText(message + " The document was restored.");
        toolbarStatus.SetText("Metadata edit rolled back");
    }

    /// @brief Update one node's local transform and commit it.
    expose func SetNodeTransform(nodeIndex: Integer,
                                 px: Number,
                                 py: Number,
                                 pz: Number,
                                 sx: Number,
                                 sy: Number,
                                 sz: Number) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        node.SetPosition(px, py, pz);
        node.SetScale(sx, sy, sz);
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene("Updated node transform") == false { return false; }
        positionX.SetValue(px);
        positionY.SetValue(py);
        positionZ.SetValue(pz);
        scaleX.SetValue(sx);
        scaleY.SetValue(sy);
        scaleZ.SetValue(sz);
        return true;
    }

    /// @brief Update one node's local Euler rotation in editor-friendly degrees.
    expose func SetNodeEulerRotation(nodeIndex: Integer,
                                     xDegrees: Number,
                                     yDegrees: Number,
                                     zDegrees: Number) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        node.Rotation = Quat.FromEuler(xDegrees * DEG_TO_RAD,
                                       yDegrees * DEG_TO_RAD,
                                       zDegrees * DEG_TO_RAD).Normalize();
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene("Updated node rotation") == false { return false; }
        rotationX.SetValue(xDegrees);
        rotationY.SetValue(yDegrees);
        rotationZ.SetValue(zDegrees);
        return true;
    }

    /// @brief Translate one node along a displayed local gizmo axis and commit.
    /// @details This is the deterministic command path behind direct viewport
    ///          manipulation. The projected handle reflects parent rotation and
    ///          scale while the edit remains an inspector-compatible local value.
    expose func TranslateNodeAlongGizmoAxis(nodeIndex: Integer,
                                            axis: Integer,
                                            amount: Number) -> Boolean {
        return TransformNodeAlongGizmoAxis(
            nodeIndex, GIZMO_MODE_MOVE, axis, amount, false);
    }

    /// @brief Apply one deterministic Move, Rotate, or Scale axis edit.
    /// @details This is the probeable command boundary behind live gizmo drags.
    ///          The amount is expressed in units, degrees, or scale depending
    ///          on mode; optional snapping quantizes the resulting value.
    expose func TransformNodeAlongGizmoAxis(nodeIndex: Integer,
                                            transformMode: Integer,
                                            axis: Integer,
                                            amount: Number,
                                            snapEnabled: Boolean) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count()
           or scene_transform_3d.IsValidMode(transformMode) == false
           or (axis != GIZMO_AXIS_X and axis != GIZMO_AXIS_Y
               and axis != GIZMO_AXIS_Z)
           or (amount > -0.0000001 and amount < 0.0000001) {
            return false;
        }
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            selectedIndex = nodeIndex;
            selectedIndices = scene_selection.Single(
                nodeIndex, flatNodes.count());
            return TransformSelectedAlongWorldGizmoAxis(
                transformMode, axis, amount, snapEnabled);
        }
        var node = flatNodes.get(nodeIndex);
        var sourceX = 0.0;
        var sourceY = 0.0;
        var sourceZ = 0.0;
        if transformMode == GIZMO_MODE_ROTATE {
            var rotation = node.Rotation;
            var euler = QuaternionToEulerDegrees(rotation);
            sourceX = euler.X;
            sourceY = euler.Y;
            sourceZ = euler.Z;
        } else if transformMode == GIZMO_MODE_SCALE {
            var scale = node.Scale;
            sourceX = scale.X;
            sourceY = scale.Y;
            sourceZ = scale.Z;
        } else {
            var position = node.Position;
            sourceX = position.X;
            sourceY = position.Y;
            sourceZ = position.Z;
        }
        var sourceValue = sourceZ;
        if axis == GIZMO_AXIS_X { sourceValue = sourceX; }
        else if axis == GIZMO_AXIS_Y { sourceValue = sourceY; }
        var targetValue = scene_transform_3d.AxisTarget(
            transformMode, sourceValue, amount, snapEnabled);
        if scene_transform_3d.NearlyEqual(sourceValue, targetValue) {
            return false;
        }
        var targetX = sourceX;
        var targetY = sourceY;
        var targetZ = sourceZ;
        if axis == GIZMO_AXIS_X { targetX = targetValue; }
        else if axis == GIZMO_AXIS_Y { targetY = targetValue; }
        else { targetZ = targetValue; }
        if transformMode == GIZMO_MODE_ROTATE {
            return SetNodeEulerRotation(
                nodeIndex, targetX, targetY, targetZ);
        }
        if transformMode == GIZMO_MODE_SCALE {
            var localPosition = node.Position;
            return SetNodeTransform(
                nodeIndex,
                localPosition.X, localPosition.Y, localPosition.Z,
                targetX, targetY, targetZ);
        }
        var localScale = node.Scale;
        return SetNodeTransform(
            nodeIndex, targetX, targetY, targetZ,
            localScale.X, localScale.Y, localScale.Z);
    }

    /// @brief Apply one axis amount to every selected local transform.
    /// @details The complete group is serialized once so undo restores every
    ///          member together. Rotate and scale use each node's local origin.
    expose func TransformSelectedAlongGizmoAxis(
        transformMode: Integer,
        axis: Integer,
        amount: Number,
        snapEnabled: Boolean) -> Boolean {
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            return TransformSelectedAlongWorldGizmoAxis(
                transformMode, axis, amount, snapEnabled);
        }
        if scene == null
           or scene_transform_3d.IsValidMode(transformMode) == false
           or (axis != GIZMO_AXIS_X and axis != GIZMO_AXIS_Y
               and axis != GIZMO_AXIS_Z)
           or (amount > -0.0000001 and amount < 0.0000001) {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var changed = false;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var nodeIndex = selectedIndices.get(selectionIndex);
            var node = flatNodes.get(nodeIndex);
            var sourceX = 0.0;
            var sourceY = 0.0;
            var sourceZ = 0.0;
            if transformMode == GIZMO_MODE_ROTATE {
                var euler = QuaternionToEulerDegrees(node.Rotation);
                sourceX = euler.X;
                sourceY = euler.Y;
                sourceZ = euler.Z;
            } else if transformMode == GIZMO_MODE_SCALE {
                var scale = node.Scale;
                sourceX = scale.X;
                sourceY = scale.Y;
                sourceZ = scale.Z;
            } else {
                var position = node.Position;
                sourceX = position.X;
                sourceY = position.Y;
                sourceZ = position.Z;
            }
            var sourceValue = sourceZ;
            if axis == GIZMO_AXIS_X { sourceValue = sourceX; }
            else if axis == GIZMO_AXIS_Y { sourceValue = sourceY; }
            var targetValue = scene_transform_3d.AxisTarget(
                transformMode, sourceValue, amount, snapEnabled);
            if scene_transform_3d.NearlyEqual(
                   sourceValue, targetValue) == false {
                if axis == GIZMO_AXIS_X { sourceX = targetValue; }
                else if axis == GIZMO_AXIS_Y { sourceY = targetValue; }
                else { sourceZ = targetValue; }
                ApplyNodeTransformValues(
                    node, transformMode, sourceX, sourceY, sourceZ);
                changed = true;
            }
            selectionIndex = selectionIndex + 1;
        }
        if changed == false { return false; }
        if CommitScene(
               scene_transform_3d.ModeHistoryVerb(transformMode)
               + " " + selectedIndices.count() + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected transforms could not be committed.");
            return false;
        }
        RefreshSelectedFields();
        SetEditorControlsEnabled(true);
        renderDirty = true;
        return true;
    }

    /// @brief Translate every selected node along two axes of one gizmo plane.
    /// @details Compatibility wrapper for deterministic Move-plane probes.
    expose func TranslateSelectedInGizmoPlane(
        plane: Integer,
        amountA: Number,
        amountB: Number,
        snapEnabled: Boolean) -> Boolean {
        return TransformSelectedInGizmoPlane(
            GIZMO_MODE_MOVE, plane, amountA, amountB, snapEnabled);
    }

    /// @brief Scale every selected node along two axes of one gizmo plane.
    /// @details The primary selection defines snapping and therefore the shared
    ///          additive group delta. World edits use exact matrix assignment
    ///          in hierarchy order and reject the complete group on shear.
    expose func ScaleSelectedInGizmoPlane(
        plane: Integer,
        amountA: Number,
        amountB: Number,
        snapEnabled: Boolean) -> Boolean {
        return TransformSelectedInGizmoPlane(
            GIZMO_MODE_SCALE, plane, amountA, amountB, snapEnabled);
    }

    /// @brief Apply one two-axis Move or Scale command to the selected group.
    /// @details Local edits use parent-relative fields. World edits use exact
    ///          runtime matrix assignment in hierarchy order. Either path
    ///          commits one canonical history snapshot or restores every node.
    hide func TransformSelectedInGizmoPlane(
        transformMode: Integer,
        plane: Integer,
        amountA: Number,
        amountB: Number,
        snapEnabled: Boolean) -> Boolean {
        if scene == null
           or (transformMode != GIZMO_MODE_MOVE
               and transformMode != GIZMO_MODE_SCALE)
           or IsGizmoPlane(plane) == false
           or (scene_transform_3d.NearlyEqual(amountA, 0.0)
               and scene_transform_3d.NearlyEqual(amountB, 0.0)) {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            return TransformSelectedInWorldGizmoPlane(
                transformMode, plane, amountA, amountB, snapEnabled);
        }

        var primary = SelectedNode();
        if primary == null { return false; }
        var axisA = GizmoPlaneAxisA(plane);
        var axisB = GizmoPlaneAxisB(plane);
        var primaryValues = primary.Position;
        if transformMode == GIZMO_MODE_SCALE {
            primaryValues = primary.Scale;
        }
        var sourceA = GizmoAxisValue(primaryValues, axisA);
        var sourceB = GizmoAxisValue(primaryValues, axisB);
        var targetA = scene_transform_3d.AxisTarget(
            transformMode, sourceA, amountA, snapEnabled);
        var targetB = scene_transform_3d.AxisTarget(
            transformMode, sourceB, amountB, snapEnabled);
        var deltaA = targetA - sourceA;
        var deltaB = targetB - sourceB;
        if scene_transform_3d.NearlyEqual(deltaA, 0.0)
           and scene_transform_3d.NearlyEqual(deltaB, 0.0) {
            return false;
        }

        var deltaX = 0.0;
        var deltaY = 0.0;
        var deltaZ = 0.0;
        if axisA == GIZMO_AXIS_X { deltaX = deltaA; }
        else if axisA == GIZMO_AXIS_Y { deltaY = deltaA; }
        else { deltaZ = deltaA; }
        if axisB == GIZMO_AXIS_X { deltaX = deltaB; }
        else if axisB == GIZMO_AXIS_Y { deltaY = deltaB; }
        else { deltaZ = deltaB; }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node = flatNodes.get(
                selectedIndices.get(selectionIndex));
            var values = node.Position;
            if transformMode == GIZMO_MODE_SCALE {
                values = node.Scale;
            }
            var valueX = values.X + deltaX;
            var valueY = values.Y + deltaY;
            var valueZ = values.Z + deltaZ;
            if transformMode == GIZMO_MODE_SCALE {
                if axisA == GIZMO_AXIS_X
                   or axisB == GIZMO_AXIS_X {
                    valueX = scene_transform_3d.UsableScale(
                        valueX, values.X);
                }
                if axisA == GIZMO_AXIS_Y
                   or axisB == GIZMO_AXIS_Y {
                    valueY = scene_transform_3d.UsableScale(
                        valueY, values.Y);
                }
                if axisA == GIZMO_AXIS_Z
                   or axisB == GIZMO_AXIS_Z {
                    valueZ = scene_transform_3d.UsableScale(
                        valueZ, values.Z);
                }
            }
            ApplyNodeTransformValues(
                node, transformMode, valueX, valueY, valueZ);
            selectionIndex = selectionIndex + 1;
        }
        if CommitScene(
               scene_transform_3d.ModeHistoryVerb(transformMode)
               + " " + selectedIndices.count()
               + " selected node(s) in "
               + GizmoAxisLabel(plane) + " plane") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected plane transform could not be committed.");
            return false;
        }
        RefreshSelectedFields();
        SetEditorControlsEnabled(true);
        renderDirty = true;
        return true;
    }

    /// @brief Apply one exact absolute-world plane transform to a group.
    hide func TransformSelectedInWorldGizmoPlane(
        transformMode: Integer,
        plane: Integer,
        amountA: Number,
        amountB: Number,
        snapEnabled: Boolean) -> Boolean {
        var worldIndices = HierarchyOrderedSelection(selectedIndices);
        var primary = SelectedNode();
        if worldIndices.count() == 0 or primary == null { return false; }

        var axisA = GizmoPlaneAxisA(plane);
        var axisB = GizmoPlaneAxisB(plane);
        var primaryValues = primary.WorldPosition;
        if transformMode == GIZMO_MODE_SCALE {
            primaryValues = primary.WorldScale;
        }
        var sourceA = GizmoAxisValue(primaryValues, axisA);
        var sourceB = GizmoAxisValue(primaryValues, axisB);
        var targetA = scene_transform_3d.AxisTarget(
            transformMode, sourceA, amountA, snapEnabled);
        var targetB = scene_transform_3d.AxisTarget(
            transformMode, sourceB, amountB, snapEnabled);
        var deltaA = targetA - sourceA;
        var deltaB = targetB - sourceB;
        if scene_transform_3d.NearlyEqual(deltaA, 0.0)
           and scene_transform_3d.NearlyEqual(deltaB, 0.0) {
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var startPositions: List[Vec3] = [];
        var startRotations: List[Quat] = [];
        var startScales: List[Vec3] = [];
        var startWorldMatrices: List[Mat4] = [];
        var startWorldPositions: List[Vec3] = [];
        var startWorldScales: List[Vec3] = [];
        var selectionIndex = 0;
        while selectionIndex < worldIndices.count() {
            var node = flatNodes.get(worldIndices.get(selectionIndex));
            startPositions.add(node.Position);
            startRotations.add(node.Rotation);
            startScales.add(node.Scale);
            startWorldMatrices.add(node.WorldMatrix);
            startWorldPositions.add(node.WorldPosition);
            startWorldScales.add(node.WorldScale);
            selectionIndex = selectionIndex + 1;
        }

        var accepted = true;
        selectionIndex = 0;
        while selectionIndex < worldIndices.count() and accepted {
            var desired = WorldPlaneTargetMatrix(
                startWorldMatrices.get(selectionIndex),
                startWorldPositions.get(selectionIndex),
                startWorldScales.get(selectionIndex),
                transformMode,
                axisA,
                axisB,
                deltaA,
                deltaB);
            if desired == null
               or flatNodes.get(worldIndices.get(selectionIndex))
                      .TrySetWorldMatrix(desired) == false {
                accepted = false;
            }
            selectionIndex = selectionIndex + 1;
        }
        if accepted == false {
            RestoreLocalTransforms(
                worldIndices,
                startPositions,
                startRotations,
                startScales);
            detailLabel.SetText(
                "The world-space plane transform would require a singular, "
                + "degenerate, or sheared local transform. No nodes changed.");
            toolbarStatus.SetText("World plane transform rejected");
            RefreshSelectedFields();
            renderDirty = true;
            return false;
        }
        if CommitScene(
               scene_transform_3d.ModeHistoryVerb(transformMode)
               + " " + selectedIndices.count()
               + " selected node(s) in world "
               + GizmoAxisLabel(plane) + " plane") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The world-space plane transform could not be committed.");
            return false;
        }
        RefreshSelectedFields();
        SetEditorControlsEnabled(true);
        renderDirty = true;
        return true;
    }

    /// @brief Apply one absolute-world axis amount to every selected node.
    /// @details Each member uses its own pivot and captured world matrix. The
    ///          runtime proves the resulting parent-relative TRS exactly; one
    ///          rejection restores every captured local transform before return.
    hide func TransformSelectedAlongWorldGizmoAxis(
        transformMode: Integer,
        axis: Integer,
        amount: Number,
        snapEnabled: Boolean) -> Boolean {
        if scene == null
           or scene_transform_3d.IsValidMode(transformMode) == false
           or (axis != GIZMO_AXIS_X and axis != GIZMO_AXIS_Y
               and axis != GIZMO_AXIS_Z)
           or (amount > -0.0000001 and amount < 0.0000001) {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var worldIndices = HierarchyOrderedSelection(selectedIndices);
        if worldIndices.count() == 0 { return false; }

        var primary = SelectedNode();
        if primary == null { return false; }
        var primaryPosition = primary.WorldPosition;
        var primaryScale = primary.WorldScale;
        var sourceValue = WorldAxisSourceValue(
            transformMode, axis, primaryPosition, primaryScale);
        var targetValue = scene_transform_3d.AxisTarget(
            transformMode, sourceValue, amount, snapEnabled);
        var delta = targetValue - sourceValue;
        if scene_transform_3d.NearlyEqual(delta, 0.0) {
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var startPositions: List[Vec3] = [];
        var startRotations: List[Quat] = [];
        var startScales: List[Vec3] = [];
        var startWorldMatrices: List[Mat4] = [];
        var startWorldPositions: List[Vec3] = [];
        var startWorldScales: List[Vec3] = [];
        var selectionIndex = 0;
        while selectionIndex < worldIndices.count() {
            var node = flatNodes.get(
                worldIndices.get(selectionIndex));
            startPositions.add(node.Position);
            startRotations.add(node.Rotation);
            startScales.add(node.Scale);
            startWorldMatrices.add(node.WorldMatrix);
            startWorldPositions.add(node.WorldPosition);
            startWorldScales.add(node.WorldScale);
            selectionIndex = selectionIndex + 1;
        }

        var accepted = true;
        selectionIndex = 0;
        while selectionIndex < worldIndices.count() and accepted {
            var desired = WorldAxisTargetMatrix(
                startWorldMatrices.get(selectionIndex),
                startWorldPositions.get(selectionIndex),
                startWorldScales.get(selectionIndex),
                transformMode,
                axis,
                delta);
            if desired == null
               or flatNodes.get(
                      worldIndices.get(selectionIndex))
                      .TrySetWorldMatrix(desired) == false {
                accepted = false;
            }
            selectionIndex = selectionIndex + 1;
        }
        if accepted == false {
            RestoreLocalTransforms(
                worldIndices,
                startPositions,
                startRotations,
                startScales);
            detailLabel.SetText(
                "The world-space transform would require a singular, "
                + "degenerate, or sheared local transform. No nodes changed.");
            toolbarStatus.SetText("World transform rejected");
            RefreshSelectedFields();
            renderDirty = true;
            return false;
        }

        if CommitScene(
               scene_transform_3d.ModeHistoryVerb(transformMode)
               + " " + selectedIndices.count()
               + " selected node(s) in world space") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The world-space transform could not be committed.");
            return false;
        }
        RefreshSelectedFields();
        SetEditorControlsEnabled(true);
        renderDirty = true;
        return true;
    }

    /// @brief Return selected flattened indices in parent-before-child order.
    /// @details The visible hierarchy is a bounded preorder flattening. Rebuild
    ///          from that model order instead of trusting caller/restore order,
    ///          so a selected ancestor's world delta cannot affect a descendant
    ///          after the descendant has already reached its requested matrix.
    hide func HierarchyOrderedSelection(
        indices: List[Integer]) -> List[Integer] {
        var ordered: List[Integer] = [];
        var flatIndex = 0;
        while flatIndex < flatNodes.count() {
            if scene_selection.Contains(indices, flatIndex) {
                ordered.add(flatIndex);
            }
            flatIndex = flatIndex + 1;
        }
        return ordered;
    }

    /// @brief Resolve the snapped axis source used by one world-space action.
    hide func WorldAxisSourceValue(transformMode: Integer,
                                   axis: Integer,
                                   worldPosition: Vec3,
                                   worldScale: Vec3) -> Number {
        if transformMode == GIZMO_MODE_ROTATE { return 0.0; }
        var source = 0.0;
        if transformMode == GIZMO_MODE_SCALE {
            if worldScale == null { return 1.0; }
            source = worldScale.Z;
            if axis == GIZMO_AXIS_X { source = worldScale.X; }
            else if axis == GIZMO_AXIS_Y { source = worldScale.Y; }
            return source;
        }
        if worldPosition == null { return 0.0; }
        source = worldPosition.Z;
        if axis == GIZMO_AXIS_X { source = worldPosition.X; }
        else if axis == GIZMO_AXIS_Y { source = worldPosition.Y; }
        return source;
    }

    /// @brief Build one world-axis delta around the node's captured pivot.
    hide func WorldAxisTargetMatrix(startWorld: Mat4,
                                    pivot: Vec3,
                                    worldScale: Vec3,
                                    transformMode: Integer,
                                    axis: Integer,
                                    delta: Number) -> Mat4 {
        if startWorld == null or pivot == null { return null; }
        if transformMode == GIZMO_MODE_MOVE {
            var dx = 0.0;
            var dy = 0.0;
            var dz = 0.0;
            if axis == GIZMO_AXIS_X { dx = delta; }
            else if axis == GIZMO_AXIS_Y { dy = delta; }
            else { dz = delta; }
            return Mat4.Mul(Mat4.Translate(dx, dy, dz), startWorld);
        }

        var deltaTransform: Mat4 = null;
        if transformMode == GIZMO_MODE_ROTATE {
            var radians = delta * DEG_TO_RAD;
            if axis == GIZMO_AXIS_X {
                deltaTransform = Mat4.RotateX(radians);
            } else if axis == GIZMO_AXIS_Y {
                deltaTransform = Mat4.RotateY(radians);
            } else {
                deltaTransform = Mat4.RotateZ(radians);
            }
        } else if transformMode == GIZMO_MODE_SCALE {
            if worldScale == null { return null; }
            var sourceScale = worldScale.Z;
            if axis == GIZMO_AXIS_X { sourceScale = worldScale.X; }
            else if axis == GIZMO_AXIS_Y { sourceScale = worldScale.Y; }
            if sourceScale > -0.000001 and sourceScale < 0.000001 {
                return null;
            }
            var targetScale = scene_transform_3d.UsableScale(
                sourceScale + delta, sourceScale);
            var factor = targetScale / sourceScale;
            var factorX = 1.0;
            var factorY = 1.0;
            var factorZ = 1.0;
            if axis == GIZMO_AXIS_X { factorX = factor; }
            else if axis == GIZMO_AXIS_Y { factorY = factor; }
            else { factorZ = factor; }
            deltaTransform = Mat4.Scale(factorX, factorY, factorZ);
        }
        if deltaTransform == null { return null; }
        return Mat4.Mul(
            Mat4.Translate(pivot.X, pivot.Y, pivot.Z),
            Mat4.Mul(
                deltaTransform,
                Mat4.Mul(
                    Mat4.Translate(
                        0.0 - pivot.X,
                        0.0 - pivot.Y,
                        0.0 - pivot.Z),
                    startWorld)));
    }

    /// @brief Build one world-plane Move or Scale delta around a node pivot.
    /// @details Two-axis scale factors are derived from the captured absolute
    ///          scale. TrySetWorldMatrix remains the authority for whether the
    ///          resulting parent-relative transform is an exact TRS.
    hide func WorldPlaneTargetMatrix(
        startWorld: Mat4,
        pivot: Vec3,
        worldScale: Vec3,
        transformMode: Integer,
        axisA: Integer,
        axisB: Integer,
        deltaA: Number,
        deltaB: Number) -> Mat4 {
        if startWorld == null or pivot == null { return null; }
        if transformMode == GIZMO_MODE_MOVE {
            var dx = 0.0;
            var dy = 0.0;
            var dz = 0.0;
            if axisA == GIZMO_AXIS_X { dx = deltaA; }
            else if axisA == GIZMO_AXIS_Y { dy = deltaA; }
            else { dz = deltaA; }
            if axisB == GIZMO_AXIS_X { dx = deltaB; }
            else if axisB == GIZMO_AXIS_Y { dy = deltaB; }
            else { dz = deltaB; }
            return Mat4.Mul(Mat4.Translate(dx, dy, dz), startWorld);
        }
        if transformMode != GIZMO_MODE_SCALE or worldScale == null {
            return null;
        }

        var sourceA = GizmoAxisValue(worldScale, axisA);
        var sourceB = GizmoAxisValue(worldScale, axisB);
        if (sourceA > -0.000001 and sourceA < 0.000001)
           or (sourceB > -0.000001 and sourceB < 0.000001) {
            return null;
        }
        var factorA = scene_transform_3d.UsableScale(
            sourceA + deltaA, sourceA) / sourceA;
        var factorB = scene_transform_3d.UsableScale(
            sourceB + deltaB, sourceB) / sourceB;
        var factorX = 1.0;
        var factorY = 1.0;
        var factorZ = 1.0;
        if axisA == GIZMO_AXIS_X { factorX = factorA; }
        else if axisA == GIZMO_AXIS_Y { factorY = factorA; }
        else { factorZ = factorA; }
        if axisB == GIZMO_AXIS_X { factorX = factorB; }
        else if axisB == GIZMO_AXIS_Y { factorY = factorB; }
        else { factorZ = factorB; }
        var deltaTransform = Mat4.Scale(factorX, factorY, factorZ);
        return Mat4.Mul(
            Mat4.Translate(pivot.X, pivot.Y, pivot.Z),
            Mat4.Mul(
                deltaTransform,
                Mat4.Mul(
                    Mat4.Translate(
                        0.0 - pivot.X,
                        0.0 - pivot.Y,
                        0.0 - pivot.Z),
                    startWorld)));
    }

    /// @brief Restore complete local TRS snapshots after a rejected group edit.
    hide func RestoreLocalTransforms(indices: List[Integer],
                                     positions: List[Vec3],
                                     rotations: List[Quat],
                                     scales: List[Vec3]) {
        var index = 0;
        while index < indices.count()
              and index < positions.count()
              and index < rotations.count()
              and index < scales.count() {
            var nodeIndex = indices.get(index);
            if nodeIndex >= 0 and nodeIndex < flatNodes.count() {
                var node = flatNodes.get(nodeIndex);
                var position = positions.get(index);
                var scale = scales.get(index);
                node.SetPosition(position.X, position.Y, position.Z);
                node.Rotation = rotations.get(index);
                node.SetScale(scale.X, scale.Y, scale.Z);
            }
            index = index + 1;
        }
    }

    /// @brief Apply explicit relative inspector values to every selected node.
    /// @details Position and Euler values are added to each local transform;
    ///          scale values multiply each local scale. The batch commits once
    ///          and reloads the prior canonical graph on any commit failure.
    expose func ApplySelectedTransformDeltas(
        positionDeltaX: Number,
        positionDeltaY: Number,
        positionDeltaZ: Number,
        rotationDeltaX: Number,
        rotationDeltaY: Number,
        rotationDeltaZ: Number,
        scaleFactorX: Number,
        scaleFactorY: Number,
        scaleFactorZ: Number) -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() < 2 { return false; }
        var positionChanged =
            scene_transform_3d.NearlyEqual(positionDeltaX, 0.0) == false
            or scene_transform_3d.NearlyEqual(positionDeltaY, 0.0) == false
            or scene_transform_3d.NearlyEqual(positionDeltaZ, 0.0) == false;
        var rotationChanged =
            scene_transform_3d.NearlyEqual(rotationDeltaX, 0.0) == false
            or scene_transform_3d.NearlyEqual(rotationDeltaY, 0.0) == false
            or scene_transform_3d.NearlyEqual(rotationDeltaZ, 0.0) == false;
        var scaleChanged =
            scene_transform_3d.NearlyEqual(scaleFactorX, 1.0) == false
            or scene_transform_3d.NearlyEqual(scaleFactorY, 1.0) == false
            or scene_transform_3d.NearlyEqual(scaleFactorZ, 1.0) == false;
        if positionChanged == false
           and rotationChanged == false and scaleChanged == false {
            detailLabel.SetText("The batch transform is already neutral.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node = flatNodes.get(selectedIndices.get(selectionIndex));
            var position = node.Position;
            node.SetPosition(
                position.X + positionDeltaX,
                position.Y + positionDeltaY,
                position.Z + positionDeltaZ);
            var euler = QuaternionToEulerDegrees(node.Rotation);
            node.Rotation = Quat.FromEuler(
                (euler.X + rotationDeltaX) * DEG_TO_RAD,
                (euler.Y + rotationDeltaY) * DEG_TO_RAD,
                (euler.Z + rotationDeltaZ) * DEG_TO_RAD).Normalize();
            var scale = node.Scale;
            node.SetScale(
                scale.X * scaleFactorX,
                scale.Y * scaleFactorY,
                scale.Z * scaleFactorZ);
            selectionIndex = selectionIndex + 1;
        }
        var count = selectedIndices.count();
        if CommitScene(
               "Applied transform deltas to " + count + " selected nodes")
           == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The batch transform could not be committed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshSelectedFields();
        SetEditorControlsEnabled(true);
        renderDirty = true;
        return true;
    }

    /// @brief Replace one node light with an independent all-field value.
    /// @details No live light mutates before staging completes. Imported or
    ///          shared component aliases therefore cannot observe this edit.
    expose func ApplyNodeLight(
        nodeIndex: Integer,
        state: scene_light_3d.LightState3D) -> Boolean {
        if scene == null or state == null
           or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var next = scene_light_3d.BuildLight(state);
        if next == null {
            toolbarStatus.SetText("Light edit failed");
            detailLabel.SetText(
                "Studio could not construct an independent light value.");
            GUI.Toast.Error("3D light edit failed");
            return false;
        }
        if scene_light_3d.Equivalent(node.Light, next) {
            detailLabel.SetText("The node light is already up to date.");
            return false;
        }
        node.Light = next;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        var typeName = scene_light_3d.TypeName(next.Type);
        if CommitScene(
               "Updated " + typeName + " light on "
               + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            typeName
            + " light updated as one independent, undoable component.");
        return true;
    }

    /// @brief Apply the light inspector to the selection (ADR 0186).
    /// @details Zero light-bearing nodes: create from the full draft on
    ///          every selected node. Otherwise: patch determined fields on
    ///          light-bearing nodes only. One transaction either way.
    expose func ApplySelectedLightFromControls() -> Boolean {
        if lightInspector == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var lightCount = 0;
        var index = 0;
        while index < selectedIndices.count() {
            if flatNodes.get(
                   selectedIndices.get(index)).Light != null {
                lightCount = lightCount + 1;
            }
            index = index + 1;
        }
        if lightCount == 0 {
            return CreateLightsOnSelection(lightInspector.BuildState());
        }
        return ApplySelectedLightPatch(lightInspector.BuildPatch());
    }

    /// @brief Create one light per selected lightless node, one transaction.
    expose func CreateLightsOnSelection(
        state: scene_light_3d.LightState3D) -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var staged: List[Light3D] = [];
        var createdCount = 0;
        var index = 0;
        while index < selectedIndices.count() {
            var node = flatNodes.get(selectedIndices.get(index));
            if node.Light != null {
                staged.add(null);
            } else {
                var light = scene_light_3d.BuildLight(state);
                if light == null {
                    toolbarStatus.SetText("Light batch failed");
                    detailLabel.SetText(
                        "Studio could not allocate every light. "
                        + "No selected nodes were changed.");
                    GUI.Toast.Error("3D light batch failed");
                    return false;
                }
                staged.add(light);
                createdCount = createdCount + 1;
            }
            index = index + 1;
        }
        if createdCount == 0 { return false; }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        index = 0;
        while index < selectedIndices.count() {
            var stagedLight = staged.get(index);
            if stagedLight != null {
                flatNodes.get(
                    selectedIndices.get(index)).Light = stagedLight;
            }
            index = index + 1;
        }
        if CommitScene(
               "Added " + scene_light_3d.TypeName(state.kind)
               + " lights to " + createdCount
               + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The light additions could not be committed.");
            return false;
        }
        RefreshHierarchy(null);
        detailLabel.SetText(
            "Created " + createdCount
            + " independent light component(s) in one undoable edit.");
        return true;
    }

    /// @brief Patch determined fields onto every selected light, staged
    ///        clone-safe with the material sharing-group rule (ADR 0186).
    expose func ApplySelectedLightPatch(
        patch: scene_light_3d.LightPatch3D) -> Boolean {
        if scene == null or patch == null or patch.HasFields() == false {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }

        var currentLights: List[Light3D] = [];
        var nextLights: List[Light3D] = [];
        var changedCount = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node =
                flatNodes.get(selectedIndices.get(selectionIndex));
            var current = node.Light;
            currentLights.add(current);
            if current == null
               or scene_light_3d.MatchesPatch(current, patch) {
                nextLights.add(current);
            } else {
                var next: Light3D = null;
                var prior = 0;
                while prior < currentLights.count() - 1
                      and next == null {
                    if currentLights.get(prior) == current
                       and nextLights.get(prior) != current {
                        next = nextLights.get(prior);
                    }
                    prior = prior + 1;
                }
                if next == null {
                    next = scene_light_3d.ApplyPatchUnique(
                        current, patch);
                }
                if next == null {
                    toolbarStatus.SetText("Light batch failed");
                    detailLabel.SetText(
                        "Studio could not construct every replacement "
                        + "light. No selected nodes were changed.");
                    GUI.Toast.Error("3D light batch failed");
                    return false;
                }
                nextLights.add(next);
                changedCount = changedCount + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if changedCount == 0 {
            detailLabel.SetText(
                "Every selected light already matches the determined "
                + "fields.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex)).Light =
                nextLights.get(selectionIndex);
            selectionIndex = selectionIndex + 1;
        }
        if CommitScene(
               "Updated light fields on " + changedCount
               + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The light batch could not be committed.");
            return false;
        }
        RefreshLightFields(SelectedNode());
        UpdateLightControls(true);
        detailLabel.SetText(
            "Light fields updated on " + changedCount
            + " selected node(s); unresolved mixed fields were preserved.");
        renderDirty = true;
        return true;
    }

    /// @brief Remove lights from every selected node in one transaction.
    expose func RemoveSelectedLights() -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var lightCount = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            if flatNodes.get(
                   selectedIndices.get(selectionIndex)).Light != null {
                lightCount = lightCount + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if lightCount == 0 {
            detailLabel.SetText(
                "No selected node has a light component.");
            return false;
        }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex)).Light = null;
            selectionIndex = selectionIndex + 1;
        }
        if CommitScene(
               "Removed lights from " + lightCount
               + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The light removal could not be committed.");
            return false;
        }
        RefreshHierarchy(null);
        detailLabel.SetText(
            "Removed " + lightCount
            + " light component(s); the scene nodes were preserved.");
        return true;
    }

    /// @brief Remove one node light as a canonical history transaction.
    expose func RemoveNodeLight(nodeIndex: Integer) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if node.Light == null {
            detailLabel.SetText("The selected node has no light component.");
            return false;
        }
        node.Light = null;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene(
               "Removed light from " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Removed the light component; the scene node was preserved.");
        return true;
    }

    /// @brief Create one named top-level camera node transactionally.
    expose func AddCameraNode(name: String,
                              parentIndex: Integer) -> Integer {
        if scene == null { return -1; }
        if parentIndex >= 0 and parentIndex < flatNodes.count()
           and ParentAcceptsAuthoredChildren(
                   flatNodes.get(parentIndex)) == false {
            return -1;
        }
        var state = new scene_camera_3d.CameraState3D();
        var camera = scene_camera_3d.BuildCamera(state);
        if camera == null {
            toolbarStatus.SetText("Camera creation failed");
            detailLabel.SetText(
                "Studio could not allocate the camera component.");
            GUI.Toast.Error("3D camera creation failed");
            return -1;
        }
        var parent: SceneNode = null;
        if parentIndex >= 0 and parentIndex < flatNodes.count() {
            parent = flatNodes.get(parentIndex);
        }
        var node = SceneNode.New();
        if node == null {
            toolbarStatus.SetText("Camera creation failed");
            detailLabel.SetText("Studio could not allocate a scene node.");
            GUI.Toast.Error("3D camera creation failed");
            return -1;
        }
        var nodeName = Str.Trim(name);
        if nodeName == "" { nodeName = "Camera " + scene.NodeCount; }
        node.Name = nodeName;
        node.Camera = camera;
        if parent != null {
            parent.AddChild(node);
        } else {
            scene.Add(node);
        }
        if CommitScene("Added " + nodeName) == false { return -1; }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Created a perspective camera. Use the Camera component "
            + "inspector to change projection and clip planes.");
        return selectedIndex;
    }

    /// @brief Apply one independent camera component transaction.
    /// @details A replacement camera is constructed before assignment, so a
    ///          shared imported camera instance is never mutated in place.
    expose func ApplyNodeCamera(
        nodeIndex: Integer,
        state: scene_camera_3d.CameraState3D) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if node.Camera != null
           and scene_camera_3d.Matches(node.Camera, state) {
            detailLabel.SetText("The node camera is already up to date.");
            return false;
        }
        var next = scene_camera_3d.BuildCamera(state);
        if next == null {
            toolbarStatus.SetText("Camera edit failed");
            detailLabel.SetText(
                "Studio could not construct an independent camera value.");
            GUI.Toast.Error("3D camera edit failed");
            return false;
        }
        node.Camera = next;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        var projectionName =
            scene_camera_3d.ProjectionName(next.IsOrtho);
        if CommitScene(
               "Updated " + projectionName + " camera on "
               + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            projectionName
            + " camera updated as one independent, undoable component.");
        return true;
    }

    /// @brief Apply the camera inspector draft to its one selected node.
    expose func ApplySelectedCameraFromControls() -> Boolean {
        if cameraInspector == null or selectedIndices.count() != 1 {
            return false;
        }
        return ApplyNodeCamera(
            selectedIndex, cameraInspector.BuildState());
    }

    /// @brief Remove one node camera as a canonical history transaction.
    expose func RemoveNodeCamera(nodeIndex: Integer) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if node.Camera == null {
            detailLabel.SetText("The selected node has no camera component.");
            return false;
        }
        if lookThroughNode == node { lookThroughNode = null; }
        node.Camera = null;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene(
               "Removed camera from " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Removed the camera component; the scene node was preserved.");
        return true;
    }

    /// @brief Toggle authored-camera look-through; workspace-only.
    expose func ToggleLookThrough() -> Boolean {
        ReleaseGameplayViewAnchor();
        if lookThroughNode != null {
            lookThroughNode = null;
            renderDirty = true;
            RefreshCameraFields(SelectedNode());
            return true;
        }
        var node = SelectedNode();
        if node == null or node.Camera == null { return false; }
        flyActive = false;
        lookThroughNode = node;
        renderDirty = true;
        RefreshCameraFields(node);
        return true;
    }

    /// @brief Report whether an authored camera drives the viewport.
    expose func IsLookingThroughCamera() -> Boolean {
        return ActiveLookThroughNode() != null;
    }

    /// @brief Apply the collider inspector draft as one VSCN transaction.
    expose func ApplySelectedColliderFromControls() -> Boolean {
        if colliderInspector == null or selectedIndices.count() != 1 {
            return false;
        }
        return ApplyNodeCollider(
            selectedIndex, colliderInspector.BuildState());
    }

    /// @brief Write one collider convention as one canonical transaction.
    /// @details Writes kind-applicable keys, removes stale dimension keys,
    ///          refuses exact no-ops, and reloads the canonical document on
    ///          any partial write failure so nodes never keep half an edit.
    expose func ApplyNodeCollider(
        nodeIndex: Integer,
        state: scene_collider_3d.ColliderState3D) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var next = scene_collider_3d.Normalize(state);
        if next.kind == scene_collider_3d.COLLIDER_NONE {
            return RemoveNodeColliderConvention(nodeIndex);
        }
        if scene_collider_3d.Matches(node, next) {
            detailLabel.SetText(
                "The node collider convention is already up to date.");
            return false;
        }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        if scene_collider_3d.WriteToNode(node, next) == false {
            RestoreNodeComponentEdit(
                previousSelection,
                previousPrimary,
                "The collider edit was rejected. No nodes were changed.");
            return false;
        }
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        var kindName = scene_collider_3d.KindName(next.kind);
        if CommitScene(
               "Updated " + kindName + " collider on "
               + NodeDisplayName(node)) == false {
            RestoreNodeComponentEdit(
                previousSelection,
                previousPrimary,
                "The collider edit could not be committed.");
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            kindName + " collider convention written as one undoable "
            + "typed-metadata edit.");
        return true;
    }

    /// @brief Remove the complete collider convention transactionally.
    expose func RemoveNodeColliderConvention(
        nodeIndex: Integer) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if scene_collider_3d.RemoveFromNode(node) == false {
            detailLabel.SetText(
                "The selected node has no collider convention.");
            return false;
        }
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene(
               "Removed collider from " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Removed every collider key; the scene node was preserved.");
        return true;
    }

    /// @brief Return the selected asset-kind schema field, or null.
    hide func SelectedAssetComponentField()
        -> scene_component_schema.SceneComponentField {
        if componentPalette == null { return null; }
        var field = componentPalette.SelectedField();
        if field == null or field.kind != "asset" { return null; }
        return field;
    }

    /// @brief Stage one browsed asset path into the metadata draft.
    /// @details Fixes the ADR 0178 deferral: asset-kind schema fields browse
    ///          the bounded workspace index (filtered by the field's asset
    ///          kinds) and stage a portable reference; the canonical write
    ///          still flows through the normal metadata transaction.
    hide func ApplyComponentAssetPath(assetPath: String) {
        var field = SelectedAssetComponentField();
        var node = SelectedNode();
        if field == null or node == null { return; }
        var documentPath = "";
        if currentDoc != null { documentPath = currentDoc.filePath; }
        var portable = scene_asset_browser.PortableReferencePath(
            assetPath, documentPath);
        if portable == "" { return; }
        if metadataInspector.SetDraft(
               node, field.key, "string", portable) == false {
            return;
        }
        selectedNodeMetadata = metadataInspector.selectedProperty;
        detailLabel.SetText(
            "Staged " + portable + " into " + field.label
            + ". Save the metadata draft to commit one undoable edit.");
        CaptureWorkspaceState();
    }

    /// @brief Place one scene by reference as a VSCN v7 prefab instance.
    /// @details The referencing document must be saved so the reference can
    ///          stay portable; grafting happens through the canonical loader
    ///          on the post-commit reload (one implementation everywhere).
    expose func ImportInstancePath(path: String) -> Boolean {
        importBrowserInstanceMode = false;
        if path == "" or currentDoc == null or scene == null {
            return false;
        }
        if currentDoc.filePath == "" {
            detailLabel.SetText(
                "Save this scene before placing instances so the "
                + "reference can stay relative and portable.");
            toolbarStatus.SetText("Instance import needs a saved scene");
            return false;
        }
        var lowered = Str.ToLower(path);
        if Str.EndsWith(lowered, ".scene3d") == false
           and Str.EndsWith(lowered, ".vscn") == false {
            detailLabel.SetText(
                "Instances reference .scene3d/.vscn scenes; other formats "
                + "import as copies.");
            return false;
        }
        var portable = scene_asset_browser.PortableReferencePath(
            path, currentDoc.filePath);
        if portable == "" { return false; }
        var relinkTarget = SelectedNode();
        if relinkTarget != null and relinkTarget.PrefabPath != "" {
            if relinkTarget.PrefabPath == portable {
                detailLabel.SetText(
                    "The instance already references " + portable + ".");
                return false;
            }
            if relinkTarget.SetPrefabReference(portable) == false {
                detailLabel.SetText(
                    "The reference must be relative; move the referenced "
                    + "scene inside the workspace.");
                return false;
            }
            if CommitScene(
                   "Re-linked instance to " + portable) == false {
                return false;
            }
            LoadDocumentModel(currentDoc, true);
            detailLabel.SetText(
                "Re-linked the instance to " + portable + ".");
            return true;
        }
        var node = SceneNode.New();
        if node == null { return false; }
        var stem = Path.Name(path);
        node.Name = stem + " Instance";
        if node.SetPrefabReference(portable) == false {
            detailLabel.SetText(
                "The reference must be relative; move the referenced "
                + "scene inside the workspace.");
            return false;
        }
        scene.Add(node);
        if CommitScene("Instanced " + portable) == false {
            return false;
        }
        LoadDocumentModel(currentDoc, true);
        detailLabel.SetText(
            "Placed " + portable + " by reference. The file stores only "
            + "the reference plus this node's overrides.");
        return true;
    }

    /// @brief Queue the referenced scene for the shell's open command.
    hide func RequestOpenPrefabSource() {
        var node = SelectedNode();
        if node == null or node.PrefabPath == ""
           or currentDoc == null or currentDoc.filePath == "" {
            detailLabel.SetText(
                "Select a prefab instance in a saved scene to open its "
                + "source.");
            return;
        }
        pendingOpenPrefabPath = Path.Normalize(Path.Join(
            Path.Directory(currentDoc.filePath), node.PrefabPath));
        detailLabel.SetText(
            "Opening " + node.PrefabPath + " as its own document.");
    }

    /// @brief Consume the queued prefab-source path for the command layer.
    expose func TakeOpenPrefabSourcePath() -> String {
        var path = pendingOpenPrefabPath;
        pendingOpenPrefabPath = "";
        return path;
    }

    /// @brief Re-graft every instance from its referenced files.
    expose func ReloadPrefabInstances() {
        if currentDoc == null { return; }
        LoadDocumentModel(currentDoc, true);
        toolbarStatus.SetText("Instances reloaded");
        detailLabel.SetText(
            "Re-grafted every prefab instance from its referenced file; "
            + "overrides were preserved.");
    }

    /// @brief Convert the selected instance into a plain editable copy.
    expose func UnpackSelectedInstance() -> Boolean {
        var node = SelectedNode();
        if node == null or node.PrefabPath == "" {
            detailLabel.SetText(
                "Select a prefab instance node to unpack.");
            return false;
        }
        if node.ClearPrefabReference() == false { return false; }
        if CommitScene(
               "Unpacked instance " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshHierarchy(node);
        detailLabel.SetText(
            "Unpacked the instance into plain editable nodes; the "
            + "reference was removed.");
        return true;
    }

    /// @brief Resolve instance content to its owning prefab node.
    /// @details Instance content is locked (ADR 0187): selection always
    ///          lands on the owning instance so every edit path sees the
    ///          override surface, never grafted internals.
    hide func ResolveInstanceOwnerIndex(nodeIndex: Integer) -> Integer {
        if nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return nodeIndex;
        }
        var node = flatNodes.get(nodeIndex);
        if node == null or node.IsInstanceContent == false {
            return nodeIndex;
        }
        var owner = node.Parent;
        var ancestorSteps = 0;
        while owner != null and ancestorSteps < 128 {
            if owner.PrefabPath != "" {
                var ownerIndex = FindFlatIndex(owner);
                if ownerIndex >= 0 { return ownerIndex; }
                return nodeIndex;
            }
            owner = owner.Parent;
            ancestorSteps = ancestorSteps + 1;
        }
        return nodeIndex;
    }

    /// @brief Remap one selection so it never contains instance content.
    hide func ResolveInstanceOwnerSelection(
        indices: List[Integer]) -> List[Integer] {
        var resolved: List[Integer] = [];
        var remapped = false;
        var index = 0;
        while index < indices.count() {
            var ownerIndex =
                ResolveInstanceOwnerIndex(indices.get(index));
            if ownerIndex != indices.get(index) { remapped = true; }
            if scene_selection.Contains(resolved, ownerIndex) == false {
                resolved.add(ownerIndex);
            }
            index = index + 1;
        }
        if remapped {
            detailLabel.SetText(
                "Instance content is locked; selected the owning "
                + "prefab instance instead.");
        }
        return resolved;
    }

    /// @brief Return whether a parent target may receive new children.
    /// @details Children of prefab nodes never serialize, and grafted
    ///          content is locked, so both reject with a truthful message.
    hide func ParentAcceptsAuthoredChildren(parent: SceneNode) -> Boolean {
        if parent == null { return true; }
        if parent.PrefabPath != "" {
            detailLabel.SetText(
                "Prefab instances own their grafted content; new children "
                + "would not serialize. Unpack the instance first.");
            return false;
        }
        if parent.IsInstanceContent {
            detailLabel.SetText(
                "Instance content is locked. Unpack the owning instance "
                + "to edit its nodes.");
            return false;
        }
        return true;
    }

    /// @brief Small bounded probe-bounds spinner builder.
    expose func AddProbeSpinner(parent: GUI.Flex,
                              label: String,
                              value: Number) -> GUI.Spinner {
        var spinner = GUI.Spinner.New(parent);
        spinner.SetRange(-1000000.0, 1000000.0);
        spinner.SetStep(0.5);
        spinner.SetDecimals(2);
        spinner.SetValue(value);
        spinner.SetPreferredSize(72.0, 0.0);
        spinner.SetAccessibleName(label + " probe value");
        return spinner;
    }

    /// @brief Pump every bake, probe, and environment intent (ADR 0188).
    hide func PumpBakeControls() {
        if bakeButton == null { return; }
        if bakeButton.WasClicked() {
            if bakeActive { CancelBake(); }
            else { StartBake(); }
        }
        if makeUniqueButton.WasClicked() {
            MakeMeshesUniqueForBaking();
        }
        if probeApplyButton.WasClicked()
           and selectedIndices.count() == 1 {
            ApplySelectedProbeGrid();
        }
        if probeRemoveButton.WasClicked()
           and selectedIndices.count() == 1 {
            RemoveSelectedProbeGrid();
        }
        if bakeProbesButton.WasClicked()
           and selectedIndices.count() == 1 {
            BakeSelectedProbeGrid();
        }
        if envBrowseButton.WasClicked() {
            envBrowseMode = true;
            importBrowserInstanceMode = false;
            importAssetBrowser.SetExtensions(".hdr,.png,.jpg,.jpeg");
            importAssetBrowser.Open();
        }
        if envApplyButton.WasClicked() {
            ApplyEnvironmentFromControls();
        }
    }

    /// @brief Read the bake settings draft from the retained controls.
    hide func BakeSettingsFromControls() -> scene_bake_3d.BakeSettings3D {
        var state = new scene_bake_3d.BakeSettings3D();
        state.texelsPerUnit = bakeTexelsSpinner.Value;
        state.samples = Convert.NumToInt(bakeSamplesSpinner.Value);
        state.bounces = Convert.NumToInt(bakeBouncesSpinner.Value);
        state.skyR =
            scene_light_3d.UnitFromByte(bakeSkyPicker.GetRed());
        state.skyG =
            scene_light_3d.UnitFromByte(bakeSkyPicker.GetGreen());
        state.skyB =
            scene_light_3d.UnitFromByte(bakeSkyPicker.GetBlue());
        return scene_bake_3d.NormalizeSettings(state);
    }

    /// @brief Begin one chunked lightmap bake over the live scene.
    /// @details The shared-mesh preflight refuses first: the baker writes
    ///          chart UVs into mesh vertices, so shared meshes would
    ///          clobber each other (ADR 0188).
    expose func StartBake() -> Boolean {
        if scene == null or bakeActive { return false; }
        var staticMeshCount = 0;
        var staticScan = 0;
        while staticScan < flatNodes.count() {
            var staticNode = flatNodes.get(staticScan);
            if staticNode.GetStatic() and staticNode.Mesh != null {
                staticMeshCount = staticMeshCount + 1;
            }
            staticScan = staticScan + 1;
        }
        if staticMeshCount == 0 {
            bakeStatus.SetText(
                "Bake refused: no static mesh nodes. Mark bake "
                + "participants with the Static checkbox first.");
            return false;
        }
        var sharedNames =
            scene_bake_3d.SharedMeshNodeNames(AllLiveNodes());
        if sharedNames.count() > 0 {
            var listing = "";
            var index = 0;
            while index < sharedNames.count() and index < 8 {
                if listing != "" { listing = listing + ", "; }
                listing = listing + sharedNames.get(index);
                index = index + 1;
            }
            if sharedNames.count() > 8 {
                listing = listing + ", …";
            }
            bakeStatus.SetText(
                "Bake refused: " + sharedNames.count()
                + " node(s) share meshes (" + listing
                + "). Run Make Meshes Unique first.");
            detailLabel.SetText(
                "Baking writes chart UVs into mesh vertices, so shared "
                + "meshes would overwrite each other's charts.");
            return false;
        }
        var settings = BakeSettingsFromControls();
        var baker = LightBaker3D.New(scene);
        if baker == null {
            bakeStatus.SetText("The light baker could not be created.");
            return false;
        }
        baker.TexelsPerUnit = settings.texelsPerUnit;
        baker.Samples = settings.samples;
        baker.Bounces = settings.bounces;
        baker.SetSkyColor(settings.skyR, settings.skyG, settings.skyB);
        var lightCount = 0;
        var index = 0;
        while index < flatNodes.count() {
            var node = flatNodes.get(index);
            if node.Light != null {
                var worldLight = scene_bake_3d.WorldSpaceLight(
                    node, node.Light);
                if worldLight != null {
                    baker.AddLight(worldLight);
                    lightCount = lightCount + 1;
                }
            }
            index = index + 1;
        }
        activeBaker = baker;
        bakeActive = true;
        bakeButton.SetText("Cancel Bake");
        bakeStatus.SetText(
            "Baking with " + lightCount + " authored light(s)…");
        return true;
    }

    /// @brief Run bounded bake chunks inside the editor pump.
    /// @return True when a completed bake committed document content.
    hide func PumpBakeSteps() -> Boolean {
        if bakeActive == false or activeBaker == null { return false; }
        var startMs = Zanna.Time.Clock.NowMs();
        var complete = false;
        while complete == false
              and Zanna.Time.Clock.NowMs() - startMs < 8 {
            complete = activeBaker.BakeStep();
        }
        if complete { return FinishBake(); }
        var percent = Convert.NumToInt(activeBaker.Progress * 100.0);
        bakeStatus.SetText("Baking… " + percent + "%");
        return false;
    }

    /// @brief Apply and commit one completed bake as one transaction.
    hide func FinishBake() -> Boolean {
        var baker = activeBaker;
        bakeActive = false;
        activeBaker = null;
        bakeButton.SetText("Bake");
        if baker == null or scene == null { return false; }
        baker.Apply();
        if scene_bake_3d.WriteSettingsToRoot(
               scene.Root, BakeSettingsFromControls()) == false {
            RollBackFailedCommit(
                "The bake settings could not be persisted.");
            return false;
        }
        if CommitScene("Baked lightmaps") == false {
            RollBackFailedCommit(
                "The completed bake could not be committed.");
            return false;
        }
        lastCompletedBaker = baker;
        bakeStatus.SetText(
            "Bake applied: charts, atlas materials, and settings "
            + "committed as one undoable edit.");
        renderDirty = true;
        return true;
    }

    /// @brief Cancel an active bake and restore the exact prior document.
    expose func CancelBake() {
        if bakeActive == false { return; }
        bakeActive = false;
        activeBaker = null;
        bakeButton.SetText("Bake");
        if currentDoc != null { LoadDocumentModel(currentDoc, true); }
        bakeStatus.SetText(
            "Bake canceled; the document was restored exactly.");
    }

    /// @brief Report whether a chunked bake currently owns the scene.
    expose func IsBakeActive() -> Boolean {
        return bakeActive;
    }

    /// @brief Return every represented live node for preflight scans.
    hide func AllLiveNodes() -> List[SceneNode] {
        var nodes: List[SceneNode] = [];
        var index = 0;
        while index < flatNodes.count() {
            nodes.add(flatNodes.get(index));
            index = index + 1;
        }
        return nodes;
    }

    /// @brief Deep-copy shared meshes per node in one undoable edit.
    expose func MakeMeshesUniqueForBaking() -> Boolean {
        if scene == null or bakeActive { return false; }
        var seen: List[Mesh3D2] = [];
        var copies = 0;
        var index = 0;
        while index < flatNodes.count() {
            var node = flatNodes.get(index);
            var mesh = node.Mesh;
            if mesh != null {
                var priorUse = false;
                var scan = 0;
                while scan < seen.count() and priorUse == false {
                    if seen.get(scan) == mesh { priorUse = true; }
                    scan = scan + 1;
                }
                if priorUse {
                    var copy = mesh.Clone() as Mesh3D2;
                    if copy == null {
                        RestoreNodeComponentEdit(
                            selectedIndices, selectedIndex,
                            "A mesh copy failed. No nodes were changed.");
                        return false;
                    }
                    node.Mesh = copy;
                    copies = copies + 1;
                } else {
                    seen.add(mesh);
                }
            }
            index = index + 1;
        }
        if copies == 0 {
            bakeStatus.SetText(
                "Every baked node already owns a unique mesh.");
            return false;
        }
        if CommitScene(
               "Made " + copies + " shared mesh(es) unique for baking")
           == false {
            return false;
        }
        bakeStatus.SetText(
            copies + " shared mesh(es) deep-copied; baking can proceed.");
        return true;
    }

    /// @brief Write the probes.* convention onto the selected node.
    expose func ApplySelectedProbeGrid() -> Boolean {
        var node = SelectedNode();
        if node == null or scene == null { return false; }
        var state = new scene_bake_3d.ProbeGridState3D();
        state.minX = probeMinXSpinner.Value;
        state.minY = probeMinYSpinner.Value;
        state.minZ = probeMinZSpinner.Value;
        state.maxX = probeMaxXSpinner.Value;
        state.maxY = probeMaxYSpinner.Value;
        state.maxZ = probeMaxZSpinner.Value;
        state.spacing = probeSpacingSpinner.Value;
        if scene_bake_3d.WriteProbeGridToNode(node, state) == false {
            return false;
        }
        if CommitScene(
               "Authored probe grid on " + NodeDisplayName(node))
           == false {
            return false;
        }
        RefreshHierarchy(node);
        probeStatus.SetText(
            "Probe grid written as one undoable typed-metadata edit.");
        return true;
    }

    /// @brief Remove the probes.* convention from the selected node.
    expose func RemoveSelectedProbeGrid() -> Boolean {
        var node = SelectedNode();
        if node == null or scene == null { return false; }
        if scene_bake_3d.RemoveProbeGridFromNode(node) == false {
            probeStatus.SetText(
                "The selected node has no probe grid.");
            return false;
        }
        if CommitScene(
               "Removed probe grid from " + NodeDisplayName(node))
           == false {
            return false;
        }
        RefreshHierarchy(node);
        probeStatus.SetText("Probe grid removed.");
        return true;
    }

    /// @brief Bake the selected probe grid and save its .vlpg sidecar.
    /// @details The sidecar never dirties the scene document (ADR 0188).
    expose func BakeSelectedProbeGrid() -> Boolean {
        var node = SelectedNode();
        var state = scene_bake_3d.ProbeGridFromNode(node);
        if state.present == false {
            probeStatus.SetText(
                "Apply a probe grid to the selected node first.");
            return false;
        }
        if lastCompletedBaker == null {
            probeStatus.SetText(
                "Run a lightmap bake first; probes sample its result.");
            return false;
        }
        if currentDoc == null or currentDoc.filePath == "" {
            probeStatus.SetText(
                "Save the scene first so the .vlpg sidecar has a home.");
            return false;
        }
        var grid = LightProbeGrid3D.New(
            Vec3.New(state.minX, state.minY, state.minZ),
            Vec3.New(state.maxX, state.maxY, state.maxZ),
            state.spacing);
        if grid == null { return false; }
        grid.Bake(lastCompletedBaker);
        var sidecarPath = SceneSidecarPath(".vlpg");
        if grid.Save(sidecarPath) == false {
            probeStatus.SetText(
                "The probe sidecar could not be written: " + sidecarPath);
            return false;
        }
        probeStatus.SetText(
            "Baked " + grid.ProbeCount + " probes to "
            + Path.Name(sidecarPath)
            + "; the scene document is untouched.");
        return true;
    }

    /// @brief Sibling sidecar path derived from the document path.
    hide func SceneSidecarPath(extension: String) -> String {
        var base = currentDoc.filePath;
        var dot = Str.LastIndexOf(base, ".");
        if dot > 0 { base = Str.MidLen(base, 1, dot - 1); }
        return base + extension;
    }

    /// @brief Write the env.* convention to the root as one transaction.
    expose func ApplyEnvironmentFromControls() -> Boolean {
        if scene == null { return false; }
        var state = new scene_bake_3d.EnvironmentState3D();
        state.skyboxPath = Str.Trim(envSkyboxInput.get_Text());
        state.iblEnabled = envIblCheck.IsChecked();
        state.iblIntensity = envIblIntensitySpinner.Value;
        if scene_bake_3d.WriteEnvironmentToRoot(
               scene.Root, state) == false {
            return false;
        }
        if CommitScene("Updated scene environment") == false {
            return false;
        }
        renderDirty = true;
        detailLabel.SetText(
            "Environment written to the scene root; games consume it "
            + "through Canvas3D.SetSkybox/IblEnabled/IblIntensity.");
        return true;
    }

    /// @brief Apply the authored environment to one render canvas.
    /// @details Workspace-only presentation: the cubemap cache keys on the
    ///          resolved path and never touches canonical content.
    hide func ApplyEnvironmentToCanvas(canvas: Canvas3D) -> Boolean {
        if canvas == null or scene == null { return false; }
        var state = scene_bake_3d.EnvironmentFromRoot(scene.Root);
        canvas.IblEnabled = state.iblEnabled;
        canvas.IblIntensity = state.iblIntensity;
        if state.skyboxPath == "" {
            canvas.ClearSkybox();
            return false;
        }
        var resolved = state.skyboxPath;
        if currentDoc != null and currentDoc.filePath != ""
           and Path.IsAbsolute(resolved) == false {
            resolved = Path.Join(
                Path.Directory(currentDoc.filePath), resolved);
        }
        if resolved != envSkyboxCubemapPath {
            envSkyboxCubemapPath = resolved;
            envSkyboxCubemap = null;
            // A missing panorama is presentation-only: the reference stays
            // authored and the viewport simply skips the skybox.
            if File.Exists(resolved) {
                envSkyboxCubemap =
                    CubeMap3D.LoadHdrPanorama(resolved, 128.0)
                    as CubeMap3D;
            }
        }
        if envSkyboxCubemap != null {
            canvas.SetSkybox(envSkyboxCubemap);
            return true;
        } else {
            canvas.ClearSkybox();
        }
        return false;
    }

    /// @brief Return one stable cache key for the resolved project environment.
    hide func ProjectEnvironmentSignature(
        state: ScenePreview3DRenderState) -> String {
        if state == null { return "none"; }
        var flags = "";
        if state.hasSky { flags = flags + "S"; }
        if state.stars { flags = flags + "*"; }
        if state.hasSun { flags = flags + "K"; }
        if state.hasFill { flags = flags + "F"; }
        return flags
            + "|" + state.clearR + "|" + state.clearG + "|" + state.clearB
            + "|" + state.zenithR + "|" + state.zenithG
            + "|" + state.zenithB
            + "|" + state.groundR + "|" + state.groundG
            + "|" + state.groundB + "|" + state.cloudDensity
            + "|" + state.sunX + "|" + state.sunY + "|" + state.sunZ
            + "|" + state.sunR + "|" + state.sunG + "|" + state.sunB
            + "|" + state.sunIntensity
            + "|" + state.fillX + "|" + state.fillY + "|" + state.fillZ
            + "|" + state.fillR + "|" + state.fillG + "|" + state.fillB
            + "|" + state.fillIntensity;
    }

    /// @brief Cache bounded project sky/light resources until metadata changes.
    hide func EnsureProjectPreviewEnvironment(
        state: ScenePreview3DRenderState) {
        var signature = ProjectEnvironmentSignature(state);
        if signature == projectEnvironmentSignature { return; }
        projectEnvironmentSignature = signature;
        projectSkyCubemap = null;
        projectSunLight = null;
        projectFillLight = null;
        if state == null { return; }
        if state.hasSky {
            projectSkyCubemap = BuildProjectSkybox(state);
        }
        if state.hasSun and state.sunIntensity > 0.0
           and DirectionUsable(state.sunX, state.sunY, state.sunZ) {
            projectSunLight = Light3D.Directional(
                Vec3.New(state.sunX, state.sunY, state.sunZ),
                state.sunR * state.sunIntensity,
                state.sunG * state.sunIntensity,
                state.sunB * state.sunIntensity);
        }
        if state.hasFill and state.fillIntensity > 0.0
           and DirectionUsable(state.fillX, state.fillY, state.fillZ) {
            projectFillLight = Light3D.Directional(
                Vec3.New(state.fillX, state.fillY, state.fillZ),
                state.fillR * state.fillIntensity,
                state.fillG * state.fillIntensity,
                state.fillB * state.fillIntensity);
        }
    }

    /// @brief Return whether a directional-light vector is nondegenerate.
    hide func DirectionUsable(x: Number,
                              y: Number,
                              z: Number) -> Boolean {
        return x * x + y * y + z * z > 0.000001;
    }

    /// @brief Build one fixed-budget project sky from the resolved palette.
    hide func BuildProjectSkybox(
        state: ScenePreview3DRenderState) -> CubeMap3D {
        var positiveX = BuildProjectSkyFace(state, 0);
        var negativeX = BuildProjectSkyFace(state, 1);
        var positiveY = BuildProjectSkyFace(state, 2);
        var negativeY = BuildProjectSkyFace(state, 3);
        var positiveZ = BuildProjectSkyFace(state, 4);
        var negativeZ = BuildProjectSkyFace(state, 5);
        if positiveX == null or negativeX == null
           or positiveY == null or negativeY == null
           or positiveZ == null or negativeZ == null {
            return null;
        }
        return CubeMap3D.New(
            positiveX, negativeX, positiveY,
            negativeY, positiveZ, negativeZ);
    }

    /// @brief Rasterize one 32x32 cubemap face from direction-space colors.
    hide func BuildProjectSkyFace(
        state: ScenePreview3DRenderState,
        face: Integer) -> Pixels {
        var pixels =
            Pixels.New(PROJECT_SKY_FACE_SIZE, PROJECT_SKY_FACE_SIZE);
        if pixels == null { return null; }
        var y = 0;
        while y < PROJECT_SKY_FACE_SIZE {
            var x = 0;
            while x < PROJECT_SKY_FACE_SIZE {
                var u = ((x + 0.5)
                    / (PROJECT_SKY_FACE_SIZE / 1.0)) * 2.0 - 1.0;
                var v = ((y + 0.5)
                    / (PROJECT_SKY_FACE_SIZE / 1.0)) * 2.0 - 1.0;
                var directionX = 0.0;
                var directionY = 0.0;
                var directionZ = 0.0;
                if face == 0 {
                    directionX = 1.0;
                    directionY = 0.0 - v;
                    directionZ = 0.0 - u;
                } else if face == 1 {
                    directionX = -1.0;
                    directionY = 0.0 - v;
                    directionZ = u;
                } else if face == 2 {
                    directionX = u;
                    directionY = 1.0;
                    directionZ = v;
                } else if face == 3 {
                    directionX = u;
                    directionY = -1.0;
                    directionZ = 0.0 - v;
                } else if face == 4 {
                    directionX = u;
                    directionY = 0.0 - v;
                    directionZ = 1.0;
                } else {
                    directionX = 0.0 - u;
                    directionY = 0.0 - v;
                    directionZ = -1.0;
                }
                var length = Math.Sqrt(
                    directionX * directionX
                    + directionY * directionY
                    + directionZ * directionZ);
                if length < 0.000001 { length = 1.0; }
                Pixels.Set(
                    pixels,
                    x,
                    y,
                    ProjectSkyColor(
                        state,
                        directionX / length,
                        directionY / length,
                        directionZ / length));
                x = x + 1;
            }
            y = y + 1;
        }
        return pixels;
    }

    /// @brief Sample bounded analytic sky color for one world direction.
    hide func ProjectSkyColor(
        state: ScenePreview3DRenderState,
        directionX: Number,
        directionY: Number,
        directionZ: Number) -> Integer {
        var red = state.clearR;
        var green = state.clearG;
        var blue = state.clearB;
        if directionY < -0.02 {
            var down = ClampNumber3D(
                (0.0 - directionY) * 2.2, 0.0, 1.0);
            red = Lerp3D(state.clearR, state.groundR, down);
            green = Lerp3D(state.clearG, state.groundG, down);
            blue = Lerp3D(state.clearB, state.groundB, down);
            return PackPreviewColor(red, green, blue);
        }
        var up = Smoothstep3D(0.0, 0.55, directionY);
        red = Lerp3D(state.clearR, state.zenithR, up);
        green = Lerp3D(state.clearG, state.zenithG, up);
        blue = Lerp3D(state.clearB, state.zenithB, up);
        var haze = ClampNumber3D(
            1.0 - AbsNumber3D(directionY) * 2.4, 0.0, 1.0);
        haze = haze * haze * 0.22;
        red = red + haze * state.clearR;
        green = green + haze * state.clearG;
        blue = blue + haze * state.clearB;

        if state.hasSun and state.sunIntensity > 0.0
           and DirectionUsable(state.sunX, state.sunY, state.sunZ) {
            var sunLength = Math.Sqrt(
                state.sunX * state.sunX
                + state.sunY * state.sunY
                + state.sunZ * state.sunZ);
            var sunDot =
                (directionX * (0.0 - state.sunX)
                 + directionY * (0.0 - state.sunY)
                 + directionZ * (0.0 - state.sunZ))
                / sunLength;
            if sunDot > 0.0 {
                var glow = sunDot * sunDot;
                glow = glow * glow * glow;
                red = red + glow * 0.9 * state.sunR;
                green = green + glow * 0.9 * state.sunG;
                blue = blue + glow * 0.9 * state.sunB;
            }
        }
        if state.cloudDensity > 0.0 {
            var band = ClampNumber3D(
                1.0 - AbsNumber3D(directionY) * 1.4, 0.0, 1.0);
            var noise =
                Math.Sin(directionX * 7.0 + directionZ * 5.0) * 0.5
                + Math.Sin(
                    directionX * 13.0 - directionZ * 11.0
                    + directionY * 6.0) * 0.3
                + Math.Cos(
                    directionZ * 17.0 + directionX * 3.0) * 0.2;
            var cloud = Smoothstep3D(
                0.55 - state.cloudDensity * 0.35,
                0.9,
                (noise + 1.0) * 0.5)
                * band * state.cloudDensity;
            red = Lerp3D(red, red * 0.4 + 0.55, cloud);
            green = Lerp3D(green, green * 0.4 + 0.55, cloud);
            blue = Lerp3D(blue, blue * 0.4 + 0.58, cloud);
        }
        if state.stars and directionY > 0.05 {
            var hashX = Convert.NumToInt(
                Math.Round((directionX + 1.0) * 271.0));
            var hashY = Convert.NumToInt(
                Math.Round((directionY + 1.0) * 197.0));
            var hashZ = Convert.NumToInt(
                Math.Round((directionZ + 1.0) * 353.0));
            var hash =
                (hashX * 73856093
                 + hashZ * 19349663
                 + hashY * 83492791) % 100000;
            if hash < 0 { hash = 0 - hash; }
            if hash > 99720 {
                var magnitude = (hash - 99720) / 280.0;
                red = red + 0.55 * magnitude;
                green = green + 0.60 * magnitude;
                blue = blue + 0.70 * magnitude;
            }
        }
        return PackPreviewColor(red, green, blue);
    }

    /// @brief Linear interpolation without introducing a math dependency.
    hide func Lerp3D(a: Number,
                     b: Number,
                     amount: Number) -> Number {
        return a + (b - a) * amount;
    }

    /// @brief Bounded cubic easing for palette and cloud transitions.
    hide func Smoothstep3D(minimum: Number,
                           maximum: Number,
                           value: Number) -> Number {
        if maximum <= minimum {
            if value < minimum { return 0.0; }
            return 1.0;
        }
        var t = ClampNumber3D(
            (value - minimum) / (maximum - minimum), 0.0, 1.0);
        return t * t * (3.0 - 2.0 * t);
    }

    /// @brief Return one scalar's magnitude.
    hide func AbsNumber3D(value: Number) -> Number {
        if value < 0.0 { return 0.0 - value; }
        return value;
    }

    /// @brief Pack normalized preview color into RGBA8 for CubeMap3D.
    hide func PackPreviewColor(red: Number,
                               green: Number,
                               blue: Number) -> Integer {
        var r = Convert.NumToInt(Math.Round(
            ClampNumber3D(red, 0.0, 1.0) * 255.0));
        var g = Convert.NumToInt(Math.Round(
            ClampNumber3D(green, 0.0, 1.0) * 255.0));
        var b = Convert.NumToInt(Math.Round(
            ClampNumber3D(blue, 0.0, 1.0) * 255.0));
        return (((r * 256) + g) * 256 + b) * 256 + 255;
    }

    /// @brief Apply resolved profile atmosphere without canonical mutation.
    hide func ApplyProjectPreviewEnvironment(
        canvas: Canvas3D,
        state: ScenePreview3DRenderState,
        authoredSkyPresent: Boolean,
        assist: Boolean) {
        if canvas == null or state == null { return; }
        EnsureProjectPreviewEnvironment(state);
        if authoredSkyPresent == false {
            if projectSkyCubemap != null {
                canvas.SetSkybox(projectSkyCubemap);
            } else {
                canvas.ClearSkybox();
            }
        }
        if state.hasIblIntensity
           and (authoredSkyPresent or projectSkyCubemap != null) {
            canvas.IblEnabled = state.iblIntensity > 0.0;
            canvas.IblIntensity = state.iblIntensity;
        }
        if projectSunLight != null or projectFillLight != null {
            canvas.ClearLights();
            var slot = 0;
            if projectSunLight != null {
                canvas.SetLight(slot, projectSunLight);
                slot = slot + 1;
            }
            if projectFillLight != null {
                canvas.SetLight(slot, projectFillLight);
            }
        } else {
            canvas.SetDefaultLighting();
        }
        if state.hasAmbient {
            canvas.SetAmbient(
                state.ambientR,
                state.ambientG,
                state.ambientB);
        } else if assist {
            canvas.SetAmbient(0.55, 0.55, 0.58);
        } else {
            canvas.SetAmbient(0.05, 0.05, 0.06);
        }
        if state.hasFog {
            canvas.SetFog(
                state.fogNear,
                state.fogFar,
                state.fogR,
                state.fogG,
                state.fogB);
        } else {
            canvas.ClearFog();
        }
        if state.hasHeightFog and state.heightFogEnabled {
            canvas.SetHeightFog(
                state.heightFogBase,
                state.heightFogFalloff,
                state.heightFogDensity,
                state.heightFogOpacity);
        } else {
            canvas.ClearHeightFog();
        }
        if state.hasClear {
            canvas.Clear(
                state.clearR,
                state.clearG,
                state.clearB);
        } else {
            canvas.Clear(
                VIEWPORT_CLEAR_RED,
                VIEWPORT_CLEAR_GREEN,
                VIEWPORT_CLEAR_BLUE);
        }
    }

    /// @brief Pump the material library group (ADR 0189).
    hide func PumpMaterialLibraryControls() {
        if materialLibraryGroup == null { return; }
        var rootPath = ComponentSchemaRoot();
        if rootPath != materialLibraryRoot {
            materialLibraryRoot = rootPath;
            ReloadMaterialLibrary();
        }
        // Bounded external polling: reload when the on-disk bytes drift.
        materialLibraryPollMs = materialLibraryPollMs + 1;
        if materialLibrary != null and materialLibrary.found
           and materialLibraryPollMs >= 120 {
            materialLibraryPollMs = 0;
            var current = safe_io.ReadAllTextBounded(
                materialLibrary.sourcePath,
                material_library_3d.MAX_MATERIAL_LIBRARY_BYTES);
            if current.ok and current.text != materialLibrary.diskText {
                ReloadMaterialLibrary();
                materialLibraryStatus.SetText(
                    "materials.scene3d changed on disk; the list was "
                    + "reloaded.");
            }
        }
        if materialLibraryReloadButton.WasClicked() {
            ReloadMaterialLibrary();
        }
        if materialLibraryNameInput.WasChanged() {
            materialLibraryOverwriteArmed = false;
            UpdateMaterialLibraryControls();
        }
        if materialLibrarySaveButton.WasClicked()
           and selectedIndices.count() == 1 {
            SaveSelectedMaterialToLibrary();
        }
        if materialLibraryApplyButton.WasClicked()
           and selectedIndices.count() > 0 {
            ApplyLibraryMaterialToSelection();
        }
        if materialLibraryList.WasSelectionChanged() {
            materialLibraryOverwriteArmed = false;
            UpdateMaterialLibraryControls();
            var dragName = "";
            if materialLibrary != null and materialLibrary.valid
               and materialLibraryList.SelectedIndex >= 0
               and materialLibraryList.SelectedIndex
                   < materialLibrary.entries.count() {
                dragName = materialLibrary.entries.get(
                    materialLibraryList.SelectedIndex).name;
            }
            materialLibraryList.SetDragData("zanna/material", dragName);
            RefreshMaterialSwatch();
        }
    }

    /// @brief Reload materials.scene3d for the owning workspace root.
    expose func ReloadMaterialLibrary() {
        materialLibraryOverwriteArmed = false;
        var libraryPath =
            material_library_3d.PathForRoot(materialLibraryRoot);
        if libraryPath == "" {
            materialLibrary = null;
            materialLibraryList.Clear();
            materialLibraryStatus.SetText(
                "Open a workspace folder to use materials.scene3d.");
            UpdateMaterialLibraryControls();
            return;
        }
        materialLibrary = material_library_3d.LoadPath(libraryPath);
        materialLibraryList.Clear();
        if materialLibrary.valid == false {
            materialLibraryStatus.SetText(
                "materials.scene3d is invalid: " + materialLibrary.error);
        } else if materialLibrary.found == false {
            materialLibraryStatus.SetText(
                "No materials.scene3d yet; Save to Library creates it.");
        } else {
            var index = 0;
            while index < materialLibrary.entries.count() {
                var entry = materialLibrary.entries.get(index);
                var maps = scene_material_3d.RetainedMapCount(
                    entry.material);
                var summary = entry.name;
                if maps == 1 { summary = summary + "  •  1 map"; }
                else if maps > 1 {
                    summary = summary + "  •  " + maps + " maps";
                }
                materialLibraryList.AddItem(summary);
                index = index + 1;
            }
            materialLibraryStatus.SetText(
                materialLibrary.entries.count()
                + " library material(s) in materials.scene3d.");
        }
        UpdateMaterialLibraryControls();
    }

    /// @brief Keep library actions truthful for selection and validity.
    hide func UpdateMaterialLibraryControls() {
        if materialLibraryGroup == null { return; }
        var usable = materialLibrary != null
            and materialLibrary.valid;
        var hasSingle = scene != null
            and selectedIndices.count() == 1
            and SelectedNode() != null
            and SelectedNode().Material != null;
        materialLibraryGroup.SetEnabled(scene != null);
        materialLibrarySaveButton.SetEnabled(
            usable and hasSingle
            and material_library_3d.NameIsValid(
                    materialLibraryNameInput.get_Text()));
        materialLibraryApplyButton.SetEnabled(
            usable and materialLibrary.found
            and scene != null and selectedIndices.count() > 0
            and materialLibraryList.SelectedIndex >= 0);
        if materialLibraryOverwriteArmed {
            materialLibrarySaveButton.SetText("Confirm Overwrite");
        } else {
            materialLibrarySaveButton.SetText("Save to Library");
        }
    }

    /// @brief Stage and persist the selected node's material by name.
    /// @details Overwriting an existing name requires a second explicit
    ///          click; writes are atomic and conflict-guarded and never
    ///          touch scene content or history.
    expose func SaveSelectedMaterialToLibrary() -> Boolean {
        var node = SelectedNode();
        if materialLibrary == null or materialLibrary.valid == false
           or node == null or node.Material == null {
            return false;
        }
        var name = Str.Trim(materialLibraryNameInput.get_Text());
        if material_library_3d.NameIsValid(name) == false {
            materialLibraryStatus.SetText(
                "Library names need 1-64 characters.");
            return false;
        }
        var existing = materialLibrary.EntryNamed(name);
        if existing != null and materialLibraryOverwriteArmed == false {
            materialLibraryOverwriteArmed = true;
            UpdateMaterialLibraryControls();
            materialLibraryStatus.SetText(
                "\"" + name + "\" already exists. Click Confirm "
                + "Overwrite to replace it.");
            return false;
        }
        materialLibraryOverwriteArmed = false;
        var staged =
            Material3D.Clone(node.Material) as Material3D;
        if staged == null {
            materialLibraryStatus.SetText(
                "The material could not be cloned for the library.");
            return false;
        }
        var nextEntries:
            List[material_library_3d.MaterialLibraryEntry3D] = [];
        var index = 0;
        while index < materialLibrary.entries.count() {
            var entry = materialLibrary.entries.get(index);
            if Str.ToLower(entry.name) != Str.ToLower(name) {
                nextEntries.add(entry);
            }
            index = index + 1;
        }
        var nextEntry =
            new material_library_3d.MaterialLibraryEntry3D();
        nextEntry.name = name;
        nextEntry.material = staged;
        nextEntries.add(nextEntry);
        if material_library_3d.SaveEntries(
               materialLibrary, nextEntries) == false {
            materialLibraryStatus.SetText(materialLibrary.error);
            return false;
        }
        ReloadMaterialLibrary();
        materialLibraryStatus.SetText(
            "Saved \"" + name + "\" to materials.scene3d.");
        return true;
    }

    /// @brief Clone the chosen library material onto the selection.
    /// @details Per-node independent clones through one canonical history
    ///          entry; unselected users of shared materials are untouched
    ///          and the scene never references the library file.
    /// @brief Reconcile best-effort labels with the snapshot stacks.
    /// @details Trims and wholesale stack replacements (budget trims,
    ///          workspace restores) can outpace the label lists; front-pad
    ///          or front-drop so counts always match before presenting.
    hide func SyncHistoryLabels() {
        while undoLabels.count() > undoStack.count() {
            undoLabels.removeAt(0);
        }
        while undoLabels.count() < undoStack.count() {
            undoLabels.add("Edit");
            var last = undoLabels.count() - 1;
            var moved = undoLabels.get(last);
            undoLabels.removeAt(last);
            var rebuilt: List[String] = [];
            rebuilt.add(moved);
            var index = 0;
            while index < undoLabels.count() {
                rebuilt.add(undoLabels.get(index));
                index = index + 1;
            }
            undoLabels = rebuilt;
        }
        while redoLabels.count() > redoStack.count() {
            redoLabels.removeAt(0);
        }
        while redoLabels.count() < redoStack.count() {
            redoLabels.add("Edit");
        }
    }

    /// @brief Rebuild the History rows: undone-past oldest first + Current.
    expose func RefreshHistoryPanel() {
        if historyList == null { return; }
        SyncHistoryLabels();
        historyListRefreshing = true;
        historyList.Clear();
        var index = 0;
        while index < undoLabels.count() {
            historyList.AddItem((index + 1) + ". " + undoLabels.get(index));
            index = index + 1;
        }
        historyList.AddItem("● Current");
        historyList.SelectIndex(undoLabels.count());
        // Programmatic selection raises the same edge a user click would;
        // drain it so the next pump cannot mistake it for a jump request.
        historyList.WasSelectionChanged();
        historyListRefreshing = false;
    }

    /// @brief Jump to the state before one history row's edit.
    /// @details Row k (0-based, oldest first) restores the snapshot taken
    ///          before that edit by running the equivalent chain of Undo
    ///          calls; the Current row is a no-op. Redo stays available.
    expose func JumpToHistoryRow(row: Integer) -> Boolean {
        SyncHistoryLabels();
        if row < 0 or row >= undoStack.count() { return false; }
        var undos = undoStack.count() - row;
        var step = 0;
        while step < undos {
            if Undo() == false { return false; }
            step = step + 1;
        }
        toolbarStatus.SetText("Jumped back " + undos + " edit(s)");
        return true;
    }

    /// @brief Route history row clicks into jumps.
    hide func PumpHistoryPanel() {
        if historyList == null or historyListRefreshing { return; }
        if historyList.WasSelectionChanged() == false { return; }
        var row = historyList.SelectedIndex;
        SyncHistoryLabels();
        if row >= 0 and row < undoStack.count() {
            JumpToHistoryRow(row);
        }
        RefreshHistoryPanel();
    }

    /// @brief Render the selected library material as a lit sphere swatch.
    /// @details Deterministic software offscreen render, cached by entry
    ///          name so reselecting the same entry re-renders nothing.
    ///          Workspace-only presentation; never touches canonical bytes.
    expose func RefreshMaterialSwatch() {
        if materialSwatchImage == null or materialLibrary == null {
            return;
        }
        var selected = materialLibraryList.SelectedIndex;
        if selected < 0 or selected >= materialLibrary.entries.count() {
            materialSwatchImage.SetVisible(false);
            materialSwatchName = "";
            return;
        }
        var entry = materialLibrary.entries.get(selected);
        if entry == null or entry.material == null {
            materialSwatchImage.SetVisible(false);
            materialSwatchName = "";
            return;
        }
        if entry.name == materialSwatchName
           and materialSwatchImage.IsVisible() {
            return;
        }
        var target = RenderTarget3D.New(48, 48);
        if target == null { return; }
        var canvas = Canvas3D.NewOffscreen(target);
        if canvas == null { return; }
        canvas.SetDefaultLighting();
        canvas.SetAmbient(0.35, 0.35, 0.38);
        var camera = Camera3D.New(45.0, 1.0, 0.1, 10.0);
        if camera == null { return; }
        camera.LookAt(
            Vec3.New(0.0, 0.0, 2.4),
            Vec3.New(0.0, 0.0, 0.0),
            Vec3.New(0.0, 1.0, 0.0));
        var swatchScene = SceneGraph.New();
        var sphere = SceneNode.New();
        sphere.Name = "swatch";
        sphere.Mesh = Mesh3D.Sphere(0.9, 24);
        sphere.Material = entry.material;
        swatchScene.Add(sphere);
        canvas.Clear(0.14, 0.15, 0.18);
        swatchScene.Draw(canvas, camera);
        var rendered = target.AsPixels() as Pixels;
        if rendered == null { return; }
        materialSwatchImage.SetPixels(rendered, 48, 48);
        materialSwatchImage.SetVisible(true);
        materialSwatchName = entry.name;
    }

    expose func ApplyLibraryMaterialToSelection() -> Boolean {
        if materialLibrary == null or materialLibrary.valid == false
           or scene == null {
            return false;
        }
        var listIndex = materialLibraryList.SelectedIndex;
        if listIndex < 0
           or listIndex >= materialLibrary.entries.count() {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var source = materialLibrary.entries.get(listIndex).material;
        var staged: List[Material3D] = [];
        var index = 0;
        while index < selectedIndices.count() {
            var clone = Material3D.Clone(source) as Material3D;
            if clone == null {
                materialLibraryStatus.SetText(
                    "Studio could not clone the library material. "
                    + "No selected nodes were changed.");
                return false;
            }
            staged.add(clone);
            index = index + 1;
        }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        index = 0;
        while index < selectedIndices.count() {
            flatNodes.get(selectedIndices.get(index)).Material =
                staged.get(index);
            index = index + 1;
        }
        if CommitScene(
               "Applied library material \""
               + materialLibrary.entries.get(listIndex).name
               + "\" to " + selectedIndices.count()
               + " node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The library material could not be committed.");
            return false;
        }
        RefreshMaterialFields(SelectedNode());
        renderDirty = true;
        materialLibraryStatus.SetText(
            "Applied \""
            + materialLibrary.entries.get(listIndex).name
            + "\" as independent per-node copies.");
        return true;
    }

    /// @brief Validate the look-through node still exists with a camera.
    hide func ActiveLookThroughNode() -> SceneNode {
        if lookThroughNode == null { return null; }
        if FindFlatIndex(lookThroughNode) < 0
           or lookThroughNode.Camera == null {
            lookThroughNode = null;
            return null;
        }
        return lookThroughNode;
    }

    /// @brief Normalize one vector or fall back to a stable default axis.
    hide func NormalizedVectorOr(vector: Vec3,
                                 fallbackX: Number,
                                 fallbackY: Number,
                                 fallbackZ: Number) -> Vec3 {
        if vector == null {
            return Vec3.New(fallbackX, fallbackY, fallbackZ);
        }
        var length = Math.Sqrt(
            vector.X * vector.X
            + vector.Y * vector.Y
            + vector.Z * vector.Z);
        if length <= 0.000001 {
            return Vec3.New(fallbackX, fallbackY, fallbackZ);
        }
        return Vec3.New(
            vector.X / length, vector.Y / length, vector.Z / length);
    }

    /// @brief Configure one retained camera from an authored camera node.
    /// @details Pose derives from the node world transform (camera looks
    ///          along its node's -Z, up +Y) and projection from the authored
    ///          fields; the authored Camera3D object is never mutated.
    hide func ApplyAuthoredCameraPose(target: Camera3D,
                                      node: SceneNode) {
        if target == null or node == null or node.Camera == null { return; }
        var state = scene_camera_3d.FromCamera(node.Camera);
        target.IsOrtho = state.isOrtho;
        if state.isOrtho {
            target.OrthoSize = state.orthoSize;
        } else {
            target.Fov = state.fovDegrees;
        }
        target.NearPlane = state.nearPlane;
        target.FarPlane = state.farPlane;
        var world = node.WorldMatrix;
        var eye = node.WorldPosition;
        var forward = NormalizedVectorOr(
            Mat4.TransformVector(
                world, Vec3.New(0.0, 0.0, -1.0)) as Vec3,
            0.0, 0.0, -1.0);
        var up = NormalizedVectorOr(
            Mat4.TransformVector(
                world, Vec3.New(0.0, 1.0, 0.0)) as Vec3,
            0.0, 1.0, 0.0);
        var alignment = forward.X * up.X
            + forward.Y * up.Y
            + forward.Z * up.Z;
        if alignment > 0.999 or alignment < -0.999 {
            up = Vec3.New(0.0, 0.0, 1.0);
        }
        target.LookAt(
            Vec3.New(eye.X, eye.Y, eye.Z),
            Vec3.New(
                eye.X + forward.X,
                eye.Y + forward.Y,
                eye.Z + forward.Z),
            up);
    }

    /// @brief Apply one copy-on-edit PBR material component transaction.
    /// @details Existing material state is cloned before visible fields change,
    ///          preserving shared siblings and unexposed texture/custom slots.
    expose func ApplyNodeMaterial(nodeIndex: Integer,
                                  red: Number,
                                  green: Number,
                                  blue: Number,
                                  alpha: Number,
                                  metallic: Number,
                                  roughness: Number,
                                  ambientOcclusion: Number,
                                  alphaMode: Integer,
                                  doubleSided: Boolean,
                                  unlit: Boolean) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var current = node.Material;
        if scene_material_3d.Matches(
               current, red, green, blue, alpha, metallic, roughness,
               ambientOcclusion, alphaMode, doubleSided, unlit) {
            return false;
        }
        var next = scene_material_3d.MakeUnique(
            current, red, green, blue, alpha, metallic, roughness,
            ambientOcclusion, alphaMode, doubleSided, unlit);
        if next == null {
            toolbarStatus.SetText("Material edit failed");
            detailLabel.SetText(
                "Studio could not allocate a node-local material copy.");
            GUI.Toast.Error("3D material edit failed");
            return false;
        }
        node.Material = next;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene("Updated material on " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshMaterialFields(node);
        return true;
    }

    /// @brief Apply one sparse PBR patch to the complete node selection.
    /// @details Materials are cloned before any live node changes. Selected
    ///          nodes that share one source material reuse one patched clone,
    ///          while unselected users retain the original. Any allocation or
    ///          serialization failure restores canonical bytes and selection.
    expose func ApplySelectedMaterialPatch(
        patch: scene_material_3d.MaterialPatch3D) -> Boolean {
        if scene == null or patch == null or patch.HasFields() == false {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }

        var currentMaterials: List[Material3D] = [];
        var nextMaterials: List[Material3D] = [];
        var changedCount = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node =
                flatNodes.get(selectedIndices.get(selectionIndex));
            var current = node.Material;
            currentMaterials.add(current);
            if scene_material_3d.MatchesPatch(current, patch) {
                nextMaterials.add(current);
            } else {
                var next: Material3D = null;
                var prior = 0;
                while prior < currentMaterials.count() - 1
                      and next == null {
                    if currentMaterials.get(prior) == current
                       and nextMaterials.get(prior) != current {
                        next = nextMaterials.get(prior);
                    }
                    prior = prior + 1;
                }
                if next == null {
                    next = scene_material_3d.ApplyPatchUnique(
                        current, patch);
                }
                if next == null {
                    toolbarStatus.SetText("Material batch failed");
                    detailLabel.SetText(
                        "Studio could not allocate every material copy. "
                        + "No selected nodes were changed.");
                    GUI.Toast.Error("3D material batch failed");
                    return false;
                }
                nextMaterials.add(next);
                changedCount = changedCount + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if changedCount == 0 { return false; }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex)).Material =
                nextMaterials.get(selectionIndex);
            selectionIndex = selectionIndex + 1;
        }
        if CommitScene(
               "Updated material fields on " + changedCount
               + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The material batch could not be committed.");
            return false;
        }
        RefreshMaterialFields(SelectedNode());
        UpdateMaterialControls(true);
        detailLabel.SetText(
            "Material fields updated on " + changedCount
            + " selected node(s); unresolved mixed fields were preserved.");
        renderDirty = true;
        return true;
    }

    /// @brief Remove one selected material component as a history transaction.
    expose func RemoveNodeMaterial(nodeIndex: Integer) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count() {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if node.Material == null { return false; }
        node.Material = null;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        if CommitScene("Removed material from " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshMaterialFields(node);
        return true;
    }

    /// @brief Remove materials from every selected node in one transaction.
    expose func RemoveSelectedMaterials() -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var materialCount = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            if flatNodes.get(
                   selectedIndices.get(selectionIndex)).Material != null {
                materialCount = materialCount + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if materialCount == 0 { return false; }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex)).Material = null;
            selectionIndex = selectionIndex + 1;
        }
        if CommitScene(
               "Removed material from " + materialCount
               + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The material removal batch could not be committed.");
            return false;
        }
        RefreshMaterialFields(SelectedNode());
        UpdateMaterialControls(true);
        detailLabel.SetText(
            "Removed " + materialCount
            + " material component(s) in one scene edit.");
        renderDirty = true;
        return true;
    }

    /// @brief Load and embed one texture map as a node-local material edit.
    expose func ApplyMaterialMapPath(nodeIndex: Integer,
                                     slot: Integer,
                                     path: String) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count()
           or scene_material_3d.IsMapSlot(slot) == false
           or Str.Trim(path) == "" {
            return false;
        }
        var texture = LoadMaterialMapPath(path);
        if texture == null { return false; }
        return AssignMaterialMap(nodeIndex, slot, texture);
    }

    /// @brief Load one map once and assign it across the current selection.
    expose func ApplySelectedMaterialMapPath(slot: Integer,
                                             path: String) -> Boolean {
        if scene == null
           or scene_material_3d.IsMapSlot(slot) == false
           or Str.Trim(path) == "" {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var texture = LoadMaterialMapPath(path);
        if texture == null { return false; }
        return AssignSelectedMaterialMap(slot, texture);
    }

    /// @brief Decode one bounded material map with actionable diagnostics.
    hide func LoadMaterialMapPath(path: String) -> Any {
        var sourceBytes = safe_io.SizeBytes(path);
        if sourceBytes < 0 or sourceBytes > MAX_TEXTURE_SOURCE_BYTES {
            toolbarStatus.SetText("Texture map not loaded");
            detailLabel.SetText(
                "Choose a readable texture no larger than 16 MB.");
            GUI.Toast.Error("3D texture map could not be read");
            return null;
        }
        var texture = scene_material_3d.LoadTexturePath(path);
        if texture == null {
            toolbarStatus.SetText("Texture map not loaded");
            detailLabel.SetText(
                "Studio could not decode " + Path.Name(path)
                + ". Use PNG, JPEG, BMP, GIF, or a valid KTX2 asset; "
                + "raster maps may contain at most 16,777,216 pixels.");
            GUI.Toast.Error("Unsupported or invalid 3D texture map");
            return null;
        }
        return texture;
    }

    /// @brief Clear one editable map slot as a single history transaction.
    expose func ClearMaterialMap(nodeIndex: Integer,
                                 slot: Integer) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count()
           or scene_material_3d.IsMapSlot(slot) == false {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        if scene_material_3d.HasMap(node.Material, slot) == false {
            return false;
        }
        return AssignMaterialMap(nodeIndex, slot, null);
    }

    /// @brief Clear one map slot everywhere it is present in the selection.
    expose func ClearSelectedMaterialMap(slot: Integer) -> Boolean {
        if scene == null
           or scene_material_3d.IsMapSlot(slot) == false {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var index = 0;
        while index < selectedIndices.count() {
            var material =
                flatNodes.get(selectedIndices.get(index)).Material;
            if scene_material_3d.HasMap(material, slot) {
                return AssignSelectedMaterialMap(slot, null);
            }
            index = index + 1;
        }
        return false;
    }

    /// @brief Import one supported asset path into the active VSCN document.
    expose func ImportAssetPath(path: String) -> Boolean {
        if path == "" or currentDoc == null { return false; }
        var imported = SceneAsset.LoadResult(path);
        if imported == null or imported.IsOk == false {
            var message = "Unsupported or invalid 3D asset";
            if imported != null { message = imported.UnwrapErrStr(); }
            detailLabel.SetText("3D import failed:\n" + message);
            toolbarStatus.SetText("Import failed");
            GUI.Toast.Error("3D import failed: " + message);
            return false;
        }
        var asset = imported.Unwrap() as SceneAsset;
        var importedScene = asset.InstantiateScene() as SceneGraph;
        if importedScene == null {
            detailLabel.SetText("3D import failed: the asset has no scene hierarchy.");
            toolbarStatus.SetText("Import failed");
            GUI.Toast.Error("3D import failed: no scene hierarchy");
            return false;
        }

        var importedCount = importedScene.NodeCount - 1;
        var firstImported: SceneNode = null;
        if importedCount > 0 {
            firstImported = importedScene.Root.GetChild(0);
        }
        if scene == null {
            scene = importedScene;
        } else if importedCount > 0 {
            var importedRoot = importedScene.Root;
            while importedRoot.ChildCount > 0 {
                var importedNode = importedRoot.GetChild(0);
                importedRoot.RemoveChild(importedNode);
                if scene.TryAdd(importedNode) == false {
                    var failedDoc = currentDoc;
                    if failedDoc != null { LoadDocumentModel(failedDoc, true); }
                    detailLabel.SetText(
                        "3D import failed while merging the asset hierarchy. "
                        + "The document was restored.");
                    toolbarStatus.SetText("Import rolled back");
                    GUI.Toast.Error("3D asset merge failed");
                    return false;
                }
            }
        }
        loadError = "";
        selectedIndex = -1;
        selectedIndices = [];
        SetEditorControlsEnabled(true);
        if importedCount == 0 and scene != importedScene {
            detailLabel.SetText("The selected asset contains no scene nodes.");
            toolbarStatus.SetText("Nothing to import");
            return false;
        }
        RefreshHierarchy(firstImported);
        FrameAll();
        return CommitScene(
            "Imported " + importedCount + " node(s) from " + Path.Name(path));
    }

    /// @brief Build one bounded snap-increment spinner in the options row.
    expose func AddSnapSpinner(minimum: Number,
                             maximum: Number,
                             step: Number,
                             value: Number,
                             accessibleName: String) -> GUI.Spinner {
        var spinner = GUI.Spinner.New(viewOptionsRow);
        spinner.SetRange(minimum, maximum);
        spinner.SetStep(step);
        spinner.SetDecimals(3);
        spinner.SetValue(value);
        spinner.SetPreferredSize(72.0, 0.0);
        spinner.SetAccessibleName(accessibleName);
        return spinner;
    }

    expose func AddTransformSpinner(parent: GUI.HBox,
                                  label: String,
                                  value: Number) -> GUI.Spinner {
        GUI.Label.New(parent, label);
        var spinner = GUI.Spinner.New(parent);
        spinner.SetRange(-1000000.0, 1000000.0);
        spinner.SetStep(0.1);
        spinner.SetDecimals(3);
        spinner.SetValue(value);
        spinner.SetPreferredSize(72.0, 0.0);
        // Flex lets the X/Y/Z triplet share the inspector width instead of
        // overflowing the pane when the inspector is narrow.
        spinner.SetFlex(1.0);
        return spinner;
    }

    expose func AddRotationSpinner(parent: GUI.HBox,
                                 label: String) -> GUI.Spinner {
        GUI.Label.New(parent, label);
        var spinner = GUI.Spinner.New(parent);
        spinner.SetRange(-36000.0, 36000.0);
        spinner.SetStep(1.0);
        spinner.SetDecimals(2);
        spinner.SetValue(0.0);
        spinner.SetPreferredSize(76.0, 0.0);
        spinner.SetFlex(1.0);
        return spinner;
    }

    hide func LoadGraphFromContent(content: String) -> SceneGraph {
        // ADR 0190: load the canonical text directly. The document path names
        // the base directory for relative prefab references (ADR 0187), so no
        // staged sibling file is needed; untitled documents accept that
        // relative references cannot resolve until their first save.
        var virtualPath = "untitled.scene3d";
        if currentDoc != null and currentDoc.filePath != "" {
            virtualPath = currentDoc.filePath;
        }
        var loaded = SceneAsset.LoadTextResult(virtualPath, content);
        if loaded == null or loaded.IsOk == false {
            loadError = "Invalid or unsupported VSCN data.";
            if loaded != null { loadError = loaded.UnwrapErrStr(); }
            return null;
        }
        var asset = loaded.Unwrap() as SceneAsset;
        var graph = asset.InstantiateScene() as SceneGraph;
        if graph == null {
            loadError = "The VSCN asset contains no instantiable scene.";
        }
        return graph;
    }

    hide func ImportAsset() -> Boolean {
        var baseDir = "";
        if currentDoc != null and currentDoc.filePath != "" {
            baseDir = Path.Directory(currentDoc.filePath);
        }
        var path = GUI.FileDialog.Open(
            "Import 3D Asset", baseDir, "*.vscn;*.gltf;*.glb;*.fbx;*.obj;*.stl");
        if path == "" { return false; }
        return ImportAssetPath(path);
    }

    hide func CommitScene(message: String) -> Boolean {
        if scene == null or currentDoc == null { return false; }
        if bakeActive {
            detailLabel.SetText(
                "A lightmap bake is running; cancel it before editing "
                + "the scene.");
            return false;
        }
        // ADR 0190: serialize entirely in memory — no staged temp file, no
        // disk IO, and no sibling-directory churn per accepted edit.
        var text = scene.SaveToText();
        if text == "" {
            RollBackFailedCommit("The 3D scene could not be serialized.");
            return false;
        }
        if Str.get_Length(text) > MAX_SCENE_BYTES {
            RollBackFailedCommit(
                "The serialized 3D scene exceeded Studio's 64 MB editing limit.");
            return false;
        }
        if text == currentSerialized { return false; }
        PushHistory(undoStack, currentSerialized);
        undoLabels.add(message);
        redoStack = [];
        redoLabels = [];
        currentSerialized = text;
        currentDoc.content = text;
        currentDoc.isModified = currentSerialized != cleanSerialized;
        revision = revision + 1;
        renderDirty = true;
        toolbarStatus.SetText(message);
        detailLabel.SetText("");
        return true;
    }

    /// @brief Append one bounded canonical VSCN history snapshot.
    /// @details Entry count and aggregate bytes are both bounded (ADR 0190):
    ///          oldest snapshots drop first so a document near the 64 MB
    ///          editing limit cannot pin gigabytes of history.
    hide func PushHistory(stack: List[String], content: String) {
        if content == "" { return; }
        stack.add(content);
        scene_history.TrimHistory(
            stack, MAX_3D_SCENE_HISTORY, MAX_3D_HISTORY_BYTES);
    }

    hide func RollBackFailedCommit(message: String) {
        var doc = currentDoc;
        if doc != null { LoadDocumentModel(doc, true); }
        detailLabel.SetText(message + " The last edit was rolled back.");
        toolbarStatus.SetText("Edit rolled back");
        GUI.Toast.Error("3D scene edit rolled back");
    }

    expose func AddPrimitive(kind: Integer, asChild: Boolean) -> Boolean {
        return AddPrimitiveAt(
            kind, asChild,
            viewTargetX, viewTargetY, viewTargetZ, false);
    }

    /// @brief Create one primitive from a context menu with rename armed.
    /// @details Menu creates spawn at the camera's view target and open the
    ///          inline hierarchy rename so the name is typed immediately;
    ///          toolbar buttons keep plain creation.
    expose func AddPrimitiveFromMenu(kind: Integer,
                                     asChild: Boolean) -> Boolean {
        return AddPrimitiveAt(
            kind, asChild,
            viewTargetX, viewTargetY, viewTargetZ, true);
    }

    /// @brief Create one primitive at the surface under a viewport pointer.
    /// @details The spawn point is the precise triangle hit under the
    ///          pointer, the ground-plane intersection when the ray misses
    ///          geometry, or the view target when it misses both. Shared by
    ///          the viewport context menu's create items.
    /// @param physicalX Physical pointer x recorded when the menu opened.
    /// @param physicalY Physical pointer y recorded when the menu opened.
    expose func AddPrimitiveAtPointer(kind: Integer,
                                      physicalX: Number,
                                      physicalY: Number) -> Boolean {
        if viewportImage == null {
            return AddPrimitiveFromMenu(kind, false);
        }
        var viewportX = Convert.NumToInt(
            PhysicalPointerToUi(physicalX)
            - viewportImage.GetScreenX());
        var viewportY = Convert.NumToInt(
            PhysicalPointerToUi(physicalY)
            - viewportImage.GetScreenY());
        var spawn = ViewportSpawnPoint(viewportX, viewportY);
        return AddPrimitiveAt(
            kind, false, spawn.X, spawn.Y, spawn.Z, true);
    }

    /// @brief Resolve a viewport point to a world spawn position.
    /// @details Precise surface hit first, ground plane (y = 0) second,
    ///          view target last — creation always lands somewhere visible.
    expose func ViewportSpawnPoint(viewportX: Integer,
                                   viewportY: Integer) -> Vec3 {
        if scene != null and ConfigureViewportCamera() {
            var origin = viewportRenderCamera.ScreenToRayOrigin(
                viewportX, viewportY,
                renderedViewportWidth, renderedViewportHeight) as Vec3;
            var direction = viewportRenderCamera.ScreenToRay(
                viewportX, viewportY,
                renderedViewportWidth, renderedViewportHeight) as Vec3;
            var hit = scene.RaycastPreciseHit(
                origin, direction, viewportRenderCamera.FarPlane)
                as RayHit3D;
            if hit != null { return hit.Point as Vec3; }
            if direction.Y < -0.000001 or direction.Y > 0.000001 {
                var t = (0.0 - origin.Y) / direction.Y;
                if t > 0.0 and t < viewportRenderCamera.FarPlane {
                    return Vec3.New(
                        origin.X + direction.X * t,
                        0.0,
                        origin.Z + direction.Z * t);
                }
            }
        }
        return Vec3.New(viewTargetX, viewTargetY, viewTargetZ);
    }

    /// @brief Shared primitive creation at one world position.
    /// @details Root creates spawn at the given world point; child creates
    ///          keep the parent-local origin so they land on their parent.
    ///          One undoable transaction; the new node becomes the
    ///          selection, optionally with inline rename armed.
    hide func AddPrimitiveAt(kind: Integer,
                             asChild: Boolean,
                             spawnX: Number,
                             spawnY: Number,
                             spawnZ: Number,
                             armRename: Boolean) -> Boolean {
        if scene == null { return false; }
        if asChild
           and ParentAcceptsAuthoredChildren(SelectedNode()) == false {
            return false;
        }
        var node = SceneNode.New();
        var name = "Empty " + scene.NodeCount;
        if kind == PRIMITIVE_BOX {
            name = "Box " + scene.NodeCount;
            node.Mesh = Mesh3D.Box(1.0, 1.0, 1.0);
            node.Material = Material3D.FromColor(0.30, 0.62, 0.92);
        } else if kind == PRIMITIVE_SPHERE {
            name = "Sphere " + scene.NodeCount;
            node.Mesh = Mesh3D.Sphere(0.5, 16);
            node.Material = Material3D.FromColor(0.92, 0.52, 0.26);
        } else if kind == PRIMITIVE_PLANE {
            name = "Plane " + scene.NodeCount;
            node.Mesh = Mesh3D.Plane(4.0, 4.0);
            node.Material = Material3D.FromColor(0.42, 0.70, 0.42);
        } else if kind == PRIMITIVE_CYLINDER {
            name = "Cylinder " + scene.NodeCount;
            node.Mesh = Mesh3D.Cylinder(0.5, 1.0, 24);
            node.Material = Material3D.FromColor(0.72, 0.46, 0.82);
        }
        node.Name = name;
        var parent = SelectedNode();
        if asChild and parent != null {
            parent.AddChild(node);
        } else {
            node.SetPosition(spawnX, spawnY, spawnZ);
            scene.Add(node);
        }
        if CommitScene("Added " + name) == false { return false; }
        RefreshHierarchy(node);
        if armRename { BeginRenameSelected(); }
        return true;
    }

    hide func FindNodeIndex(nodes: List[SceneNode],
                            needle: SceneNode) -> Integer {
        var index = 0;
        while index < nodes.count() {
            if nodes.get(index) == needle { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Return selected roots in an arbitrary flattened source graph.
    hide func TopLevelIndicesFor(nodes: List[SceneNode],
                                 indices: List[Integer],
                                 primary: Integer) -> List[Integer] {
        var roots: List[Integer] = [];
        var normalized = scene_selection.Normalize(
            indices, nodes.count(), primary);
        var selectionIndex = 0;
        while selectionIndex < normalized.count() {
            var candidate = normalized.get(selectionIndex);
            var parent = nodes.get(candidate).Parent;
            var hasSelectedAncestor = false;
            while parent != null and hasSelectedAncestor == false {
                var parentIndex = FindNodeIndex(nodes, parent);
                if parentIndex >= 0
                   and scene_selection.Contains(
                       normalized, parentIndex) {
                    hasSelectedAncestor = true;
                }
                parent = parent.Parent;
            }
            if hasSelectedAncestor == false { roots.add(candidate); }
            selectionIndex = selectionIndex + 1;
        }
        return roots;
    }

    /// @brief Return selected hierarchy roots, excluding selected descendants.
    hide func TopLevelSelectedIndices() -> List[Integer] {
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        return TopLevelIndicesFor(
            flatNodes, selectedIndices, selectedIndex);
    }

    /// @brief Return live handles for the top-level roots of current selection.
    hide func TopLevelSelectedNodes() -> List[SceneNode] {
        var nodes: List[SceneNode] = [];
        var indices = TopLevelSelectedIndices();
        var index = 0;
        while index < indices.count() {
            nodes.add(flatNodes.get(indices.get(index)));
            index = index + 1;
        }
        return nodes;
    }

    /// @brief Return the maximum child-edge depth beneath one live node.
    hide func SubtreeRelativeDepth(node: SceneNode) -> Integer {
        if node == null { return 0; }
        var maximum = 0;
        var child = 0;
        while child < node.ChildCount {
            var depth = 1 + SubtreeRelativeDepth(node.GetChild(child));
            if depth > maximum { maximum = depth; }
            if maximum >= MAX_HIERARCHY_DEPTH { return maximum; }
            child = child + 1;
        }
        return maximum;
    }

    /// @brief Return whether all moved subtrees remain visible within the cap.
    hide func ParentTargetFits(targetIndex: Integer,
                               roots: List[SceneNode]) -> Boolean {
        var rootDepth = 0;
        if targetIndex >= 0 {
            if targetIndex >= flatDepths.count() { return false; }
            rootDepth = flatDepths.get(targetIndex) + 1;
        }
        var index = 0;
        while index < roots.count() {
            if rootDepth + SubtreeRelativeDepth(roots.get(index))
               > MAX_HIERARCHY_DEPTH {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    /// @brief Move selected hierarchy roots beneath one existing target.
    /// @param targetIndex Flattened target index, or -1 for the scene root.
    /// @details World transforms are preserved by default through the runtime's
    ///          exact TRS conversion; the inspector can explicitly preserve
    ///          local transforms instead. Cycles, excessive depth, lossy world
    ///          conversion, unchanged parents, and invalid targets are
    ///          byte/history no-ops.
    ///          The complete operation serializes once and selection is remapped
    ///          by live node identity after preorder changes.
    expose func ReparentSelectedNodes(targetIndex: Integer) -> Boolean {
        if targetIndex >= 0 and targetIndex < flatNodes.count()
           and ParentAcceptsAuthoredChildren(
                   flatNodes.get(targetIndex)) == false {
            return false;
        }
        if scene == null or (targetIndex < -1)
           or targetIndex >= flatNodes.count() {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var roots = TopLevelSelectedNodes();
        if roots.count() == 0 { return false; }

        var target = scene.Root;
        if targetIndex >= 0 { target = flatNodes.get(targetIndex); }
        if scene_hierarchy_3d.TargetAllowed(target, roots) == false {
            detailLabel.SetText(
                "A node cannot be reparented to itself or one of its descendants.");
            return false;
        }
        if ParentTargetFits(targetIndex, roots) == false {
            detailLabel.SetText(
                "That parent would exceed Studio's hierarchy depth limit.");
            return false;
        }
        if scene_hierarchy_3d.AllAlreadyParented(roots, target) {
            detailLabel.SetText(
                "The selected hierarchy roots already use that parent.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectedNodes: List[SceneNode] = [];
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            selectedNodes.add(
                flatNodes.get(selectedIndices.get(selectionIndex)));
            selectionIndex = selectionIndex + 1;
        }
        var primaryNode = SelectedNode();
        var preserveWorld = preserveWorldReparentCheck != null
            and preserveWorldReparentCheck.IsChecked();

        var rootIndex = 0;
        while rootIndex < roots.count() {
            var node = roots.get(rootIndex);
            var attached = false;
            if preserveWorld {
                attached = target.TryAddChildPreserveWorld(node);
            } else {
                attached = target.TryAddChild(node);
            }
            if attached == false {
                var failure =
                    "Studio could not attach every selected hierarchy root. "
                    + "The document was restored.";
                if preserveWorld {
                    failure =
                        "Keeping the complete world transform would require "
                        + "a singular, sheared, or otherwise lossy local "
                        + "transform. The document was restored.";
                }
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    failure);
                return false;
            }
            rootIndex = rootIndex + 1;
        }

        // Resolve every identity before accepting serialized bytes. If the
        // resulting preorder cannot represent the complete prior selection,
        // currentDoc still contains the old canonical graph and rollback is
        // exact.
        var destinationNodes = FlattenGraph(scene);
        var nextSelection: List[Integer] = [];
        selectionIndex = 0;
        while selectionIndex < selectedNodes.count() {
            var mapped = FindNodeIndex(
                destinationNodes, selectedNodes.get(selectionIndex));
            if mapped >= 0 { nextSelection.add(mapped); }
            selectionIndex = selectionIndex + 1;
        }
        var nextPrimary = FindNodeIndex(destinationNodes, primaryNode);
        if nextSelection.count() != selectedNodes.count()
           or nextPrimary < 0 {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not retain the reparented selection.");
            return false;
        }

        var targetName = "scene root";
        if targetIndex >= 0 { targetName = NodeDisplayName(target); }
        var transformMode = " while preserving local transforms";
        if preserveWorld {
            transformMode = " while preserving world transforms";
        }
        if CommitScene(
               "Reparented " + roots.count() + " hierarchy root(s) to "
               + targetName + transformMode) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected hierarchy could not be reparented.");
            return false;
        }

        RefreshHierarchy(null);
        SelectSceneNodes(nextSelection, nextPrimary);
        if preserveWorld {
            detailLabel.SetText(
                "World transforms were preserved while changing parent.");
        } else {
            detailLabel.SetText(
                "Local transforms were preserved while changing parent.");
        }
        return true;
    }

    /// @brief Apply one latched TreeView row drop through canonical history.
    /// @details Dragging an unselected source first makes it the sole
    ///          selection. INTO uses the established transactional reparent
    ///          path; BEFORE/AFTER also establish exact sibling order.
    expose func ApplyHierarchyDrop(sourceIndex: Integer,
                                   targetIndex: Integer,
                                   position: Integer) -> Boolean {
        if scene == null
           or sourceIndex < 0 or sourceIndex >= flatNodes.count()
           or targetIndex < 0 or targetIndex >= flatNodes.count()
           or position < 0 or position > 2 {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if scene_selection.Contains(selectedIndices, sourceIndex) == false {
            SelectIndex(sourceIndex);
        }
        if position == 1 {
            if ParentAcceptsAuthoredChildren(
                   flatNodes.get(targetIndex)) == false {
                return false;
            }
            return ReparentSelectedNodes(targetIndex);
        }
        return MoveSelectedBeside(
            targetIndex, position == 2);
    }

    /// @brief Return whether one direct-child sequence is already exact.
    hide func ChildOrderMatches(parent: SceneNode,
                                desired: List[SceneNode]) -> Boolean {
        if parent == null or parent.ChildCount != desired.count() {
            return false;
        }
        var index = 0;
        while index < desired.count() {
            if parent.GetChild(index) != desired.get(index) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    /// @brief Reparent selected roots beside a target and establish row order.
    /// @details Attachment, exact preserve-world conversion, stable ordering,
    ///          serialization, selection remapping, and rollback form one edit.
    hide func MoveSelectedBeside(targetIndex: Integer,
                                 after: Boolean) -> Boolean {
        if scene == null
           or targetIndex < 0 or targetIndex >= flatNodes.count() {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var roots = TopLevelSelectedNodes();
        if roots.count() == 0 { return false; }

        var target = flatNodes.get(targetIndex);
        if scene_hierarchy_3d.TargetAllowed(target, roots) == false {
            detailLabel.SetText(
                "Drop beside a node outside the selected subtrees.");
            return false;
        }
        var destinationParent = target.Parent;
        if destinationParent == null {
            detailLabel.SetText("The drop target has no editable parent.");
            return false;
        }
        var destinationParentIndex =
            FindNodeIndex(flatNodes, destinationParent);
        if ParentTargetFits(destinationParentIndex, roots) == false {
            detailLabel.SetText(
                "That row drop would exceed Studio's hierarchy depth limit.");
            return false;
        }

        // Normalize moved roots to the scene's current structural preorder,
        // independent of the order in which callers supplied selected indices.
        var orderedRoots: List[SceneNode] = [];
        var flatIndex = 0;
        while flatIndex < flatNodes.count() {
            var candidate = flatNodes.get(flatIndex);
            if FindNodeIndex(roots, candidate) >= 0 {
                orderedRoots.add(candidate);
            }
            flatIndex = flatIndex + 1;
        }
        if orderedRoots.count() != roots.count() { return false; }

        // Compute the complete destination order before changing hierarchy.
        // Selected roots already under the destination are removed first, then
        // the whole ordered block is inserted around the target.
        var desired: List[SceneNode] = [];
        var inserted = false;
        var childIndex = 0;
        while childIndex < destinationParent.ChildCount {
            var child = destinationParent.GetChild(childIndex);
            if FindNodeIndex(orderedRoots, child) < 0 {
                if child == target and after == false {
                    var rootIndex = 0;
                    while rootIndex < orderedRoots.count() {
                        desired.add(orderedRoots.get(rootIndex));
                        rootIndex = rootIndex + 1;
                    }
                }
                desired.add(child);
                if child == target and after {
                    var rootIndex = 0;
                    while rootIndex < orderedRoots.count() {
                        desired.add(orderedRoots.get(rootIndex));
                        rootIndex = rootIndex + 1;
                    }
                }
                if child == target { inserted = true; }
            }
            childIndex = childIndex + 1;
        }
        if inserted == false {
            detailLabel.SetText("The row drop target is no longer attached.");
            return false;
        }

        var allAlreadyDirect = true;
        var rootIndex = 0;
        while rootIndex < orderedRoots.count() {
            if orderedRoots.get(rootIndex).Parent != destinationParent {
                allAlreadyDirect = false;
            }
            rootIndex = rootIndex + 1;
        }
        if allAlreadyDirect and ChildOrderMatches(destinationParent, desired) {
            detailLabel.SetText(
                "The selected hierarchy roots already use that row position.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectedNodes: List[SceneNode] = [];
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            selectedNodes.add(
                flatNodes.get(selectedIndices.get(selectionIndex)));
            selectionIndex = selectionIndex + 1;
        }
        var primaryNode = SelectedNode();
        var preserveWorld = preserveWorldReparentCheck != null
            and preserveWorldReparentCheck.IsChecked();

        rootIndex = 0;
        while rootIndex < orderedRoots.count() {
            var node = orderedRoots.get(rootIndex);
            if node.Parent != destinationParent {
                var attached = false;
                if preserveWorld {
                    attached =
                        destinationParent.TryAddChildPreserveWorld(node);
                } else {
                    attached = destinationParent.TryAddChild(node);
                }
                if attached == false {
                    RollBackGroupEdit(
                        previousSelection, previousPrimary,
                        "Studio could not attach every dragged hierarchy "
                        + "root without a lossy transform.");
                    return false;
                }
            }
            rootIndex = rootIndex + 1;
        }

        if destinationParent.ChildCount != desired.count() {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The destination hierarchy changed during the row drop.");
            return false;
        }
        childIndex = 0;
        while childIndex < desired.count() {
            var desiredChild = desired.get(childIndex);
            if destinationParent.GetChild(childIndex) != desiredChild
               and destinationParent.TryMoveChild(
                       desiredChild, childIndex) == false {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "Studio could not establish the complete dropped row order.");
                return false;
            }
            childIndex = childIndex + 1;
        }
        if ChildOrderMatches(destinationParent, desired) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not verify the complete dropped row order.");
            return false;
        }

        var destinationNodes = FlattenGraph(scene);
        var nextSelection: List[Integer] = [];
        selectionIndex = 0;
        while selectionIndex < selectedNodes.count() {
            var mapped = FindNodeIndex(
                destinationNodes, selectedNodes.get(selectionIndex));
            if mapped >= 0 { nextSelection.add(mapped); }
            selectionIndex = selectionIndex + 1;
        }
        var nextPrimary = FindNodeIndex(destinationNodes, primaryNode);
        if nextSelection.count() != selectedNodes.count()
           or nextPrimary < 0 {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not retain the dropped hierarchy selection.");
            return false;
        }

        var placement = "before";
        if after { placement = "after"; }
        if CommitScene(
               "Moved " + orderedRoots.count() + " hierarchy root(s) "
               + placement + " " + NodeDisplayName(target)) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The dropped hierarchy could not be committed.");
            return false;
        }
        RefreshHierarchy(null);
        SelectSceneNodes(nextSelection, nextPrimary);
        detailLabel.SetText(
            "Hierarchy row order changed as one undoable edit.");
        return true;
    }

    /// @brief Return a selected contiguous block of children in sibling order.
    /// @details Empty means the selection is empty, mixed-parent, contains
    ///          ancestor/descendant rows, or has an unselected sibling gap.
    hide func SelectedSiblingBlock() -> List[SceneNode] {
        var block: List[SceneNode] = [];
        if scene == null { return block; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return block; }

        var selectedNodes: List[SceneNode] = [];
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            selectedNodes.add(
                flatNodes.get(selectedIndices.get(selectionIndex)));
            selectionIndex = selectionIndex + 1;
        }
        var parent = selectedNodes.get(0).Parent;
        if parent == null { return block; }
        selectionIndex = 1;
        while selectionIndex < selectedNodes.count() {
            if selectedNodes.get(selectionIndex).Parent != parent {
                return [];
            }
            selectionIndex = selectionIndex + 1;
        }

        var started = false;
        var ended = false;
        var childIndex = 0;
        while childIndex < parent.ChildCount {
            var child = parent.GetChild(childIndex);
            var selected = FindNodeIndex(selectedNodes, child) >= 0;
            if selected {
                if ended { return []; }
                block.add(child);
                started = true;
            } else if started {
                ended = true;
            }
            childIndex = childIndex + 1;
        }
        if block.count() != selectedNodes.count() { return []; }
        return block;
    }

    /// @brief Find one direct child index without exposing native child storage.
    hide func DirectChildIndex(parent: SceneNode,
                               child: SceneNode) -> Integer {
        if parent == null or child == null { return -1; }
        var index = 0;
        while index < parent.ChildCount {
            if parent.GetChild(index) == child { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Move one contiguous selected sibling block by one position.
    /// @param direction -1 for earlier or 1 for later.
    /// @details The runtime operation is allocation-free, but Studio still
    ///          treats the complete block as one canonical history transaction
    ///          and reloads the old document after any rejected partial move.
    expose func MoveSelectedSiblings(direction: Integer) -> Boolean {
        if direction != -1 and direction != 1 { return false; }
        var block = SelectedSiblingBlock();
        if block.count() == 0 {
            detailLabel.SetText(
                "Select one contiguous group of nodes with the same parent.");
            return false;
        }
        var parent = block.get(0).Parent;
        var first = DirectChildIndex(parent, block.get(0));
        if first < 0 { return false; }
        var last = first + block.count() - 1;
        if (direction < 0 and first == 0)
           or (direction > 0 and last + 1 >= parent.ChildCount) {
            detailLabel.SetText(
                "The selected sibling block is already at that boundary.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectedNodes: List[SceneNode] = [];
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            selectedNodes.add(
                flatNodes.get(selectedIndices.get(selectionIndex)));
            selectionIndex = selectionIndex + 1;
        }
        var primaryNode = SelectedNode();

        if direction < 0 {
            var blockIndex = 0;
            while blockIndex < block.count() {
                if parent.TryMoveChild(
                       block.get(blockIndex),
                       first - 1 + blockIndex) == false {
                    RollBackGroupEdit(
                        previousSelection, previousPrimary,
                        "Studio could not move the complete sibling block.");
                    return false;
                }
                blockIndex = blockIndex + 1;
            }
        } else {
            var blockIndex = block.count() - 1;
            while blockIndex >= 0 {
                if parent.TryMoveChild(
                       block.get(blockIndex),
                       first + blockIndex + 1) == false {
                    RollBackGroupEdit(
                        previousSelection, previousPrimary,
                        "Studio could not move the complete sibling block.");
                    return false;
                }
                blockIndex = blockIndex - 1;
            }
        }

        var destinationNodes = FlattenGraph(scene);
        var nextSelection: List[Integer] = [];
        selectionIndex = 0;
        while selectionIndex < selectedNodes.count() {
            var mapped = FindNodeIndex(
                destinationNodes, selectedNodes.get(selectionIndex));
            if mapped >= 0 { nextSelection.add(mapped); }
            selectionIndex = selectionIndex + 1;
        }
        var nextPrimary = FindNodeIndex(destinationNodes, primaryNode);
        if nextSelection.count() != selectedNodes.count()
           or nextPrimary < 0 {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not retain the reordered selection.");
            return false;
        }

        var directionName = "earlier";
        if direction > 0 { directionName = "later"; }
        if CommitScene(
               "Moved " + block.count() + " sibling node(s) "
               + directionName) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected sibling block could not be reordered.");
            return false;
        }
        RefreshHierarchy(null);
        SelectSceneNodes(nextSelection, nextPrimary);
        detailLabel.SetText(
            "Sibling order changed without changing parent or local transforms.");
        return true;
    }

    /// @brief Remove selected hierarchy roots as one safe history transaction.
    expose func DeleteSelectedNodes() -> Boolean {
        if scene == null { return false; }
        var roots = TopLevelSelectedIndices();
        if roots.count() == 0 { return false; }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var firstRemoved = flatNodes.count();
        var index = roots.count() - 1;
        while index >= 0 {
            var nodeIndex = roots.get(index);
            if nodeIndex < firstRemoved { firstRemoved = nodeIndex; }
            scene.Remove(flatNodes.get(nodeIndex));
            index = index - 1;
        }
        selectedIndex = firstRemoved;
        selectedIndices = scene_selection.Single(
            selectedIndex, scene.NodeCount - 1);
        var message = "Deleted " + previousSelection.count()
            + " selected node(s)";
        if CommitScene(message) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected nodes could not be deleted.");
            return false;
        }
        RefreshHierarchy(null);
        return true;
    }

    /// @brief Flatten one cloned graph in the same pre-order as the inspector.
    hide func FlattenGraph(graph: SceneGraph) -> List[SceneNode] {
        var nodes: List[SceneNode] = [];
        if graph == null { return nodes; }
        var root = graph.Root;
        var child = 0;
        while child < root.ChildCount and nodes.count() < MAX_EDITOR_NODES {
            AppendFlattenedClone(root.GetChild(child), nodes);
            child = child + 1;
        }
        return nodes;
    }

    hide func AppendFlattenedClone(node: SceneNode,
                                   nodes: List[SceneNode]) {
        if node == null or nodes.count() >= MAX_EDITOR_NODES { return; }
        nodes.add(node);
        var child = 0;
        while child < node.ChildCount and nodes.count() < MAX_EDITOR_NODES {
            AppendFlattenedClone(node.GetChild(child), nodes);
            child = child + 1;
        }
    }

    /// @brief Return a useful scene-unique name for one duplicated root.
    hide func UniqueDuplicateNodeName(source: SceneNode) -> String {
        var stem = NodeDisplayName(source) + " Copy";
        if scene.Find(stem).IsNone { return stem; }
        var suffix = 2;
        while suffix <= flatNodes.count() + 2 {
            var candidate = stem + " " + suffix;
            if scene.Find(candidate).IsNone { return candidate; }
            suffix = suffix + 1;
        }
        return stem + " " + (flatNodes.count() + 3);
    }

    /// @brief Reload canonical content after a partially applied group action.
    hide func RollBackGroupEdit(previousSelection: List[Integer],
                                previousPrimary: Integer,
                                message: String) {
        var doc = currentDoc;
        if doc != null { LoadDocumentModel(doc, true); }
        SelectSceneNodes(previousSelection, previousPrimary);
        toolbarStatus.SetText("Group edit rolled back");
        detailLabel.SetText(message);
    }

    /// @brief Duplicate selected hierarchy roots from a canonical full clone.
    /// @return Number of selected nodes represented in the duplicate selection.
    expose func DuplicateSelectedNodes() -> Integer {
        if scene == null or currentSerialized == "" { return 0; }
        var roots = TopLevelSelectedIndices();
        if roots.count() == 0 { return 0; }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var cloneGraph = LoadGraphFromContent(currentSerialized);
        var cloneNodes = FlattenGraph(cloneGraph);
        if cloneGraph == null or cloneNodes.count() != flatNodes.count() {
            detailLabel.SetText(
                "Studio could not build a complete hierarchy clone. "
                + "No nodes were changed.");
            return 0;
        }

        var duplicateSelectionNodes: List[SceneNode] = [];
        var selectionIndex = 0;
        while selectionIndex < previousSelection.count() {
            duplicateSelectionNodes.add(
                cloneNodes.get(previousSelection.get(selectionIndex)));
            selectionIndex = selectionIndex + 1;
        }
        var primaryClone: SceneNode = null;
        if previousPrimary >= 0 and previousPrimary < cloneNodes.count() {
            primaryClone = cloneNodes.get(previousPrimary);
        }

        var rootIndex = 0;
        while rootIndex < roots.count() {
            var sourceIndex = roots.get(rootIndex);
            var source = flatNodes.get(sourceIndex);
            var clone = cloneNodes.get(sourceIndex);
            var cloneParent = clone.Parent;
            var destinationParent = source.Parent;
            if cloneParent == null or destinationParent == null {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "The duplicate hierarchy had no valid parent.");
                return 0;
            }
            cloneParent.RemoveChild(clone);
            clone.Name = UniqueDuplicateNodeName(source);
            var position = clone.Position;
            clone.SetPosition(position.X + 1.0, position.Y, position.Z);
            if destinationParent.TryAddChild(clone) == false {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "Studio could not attach every duplicated subtree. "
                    + "The document was restored.");
                return 0;
            }
            rootIndex = rootIndex + 1;
        }
        if scene.NodeCount - 1 > MAX_EDITOR_NODES {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Duplicating this selection would exceed Studio's "
                + MAX_EDITOR_NODES + "-node editing limit.");
            return 0;
        }

        var message = "Duplicated " + roots.count()
            + " selected hierarchy root(s)";
        if CommitScene(message) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected hierarchy could not be duplicated.");
            return 0;
        }
        RefreshHierarchy(null);
        var duplicateIndices: List[Integer] = [];
        var duplicatePrimary = -1;
        selectionIndex = 0;
        while selectionIndex < duplicateSelectionNodes.count() {
            var duplicateIndex =
                FindFlatIndex(duplicateSelectionNodes.get(selectionIndex));
            if duplicateIndex >= 0 { duplicateIndices.add(duplicateIndex); }
            selectionIndex = selectionIndex + 1;
        }
        if primaryClone != null {
            duplicatePrimary = FindFlatIndex(primaryClone);
        }
        if duplicatePrimary < 0 and duplicateIndices.count() > 0 {
            duplicatePrimary = duplicateIndices.get(0);
        }
        SelectSceneNodes(duplicateIndices, duplicatePrimary);
        return duplicateIndices.count();
    }

    hide func ApplySelectedNode() -> Boolean {
        var node = SelectedNode();
        if node == null { return false; }
        var nextName = Str.Trim(nameInput.Text);
        if nextName == "" { nextName = "Node"; }
        node.Name = nextName;
        node.Visible = visibleCheck.IsChecked();
        node.SetPosition(positionX.Value, positionY.Value, positionZ.Value);
        node.Rotation = Quat.FromEuler(rotationX.Value * DEG_TO_RAD,
                                       rotationY.Value * DEG_TO_RAD,
                                       rotationZ.Value * DEG_TO_RAD).Normalize();
        node.SetScale(scaleX.Value, scaleY.Value, scaleZ.Value);
        if CommitScene("Updated " + nextName) == false { return false; }
        RefreshHierarchy(node);
        return true;
    }

    /// @brief Set visibility across the complete normalized node selection.
    /// @details Mixed state is presentation-only. A determined checkbox value
    ///          changes every selected node, verifies the live graph, and
    ///          creates one canonical VSCN history entry. No-op and failed
    ///          commits retain content, selection, and history.
    /// @brief Set the bake-participation flag across the selection.
    expose func ApplySelectedStatic(nextStatic: Boolean) -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        var needsChange = false;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            if flatNodes.get(
                   selectedIndices.get(selectionIndex)).GetStatic()
               != nextStatic {
                needsChange = true;
            }
            selectionIndex = selectionIndex + 1;
        }
        if needsChange == false {
            detailLabel.SetText(
                "Every selected node already has that static state.");
            return false;
        }
        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex))
                .SetStatic(nextStatic);
            selectionIndex = selectionIndex + 1;
        }
        var stateName = "static";
        if nextStatic == false { stateName = "dynamic"; }
        if CommitScene(
               "Marked " + selectedIndices.count() + " node(s) "
               + stateName) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected nodes' static flag could not be committed.");
            return false;
        }
        return true;
    }

    /// @brief Resolve the complete selection to one canonical visibility.
    /// @details This is shared by the inspector, hierarchy action strip, and
    ///          context menu; one group operation creates one history entry.
    expose func ApplySelectedVisibility(nextVisible: Boolean) -> Boolean {
        if scene == null { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }

        var needsChange = false;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            if flatNodes.get(
                   selectedIndices.get(selectionIndex)).Visible
               != nextVisible {
                needsChange = true;
            }
            selectionIndex = selectionIndex + 1;
        }
        if needsChange == false {
            detailLabel.SetText(
                "Every selected node already has that visibility.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var node =
                flatNodes.get(selectedIndices.get(selectionIndex));
            node.Visible = nextVisible;
            if node.Visible != nextVisible {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "Studio could not update every selected node's visibility.");
                return false;
            }
            selectionIndex = selectionIndex + 1;
        }

        var stateName = "visible";
        if nextVisible == false { stateName = "hidden"; }
        if CommitScene(
               "Set " + selectedIndices.count() + " node(s) "
               + stateName) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The selected nodes' visibility could not be committed.");
            return false;
        }
        RefreshHierarchy(null);
        SelectSceneNodes(previousSelection, previousPrimary);
        detailLabel.SetText(
            "Visibility updated for the complete selection.");
        return true;
    }

    /// @brief Commit every determined material control for the selection.
    expose func ApplySelectedMaterialFromControls() -> Boolean {
        if materialInspector == null or materialInspector.colorPicker == null {
            return false;
        }
        materialInspector.PumpDraftIntent();
        return ApplySelectedMaterialPatch(
            materialInspector.BuildPatch());
    }

    /// @brief Open the native picker for the currently selected texture slot.
    hide func ChooseMaterialMap() -> Boolean {
        var node = SelectedNode();
        if node == null { return false; }
        var baseDir = "";
        if currentDoc != null and currentDoc.filePath != "" {
            baseDir = Path.Directory(currentDoc.filePath);
        }
        var slot = materialInspector.mapSlot.Selected;
        var path = GUI.FileDialog.Open(
            "Choose " + scene_material_3d.MapSlotName(slot) + " Map",
            baseDir,
            "*.png;*.jpg;*.jpeg;*.bmp;*.gif;*.ktx2");
        if path == "" { return false; }
        return ApplySelectedMaterialMapPath(slot, path);
    }

    /// @brief Assign or clear one map across the complete node selection.
    /// @details All required material clones are staged before nodes mutate.
    ///          Equal source-material identities reuse one staged clone, so a
    ///          selected sharing group remains shared without affecting any
    ///          unselected node that owns the original material.
    expose func AssignSelectedMaterialMap(slot: Integer,
                                          texture: Any) -> Boolean {
        if scene == null
           or scene_material_3d.IsMapSlot(slot) == false {
            return false;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }

        var currentMaterials: List[Material3D] = [];
        var nextMaterials: List[Material3D] = [];
        var changedCount = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            var current = flatNodes.get(
                selectedIndices.get(selectionIndex)).Material;
            currentMaterials.add(current);
            var shouldChange = texture != null
                or scene_material_3d.HasMap(current, slot);
            if shouldChange == false {
                nextMaterials.add(current);
            } else {
                var next: Material3D = null;
                var prior = 0;
                while prior < currentMaterials.count() - 1
                      and next == null {
                    if currentMaterials.get(prior) == current
                       and nextMaterials.get(prior) != current {
                        next = nextMaterials.get(prior);
                    }
                    prior = prior + 1;
                }
                if next == null {
                    next = scene_material_3d.WithMap(
                        current, slot, texture);
                }
                if next == null {
                    toolbarStatus.SetText("Texture map batch failed");
                    detailLabel.SetText(
                        "Studio could not allocate every material map copy. "
                        + "No selected nodes were changed.");
                    GUI.Toast.Error("3D texture map batch failed");
                    return false;
                }
                nextMaterials.add(next);
                changedCount = changedCount + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if changedCount == 0 { return false; }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        selectionIndex = 0;
        while selectionIndex < selectedIndices.count() {
            flatNodes.get(
                selectedIndices.get(selectionIndex)).Material =
                nextMaterials.get(selectionIndex);
            selectionIndex = selectionIndex + 1;
        }
        var action = "Embedded ";
        if texture == null { action = "Cleared "; }
        if CommitScene(
               action + scene_material_3d.MapSlotName(slot)
               + " map on " + changedCount + " selected node(s)") == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The texture map batch could not be committed.");
            return false;
        }
        RefreshMaterialFields(SelectedNode());
        UpdateMaterialControls(true);
        detailLabel.SetText(
            action + scene_material_3d.MapSlotName(slot)
            + " map on " + changedCount + " selected node(s).");
        renderDirty = true;
        return true;
    }

    /// @brief Assign a loaded object to one cloned material map slot.
    hide func AssignMaterialMap(nodeIndex: Integer,
                                slot: Integer,
                                texture: Any) -> Boolean {
        if scene == null or nodeIndex < 0 or nodeIndex >= flatNodes.count()
           or scene_material_3d.IsMapSlot(slot) == false {
            return false;
        }
        var node = flatNodes.get(nodeIndex);
        var next = scene_material_3d.WithMap(node.Material, slot, texture);
        if next == null {
            toolbarStatus.SetText("Texture map edit failed");
            detailLabel.SetText(
                "Studio could not create a node-local material copy.");
            GUI.Toast.Error("3D texture map edit failed");
            return false;
        }
        node.Material = next;
        selectedIndex = nodeIndex;
        selectedIndices = scene_selection.Single(
            nodeIndex, flatNodes.count());
        var action = "Embedded ";
        if texture == null { action = "Cleared "; }
        if CommitScene(
               action + scene_material_3d.MapSlotName(slot)
               + " map on " + NodeDisplayName(node)) == false {
            return false;
        }
        RefreshMaterialFields(node);
        return true;
    }

    expose func SetEditorControlsEnabled(enabled: Boolean) {
        if addEmptyButton == null { return; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var hasSelection = enabled and selectedIndex >= 0
            and selectedIndex < flatNodes.count()
            and selectedIndices.count() > 0;
        var hasSingle = hasSelection and selectedIndices.count() == 1;
        addEmptyButton.SetEnabled(enabled);
        addChildButton.SetEnabled(hasSingle);
        addBoxButton.SetEnabled(enabled);
        addSphereButton.SetEnabled(enabled);
        addPlaneButton.SetEnabled(enabled);
        addCylinderButton.SetEnabled(enabled);
        addLightButton.SetEnabled(enabled);
        duplicateNodeButton.SetEnabled(hasSelection);
        moveToolButton.SetEnabled(hasSelection);
        rotateToolButton.SetEnabled(hasSelection);
        scaleToolButton.SetEnabled(hasSelection);
        snapTransformCheck.SetEnabled(hasSelection);
        deleteNodeButton.SetEnabled(hasSelection);
        frameSelectedButton.SetEnabled(hasSelection);
        hierarchySearchInput.SetEnabled(enabled);
        hierarchyTree.SetEnabled(enabled);
        parentDropdown.SetEnabled(hasSelection);
        reparentButton.SetEnabled(hasSelection);
        preserveWorldReparentCheck.SetEnabled(hasSelection);
        moveSiblingEarlierButton.SetEnabled(false);
        moveSiblingLaterButton.SetEnabled(false);
        nameInput.SetEnabled(hasSingle);
        visibleCheck.SetEnabled(hasSelection);
        positionX.SetEnabled(hasSelection);
        positionY.SetEnabled(hasSelection);
        positionZ.SetEnabled(hasSelection);
        rotationX.SetEnabled(hasSelection);
        rotationY.SetEnabled(hasSelection);
        rotationZ.SetEnabled(hasSelection);
        scaleX.SetEnabled(hasSelection);
        scaleY.SetEnabled(hasSelection);
        scaleZ.SetEnabled(hasSelection);
        applyTransformButton.SetEnabled(hasSelection);
        duplicateNodeButton.SetText("Duplicate");
        deleteNodeButton.SetText("Delete");
        applyTransformButton.SetText("Apply node properties");
        applyTransformButton.SetTooltip(
            "Set the selected node's name, visibility, and local transform");
        UpdateHierarchySearchControls();
        RefreshHierarchyActionControls();
        if selectedIndices.count() > 1 {
            duplicateNodeButton.SetText(
                "Duplicate (" + selectedIndices.count() + ")");
            deleteNodeButton.SetText(
                "Delete (" + selectedIndices.count() + ")");
            applyTransformButton.SetText(
                "Apply deltas to " + selectedIndices.count());
            applyTransformButton.SetTooltip(
                "Add position/rotation and multiply scale for every "
                + "selected node as one undoable edit");
        }
        UpdateParentControlAvailability();
        UpdateSiblingControlAvailability();
        metadataInspector.SetEnabled(hasSingle);
        UpdateLightControls(enabled);
        UpdateCameraControls(enabled);
        UpdateColliderControls(enabled);
        UpdateMaterialControls(enabled);
        UpdateInspectorScope();
    }

    /// @brief Whether at least one selected node can be made visible.
    expose func CanShowSelectedNodes() -> Boolean {
        var selection = 0;
        while selection < selectedIndices.count() {
            var index = selectedIndices.get(selection);
            if index >= 0 and index < flatNodes.count()
               and flatNodes.get(index).Visible == false {
                return true;
            }
            selection = selection + 1;
        }
        return false;
    }

    /// @brief Whether at least one selected node can be hidden.
    expose func CanHideSelectedNodes() -> Boolean {
        var selection = 0;
        while selection < selectedIndices.count() {
            var index = selectedIndices.get(selection);
            if index >= 0 and index < flatNodes.count()
               and flatNodes.get(index).Visible {
                return true;
            }
            selection = selection + 1;
        }
        return false;
    }

    /// @brief Whether every selected node ignores viewport picking.
    expose func SelectedAllPickLocked() -> Boolean {
        var valid = 0;
        var selection = 0;
        while selection < selectedIndices.count() {
            var index = selectedIndices.get(selection);
            if index >= 0 and index < flatNodes.count() {
                valid = valid + 1;
                if NodePickLocked(index) == false { return false; }
            }
            selection = selection + 1;
        }
        return valid > 0;
    }

    /// @brief Keep hierarchy actions enabled, labeled, and mixed-state truthful.
    hide func RefreshHierarchyActionControls() {
        if hierarchyShowButton == null
           or hierarchyHideButton == null
           or hierarchyPickLockButton == null {
            return;
        }
        var hasSelection = scene != null
            and selectedIndices.count() > 0;
        hierarchyShowButton.SetEnabled(
            hasSelection and CanShowSelectedNodes());
        hierarchyHideButton.SetEnabled(
            hasSelection and CanHideSelectedNodes());
        hierarchyPickLockButton.SetEnabled(hasSelection);
        if hasSelection and SelectedAllPickLocked() {
            hierarchyPickLockButton.SetText("Unlock Pick");
            hierarchyPickLockButton.SetAccessibleName(
                "Unlock viewport picking for selected 3D scene nodes");
            hierarchyPickLockButton.SetTooltip(
                "Return every selected node to viewport click and marquee "
                + "selection; this does not edit the scene");
        } else {
            var label = "⊘ Lock Pick";
            if hasSelection and selectedIndices.count() > 1 {
                label = "⊘ Lock All";
            }
            hierarchyPickLockButton.SetText(label);
            hierarchyPickLockButton.SetAccessibleName(
                "Lock viewport picking for selected 3D scene nodes");
            hierarchyPickLockButton.SetTooltip(
                "Keep the selected nodes visible but ignore them during "
                + "viewport click and marquee selection; this follows the "
                + "scene tab");
        }
    }

    /// @brief Refresh typed metadata without rebuilding hierarchy identity.
    hide func RefreshMetadataFields(node: SceneNode) {
        if metadataInspector == null { return; }
        if selectedIndex != metadataOwnerIndex {
            selectedNodeMetadata = -1;
            metadataOwnerIndex = selectedIndex;
        }
        var enabled = scene != null and node != null
            and selectedIndices.count() == 1;
        metadataInspector.Refresh(node, enabled);
        selectedNodeMetadata = metadataInspector.selectedProperty;
    }

    /// @brief Refresh complete node-light controls without changing history.
    hide func RefreshLightFields(node: SceneNode) {
        if lightInspector == null { return; }
        var primary = SelectedNode();
        if primary == null and node != null { primary = node; }
        lightInspector.RefreshSelection(
            SelectedMaterialNodes(), primary, scene != null);
    }

    /// @brief Keep light actions truthful for the selection (ADR 0186).
    hide func UpdateLightControls(editorEnabled: Boolean) {
        if lightInspector == null { return; }
        var nodes = SelectedMaterialNodes();
        var lightCount = 0;
        var index = 0;
        while index < nodes.count() {
            if nodes.get(index).Light != null {
                lightCount = lightCount + 1;
            }
            index = index + 1;
        }
        lightInspector.UpdateSelectionControls(
            editorEnabled, nodes, lightCount);
    }

    /// @brief Refresh complete node-camera controls without changing history.
    hide func RefreshCameraFields(node: SceneNode) {
        if cameraInspector == null { return; }
        cameraInspector.Refresh(
            node,
            selectedIndices.count(),
            scene != null,
            lookThroughNode != null);
    }

    /// @brief Keep camera actions truthful for single-node authoring.
    hide func UpdateCameraControls(editorEnabled: Boolean) {
        if cameraInspector == null { return; }
        var node = SelectedNode();
        var hasCamera = node != null and node.Camera != null;
        cameraInspector.UpdateControls(
            editorEnabled, hasCamera, selectedIndices.count(),
            lookThroughNode != null);
    }

    /// @brief Refresh collider convention controls without changing history.
    hide func RefreshColliderFields(node: SceneNode) {
        if colliderInspector == null { return; }
        colliderInspector.Refresh(
            node,
            selectedIndices.count(),
            scene != null);
    }

    /// @brief Keep the prefab-instance group truthful for the selection.
    hide func RefreshInstanceControls(node: SceneNode) {
        if instanceGroup == null { return; }
        var single = selectedIndices.count() == 1 and node != null;
        var isInstance = single and node.PrefabPath != "";
        instanceGroup.SetEnabled(scene != null);
        openPrefabSourceButton.SetEnabled(isInstance);
        unpackInstanceButton.SetEnabled(isInstance);
        relinkInstanceButton.SetEnabled(isInstance);
        reloadInstancesButton.SetEnabled(scene != null);
        if isInstance {
            var content = "empty placeholder — the referenced scene "
                + "did not resolve";
            if node.ChildCount > 0 {
                content = node.ChildCount + " grafted root node(s)";
            }
            instanceSummary.SetText(
                "References " + node.PrefabPath + " • " + content
                + " • overrides: transform, name, visibility, metadata.");
        } else if single and node.IsInstanceContent {
            instanceSummary.SetText(
                "Instance content is locked; selection resolves to the "
                + "owning prefab instance.");
        } else {
            instanceSummary.SetText(
                "Select a prefab instance node to manage its reference.");
        }
    }

    /// @brief Keep collider actions truthful for single-node authoring.
    hide func UpdateColliderControls(editorEnabled: Boolean) {
        if colliderInspector == null { return; }
        var node = SelectedNode();
        var state = scene_collider_3d.FromNode(node);
        colliderInspector.UpdateControls(
            editorEnabled,
            state.kind != scene_collider_3d.COLLIDER_NONE,
            selectedIndices.count());
    }

    /// @brief Summarize selected-node coverage for the active component.
    hide func RefreshComponentPalette() {
        if componentPalette == null or componentPalette.group == null {
            return;
        }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var component = componentPalette.SelectedComponent();
        var enabled = scene != null and selectedIndices.count() > 0
            and component != null;
        var present = 0;
        var missing = 0;
        var conflicts = 0;
        if enabled {
            var selectionIndex = 0;
            while selectionIndex < selectedIndices.count() {
                var node =
                    flatNodes.get(selectedIndices.get(selectionIndex));
                var fieldIndex = 0;
                while fieldIndex < component.fields.count() {
                    var field = component.fields.get(fieldIndex);
                    if node.MetadataHas(field.key) == false {
                        missing = missing + 1;
                    } else if node.MetadataKind(field.key)
                               == scene_component_schema.ValueKind(
                                      field.kind) {
                        present = present + 1;
                    } else {
                        conflicts = conflicts + 1;
                    }
                    fieldIndex = fieldIndex + 1;
                }
                selectionIndex = selectionIndex + 1;
            }
        }
        componentPalette.SetContext(
            enabled, present, missing, conflicts);
        componentPalette.SetEditEnabled(
            enabled and selectedIndices.count() == 1);
    }

    /// @brief Route project component-picker intent into editor transactions.
    hide func PumpComponentControls() -> Boolean {
        if componentPalette == null or componentPalette.group == null {
            return false;
        }
        if componentPalette.Pump() { RefreshComponentPalette(); }
        var schemaChanged = componentAuthoring.PollExternalChanges(
            1000, componentPalette);
        var schemaAuthored =
            componentAuthoring.Pump(componentPalette);
        if schemaChanged or schemaAuthored
           or componentAuthoring.handled {
            componentSchema = componentAuthoring.schema;
            viewportPostFXDirty = true;
            RefreshComponentPalette();
            RebuildProjectNodePreviews();
            if componentAuthoring.message != "" {
                detailLabel.SetText(componentAuthoring.message);
            }
        }
        if componentPalette.TakeEditFieldRequested() {
            EditSelectedComponentField();
        }
        if componentPalette.TakeApplyRequested() {
            return ApplySelectedComponent(
                componentPalette.SelectedComponent());
        }
        return false;
    }

    /// @brief Update material fields without rebuilding hierarchy/node identity.
    hide func RefreshMaterialFields(node: SceneNode) {
        if materialInspector == null { return; }
        var primary = SelectedNode();
        if primary == null and node != null { primary = node; }
        var material: Material3D = null;
        if primary != null { material = primary.Material; }
        materialInspector.RefreshSelection(
            SelectedMaterialNodes(),
            primary,
            MaterialUsageCount(material),
            scene != null);
    }

    /// @brief Keep material actions truthful for selection and sharing state.
    hide func UpdateMaterialControls(editorEnabled: Boolean) {
        if materialInspector == null { return; }
        var node = SelectedNode();
        var material: Material3D = null;
        if node != null { material = node.Material; }
        materialInspector.UpdateSelectionControls(
            editorEnabled,
            SelectedMaterialNodes(),
            MaterialUsageCount(material));
    }

    /// @brief Return normalized live material owners for current selection.
    hide func SelectedMaterialNodes() -> List[SceneNode] {
        var nodes: List[SceneNode] = [];
        var normalized = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var index = 0;
        while index < normalized.count() {
            nodes.add(flatNodes.get(normalized.get(index)));
            index = index + 1;
        }
        return nodes;
    }

    /// @brief Count selected-scene nodes sharing one material identity.
    hide func MaterialUsageCount(material: Material3D) -> Integer {
        if material == null { return 0; }
        var count = 0;
        var index = 0;
        while index < flatNodes.count() {
            if flatNodes.get(index).Material == material { count = count + 1; }
            index = index + 1;
        }
        return count;
    }

    /// @brief Count node-attached lights represented by the bounded editor tree.
    hide func AuthoredLightCount() -> Integer {
        var count = 0;
        var index = 0;
        while index < flatNodes.count() {
            if flatNodes.get(index).Light != null { count = count + 1; }
            index = index + 1;
        }
        return count;
    }

    /// @brief Return a non-empty node name for status messages.
    hide func NodeDisplayName(node: SceneNode) -> String {
        if node == null { return "node"; }
        var name = Str.Trim(node.Name);
        if name == "" { return "unnamed node"; }
        return name;
    }

    hide func SelectedNode() -> SceneNode {
        if selectedIndex < 0 or selectedIndex >= flatNodes.count() { return null; }
        return flatNodes.get(selectedIndex);
    }

    hide func SelectIndex(index: Integer) {
        if index < 0 or index >= flatNodes.count() {
            selectedIndex = -1;
            selectedIndices = [];
        } else {
            selectedIndex = index;
            selectedIndices = scene_selection.Single(
                index, flatNodes.count());
        }
        RevealHierarchyTreeSelection();
        RefreshSelectedFields();
        SetEditorControlsEnabled(scene != null);
        renderDirty = true;
    }

    /// @brief Select validated hierarchy rows with one explicit primary node.
    expose func SelectSceneNodes(indices: List[Integer],
                                 primary: Integer) -> Boolean {
        var resolved = ResolveInstanceOwnerSelection(indices);
        selectedIndices = scene_selection.Normalize(
            resolved, flatNodes.count(), primary);
        selectedIndex = ResolveInstanceOwnerIndex(primary);
        if selectedIndex < 0 or selectedIndex >= flatNodes.count() {
            selectedIndex = -1;
            if selectedIndices.count() > 0 {
                selectedIndex = selectedIndices.get(0);
            }
        }
        RevealHierarchyTreeSelection();
        RefreshSelectedFields();
        SetEditorControlsEnabled(scene != null);
        renderDirty = true;
        CaptureWorkspaceState();
        return selectedIndices.count() > 0;
    }

    /// @brief Reveal and focus the hierarchy Find field without editing VSCN.
    /// @return True when a loaded scene owns a usable search field.
    expose func FocusHierarchySearch() -> Boolean {
        if scene == null or hierarchySearchInput == null { return false; }
        if hierarchyDock.floating == false
           and UsesDockedHierarchy(lastHostWidth) == false {
            compactHierarchyShown = true;
            compactInspectorShown = false;
        }
        ApplyInspectorLayout();
        hierarchySearchInput.Focus();
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Select and reveal one bounded node-name hierarchy match.
    /// @param query Case-insensitive node-name fragment.
    /// @param direction Negative for previous; zero or positive for next.
    /// @return True when a matching represented row was selected.
    expose func FindHierarchy(query: String,
                              direction: Integer) -> Boolean {
        if scene == null or hierarchySearchInput == null { return false; }
        var normalized = scene_hierarchy_search.Normalize(query);
        var resetCursor = normalized != hierarchySearchQuery;
        if hierarchySearchInput.Text != query {
            hierarchySearchInput.SetText(query);
        }
        RefreshHierarchySearch(resetCursor);
        return NavigateHierarchySearch(direction);
    }

    /// @brief Rebuild match indices from represented bounded rows only.
    hide func RefreshHierarchySearch(resetCursor: Boolean) {
        if hierarchySearchInput == null { return; }
        hierarchySearchQuery = scene_hierarchy_search.Normalize(
            hierarchySearchInput.Text);
        hierarchySearchMatches = [];
        if scene != null and hierarchySearchQuery != "" {
            var index = 0;
            while index < flatNodes.count()
                  and index < hierarchyTreeNodes.count() {
                if hierarchyTreeNodes.get(index) != null
                   and scene_hierarchy_search.MatchesNormalized(
                       hierarchySearchQuery,
                       flatNodes.get(index).Name,
                       "") {
                    hierarchySearchMatches.add(index);
                }
                index = index + 1;
            }
        }

        hierarchySearchCursor = -1;
        if resetCursor == false {
            var match = 0;
            while match < hierarchySearchMatches.count() {
                if hierarchySearchMatches.get(match) == selectedIndex {
                    hierarchySearchCursor = match;
                    break;
                }
                match = match + 1;
            }
        }
        UpdateHierarchySearchControls();
    }

    /// @brief Apply one previous/next hierarchy jump without scene mutation.
    hide func NavigateHierarchySearch(direction: Integer) -> Boolean {
        hierarchySearchCursor = scene_hierarchy_search.NextCursor(
            hierarchySearchMatches.count(),
            hierarchySearchCursor,
            direction);
        if hierarchySearchCursor < 0
           or hierarchySearchCursor >= hierarchySearchMatches.count() {
            UpdateHierarchySearchControls();
            return false;
        }
        var target = hierarchySearchMatches.get(hierarchySearchCursor);
        var selection = scene_selection.Single(
            target, flatNodes.count());
        var selected = SelectSceneNodes(selection, target);
        UpdateHierarchySearchControls();
        return selected;
    }

    /// @brief Pump search text and navigation controls without VSCN history.
    hide func PumpHierarchySearchControls() {
        if hierarchySearchInput == null { return; }
        var query = scene_hierarchy_search.Normalize(
            hierarchySearchInput.Text);
        if query != hierarchySearchQuery {
            RefreshHierarchySearch(true);
        }
        var direction = 0;
        var requested = false;
        if hierarchySearchPreviousButton.WasClicked() {
            direction = -1;
            requested = true;
        }
        if hierarchySearchNextButton.WasClicked()
           or hierarchySearchInput.WasSubmitted() {
            direction = 1;
            requested = true;
        }
        if requested { NavigateHierarchySearch(direction); }
    }

    /// @brief Reflect query, match cursor, and safety bounds in compact UI.
    hide func UpdateHierarchySearchControls() {
        if hierarchySearchInput == null { return; }
        var available = scene != null;
        hierarchySearchInput.SetEnabled(available);
        var canNavigate =
            available and hierarchySearchMatches.count() > 0;
        hierarchySearchPreviousButton.SetEnabled(canNavigate);
        hierarchySearchNextButton.SetEnabled(canNavigate);

        var suffix = "";
        if hierarchyClipped {
            suffix = " within the bounded visible hierarchy";
        }
        if hierarchySearchQuery == "" {
            hierarchySearchStatus.SetText(
                "Find by node name" + suffix);
        } else if hierarchySearchMatches.count() == 0 {
            hierarchySearchStatus.SetText(
                "No matching nodes" + suffix);
        } else if hierarchySearchCursor < 0 {
            hierarchySearchStatus.SetText(
                hierarchySearchMatches.count()
                + " matching node(s)" + suffix
                + "; press Enter to jump");
        } else {
            hierarchySearchStatus.SetText(
                "Match " + (hierarchySearchCursor + 1)
                + " of " + hierarchySearchMatches.count()
                + suffix);
        }
    }

    /// @brief Return whether at least one valid hierarchy node is selected.
    expose func HasSceneNodeSelection() -> Boolean {
        var normalized = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        return scene != null and normalized.count() > 0;
    }

    /// @brief Return whether Select All has a hierarchy target.
    expose func CanSelectAllSceneNodes() -> Boolean {
        return scene != null and flatNodes.count() > 0;
    }

    /// @brief Return whether the text clipboard may contain pasteable data.
    /// @details Explicit paste performs typed envelope and VSCN validation;
    ///          per-frame menu state only asks the cheap native HasText query.
    expose func CanPasteSceneNodes() -> Boolean {
        return scene != null and GUI.ClipboardText.HasText();
    }

    /// @brief Select every editable hierarchy row without changing history.
    expose func SelectAllSceneNodes() -> Boolean {
        if CanSelectAllSceneNodes() == false { return false; }
        var all: List[Integer] = [];
        var index = 0;
        while index < flatNodes.count() {
            all.add(index);
            index = index + 1;
        }
        var primary = selectedIndex;
        if primary < 0 or primary >= flatNodes.count() { primary = 0; }
        if SelectSceneNodes(all, primary) == false { return false; }
        toolbarStatus.SetText(
            "Selected all " + selectedIndices.count() + " scene nodes");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Copy selected hierarchy identities with canonical VSCN content.
    expose func CopySelectedNodes() -> Boolean {
        if scene == null or currentSerialized == "" { return false; }
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }
        if selectedIndex < 0
           or scene_selection.Contains(selectedIndices, selectedIndex) == false {
            selectedIndex = selectedIndices.get(0);
        }
        var encoded = scene_clipboard.Encode(
            "3d", selectedIndices, selectedIndex, currentSerialized);
        if encoded == "" {
            toolbarStatus.SetText("Scene nodes not copied");
            detailLabel.SetText(
                "The selected hierarchy exceeds Studio's scene clipboard limit.");
            return false;
        }
        GUI.ClipboardText.SetText(encoded);
        toolbarStatus.SetText(
            "Copied " + selectedIndices.count() + " scene node(s)");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Copy and remove selected hierarchy roots as one undoable edit.
    expose func CutSelectedNodes() -> Boolean {
        var count = selectedIndices.count();
        if CopySelectedNodes() == false { return false; }
        if DeleteSelectedNodes() == false {
            detailLabel.SetText(
                "The nodes were copied, but Studio could not remove them.");
            return false;
        }
        toolbarStatus.SetText("Cut " + count + " scene node(s)");
        return true;
    }

    /// @brief Paste selected VSCN subtrees as siblings of the primary node.
    /// @details A source graph is instantiated from the clipboard's canonical
    ///          VSCN. Selected descendants remain attached to selected roots,
    ///          and any attachment/serialization failure restores the complete
    ///          destination document and its prior selection.
    expose func PasteSceneNodesFromClipboard() -> Boolean {
        if scene == null or currentDoc == null { return false; }
        var payload = scene_clipboard.Decode(GUI.ClipboardText.GetText());
        if payload.valid == false {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(payload.error);
            return false;
        }
        if payload.kind != "3d" {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard contains 2D objects. Paste them into a 2D scene.");
            return false;
        }

        var sourceGraph = LoadGraphFromContent(payload.content);
        var sourceNodes = FlattenGraph(sourceGraph);
        if sourceGraph == null
           or sourceGraph.NodeCount - 1 != sourceNodes.count()
           or sourceNodes.count() > MAX_EDITOR_NODES {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard contains invalid, incomplete, or oversized VSCN data.");
            return false;
        }
        var sourceSelection = scene_selection.Normalize(
            payload.indices, sourceNodes.count(), payload.primary);
        if sourceSelection.count() != payload.indices.count()
           or payload.primary < 0
           or payload.primary >= sourceNodes.count() {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard node identities no longer match its VSCN data.");
            return false;
        }
        var sourceRoots = TopLevelIndicesFor(
            sourceNodes, sourceSelection, payload.primary);
        if sourceRoots.count() == 0 {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText("Clipboard contains no pasteable hierarchy roots.");
            return false;
        }

        var previousSelection = selectedIndices;
        var previousPrimary = selectedIndex;
        var selectionNodes: List[SceneNode] = [];
        var index = 0;
        while index < sourceSelection.count() {
            selectionNodes.add(
                sourceNodes.get(sourceSelection.get(index)));
            index = index + 1;
        }
        var primaryNode = sourceNodes.get(payload.primary);
        var destinationParent = scene.Root;
        if selectedIndex >= 0 and selectedIndex < flatNodes.count()
           and flatNodes.get(selectedIndex).Parent != null {
            destinationParent = flatNodes.get(selectedIndex).Parent;
        }

        index = 0;
        while index < sourceRoots.count() {
            var rootIndex = sourceRoots.get(index);
            var rootNode = sourceNodes.get(rootIndex);
            var sourceParent = rootNode.Parent;
            if sourceParent == null {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "Clipboard hierarchy had no valid parent.");
                return false;
            }
            sourceParent.RemoveChild(rootNode);
            rootNode.Name = UniqueDuplicateNodeName(rootNode);
            var position = rootNode.Position;
            rootNode.SetPosition(
                position.X + 1.0, position.Y, position.Z);
            if destinationParent.TryAddChild(rootNode) == false {
                RollBackGroupEdit(
                    previousSelection, previousPrimary,
                    "Studio could not attach every pasted subtree. "
                    + "The document was restored.");
                return false;
            }
            index = index + 1;
        }
        if scene.NodeCount - 1 > MAX_EDITOR_NODES {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Pasting this hierarchy would exceed Studio's "
                + MAX_EDITOR_NODES + "-node editing limit.");
            return false;
        }

        // Resolve selection identities before serialization. The canonical
        // VSCN is reloaded below so the active edit graph is independent from
        // the temporary clipboard graph and its retained shared resources.
        var destinationNodes = FlattenGraph(scene);
        var pastedIndices: List[Integer] = [];
        index = 0;
        while index < selectionNodes.count() {
            var pastedIndex = FindNodeIndex(
                destinationNodes, selectionNodes.get(index));
            if pastedIndex >= 0 { pastedIndices.add(pastedIndex); }
            index = index + 1;
        }
        var pastedPrimary = FindNodeIndex(
            destinationNodes, primaryNode);
        if pastedPrimary < 0 and pastedIndices.count() > 0 {
            pastedPrimary = pastedIndices.get(0);
        }
        if pastedIndices.count() != selectionNodes.count()
           or pastedPrimary < 0 {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not retain the pasted hierarchy selection.");
            return false;
        }

        var message = "Pasted " + sourceRoots.count()
            + " hierarchy root(s)";
        if CommitScene(message) == false {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The pasted hierarchy could not be committed.");
            return false;
        }
        var acceptedDoc = currentDoc;
        if acceptedDoc == null {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "The pasted hierarchy lost its destination document.");
            return false;
        }
        LoadDocumentModel(acceptedDoc, true);
        if scene == null {
            RollBackGroupEdit(
                previousSelection, previousPrimary,
                "Studio could not reload the accepted pasted hierarchy.");
            return false;
        }
        SelectSceneNodes(pastedIndices, pastedPrimary);
        detailLabel.SetText("");
        return pastedIndices.count() > 0;
    }

    /// @brief Expand every retained ancestor and scroll the primary into view.
    hide func RevealHierarchyTreeSelection() {
        if hierarchyTree == null { return; }
        if selectedIndex >= 0 and selectedIndex < flatNodes.count() {
            var parent = flatNodes.get(selectedIndex).Parent;
            var steps = 0;
            while parent != null and steps <= flatNodes.count() {
                if scene != null and parent == scene.Root { break; }
                var parentIndex = FindNodeIndex(flatNodes, parent);
                if parentIndex < 0
                   or parentIndex >= hierarchyTreeNodes.count() {
                    break;
                }
                hierarchyTree.Expand(
                    hierarchyTreeNodes.get(parentIndex));
                parent = parent.Parent;
                steps = steps + 1;
            }
        }
        RestoreHierarchyTreeSelection();
        if selectedIndex >= 0
           and selectedIndex < hierarchyTreeNodes.count()
           and hierarchyTreeNodes.get(selectedIndex) != null {
            hierarchyTree.ScrollTo(
                hierarchyTreeNodes.get(selectedIndex));
        }
    }

    /// @brief Restore all retained hierarchy rows while keeping one primary.
    hide func RestoreHierarchyTreeSelection() {
        if hierarchyTree == null { return; }
        hierarchyTree.Select(null);
        var index = 0;
        while index < selectedIndices.count() {
            var selected = selectedIndices.get(index);
            if selected != selectedIndex
               and selected >= 0
               and selected < hierarchyTreeNodes.count() {
                hierarchyTree.Select(hierarchyTreeNodes.get(selected));
            }
            index = index + 1;
        }
        if selectedIndex >= 0
           and selectedIndex < hierarchyTreeNodes.count() {
            hierarchyTree.Select(hierarchyTreeNodes.get(selectedIndex));
        }
    }

    /// @brief Resolve the current dropdown row to its flattened target identity.
    hide func SelectedParentTargetIndex() -> Integer {
        if parentDropdown == null
           or parentDropdown.Selected < 0
           or parentDropdown.Selected >= parentTargetIndices.count() {
            return PARENT_TARGET_MIXED;
        }
        return parentTargetIndices.get(parentDropdown.Selected);
    }

    /// @brief Select one currently offered parent target by stable node index.
    /// @details This mirrors a dropdown choice for command/probe callers without
    ///          synthesizing native pointer input. It never changes scene data.
    expose func SelectParentTarget(targetIndex: Integer) -> Boolean {
        if parentDropdown == null { return false; }
        var option = 0;
        while option < parentTargetIndices.count() {
            if parentTargetIndices.get(option) == targetIndex {
                parentDropdown.SetSelected(option);
                UpdateParentControlAvailability();
                return true;
            }
            option = option + 1;
        }
        return false;
    }

    /// @brief Resolve -1/root or one current flattened hierarchy target.
    hide func ParentTargetNode(targetIndex: Integer) -> SceneNode {
        if scene == null { return null; }
        if targetIndex == -1 { return scene.Root; }
        if targetIndex >= 0 and targetIndex < flatNodes.count() {
            return flatNodes.get(targetIndex);
        }
        return null;
    }

    /// @brief Rebuild cycle-safe parent choices from stable live node handles.
    hide func RefreshParentTargets() {
        if parentDropdown == null or reparentButton == null { return; }
        parentDropdown.Clear();
        parentTargetIndices = [];
        if scene == null or selectedIndices.count() == 0 {
            parentDropdown.SetPlaceholder("Select a node");
            parentDropdown.SetEnabled(false);
            reparentButton.SetEnabled(false);
            preserveWorldReparentCheck.SetEnabled(false);
            reparentButton.SetText("Reparent");
            return;
        }

        var roots = TopLevelSelectedNodes();
        if roots.count() == 0 {
            parentDropdown.SetPlaceholder("Select a node");
            parentDropdown.SetEnabled(false);
            reparentButton.SetEnabled(false);
            preserveWorldReparentCheck.SetEnabled(false);
            return;
        }
        var commonParent = scene_hierarchy_3d.CommonParent(roots);
        var mixedParents = commonParent == null and roots.count() > 1;
        var selectedOption = -1;
        if mixedParents {
            parentDropdown.AddItem("Multiple parents — choose target");
            parentTargetIndices.add(PARENT_TARGET_MIXED);
            selectedOption = 0;
        }

        if scene_hierarchy_3d.TargetAllowed(scene.Root, roots)
           and ParentTargetFits(-1, roots) {
            var option = parentDropdown.AddItem("Scene root");
            parentTargetIndices.add(-1);
            if mixedParents == false
               and (commonParent == scene.Root or commonParent == null) {
                selectedOption = option;
            }
        }

        var candidateIndex = 0;
        while candidateIndex < flatNodes.count() {
            var candidate = flatNodes.get(candidateIndex);
            if scene_hierarchy_3d.TargetAllowed(candidate, roots)
               and ParentTargetFits(candidateIndex, roots) {
                var prefix = "";
                var depth = flatDepths.get(candidateIndex);
                var indent = 0;
                while indent < depth and indent < 16 {
                    prefix = prefix + "  ";
                    indent = indent + 1;
                }
                var option = parentDropdown.AddItem(
                    prefix + NodeDisplayName(candidate));
                parentTargetIndices.add(candidateIndex);
                if mixedParents == false and commonParent == candidate {
                    selectedOption = option;
                }
            }
            candidateIndex = candidateIndex + 1;
        }

        if selectedOption < 0 and parentTargetIndices.count() > 0 {
            selectedOption = 0;
        }
        if selectedOption >= 0 { parentDropdown.SetSelected(selectedOption); }
        parentDropdown.SetPlaceholder("Choose parent");
        UpdateParentControlAvailability();
    }

    /// @brief Enable Reparent only for a valid, changed, depth-safe target.
    hide func UpdateParentControlAvailability() {
        if parentDropdown == null or reparentButton == null { return; }
        var roots = TopLevelSelectedNodes();
        var targetIndex = SelectedParentTargetIndex();
        var target = ParentTargetNode(targetIndex);
        var available = roots.count() > 0
            and target != null
            and scene_hierarchy_3d.TargetAllowed(target, roots)
            and ParentTargetFits(targetIndex, roots)
            and scene_hierarchy_3d.AllAlreadyParented(roots, target) == false;
        parentDropdown.SetEnabled(roots.count() > 0
                                  and parentTargetIndices.count() > 0);
        preserveWorldReparentCheck.SetEnabled(roots.count() > 0);
        reparentButton.SetEnabled(available);
        reparentButton.SetText("Reparent");
        if roots.count() > 1 {
            reparentButton.SetText("Reparent (" + roots.count() + ")");
        }
        var transformMode = "local transforms stay unchanged";
        if preserveWorldReparentCheck.IsChecked() {
            transformMode =
                "world transforms stay unchanged; lossy conversions are rejected";
        }
        reparentButton.SetTooltip(
            "Move " + roots.count() + " selected hierarchy root(s) beneath "
            + "the chosen parent; " + transformMode);
    }

    /// @brief Enable ordering only for a movable contiguous sibling block.
    hide func UpdateSiblingControlAvailability() {
        if moveSiblingEarlierButton == null
           or moveSiblingLaterButton == null {
            return;
        }
        var block = SelectedSiblingBlock();
        var canMoveEarlier = false;
        var canMoveLater = false;
        if block.count() > 0 {
            var parent = block.get(0).Parent;
            var first = DirectChildIndex(parent, block.get(0));
            if first >= 0 {
                canMoveEarlier = first > 0;
                canMoveLater =
                    first + block.count() < parent.ChildCount;
            }
        }
        moveSiblingEarlierButton.SetEnabled(canMoveEarlier);
        moveSiblingLaterButton.SetEnabled(canMoveLater);
        var count = block.count();
        moveSiblingEarlierButton.SetTooltip(
            "Move " + count
            + " contiguous sibling node(s) one position earlier");
        moveSiblingLaterButton.SetTooltip(
            "Move " + count
            + " contiguous sibling node(s) one position later");
    }

    /// @brief Show only inspector groups relevant to the current selection.
    /// @details Node groups appear with a selection; single-selection groups
    ///          (metadata, camera, collider, prefab instance, probe grid,
    ///          component asset field) need exactly one node, and the prefab
    ///          group additionally needs an instance. Scene-scoped groups
    ///          (imports, bake, environment, material library) stay visible
    ///          with any loaded scene until the Object/Scene inspector tabs
    ///          give them their own surface. Pure presentation: no canonical
    ///          bytes, history, or selection state changes here.
    hide func UpdateInspectorScope() {
        if nameLabel == null { return; }
        var hasScene = scene != null;
        var hasSelection = hasScene and selectedIndices.count() > 0;
        var single = hasScene and selectedIndices.count() == 1;
        var objectTab = hasScene and inspectorSceneTab == false;
        var sceneTab = hasScene and inspectorSceneTab;
        var selectedIsInstance = false;
        if single {
            var scopeNode = SelectedNode();
            selectedIsInstance =
                scopeNode != null and scopeNode.PrefabPath != "";
        }
        var nodeScope = objectTab and hasSelection;
        var singleScope = objectTab and single;
        var selectionHasLight = SelectionHasLight();
        var selectionHasMaterial = SelectionHasMaterial();
        var singleHasCamera = false;
        var singleHasCollider = false;
        if single {
            var presenceNode = SelectedNode();
            if presenceNode != null {
                singleHasCamera = presenceNode.Camera != null;
                singleHasCollider =
                    presenceNode.MetadataHas("collider.kind");
            }
        }
        objectTabButton.SetVisible(hasScene);
        sceneTabButton.SetVisible(hasScene);
        objectTabButton.SetStyle(0);
        sceneTabButton.SetStyle(0);
        if sceneTab { sceneTabButton.SetStyle(1); }
        if objectTab { objectTabButton.SetStyle(1); }
        nameLabel.SetVisible(nodeScope);
        nameInput.SetVisible(nodeScope);
        visibleCheck.SetVisible(nodeScope);
        staticCheck.SetVisible(nodeScope);
        positionLabel.SetVisible(nodeScope);
        positionRow.SetVisible(nodeScope);
        rotationLabel.SetVisible(nodeScope);
        rotationRow.SetVisible(nodeScope);
        scaleLabel.SetVisible(nodeScope);
        scaleRow.SetVisible(nodeScope);
        // Single-node transforms commit live from the spinners; the explicit
        // relative Apply remains for deliberate multi-node batches.
        applyTransformButton.SetVisible(
            nodeScope and selectedIndices.count() > 1);
        metadataInspector.group.SetVisible(singleScope);
        componentPalette.group.SetVisible(nodeScope);
        componentAssetHost.SetVisible(singleScope);
        // Component groups appear only when the component is present; the
        // Add-component row covers creation for the absent ones.
        lightInspector.group.SetVisible(nodeScope and selectionHasLight);
        cameraInspector.group.SetVisible(singleScope and singleHasCamera);
        colliderInspector.group.SetVisible(
            singleScope and singleHasCollider);
        instanceGroup.SetVisible(objectTab and selectedIsInstance);
        materialInspector.group.SetVisible(
            nodeScope and selectionHasMaterial);
        probeGroup.SetVisible(singleScope);
        addComponentRow.SetVisible(
            nodeScope and addComponentKinds.count() > 0);
        importGroup.SetVisible(sceneTab);
        bakeGroup.SetVisible(sceneTab);
        historyGroup.SetVisible(sceneTab);
        envGroup.SetVisible(sceneTab);
        materialLibraryGroup.SetVisible(sceneTab);
        // Programmatic visibility toggles advance widget revisions; re-baseline
        // the write-through checkbox trackers so scoping can never masquerade
        // as a user resolving the Visible or Static state onto the selection.
        visibleRevision = visibleCheck.GetRevision();
        staticRevision = staticCheck.GetRevision();
        // Scope storms reflow the whole inspector column; force a complete
        // re-measure/arrange/repaint so no child keeps partial-pass geometry.
        if inspectorScroll != null {
            inspectorScroll.InvalidateLayout();
            inspectorScroll.InvalidatePaint();
        }
    }

    /// @brief Choose the Object or Scene inspector tab (workspace-only).
    /// @details Selection changes auto-follow: selecting nodes returns to
    ///          Object, clearing the selection returns to Scene.
    expose func SetInspectorSceneTab(sceneTab: Boolean) {
        if inspectorSceneTab == sceneTab { return; }
        inspectorSceneTab = sceneTab;
        UpdateInspectorScope();
    }

    /// @brief Return whether any selected node carries a Light component.
    hide func SelectionHasLight() -> Boolean {
        var index = 0;
        while index < selectedIndices.count() {
            var flat = selectedIndices.get(index);
            if flat >= 0 and flat < flatNodes.count()
               and flatNodes.get(flat).Light != null {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /// @brief Return whether any selected node carries a Material component.
    hide func SelectionHasMaterial() -> Boolean {
        var index = 0;
        while index < selectedIndices.count() {
            var flat = selectedIndices.get(index);
            if flat >= 0 and flat < flatNodes.count()
               and flatNodes.get(flat).Material != null {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /// @brief Rebuild the addable built-in component choices for the selection.
    /// @details Light and Material are addable when at least one selected node
    ///          lacks them; Camera and Collider need exactly one node without
    ///          the component. Project schema components keep their own group.
    hide func RefreshAddComponentChoices() {
        if addComponentDropdown == null { return; }
        addComponentKinds = [];
        addComponentDropdown.Clear();
        if scene == null or selectedIndices.count() == 0 { return; }
        var single = selectedIndices.count() == 1;
        var singleNode = SelectedNode();
        var lacksLight = false;
        var lacksMaterial = false;
        var index = 0;
        while index < selectedIndices.count() {
            var flat = selectedIndices.get(index);
            if flat >= 0 and flat < flatNodes.count() {
                if flatNodes.get(flat).Light == null { lacksLight = true; }
                if flatNodes.get(flat).Material == null {
                    lacksMaterial = true;
                }
            }
            index = index + 1;
        }
        if lacksLight {
            addComponentDropdown.AddItem("Light");
            addComponentKinds.add(ADD_COMPONENT_LIGHT);
        }
        if lacksMaterial {
            addComponentDropdown.AddItem("Material");
            addComponentKinds.add(ADD_COMPONENT_MATERIAL);
        }
        if single and singleNode != null and singleNode.Camera == null {
            addComponentDropdown.AddItem("Camera");
            addComponentKinds.add(ADD_COMPONENT_CAMERA);
        }
        if single and singleNode != null
           and singleNode.MetadataHas("collider.kind") == false {
            addComponentDropdown.AddItem("Collider");
            addComponentKinds.add(ADD_COMPONENT_COLLIDER);
        }
        if addComponentKinds.count() > 0 {
            addComponentDropdown.SetSelected(0);
        }
    }

    /// @brief Return whether a spinner value differs beyond display noise.
    hide func TransformValueDiffers(spinnerValue: Number,
                                    nodeValue: Number,
                                    epsilon: Number) -> Boolean {
        var delta = spinnerValue - nodeValue;
        if delta < 0.0 { delta = 0.0 - delta; }
        return delta > epsilon;
    }

    /// @brief Consume stale transform-spinner change edges after programmatic
    ///        SetValue refreshes so they cannot masquerade as user edits.
    hide func DrainTransformSpinnerEdges() {
        if positionX == null { return; }
        positionX.WasChanged();
        positionY.WasChanged();
        positionZ.WasChanged();
        rotationX.WasChanged();
        rotationY.WasChanged();
        rotationZ.WasChanged();
        scaleX.WasChanged();
        scaleY.WasChanged();
        scaleZ.WasChanged();
    }

    /// @brief Live single-node transform editing with one commit per gesture.
    /// @details Spinner changes mutate the live node immediately, matching
    ///          the gizmo-drag preview model; the edit serializes exactly
    ///          once when the transform spinners lose keyboard focus, and
    ///          Escape while editing restores the captured values without
    ///          creating history. Multi-selections keep the explicit
    ///          relative Apply button, whose semantics are deliberate.
    /// @return True when one canonical transaction committed this frame.
    hide func PumpTransformDraft() -> Boolean {
        if gizmoDragAxis != GIZMO_AXIS_NONE or flyActive {
            return false;
        }
        if scene == null or selectedIndices.count() != 1 {
            transformDraftActive = false;
            return false;
        }
        var node = SelectedNode();
        if node == null {
            transformDraftActive = false;
            return false;
        }
        var edited = positionX.WasChanged() or positionY.WasChanged()
            or positionZ.WasChanged() or rotationX.WasChanged()
            or rotationY.WasChanged() or rotationZ.WasChanged()
            or scaleX.WasChanged() or scaleY.WasChanged()
            or scaleZ.WasChanged();
        if edited {
            // Only value changes that actually differ from the live node are
            // user edits, and only differing groups re-apply: re-applying an
            // untouched rotation would silently perturb the quaternion
            // through the lossy euler round trip and fold that drift into
            // the next unrelated commit.
            var positionNow = node.Position;
            var eulerNow = QuaternionToEulerDegrees(node.Rotation);
            var scaleNow = node.Scale;
            var positionEdited =
                TransformValueDiffers(positionX.Value, positionNow.X, 0.0005)
                or TransformValueDiffers(
                    positionY.Value, positionNow.Y, 0.0005)
                or TransformValueDiffers(
                    positionZ.Value, positionNow.Z, 0.0005);
            var rotationEdited =
                TransformValueDiffers(rotationX.Value, eulerNow.X, 0.01)
                or TransformValueDiffers(rotationY.Value, eulerNow.Y, 0.01)
                or TransformValueDiffers(rotationZ.Value, eulerNow.Z, 0.01);
            var scaleEdited =
                TransformValueDiffers(scaleX.Value, scaleNow.X, 0.0005)
                or TransformValueDiffers(scaleY.Value, scaleNow.Y, 0.0005)
                or TransformValueDiffers(scaleZ.Value, scaleNow.Z, 0.0005);
            if positionEdited or rotationEdited or scaleEdited {
                if transformDraftActive == false {
                    transformDraftActive = true;
                    draftOriginPX = positionNow.X;
                    draftOriginPY = positionNow.Y;
                    draftOriginPZ = positionNow.Z;
                    draftOriginRX = eulerNow.X;
                    draftOriginRY = eulerNow.Y;
                    draftOriginRZ = eulerNow.Z;
                    draftOriginSX = scaleNow.X;
                    draftOriginSY = scaleNow.Y;
                    draftOriginSZ = scaleNow.Z;
                }
                if positionEdited {
                    ApplyNodeTransformValues(
                        node, GIZMO_MODE_MOVE,
                        positionX.Value, positionY.Value, positionZ.Value);
                }
                if rotationEdited {
                    ApplyNodeTransformValues(
                        node, GIZMO_MODE_ROTATE,
                        rotationX.Value, rotationY.Value, rotationZ.Value);
                }
                if scaleEdited {
                    ApplyNodeTransformValues(
                        node, GIZMO_MODE_SCALE,
                        scaleX.Value, scaleY.Value, scaleZ.Value);
                }
                renderDirty = true;
            }
        }
        if transformDraftActive == false { return false; }
        var editingFocused = positionX.IsFocused()
            or positionY.IsFocused() or positionZ.IsFocused()
            or rotationX.IsFocused() or rotationY.IsFocused()
            or rotationZ.IsFocused() or scaleX.IsFocused()
            or scaleY.IsFocused() or scaleZ.IsFocused();
        if editingFocused
           and Input.Keyboard.WasPressed(Input.Key.Escape) {
            ApplyNodeTransformValues(
                node, GIZMO_MODE_MOVE,
                draftOriginPX, draftOriginPY, draftOriginPZ);
            ApplyNodeTransformValues(
                node, GIZMO_MODE_ROTATE,
                draftOriginRX, draftOriginRY, draftOriginRZ);
            ApplyNodeTransformValues(
                node, GIZMO_MODE_SCALE,
                draftOriginSX, draftOriginSY, draftOriginSZ);
            transformDraftActive = false;
            RefreshSelectedFields();
            renderDirty = true;
            toolbarStatus.SetText("Transform edit canceled");
            return false;
        }
        // A completed value scrub commits its gesture immediately, mirroring
        // gizmo-drag release; typed edits still commit when focus leaves.
        var scrubFinished = positionX.WasScrubFinished()
            or positionY.WasScrubFinished() or positionZ.WasScrubFinished()
            or rotationX.WasScrubFinished() or rotationY.WasScrubFinished()
            or rotationZ.WasScrubFinished() or scaleX.WasScrubFinished()
            or scaleY.WasScrubFinished() or scaleZ.WasScrubFinished();
        if editingFocused and scrubFinished == false { return false; }
        transformDraftActive = false;
        return CommitScene("Edited node transform");
    }

    /// @brief The number of addable built-in component choices (probe surface).
    expose func AddComponentChoiceCount() -> Integer {
        return addComponentKinds.count();
    }

    /// @brief The ADD_COMPONENT_* kind at one dropdown row (probe surface).
    expose func AddComponentKindAt(index: Integer) -> Integer {
        if index < 0 or index >= addComponentKinds.count() { return -1; }
        return addComponentKinds.get(index);
    }

    /// @brief Create the chosen built-in component with defaults.
    /// @return True when one canonical transaction committed.
    expose func AddSelectedComponentChoice() -> Boolean {
        var choice = addComponentDropdown.Selected;
        if choice < 0 or choice >= addComponentKinds.count() {
            return false;
        }
        var kind = addComponentKinds.get(choice);
        var changed = false;
        if kind == ADD_COMPONENT_LIGHT {
            changed = CreateLightsOnSelection(
                new scene_light_3d.LightState3D());
        } else if kind == ADD_COMPONENT_MATERIAL {
            changed = ApplySelectedMaterialFromControls();
        } else if kind == ADD_COMPONENT_CAMERA {
            changed = ApplyNodeCamera(
                selectedIndex, new scene_camera_3d.CameraState3D());
        } else if kind == ADD_COMPONENT_COLLIDER {
            var colliderState = new scene_collider_3d.ColliderState3D();
            colliderState.kind = scene_collider_3d.COLLIDER_BOX;
            changed = ApplyNodeCollider(selectedIndex, colliderState);
        }
        if changed { RefreshSelectedFields(); }
        return changed;
    }

    hide func RefreshSelectedFields() {
        var node = SelectedNode();
        // Auto-follow the Object/Scene tab on selection-presence changes
        // only, so a manual tab choice survives ordinary refreshes.
        var scopeHasSelection = selectedIndices.count() > 0;
        if scopeHasSelection != inspectorAutoFollowHadSelection {
            inspectorAutoFollowHadSelection = scopeHasSelection;
            inspectorSceneTab = scopeHasSelection == false;
        }
        RefreshParentTargets();
        UpdateSiblingControlAvailability();
        RefreshComponentPalette();
        RefreshAddComponentChoices();
        UpdateInspectorScope();
        if node == null {
            nameInput.SetText("");
            visibleCheck.SetIndeterminate(false);
            visibleCheck.SetChecked(false);
            visibleRevision = visibleCheck.GetRevision();
            positionX.SetValue(0.0);
            positionY.SetValue(0.0);
            positionZ.SetValue(0.0);
            rotationX.SetValue(0.0);
            rotationY.SetValue(0.0);
            rotationZ.SetValue(0.0);
            scaleX.SetValue(1.0);
            scaleY.SetValue(1.0);
            scaleZ.SetValue(1.0);
            selectionInfo.SetText("No node selected");
            RefreshMetadataFields(null);
            RefreshLightFields(null);
            RefreshCameraFields(null);
            RefreshColliderFields(null);
            RefreshInstanceControls(null);
            RefreshMaterialFields(null);
            return;
        }
        if selectedIndices.count() > 1 {
            nameInput.SetText("");
            nameInput.SetPlaceholder(
                selectedIndices.count() + " nodes selected");
            var allVisible = true;
            var allHidden = true;
            var visibilityIndex = 0;
            while visibilityIndex < selectedIndices.count() {
                if flatNodes.get(
                       selectedIndices.get(visibilityIndex)).Visible {
                    allHidden = false;
                } else {
                    allVisible = false;
                }
                visibilityIndex = visibilityIndex + 1;
            }
            if allVisible {
                visibleCheck.SetChecked(true);
            } else if allHidden {
                visibleCheck.SetChecked(false);
            } else {
                visibleCheck.SetIndeterminate(true);
            }
            visibleCheck.SetTooltip(
                "Set visibility for all "
                + selectedIndices.count() + " selected nodes");
            visibleRevision = visibleCheck.GetRevision();
            var allStatic = true;
            var allDynamic = true;
            var staticIndex = 0;
            while staticIndex < selectedIndices.count() {
                if flatNodes.get(
                       selectedIndices.get(staticIndex)).GetStatic() {
                    allDynamic = false;
                } else {
                    allStatic = false;
                }
                staticIndex = staticIndex + 1;
            }
            if allStatic {
                staticCheck.SetChecked(true);
            } else if allDynamic {
                staticCheck.SetChecked(false);
            } else {
                staticCheck.SetIndeterminate(true);
            }
            staticCheck.SetTooltip(
                "Mark all " + selectedIndices.count()
                + " selected nodes as bake participants");
            staticRevision = staticCheck.GetRevision();
            positionX.SetValue(0.0);
            positionY.SetValue(0.0);
            positionZ.SetValue(0.0);
            rotationX.SetValue(0.0);
            rotationY.SetValue(0.0);
            rotationZ.SetValue(0.0);
            scaleX.SetValue(1.0);
            scaleY.SetValue(1.0);
            scaleZ.SetValue(1.0);
            selectionInfo.SetText(
                selectedIndices.count() + " nodes selected  |  primary "
                + NodeDisplayName(node)
                + "  |  inspector adds position/rotation and multiplies "
                + "scale for the group");
            RefreshMetadataFields(node);
            RefreshLightFields(node);
            RefreshCameraFields(node);
            RefreshColliderFields(node);
            RefreshInstanceControls(node);
            RefreshMaterialFields(null);
            return;
        }
        nameInput.SetPlaceholder("Node name");
        nameInput.SetText(node.Name);
        visibleCheck.SetChecked(node.Visible);
        visibleCheck.SetTooltip("Set this node's visibility");
        visibleRevision = visibleCheck.GetRevision();
        staticCheck.SetChecked(node.GetStatic());
        staticRevision = staticCheck.GetRevision();
        var position = node.Position;
        positionX.SetValue(position.X);
        positionY.SetValue(position.Y);
        positionZ.SetValue(position.Z);
        var rotation = node.Rotation;
        var euler = QuaternionToEulerDegrees(rotation);
        rotationX.SetValue(euler.X);
        rotationY.SetValue(euler.Y);
        rotationZ.SetValue(euler.Z);
        var scale = node.Scale;
        scaleX.SetValue(scale.X);
        scaleY.SetValue(scale.Y);
        scaleZ.SetValue(scale.Z);
        var kind = "empty";
        if node.Mesh != null { kind = "mesh"; }
        var materialState = "no material";
        if node.Material != null { materialState = "material"; }
        var lightState = "no light";
        if node.Light != null {
            lightState =
                scene_light_3d.TypeName(node.Light.Type) + " light";
        }
        var cameraState = "no camera";
        if node.Camera != null { cameraState = "camera"; }
        selectionInfo.SetText(
            kind + " node  |  children " + node.ChildCount
            + "  |  " + lightState
            + "  |  " + cameraState
            + "  |  " + materialState + "  |  local transform");
        RefreshMetadataFields(node);
        RefreshLightFields(node);
        RefreshCameraFields(node);
        RefreshColliderFields(node);
        RefreshInstanceControls(node);
        RefreshMaterialFields(node);
    }

    hide func QuaternionToEulerDegrees(rotation: Quat) -> Vec3 {
        if rotation == null { return Vec3.New(0.0, 0.0, 0.0); }
        var x = rotation.X;
        var y = rotation.Y;
        var z = rotation.Z;
        var w = rotation.W;
        var pitch = Math.Atan2(
            2.0 * (w * x + y * z),
            1.0 - 2.0 * (x * x + y * y));
        var yaw = Math.Asin(Math.Clamp(
            2.0 * (w * y - z * x), -1.0, 1.0));
        var roll = Math.Atan2(
            2.0 * (w * z + x * y),
            1.0 - 2.0 * (y * y + z * z));
        return Vec3.New(
            pitch * RAD_TO_DEG,
            yaw * RAD_TO_DEG,
            roll * RAD_TO_DEG);
    }

    hide func RefreshHierarchy(preferred: SceneNode) {
        CaptureHierarchyExpansion();
        flatNodes = [];
        flatDepths = [];
        flatPaths = [];
        hierarchyTreeNodes = [];
        hierarchyTree.Clear();
        hierarchyTree.PruneRetiredNodes();
        hierarchyClipped = false;
        hierarchyPreferredNode = preferred;
        if scene != null {
            var sceneRoot = scene.Root;
            var child = 0;
            while child < sceneRoot.ChildCount
                  and flatNodes.count() < MAX_EDITOR_NODES {
                AppendHierarchy(
                    sceneRoot.GetChild(child), 0, "" + child, null);
                child = child + 1;
            }
            if child < sceneRoot.ChildCount { hierarchyClipped = true; }
            hierarchySceneRoot = sceneRoot;
        } else {
            hierarchySceneRoot = null;
        }
        ReconcilePickLocksAfterHierarchyRefresh();
        RefreshHierarchyRowLabels();
        hierarchyDocument = currentDoc;

        var i = 0;
        var preferredIndex = -1;
        while i < flatNodes.count() {
            var node = flatNodes.get(i);
            if preferred != null and node == preferred { preferredIndex = i; }
            i = i + 1;
        }
        if preferredIndex >= 0 {
            selectedIndex = preferredIndex;
            selectedIndices = scene_selection.Single(
                preferredIndex, flatNodes.count());
        } else if selectedIndex >= flatNodes.count() {
            selectedIndex = -1;
            selectedIndices = [];
        } else {
            selectedIndices = scene_selection.Normalize(
                selectedIndices, flatNodes.count(), selectedIndex);
            if selectedIndex < 0 and selectedIndices.count() > 0 {
                selectedIndex = selectedIndices.get(0);
            }
        }
        RevealHierarchyTreeSelection();
        RefreshHierarchySearch(false);
        hierarchyPreferredNode = null;
        hierarchyExpandedNodes = [];
        hierarchyExpandedPaths = [];
        hierarchyPickLockedNodes = [];
        RefreshSelectedFields();
        SetEditorControlsEnabled(scene != null);
        RebuildProjectNodePreviews();
        renderDirty = true;
    }

    /// @brief Snapshot expanded identities before rebuilding retained rows.
    /// @details Live graph refreshes match node identity, while canonical
    ///          reloads fall back to structural paths. First presentation
    ///          expands the complete bounded hierarchy for discoverability.
    hide func CaptureHierarchyExpansion() {
        hierarchyExpandedNodes = [];
        hierarchyExpandedPaths = [];
        hierarchyPickLockedNodes = [];
        var sameDocument =
            currentDoc != null and hierarchyDocument == currentDoc;
        hierarchyPreserveExpansionByIdentity =
            sameDocument and scene != null and hierarchySceneRoot != null
            and hierarchySceneRoot == scene.Root;
        hierarchyExpandByDefault =
            hierarchyTreeNodes.count() == 0 or sameDocument == false;
        if sameDocument == false { return; }
        var index = 0;
        while index < hierarchyTreeNodes.count()
              and index < flatNodes.count()
              and index < flatPaths.count() {
            var treeNode = hierarchyTreeNodes.get(index);
            if treeNode != null
               and GUI.TreeView.Node.IsExpanded(treeNode) {
                hierarchyExpandedNodes.add(flatNodes.get(index));
                hierarchyExpandedPaths.add(flatPaths.get(index));
            }
            if hierarchyPreserveExpansionByIdentity
               and PickLockedPath(flatPaths.get(index)) {
                hierarchyPickLockedNodes.add(flatNodes.get(index));
            }
            index = index + 1;
        }
    }

    /// @brief Return whether one node is the candidate or its ancestor.
    hide func HierarchyContains(node: SceneNode,
                                candidate: SceneNode) -> Boolean {
        if node == null or candidate == null { return false; }
        var current = candidate;
        while current != null {
            if current == node { return true; }
            current = current.Parent;
        }
        return false;
    }

    hide func ExpandedPathContains(path: String) -> Boolean {
        var index = 0;
        while index < hierarchyExpandedPaths.count() {
            if hierarchyExpandedPaths.get(index) == path { return true; }
            index = index + 1;
        }
        return false;
    }

    /// @brief Return whether an exact bounded hierarchy path is pick-locked.
    hide func PickLockedPath(path: String) -> Boolean {
        var index = 0;
        while index < pickLockedPaths.count() {
            if pickLockedPaths.get(index) == path { return true; }
            index = index + 1;
        }
        return false;
    }

    hide func StringListContains(values: List[String],
                                 value: String) -> Boolean {
        var index = 0;
        while index < values.count() {
            if values.get(index) == value { return true; }
            index = index + 1;
        }
        return false;
    }

    hide func FlatPathIndex(path: String) -> Integer {
        var index = 0;
        while index < flatPaths.count() {
            if flatPaths.get(index) == path { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Rebind workspace locks safely after one hierarchy rebuild.
    /// @details Live graph edits follow SceneNode identity so reordered or
    ///          deleted paths cannot transfer a lock to another node.
    ///          Canonical reloads have new identities and retain only exact,
    ///          still-existing paths from the document's workspace state.
    hide func ReconcilePickLocksAfterHierarchyRefresh() {
        var reconciled: List[String] = [];
        if hierarchyPreserveExpansionByIdentity {
            var nodeIndex = 0;
            while nodeIndex < hierarchyPickLockedNodes.count()
                  and reconciled.count() < MAX_EDITOR_NODES {
                var flatIndex = FindFlatIndex(
                    hierarchyPickLockedNodes.get(nodeIndex));
                if flatIndex >= 0 and flatIndex < flatPaths.count() {
                    var mappedPath = flatPaths.get(flatIndex);
                    if StringListContains(reconciled, mappedPath) == false {
                        reconciled.add(mappedPath);
                    }
                }
                nodeIndex = nodeIndex + 1;
            }
        } else {
            var lockIndex = 0;
            while lockIndex < pickLockedPaths.count()
                  and reconciled.count() < MAX_EDITOR_NODES {
                var path = pickLockedPaths.get(lockIndex);
                if FlatPathIndex(path) >= 0
                   and StringListContains(reconciled, path) == false {
                    reconciled.add(path);
                }
                lockIndex = lockIndex + 1;
            }
        }
        pickLockedPaths = reconciled;
        if currentDoc != null and currentDoc.scene3DWorkspace != null {
            currentDoc.scene3DWorkspace.pickLockedPaths =
                pickLockedPaths;
        }
    }

    /// @brief Decide expansion without confusing reordered live nodes by path.
    hide func ShouldExpandHierarchyNode(node: SceneNode,
                                        path: String) -> Boolean {
        if node == null or node.ChildCount == 0 { return false; }
        if hierarchyPreferredNode != null
           and HierarchyContains(node, hierarchyPreferredNode) {
            return true;
        }
        if hierarchyExpandByDefault { return true; }
        if hierarchyPreserveExpansionByIdentity {
            return FindNodeIndex(hierarchyExpandedNodes, node) >= 0;
        }
        return ExpandedPathContains(path);
    }

    /// @brief Compose one hierarchy row's visibility, name, and component cues.
    hide func HierarchyRowLabel(node: SceneNode,
                                path: String) -> String {
        if node == null { return "○ (missing)"; }
        var visibleMarker = "○ ";
        if node.Visible { visibleMarker = "● "; }
        var componentMarker = "";
        if node.Mesh != null { componentMarker = " [mesh]"; }
        if node.Material != null {
            componentMarker = componentMarker + " [mat]";
        }
        if node.Light != null {
            componentMarker = componentMarker + " [light]";
        }
        if node.Camera != null {
            componentMarker = componentMarker + " [camera]";
        }
        if node.PrefabPath != "" {
            componentMarker = componentMarker + " [prefab]";
        } else if node.IsInstanceContent {
            componentMarker = componentMarker + " [instance]";
        }
        var gameplayBadge = NodeComponentBadge(node);
        if gameplayBadge != "" {
            componentMarker = componentMarker
                + " [" + gameplayBadge + "]";
        }
        var name = node.Name;
        if name == "" { name = "(unnamed)"; }
        var lockMarker = "";
        if PickLockedPath(path) { lockMarker = "  ⊘"; }
        return visibleMarker + name + lockMarker + componentMarker;
    }

    /// @brief Refresh retained row labels without disturbing tree identity.
    hide func RefreshHierarchyRowLabels() {
        var index = 0;
        while index < hierarchyTreeNodes.count()
              and index < flatNodes.count()
              and index < flatPaths.count() {
            var treeNode = hierarchyTreeNodes.get(index);
            if treeNode != null {
                GUI.TreeView.Node.SetText(
                    treeNode,
                    HierarchyRowLabel(
                        flatNodes.get(index), flatPaths.get(index)));
            }
            index = index + 1;
        }
    }

    /// @brief Append one true retained parent/child row and its bounded subtree.
    hide func AppendHierarchy(node: SceneNode,
                              depth: Integer,
                              path: String,
                              parentTreeNode: Any) {
        if node == null { return; }
        if flatNodes.count() >= MAX_EDITOR_NODES
           or depth > MAX_HIERARCHY_DEPTH {
            hierarchyClipped = true;
            return;
        }
        var treeNode = hierarchyTree.AddNode(
            parentTreeNode,
            HierarchyRowLabel(node, path));
        if treeNode == null {
            hierarchyClipped = true;
            return;
        }
        GUI.TreeView.Node.SetData(treeNode, "" + flatNodes.count());
        GUI.TreeView.Node.SetStableId(treeNode, path);
        var icon = "◇";
        if node.PrefabPath != "" { icon = "⬒"; }
        else if node.Mesh != null { icon = "◆"; }
        else if node.Light != null { icon = "✦"; }
        else if node.Camera != null { icon = "▣"; }
        GUI.TreeView.Node.SetIcon(treeNode, icon);
        flatNodes.add(node);
        flatDepths.add(depth);
        flatPaths.add(path);
        hierarchyTreeNodes.add(treeNode);
        var child = 0;
        while child < node.ChildCount
              and flatNodes.count() < MAX_EDITOR_NODES {
            AppendHierarchy(
                node.GetChild(child),
                depth + 1,
                path + "/" + child,
                treeNode);
            child = child + 1;
        }
        if child < node.ChildCount { hierarchyClipped = true; }
        if ShouldExpandHierarchyNode(node, path) {
            hierarchyTree.Expand(treeNode);
        }
    }

    expose func FrameAll() {
        ReleaseGameplayViewAnchor();
        if flatNodes.count() == 0 {
            viewScale = 28;
            viewTargetX = 0.0;
            viewTargetY = 0.0;
            viewTargetZ = 0.0;
            return;
        }
        var first = flatNodes.get(0).WorldPosition;
        var minimumX = first.X;
        var minimumY = first.Y;
        var minimumZ = first.Z;
        var maximumX = first.X;
        var maximumY = first.Y;
        var maximumZ = first.Z;
        var i = 0;
        while i < flatNodes.count() {
            var p = flatNodes.get(i).WorldPosition;
            if p.X < minimumX { minimumX = p.X; }
            if p.Y < minimumY { minimumY = p.Y; }
            if p.Z < minimumZ { minimumZ = p.Z; }
            if p.X > maximumX { maximumX = p.X; }
            if p.Y > maximumY { maximumY = p.Y; }
            if p.Z > maximumZ { maximumZ = p.Z; }
            i = i + 1;
        }
        viewTargetX = (minimumX + maximumX) * 0.5;
        viewTargetY = (minimumY + maximumY) * 0.5;
        viewTargetZ = (minimumZ + maximumZ) * 0.5;

        var furthest = 1.0;
        i = 0;
        while i < flatNodes.count() {
            var p = flatNodes.get(i).WorldPosition;
            var dx = p.X - viewTargetX;
            var dy = p.Y - viewTargetY;
            var dz = p.Z - viewTargetZ;
            var distance = Math.Sqrt(dx * dx + dy * dy + dz * dz);
            if distance > furthest { furthest = distance; }
            i = i + 1;
        }
        var available = renderedViewportWidth;
        if renderedViewportHeight < available {
            available = renderedViewportHeight;
        }
        viewScale = ClampInt3D(Convert.NumToInt(
            (available * 0.38) / furthest), 4, 120);
    }

    expose func FrameSelected() {
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return; }
        ReleaseGameplayViewAnchor();
        var first = flatNodes.get(selectedIndices.get(0)).WorldPosition;
        var minimumX = first.X;
        var minimumY = first.Y;
        var minimumZ = first.Z;
        var maximumX = first.X;
        var maximumY = first.Y;
        var maximumZ = first.Z;
        var index = 1;
        while index < selectedIndices.count() {
            var world = flatNodes.get(
                selectedIndices.get(index)).WorldPosition;
            if world.X < minimumX { minimumX = world.X; }
            if world.Y < minimumY { minimumY = world.Y; }
            if world.Z < minimumZ { minimumZ = world.Z; }
            if world.X > maximumX { maximumX = world.X; }
            if world.Y > maximumY { maximumY = world.Y; }
            if world.Z > maximumZ { maximumZ = world.Z; }
            index = index + 1;
        }
        viewTargetX = (minimumX + maximumX) * 0.5;
        viewTargetY = (minimumY + maximumY) * 0.5;
        viewTargetZ = (minimumZ + maximumZ) * 0.5;

        var furthest = 1.0;
        index = 0;
        while index < selectedIndices.count() {
            var world = flatNodes.get(
                selectedIndices.get(index)).WorldPosition;
            var dx = world.X - viewTargetX;
            var dy = world.Y - viewTargetY;
            var dz = world.Z - viewTargetZ;
            var distance = Math.Sqrt(dx * dx + dy * dy + dz * dz);
            if distance > furthest { furthest = distance; }
            index = index + 1;
        }
        var available = renderedViewportWidth;
        if renderedViewportHeight < available {
            available = renderedViewportHeight;
        }
        viewScale = ClampInt3D(Convert.NumToInt(
            (available * 0.38) / furthest), 4, 120);
        if selectedIndices.count() == 1 and viewScale < 48 {
            viewScale = 48;
        }
    }

    hide func UpdateViewportSize() {
        if viewportScroll == null { return; }
        var width = Convert.NumToInt(
            viewportScroll.GetLogicalWidth() - 2.0);
        var height = Convert.NumToInt(
            viewportScroll.GetLogicalHeight() - 2.0);
        if width <= 0 { width = DEFAULT_VIEWPORT_WIDTH; }
        if height <= 0 { height = DEFAULT_VIEWPORT_HEIGHT; }
        width = ClampInt3D(
            width, MIN_VIEWPORT_WIDTH, MAX_VIEWPORT_WIDTH);
        height = ClampInt3D(
            height, MIN_VIEWPORT_HEIGHT, MAX_VIEWPORT_HEIGHT);
        if width != renderedViewportWidth
           or height != renderedViewportHeight {
            renderedViewportWidth = width;
            renderedViewportHeight = height;
            ReanchorGameplayViewTarget();
            renderDirty = true;
        }
    }

    /// @brief Project one world point through the shared viewport camera.
    /// @details The retained render camera is the single projection authority
    ///          (ADR 0183): overlays and picking read the exact camera that
    ///          rendered the shaded frame, in both projections. The hand math
    ///          below serves surfaces with no configured camera (fallback
    ///          wireframe rendering) and mirrors the camera formulas exactly,
    ///          including the perspective divide about the derived eye.
    hide func Project(x: Number, y: Number, z: Number) -> ProjectedPoint {
        var projected = new ProjectedPoint();
        if projectionCameraReady and viewportRenderCamera != null {
            var screen = viewportRenderCamera.WorldToScreen(
                Vec3.New(x, y, z),
                renderedViewportWidth,
                renderedViewportHeight) as Vec3;
            projected.x = Convert.NumToInt(Math.Round(screen.X));
            projected.y = Convert.NumToInt(Math.Round(screen.Y));
            projected.visible = screen.Z > 0.5;
            return projected;
        }
        var yaw = viewYawDegrees * DEG_TO_RAD;
        var pitch = viewPitchDegrees * DEG_TO_RAD;
        var cosYaw = Math.Cos(yaw);
        var sinYaw = Math.Sin(yaw);
        var cosPitch = Math.Cos(pitch);
        var sinPitch = Math.Sin(pitch);
        var relativeX = x - viewTargetX;
        var relativeY = y - viewTargetY;
        var relativeZ = z - viewTargetZ;
        var rotatedX = relativeX * cosYaw - relativeZ * sinYaw;
        var rotatedZ = relativeX * sinYaw + relativeZ * cosYaw;
        var rotatedY = relativeY * cosPitch - rotatedZ * sinPitch;
        if viewPerspective {
            var towardEye =
                rotatedZ * cosPitch + relativeY * sinPitch;
            var depth = PerspectiveEyeDistance() - towardEye;
            if depth < 0.000001 {
                projected.visible = false;
                depth = 0.000001;
            }
            var focal = renderedViewportHeight
                / (2.0 * ActiveViewportFovHalfTan());
            projected.x = Convert.NumToInt(
                renderedViewportWidth / 2.0
                    + rotatedX * focal / depth);
            projected.y = Convert.NumToInt(
                renderedViewportHeight / 2.0
                    - rotatedY * focal / depth);
            return projected;
        }
        projected.x = Convert.NumToInt(
            renderedViewportWidth / 2.0 + rotatedX * viewScale);
        projected.y = Convert.NumToInt(
            renderedViewportHeight / 2.0 - rotatedY * viewScale);
        return projected;
    }

    /// @brief Return whether either side-specific Shift key is held.
    hide func ViewportShiftDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftShift)
            or Input.Keyboard.IsDown(Input.Key.RightShift);
    }

    /// @brief Return whether the conventional Control/Command key is held.
    hide func ViewportPrimaryModifierDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftControl)
            or Input.Keyboard.IsDown(Input.Key.RightControl)
            or Input.Keyboard.IsDown(Input.Key.LeftSuper)
            or Input.Keyboard.IsDown(Input.Key.RightSuper);
    }

    /// @brief Move the camera target in its exact screen-plane basis.
    /// @details Positive deltas move rendered content with the pointer. This
    ///          updates workspace state only and never commits VSCN content.
    expose func PanViewportByPixels(deltaX: Number,
                                    deltaY: Number) -> Boolean {
        var stationaryX = deltaX > -0.000001 and deltaX < 0.000001;
        var stationaryY = deltaY > -0.000001 and deltaY < 0.000001;
        if (stationaryX and stationaryY) or viewScale <= 0 {
            return false;
        }
        ReleaseGameplayViewAnchor();
        ShiftViewTargetInScreenBasis(
            (0.0 - deltaX) / viewScale,
            deltaY / viewScale);
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Translate the view target along the exact screen right/up basis.
    hide func ShiftViewTargetInScreenBasis(rightAmount: Number,
                                           upAmount: Number) {
        var yaw = viewYawDegrees * DEG_TO_RAD;
        var pitch = viewPitchDegrees * DEG_TO_RAD;
        var cosYaw = Math.Cos(yaw);
        var sinYaw = Math.Sin(yaw);
        var cosPitch = Math.Cos(pitch);
        var sinPitch = Math.Sin(pitch);
        viewTargetX = ClampNumber3D(
            viewTargetX
                + cosYaw * rightAmount
                - sinYaw * sinPitch * upAmount,
            -1000000.0, 1000000.0);
        viewTargetY = ClampNumber3D(
            viewTargetY + cosPitch * upAmount,
            -1000000.0, 1000000.0);
        viewTargetZ = ClampNumber3D(
            viewTargetZ
                - sinYaw * rightAmount
                - cosYaw * sinPitch * upAmount,
            -1000000.0, 1000000.0);
        renderDirty = true;
    }

    /// @brief Zoom one wheel step keeping the point under the pointer fixed.
    /// @details Scale change plus a target-plane shift toward the cursor is
    ///          the dolly-to-cursor contract for both projections (ADR 0183):
    ///          in perspective the derived eye distance shortens toward the
    ///          cursor ray; in ortho it is exact zoom-about-point.
    hide func DollyViewportAtPointer(direction: Integer) {
        var previousScale = viewScale;
        viewScale = ClampInt3D(viewScale + direction * 4, 4, 120);
        if viewScale == previousScale { return; }
        ReleaseGameplayViewAnchor();
        renderDirty = true;
        var mouseX = PhysicalPointerToUi(Input.Mouse.X())
            - viewportImage.GetScreenX();
        var mouseY = PhysicalPointerToUi(Input.Mouse.Y())
            - viewportImage.GetScreenY();
        var offsetX = mouseX - renderedViewportWidth / 2.0;
        var offsetY = mouseY - renderedViewportHeight / 2.0;
        var factor = 1.0 / previousScale - 1.0 / viewScale;
        ShiftViewTargetInScreenBasis(
            offsetX * factor, (0.0 - offsetY) * factor);
        CaptureWorkspaceState();
    }

    /// @brief Unit vector from the view target toward the camera eye.
    hide func ViewportEyeUnit() -> Vec3 {
        var yaw = viewYawDegrees * DEG_TO_RAD;
        var pitch = viewPitchDegrees * DEG_TO_RAD;
        return Vec3.New(
            Math.Sin(yaw) * Math.Cos(pitch),
            Math.Sin(pitch),
            Math.Cos(yaw) * Math.Cos(pitch));
    }

    /// @brief Eye distance the active projection places behind the target.
    hide func CurrentEyeDistance() -> Number {
        if viewPerspective { return PerspectiveEyeDistance(); }
        return ViewportCameraRange().X;
    }

    /// @brief Begin captured right-mouse fly-look with WASD movement.
    hide func BeginFlyNavigation() {
        ReleaseGameplayViewAnchor();
        flyActive = true;
        flyLastMs = Zanna.Time.Clock.NowMs();
        flyYawRemainder = 0.0;
        flyPitchRemainder = 0.0;
        FocusActiveGizmoButton();
        renderDirty = true;
    }

    /// @brief One frame of fly navigation; owns viewport input while active.
    /// @details Workspace-only camera motion: mouse-look about the fixed eye,
    ///          WASD in the camera basis, Q/E world down/up, Shift fast, and
    ///          the wheel retunes the bounded speed multiplier (ADR 0183).
    hide func PumpFlyFrame() {
        if Input.Keyboard.WasPressed(Input.Key.Escape)
           or Input.Mouse.IsDown(Input.Mouse.ButtonRight) == false {
            flyActive = false;
            flyLastMs = -1;
            renderDirty = true;
            CaptureWorkspaceState();
            return;
        }
        var now = Zanna.Time.Clock.NowMs();
        var deltaMs = now - flyLastMs;
        flyLastMs = now;
        if deltaMs < 0 { deltaMs = 0; }
        if deltaMs > 100 { deltaMs = 100; }
        var deltaSeconds = deltaMs / 1000.0;

        var wheel = Input.Mouse.WheelYFloat();
        if wheel > 0.0 {
            flySpeedMultiplier = ClampNumber3D(
                flySpeedMultiplier * 1.25,
                FLY_MIN_SPEED_MULTIPLIER,
                FLY_MAX_SPEED_MULTIPLIER);
        } else if wheel < 0.0 {
            flySpeedMultiplier = ClampNumber3D(
                flySpeedMultiplier / 1.25,
                FLY_MIN_SPEED_MULTIPLIER,
                FLY_MAX_SPEED_MULTIPLIER);
        }

        var changed = FlyLookByPixels(
            PhysicalPointerToUi(Input.Mouse.DeltaX()),
            PhysicalPointerToUi(Input.Mouse.DeltaY()));

        var moving = false;
        var forwardInput = 0.0;
        if Input.Keyboard.IsDown(Input.Key.W) {
            forwardInput = 1.0;
            moving = true;
        }
        if Input.Keyboard.IsDown(Input.Key.S) {
            forwardInput = forwardInput - 1.0;
            moving = true;
        }
        var rightInput = 0.0;
        if Input.Keyboard.IsDown(Input.Key.D) {
            rightInput = 1.0;
            moving = true;
        }
        if Input.Keyboard.IsDown(Input.Key.A) {
            rightInput = rightInput - 1.0;
            moving = true;
        }
        var upInput = 0.0;
        if Input.Keyboard.IsDown(Input.Key.E) {
            upInput = 1.0;
            moving = true;
        }
        if Input.Keyboard.IsDown(Input.Key.Q) {
            upInput = upInput - 1.0;
            moving = true;
        }
        if moving {
            var speed = FLY_BASE_SPEED_PER_SECOND
                * CurrentEyeDistance() * flySpeedMultiplier;
            if ViewportShiftDown() { speed = speed * FLY_FAST_MULTIPLIER; }
            var step = speed * deltaSeconds;
            var eyeUnit = ViewportEyeUnit();
            var yaw = viewYawDegrees * DEG_TO_RAD;
            var rightX = Math.Cos(yaw);
            var rightZ = 0.0 - Math.Sin(yaw);
            viewTargetX = ClampNumber3D(
                viewTargetX
                    - eyeUnit.X * forwardInput * step
                    + rightX * rightInput * step,
                -1000000.0, 1000000.0);
            viewTargetY = ClampNumber3D(
                viewTargetY
                    - eyeUnit.Y * forwardInput * step
                    + upInput * step,
                -1000000.0, 1000000.0);
            viewTargetZ = ClampNumber3D(
                viewTargetZ
                    - eyeUnit.Z * forwardInput * step
                    + rightZ * rightInput * step,
                -1000000.0, 1000000.0);
            changed = true;
        }
        if changed {
            renderDirty = true;
            CaptureWorkspaceState();
        }
    }

    /// @brief Rotate the look direction about the fixed eye (not the target).
    /// @details Integer yaw/pitch state keeps every existing viewport contract;
    ///          fractional remainders accumulate sub-degree motion so slow
    ///          mouse movement still turns smoothly.
    hide func FlyLookByPixels(deltaX: Number,
                              deltaY: Number) -> Boolean {
        var eyeDistance = CurrentEyeDistance();
        var eyeUnit = ViewportEyeUnit();
        var eyeX = viewTargetX + eyeUnit.X * eyeDistance;
        var eyeY = viewTargetY + eyeUnit.Y * eyeDistance;
        var eyeZ = viewTargetZ + eyeUnit.Z * eyeDistance;
        flyYawRemainder = flyYawRemainder
            - deltaX * FLY_LOOK_DEGREES_PER_PIXEL;
        flyPitchRemainder = flyPitchRemainder
            + deltaY * FLY_LOOK_DEGREES_PER_PIXEL;
        var yawStep = Convert.NumToInt(flyYawRemainder);
        var pitchStep = Convert.NumToInt(flyPitchRemainder);
        if yawStep == 0 and pitchStep == 0 { return false; }
        flyYawRemainder = flyYawRemainder - yawStep;
        flyPitchRemainder = flyPitchRemainder - pitchStep;
        var nextYaw = NormalizeYawDegrees(viewYawDegrees + yawStep);
        var nextPitch = ClampInt3D(
            viewPitchDegrees + pitchStep, -80, 80);
        if nextYaw == viewYawDegrees
           and nextPitch == viewPitchDegrees {
            return false;
        }
        viewYawDegrees = nextYaw;
        viewPitchDegrees = nextPitch;
        viewTargetX = ClampNumber3D(
            eyeX - ViewportEyeUnit().X * eyeDistance,
            -1000000.0, 1000000.0);
        viewTargetY = ClampNumber3D(
            eyeY - ViewportEyeUnit().Y * eyeDistance,
            -1000000.0, 1000000.0);
        viewTargetZ = ClampNumber3D(
            eyeZ - ViewportEyeUnit().Z * eyeDistance,
            -1000000.0, 1000000.0);
        return true;
    }

    /// @brief Report whether right-mouse fly navigation owns the viewport.
    expose func IsFlyNavigationActive() -> Boolean {
        return flyActive;
    }

    /// @brief Report whether the viewport fell back to marker-only drawing.
    expose func IsViewportRenderFallback() -> Boolean {
        return viewportRenderFallback;
    }

    /// @brief Switch the shared viewport camera projection; workspace-only.
    expose func SetViewProjection(perspective: Boolean) {
        if viewPerspective == perspective { return; }
        ReleaseGameplayViewAnchor();
        viewPerspective = perspective;
        UpdateProjectionControls();
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Show or hide the overlay/snap options row.
    expose func SetViewOptionsVisible(visible: Boolean) {
        viewOptionsVisible = visible;
        if viewOptionsRow != null {
            viewOptionsRow.SetVisible(viewOptionsVisible);
        }
        UpdateViewOptionsChrome();
    }

    /// @brief Reserve wrapped rows for the options row at compact widths.
    /// @details Flex cannot infer wrapped cross-axis height before its parent
    ///          assigns a width, mirroring the toolbar reservations above.
    hide func UpdateViewOptionsChrome() {
        if viewOptionsRow == null { return; }
        if viewOptionsVisible and compactLayout {
            viewOptionsRow.SetPreferredSize(0.0, 96.0);
        } else {
            viewOptionsRow.SetPreferredSize(0.0, 0.0);
        }
    }

    /// @brief Project one world point for display probes.
    /// @details Probes assert through the shared camera instead of
    ///          duplicating projection math (ADR 0183).
    expose func ProjectWorldPoint(x: Number,
                                  y: Number,
                                  z: Number) -> ProjectedPoint {
        return Project(x, y, z);
    }

    /// @brief Keep the projection toggle label naming the active mode.
    hide func UpdateProjectionControls() {
        if projectionButton == null { return; }
        if viewPerspective {
            projectionButton.SetText("Persp");
            projectionButton.SetTooltip(
                "Perspective projection (click for orthographic)");
        } else {
            projectionButton.SetText("Ortho");
            projectionButton.SetTooltip(
                "Orthographic projection (click for perspective)");
        }
    }

    /// @brief Apply overlay and snap chrome edits; all workspace-only state.
    hide func PumpViewOptionControls() {
        if gridCheck == null { return; }
        if gridCheck.WasChanged() {
            showGrid = gridCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if markersCheck.WasChanged() {
            showMarkers = markersCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if lightsCheck.WasChanged() {
            showLightOverlays = lightsCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if camerasCheck.WasChanged() {
            showCameraOverlays = camerasCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if collidersCheck.WasChanged() {
            showColliderOverlays = collidersCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if routesCheck.WasChanged() {
            showRouteOverlays = routesCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if statsCheck.WasChanged() {
            showStats = statsCheck.IsChecked();
            renderDirty = true;
            CaptureWorkspaceState();
        }
        if editorLightCheck.WasChanged() {
            editorLightAssist = editorLightCheck.IsChecked();
            renderDirty = true;
        }
        var snapChanged = false;
        if snapMoveSpinner.WasChanged() {
            snapMoveIncrement = snapMoveSpinner.Value;
            snapChanged = true;
        }
        if snapRotateSpinner.WasChanged() {
            snapRotateIncrement = snapRotateSpinner.Value;
            snapChanged = true;
        }
        if snapScaleSpinner.WasChanged() {
            snapScaleIncrement = snapScaleSpinner.Value;
            snapChanged = true;
        }
        if snapChanged {
            ApplySnapIncrements();
            renderDirty = true;
            CaptureWorkspaceState();
        }
    }

    /// @brief Push this document's bounded snap increments into the gizmos.
    /// @details The transform module holds one live set of increments, so the
    ///          active document reasserts its own on restore and edit.
    hide func ApplySnapIncrements() {
        snapMoveIncrement = scene_transform_3d.BoundSnapIncrement(
            snapMoveIncrement,
            scene_transform_3d.MAX_MOVE_SNAP_INCREMENT);
        snapRotateIncrement = scene_transform_3d.BoundSnapIncrement(
            snapRotateIncrement,
            scene_transform_3d.MAX_ROTATE_SNAP_INCREMENT);
        snapScaleIncrement = scene_transform_3d.BoundSnapIncrement(
            snapScaleIncrement,
            scene_transform_3d.MAX_SCALE_SNAP_INCREMENT);
        scene_transform_3d.SetSnapIncrements(
            snapMoveIncrement, snapRotateIncrement, snapScaleIncrement);
    }

    /// @brief Reflect restored workspace chrome into the retained controls.
    hide func SyncViewOptionControls() {
        UpdateProjectionControls();
        if gridCheck == null { return; }
        gridCheck.SetChecked(showGrid);
        markersCheck.SetChecked(showMarkers);
        lightsCheck.SetChecked(showLightOverlays);
        camerasCheck.SetChecked(showCameraOverlays);
        collidersCheck.SetChecked(showColliderOverlays);
        routesCheck.SetChecked(showRouteOverlays);
        statsCheck.SetChecked(showStats);
        snapMoveSpinner.SetValue(snapMoveIncrement);
        snapRotateSpinner.SetValue(snapRotateIncrement);
        snapScaleSpinner.SetValue(snapScaleIncrement);
        ApplySnapIncrements();
    }

    /// @brief Find the nearest bounded origin marker at one viewport point.
    hide func ViewportMarkerAt(mouseX: Integer,
                               mouseY: Integer) -> Integer {
        var best = -1;
        var bestDistance = 196;
        var index = 0;
        while index < projectedX.count()
              and index < projectedY.count()
              and index < flatNodes.count() {
            var dx = projectedX.get(index) - mouseX;
            var dy = projectedY.get(index) - mouseY;
            var distance = dx * dx + dy * dy;
            if distance < bestDistance {
                bestDistance = distance;
                best = index;
            }
            index = index + 1;
        }
        return best;
    }

    /// @brief Resolve one viewport point through visible mesh bounds then markers.
    /// @return Flattened node index, or -1 for empty viewport space.
    expose func ViewportNodeAt(mouseX: Integer,
                               mouseY: Integer) -> Integer {
        if scene == null
           or mouseX < 0 or mouseX >= renderedViewportWidth
           or mouseY < 0 or mouseY >= renderedViewportHeight {
            return -1;
        }
        if ConfigureViewportCamera() {
            var castOrigin = viewportRenderCamera.ScreenToRayOrigin(
                mouseX, mouseY,
                renderedViewportWidth, renderedViewportHeight) as Vec3;
            var direction = viewportRenderCamera.ScreenToRay(
                mouseX, mouseY,
                renderedViewportWidth, renderedViewportHeight) as Vec3;
            var previewCandidate = -1;
            var previewDistance = 1000000000.0;
            if projectPreviewScene != null {
                var previewNode =
                    projectPreviewScene.RaycastNodesPrecise(
                        castOrigin,
                        direction,
                        viewportRenderCamera.FarPlane) as SceneNode;
                var previewHit =
                    projectPreviewScene.RaycastPreciseHit(
                        castOrigin,
                        direction,
                        viewportRenderCamera.FarPlane) as RayHit3D;
                previewCandidate =
                    ProjectPreviewOwner(previewNode);
                if previewHit != null {
                    previewDistance = previewHit.Distance;
                }
                if previewCandidate >= 0
                   and NodePickLocked(previewCandidate) == false {
                    var sceneHit = scene.RaycastPreciseHit(
                        castOrigin,
                        direction,
                        viewportRenderCamera.FarPlane) as RayHit3D;
                    if sceneHit == null
                       or previewDistance <= sceneHit.Distance {
                        return previewCandidate;
                    }
                }
            }
            // Walk hits front to back so pick-locked nodes yield to the
            // geometry behind them instead of blocking the click.
            var remaining = viewportRenderCamera.FarPlane;
            var attempts = 0;
            while attempts < 32 and remaining > 0.0 {
                var node = scene.RaycastNodesPrecise(
                    castOrigin, direction, remaining) as SceneNode;
                if node == null { break; }
                var hitIndex = FindFlatIndex(node);
                if hitIndex >= 0
                   and NodePickLocked(hitIndex) == false {
                    return hitIndex;
                }
                var hit = scene.RaycastPreciseHit(
                    castOrigin, direction, remaining) as RayHit3D;
                if hit == null { break; }
                var step = hit.Distance + 0.001;
                if step <= 0.0 { break; }
                castOrigin = Vec3.New(
                    castOrigin.X + direction.X * step,
                    castOrigin.Y + direction.Y * step,
                    castOrigin.Z + direction.Z * step);
                remaining = remaining - step;
                attempts = attempts + 1;
            }
            if previewCandidate >= 0
               and NodePickLocked(previewCandidate) == false {
                return previewCandidate;
            }
        }
        var marker = ViewportMarkerAt(mouseX, mouseY);
        if marker >= 0 and NodePickLocked(marker) { return -1; }
        return marker;
    }

    /// @brief Consume the one-shot Run Scene request from this editor.
    expose func TakeRunSceneRequested() -> Boolean {
        if runSceneRequested == false { return false; }
        runSceneRequested = false;
        return true;
    }

    /// @brief Whether one flattened node is workspace pick-locked.
    /// @details The active path set follows its document. RefreshHierarchy
    ///          remaps live structural changes by node identity, preventing a
    ///          reordered or deleted path from locking a different node.
    expose func NodePickLocked(index: Integer) -> Boolean {
        if index < 0 or index >= flatPaths.count() { return false; }
        return PickLockedPath(flatPaths.get(index));
    }

    /// @brief Set pick-lock for the complete selection without editing VSCN.
    /// @return True only when workspace lock state changed.
    expose func SetSelectedPickLocked(nextLocked: Boolean) -> Boolean {
        selectedIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if selectedIndices.count() == 0 { return false; }

        var changed = false;
        if nextLocked {
            var selection = 0;
            while selection < selectedIndices.count()
                  and pickLockedPaths.count() < MAX_EDITOR_NODES {
                var index = selectedIndices.get(selection);
                if index >= 0 and index < flatPaths.count() {
                    var path = flatPaths.get(index);
                    if PickLockedPath(path) == false {
                        pickLockedPaths.add(path);
                        changed = true;
                    }
                }
                selection = selection + 1;
            }
        } else {
            var kept: List[String] = [];
            var lockIndex = 0;
            while lockIndex < pickLockedPaths.count() {
                var path = pickLockedPaths.get(lockIndex);
                var selectedPath = false;
                var selection = 0;
                while selection < selectedIndices.count() {
                    var index = selectedIndices.get(selection);
                    if index >= 0 and index < flatPaths.count()
                       and flatPaths.get(index) == path {
                        selectedPath = true;
                    }
                    selection = selection + 1;
                }
                if selectedPath {
                    changed = true;
                } else if StringListContains(kept, path) == false {
                    kept.add(path);
                }
                lockIndex = lockIndex + 1;
            }
            pickLockedPaths = kept;
        }
        if changed == false { return false; }

        RefreshHierarchyRowLabels();
        RefreshHierarchyActionControls();
        CaptureWorkspaceState();
        if nextLocked {
            toolbarStatus.SetText(
                "Viewport picking locked for "
                + selectedIndices.count() + " node(s)");
        } else {
            toolbarStatus.SetText(
                "Viewport picking unlocked for "
                + selectedIndices.count() + " node(s)");
        }
        return true;
    }

    /// @brief Resolve a mixed selection to locked, or unlock an all-locked one.
    /// @return True when every selected node is locked after the toggle.
    expose func ToggleSelectedPickLocks() -> Boolean {
        if selectedIndices.count() == 0 { return false; }
        var nextLocked = SelectedAllPickLocked() == false;
        SetSelectedPickLocked(nextLocked);
        return nextLocked;
    }

    /// @brief Toggle pick-lock on the single selected node (workspace-only).
    /// @return True when the node is locked after the toggle.
    expose func ToggleSelectedPickLock() -> Boolean {
        if selectedIndices.count() != 1 { return false; }
        return ToggleSelectedPickLocks();
    }

    /// @brief Snap the camera to one of six axis-aligned views.
    /// @param kind Top/Front/Right/Bottom/Back/Left orientation face.
    expose func SetQuickView(kind: Integer) {
        if kind < ORIENTATION_FACE_TOP
           or kind > ORIENTATION_FACE_LEFT {
            return;
        }
        ReleaseGameplayViewAnchor();
        if kind == ORIENTATION_FACE_TOP {
            viewYawDegrees = 0;
            viewPitchDegrees = 80;
        } else if kind == ORIENTATION_FACE_FRONT {
            viewYawDegrees = 0;
            viewPitchDegrees = 0;
        } else if kind == ORIENTATION_FACE_RIGHT {
            viewYawDegrees = 90;
            viewPitchDegrees = 0;
        } else if kind == ORIENTATION_FACE_BOTTOM {
            viewYawDegrees = 0;
            viewPitchDegrees = -80;
        } else if kind == ORIENTATION_FACE_BACK {
            viewYawDegrees = 180;
            viewPitchDegrees = 0;
        } else {
            viewYawDegrees = -90;
            viewPitchDegrees = 0;
        }
        renderDirty = true;
        CaptureWorkspaceState();
    }

    /// @brief Return whether the complete navigator fits the viewport.
    expose func OrientationNavigatorVisible() -> Boolean {
        return renderedViewportWidth
                   >= ORIENTATION_PANEL_WIDTH
                      + ORIENTATION_PANEL_MARGIN * 2
            and renderedViewportHeight
                   >= ORIENTATION_PANEL_HEIGHT
                      + ORIENTATION_PANEL_MARGIN * 2;
    }

    /// @brief Return the navigator face under one viewport-local point.
    /// @return Six direction faces, projection toggle, or NONE.
    expose func OrientationFaceAt(mouseX: Integer,
                                  mouseY: Integer) -> Integer {
        if OrientationNavigatorVisible() == false {
            return ORIENTATION_FACE_NONE;
        }
        var panelLeft = renderedViewportWidth
            - ORIENTATION_PANEL_MARGIN - ORIENTATION_PANEL_WIDTH;
        var face = ORIENTATION_FACE_TOP;
        while face <= ORIENTATION_FACE_LEFT {
            var column = face % 3;
            var row = face / 3;
            var left = panelLeft + ORIENTATION_FACE_LEFT_PAD
                + column
                    * (ORIENTATION_FACE_WIDTH + ORIENTATION_FACE_GAP);
            var top = ORIENTATION_PANEL_MARGIN
                + ORIENTATION_FACE_TOP_PAD
                + row
                    * (ORIENTATION_FACE_HEIGHT + ORIENTATION_FACE_GAP);
            if mouseX >= left
               and mouseX < left + ORIENTATION_FACE_WIDTH
               and mouseY >= top
               and mouseY < top + ORIENTATION_FACE_HEIGHT {
                return face;
            }
            face = face + 1;
        }
        var projectionLeft = panelLeft + 91;
        var projectionTop = ORIENTATION_PANEL_MARGIN + 5;
        if mouseX >= projectionLeft and mouseX < projectionLeft + 50
           and mouseY >= projectionTop and mouseY < projectionTop + 17 {
            return ORIENTATION_PROJECTION_TOGGLE;
        }
        if mouseX >= panelLeft
           and mouseX < panelLeft + ORIENTATION_PANEL_WIDTH
           and mouseY >= ORIENTATION_PANEL_MARGIN
           and mouseY
              < ORIENTATION_PANEL_MARGIN + ORIENTATION_PANEL_HEIGHT {
            return ORIENTATION_PANEL_BACKGROUND;
        }
        return ORIENTATION_FACE_NONE;
    }

    /// @brief Return the center of one live navigator hit target.
    /// @details Display probes use production geometry instead of duplicating
    ///          top-right placement math.
    expose func OrientationFaceCenter(face: Integer) -> ProjectedPoint {
        var point = new ProjectedPoint();
        point.visible = false;
        if OrientationNavigatorVisible() == false { return point; }
        var panelLeft = renderedViewportWidth
            - ORIENTATION_PANEL_MARGIN - ORIENTATION_PANEL_WIDTH;
        if face >= ORIENTATION_FACE_TOP
           and face <= ORIENTATION_FACE_LEFT {
            var column = face % 3;
            var row = face / 3;
            point.x = panelLeft + ORIENTATION_FACE_LEFT_PAD
                + column
                    * (ORIENTATION_FACE_WIDTH + ORIENTATION_FACE_GAP)
                + ORIENTATION_FACE_WIDTH / 2;
            point.y = ORIENTATION_PANEL_MARGIN
                + ORIENTATION_FACE_TOP_PAD
                + row
                    * (ORIENTATION_FACE_HEIGHT + ORIENTATION_FACE_GAP)
                + ORIENTATION_FACE_HEIGHT / 2;
            point.visible = true;
        } else if face == ORIENTATION_PROJECTION_TOGGLE {
            point.x = panelLeft + 116;
            point.y = ORIENTATION_PANEL_MARGIN + 13;
            point.visible = true;
        }
        return point;
    }

    /// @brief Name one navigator target for status/accessibility text.
    expose func OrientationFaceLabel(face: Integer) -> String {
        if face == ORIENTATION_FACE_TOP { return "Top"; }
        if face == ORIENTATION_FACE_FRONT { return "Front"; }
        if face == ORIENTATION_FACE_RIGHT { return "Right"; }
        if face == ORIENTATION_FACE_BOTTOM { return "Bottom"; }
        if face == ORIENTATION_FACE_BACK { return "Back"; }
        if face == ORIENTATION_FACE_LEFT { return "Left"; }
        if face == ORIENTATION_PROJECTION_TOGGLE {
            if viewPerspective { return "Orthographic"; }
            return "Perspective";
        }
        if face == ORIENTATION_PANEL_BACKGROUND { return "Navigator"; }
        return "";
    }

    /// @brief Activate one navigator target without touching VSCN content.
    /// @return True only for one recognized direction/projection target.
    expose func ActivateOrientationFace(face: Integer) -> Boolean {
        if face >= ORIENTATION_FACE_TOP
           and face <= ORIENTATION_FACE_LEFT {
            SetQuickView(face);
            toolbarStatus.SetText(
                OrientationFaceLabel(face) + " view");
            return true;
        }
        if face == ORIENTATION_PROJECTION_TOGGLE {
            SetViewProjection(!viewPerspective);
            var projection = "Orthographic";
            if viewPerspective { projection = "Perspective"; }
            toolbarStatus.SetText(projection + " projection");
            return true;
        }
        return false;
    }

    /// @brief Return the navigator face nearest the current camera heading.
    hide func ActiveOrientationFace() -> Integer {
        if viewPitchDegrees >= 45 { return ORIENTATION_FACE_TOP; }
        if viewPitchDegrees <= -45 { return ORIENTATION_FACE_BOTTOM; }
        var yaw = NormalizeYawDegrees(viewYawDegrees);
        if yaw < 0 { yaw = yaw + 360; }
        if yaw < 45 or yaw >= 315 { return ORIENTATION_FACE_FRONT; }
        if yaw < 135 { return ORIENTATION_FACE_RIGHT; }
        if yaw < 225 { return ORIENTATION_FACE_BACK; }
        return ORIENTATION_FACE_LEFT;
    }

    /// @brief Encode the live camera pose as one bookmark string.
    hide func EncodeCameraBookmark() -> String {
        var projection = 0;
        if viewPerspective { projection = 1; }
        return viewYawDegrees + "," + viewPitchDegrees + ","
            + viewScale + "," + viewTargetX + "," + viewTargetY + ","
            + viewTargetZ + "," + projection;
    }

    /// @brief Store or recall camera bookmarks from the digit row.
    /// @details With the viewport surface focused, Shift+1..9 stores the
    ///          live pose into that slot and a bare digit recalls it;
    ///          bookmarks persist in the per-document workspace state and
    ///          never touch canonical VSCN bytes.
    hide func PumpCameraBookmarks() {
        if viewportImage == null or viewportImage.IsFocused() == false {
            return;
        }
        var digit = 0;
        if Input.Keyboard.WasPressed(Input.Key.Digit1) { digit = 1; }
        if Input.Keyboard.WasPressed(Input.Key.Digit2) { digit = 2; }
        if Input.Keyboard.WasPressed(Input.Key.Digit3) { digit = 3; }
        if Input.Keyboard.WasPressed(Input.Key.Digit4) { digit = 4; }
        if Input.Keyboard.WasPressed(Input.Key.Digit5) { digit = 5; }
        if Input.Keyboard.WasPressed(Input.Key.Digit6) { digit = 6; }
        if Input.Keyboard.WasPressed(Input.Key.Digit7) { digit = 7; }
        if Input.Keyboard.WasPressed(Input.Key.Digit8) { digit = 8; }
        if Input.Keyboard.WasPressed(Input.Key.Digit9) { digit = 9; }
        if digit == 0 { return; }
        if ViewportShiftDown() {
            StoreCameraBookmark(digit);
        } else {
            RecallCameraBookmark(digit);
        }
    }

    /// @brief Store the live camera pose into one 1-based bookmark slot.
    expose func StoreCameraBookmark(slot: Integer) -> Boolean {
        if slot < 1 or slot > 9 { return false; }
        while cameraBookmarks.count() < 9 { cameraBookmarks.add(""); }
        cameraBookmarks.set(slot - 1, EncodeCameraBookmark());
        toolbarStatus.SetText("Stored camera bookmark " + slot);
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Recall one 1-based camera bookmark slot when it exists.
    expose func RecallCameraBookmark(slot: Integer) -> Boolean {
        if slot < 1 or slot > cameraBookmarks.count() { return false; }
        var encoded = cameraBookmarks.get(slot - 1);
        if encoded == "" { return false; }
        var parts = Str.Split(encoded, ",");
        if Seq.get_Count(parts) != 7 { return false; }
        ReleaseGameplayViewAnchor();
        viewYawDegrees = NormalizeYawDegrees(
            Parse.IntOr(Seq.GetStr(parts, 0), viewYawDegrees));
        viewPitchDegrees = ClampInt3D(
            Parse.IntOr(Seq.GetStr(parts, 1), viewPitchDegrees), -80, 80);
        viewScale = ClampInt3D(
            Parse.IntOr(Seq.GetStr(parts, 2), viewScale), 4, 120);
        viewTargetX = Parse.DoubleOr(Seq.GetStr(parts, 3), viewTargetX);
        viewTargetY = Parse.DoubleOr(Seq.GetStr(parts, 4), viewTargetY);
        viewTargetZ = Parse.DoubleOr(Seq.GetStr(parts, 5), viewTargetZ);
        SetViewProjection(
            Parse.IntOr(Seq.GetStr(parts, 6), 1) != 0);
        toolbarStatus.SetText("Recalled camera bookmark " + slot);
        renderDirty = true;
        CaptureWorkspaceState();
        return true;
    }

    /// @brief The snap state one gizmo step should use right now.
    /// @details Holding Ctrl temporarily inverts the checkbox: snapping
    ///          drags snap-free and free drags snap, matching Unity's
    ///          hold-to-invert convention. Workspace state is untouched.
    expose func EffectiveSnapEnabled() -> Boolean {
        var inverted = Input.Keyboard.IsDown(Input.Key.LeftControl)
            or Input.Keyboard.IsDown(Input.Key.RightControl);
        if inverted { return gizmoSnapEnabled == false; }
        return gizmoSnapEnabled;
    }

    /// @brief Return whether either Alt key is held (overlap cycling).
    hide func ViewportAltDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftAlt)
            or Input.Keyboard.IsDown(Input.Key.RightAlt);
    }

    /// @brief Alt-click: cycle through every triangle hit under the pointer.
    /// @details Walks the ray front to back by re-casting just past each
    ///          triangle hit (Zia cannot type Seq elements, so the sorted
    ///          RaycastNodesPreciseAll list stays a runtime-level surface);
    ///          the pick after the current primary wins, wrapping, so
    ///          repeated Alt-clicks walk through stacked geometry.
    /// @return The flattened node index to select, or @p fallback.
    expose func CycleViewportNodeAt(mouseX: Integer,
                                  mouseY: Integer,
                                  fallback: Integer) -> Integer {
        if scene == null or ConfigureViewportCamera() == false {
            return fallback;
        }
        var castOrigin = viewportRenderCamera.ScreenToRayOrigin(
            mouseX, mouseY,
            renderedViewportWidth, renderedViewportHeight) as Vec3;
        var direction = viewportRenderCamera.ScreenToRay(
            mouseX, mouseY,
            renderedViewportWidth, renderedViewportHeight) as Vec3;
        var remaining = viewportRenderCamera.FarPlane;
        var indices: List[Integer] = [];
        var attempts = 0;
        while attempts < 32 and remaining > 0.0 {
            var node = scene.RaycastNodesPrecise(
                castOrigin, direction, remaining) as SceneNode;
            if node == null { break; }
            var flat = ResolveInstanceOwnerIndex(FindFlatIndex(node));
            if flat >= 0
               and scene_selection.Contains(indices, flat) == false {
                indices.add(flat);
            }
            var hit = scene.RaycastPreciseHit(
                castOrigin, direction, remaining) as RayHit3D;
            if hit == null { break; }
            var step = hit.Distance + 0.001;
            if step <= 0.0 { break; }
            castOrigin = Vec3.New(
                castOrigin.X + direction.X * step,
                castOrigin.Y + direction.Y * step,
                castOrigin.Z + direction.Z * step);
            remaining = remaining - step;
            attempts = attempts + 1;
        }
        if indices.count() == 0 { return fallback; }
        var currentAt = -1;
        var primary = ResolveInstanceOwnerIndex(selectedIndex);
        var i = 0;
        while i < indices.count() {
            if indices.get(i) == primary { currentAt = i; }
            i = i + 1;
        }
        var next = currentAt + 1;
        if next >= indices.count() { next = 0; }
        return indices.get(next);
    }

    /// @brief Project one node subtree's world bounds to a screen rectangle.
    /// @details Transforms the eight subtree-local AABB corners through the
    ///          node's world matrix and projects each through the shared
    ///          viewport camera. Any behind-eye corner marks the bounds
    ///          invisible because mirrored projections would inflate rects.
    hide func NodeScreenBounds(node: SceneNode) -> ScreenBounds3D {
        var bounds = new ScreenBounds3D();
        if node == null { return bounds; }
        var localMin = node.BoundsMin as Vec3;
        var localMax = node.BoundsMax as Vec3;
        var world = node.WorldMatrix;
        var corner = 0;
        while corner < 8 {
            var x = localMin.X;
            if corner / 4 == 1 { x = localMax.X; }
            var y = localMin.Y;
            if (corner / 2) - (corner / 4) * 2 == 1 { y = localMax.Y; }
            var z = localMin.Z;
            if corner - (corner / 2) * 2 == 1 { z = localMax.Z; }
            var worldCorner = world.TransformPoint(Vec3.New(x, y, z)) as Vec3;
            var point = Project(worldCorner.X, worldCorner.Y, worldCorner.Z);
            if point.visible == false { return new ScreenBounds3D(); }
            if corner == 0 {
                bounds.minX = point.x;
                bounds.maxX = point.x;
                bounds.minY = point.y;
                bounds.maxY = point.y;
            } else {
                if point.x < bounds.minX { bounds.minX = point.x; }
                if point.x > bounds.maxX { bounds.maxX = point.x; }
                if point.y < bounds.minY { bounds.minY = point.y; }
                if point.y > bounds.maxY { bounds.maxY = point.y; }
            }
            corner = corner + 1;
        }
        bounds.visible = true;
        return bounds;
    }

    /// @brief Apply the completed marquee rectangle to the selection.
    /// @details Nodes whose projected world bounds intersect the rectangle
    ///          are selected with the 2D marquee vocabulary: replace by
    ///          default, Shift adds, Ctrl/Cmd toggles. Workspace-only.
    hide func ApplyMarqueeSelection() {
        var rectMinX = marqueeStartX;
        var rectMaxX = marqueeEndX;
        if rectMaxX < rectMinX {
            rectMinX = marqueeEndX;
            rectMaxX = marqueeStartX;
        }
        var rectMinY = marqueeStartY;
        var rectMaxY = marqueeEndY;
        if rectMaxY < rectMinY {
            rectMinY = marqueeEndY;
            rectMaxY = marqueeStartY;
        }
        var hits: List[Integer] = [];
        var i = 0;
        while i < flatNodes.count() {
            var bounds = NodeScreenBounds(flatNodes.get(i));
            if bounds.visible
               and NodePickLocked(i) == false
               and bounds.minX <= rectMaxX and bounds.maxX >= rectMinX
               and bounds.minY <= rectMaxY and bounds.maxY >= rectMinY {
                var resolved = ResolveInstanceOwnerIndex(i);
                if resolved >= 0
                   and scene_selection.Contains(hits, resolved) == false {
                    hits.add(resolved);
                }
            }
            i = i + 1;
        }
        var current = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        var next: List[Integer] = [];
        var nextPrimary = -1;
        if marqueeToggle {
            i = 0;
            while i < current.count() {
                if scene_selection.Contains(hits, current.get(i)) == false {
                    next.add(current.get(i));
                }
                i = i + 1;
            }
            i = 0;
            while i < hits.count() {
                if scene_selection.Contains(current, hits.get(i)) == false {
                    next.add(hits.get(i));
                }
                i = i + 1;
            }
        } else if marqueeAdditive {
            next = current;
            i = 0;
            while i < hits.count() {
                if scene_selection.Contains(next, hits.get(i)) == false {
                    next.add(hits.get(i));
                }
                i = i + 1;
            }
        } else {
            next = hits;
        }
        if next.count() > 0 {
            nextPrimary = next.get(next.count() - 1);
            if scene_selection.Contains(next, selectedIndex) {
                nextPrimary = selectedIndex;
            }
        }
        SelectSceneNodes(next, nextPrimary);
    }

    /// @brief Track an armed or active marquee drag; true consumes the frame.
    /// @details Runs before shortcut pumps so a marquee Escape cancels the
    ///          gesture without also clearing the selection, and before the
    ///          hover early-out so drags that leave the widget stay live.
    hide func PumpMarquee() -> Boolean {
        if marqueeCandidate == false or viewportImage == null {
            return false;
        }
        if Input.Keyboard.WasPressed(Input.Key.Escape)
           and marqueeCancelled == false {
            if marqueeActive {
                marqueeActive = false;
                renderDirty = true;
            }
            // Keep swallowing input until the button releases so the
            // cancelled gesture's release never becomes a blank click.
            marqueeCancelled = true;
            return true;
        }
        var mouseX = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.X())
            - viewportImage.GetScreenX());
        var mouseY = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.Y())
            - viewportImage.GetScreenY());
        if Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
            if marqueeCancelled { return true; }
            if mouseX != marqueeEndX or mouseY != marqueeEndY {
                marqueeEndX = mouseX;
                marqueeEndY = mouseY;
                if marqueeActive { renderDirty = true; }
            }
            if marqueeActive == false {
                var dx = marqueeEndX - marqueeStartX;
                var dy = marqueeEndY - marqueeStartY;
                if dx * dx + dy * dy
                   > MARQUEE_THRESHOLD_SQUARED_3D {
                    marqueeActive = true;
                    renderDirty = true;
                }
            }
            return marqueeActive;
        }
        marqueeCandidate = false;
        if marqueeCancelled {
            marqueeCancelled = false;
            return true;
        }
        if marqueeActive == false { return false; }
        marqueeActive = false;
        ApplyMarqueeSelection();
        renderDirty = true;
        return true;
    }

    /// @brief Apply replace, additive, toggle, or blank viewport selection.
    /// @return True only when presentation selection state changed.
    expose func ApplyViewportSelection(nodeIndex: Integer,
                                       additive: Boolean,
                                       toggle: Boolean) -> Boolean {
        var resolvedIndex = ResolveInstanceOwnerIndex(nodeIndex);
        var current = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if resolvedIndex < 0 or resolvedIndex >= flatNodes.count() {
            if additive or toggle or current.count() == 0 {
                return false;
            }
            SelectSceneNodes([], -1);
            return true;
        }

        var next: List[Integer] = [];
        var nextPrimary = resolvedIndex;
        if toggle {
            var removing = scene_selection.Contains(current, resolvedIndex);
            var index = 0;
            while index < current.count() {
                var candidate = current.get(index);
                if removing == false or candidate != resolvedIndex {
                    next.add(candidate);
                }
                index = index + 1;
            }
            if removing == false { next.add(resolvedIndex); }
            if removing {
                if next.count() == 0 {
                    nextPrimary = -1;
                } else if selectedIndex != resolvedIndex
                          and scene_selection.Contains(
                              next, selectedIndex) {
                    nextPrimary = selectedIndex;
                } else {
                    nextPrimary = next.get(next.count() - 1);
                }
            }
        } else if additive {
            next = current;
            if scene_selection.Contains(next, resolvedIndex) == false {
                next.add(resolvedIndex);
            }
        } else {
            next.add(resolvedIndex);
        }

        var changed = nextPrimary != selectedIndex
            or next.count() != current.count();
        if changed == false {
            var compareIndex = 0;
            while compareIndex < next.count() and changed == false {
                if next.get(compareIndex) != current.get(compareIndex) {
                    changed = true;
                }
                compareIndex = compareIndex + 1;
            }
        }
        if changed == false { return false; }
        SelectSceneNodes(next, nextPrimary);
        return true;
    }

    /// @brief Recognize only two nearby clicks on the same viewport node.
    /// @details The global mouse double-click flag has no widget or position
    ///          identity, so it cannot safely distinguish toolbar clicks.
    hide func RegisterViewportClick(resolvedIndex: Integer,
                                    mouseX: Integer,
                                    mouseY: Integer) -> Boolean {
        var now = Zanna.Time.Clock.NowMs();
        var elapsed = now - lastViewportClickMs;
        var dx = mouseX - lastViewportClickX;
        var dy = mouseY - lastViewportClickY;
        var isDouble = resolvedIndex >= 0
            and resolvedIndex == lastViewportClickNode
            and elapsed >= 0
            and elapsed <= VIEWPORT_DOUBLE_CLICK_MS
            and dx * dx + dy * dy
                <= VIEWPORT_DOUBLE_CLICK_RADIUS_SQUARED;
        lastViewportClickNode = resolvedIndex;
        lastViewportClickX = mouseX;
        lastViewportClickY = mouseY;
        lastViewportClickMs = now;
        return isDouble;
    }

    /// @brief Pump viewport selection, orbit/pan, zoom, and transform gizmos.
    /// @return True only when a complete gizmo drag committed document content.
    hide func PumpViewportNavigation() -> Boolean {
        if gizmoDragAxis != GIZMO_AXIS_NONE {
            if Input.Keyboard.WasPressed(Input.Key.Escape) {
                CancelGizmoDrag();
                return false;
            }
            if !Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
                return FinishGizmoDrag();
            }
            ApplyGizmoMouseDelta();
            return false;
        }
        if flyActive {
            PumpFlyFrame();
            return false;
        }
        if PumpMarquee() { return false; }
        PumpGizmoShortcuts();
        PumpHierarchyRename();
        if viewportImage == null or viewportImage.IsHovered() == false {
            if gizmoHoverAxis != GIZMO_AXIS_NONE {
                gizmoHoverAxis = GIZMO_AXIS_NONE;
                renderDirty = true;
            }
            if hoveredViewportNode != -1 {
                hoveredViewportNode = -1;
                renderDirty = true;
            }
            if orientationHoverFace != ORIENTATION_FACE_NONE {
                orientationHoverFace = ORIENTATION_FACE_NONE;
                renderDirty = true;
            }
            return false;
        }
        var mouseX = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.X())
            - viewportImage.GetScreenX());
        var mouseY = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.Y())
            - viewportImage.GetScreenY());
        var orientationFace = OrientationFaceAt(mouseX, mouseY);
        if orientationFace != orientationHoverFace {
            orientationHoverFace = orientationFace;
            renderDirty = true;
        }
        if orientationFace != ORIENTATION_FACE_NONE {
            if gizmoHoverAxis != GIZMO_AXIS_NONE {
                gizmoHoverAxis = GIZMO_AXIS_NONE;
                renderDirty = true;
            }
            if hoveredViewportNode != -1 {
                hoveredViewportNode = -1;
                renderDirty = true;
            }
            if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
                FocusActiveGizmoButton();
            }
            if Input.Mouse.WasClicked(Input.Mouse.ButtonLeft) {
                ActivateOrientationFace(orientationFace);
            }
            // The navigator owns its complete panel. Wheel/right/middle input
            // cannot leak into dolly/orbit or arm a selection marquee.
            return false;
        }
        var navigationOwned = ActiveLookThroughNode() == null;
        var wheel = Input.Mouse.WheelYFloat();
        if navigationOwned {
            if wheel > 0.0 {
                DollyViewportAtPointer(1);
            } else if wheel < 0.0 {
                DollyViewportAtPointer(-1);
            }
        }
        if Input.Mouse.WasPressed(Input.Mouse.ButtonMiddle)
           or Input.Mouse.WasPressed(Input.Mouse.ButtonRight) {
            FocusActiveGizmoButton();
        }
        if navigationOwned
           and Input.Mouse.WasPressed(Input.Mouse.ButtonRight)
           and ViewportShiftDown() == false {
            BeginFlyNavigation();
            return false;
        }
        if navigationOwned
           and (Input.Mouse.IsDown(Input.Mouse.ButtonMiddle)
                or Input.Mouse.IsDown(Input.Mouse.ButtonRight)) {
            var deltaX = Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.DeltaX()));
            var deltaY = Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.DeltaY()));
            if deltaX != 0 or deltaY != 0 {
                if ViewportShiftDown() {
                    PanViewportByPixels(deltaX, deltaY);
                } else {
                    ReleaseGameplayViewAnchor();
                    viewYawDegrees = NormalizeYawDegrees(
                        viewYawDegrees + deltaX);
                    viewPitchDegrees = ClampInt3D(
                        viewPitchDegrees - deltaY, -80, 80);
                    renderDirty = true;
                }
            }
            return false;
        }
        var hoveredAxis = GizmoHandleAtViewportPoint(mouseX, mouseY);
        if hoveredAxis != gizmoHoverAxis {
            gizmoHoverAxis = hoveredAxis;
            renderDirty = true;
        }
        var hoveredNode = -1;
        if hoveredAxis == GIZMO_AXIS_NONE {
            hoveredNode = ViewportNodeAt(mouseX, mouseY);
        }
        if hoveredNode != hoveredViewportNode {
            hoveredViewportNode = hoveredNode;
            renderDirty = true;
        }
        if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
            FocusActiveGizmoButton();
        }
        if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft)
           and hoveredAxis != GIZMO_AXIS_NONE {
            BeginGizmoDrag(hoveredAxis);
            return false;
        }
        if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft)
           and hoveredAxis == GIZMO_AXIS_NONE {
            // Arm a marquee candidate: it activates only past the drag
            // threshold, so plain clicks keep flowing to the click path.
            marqueeCandidate = true;
            marqueeActive = false;
            marqueeStartX = mouseX;
            marqueeStartY = mouseY;
            marqueeEndX = mouseX;
            marqueeEndY = mouseY;
            marqueeAdditive = ViewportShiftDown();
            marqueeToggle = ViewportPrimaryModifierDown();
        }
        if Input.Mouse.WasClicked(Input.Mouse.ButtonLeft) == false {
            return false;
        }
        var best = ViewportNodeAt(mouseX, mouseY);
        if ViewportAltDown() {
            best = CycleViewportNodeAt(mouseX, mouseY, best);
        }
        var doubleClick = RegisterViewportClick(best, mouseX, mouseY);
        ApplyViewportSelection(
            best,
            ViewportShiftDown(),
            ViewportPrimaryModifierDown());
        if best >= 0
           and doubleClick
           and scene_selection.Contains(selectedIndices, best) {
            FrameSelected();
            renderDirty = true;
        }
        return false;
    }

    /// @brief Consume viewport drops: import 3D assets, apply materials.
    hide func PumpViewportDrops() -> Boolean {
        if viewportImage == null or scene == null { return false; }
        if viewportImage.WasDropped() == false { return false; }
        var dropType = viewportImage.GetDropType();
        var dropData = viewportImage.GetDropData();
        if dropType == "zanna/material" {
            return ApplyMaterialDropAt(
                viewportImage.GetDropX(), viewportImage.GetDropY());
        }
        return ImportAssetDrop(dropData);
    }

    /// @brief Import one dropped 3D asset through the standard import path.
    /// @details Shared by the viewport drop pump and the DnD probe: the
    ///          extension gate refuses non-3D assets before any import work.
    expose func ImportAssetDrop(assetPath: String) -> Boolean {
        if assetPath == "" { return false; }
        if scene_asset_browser.AssetExtensionAllowed(
               assetPath,
               scene_asset_browser.NormalizeAssetExtensions(
                   ".scene3d,.vscn,.gltf,.glb,.fbx,.obj,.stl")) == false {
            toolbarStatus.SetText(
                "Only 3D assets can drop into the viewport.");
            return false;
        }
        return ImportAssetPath(assetPath);
    }

    /// @brief Apply the selected library material to the node under the drop.
    hide func ApplyMaterialDropAt(dropX: Number, dropY: Number) -> Boolean {
        var mouseX = Convert.NumToInt(
            PhysicalPointerToUi(dropX)
            - viewportImage.GetScreenX());
        var mouseY = Convert.NumToInt(
            PhysicalPointerToUi(dropY)
            - viewportImage.GetScreenY());
        var node = ViewportNodeAt(mouseX, mouseY);
        if node < 0 {
            toolbarStatus.SetText(
                "Drop the material onto a visible mesh.");
            return false;
        }
        SelectSceneNodes([node], node);
        return ApplyLibraryMaterialToSelection();
    }

    /// @brief F2 begins an inline hierarchy rename of the single selection.
    /// @details The row editor pre-fills the raw node name (rows decorate the
    ///          label with kind badges). Enter or focus loss commits through
    ///          ApplyHierarchyRename as one undoable edit; Escape cancels.
    hide func PumpHierarchyRename() {
        if Input.Keyboard.WasPressed(Input.Key.F2) == false { return; }
        if SceneSelectionCommandsOwnFocus() == false { return; }
        BeginRenameSelected();
    }

    /// @brief Begin a visible inline rename of the selected node's row.
    /// @details Shared by F2, context menus, and create-and-rename flows.
    ///          Viewport-priority layouts reveal the full-width hierarchy
    ///          master before opening the row editor. Focus mode refuses the
    ///          edit unless the hierarchy already owns a floating pane.
    /// @return True when the row editor opened.
    expose func BeginRenameSelected() -> Boolean {
        if hierarchyTree == null or scene == null { return false; }
        if hierarchyTree.IsEditing() { return false; }
        if selectedIndices.count() != 1 { return false; }
        if selectedIndex < 0
           or selectedIndex >= hierarchyTreeNodes.count()
           or hierarchyTreeNodes.get(selectedIndex) == null {
            return false;
        }
        var node = SelectedNode();
        if node == null { return false; }
        if focusModeActive and hierarchyDock.floating == false {
            return false;
        }
        if hierarchyDock.floating == false
           and UsesDockedHierarchy(lastHostWidth) == false {
            compactHierarchyShown = true;
            compactInspectorShown = false;
            ApplyInspectorLayout();
            CaptureWorkspaceState();
        }
        return hierarchyTree.BeginEditNode(
            hierarchyTreeNodes.get(selectedIndex), node.Name);
    }

    /// @brief Apply a committed inline hierarchy rename as one undoable edit.
    /// @details The edited row's data carries its flat index, so a selection
    ///          change between commit and consumption cannot retarget the
    ///          rename. Empty and unchanged names are no-ops.
    hide func ApplyHierarchyRename() -> Boolean {
        var edited = hierarchyTree.GetEditedNodeOption();
        if edited.IsSome == false { return false; }
        var index = Parse.IntOr(
            GUI.TreeView.Node.GetData(edited.Unwrap()), -1);
        if index < 0 or index >= flatNodes.count() { return false; }
        var node = flatNodes.get(index);
        if node == null { return false; }
        var nextName = Str.Trim(hierarchyTree.GetEditText());
        if nextName == "" or nextName == node.Name { return false; }
        node.Name = nextName;
        if CommitScene("Renamed node to " + nextName) == false {
            return false;
        }
        RefreshHierarchy(node);
        return true;
    }

    /// @brief Apply conventional transform shortcuts only while viewport owns focus.
    hide func PumpGizmoShortcuts() {
        if GizmoControlsOwnFocus() == false {
            return;
        }
        if Input.Keyboard.WasPressed(Input.Key.F) {
            if selectedIndices.count() > 0 { FrameSelected(); }
            else { FrameAll(); }
            renderDirty = true;
        }
        if Input.Keyboard.WasPressed(Input.Key.W) {
            SetGizmoMode(GIZMO_MODE_MOVE);
        } else if Input.Keyboard.WasPressed(Input.Key.E) {
            SetGizmoMode(GIZMO_MODE_ROTATE);
        } else if Input.Keyboard.WasPressed(Input.Key.R) {
            SetGizmoMode(GIZMO_MODE_SCALE);
        }
        if Input.Keyboard.WasPressed(Input.Key.Escape)
           and selectedIndices.count() > 0 {
            // Workspace-only: clearing selection never touches VSCN bytes,
            // history, or dirty state. Drag and fly Escapes are consumed
            // before this pump runs.
            SelectSceneNodes([], -1);
            renderDirty = true;
        }
    }

    /// @brief Give the viewport surface keyboard focus for its shortcuts.
    /// @details The viewport Image is a real focusable widget; clicking it
    ///          already focuses it through the GUI's click-to-focus path, and
    ///          navigation gestures route here so shortcut ownership follows
    ///          the surface rather than a toolbar-button proxy.
    hide func FocusActiveGizmoButton() {
        if viewportImage != null { viewportImage.Focus(); }
    }

    /// @brief Return whether W/E/R belong to this scene viewport this frame.
    /// @details The focused viewport surface is the primary owner; the
    ///          transform tool buttons remain accepted so keyboard-driven
    ///          toolbar workflows keep their shortcuts.
    hide func GizmoControlsOwnFocus() -> Boolean {
        return (viewportImage != null and viewportImage.IsFocused())
            or (moveToolButton != null and moveToolButton.IsFocused())
            or (rotateToolButton != null and rotateToolButton.IsFocused())
            or (scaleToolButton != null and scaleToolButton.IsFocused())
            or (transformSpaceButton != null
                and transformSpaceButton.IsFocused());
    }

    /// @brief Return whether duplicate/delete keys belong to the scene surface.
    /// @details Text, numeric, color, and material inputs remain outside this
    ///          focus set even while their node stays selected.
    expose func SceneSelectionCommandsOwnFocus() -> Boolean {
        // GizmoControlsOwnFocus covers the focused viewport surface.
        return (hierarchyTree != null and hierarchyTree.IsFocused())
            or GizmoControlsOwnFocus()
            or (duplicateNodeButton != null
                and duplicateNodeButton.IsFocused())
            or (deleteNodeButton != null and deleteNodeButton.IsFocused())
            or (frameSelectedButton != null
                and frameSelectedButton.IsFocused());
    }

    /// @brief Return the transform handle at one viewport-local coordinate.
    /// @details Exposed so display probes use the exact rounded geometry that
    ///          production input and rendering share.
    expose func GizmoHandleAtViewportPoint(mouseX: Integer,
                                           mouseY: Integer) -> Integer {
        var node = SelectedNode();
        if node == null { return GIZMO_AXIS_NONE; }
        var world = node.WorldPosition;
        var origin = Project(world.X, world.Y, world.Z);
        if origin.visible == false { return GIZMO_AXIS_NONE; }
        var xEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_X);
        var yEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_Y);
        var zEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_Z);
        if gizmoMode == GIZMO_MODE_ROTATE {
            return ClosestGizmoRotationRing(
                mouseX, mouseY, origin.x, origin.y,
                xEnd.x, xEnd.y, yEnd.x, yEnd.y, zEnd.x, zEnd.y,
                GIZMO_RING_PICK_RADIUS);
        }
        if gizmoMode == GIZMO_MODE_MOVE
           or gizmoMode == GIZMO_MODE_SCALE {
            var plane = ClosestGizmoPlane(
                mouseX, mouseY, origin.x, origin.y,
                xEnd.x, xEnd.y, yEnd.x, yEnd.y, zEnd.x, zEnd.y);
            if plane != GIZMO_AXIS_NONE { return plane; }
        }
        return ClosestGizmoAxis(
            mouseX, mouseY, origin.x, origin.y,
            xEnd.x, xEnd.y, yEnd.x, yEnd.y, zEnd.x, zEnd.y,
            GIZMO_PICK_RADIUS);
    }

    /// @brief Return the currently hovered axis or plane handle.
    expose func HoveredGizmoHandle() -> Integer {
        return gizmoHoverAxis;
    }

    /// @brief Return the active gesture amount for deterministic input probes.
    expose func GizmoDragAccumulatedAmount() -> Number {
        return gizmoDragAccumulated;
    }

    /// @brief Return the selected node's rounded projected axis endpoint.
    /// @details Display probes use this instead of duplicating camera math.
    expose func SelectedGizmoAxisEndpoint(
        axis: Integer) -> ProjectedPoint {
        if IsGizmoAxis(axis) == false {
            return new ProjectedPoint();
        }
        return GizmoAxisEndpoint(SelectedNode(), axis);
    }

    /// @brief Return one rounded point on the selected projected rotation ring.
    /// @details Probes and production drawing share this exact right-handed
    ///          ellipse parameterization instead of duplicating camera math.
    expose func SelectedGizmoRotationRingPoint(
        axis: Integer,
        degrees: Number) -> ProjectedPoint {
        return GizmoRotationRingPoint(
            SelectedNode(), axis, degrees);
    }

    /// @brief Project one angular coordinate on a node's rotation ellipse.
    hide func GizmoRotationRingPoint(node: SceneNode,
                                     axis: Integer,
                                     degrees: Number) -> ProjectedPoint {
        var point = new ProjectedPoint();
        if node == null or IsGizmoAxis(axis) == false { return point; }
        var world = node.WorldPosition;
        var origin = Project(world.X, world.Y, world.Z);
        var axisA = GizmoAxisEndpoint(node, GizmoRingAxisA(axis));
        var axisB = GizmoAxisEndpoint(node, GizmoRingAxisB(axis));
        var radians = degrees * DEG_TO_RAD;
        point.x = origin.x + Convert.NumToInt(
            (axisA.x - origin.x) * Math.Cos(radians)
            + (axisB.x - origin.x) * Math.Sin(radians));
        point.y = origin.y + Convert.NumToInt(
            (axisA.y - origin.y) * Math.Cos(radians)
            + (axisB.y - origin.y) * Math.Sin(radians));
        return point;
    }

    /// @brief Decode one viewport point against a node's projected ring basis.
    hide func GizmoRotationRingAngle(
        node: SceneNode,
        axis: Integer,
        pointerX: Number,
        pointerY: Number) -> scene_transform_3d.RingAngleResult {
        if node == null or IsGizmoAxis(axis) == false {
            return new scene_transform_3d.RingAngleResult();
        }
        var world = node.WorldPosition;
        var origin = Project(world.X, world.Y, world.Z);
        var axisA = GizmoAxisEndpoint(node, GizmoRingAxisA(axis));
        var axisB = GizmoAxisEndpoint(node, GizmoRingAxisB(axis));
        return scene_transform_3d.RotationRingAngle(
            pointerX, pointerY, origin.x, origin.y,
            axisA.x, axisA.y, axisB.x, axisB.y);
    }

    /// @brief Project one parent-aware local transform handle.
    hide func GizmoAxisEndpoint(node: SceneNode,
                                axis: Integer) -> ProjectedPoint {
        if node == null { return new ProjectedPoint(); }
        var world = node.WorldPosition;
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            var worldLength = GizmoWorldLength();
            var worldX = world.X;
            var worldY = world.Y;
            var worldZ = world.Z;
            if axis == GIZMO_AXIS_X { worldX = worldX + worldLength; }
            else if axis == GIZMO_AXIS_Y {
                worldY = worldY + worldLength;
            } else {
                worldZ = worldZ + worldLength;
            }
            return Project(worldX, worldY, worldZ);
        }
        var localLength = GizmoLocalLength(node, axis);
        var deltaX = 0.0;
        var deltaY = 0.0;
        var deltaZ = 0.0;
        if axis == GIZMO_AXIS_X { deltaX = localLength; }
        else if axis == GIZMO_AXIS_Y { deltaY = localLength; }
        else { deltaZ = localLength; }

        var parent = node.Parent;
        if parent != null {
            var parentScale = parent.WorldScale;
            deltaX = deltaX * parentScale.X;
            deltaY = deltaY * parentScale.Y;
            deltaZ = deltaZ * parentScale.Z;
            var rotation = parent.WorldRotation;
            var crossX = 2.0
                * (rotation.Y * deltaZ - rotation.Z * deltaY);
            var crossY = 2.0
                * (rotation.Z * deltaX - rotation.X * deltaZ);
            var crossZ = 2.0
                * (rotation.X * deltaY - rotation.Y * deltaX);
            var rotatedX = deltaX + rotation.W * crossX
                + rotation.Y * crossZ - rotation.Z * crossY;
            var rotatedY = deltaY + rotation.W * crossY
                + rotation.Z * crossX - rotation.X * crossZ;
            var rotatedZ = deltaZ + rotation.W * crossZ
                + rotation.X * crossY - rotation.Y * crossX;
            deltaX = rotatedX;
            deltaY = rotatedY;
            deltaZ = rotatedZ;
        }
        return Project(
            world.X + deltaX, world.Y + deltaY, world.Z + deltaZ);
    }

    /// @brief Local distance that produces a stable world-space handle length.
    hide func GizmoLocalLength(node: SceneNode,
                               axis: Integer) -> Number {
        var worldLength = GizmoWorldLength();
        if node == null or node.Parent == null { return worldLength; }
        var scale = node.Parent.WorldScale;
        var axisScale = scale.Z;
        if axis == GIZMO_AXIS_X { axisScale = scale.X; }
        else if axis == GIZMO_AXIS_Y { axisScale = scale.Y; }
        if axisScale < 0.0 { axisScale = 0.0 - axisScale; }
        if axisScale < 0.0001 { axisScale = 0.0001; }
        return worldLength / axisScale;
    }

    /// @brief World distance that keeps every absolute-axis handle pixel-stable.
    hide func GizmoWorldLength() -> Number {
        if viewScale > 0 { return GIZMO_PIXEL_LENGTH / viewScale; }
        return 1.0;
    }

    /// @brief Scene-unit amount represented by the currently displayed handle.
    hide func GizmoDragLength(node: SceneNode,
                              axis: Integer) -> Number {
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            return GizmoWorldLength();
        }
        return GizmoLocalLength(node, axis);
    }

    /// @brief Start one captured transactional transform gesture.
    hide func BeginGizmoDrag(axis: Integer) {
        if bakeActive {
            detailLabel.SetText(
                "A lightmap bake is running; cancel it before "
                + "transforming nodes.");
            return;
        }
        var node = SelectedNode();
        if node == null
           or (IsGizmoAxis(axis) == false
               and ((gizmoMode != GIZMO_MODE_MOVE
                     and gizmoMode != GIZMO_MODE_SCALE)
                    or IsGizmoPlane(axis) == false)) {
            return;
        }
        var sourceX = 0.0;
        var sourceY = 0.0;
        var sourceZ = 0.0;
        if gizmoMode == GIZMO_MODE_ROTATE {
            var rotation = node.Rotation;
            var euler = QuaternionToEulerDegrees(rotation);
            sourceX = euler.X;
            sourceY = euler.Y;
            sourceZ = euler.Z;
        } else if gizmoMode == GIZMO_MODE_SCALE {
            var scale = node.Scale;
            sourceX = scale.X;
            sourceY = scale.Y;
            sourceZ = scale.Z;
        } else {
            var position = node.Position;
            sourceX = position.X;
            sourceY = position.Y;
            sourceZ = position.Z;
        }
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            if gizmoMode == GIZMO_MODE_ROTATE {
                sourceX = 0.0;
                sourceY = 0.0;
                sourceZ = 0.0;
            } else if gizmoMode == GIZMO_MODE_SCALE {
                var worldScale = node.WorldScale;
                sourceX = worldScale.X;
                sourceY = worldScale.Y;
                sourceZ = worldScale.Z;
            } else {
                var worldPosition = node.WorldPosition;
                sourceX = worldPosition.X;
                sourceY = worldPosition.Y;
                sourceZ = worldPosition.Z;
            }
        }
        var initialRingAngle = 0.0;
        var initialRingValid = false;
        if gizmoMode == GIZMO_MODE_ROTATE {
            var pointerX =
                PhysicalPointerToUi(Input.Mouse.X())
                - viewportImage.GetScreenX();
            var pointerY =
                PhysicalPointerToUi(Input.Mouse.Y())
                - viewportImage.GetScreenY();
            var decodedRing = GizmoRotationRingAngle(
                node, axis, pointerX, pointerY);
            if decodedRing.valid == false { return; }
            initialRingAngle = decodedRing.degrees;
            initialRingValid = true;
        }
        gizmoDragAxis = axis;
        gizmoDragChanged = false;
        gizmoDragAccumulated = 0.0;
        gizmoDragAccumulatedB = 0.0;
        gizmoDragPreviousRingAngle = initialRingAngle;
        gizmoDragRingAngleValid = initialRingValid;
        gizmoDragStartX = sourceX;
        gizmoDragStartY = sourceY;
        gizmoDragStartZ = sourceZ;
        gizmoDragIndices = scene_selection.Normalize(
            selectedIndices, flatNodes.count(), selectedIndex);
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            gizmoDragIndices =
                HierarchyOrderedSelection(gizmoDragIndices);
        }
        gizmoDragStartXs = [];
        gizmoDragStartYs = [];
        gizmoDragStartZs = [];
        gizmoDragStartPositions = [];
        gizmoDragStartRotations = [];
        gizmoDragStartScales = [];
        gizmoDragStartWorldMatrices = [];
        gizmoDragStartWorldPositions = [];
        gizmoDragStartWorldScales = [];
        var selectionIndex = 0;
        while selectionIndex < gizmoDragIndices.count() {
            var selectedNode = flatNodes.get(
                gizmoDragIndices.get(selectionIndex));
            gizmoDragStartPositions.add(selectedNode.Position);
            gizmoDragStartRotations.add(selectedNode.Rotation);
            gizmoDragStartScales.add(selectedNode.Scale);
            if gizmoTransformSpace
               == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                gizmoDragStartWorldMatrices.add(
                    selectedNode.WorldMatrix);
                gizmoDragStartWorldPositions.add(
                    selectedNode.WorldPosition);
                gizmoDragStartWorldScales.add(
                    selectedNode.WorldScale);
            }
            var startX = 0.0;
            var startY = 0.0;
            var startZ = 0.0;
            if gizmoMode == GIZMO_MODE_ROTATE {
                var selectedEuler =
                    QuaternionToEulerDegrees(selectedNode.Rotation);
                startX = selectedEuler.X;
                startY = selectedEuler.Y;
                startZ = selectedEuler.Z;
            } else if gizmoMode == GIZMO_MODE_SCALE {
                var selectedScale = selectedNode.Scale;
                startX = selectedScale.X;
                startY = selectedScale.Y;
                startZ = selectedScale.Z;
            } else {
                var selectedPosition = selectedNode.Position;
                startX = selectedPosition.X;
                startY = selectedPosition.Y;
                startZ = selectedPosition.Z;
            }
            gizmoDragStartXs.add(startX);
            gizmoDragStartYs.add(startY);
            gizmoDragStartZs.add(startZ);
            selectionIndex = selectionIndex + 1;
        }
        Input.Mouse.Capture();
        toolbarStatus.SetText(
            scene_transform_3d.ModeAction(gizmoMode)
            + " " + gizmoDragIndices.count()
            + " selected node(s) on "
            + scene_transform_3d.SpaceLabel(gizmoTransformSpace)
            + " " + GizmoHandleLabel(axis)
            + GizmoSnapStatus());
        renderDirty = true;
    }

    /// @brief Apply one frame of pointer motion from the gesture origin.
    hide func ApplyGizmoMouseDelta() {
        var node = SelectedNode();
        if node == null {
            ResetGizmoDrag(true);
            return;
        }
        var deltaX = PhysicalPointerToUi(Input.Mouse.DeltaX());
        var deltaY = PhysicalPointerToUi(Input.Mouse.DeltaY());
        if deltaX == 0 and deltaY == 0 { return; }

        var world = node.WorldPosition;
        var origin = Project(world.X, world.Y, world.Z);
        if gizmoMode == GIZMO_MODE_ROTATE
           and IsGizmoAxis(gizmoDragAxis) {
            var pointerX =
                PhysicalPointerToUi(Input.Mouse.X())
                - viewportImage.GetScreenX();
            var pointerY =
                PhysicalPointerToUi(Input.Mouse.Y())
                - viewportImage.GetScreenY();
            var decodedRing = GizmoRotationRingAngle(
                node, gizmoDragAxis, pointerX, pointerY);
            if decodedRing.valid == false {
                gizmoDragRingAngleValid = false;
                return;
            }
            if gizmoDragRingAngleValid == false {
                gizmoDragPreviousRingAngle = decodedRing.degrees;
                gizmoDragRingAngleValid = true;
                return;
            }
            var amount = scene_transform_3d.SignedAngleDelta(
                gizmoDragPreviousRingAngle, decodedRing.degrees);
            gizmoDragPreviousRingAngle = decodedRing.degrees;
            if scene_transform_3d.NearlyEqual(amount, 0.0) {
                return;
            }
            gizmoDragAccumulated = gizmoDragAccumulated + amount;

            var sourceValue = gizmoDragStartZ;
            if gizmoDragAxis == GIZMO_AXIS_X {
                sourceValue = gizmoDragStartX;
            } else if gizmoDragAxis == GIZMO_AXIS_Y {
                sourceValue = gizmoDragStartY;
            }
            var targetValue = scene_transform_3d.AxisTarget(
                GIZMO_MODE_ROTATE,
                sourceValue,
                gizmoDragAccumulated,
                EffectiveSnapEnabled());
            if gizmoTransformSpace
               == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                var applied =
                    ApplyLiveWorldGizmoTarget(targetValue);
                gizmoDragChanged = applied
                    and scene_transform_3d.NearlyEqual(
                        sourceValue, targetValue) == false;
            } else {
                ApplyLiveGizmoTarget(node, targetValue);
                gizmoDragChanged =
                    scene_transform_3d.NearlyEqual(
                        sourceValue, targetValue) == false;
            }
            renderDirty = true;
            return;
        }
        if IsGizmoPlane(gizmoDragAxis) {
            var axisA = GizmoPlaneAxisA(gizmoDragAxis);
            var axisB = GizmoPlaneAxisB(gizmoDragAxis);
            var endpointA = GizmoAxisEndpoint(node, axisA);
            var endpointB = GizmoAxisEndpoint(node, axisB);
            var planeDrag = scene_transform_3d.PlanarDragAmounts(
                gizmoMode, deltaX, deltaY,
                endpointA.x - origin.x,
                endpointA.y - origin.y,
                endpointB.x - origin.x,
                endpointB.y - origin.y,
                GizmoDragLength(node, axisA),
                GizmoDragLength(node, axisB));
            if planeDrag.valid == false
               or (scene_transform_3d.NearlyEqual(
                       planeDrag.amountA, 0.0)
                   and scene_transform_3d.NearlyEqual(
                       planeDrag.amountB, 0.0)) {
                return;
            }
            gizmoDragAccumulated =
                gizmoDragAccumulated + planeDrag.amountA;
            gizmoDragAccumulatedB =
                gizmoDragAccumulatedB + planeDrag.amountB;

            var sourceA = gizmoDragStartZ;
            if axisA == GIZMO_AXIS_X { sourceA = gizmoDragStartX; }
            else if axisA == GIZMO_AXIS_Y {
                sourceA = gizmoDragStartY;
            }
            var sourceB = gizmoDragStartZ;
            if axisB == GIZMO_AXIS_X { sourceB = gizmoDragStartX; }
            else if axisB == GIZMO_AXIS_Y {
                sourceB = gizmoDragStartY;
            }
            var targetA = scene_transform_3d.AxisTarget(
                gizmoMode, sourceA, gizmoDragAccumulated,
                EffectiveSnapEnabled());
            var targetB = scene_transform_3d.AxisTarget(
                gizmoMode, sourceB, gizmoDragAccumulatedB,
                EffectiveSnapEnabled());
            if gizmoTransformSpace
               == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                var applied = ApplyLiveWorldGizmoPlaneTarget(
                    targetA, targetB);
                gizmoDragChanged = applied
                    and (scene_transform_3d.NearlyEqual(
                             sourceA, targetA) == false
                         or scene_transform_3d.NearlyEqual(
                                sourceB, targetB) == false);
            } else {
                ApplyLiveGizmoPlaneTarget(targetA, targetB);
                gizmoDragChanged =
                    scene_transform_3d.NearlyEqual(
                        sourceA, targetA) == false
                    or scene_transform_3d.NearlyEqual(
                           sourceB, targetB) == false;
            }
            renderDirty = true;
            return;
        }
        var endpoint = GizmoAxisEndpoint(node, gizmoDragAxis);
        var axisX = endpoint.x - origin.x;
        var axisY = endpoint.y - origin.y;
        var amount = scene_transform_3d.AxisDragAmount(
            gizmoMode, deltaX, deltaY, axisX, axisY,
            GizmoDragLength(node, gizmoDragAxis));
        if amount > -0.0000001 and amount < 0.0000001 { return; }
        gizmoDragAccumulated = gizmoDragAccumulated + amount;

        var sourceValue = gizmoDragStartZ;
        if gizmoDragAxis == GIZMO_AXIS_X { sourceValue = gizmoDragStartX; }
        else if gizmoDragAxis == GIZMO_AXIS_Y {
            sourceValue = gizmoDragStartY;
        }
        var targetValue = scene_transform_3d.AxisTarget(
            gizmoMode, sourceValue, gizmoDragAccumulated,
            EffectiveSnapEnabled());
        if gizmoTransformSpace
           == scene_transform_3d.TRANSFORM_SPACE_WORLD {
            var applied = ApplyLiveWorldGizmoTarget(targetValue);
            gizmoDragChanged = applied
                and scene_transform_3d.NearlyEqual(
                    sourceValue, targetValue) == false;
        } else {
            ApplyLiveGizmoTarget(node, targetValue);
            gizmoDragChanged =
                scene_transform_3d.NearlyEqual(
                    sourceValue, targetValue) == false;
        }
        renderDirty = true;
    }

    /// @brief Commit one complete axis drag as a single undoable edit.
    hide func FinishGizmoDrag() -> Boolean {
        var changed = gizmoDragChanged;
        var node = SelectedNode();
        var completedMode = gizmoMode;
        var transformedCount = gizmoDragIndices.count();
        ResetGizmoDrag(true);
        renderDirty = true;
        if changed == false or node == null { return false; }
        if CommitScene(
               scene_transform_3d.ModeHistoryVerb(completedMode)
               + " " + transformedCount + " selected node(s)") {
            return true;
        }
        return false;
    }

    /// @brief Restore the drag origin and leave document/history untouched.
    hide func CancelGizmoDrag() {
        if gizmoDragAxis != GIZMO_AXIS_NONE {
            if gizmoTransformSpace
               == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                RestoreLocalTransforms(
                    gizmoDragIndices,
                    gizmoDragStartPositions,
                    gizmoDragStartRotations,
                    gizmoDragStartScales);
            } else {
                var selectionIndex = 0;
                while selectionIndex < gizmoDragIndices.count()
                      and selectionIndex < gizmoDragStartXs.count()
                      and selectionIndex < gizmoDragStartYs.count()
                      and selectionIndex < gizmoDragStartZs.count() {
                    var nodeIndex = gizmoDragIndices.get(selectionIndex);
                    if nodeIndex >= 0 and nodeIndex < flatNodes.count() {
                        ApplyNodeTransformValues(
                            flatNodes.get(nodeIndex),
                            gizmoMode,
                            gizmoDragStartXs.get(selectionIndex),
                            gizmoDragStartYs.get(selectionIndex),
                            gizmoDragStartZs.get(selectionIndex));
                    }
                    selectionIndex = selectionIndex + 1;
                }
            }
            var node = SelectedNode();
            if node != null {
                if gizmoTransformSpace
                   == scene_transform_3d.TRANSFORM_SPACE_WORLD {
                    RefreshSelectedFields();
                } else if gizmoMode == GIZMO_MODE_ROTATE {
                    rotationX.SetValue(gizmoDragStartX);
                    rotationY.SetValue(gizmoDragStartY);
                    rotationZ.SetValue(gizmoDragStartZ);
                } else if gizmoMode == GIZMO_MODE_SCALE {
                    scaleX.SetValue(gizmoDragStartX);
                    scaleY.SetValue(gizmoDragStartY);
                    scaleZ.SetValue(gizmoDragStartZ);
                } else {
                    positionX.SetValue(gizmoDragStartX);
                    positionY.SetValue(gizmoDragStartY);
                    positionZ.SetValue(gizmoDragStartZ);
                }
            }
        }
        ResetGizmoDrag(true);
        toolbarStatus.SetText("Transform canceled");
        renderDirty = true;
    }

    /// @brief Apply one live world-plane target from immutable gesture origins.
    /// @return True when every selected node accepted the exact transform.
    hide func ApplyLiveWorldGizmoPlaneTarget(
        targetA: Number,
        targetB: Number) -> Boolean {
        var axisA = GizmoPlaneAxisA(gizmoDragAxis);
        var axisB = GizmoPlaneAxisB(gizmoDragAxis);
        var sourceA = gizmoDragStartZ;
        if axisA == GIZMO_AXIS_X { sourceA = gizmoDragStartX; }
        else if axisA == GIZMO_AXIS_Y { sourceA = gizmoDragStartY; }
        var sourceB = gizmoDragStartZ;
        if axisB == GIZMO_AXIS_X { sourceB = gizmoDragStartX; }
        else if axisB == GIZMO_AXIS_Y { sourceB = gizmoDragStartY; }
        var deltaA = targetA - sourceA;
        var deltaB = targetB - sourceB;

        RestoreLocalTransforms(
            gizmoDragIndices,
            gizmoDragStartPositions,
            gizmoDragStartRotations,
            gizmoDragStartScales);
        var accepted = true;
        var selectionIndex = 0;
        while selectionIndex < gizmoDragIndices.count() and accepted
              and selectionIndex < gizmoDragStartWorldMatrices.count()
              and selectionIndex < gizmoDragStartWorldPositions.count()
              and selectionIndex < gizmoDragStartWorldScales.count() {
            var desired = WorldPlaneTargetMatrix(
                gizmoDragStartWorldMatrices.get(selectionIndex),
                gizmoDragStartWorldPositions.get(selectionIndex),
                gizmoDragStartWorldScales.get(selectionIndex),
                gizmoMode,
                axisA,
                axisB,
                deltaA,
                deltaB);
            var nodeIndex = gizmoDragIndices.get(selectionIndex);
            if desired == null
               or nodeIndex < 0 or nodeIndex >= flatNodes.count()
               or flatNodes.get(nodeIndex)
                      .TrySetWorldMatrix(desired) == false {
                accepted = false;
            }
            selectionIndex = selectionIndex + 1;
        }
        if accepted == false
           or selectionIndex != gizmoDragIndices.count() {
            RestoreLocalTransforms(
                gizmoDragIndices,
                gizmoDragStartPositions,
                gizmoDragStartRotations,
                gizmoDragStartScales);
            detailLabel.SetText(
                "This world-space plane drag would require a singular, "
                + "degenerate, or sheared local transform. The gesture remains "
                + "uncommitted.");
            toolbarStatus.SetText("World plane transform rejected");
            RefreshSelectedFields();
            return false;
        }
        RefreshSelectedFields();
        return true;
    }

    /// @brief Apply one local Move/Scale plane target before release history.
    hide func ApplyLiveGizmoPlaneTarget(
        targetA: Number,
        targetB: Number) {
        var axisA = GizmoPlaneAxisA(gizmoDragAxis);
        var axisB = GizmoPlaneAxisB(gizmoDragAxis);
        var sourceA = gizmoDragStartZ;
        if axisA == GIZMO_AXIS_X { sourceA = gizmoDragStartX; }
        else if axisA == GIZMO_AXIS_Y { sourceA = gizmoDragStartY; }
        var sourceB = gizmoDragStartZ;
        if axisB == GIZMO_AXIS_X { sourceB = gizmoDragStartX; }
        else if axisB == GIZMO_AXIS_Y { sourceB = gizmoDragStartY; }
        var deltaA = targetA - sourceA;
        var deltaB = targetB - sourceB;
        var deltaX = 0.0;
        var deltaY = 0.0;
        var deltaZ = 0.0;
        if axisA == GIZMO_AXIS_X { deltaX = deltaA; }
        else if axisA == GIZMO_AXIS_Y { deltaY = deltaA; }
        else { deltaZ = deltaA; }
        if axisB == GIZMO_AXIS_X { deltaX = deltaB; }
        else if axisB == GIZMO_AXIS_Y { deltaY = deltaB; }
        else { deltaZ = deltaB; }

        var selectionIndex = 0;
        while selectionIndex < gizmoDragIndices.count()
              and selectionIndex < gizmoDragStartXs.count()
              and selectionIndex < gizmoDragStartYs.count()
              and selectionIndex < gizmoDragStartZs.count() {
            var nodeIndex = gizmoDragIndices.get(selectionIndex);
            if nodeIndex >= 0 and nodeIndex < flatNodes.count() {
                var startX = gizmoDragStartXs.get(selectionIndex);
                var startY = gizmoDragStartYs.get(selectionIndex);
                var startZ = gizmoDragStartZs.get(selectionIndex);
                var targetX = startX + deltaX;
                var targetY = startY + deltaY;
                var targetZ = startZ + deltaZ;
                if gizmoMode == GIZMO_MODE_SCALE {
                    if axisA == GIZMO_AXIS_X
                       or axisB == GIZMO_AXIS_X {
                        targetX = scene_transform_3d.UsableScale(
                            targetX, startX);
                    }
                    if axisA == GIZMO_AXIS_Y
                       or axisB == GIZMO_AXIS_Y {
                        targetY = scene_transform_3d.UsableScale(
                            targetY, startY);
                    }
                    if axisA == GIZMO_AXIS_Z
                       or axisB == GIZMO_AXIS_Z {
                        targetZ = scene_transform_3d.UsableScale(
                            targetZ, startZ);
                    }
                }
                ApplyNodeTransformValues(
                    flatNodes.get(nodeIndex),
                    gizmoMode,
                    targetX,
                    targetY,
                    targetZ);
            }
            selectionIndex = selectionIndex + 1;
        }
        var primaryX = gizmoDragStartX + deltaX;
        var primaryY = gizmoDragStartY + deltaY;
        var primaryZ = gizmoDragStartZ + deltaZ;
        if gizmoMode == GIZMO_MODE_SCALE {
            if axisA == GIZMO_AXIS_X
               or axisB == GIZMO_AXIS_X {
                primaryX = scene_transform_3d.UsableScale(
                    primaryX, gizmoDragStartX);
            }
            if axisA == GIZMO_AXIS_Y
               or axisB == GIZMO_AXIS_Y {
                primaryY = scene_transform_3d.UsableScale(
                    primaryY, gizmoDragStartY);
            }
            if axisA == GIZMO_AXIS_Z
               or axisB == GIZMO_AXIS_Z {
                primaryZ = scene_transform_3d.UsableScale(
                    primaryZ, gizmoDragStartZ);
            }
            scaleX.SetValue(primaryX);
            scaleY.SetValue(primaryY);
            scaleZ.SetValue(primaryZ);
        } else {
            positionX.SetValue(primaryX);
            positionY.SetValue(primaryY);
            positionZ.SetValue(primaryZ);
        }
    }

    /// @brief Apply one live world-space target from immutable gesture origins.
    /// @return True when every selected node accepted the exact conversion.
    hide func ApplyLiveWorldGizmoTarget(targetValue: Number) -> Boolean {
        var sourceValue = gizmoDragStartZ;
        if gizmoDragAxis == GIZMO_AXIS_X {
            sourceValue = gizmoDragStartX;
        } else if gizmoDragAxis == GIZMO_AXIS_Y {
            sourceValue = gizmoDragStartY;
        }
        var delta = targetValue - sourceValue;
        RestoreLocalTransforms(
            gizmoDragIndices,
            gizmoDragStartPositions,
            gizmoDragStartRotations,
            gizmoDragStartScales);

        var accepted = true;
        var selectionIndex = 0;
        while selectionIndex < gizmoDragIndices.count() and accepted
              and selectionIndex < gizmoDragStartWorldMatrices.count()
              and selectionIndex < gizmoDragStartWorldPositions.count()
              and selectionIndex < gizmoDragStartWorldScales.count() {
            var desired = WorldAxisTargetMatrix(
                gizmoDragStartWorldMatrices.get(selectionIndex),
                gizmoDragStartWorldPositions.get(selectionIndex),
                gizmoDragStartWorldScales.get(selectionIndex),
                gizmoMode,
                gizmoDragAxis,
                delta);
            var nodeIndex = gizmoDragIndices.get(selectionIndex);
            if desired == null
               or nodeIndex < 0 or nodeIndex >= flatNodes.count()
               or flatNodes.get(nodeIndex)
                      .TrySetWorldMatrix(desired) == false {
                accepted = false;
            }
            selectionIndex = selectionIndex + 1;
        }
        if accepted == false
           or selectionIndex != gizmoDragIndices.count() {
            RestoreLocalTransforms(
                gizmoDragIndices,
                gizmoDragStartPositions,
                gizmoDragStartRotations,
                gizmoDragStartScales);
            detailLabel.SetText(
                "This world-space drag would require local shear or a "
                + "singular transform. The gesture remains uncommitted.");
            toolbarStatus.SetText("World transform rejected");
            RefreshSelectedFields();
            return false;
        }
        RefreshSelectedFields();
        return true;
    }

    /// @brief Apply one snapped target while deferring serialization to release.
    hide func ApplyLiveGizmoTarget(node: SceneNode,
                                   targetValue: Number) {
        if node == null { return; }
        var primarySource = gizmoDragStartZ;
        if gizmoDragAxis == GIZMO_AXIS_X {
            primarySource = gizmoDragStartX;
        } else if gizmoDragAxis == GIZMO_AXIS_Y {
            primarySource = gizmoDragStartY;
        }
        var delta = targetValue - primarySource;
        var selectionIndex = 0;
        while selectionIndex < gizmoDragIndices.count()
              and selectionIndex < gizmoDragStartXs.count()
              and selectionIndex < gizmoDragStartYs.count()
              and selectionIndex < gizmoDragStartZs.count() {
            var targetX = gizmoDragStartXs.get(selectionIndex);
            var targetY = gizmoDragStartYs.get(selectionIndex);
            var targetZ = gizmoDragStartZs.get(selectionIndex);
            if gizmoDragAxis == GIZMO_AXIS_X {
                targetX = targetX + delta;
            } else if gizmoDragAxis == GIZMO_AXIS_Y {
                targetY = targetY + delta;
            } else {
                targetZ = targetZ + delta;
            }
            if gizmoMode == GIZMO_MODE_SCALE {
                if gizmoDragAxis == GIZMO_AXIS_X {
                    targetX = scene_transform_3d.UsableScale(
                        targetX, gizmoDragStartXs.get(selectionIndex));
                } else if gizmoDragAxis == GIZMO_AXIS_Y {
                    targetY = scene_transform_3d.UsableScale(
                        targetY, gizmoDragStartYs.get(selectionIndex));
                } else {
                    targetZ = scene_transform_3d.UsableScale(
                        targetZ, gizmoDragStartZs.get(selectionIndex));
                }
            }
            var nodeIndex = gizmoDragIndices.get(selectionIndex);
            if nodeIndex >= 0 and nodeIndex < flatNodes.count() {
                ApplyNodeTransformValues(
                    flatNodes.get(nodeIndex),
                    gizmoMode,
                    targetX,
                    targetY,
                    targetZ);
            }
            selectionIndex = selectionIndex + 1;
        }
        var primaryX = gizmoDragStartX;
        var primaryY = gizmoDragStartY;
        var primaryZ = gizmoDragStartZ;
        if gizmoDragAxis == GIZMO_AXIS_X { primaryX = targetValue; }
        else if gizmoDragAxis == GIZMO_AXIS_Y { primaryY = targetValue; }
        else { primaryZ = targetValue; }
        if gizmoMode == GIZMO_MODE_ROTATE {
            rotationX.SetValue(primaryX);
            rotationY.SetValue(primaryY);
            rotationZ.SetValue(primaryZ);
        } else if gizmoMode == GIZMO_MODE_SCALE {
            scaleX.SetValue(primaryX);
            scaleY.SetValue(primaryY);
            scaleZ.SetValue(primaryZ);
        } else {
            positionX.SetValue(primaryX);
            positionY.SetValue(primaryY);
            positionZ.SetValue(primaryZ);
        }
    }

    /// @brief Apply three local transform components without serializing.
    hide func ApplyNodeTransformValues(node: SceneNode,
                                       transformMode: Integer,
                                       x: Number,
                                       y: Number,
                                       z: Number) {
        if node == null { return; }
        if transformMode == GIZMO_MODE_ROTATE {
            node.Rotation = Quat.FromEuler(
                x * DEG_TO_RAD,
                y * DEG_TO_RAD,
                z * DEG_TO_RAD).Normalize();
        } else if transformMode == GIZMO_MODE_SCALE {
            node.SetScale(x, y, z);
        } else {
            node.SetPosition(x, y, z);
        }
    }

    /// @brief Clear gesture-only state and release pointer capture if owned.
    hide func ResetGizmoDrag(releaseCapture: Boolean) {
        var wasDragging = gizmoDragAxis != GIZMO_AXIS_NONE;
        gizmoDragAxis = GIZMO_AXIS_NONE;
        gizmoDragChanged = false;
        gizmoDragAccumulated = 0.0;
        gizmoDragAccumulatedB = 0.0;
        gizmoDragPreviousRingAngle = 0.0;
        gizmoDragRingAngleValid = false;
        gizmoDragStartX = 0.0;
        gizmoDragStartY = 0.0;
        gizmoDragStartZ = 0.0;
        gizmoDragIndices = [];
        gizmoDragStartXs = [];
        gizmoDragStartYs = [];
        gizmoDragStartZs = [];
        gizmoDragStartPositions = [];
        gizmoDragStartRotations = [];
        gizmoDragStartScales = [];
        gizmoDragStartWorldMatrices = [];
        gizmoDragStartWorldPositions = [];
        gizmoDragStartWorldScales = [];
        if releaseCapture and wasDragging and Input.Mouse.IsCaptured() {
            Input.Mouse.Release();
        }
    }

    /// @brief Return the app's logical-to-framebuffer scale for legacy pixel APIs.
    hide func EffectiveUiScale() -> Number {
        if guiApp == null { return 1.0; }
        var scale = guiApp.GetEffectiveScale();
        if scale <= 0.0 { return 1.0; }
        return scale;
    }

    /// @brief Convert a GUI-app pointer coordinate into effective UI units.
    hide func PhysicalPointerToUi(value: Number) -> Number {
        return value / EffectiveUiScale();
    }

    /// @brief Read a legacy framebuffer scroll offset as logical UI units.
    hide func LogicalScrollY(scroll: GUI.ScrollView) -> Number {
        if scroll == null { return 0.0; }
        return scroll.GetScrollY() / EffectiveUiScale();
    }

    /// @brief Apply logical offsets through ScrollView's framebuffer-pixel API.
    hide func SetLogicalScroll(scroll: GUI.ScrollView,
                               x: Number,
                               y: Number) {
        if scroll == null { return; }
        var scale = EffectiveUiScale();
        scroll.SetScroll(x * scale, y * scale);
    }

    /// @brief Apply logical content dimensions through the legacy pixel API.
    hide func SetLogicalContentSize(scroll: GUI.ScrollView,
                                    width: Number,
                                    height: Number) {
        if scroll == null { return; }
        var scale = EffectiveUiScale();
        scroll.SetContentSize(width * scale, height * scale);
    }

    hide func GizmoAxisLabel(axis: Integer) -> String {
        if axis == GIZMO_PLANE_XY { return "XY"; }
        if axis == GIZMO_PLANE_XZ { return "XZ"; }
        if axis == GIZMO_PLANE_YZ { return "YZ"; }
        if axis == GIZMO_AXIS_X { return "X"; }
        if axis == GIZMO_AXIS_Y { return "Y"; }
        return "Z";
    }

    /// @brief Describe an axis or plane without relying on color alone.
    hide func GizmoHandleLabel(handle: Integer) -> String {
        if IsGizmoPlane(handle) {
            if gizmoMode == GIZMO_MODE_SCALE {
                return GizmoAxisLabel(handle) + " scale plane";
            }
            return GizmoAxisLabel(handle) + " move plane";
        }
        if gizmoMode == GIZMO_MODE_ROTATE {
            return GizmoAxisLabel(handle) + " rotation ring";
        }
        return GizmoAxisLabel(handle) + " axis";
    }

    hide func GizmoSnapStatus() -> String {
        if gizmoSnapEnabled == false { return ""; }
        return "  |  snap "
            + scene_transform_3d.SnapDescription(gizmoMode);
    }

    /// @brief Return camera distance, far plane, and orthographic half-height.
    /// @details Only nodes whose projected origins are near the viewport affect
    ///          the depth range. This keeps nearby geometry precise in large
    ///          worlds while retaining enough margin for visible mesh extents.
    hide func ViewportCameraRange() -> Vec3 {
        var halfHeight =
            renderedViewportHeight / (2.0 * viewScale);
        var depthMargin = halfHeight * 2.0 + 10.0;
        var maxTowardEye = 0.0;
        var minTowardEye = 0.0;
        var yaw = viewYawDegrees * DEG_TO_RAD;
        var pitch = viewPitchDegrees * DEG_TO_RAD;
        var sinYaw = Math.Sin(yaw);
        var cosYaw = Math.Cos(yaw);
        var sinPitch = Math.Sin(pitch);
        var cosPitch = Math.Cos(pitch);
        var halfWidthWorld =
            renderedViewportWidth / (2.0 * viewScale);
        var i = 0;
        while i < flatNodes.count() {
            var world = flatNodes.get(i).WorldPosition;
            var dx = world.X - viewTargetX;
            var dy = world.Y - viewTargetY;
            var dz = world.Z - viewTargetZ;
            var rotatedX = dx * cosYaw - dz * sinYaw;
            var rotatedZ = dx * sinYaw + dz * cosYaw;
            var rotatedY = dy * cosPitch - rotatedZ * sinPitch;
            // Pure rotated-space bound: a generous three-viewport margin,
            // independent of the retained camera so the depth range can be
            // computed before the camera is configured each frame.
            if rotatedX >= 0.0 - halfWidthWorld * 3.0
               and rotatedX <= halfWidthWorld * 3.0
               and rotatedY >= 0.0 - halfHeight * 3.0
               and rotatedY <= halfHeight * 3.0 {
                var towardEye =
                    rotatedZ * cosPitch + dy * sinPitch;
                if towardEye > maxTowardEye {
                    maxTowardEye = towardEye;
                }
                if towardEye < minTowardEye {
                    minTowardEye = towardEye;
                }
            }
            i = i + 1;
        }
        var distance = maxTowardEye + depthMargin;
        if distance < VIEWPORT_CAMERA_MIN_DISTANCE {
            distance = VIEWPORT_CAMERA_MIN_DISTANCE;
        }
        var farPlane = distance - minTowardEye + depthMargin;
        if farPlane < distance + depthMargin {
            farPlane = distance + depthMargin;
        }
        return Vec3.New(distance, farPlane, halfHeight);
    }

    /// @brief Retain one correctly sized windowless renderer and camera.
    /// @brief Enable or disable the accelerated offscreen viewport (ADR 0191).
    /// @details Probes never call this, so they keep the byte-deterministic
    ///          software constructor. The renderer is dropped and rebuilt on
    ///          the next damaged frame; canonical content never changes.
    expose func SetViewportAcceleration(enabled: Boolean) {
        if viewportAccelerationRequested == enabled { return; }
        viewportAccelerationRequested = enabled;
        viewportRenderTarget = null;
        viewportRenderCanvas = null;
        viewportRenderCamera = null;
        viewportRenderPostFX = null;
        viewportPostFXDirty = true;
        projectionCameraReady = false;
        renderDirty = true;
    }

    /// @brief The render-target width backing the viewport (probe surface).
    expose func ViewportTargetWidth() -> Integer {
        return viewportTargetWidth;
    }

    /// @brief The render-target height backing the viewport (probe surface).
    expose func ViewportTargetHeight() -> Integer {
        return viewportTargetHeight;
    }

    /// @brief Whether this frame should render at reduced resolution.
    /// @details Camera and gizmo drags re-render every frame; halving the
    ///          shaded target during them keeps interaction fluid while the
    ///          release path re-renders at full resolution (ADR 0191 interim).
    hide func InteractiveDegradeActive() -> Boolean {
        if flyActive { return true; }
        if gizmoDragAxis != GIZMO_AXIS_NONE { return true; }
        return viewportImage != null
            and viewportImage.IsHovered()
            and (Input.Mouse.IsDown(Input.Mouse.ButtonMiddle)
                 or Input.Mouse.IsDown(Input.Mouse.ButtonRight));
    }

    hide func EnsureViewportRenderer(targetWidth: Integer,
                                     targetHeight: Integer) -> Boolean {
        if targetWidth <= 0 or targetHeight <= 0 {
            return false;
        }
        if viewportRenderTarget != null
           and viewportRenderCanvas != null
           and viewportRenderCamera != null
           and viewportRenderTarget.Width == targetWidth
           and viewportRenderTarget.Height == targetHeight {
            return true;
        }

        var target = RenderTarget3D.New(targetWidth, targetHeight);
        if target == null { return false; }
        var canvas: Canvas3D = null;
        if viewportAccelerationRequested {
            canvas = Canvas3D.NewOffscreenAccelerated(target);
        } else {
            canvas = Canvas3D.NewOffscreen(target);
        }
        if canvas == null { return false; }
        // Camera framing derives from the LOGICAL viewport so a reduced
        // interactive target renders the identical view at lower resolution.
        var aspect =
            renderedViewportWidth / (renderedViewportHeight / 1.0);
        var halfHeight =
            renderedViewportHeight / (2.0 * viewScale);
        var camera = Camera3D.NewOrtho(
            halfHeight, aspect,
            VIEWPORT_CAMERA_NEAR,
            VIEWPORT_CAMERA_MIN_DISTANCE * 4.0);
        if camera == null { return false; }
        camera.Fov = ActiveViewportFovDegrees();
        canvas.SetDefaultLighting();

        viewportRenderTarget = target;
        viewportRenderCanvas = canvas;
        viewportRenderCamera = camera;
        viewportRenderPostFX = null;
        viewportPostFXDirty = true;
        viewportTargetWidth = targetWidth;
        viewportTargetHeight = targetHeight;
        // The fresh camera has never been configured for the current view
        // state; Project must fall back to hand math until it is.
        projectionCameraReady = false;
        return true;
    }

    /// @brief Eye distance that keeps viewScale exact at the view target.
    /// @details Pixels-per-unit on the target plane equals viewScale in both
    ///          projections, so zoom, pan, and Frame Selected keep identical
    ///          apparent-size semantics when switching modes (ADR 0183).
    hide func ActiveViewportFovDegrees() -> Number {
        if componentSchema != null
           and componentSchema.valid
           and componentSchema.scenePreview3D != null
           and componentSchema.scenePreview3D.present
           and componentSchema.scenePreview3D.hasCameraFov {
            return componentSchema.scenePreview3D.cameraFov;
        }
        return VIEWPORT_FOV_DEGREES;
    }

    /// @brief Return the tangent of half the active bounded perspective lens.
    hide func ActiveViewportFovHalfTan() -> Number {
        var tangent = Math.Tan(
            ActiveViewportFovDegrees() * DEG_TO_RAD * 0.5);
        if tangent < 0.0001 { return 0.0001; }
        return tangent;
    }

    hide func PerspectiveEyeDistance() -> Number {
        var distance = renderedViewportHeight
            / (2.0 * viewScale * ActiveViewportFovHalfTan());
        if distance < 0.5 { distance = 0.5; }
        if distance > 1000000.0 { distance = 1000000.0; }
        return distance;
    }

    /// @brief Keep the retained camera exact for draw, overlays, and picking.
    /// @details One mode-switchable Camera3D is the single projection source
    ///          (ADR 0183): the shaded render, every overlay, and every pick
    ///          ray read the same configured state in both modes.
    hide func ConfigureViewportCamera() -> Boolean {
        var targetWidth = renderedViewportWidth;
        var targetHeight = renderedViewportHeight;
        if InteractiveDegradeActive() {
            targetWidth = targetWidth / INTERACTIVE_RESOLUTION_DIVISOR;
            targetHeight = targetHeight / INTERACTIVE_RESOLUTION_DIVISOR;
            if targetWidth < MIN_VIEWPORT_WIDTH {
                targetWidth = MIN_VIEWPORT_WIDTH;
            }
            if targetHeight < MIN_VIEWPORT_HEIGHT {
                targetHeight = MIN_VIEWPORT_HEIGHT;
            }
        }
        if scene == null
           or EnsureViewportRenderer(targetWidth, targetHeight) == false {
            projectionCameraReady = false;
            return false;
        }
        var lookNode = ActiveLookThroughNode();
        if lookNode != null {
            ApplyAuthoredCameraPose(viewportRenderCamera, lookNode);
            projectionCameraReady = true;
            return true;
        }
        var cameraRange = ViewportCameraRange();
        if viewPerspective {
            var eyeDistance = PerspectiveEyeDistance();
            viewportRenderCamera.IsOrtho = false;
            viewportRenderCamera.Fov = ActiveViewportFovDegrees();
            var nearPlane = eyeDistance / 500.0;
            if nearPlane < VIEWPORT_CAMERA_NEAR {
                nearPlane = VIEWPORT_CAMERA_NEAR;
            }
            viewportRenderCamera.NearPlane = nearPlane;
            var farPlane =
                eyeDistance + (cameraRange.Y - cameraRange.X);
            if farPlane < eyeDistance * 2.0 {
                farPlane = eyeDistance * 2.0;
            }
            viewportRenderCamera.FarPlane = farPlane;
            viewportRenderCamera.Orbit(
                Vec3.New(viewTargetX, viewTargetY, viewTargetZ),
                eyeDistance,
                viewYawDegrees,
                viewPitchDegrees);
        } else {
            viewportRenderCamera.IsOrtho = true;
            viewportRenderCamera.OrthoSize = cameraRange.Z;
            viewportRenderCamera.NearPlane = VIEWPORT_CAMERA_NEAR;
            viewportRenderCamera.FarPlane = cameraRange.Y;
            viewportRenderCamera.Orbit(
                Vec3.New(viewTargetX, viewTargetY, viewTargetZ),
                cameraRange.X,
                viewYawDegrees,
                viewPitchDegrees);
        }
        projectionCameraReady = true;
        return true;
    }


    /// @brief Rebuild one retained portable project post-processing chain.
    /// @details Static schema values are copied into runtime state only when
    ///          the schema or render canvas changes, avoiding per-frame
    ///          allocation while keeping project code outside Studio.
    hide func RebuildProjectPreviewPostFX() {
        viewportRenderPostFX = null;
        viewportPostFXDirty = false;
        if componentSchema == null
           or componentSchema.valid == false
           or componentSchema.scenePreview3D == null {
            return;
        }
        var profile = componentSchema.scenePreview3D;
        if profile.present == false or profile.HasPostFX() == false {
            return;
        }
        var chain = PostFX3D.New();
        if chain == null { return; }
        if profile.hasTonemap {
            PostFX3D.AddTonemap(
                chain, profile.tonemapMode, profile.tonemapExposure);
        }
        if profile.hasBloom {
            PostFX3D.AddBloom(
                chain,
                profile.bloomThreshold,
                profile.bloomIntensity,
                profile.bloomPasses);
        }
        if profile.hasColorGrade {
            PostFX3D.AddColorGrade(
                chain,
                profile.colorGradeBrightness,
                profile.colorGradeContrast,
                profile.colorGradeSaturation);
        }
        if profile.hasVignette {
            PostFX3D.AddVignette(
                chain,
                profile.vignetteRadius,
                profile.vignetteSoftness);
        }
        if profile.hasFxaa and profile.fxaa {
            PostFX3D.AddFxaa(chain);
        }
        if chain.EffectCount > 0 {
            viewportRenderPostFX = chain;
        }
    }

    /// @brief Attach project effects only to the main shaded scene viewport.
    hide func ApplyProjectPreviewPostFX() {
        if viewportRenderCanvas == null { return; }
        if viewportPostFXDirty { RebuildProjectPreviewPostFX(); }
        if viewportMode == VIEWPORT_MODE_WIREFRAME
           or viewportRenderPostFX == null {
            Canvas3D.SetPostFX(viewportRenderCanvas, null);
            return;
        }
        Canvas3D.SetPostFX(
            viewportRenderCanvas, viewportRenderPostFX);
    }

    /// @brief Rasterize authored meshes and materials into the embedded image.
    hide func RenderAuthoredViewport() -> Boolean {
        if ConfigureViewportCamera() == false { return false; }
        viewportRenderCanvas.Wireframe =
            viewportMode == VIEWPORT_MODE_WIREFRAME;
        var authoredSkyPresent =
            ApplyEnvironmentToCanvas(viewportRenderCanvas);
        var projectPreview = ProjectPreviewRenderState();
        // Project profiles can supply the runtime-like sky/key/fill rig for
        // metadata-driven games. Editor assist remains only the fallback
        // ambient floor when that profile omits ambient.
        ApplyProjectPreviewEnvironment(
            viewportRenderCanvas,
            projectPreview,
            authoredSkyPresent,
            editorLightAssist);
        ApplyProjectPreviewPostFX();
        scene.Draw(viewportRenderCanvas, viewportRenderCamera);
        if projectPreviewScene != null {
            projectPreviewScene.Draw(
                viewportRenderCanvas, viewportRenderCamera);
        }
        if viewportMode == VIEWPORT_MODE_SHADED_WIRE {
            // Combined mode: the wire pass draws over the shaded frame
            // without clearing, giving Unity's Shaded Wireframe look.
            viewportRenderCanvas.Wireframe = true;
            scene.Draw(viewportRenderCanvas, viewportRenderCamera);
            if projectPreviewScene != null {
                projectPreviewScene.Draw(
                    viewportRenderCanvas, viewportRenderCamera);
            }
            viewportRenderCanvas.Wireframe = false;
        }
        var rendered: Pixels = null;
        if viewportRenderPostFX != null
           and viewportMode != VIEWPORT_MODE_WIREFRAME {
            // RenderTarget.AsPixels is the pre-finalization attachment.
            // ScreenshotFinal is the runtime boundary that actually applies
            // the retained chain before readback (ADR 0204).
            rendered =
                viewportRenderCanvas.ScreenshotFinal() as Pixels;
        } else {
            rendered = viewportRenderTarget.AsPixels() as Pixels;
        }
        if rendered == null { return false; }
        if viewportTargetWidth != renderedViewportWidth
           or viewportTargetHeight != renderedViewportHeight {
            // Reduced-resolution interactive frame: upscale so overlays,
            // picking, and the embedded image keep full-viewport coordinates.
            rendered = rendered.Scale(
                renderedViewportWidth, renderedViewportHeight) as Pixels;
            if rendered == null { return false; }
        }
        viewportPixels = rendered;
        return true;
    }

    /// @brief Draw authored geometry plus deterministic editor overlays.
    hide func RenderViewport() {
        renderDirty = false;
        viewYawDegrees = NormalizeYawDegrees(viewYawDegrees);
        viewPitchDegrees = ClampInt3D(viewPitchDegrees, -80, 80);
        viewScale = ClampInt3D(viewScale, 4, 120);
        viewportPixels = null;
        viewportRenderFallback = false;
        if scene != null and RenderAuthoredViewport() == false {
            viewportRenderFallback = true;
        }
        if viewportPixels == null {
            viewportPixels = Pixels.New(
                renderedViewportWidth, renderedViewportHeight);
            viewportPixels.FillColor(Color.RGB(22, 26, 34));
        }
        projectedX = [];
        projectedY = [];

        var gridColor = Color.RGB(47, 55, 67);
        var axisX = Color.RGB(170, 70, 70);
        var axisZ = Color.RGB(70, 110, 180);
        var gridCenterX = Convert.NumToInt(viewTargetX);
        var gridCenterZ = Convert.NumToInt(viewTargetZ);
        if showGrid {
            var line = -10;
            while line <= 10 {
                var worldX = gridCenterX + line;
                var worldZ = gridCenterZ + line;
                var a = Project(worldX, 0.0, gridCenterZ - 10);
                var b = Project(worldX, 0.0, gridCenterZ + 10);
                var c = Project(gridCenterX - 10, 0.0, worldZ);
                var d = Project(gridCenterX + 10, 0.0, worldZ);
                var colorA = gridColor;
                var colorB = gridColor;
                if viewPerspective {
                    var fade = line;
                    if fade < 0 { fade = 0 - fade; }
                    if fade > 7 {
                        colorA = Color.RGB(33, 39, 48);
                        colorB = Color.RGB(33, 39, 48);
                    } else if fade > 3 {
                        colorA = Color.RGB(40, 47, 58);
                        colorB = Color.RGB(40, 47, 58);
                    }
                }
                if worldX == 0 { colorA = axisZ; }
                if worldZ == 0 { colorB = axisX; }
                // Behind-eye projections mirror in perspective; draw only
                // segments whose endpoints are both in front of the camera.
                if a.visible and b.visible {
                    viewportPixels.DrawLine(a.x, a.y, b.x, b.y, colorA);
                }
                if c.visible and d.visible {
                    viewportPixels.DrawLine(c.x, c.y, d.x, d.y, colorB);
                }
                line = line + 1;
            }
        }

        if scene == null {
            var messageY = renderedViewportHeight / 2 - 12;
            viewportPixels.DrawTextCentered(
                messageY, "Unable to display this 3D scene",
                Color.RGB(230, 115, 115));
            viewportPixels.DrawTextCentered(
                messageY + 22, "Repair the VSCN or create a new scene",
                Color.RGB(180, 188, 202));
        } else {
            var i = 0;
            while i < flatNodes.count() {
                var node = flatNodes.get(i);
                var world = node.WorldPosition;
                var point = Project(world.X, world.Y, world.Z);
                var pickPoint = point;
                if node.Light != null and node.Mesh == null {
                    var lightWorld =
                        LightWorldPosition(node, node.Light);
                    pickPoint = Project(
                        lightWorld.X, lightWorld.Y, lightWorld.Z);
                }
                if pickPoint.visible {
                    projectedX.add(pickPoint.x);
                    projectedY.add(pickPoint.y);
                } else {
                    // Behind-eye projections mirror; keep them unpickable.
                    projectedX.add(-100000);
                    projectedY.add(-100000);
                }

                var parent = node.Parent;
                var parentIndex = FindFlatIndex(parent);
                if showMarkers and parentIndex >= 0 {
                    var parentWorld = parent.WorldPosition;
                    var parentPoint = Project(
                        parentWorld.X, parentWorld.Y, parentWorld.Z);
                    if point.visible and parentPoint.visible {
                        viewportPixels.DrawLine(
                            parentPoint.x, parentPoint.y, point.x, point.y,
                            Color.RGB(86, 96, 112));
                    }
                }

                var markerColor = Color.RGB(150, 165, 188);
                if node.Mesh != null {
                    markerColor = Color.RGB(91, 180, 235);
                } else if node.Light != null {
                    markerColor = Color.RGB(255, 190, 74);
                } else if node.Camera != null {
                    markerColor = Color.RGB(126, 214, 204);
                } else {
                    var componentTint = NodeComponentTint(node);
                    if componentTint != 0 { markerColor = componentTint; }
                }
                if node.Visible == false {
                    markerColor = Color.RGB(92, 98, 108);
                }
                if scene_selection.Contains(selectedIndices, i) {
                    markerColor = Color.RGB(104, 220, 255);
                }
                if i == selectedIndex and point.visible {
                    markerColor = Color.RGB(255, 195, 78);
                    var xEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_X);
                    var yEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_Y);
                    var zEnd = GizmoAxisEndpoint(node, GIZMO_AXIS_Z);
                    var selectedXColor = axisX;
                    var selectedYColor = Color.RGB(80, 190, 105);
                    var selectedZColor = axisZ;
                    if gizmoHoverAxis == GIZMO_AXIS_X
                       or gizmoDragAxis == GIZMO_AXIS_X {
                        selectedXColor = Color.RGB(255, 105, 105);
                    }
                    if gizmoHoverAxis == GIZMO_AXIS_Y
                       or gizmoDragAxis == GIZMO_AXIS_Y {
                        selectedYColor = Color.RGB(115, 240, 140);
                    }
                    if gizmoHoverAxis == GIZMO_AXIS_Z
                       or gizmoDragAxis == GIZMO_AXIS_Z {
                        selectedZColor = Color.RGB(105, 165, 255);
                    }
                    if gizmoMode == GIZMO_MODE_ROTATE {
                        DrawGizmoRotationRing(
                            point, yEnd, zEnd, selectedXColor);
                        DrawGizmoRotationRing(
                            point, zEnd, xEnd, selectedYColor);
                        DrawGizmoRotationRing(
                            point, xEnd, yEnd, selectedZColor);
                    } else {
                        if gizmoMode == GIZMO_MODE_MOVE
                           or gizmoMode == GIZMO_MODE_SCALE {
                            var xyFill = Color.RGB(84, 78, 38);
                            var xyOutline = Color.RGB(176, 158, 68);
                            var xzFill = Color.RGB(82, 48, 72);
                            var xzOutline = Color.RGB(184, 92, 154);
                            var yzFill = Color.RGB(36, 80, 82);
                            var yzOutline = Color.RGB(72, 174, 178);
                            if gizmoHoverAxis == GIZMO_PLANE_XY
                               or gizmoDragAxis == GIZMO_PLANE_XY {
                                xyFill = Color.RGB(154, 132, 44);
                                xyOutline = Color.RGB(255, 222, 96);
                            }
                            if gizmoHoverAxis == GIZMO_PLANE_XZ
                               or gizmoDragAxis == GIZMO_PLANE_XZ {
                                xzFill = Color.RGB(148, 66, 122);
                                xzOutline = Color.RGB(255, 132, 218);
                            }
                            if gizmoHoverAxis == GIZMO_PLANE_YZ
                               or gizmoDragAxis == GIZMO_PLANE_YZ {
                                yzFill = Color.RGB(44, 142, 146);
                                yzOutline = Color.RGB(104, 238, 242);
                            }
                            var crossed =
                                gizmoMode == GIZMO_MODE_SCALE;
                            DrawGizmoPlane(
                                point, xEnd, yEnd,
                                xyFill, xyOutline, crossed);
                            DrawGizmoPlane(
                                point, xEnd, zEnd,
                                xzFill, xzOutline, crossed);
                            DrawGizmoPlane(
                                point, yEnd, zEnd,
                                yzFill, yzOutline, crossed);
                        }
                        viewportPixels.DrawLine(
                            point.x, point.y,
                            xEnd.x, xEnd.y, selectedXColor);
                        viewportPixels.DrawLine(
                            point.x, point.y,
                            yEnd.x, yEnd.y, selectedYColor);
                        viewportPixels.DrawLine(
                            point.x, point.y,
                            zEnd.x, zEnd.y, selectedZColor);
                        DrawGizmoHandle(xEnd, selectedXColor);
                        DrawGizmoHandle(yEnd, selectedYColor);
                        DrawGizmoHandle(zEnd, selectedZColor);
                    }
                }
                if showMarkers and point.visible {
                    if node.Mesh != null {
                        viewportPixels.DrawFrame(
                            point.x - 6, point.y - 6, 13, 13, markerColor);
                    } else {
                        viewportPixels.DrawDisc(
                            point.x, point.y, 4, markerColor);
                    }
                }
                if node.Light != null and showLightOverlays {
                    DrawLightOverlay(
                        node, node.Light, i == selectedIndex);
                }
                if node.Camera != null and showCameraOverlays {
                    DrawCameraOverlay(node, i == selectedIndex);
                }
                if showColliderOverlays {
                    DrawColliderOverlay(node, i == selectedIndex);
                }
                i = i + 1;
            }
            DrawRouteOverlays();
            DrawSelectionFeedback();
        }

        DrawCameraPreviewInset();
        DrawOrientationNavigator();
        viewportImage.SetPixels(
            viewportPixels, renderedViewportWidth, renderedViewportHeight);
        viewportImage.SetSize(renderedViewportWidth, renderedViewportHeight);
        SetLogicalContentSize(
            viewportScroll,
            renderedViewportWidth, renderedViewportHeight);
        var clipped = "";
        if hierarchyClipped { clipped = "  |  hierarchy preview clipped"; }
        var count = 0;
        if scene != null { count = scene.NodeCount - 1; }
        var lightCount = AuthoredLightCount();
        var interaction = "";
        if gizmoDragAxis != GIZMO_AXIS_NONE {
            interaction = "  |  "
                + Str.ToLower(scene_transform_3d.ModeAction(gizmoMode))
                + " " + GizmoHandleLabel(gizmoDragAxis);
            if gizmoMode == GIZMO_MODE_ROTATE {
                // Live numeric readout: tenth-degree resolution of the
                // signed angle swept since the drag began.
                var tenths = Convert.NumToInt(
                    gizmoDragAccumulated * 10.0);
                var fraction = tenths % 10;
                if fraction < 0 { fraction = 0 - fraction; }
                interaction = interaction + " "
                    + (tenths / 10) + "." + fraction + " deg";
            }
        } else if gizmoHoverAxis != GIZMO_AXIS_NONE {
            interaction = "  |  " + GizmoHandleLabel(gizmoHoverAxis);
        } else if orientationHoverFace != ORIENTATION_FACE_NONE {
            interaction = "  |  view "
                + OrientationFaceLabel(orientationHoverFace);
        }
        var snapStatus = "";
        if gizmoSnapEnabled {
            snapStatus = " snap "
                + scene_transform_3d.SnapDescription(gizmoMode);
        }
        var renderStatus = ViewportModeLabel(viewportMode);
        if viewportRenderFallback {
            renderStatus = renderStatus + " fallback";
        }
        var projectionLabel = "persp";
        if viewPerspective == false { projectionLabel = "ortho"; }
        var statsStatus = "";
        if showStats and scene != null {
            statsStatus = "  |  visible " + scene.VisibleNodeCount
                + " culled " + scene.CulledCount;
            if viewportRenderCanvas != null {
                statsStatus = statsStatus
                    + "  |  cpu ms shadow "
                    + PassMsTenths(0) + " main " + PassMsTenths(1)
                    + " overlay " + PassMsTenths(2)
                    + " end " + PassMsTenths(3);
            }
        }
        var flyStatus = "";
        if flyActive {
            flyStatus = "  |  fly WASD/QE (wheel speed)";
        }
        var lookStatus = "";
        if ActiveLookThroughNode() != null {
            lookStatus = "  |  look-through "
                + NodeDisplayName(lookThroughNode);
        }
        var previewStatus = "";
        if projectPreviewInstanceCount > 0 {
            previewStatus = "  |  "
                + projectPreviewInstanceCount + " project preview(s)";
        }
        if projectPreviewMissingCount > 0 {
            previewStatus = previewStatus + "  |  "
                + projectPreviewMissingCount + " preview missing";
        }
        if projectPreviewClipped {
            previewStatus = previewStatus + "  |  preview cap";
        }
        viewStatusLabel.SetText(
            count + " nodes  |  view " + viewYawDegrees
            + "/" + viewPitchDegrees + "  |  " + viewScale + " px/u"
            + "  |  " + projectionLabel
            + "  |  " + lightCount + " light(s)"
            + "  |  " + renderStatus
            + "  |  " + scene_transform_3d.ModeLabel(gizmoMode)
            + snapStatus + statsStatus + flyStatus + lookStatus
            + previewStatus
            + clipped + interaction);
        viewportImage.SetAccessibleDescription(
            count + " scene nodes and " + lightCount
            + " authored lights plus " + projectPreviewInstanceCount
            + " project previews in " + renderStatus
            + " mode at " + viewScale + " pixels per world unit. "
            + "Click visible meshes to select; Shift adds and Control or "
            + "Command toggles. Middle or right drag orbits; add Shift to pan. "
            + "The top-right View navigator exposes Top, Front, Right, Bottom, "
            + "Back, Left, and the perspective/orthographic toggle.");
    }

    /// @brief Draw the responsive six-face camera navigator.
    /// @details The navigator is a pure viewport overlay. Stable geometry is
    ///          shared with OrientationFaceAt, active heading is amber, hover
    ///          is cyan, and axis-family tint keeps directions scannable.
    hide func DrawOrientationNavigator() {
        if viewportPixels == null
           or OrientationNavigatorVisible() == false {
            return;
        }
        var panelLeft = renderedViewportWidth
            - ORIENTATION_PANEL_MARGIN - ORIENTATION_PANEL_WIDTH;
        var panelTop = ORIENTATION_PANEL_MARGIN;
        viewportPixels.DrawBox(
            panelLeft, panelTop,
            ORIENTATION_PANEL_WIDTH, ORIENTATION_PANEL_HEIGHT,
            Color.RGB(25, 30, 39));
        viewportPixels.DrawFrame(
            panelLeft, panelTop,
            ORIENTATION_PANEL_WIDTH, ORIENTATION_PANEL_HEIGHT,
            Color.RGB(84, 95, 112));
        viewportPixels.DrawText(
            panelLeft + 7, panelTop + 8,
            "VIEW", Color.RGB(188, 198, 214));

        // Tiny XYZ triad gives the compact face grid an immediate spatial cue.
        var triadX = panelLeft + 57;
        var triadY = panelTop + 14;
        viewportPixels.DrawDisc(
            triadX, triadY, 2, Color.RGB(215, 220, 228));
        viewportPixels.DrawLine(
            triadX, triadY, triadX + 15, triadY,
            Color.RGB(218, 88, 88));
        viewportPixels.DrawLine(
            triadX, triadY, triadX, triadY - 9,
            Color.RGB(88, 205, 112));
        viewportPixels.DrawLine(
            triadX, triadY, triadX + 9, triadY + 7,
            Color.RGB(86, 138, 226));

        var projectionLeft = panelLeft + 91;
        var projectionTop = panelTop + 5;
        var projectionFill = Color.RGB(48, 57, 70);
        var projectionOutline = Color.RGB(104, 117, 136);
        if orientationHoverFace == ORIENTATION_PROJECTION_TOGGLE {
            projectionFill = Color.RGB(43, 94, 110);
            projectionOutline = Color.RGB(104, 220, 255);
        }
        viewportPixels.DrawBox(
            projectionLeft, projectionTop, 50, 17, projectionFill);
        viewportPixels.DrawFrame(
            projectionLeft, projectionTop, 50, 17, projectionOutline);
        var projectionText = "PERSP";
        if viewPerspective == false { projectionText = "ORTHO"; }
        viewportPixels.DrawText(
            projectionLeft + 5, projectionTop + 5,
            projectionText, Color.RGB(224, 229, 236));

        var active = ActiveOrientationFace();
        var face = ORIENTATION_FACE_TOP;
        while face <= ORIENTATION_FACE_LEFT {
            var column = face % 3;
            var row = face / 3;
            var left = panelLeft + ORIENTATION_FACE_LEFT_PAD
                + column
                    * (ORIENTATION_FACE_WIDTH + ORIENTATION_FACE_GAP);
            var top = panelTop + ORIENTATION_FACE_TOP_PAD
                + row
                    * (ORIENTATION_FACE_HEIGHT + ORIENTATION_FACE_GAP);
            var fill = Color.RGB(52, 61, 74);
            if face == ORIENTATION_FACE_TOP
               or face == ORIENTATION_FACE_BOTTOM {
                fill = Color.RGB(38, 82, 51);
            } else if face == ORIENTATION_FACE_FRONT
                      or face == ORIENTATION_FACE_BACK {
                fill = Color.RGB(37, 65, 104);
            } else {
                fill = Color.RGB(96, 48, 51);
            }
            var outline = Color.RGB(91, 104, 123);
            if face == active {
                fill = Color.RGB(124, 91, 35);
                outline = Color.RGB(255, 195, 78);
            }
            if face == orientationHoverFace {
                fill = Color.RGB(39, 105, 122);
                outline = Color.RGB(104, 220, 255);
            }
            viewportPixels.DrawBox(
                left, top,
                ORIENTATION_FACE_WIDTH, ORIENTATION_FACE_HEIGHT,
                fill);
            viewportPixels.DrawFrame(
                left, top,
                ORIENTATION_FACE_WIDTH, ORIENTATION_FACE_HEIGHT,
                outline);
            var label = "TOP";
            if face == ORIENTATION_FACE_FRONT { label = "FRONT"; }
            else if face == ORIENTATION_FACE_RIGHT { label = "RIGHT"; }
            else if face == ORIENTATION_FACE_BOTTOM { label = "BOT"; }
            else if face == ORIENTATION_FACE_BACK { label = "BACK"; }
            else if face == ORIENTATION_FACE_LEFT { label = "LEFT"; }
            var labelWidth = Str.get_Length(label) * 8;
            viewportPixels.DrawText(
                left + (ORIENTATION_FACE_WIDTH - labelWidth) / 2,
                top + 7,
                label,
                Color.RGB(235, 239, 244));
            face = face + 1;
        }
    }

    /// @brief Draw a mode-specific endpoint so tools are distinguishable.
    /// @brief Draw four short corner brackets around one screen rectangle.
    /// @details The cheap screen-space stand-in for a mesh silhouette until
    ///          the GPU outline pass lands (deferral recorded in status).
    hide func DrawCornerBrackets(bounds: ScreenBounds3D, color: Integer) {
        if viewportPixels == null { return; }
        var width = bounds.maxX - bounds.minX;
        var height = bounds.maxY - bounds.minY;
        var arm = 10;
        if width / 3 < arm { arm = width / 3; }
        if height / 3 < arm { arm = height / 3; }
        if arm < 3 { arm = 3; }
        viewportPixels.DrawLine(
            bounds.minX, bounds.minY, bounds.minX + arm, bounds.minY, color);
        viewportPixels.DrawLine(
            bounds.minX, bounds.minY, bounds.minX, bounds.minY + arm, color);
        viewportPixels.DrawLine(
            bounds.maxX, bounds.minY, bounds.maxX - arm, bounds.minY, color);
        viewportPixels.DrawLine(
            bounds.maxX, bounds.minY, bounds.maxX, bounds.minY + arm, color);
        viewportPixels.DrawLine(
            bounds.minX, bounds.maxY, bounds.minX + arm, bounds.maxY, color);
        viewportPixels.DrawLine(
            bounds.minX, bounds.maxY, bounds.minX, bounds.maxY - arm, color);
        viewportPixels.DrawLine(
            bounds.maxX, bounds.maxY, bounds.maxX - arm, bounds.maxY, color);
        viewportPixels.DrawLine(
            bounds.maxX, bounds.maxY, bounds.maxX, bounds.maxY - arm, color);
    }

    /// @brief Draw hover/selection bounds brackets and the marquee band.
    /// @details Selected mesh nodes get bracket outlines (primary amber,
    ///          others cyan); the hovered unselected mesh gets a subtle
    ///          bracket; an active marquee draws its live rectangle.
    hide func DrawSelectionFeedback() {
        if viewportPixels == null { return; }
        var i = 0;
        while i < flatNodes.count() {
            var isSelected =
                scene_selection.Contains(selectedIndices, i);
            var isHovered = i == hoveredViewportNode;
            if (isSelected or isHovered)
               and flatNodes.get(i).Mesh != null {
                var bounds = NodeScreenBounds(flatNodes.get(i));
                if bounds.visible {
                    var color = Color.RGB(96, 110, 126);
                    if isSelected { color = Color.RGB(104, 220, 255); }
                    if i == selectedIndex {
                        color = Color.RGB(255, 195, 78);
                    }
                    DrawCornerBrackets(bounds, color);
                }
            }
            i = i + 1;
        }
        if marqueeActive {
            var x = marqueeStartX;
            var y = marqueeStartY;
            var width = marqueeEndX - marqueeStartX;
            var height = marqueeEndY - marqueeStartY;
            if width < 0 {
                x = marqueeEndX;
                width = 0 - width;
            }
            if height < 0 {
                y = marqueeEndY;
                height = 0 - height;
            }
            viewportPixels.DrawFrame(
                x, y, width + 1, height + 1, Color.RGB(120, 190, 255));
        }
    }

    hide func DrawGizmoHandle(point: ProjectedPoint,
                              color: Integer) {
        if gizmoMode == GIZMO_MODE_SCALE {
            viewportPixels.DrawFrame(
                point.x - 4, point.y - 4, 9, 9, color);
            return;
        }
        viewportPixels.DrawDisc(point.x, point.y, 3, color);
    }

    /// @brief Resolve the authored light-local offset through node world space.
    hide func LightWorldPosition(node: SceneNode,
                                 light: Light3D) -> Vec3 {
        if node == null { return Vec3.New(0.0, 0.0, 0.0); }
        if light == null
           or scene_light_3d.HasPosition(light.Type) == false {
            return node.WorldPosition;
        }
        return Mat4.TransformPoint(node.WorldMatrix, light.Position) as Vec3;
    }

    /// @brief Resolve and normalize one light-local direction in world space.
    hide func LightWorldDirection(node: SceneNode,
                                  light: Light3D) -> Vec3 {
        if node == null or light == null {
            return Vec3.New(0.0, -1.0, 0.0);
        }
        var transformed = Mat4.TransformVector(
            node.WorldMatrix, light.Direction) as Vec3;
        if transformed == null {
            return Vec3.New(0.0, -1.0, 0.0);
        }
        var length = Math.Sqrt(
            transformed.X * transformed.X
            + transformed.Y * transformed.Y
            + transformed.Z * transformed.Z);
        if length <= 0.000001 {
            return Vec3.New(0.0, -1.0, 0.0);
        }
        return Vec3.New(
            transformed.X / length,
            transformed.Y / length,
            transformed.Z / length);
    }

    /// @brief Draw a pickable light glyph plus applicable direction and range.
    /// @details The retained overlay makes meshless lighting nodes visible
    ///          without replacing the live SceneGraph shading underneath it.
    hide func DrawLightOverlay(node: SceneNode,
                               light: Light3D,
                               selected: Boolean) {
        if node == null or light == null or viewportPixels == null { return; }
        var world = LightWorldPosition(node, light);
        var center = Project(world.X, world.Y, world.Z);
        if center.visible == false { return; }
        var nodeWorld = node.WorldPosition;
        var nodePoint = Project(
            nodeWorld.X, nodeWorld.Y, nodeWorld.Z);
        var color = scene_light_3d.PackedRgb(light);
        if color == 0 { color = Color.RGB(118, 100, 54); }
        if light.IsEnabled == false {
            color = Color.RGB(106, 108, 114);
        }
        if nodePoint.visible
           and (center.x != nodePoint.x or center.y != nodePoint.y) {
            viewportPixels.DrawLine(
                nodePoint.x, nodePoint.y,
                center.x, center.y,
                Color.RGB(132, 112, 66));
        }
        viewportPixels.DrawLine(
            center.x - 7, center.y,
            center.x + 7, center.y, color);
        viewportPixels.DrawLine(
            center.x, center.y - 7,
            center.x, center.y + 7, color);
        viewportPixels.DrawDisc(center.x, center.y, 4, color);
        var outline = Color.RGB(255, 220, 136);
        if selected { outline = Color.RGB(255, 195, 78); }
        viewportPixels.DrawFrame(
            center.x - 6, center.y - 6, 13, 13, outline);

        if scene_light_3d.HasDirection(light.Type) {
            var direction = LightWorldDirection(node, light);
            var endpoint = Project(
                world.X + direction.X * 1.5,
                world.Y + direction.Y * 1.5,
                world.Z + direction.Z * 1.5);
            if endpoint.visible {
                viewportPixels.DrawLine(
                    center.x, center.y,
                    endpoint.x, endpoint.y, color);
                viewportPixels.DrawDisc(
                    endpoint.x, endpoint.y, 2, color);
            }
        }
        if selected and scene_light_3d.HasRange(light.Type) {
            var rangePixels = Convert.NumToInt(light.Range * viewScale);
            if rangePixels < 8 { rangePixels = 8; }
            if rangePixels > 90 { rangePixels = 90; }
            viewportPixels.DrawFrame(
                center.x - rangePixels,
                center.y - rangePixels,
                rangePixels * 2 + 1,
                rangePixels * 2 + 1,
                Color.RGB(156, 128, 62));
        }
    }

    /// @brief Draw a camera glyph plus its authored frustum wireframe.
    /// @details Pose comes from the node world transform and projection from
    ///          the authored fields, both projected through the shared
    ///          viewport camera (ADR 0184). Behind-eye segments are skipped.
    hide func DrawCameraOverlay(node: SceneNode,
                                selected: Boolean) {
        var camera = node.Camera;
        if camera == null or viewportPixels == null { return; }
        var center = Project(
            node.WorldPosition.X,
            node.WorldPosition.Y,
            node.WorldPosition.Z);
        var color = Color.RGB(126, 214, 204);
        if selected { color = Color.RGB(168, 255, 240); }
        if center.visible {
            viewportPixels.DrawFrame(
                center.x - 5, center.y - 4, 11, 9, color);
            viewportPixels.DrawDisc(center.x + 7, center.y, 2, color);
        }

        var state = scene_camera_3d.FromCamera(camera);
        var world = node.WorldMatrix;
        var eye = node.WorldPosition;
        var forward = NormalizedVectorOr(
            Mat4.TransformVector(
                world, Vec3.New(0.0, 0.0, -1.0)) as Vec3,
            0.0, 0.0, -1.0);
        var up = NormalizedVectorOr(
            Mat4.TransformVector(
                world, Vec3.New(0.0, 1.0, 0.0)) as Vec3,
            0.0, 1.0, 0.0);
        var right = NormalizedVectorOr(
            Vec3.Cross(forward, up) as Vec3, 1.0, 0.0, 0.0);
        up = NormalizedVectorOr(
            Vec3.Cross(right, forward) as Vec3, 0.0, 1.0, 0.0);

        var nearHalfHeight = state.orthoSize;
        var farHalfHeight = state.orthoSize;
        if state.isOrtho == false {
            var halfTangent = Math.Tan(
                state.fovDegrees * 0.5 * DEG_TO_RAD);
            nearHalfHeight = halfTangent * state.nearPlane;
            farHalfHeight = halfTangent * state.farPlane;
        }
        var nearHalfWidth =
            nearHalfHeight * scene_camera_3d.DEFAULT_ASPECT;
        var farHalfWidth =
            farHalfHeight * scene_camera_3d.DEFAULT_ASPECT;
        DrawFrustumRect(
            eye, forward, right, up,
            state.nearPlane, nearHalfWidth, nearHalfHeight, color);
        DrawFrustumRect(
            eye, forward, right, up,
            state.farPlane, farHalfWidth, farHalfHeight, color);
        var corner = 0;
        while corner < 4 {
            var signRight = 1.0;
            if corner == 1 or corner == 2 { signRight = -1.0; }
            var signUp = 1.0;
            if corner >= 2 { signUp = -1.0; }
            var nearPoint = FrustumCorner(
                eye, forward, right, up,
                state.nearPlane,
                nearHalfWidth * signRight,
                nearHalfHeight * signUp);
            var farPoint = FrustumCorner(
                eye, forward, right, up,
                state.farPlane,
                farHalfWidth * signRight,
                farHalfHeight * signUp);
            if nearPoint.visible and farPoint.visible {
                viewportPixels.DrawLine(
                    nearPoint.x, nearPoint.y,
                    farPoint.x, farPoint.y, color);
            }
            corner = corner + 1;
        }
    }

    /// @brief Project one frustum-plane corner through the shared camera.
    hide func FrustumCorner(eye: Vec3,
                            forward: Vec3,
                            right: Vec3,
                            up: Vec3,
                            distance: Number,
                            offsetRight: Number,
                            offsetUp: Number) -> ProjectedPoint {
        return Project(
            eye.X + forward.X * distance
                + right.X * offsetRight + up.X * offsetUp,
            eye.Y + forward.Y * distance
                + right.Y * offsetRight + up.Y * offsetUp,
            eye.Z + forward.Z * distance
                + right.Z * offsetRight + up.Z * offsetUp);
    }

    /// @brief Draw one projected frustum rectangle with visibility guards.
    hide func DrawFrustumRect(eye: Vec3,
                              forward: Vec3,
                              right: Vec3,
                              up: Vec3,
                              distance: Number,
                              halfWidth: Number,
                              halfHeight: Number,
                              color: Integer) {
        var topRight = FrustumCorner(
            eye, forward, right, up, distance, halfWidth, halfHeight);
        var topLeft = FrustumCorner(
            eye, forward, right, up, distance,
            0.0 - halfWidth, halfHeight);
        var bottomLeft = FrustumCorner(
            eye, forward, right, up, distance,
            0.0 - halfWidth, 0.0 - halfHeight);
        var bottomRight = FrustumCorner(
            eye, forward, right, up, distance,
            halfWidth, 0.0 - halfHeight);
        if topRight.visible and topLeft.visible {
            viewportPixels.DrawLine(
                topRight.x, topRight.y, topLeft.x, topLeft.y, color);
        }
        if topLeft.visible and bottomLeft.visible {
            viewportPixels.DrawLine(
                topLeft.x, topLeft.y, bottomLeft.x, bottomLeft.y, color);
        }
        if bottomLeft.visible and bottomRight.visible {
            viewportPixels.DrawLine(
                bottomLeft.x, bottomLeft.y,
                bottomRight.x, bottomRight.y, color);
        }
        if bottomRight.visible and topRight.visible {
            viewportPixels.DrawLine(
                bottomRight.x, bottomRight.y,
                topRight.x, topRight.y, color);
        }
    }

    /// @brief Retain the bounded picture-in-picture renderer lazily.
    hide func EnsureInsetRenderer() -> Boolean {
        if insetRenderTarget != null
           and insetRenderCanvas != null
           and insetRenderCamera != null {
            return true;
        }
        var target = RenderTarget3D.New(INSET_WIDTH, INSET_HEIGHT);
        if target == null { return false; }
        var canvas = Canvas3D.NewOffscreen(target);
        if canvas == null { return false; }
        canvas.SetDefaultLighting();
        var camera = Camera3D.New(
            scene_camera_3d.DEFAULT_FOV_DEGREES,
            INSET_WIDTH / (INSET_HEIGHT / 1.0),
            scene_camera_3d.DEFAULT_NEAR_PLANE,
            scene_camera_3d.DEFAULT_FAR_PLANE);
        if camera == null { return false; }
        insetRenderTarget = target;
        insetRenderCanvas = canvas;
        insetRenderCamera = camera;
        return true;
    }

    /// @brief Render and composite the selected camera's bounded preview.
    /// @details Presentation only (ADR 0184): the inset re-renders during
    ///          damaged frames when its source changed or the bounded frame
    ///          spacing elapsed, and never touches canonical content.
    hide func DrawCameraPreviewInset() {
        if insetEnabled == false or showCameraOverlays == false {
            return;
        }
        if scene == null or viewportRenderFallback { return; }
        var node = SelectedNode();
        if node == null or node.Camera == null { return; }
        var sourceChanged = insetSourceRevision != revision
            or insetSourceNode != node;
        var spacingElapsed = insetFrameCounter - insetLastRenderFrame
            >= INSET_REFRESH_FRAMES;
        if (sourceChanged or spacingElapsed or insetPixels == null)
           and EnsureInsetRenderer() {
            ApplyAuthoredCameraPose(insetRenderCamera, node);
            insetRenderCanvas.Wireframe = false;
            var insetAuthoredSky =
                ApplyEnvironmentToCanvas(insetRenderCanvas);
            ApplyProjectPreviewEnvironment(
                insetRenderCanvas,
                ProjectPreviewRenderState(),
                insetAuthoredSky,
                false);
            scene.Draw(insetRenderCanvas, insetRenderCamera);
            var rendered = insetRenderTarget.AsPixels();
            if rendered != null {
                insetPixels = rendered;
                insetLastRenderFrame = insetFrameCounter;
                insetSourceRevision = revision;
                insetSourceNode = node;
            }
        }
        if insetPixels == null { return; }
        var margin = 8;
        var x = renderedViewportWidth - INSET_WIDTH - margin;
        var y = renderedViewportHeight - INSET_HEIGHT - margin;
        if x < 8 or y < 8 { return; }
        viewportPixels.Copy(
            x, y, insetPixels, 0, 0, INSET_WIDTH, INSET_HEIGHT);
        viewportPixels.DrawFrame(
            x - 1, y - 1, INSET_WIDTH + 2, INSET_HEIGHT + 2,
            Color.RGB(126, 214, 204));
    }

    /// @brief Project one node-local point through the world transform.
    hide func ProjectLocalPoint(world: Mat4,
                                localX: Number,
                                localY: Number,
                                localZ: Number) -> ProjectedPoint {
        var transformed = Mat4.TransformPoint(
            world, Vec3.New(localX, localY, localZ)) as Vec3;
        if transformed == null { return new ProjectedPoint(); }
        return Project(transformed.X, transformed.Y, transformed.Z);
    }

    /// @brief Draw one overlay segment, dashed for trigger colliders.
    /// @details Dashing interpolates the projected endpoints, drawing the
    ///          outer 40% spans; both endpoints must be in front of the eye.
    hide func DrawColliderSegment(from: ProjectedPoint,
                                  to: ProjectedPoint,
                                  color: Integer,
                                  dashed: Boolean) {
        if from.visible == false or to.visible == false { return; }
        if dashed == false {
            viewportPixels.DrawLine(from.x, from.y, to.x, to.y, color);
            return;
        }
        var firstX = from.x + Convert.NumToInt((to.x - from.x) * 0.4);
        var firstY = from.y + Convert.NumToInt((to.y - from.y) * 0.4);
        var secondX = from.x + Convert.NumToInt((to.x - from.x) * 0.6);
        var secondY = from.y + Convert.NumToInt((to.y - from.y) * 0.6);
        viewportPixels.DrawLine(from.x, from.y, firstX, firstY, color);
        viewportPixels.DrawLine(secondX, secondY, to.x, to.y, color);
    }

    /// @brief Draw one transformed local-space wire box.
    hide func DrawColliderBox(world: Mat4,
                              minX: Number,
                              minY: Number,
                              minZ: Number,
                              maxX: Number,
                              maxY: Number,
                              maxZ: Number,
                              color: Integer,
                              dashed: Boolean) {
        var c000 = ProjectLocalPoint(world, minX, minY, minZ);
        var c100 = ProjectLocalPoint(world, maxX, minY, minZ);
        var c010 = ProjectLocalPoint(world, minX, maxY, minZ);
        var c110 = ProjectLocalPoint(world, maxX, maxY, minZ);
        var c001 = ProjectLocalPoint(world, minX, minY, maxZ);
        var c101 = ProjectLocalPoint(world, maxX, minY, maxZ);
        var c011 = ProjectLocalPoint(world, minX, maxY, maxZ);
        var c111 = ProjectLocalPoint(world, maxX, maxY, maxZ);
        DrawColliderSegment(c000, c100, color, dashed);
        DrawColliderSegment(c010, c110, color, dashed);
        DrawColliderSegment(c001, c101, color, dashed);
        DrawColliderSegment(c011, c111, color, dashed);
        DrawColliderSegment(c000, c010, color, dashed);
        DrawColliderSegment(c100, c110, color, dashed);
        DrawColliderSegment(c001, c011, color, dashed);
        DrawColliderSegment(c101, c111, color, dashed);
        DrawColliderSegment(c000, c001, color, dashed);
        DrawColliderSegment(c100, c101, color, dashed);
        DrawColliderSegment(c010, c011, color, dashed);
        DrawColliderSegment(c110, c111, color, dashed);
    }

    /// @brief Draw one transformed local-plane wire circle.
    /// @param plane 0 = XY, 1 = XZ, 2 = YZ.
    hide func DrawColliderCircle(world: Mat4,
                                 centerY: Number,
                                 radius: Number,
                                 plane: Integer,
                                 color: Integer,
                                 dashed: Boolean) {
        var segments = 16;
        var previous = new ProjectedPoint();
        var segment = 0;
        while segment <= segments {
            var angle = segment * 2.0 * 3.141592653589793 / segments;
            var alongA = Math.Cos(angle) * radius;
            var alongB = Math.Sin(angle) * radius;
            var localX = alongA;
            var localY = centerY + alongB;
            var localZ = 0.0;
            if plane == 1 {
                localY = centerY;
                localZ = alongB;
            } else if plane == 2 {
                localX = 0.0;
                localY = centerY + alongA;
                localZ = alongB;
            }
            var point = ProjectLocalPoint(
                world, localX, localY, localZ);
            if segment > 0
               and (dashed == false or segment - (segment / 2) * 2 == 1) {
                DrawColliderSegment(previous, point, color, false);
            }
            previous = point;
            segment = segment + 1;
        }
    }

    /// @brief Draw the authored collider convention wireframe (ADR 0185).
    hide func DrawColliderOverlay(node: SceneNode,
                                  selected: Boolean) {
        var state = scene_collider_3d.FromNode(node);
        if state.kind == scene_collider_3d.COLLIDER_NONE { return; }
        var world = node.WorldMatrix;
        if world == null { return; }
        var color = Color.RGB(140, 210, 120);
        if selected { color = Color.RGB(190, 255, 160); }
        var dashed = state.trigger;
        if state.kind == scene_collider_3d.COLLIDER_BOX {
            DrawColliderBox(
                world,
                0.0 - state.halfX, 0.0 - state.halfY, 0.0 - state.halfZ,
                state.halfX, state.halfY, state.halfZ,
                color, dashed);
        } else if state.kind == scene_collider_3d.COLLIDER_SPHERE {
            DrawColliderCircle(world, 0.0, state.radius, 0, color, dashed);
            DrawColliderCircle(world, 0.0, state.radius, 1, color, dashed);
            DrawColliderCircle(world, 0.0, state.radius, 2, color, dashed);
        } else if state.kind == scene_collider_3d.COLLIDER_CAPSULE {
            var halfHeight = state.height * 0.5;
            DrawColliderCircle(
                world, halfHeight, state.radius, 1, color, dashed);
            DrawColliderCircle(
                world, 0.0 - halfHeight, state.radius, 1, color, dashed);
            DrawColliderSegment(
                ProjectLocalPoint(
                    world, state.radius, 0.0 - halfHeight, 0.0),
                ProjectLocalPoint(world, state.radius, halfHeight, 0.0),
                color, dashed);
            DrawColliderSegment(
                ProjectLocalPoint(
                    world, 0.0 - state.radius, 0.0 - halfHeight, 0.0),
                ProjectLocalPoint(
                    world, 0.0 - state.radius, halfHeight, 0.0),
                color, dashed);
            DrawColliderSegment(
                ProjectLocalPoint(
                    world, 0.0, 0.0 - halfHeight, state.radius),
                ProjectLocalPoint(world, 0.0, halfHeight, state.radius),
                color, dashed);
            DrawColliderSegment(
                ProjectLocalPoint(
                    world, 0.0, 0.0 - halfHeight, 0.0 - state.radius),
                ProjectLocalPoint(
                    world, 0.0, halfHeight, 0.0 - state.radius),
                color, dashed);
        } else {
            var boundsMin = node.BoundsMin;
            var boundsMax = node.BoundsMax;
            if boundsMin == null or boundsMax == null { return; }
            DrawColliderBox(
                world,
                boundsMin.X, boundsMin.Y, boundsMin.Z,
                boundsMax.X, boundsMax.Y, boundsMax.Z,
                color, dashed);
        }
    }

    /// @brief Draw ordered route polylines through direct children.
    /// @details A route is a node carrying the project `route` component
    ///          (ADR 0185 lifting the 2D convention of ADR 0179). At most
    ///          256 waypoints per route are drawn; the hierarchy stays the
    ///          editable source of truth.
    hide func DrawRouteOverlays() {
        if showRouteOverlays == false { return; }
        var routeComponent = RouteComponentDefinition();
        if routeComponent == null { return; }
        var index = 0;
        while index < flatNodes.count() {
            var node = flatNodes.get(index);
            if NodeCarriesComponent(node, routeComponent) {
                var highlighted =
                    scene_selection.Contains(selectedIndices, index);
                var child = 0;
                while child < node.ChildCount
                      and highlighted == false {
                    var childIndex =
                        FindFlatIndex(node.GetChild(child));
                    if childIndex >= 0
                       and scene_selection.Contains(
                              selectedIndices, childIndex) {
                        highlighted = true;
                    }
                    child = child + 1;
                }
                var color = Color.RGB(196, 150, 255);
                if highlighted { color = Color.RGB(230, 196, 255); }
                var previousPoint = Project(
                    node.WorldPosition.X,
                    node.WorldPosition.Y,
                    node.WorldPosition.Z);
                var waypoint = 0;
                while waypoint < node.ChildCount and waypoint < 256 {
                    var waypointNode = node.GetChild(waypoint);
                    if waypointNode != null {
                        var world = waypointNode.WorldPosition;
                        var point = Project(world.X, world.Y, world.Z);
                        DrawColliderSegment(
                            previousPoint, point, color, false);
                        previousPoint = point;
                    }
                    waypoint = waypoint + 1;
                }
            }
            index = index + 1;
        }
    }

    /// @brief Return the project route component for 3D nodes, or null.
    hide func RouteComponentDefinition()
        -> scene_component_schema.SceneComponentDefinition {
        if componentSchema == null or componentSchema.valid == false {
            return null;
        }
        return componentSchema.Find(
            "route", scene_component_schema.TARGET_3D_NODE);
    }

    /// @brief Return whether one node has every field of one component.
    hide func NodeCarriesComponent(
        node: SceneNode,
        component: scene_component_schema.SceneComponentDefinition)
        -> Boolean {
        if node == null or component == null
           or component.fields.count() == 0 {
            return false;
        }
        var fieldIndex = 0;
        while fieldIndex < component.fields.count() {
            if node.MetadataHas(
                   component.fields.get(fieldIndex).key) == false {
                return false;
            }
            fieldIndex = fieldIndex + 1;
        }
        return true;
    }

    /// @brief Deterministic viewport tint for recognized gameplay markers.
    /// @return Packed color, or zero when no 3D component matches.
    hide func NodeComponentTint(node: SceneNode) -> Integer {
        if componentSchema == null or componentSchema.valid == false
           or node == null {
            return 0;
        }
        var seen = 0;
        var index = 0;
        while index < componentSchema.components.count() {
            var component = componentSchema.components.get(index);
            if component != null
               and component.SupportsTarget(
                   scene_component_schema.TARGET_3D_NODE) {
                if NodeCarriesComponent(node, component) {
                    return ComponentTintColor(seen);
                }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return 0;
    }

    /// @brief First recognized gameplay component name for one node.
    hide func NodeComponentBadge(node: SceneNode) -> String {
        if componentSchema == null or componentSchema.valid == false
           or node == null {
            return "";
        }
        var index = 0;
        while index < componentSchema.components.count() {
            var component = componentSchema.components.get(index);
            if component != null
               and component.SupportsTarget(
                   scene_component_schema.TARGET_3D_NODE)
               and NodeCarriesComponent(node, component) {
                return component.name;
            }
            index = index + 1;
        }
        return "";
    }

    /// @brief Fixed six-color palette keyed by schema component order.
    hide func ComponentTintColor(position: Integer) -> Integer {
        var slot = position - (position / 6) * 6;
        if slot == 0 { return Color.RGB(255, 138, 128); }
        if slot == 1 { return Color.RGB(255, 213, 128); }
        if slot == 2 { return Color.RGB(174, 255, 128); }
        if slot == 3 { return Color.RGB(128, 222, 255); }
        if slot == 4 { return Color.RGB(196, 150, 255); }
        return Color.RGB(255, 158, 222);
    }

    /// @brief Interpolate one corner of a projected plane handle.
    hide func GizmoPlanePoint(origin: ProjectedPoint,
                              axisA: ProjectedPoint,
                              axisB: ProjectedPoint,
                              fractionA: Number,
                              fractionB: Number) -> ProjectedPoint {
        var point = new ProjectedPoint();
        point.x = origin.x + Convert.NumToInt(
            (axisA.x - origin.x) * fractionA
            + (axisB.x - origin.x) * fractionB);
        point.y = origin.y + Convert.NumToInt(
            (axisA.y - origin.y) * fractionA
            + (axisB.y - origin.y) * fractionB);
        return point;
    }

    /// @brief Draw the same conditioned 32-segment ellipse used for picking.
    hide func DrawGizmoRotationRing(origin: ProjectedPoint,
                                    axisA: ProjectedPoint,
                                    axisB: ProjectedPoint,
                                    color: Integer) {
        var vectorAX = axisA.x - origin.x;
        var vectorAY = axisA.y - origin.y;
        var vectorBX = axisB.x - origin.x;
        var vectorBY = axisB.y - origin.y;
        if scene_transform_3d.PlaneProjectionIsUsable(
               vectorAX, vectorAY, vectorBX, vectorBY) == false {
            return;
        }
        var previous = GizmoPlanePoint(
            origin, axisA, axisB, 1.0, 0.0);
        var segment = 1;
        while segment <= GIZMO_RING_SEGMENTS {
            var angle = segment * GIZMO_RING_STEP_RADIANS;
            var current = GizmoPlanePoint(
                origin, axisA, axisB,
                Math.Cos(angle), Math.Sin(angle));
            viewportPixels.DrawLine(
                previous.x, previous.y,
                current.x, current.y, color);
            previous = current;
            segment = segment + 1;
        }
    }

    /// @brief Draw one filled, outlined plane only when projection is stable.
    hide func DrawGizmoPlane(origin: ProjectedPoint,
                             axisA: ProjectedPoint,
                             axisB: ProjectedPoint,
                             fillColor: Integer,
                             outlineColor: Integer,
                             crossed: Boolean) {
        var vectorAX = axisA.x - origin.x;
        var vectorAY = axisA.y - origin.y;
        var vectorBX = axisB.x - origin.x;
        var vectorBY = axisB.y - origin.y;
        if scene_transform_3d.PlaneProjectionIsUsable(
               vectorAX, vectorAY, vectorBX, vectorBY) == false {
            return;
        }
        var cornerAA = GizmoPlanePoint(
            origin, axisA, axisB,
            GIZMO_PLANE_INNER_FRACTION,
            GIZMO_PLANE_INNER_FRACTION);
        var cornerBA = GizmoPlanePoint(
            origin, axisA, axisB,
            GIZMO_PLANE_OUTER_FRACTION,
            GIZMO_PLANE_INNER_FRACTION);
        var cornerBB = GizmoPlanePoint(
            origin, axisA, axisB,
            GIZMO_PLANE_OUTER_FRACTION,
            GIZMO_PLANE_OUTER_FRACTION);
        var cornerAB = GizmoPlanePoint(
            origin, axisA, axisB,
            GIZMO_PLANE_INNER_FRACTION,
            GIZMO_PLANE_OUTER_FRACTION);
        viewportPixels.DrawTriangle(
            cornerAA.x, cornerAA.y,
            cornerBA.x, cornerBA.y,
            cornerBB.x, cornerBB.y,
            fillColor);
        viewportPixels.DrawTriangle(
            cornerAA.x, cornerAA.y,
            cornerBB.x, cornerBB.y,
            cornerAB.x, cornerAB.y,
            fillColor);
        viewportPixels.DrawLine(
            cornerAA.x, cornerAA.y, cornerBA.x, cornerBA.y,
            outlineColor);
        viewportPixels.DrawLine(
            cornerBA.x, cornerBA.y, cornerBB.x, cornerBB.y,
            outlineColor);
        viewportPixels.DrawLine(
            cornerBB.x, cornerBB.y, cornerAB.x, cornerAB.y,
            outlineColor);
        viewportPixels.DrawLine(
            cornerAB.x, cornerAB.y, cornerAA.x, cornerAA.y,
            outlineColor);
        if crossed {
            viewportPixels.DrawLine(
                cornerAA.x, cornerAA.y, cornerBB.x, cornerBB.y,
                outlineColor);
            viewportPixels.DrawLine(
                cornerBA.x, cornerBA.y, cornerAB.x, cornerAB.y,
                outlineColor);
        }
    }

    hide func FindFlatIndex(node: SceneNode) -> Integer {
        if node == null { return -1; }
        var i = 0;
        while i < flatNodes.count() {
            if flatNodes.get(i) == node { return i; }
            i = i + 1;
        }
        return -1;
    }
}

/// @brief Clamp one integer without platform-specific math helpers.
func ClampInt3D(value: Integer,
                minimum: Integer,
                maximum: Integer) -> Integer {
    if value < minimum { return minimum; }
    if value > maximum { return maximum; }
    return value;
}
