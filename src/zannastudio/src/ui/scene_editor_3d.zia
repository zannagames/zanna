// Stable pure-function surface retained at the historical module boundary.
/// @brief Forward IsGizmoAxis to the focused 3D editor model.
func IsGizmoAxis(handle: Integer) -> Boolean {
    return SceneEditor3DModel.IsGizmoAxis(handle);
}

/// @brief Forward IsGizmoPlane to the focused 3D editor model.
