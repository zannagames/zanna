    expose Boolean heightFogEnabled;
    expose Number heightFogBase;
    expose Number heightFogFalloff;
    expose Number heightFogDensity;
    expose Number heightFogOpacity;

    expose func init() {
        hasCameraFov = false;
        cameraFov = VIEWPORT_FOV_DEGREES;
        hasIblIntensity = false;
        iblIntensity = 0.0;
        hasAmbient = false;
        ambientR = 0.0;
        ambientG = 0.0;
        ambientB = 0.0;
        hasClear = false;
        clearR = 0.0;
        clearG = 0.0;
        clearB = 0.0;
        hasFog = false;
        fogR = 0.0;
        fogG = 0.0;
        fogB = 0.0;
        fogNear = 0.0;
        fogFar = 1.0;
        hasSky = false;
        zenithR = 0.0;
        zenithG = 0.0;
        zenithB = 0.0;
        groundR = 0.0;
        groundG = 0.0;
        groundB = 0.0;
        cloudDensity = 0.0;
        stars = false;
        hasSun = false;
        sunX = 0.0;
        sunY = -1.0;
        sunZ = 0.0;
        sunR = 1.0;
        sunG = 1.0;
        sunB = 1.0;
        sunIntensity = 0.0;
        hasFill = false;
        fillX = 0.0;
        fillY = -1.0;
        fillZ = 0.0;
        fillR = 1.0;
        fillG = 1.0;
        fillB = 1.0;
        fillIntensity = 0.0;
        hasHeightFog = false;
        heightFogEnabled = false;
        heightFogBase = 0.0;
        heightFogFalloff = 0.0;
        heightFogDensity = 0.0;
        heightFogOpacity = 0.0;
    }
}

