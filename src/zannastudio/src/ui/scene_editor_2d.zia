    /// @brief Build the visual editor into WorkbenchShell.scene2DHost.

    /// @brief Borrow Studio's multi-root project index for non-modal assets.
    expose func SetWorkspaceContext(
        nextProjectManager: project_manager.ProjectManager) {
        projectManager = nextProjectManager;
        ReloadComponentSchema();
    }

    /// @brief Reload project component templates for the active document root.
    expose func ReloadComponentSchema() {
        var rootPath = ComponentSchemaRoot();
        componentSchemaPath =
            scene_component_schema.PathForRoot(rootPath);
        if componentPalette != null and componentPalette.group != null
           and componentAuthoring != null {
            componentAuthoring.Load(
                componentSchemaPath,
                scene_component_schema.TARGET_2D_OBJECT,
                componentPalette);
            componentSchema = componentAuthoring.schema;
            RefreshComponentPalette();
        } else {
            componentSchema =
                scene_component_schema.LoadPath(componentSchemaPath);
        }
        if tilesets != null { tilesets.ClearSceneBackground(); }
        renderDirty = true;
    }

    /// @brief Keep multi-root schema ownership aligned with document ownership.
    hide func EnsureComponentSchema(force: Boolean) {
        var nextPath = scene_component_schema.PathForRoot(
            ComponentSchemaRoot());
        if force or nextPath != componentSchemaPath {
            ReloadComponentSchema();
        }
    }

    /// @brief Resolve the unambiguous workspace root for the current scene.
    hide func ComponentSchemaRoot() -> String {
        if projectManager == null { return ""; }
        if currentDoc != null and currentDoc.filePath != "" {
            var owner =
                projectManager.WorkspaceRootPathForPath(currentDoc.filePath);
            if owner != "" { return owner; }
            // An explicitly opened external scene keeps its own project
            // authoring conventions; never borrow an unrelated sole workspace.
            return project_locator.NearestManifestRoot(
                currentDoc.filePath);
        }
        if projectManager.RootCount() == 1 {
            return projectManager.RootPathAt(0);
        }
        return "";
    }

    /// @brief Pump one active document and return true when scene JSON changed.
    expose func Pump(activeDoc: document.Document) -> Boolean {
        if activeDoc == null or activeDoc.kind != file_utils.DOC_KIND_SCENE_2D {
            return false;
        }
        if activeDoc != currentDoc or activeDoc.content != currentSerialized {
            Activate(activeDoc);
        }
        EnsureComponentSchema(false);
        if activeDoc == currentDoc and activeDoc.isModified == false
           and activeDoc.content == currentSerialized {
            cleanSerialized = currentSerialized;
        }

        RefreshResponsiveLayout();
        PumpCommandMenuButtons();
        if hierarchyButton.WasClicked()
           or viewHierarchyItem.WasClicked() {
            ToggleHierarchyPane();
        }
        if inspectorButton.WasClicked()
           or viewInspectorItem.WasClicked() {
            ToggleInspectorPane();
        }
        if paletteButton.WasClicked()
           or viewPaletteItem.WasClicked() {
            TogglePalettePane();
        }
        if workspaceButton.WasClicked()
           or viewWorkspaceItem.WasClicked() {
            RequestWorkspaceModeToggle();
        }
        if focusButton.WasClicked()
           or viewFocusItem.WasClicked() {
            RequestFocusModeToggle();
        }
        if objectTabButton.WasClicked() { SetInspectorSceneTab(false); }
        if sceneTabButton.WasClicked() { SetInspectorSceneTab(true); }

        var changed = false;
        gestureEscapeConsumed = false;
        // Commit or cancel a pending live position edit before selection and
        // document handlers can observe uncommitted document state.
        changed = PumpObjectTransformDraft() or changed;
        changed = PumpObjectFlipControls() or changed;
        changed = PumpObjectTintInput() or changed;
        if hierarchyDock.Pump() {
            ApplyInspectorLayout();
            renderDirty = true;
        }
        if inspectorDock.Pump() {
            ApplyInspectorLayout();
            renderDirty = true;
        }
        if paletteDock.Pump() {
            ApplyPaletteLayout();
            renderDirty = true;
        }
        if newSceneButton.WasClicked() {
            changed = ReplaceScene(
                Convert.NumToInt(sceneWidthSpinner.Value),
                Convert.NumToInt(sceneHeightSpinner.Value),
                Convert.NumToInt(sceneTileSizeSpinner.Value));
        }
        if importButton.WasClicked() {
            changed = ImportTiled() or changed;
        }
        tiledAssetBrowser.SetLibraryRoot(ComponentSchemaRoot());
        tilesetInspector.assetBrowser.SetLibraryRoot(ComponentSchemaRoot());
        componentAssetBrowser.SetLibraryRoot(ComponentSchemaRoot());
        var componentAssetPath = componentAssetBrowser.Pump(
            projectManager,
            scene != null and SelectedAssetComponentField() != null);
        if componentAssetPath != "" {
            ApplyComponentAssetPath(componentAssetPath);
        }
        var projectImportPath = tiledAssetBrowser.Pump(
            projectManager, currentDoc != null);
        if projectImportPath != "" {
            changed = ImportTiledPath(projectImportPath) or changed;
        }
        var canChooseLayerAsset = scene != null
            and activeLayer >= 0 and activeLayer < scene.LayerCount();
        var projectLayerAssetPath = tilesetInspector.assetBrowser.Pump(
            projectManager, canChooseLayerAsset);
        if projectLayerAssetPath != "" {
            var libraryEntry = tilesetInspector.assetBrowser
                .LibraryEntryForAbsolutePath(projectLayerAssetPath);
            if libraryEntry != null and scene != null
               and libraryEntry.tileWidth > 0
               and (libraryEntry.tileWidth != scene.TileWidth
                    or libraryEntry.tileHeight != scene.TileHeight) {
                detailLabel.SetText(
                    "Library grid for this asset is "
                    + libraryEntry.tileWidth + "x" + libraryEntry.tileHeight
                    + "; the scene uses " + scene.TileWidth + "x"
                    + scene.TileHeight + ". The scene was not resized.");
            }
            changed = ApplyLayerAssetPath(
                activeLayer,
                PortableLayerAssetPath(projectLayerAssetPath)) or changed;
        }
        if scene == null {
            if renderDirty { RenderScene(); }
            ApplyPendingWorkspaceScroll();
            CaptureWorkspaceState();
            return changed;
        }
        if currentDoc != null
           and currentDoc.filePath != tilesetDocumentPath {
            ReloadTilesets();
            RefreshTilesetPalette();
        }
        PollTilesetExternalChanges(250);

        UpdateCanvasViewportSize();
        if selectButton.WasClicked()
           or toolSelectItem.WasClicked() {
            SetMode(MODE_SELECT);
        }
        if paintButton.WasClicked()
           or toolPaintItem.WasClicked() {
            SetMode(MODE_PAINT);
        }
        if eraseButton.WasClicked()
           or toolEraseItem.WasClicked() {
            SetMode(MODE_ERASE);
        }
        if rectangleButton.WasClicked()
           or toolRectangleItem.WasClicked() {
            SetMode(MODE_RECTANGLE);
        }
        if lineButton.WasClicked()
           or toolLineItem.WasClicked() {
            SetMode(MODE_LINE);
        }
        if ellipseButton.WasClicked()
           or toolEllipseItem.WasClicked() {
            SetMode(MODE_ELLIPSE);
        }
        if fillButton.WasClicked()
           or toolFillItem.WasClicked() {
            SetMode(MODE_FILL);
        }
        if pickerButton.WasClicked()
           or toolPickerItem.WasClicked() {
            SetMode(MODE_PICKER);
        }
        if previewButton.WasClicked() {
            SetPreviewActive(previewActive == false);
        }
        if gameViewButton.WasClicked()
           or viewGameItem.WasClicked() {
            SetGameViewActive(gameViewActive == false);
        }
        if gameOutputFramePending and ApplyGameOutputFrame() {
            gameOutputFramePending = false;
        }
        if runSceneButton.WasClicked() { runSceneRequested = true; }
        PumpPreviewClock();
        if objectButton.WasClicked()
           or toolObjectItem.WasClicked() {
            SetMode(MODE_OBJECT);
        }
        if zoomOutButton.WasClicked() { ZoomAtWindowCenter(-1); }
        if zoomInButton.WasClicked() { ZoomAtWindowCenter(1); }
        if actualSizeButton.WasClicked()
           or viewActualSizeItem.WasClicked() {
            ZoomToPercentAtWindowCenter(100);
        }
        if gridButton.WasClicked()
           or viewGridItem.WasClicked() {
            showGrid = showGrid == false;
            RefreshGridButton();
            renderDirty = true;
        }
        if rulersButton.WasClicked()
           or viewRulersItem.WasClicked() {
            showRulers = showRulers == false;
            RefreshRulerPresentation();
            renderDirty = true;
        }
        if fitButton.WasClicked()
           or viewFitItem.WasClicked() {
            initialFramePending = false;
            fitPending = false;
            if FitScene() { renderDirty = true; }
        }
        if initialFramePending and FrameInitialScene() {
            initialFramePending = false;
            restoreScrollPending = false;
            renderDirty = true;
        }
        if fitPending and FitScene() {
            fitPending = false;
            renderDirty = true;
        }
        if tileSpinner.WasChanged() {
            RefreshTilesetPalette();
            renderDirty = true;
        }

        changed = PumpHistoryPanel() or changed;
        changed = PumpScenePropertyControls() or changed;
        changed = PumpLayerControls() or changed;
        changed = PumpObjectControls() or changed;
        changed = PumpComponentControls() or changed;
        changed = PumpTileBehaviorControls() or changed;
        changed = PumpCameraLightingControls() or changed;
        PumpTilesetPalette();
        PumpCanvasRulers();
        changed = PumpCanvas() or changed;
        changed = PumpCanvasKeyboard() or changed;

        if changed { RefreshHistoryPanel(); }
        if renderDirty { RenderScene(); }
        ApplyPendingWorkspaceScroll();
        // User input only arrives between frames, so any object-spinner
        // change edges still set here came from this pump's programmatic
        // refreshes; drain them so the live-edit path never mistakes them
        // for user edits.
        DrainObjectSpinnerEdges();
        CaptureWorkspaceState();
        return changed;
    }

    /// @brief Parse and display one document without mutating invalid input.
    expose func Activate(doc: document.Document) {
        LoadDocumentModel(doc, false);
    }

    /// @brief Return whether a visual scene edit can be undone.
    expose func CanUndo() -> Boolean {
        return undoStack.count() > 0;
    }

    /// @brief Return whether an undone visual scene edit can be redone.
    expose func CanRedo() -> Boolean {
        return redoStack.count() > 0;
    }

    /// @brief Restore the preceding canonical scene snapshot.
    expose func Undo() -> Boolean {
        if currentDoc == null or undoStack.count() == 0 { return false; }
        SyncHistoryLabels();
        var index = undoStack.count() - 1;
        var target = undoStack.get(index);
        undoStack.removeAt(index);
        var label = "Edit";
        if undoLabels.count() > 0 {
            label = undoLabels.get(undoLabels.count() - 1);
            undoLabels.removeAt(undoLabels.count() - 1);
        }
        PushHistory(redoStack, currentSerialized);
        redoLabels.add(label);
        SyncHistoryLabels();
        currentDoc.content = target;
        currentDoc.isModified = target != cleanSerialized;
        revision = revision + 1;
        LoadDocumentModel(currentDoc, true);
        toolbarStatus.SetText("Undid 2D scene edit");
        return true;
    }

    /// @brief Reapply the next canonical scene snapshot.
    expose func Redo() -> Boolean {
        if currentDoc == null or redoStack.count() == 0 { return false; }
        SyncHistoryLabels();
        var index = redoStack.count() - 1;
        var target = redoStack.get(index);
        redoStack.removeAt(index);
        var label = "Edit";
        if redoLabels.count() > 0 {
            label = redoLabels.get(redoLabels.count() - 1);
            redoLabels.removeAt(redoLabels.count() - 1);
        }
        PushHistory(undoStack, currentSerialized);
        undoLabels.add(label);
        SyncHistoryLabels();
        currentDoc.content = target;
        currentDoc.isModified = target != cleanSerialized;
        revision = revision + 1;
        LoadDocumentModel(currentDoc, true);
        toolbarStatus.SetText("Redid 2D scene edit");
        return true;
    }

    /// @brief Parse and display one document with optional history retention.
    hide func LoadDocumentModel(doc: document.Document,
                                preserveHistory: Boolean) {
        if paintStrokeActive { CancelPaintStroke(); }
        if tileRectangleActive { CancelTileRectangle(); }
        if canvasMarqueeActive { CancelCanvasMarquee(); }
        if canvasGuideDragActive { ResetCanvasGuideDrag(true); }
        var switchingDocument = currentDoc != doc;
        var reloadingDocument = currentDoc == doc;
        if currentDoc != null { CaptureWorkspaceState(); }
        if preserveHistory == false {
            var savedState = doc.scene2DWorkspace;
            var canRestoreHistory = switchingDocument
                and savedState != null
                and savedState.historyContent == doc.content;
            if canRestoreHistory {
                undoStack = savedState.undoStack;
                redoStack = savedState.redoStack;
                undoLabels = savedState.undoLabels;
                redoLabels = savedState.redoLabels;
                cleanSerialized = savedState.cleanSerialized;
            } else {
                undoStack = [];
                redoStack = [];
                undoLabels = [];
                redoLabels = [];
                if doc.isModified == false { cleanSerialized = doc.content; }
                else { cleanSerialized = ""; }
            }
        }
        currentDoc = doc;
        currentSerialized = doc.content;
        EnsureComponentSchema(false);
        loadError = "";
        RestoreWorkspaceState(doc);
        if reloadingDocument {
            // A canonical reload creates new layer identities. Clearing is
            // safer than applying an old numeric index to a different layer;
            // ordinary live add/remove/reorder operations remap exactly.
            lockedLayers = [];
            soloLayer = -1;
            if doc.scene2DWorkspace != null {
                doc.scene2DWorkspace.lockedLayers = [];
                doc.scene2DWorkspace.soloLayer = -1;
            }
        }
        // Restoring divider positions intentionally clears SplitPane collapse
        // state. Reconcile the current responsive presentation once here:
        // the host dimensions may be unchanged, so the idle resize cache will
        // correctly have no reason to reapply it on the next Pump.
        ApplyInspectorLayout();
        ApplyPaletteLayout();
        ResetCanvasMarquee(true);
        ResetTileRectangle(true);
        lastPaintX = -1;
        lastPaintY = -1;
        paintStrokeActive = false;
        paintStrokeChanged = false;
        paintStrokeSnapshot = "";
        objectDragActive = false;
        objectDragChanged = false;
        objectDragSnapshot = "";
        objectDragIndex = -1;

        var parsed = SceneDocument.LoadJsonResult(doc.content);
        if parsed.IsOk {
            scene = parsed.Unwrap() as SceneDocument;
            SetEditorControlsEnabled(true);
            detailLabel.SetText("");
            toolbarStatus.SetText("2D scene ready");
        } else {
            scene = null;
            loadError = parsed.UnwrapErrStr();
            SetEditorControlsEnabled(false);
            toolbarStatus.SetText("Scene needs repair");
            detailLabel.SetText("Scene could not be parsed. The original JSON "
                                + "is preserved.\n\n" + loadError);
        }
        RefreshAutotilePreviewRules();
        ReloadTilesets();
        RefreshInspector();
        RefreshSceneSetupFields();
        RefreshTilesetPalette();
        RefreshHistoryPanel();
        renderDirty = true;
    }

    /// @brief Snapshot live canvas, inspector, and process-local history state.
    hide func CaptureWorkspaceState() {
        if currentDoc == null or currentDoc.scene2DWorkspace == null { return; }
        var state = currentDoc.scene2DWorkspace;
        state.initialized = true;
        state.mode = ClampInt(mode, MODE_SELECT, MODE_ELLIPSE);
        if gameViewOutputFramed == false {
            state.zoomPercent = ClampInt(
                zoomPercent, MIN_ZOOM_PERCENT, MAX_ZOOM_PERCENT);
        }
        state.activeLayer = activeLayer;
        state.selectedObject = selectedObject;
        state.selectedObjects = selectedObjects;
        state.selectedObjectProperty = selectedObjectProperty;
        state.selectedSceneProperty = selectedSceneProperty;
        state.selectedCellX = selectedCellX;
        state.selectedCellY = selectedCellY;
        var tileId = 1;
        if tileSpinner != null {
            tileId = ClampInt(
                Convert.NumToInt(tileSpinner.Value), 0, 1000000);
        }
        state.tileId = tileId;
        if bodySplit != null {
            state.splitPosition = ClampNumber2D(
                bodySplit.GetPosition(), 0.20, 0.85);
        }
        if hierarchySplit != null {
            state.hierarchySplitPosition = ClampNumber2D(
                hierarchySplit.GetPosition(), 0.10, 0.45);
        }
        if canvasSplit != null {
            state.canvasSplitPosition = ClampNumber2D(
                canvasSplit.GetPosition(), 0.40, 0.92);
        }
        if canvasScroll != null and gameViewOutputFramed == false {
            state.canvasScrollX = ClampNumber2D(
                LogicalScrollX(canvasScroll), 0.0, 1000000.0);
            state.canvasScrollY = ClampNumber2D(
                LogicalScrollY(canvasScroll), 0.0, 1000000.0);
        }
        if inspectorScroll != null {
            state.inspectorScrollY = ClampNumber2D(
                LogicalScrollY(inspectorScroll), 0.0, 1000000.0);
        }
        state.inspectorRequestedVisible = inspectorRequestedVisible;
        state.compactInspectorShown = compactInspectorShown;
        state.paletteRequestedVisible = paletteRequestedVisible;
        state.compactPaletteShown = compactPaletteShown;
        state.previewActive = previewActive;
        state.gameViewActive = gameViewActive;
        state.gameViewOutputFramed = gameViewOutputFramed;
        state.autotilePreviewEnabled = autotilePreviewEnabled;
        state.showGrid = showGrid;
        state.showRulers = showRulers;
        state.verticalGuides = verticalGuides;
        state.horizontalGuides = horizontalGuides;
        state.lockedLayers = lockedLayers;
        state.soloLayer = soloLayer;
        state.undoStack = undoStack;
        state.redoStack = redoStack;
        state.undoLabels = undoLabels;
        state.redoLabels = redoLabels;
        state.cleanSerialized = cleanSerialized;
        state.historyContent = currentSerialized;
    }

    /// @brief Restore a document's validated canvas and inspector workspace.
    hide func RestoreWorkspaceState(doc: document.Document) {
        var state = doc.scene2DWorkspace;
        if state == null or state.initialized == false {
            mode = MODE_SELECT;
            zoomPercent = 100;
            activeLayer = 0;
            selectedObject = -1;
            selectedObjects = [];
            selectedObjectProperty = -1;
            selectedSceneProperty = -1;
            selectedCellX = -1;
            selectedCellY = -1;
            if tileSpinner != null { tileSpinner.SetValue(1.0); }
            if bodySplit != null { bodySplit.SetPosition(0.66); }
            if hierarchySplit != null { hierarchySplit.SetPosition(0.20); }
            if canvasSplit != null { canvasSplit.SetPosition(0.72); }
            pendingCanvasScrollX = 0.0;
            pendingCanvasScrollY = 0.0;
            pendingInspectorScrollY = 0.0;
            inspectorRequestedVisible = true;
            compactHierarchyShown = false;
            compactInspectorShown = false;
            paletteRequestedVisible = true;
            compactPaletteShown = false;
            previewActive = false;
            gameViewActive = false;
            gameViewOutputFramed = false;
            gameOutputFramePending = false;
            autotilePreviewEnabled = true;
            showGrid = true;
            showRulers = true;
            verticalGuides = [];
            horizontalGuides = [];
            lockedLayers = [];
            soloLayer = -1;
            if componentSchema != null and componentSchema.valid
               and componentSchema.scenePreview2D != null
               and componentSchema.scenePreview2D.present
               and componentSchema.scenePreview2D.hasShowGrid {
                showGrid = componentSchema.scenePreview2D.showGrid;
            }
            RefreshPreviewButton();
            UpdateGameViewButton();
            RefreshGridButton();
            RefreshRulerPresentation();
            if tileBehavior != null
               and tileBehavior.autotilePreviewCheck != null {
                tileBehavior.SetAutotilePreviewEnabled(
                    autotilePreviewEnabled);
            }
            restoreScrollPending = true;
            fitPending = false;
            initialFramePending = true;
            UpdateModeButtons();
            return;
        }

        mode = ClampInt(state.mode, MODE_SELECT, MODE_ELLIPSE);
        zoomPercent = ClampInt(
            state.zoomPercent, MIN_ZOOM_PERCENT, MAX_ZOOM_PERCENT);
        activeLayer = ClampInt(state.activeLayer, 0, 1023);
        selectedObject = ClampInt(state.selectedObject, -1, 1000000);
        selectedObjects = state.selectedObjects;
        selectedObjectProperty = ClampInt(
            state.selectedObjectProperty, -1, MAX_INSPECTOR_PROPERTIES - 1);
        selectedSceneProperty = ClampInt(
            state.selectedSceneProperty, -1, MAX_INSPECTOR_PROPERTIES - 1);
        selectedCellX = ClampInt(
            state.selectedCellX, -1, MAX_SELECTED_CELL);
        selectedCellY = ClampInt(
            state.selectedCellY, -1, MAX_SELECTED_CELL);
        if tileSpinner != null {
            tileSpinner.SetValue(ClampInt(state.tileId, 0, 1000000));
        }
        if bodySplit != null {
            bodySplit.SetPosition(ClampNumber2D(
                state.splitPosition, 0.20, 0.85));
        }
        if hierarchySplit != null {
            hierarchySplit.SetPosition(ClampNumber2D(
                state.hierarchySplitPosition, 0.10, 0.45));
        }
        if canvasSplit != null {
            canvasSplit.SetPosition(ClampNumber2D(
                state.canvasSplitPosition, 0.40, 0.92));
        }
        pendingCanvasScrollX = ClampNumber2D(
            state.canvasScrollX, 0.0, 1000000.0);
        pendingCanvasScrollY = ClampNumber2D(
            state.canvasScrollY, 0.0, 1000000.0);
        pendingInspectorScrollY = ClampNumber2D(
            state.inspectorScrollY, 0.0, 1000000.0);
        inspectorRequestedVisible = state.inspectorRequestedVisible;
        compactHierarchyShown = false;
        compactInspectorShown = state.compactInspectorShown;
        paletteRequestedVisible = state.paletteRequestedVisible;
        compactPaletteShown = state.compactPaletteShown;
        previewActive = state.previewActive;
        gameViewActive = state.gameViewActive;
        gameViewOutputFramed =
            state.gameViewActive and state.gameViewOutputFramed;
        gameOutputFramePending = gameViewOutputFramed;
        autotilePreviewEnabled = state.autotilePreviewEnabled;
        showGrid = state.showGrid;
        showRulers = state.showRulers;
        verticalGuides = state.verticalGuides;
        horizontalGuides = state.horizontalGuides;
        lockedLayers = state.lockedLayers;
        soloLayer = ClampInt(state.soloLayer, -1, 1023);
        RefreshPreviewButton();
        UpdateGameViewButton();
        RefreshGridButton();
        RefreshRulerPresentation();
        if tileBehavior != null
           and tileBehavior.autotilePreviewCheck != null {
            tileBehavior.SetAutotilePreviewEnabled(
                autotilePreviewEnabled);
        }
        restoreScrollPending = gameViewOutputFramed == false;
        fitPending = false;
        initialFramePending = false;
        UpdateModeButtons();
    }

    /// @brief Toggle the inspector without making either compact pane unusable.
    expose func ToggleInspectorPane() {
        if focusModeActive and inspectorDock.floating == false { return; }
        if compactHierarchyShown {
            compactHierarchyShown = false;
            if compactLayout {
                compactInspectorShown = true;
            } else {
                inspectorRequestedVisible = true;
            }
            ApplyInspectorLayout();
            ApplyPaletteLayout();
            CaptureWorkspaceState();
            return;
        }
        if compactLayout {
            compactInspectorShown = !compactInspectorShown;
        } else {
            inspectorRequestedVisible = !inspectorRequestedVisible;
        }
        ApplyInspectorLayout();
        CaptureWorkspaceState();
    }

    /// @brief Toggle a full-width object hierarchy on viewport-priority hosts.
    expose func ToggleHierarchyPane() {
        if focusModeActive or hierarchyDock.floating
           or UsesDockedHierarchy(lastHostWidth) {
            return;
        }
        compactHierarchyShown = compactHierarchyShown == false;
        if compactHierarchyShown {
            compactInspectorShown = false;
            compactPaletteShown = false;
        }
        ApplyInspectorLayout();
        ApplyPaletteLayout();
        CaptureWorkspaceState();
    }

    /// @brief Toggle the palette without sacrificing canvas usability.
    expose func TogglePalettePane() {
        if paletteDock.floating
           or (focusModeActive and paletteDock.floating == false) {
            return;
        }
        if compactHierarchyShown {
            compactHierarchyShown = false;
            if compactPaletteLayout {
                compactPaletteShown = true;
            } else {
                paletteRequestedVisible = true;
            }
            ApplyInspectorLayout();
            ApplyPaletteLayout();
            CaptureWorkspaceState();
            return;
        }
        if compactPaletteLayout {
            compactPaletteShown = !compactPaletteShown;
        } else {
            paletteRequestedVisible = !paletteRequestedVisible;
        }
        ApplyPaletteLayout();
        CaptureWorkspaceState();
    }

    /// @brief Publish a one-shot request for outer-only scene layout.
    expose func RequestWorkspaceModeToggle() {
        workspaceModeToggleRequested = true;
    }

    /// @brief Consume one outer-only scene-layout toggle request.
    expose func TakeWorkspaceModeToggleRequested() -> Boolean {
        var requested = workspaceModeToggleRequested;
        workspaceModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the shell's outer-only scene layout state.
    expose func SetWorkspaceModeActive(active: Boolean) {
        if workspaceModeActive == active { return; }
        workspaceModeActive = active;
        UpdateWorkspaceButton();
    }

    /// @brief Return whether outer-only Scene Layout is active.
    expose func IsWorkspaceModeActive() -> Boolean {
        return workspaceModeActive;
    }

    /// @brief Publish a one-shot request for the outer shell focus presentation.
    expose func RequestFocusModeToggle() {
        focusModeToggleRequested = true;
    }

    /// @brief Consume one focus-mode toggle request.
    expose func TakeFocusModeToggleRequested() -> Boolean {
        var requested = focusModeToggleRequested;
        focusModeToggleRequested = false;
        return requested;
    }

    /// @brief Synchronize the outer shell's focus-presentation state.
    expose func SetFocusModeActive(active: Boolean) {
        if focusModeActive == active { return; }
        focusModeActive = active;
        ApplyInspectorLayout();
        ApplyPaletteLayout();
        UpdateFocusButton();
    }

    /// @brief Return whether the outer shell is presenting this scene in focus.
    expose func IsFocusModeActive() -> Boolean {
        return focusModeActive;
    }

    /// @brief Open one persistent command menu beneath its owning button.
    hide func ShowCommandMenu(button: GUI.Button,
                              menu: GUI.ContextMenu) {
        if button == null or menu == null { return; }
        menu.Show(
            Convert.NumToInt(button.GetScreenX()),
            Convert.NumToInt(
                button.GetScreenY() + button.GetScreenHeight()));
    }

    /// @brief Return the full user-facing name of one canvas tool.
    hide func ToolModeLabel(value: Integer) -> String {
        if value == MODE_PAINT { return "Paint"; }
        if value == MODE_ERASE { return "Erase"; }
        if value == MODE_RECTANGLE { return "Rectangle"; }
        if value == MODE_LINE { return "Line"; }
        if value == MODE_ELLIPSE { return "Ellipse"; }
        if value == MODE_FILL { return "Flood Fill"; }
        if value == MODE_PICKER { return "Pick Tile"; }
        if value == MODE_OBJECT { return "Object"; }
        return "Select";
    }

    /// @brief Mirror active-mode and edit availability into the Tools menu.
    hide func ConfigureToolMenu() {
        var enabled =
            editorControlsEnabled and gameViewActive == false;
        toolSelectItem.SetEnabled(enabled);
        toolPaintItem.SetEnabled(enabled);
        toolEraseItem.SetEnabled(enabled);
        toolRectangleItem.SetEnabled(enabled);
        toolLineItem.SetEnabled(enabled);
        toolEllipseItem.SetEnabled(enabled);
        toolFillItem.SetEnabled(enabled);
        toolPickerItem.SetEnabled(enabled);
        toolObjectItem.SetEnabled(enabled);
        toolSelectItem.SetChecked(mode == MODE_SELECT);
        toolPaintItem.SetChecked(mode == MODE_PAINT);
        toolEraseItem.SetChecked(mode == MODE_ERASE);
        toolRectangleItem.SetChecked(mode == MODE_RECTANGLE);
        toolLineItem.SetChecked(mode == MODE_LINE);
        toolEllipseItem.SetChecked(mode == MODE_ELLIPSE);
        toolFillItem.SetChecked(mode == MODE_FILL);
        toolPickerItem.SetChecked(mode == MODE_PICKER);
        toolObjectItem.SetChecked(mode == MODE_OBJECT);
    }

    /// @brief Mirror navigation, overlays, and pane state into the View menu.
    hide func ConfigureViewMenu() {
        var enabled = scene != null;
        var navigationEnabled =
            enabled and gameViewOutputFramed == false;
        viewFitItem.SetEnabled(navigationEnabled);
        viewActualSizeItem.SetEnabled(navigationEnabled);
        viewGridItem.SetEnabled(
            enabled and gameViewActive == false);
        viewGridItem.SetChecked(showGrid);
        viewRulersItem.SetEnabled(
            enabled and gameViewActive == false);
        viewRulersItem.SetChecked(showRulers);
        viewGameItem.SetEnabled(enabled);
        viewGameItem.SetChecked(gameViewActive);
        viewGameItem.SetText(
            gameViewActive ? "Exit Game View" : "Game View");

        var canToggleHierarchy =
            UsesDockedHierarchy(lastHostWidth) == false
            and focusModeActive == false
            and hierarchyDock.floating == false;
        viewHierarchyItem.SetEnabled(canToggleHierarchy);
        viewHierarchyItem.SetText(
            compactHierarchyShown
            ? "Return to Canvas"
            : "Open Objects");
        viewInspectorItem.SetEnabled(
            focusModeActive == false or inspectorDock.floating);
        viewInspectorItem.SetText(
            compactInspectorShown
            ? "Return to Canvas"
            : "Toggle Inspector");
        viewPaletteItem.SetEnabled(
            focusModeActive == false or paletteDock.floating);
        viewPaletteItem.SetText(
            compactPaletteShown
            ? "Return to Canvas"
            : "Toggle Palette");
        viewFocusItem.SetEnabled(
            focusButton != null and focusButton.IsEnabled());
        viewFocusItem.SetChecked(focusModeActive);
        viewFocusItem.SetText(
            focusModeActive ? "Exit Focus" : "Focus Canvas");
        viewWorkspaceItem.SetEnabled(true);
        viewWorkspaceItem.SetChecked(workspaceModeActive);
        viewWorkspaceItem.SetText(
            workspaceModeActive ? "Exit Scene Layout" : "Scene Layout");
    }

    /// @brief Open requested overflow menus after responsive visibility settles.
    hide func PumpCommandMenuButtons() {
        if toolMenuButton.WasClicked() {
            ConfigureToolMenu();
            ShowCommandMenu(toolMenuButton, toolMenu);
        }
        if viewMenuButton.WasClicked() {
            ConfigureViewMenu();
            ShowCommandMenu(viewMenuButton, viewMenu);
        }
    }

    /// @brief Keep compact menu affordances visibly and accessibly truthful.
    hide func UpdateCommandMenuButtons() {
        if toolMenuButton != null {
            var hiddenMode =
                mode != MODE_SELECT
                and mode != MODE_PAINT
                and mode != MODE_ERASE;
            var label = "Tools...";
            if compactChrome { label = "Tools"; }
            if hiddenMode {
                label = ToolModeLabel(mode);
                if compactChrome and mode == MODE_RECTANGLE {
                    label = "Rect";
                } else if compactChrome and mode == MODE_ELLIPSE {
                    label = "Oval";
                } else if compactChrome and mode == MODE_FILL {
                    label = "Fill";
                } else if compactChrome and mode == MODE_PICKER {
                    label = "Pick";
                }
            }
            toolMenuButton.SetText(label);
            toolMenuButton.SetStyle(hiddenMode ? 1 : 0);
            toolMenuButton.SetAccessibleDescription(
                "Current 2D scene tool: " + ToolModeLabel(mode) + ".");
        }
        if viewMenuButton != null {
            var presentationActive =
                focusModeActive or workspaceModeActive;
            viewMenuButton.SetStyle(presentationActive ? 1 : 2);
            viewMenuButton.SetAccessibleDescription(
                "Grid " + (showGrid ? "on" : "off")
                + ", rulers " + (showRulers ? "on" : "off")
                + ", Focus " + (focusModeActive ? "on" : "off")
                + ", Scene Layout "
                + (workspaceModeActive ? "on" : "off") + ".");
        }
    }

    /// @brief Swap dense secondary tools and view actions for complete menus.
    hide func ApplyCommandMenuVisibility(useMenus: Boolean) {
        toolMenuButton.SetVisible(useMenus);
        rectangleButton.SetVisible(!useMenus);
        lineButton.SetVisible(!useMenus);
        ellipseButton.SetVisible(!useMenus);
        fillButton.SetVisible(!useMenus);
        pickerButton.SetVisible(!useMenus);
        objectButton.SetVisible(!useMenus);

        viewMenuButton.SetVisible(useMenus);
        fitButton.SetVisible(!useMenus);
        actualSizeButton.SetVisible(!useMenus);
        gridButton.SetVisible(!useMenus);
        rulersButton.SetVisible(!useMenus);
        focusButton.SetVisible(!useMenus);
        workspaceButton.SetVisible(!useMenus);
    }

    /// @brief Reconcile wrapping chrome and master/detail layout after resize.
    expose func RefreshResponsiveLayout() {
        if root == null or bodySplit == null { return; }
        var width = root.GetLogicalWidth();
        var height = root.GetLogicalHeight();
        if width <= 0.0 or height <= 0.0 { return; }
        var widthDelta = width - lastHostWidth;
        if widthDelta < 0.0 { widthDelta = 0.0 - widthDelta; }
        var widthChanged = widthDelta > 0.01;
        lastHostWidth = width;
        lastHostHeight = height;
        var nextCompact = UsesCompactLayout(width);
        var nextCompactChrome = UsesCompactChrome(width);
        var layoutChanged = nextCompact != compactLayout;
        var chromeChanged = nextCompactChrome != compactChrome;
        if layoutChanged {
            compactLayout = nextCompact;
            renderDirty = true;
        }
        compactChrome = nextCompactChrome;
        if layoutChanged or chromeChanged or widthChanged {
            ApplyResponsiveChrome();
        }
        var nextCompactPalette = UsesCompactPaletteLayout(height);
        var paletteChanged =
            nextCompactPalette != compactPaletteLayout;
        if paletteChanged {
            compactPaletteLayout = nextCompactPalette;
            renderDirty = true;
        }
        if layoutChanged or widthChanged {
            ApplyInspectorLayout();
        }
        if layoutChanged or widthChanged or paletteChanged {
            ApplyPaletteLayout();
        }
    }

    /// @brief Keep essential scene actions reachable when toolbar rows wrap.
    hide func ApplyResponsiveChrome() {
        var useCommandMenus = UsesSceneCommandMenus(lastHostWidth);
        ApplyCommandMenuVisibility(useCommandMenus);
        if compactChrome {
            // The direct compact set needs at most two tool rows and three
            // short view rows, leaving most small-window height to the canvas.
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 68.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 100.0);
            newSceneButton.SetText("New");
            importButton.SetText("Import...");
            runSceneButton.SetText("Run");
            rectangleButton.SetText("Rect");
            ellipseButton.SetText("Oval");
            previewButton.SetText("Play");
            toolbar.SetGap(2.0);
            toolbar.SetPadding(2.0);
            viewToolbar.SetGap(2.0);
            viewToolbar.SetPadding(2.0);
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else if lastHostWidth < WRAPPED_SCENE_2D_CHROME_WIDTH {
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 40.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 40.0);
            newSceneButton.SetText("New");
            importButton.SetText("Import");
            rectangleButton.SetText("Rect");
            ellipseButton.SetText("Oval");
            previewButton.SetText("Play");
            runSceneButton.SetText("Run");
            toolbar.SetGap(2.0);
            toolbar.SetPadding(2.0);
            viewToolbar.SetGap(2.0);
            viewToolbar.SetPadding(2.0);
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else if UsesDockedHierarchy(lastHostWidth) == false {
            // Laptop-width scene-layout mode fits the concise actions in one
            // row. Do not keep the narrower tier's defensive two-row floor:
            // that would consume canvas height as an empty band.
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 0.0);
            newSceneButton.SetText("New");
            importButton.SetText("Import");
            rectangleButton.SetText("Rect");
            ellipseButton.SetText("Oval");
            previewButton.SetText("Play");
            runSceneButton.SetText("Run");
            toolbar.SetGap(4.0);
            toolbar.SetPadding(4.0);
            viewToolbar.SetGap(4.0);
            viewToolbar.SetPadding(4.0);
            toolbarStatus.SetVisible(false);
            viewStatusLabel.SetVisible(false);
        } else {
            toolbar.SetPreferredSize(0.0, 0.0);
            toolbar.SetMinSize(0.0, 0.0);
            viewToolbar.SetPreferredSize(0.0, 0.0);
            viewToolbar.SetMinSize(0.0, 0.0);
            newSceneButton.SetText("New Scene");
            importButton.SetText("Import Tiled...");
            rectangleButton.SetText("Rectangle");
            ellipseButton.SetText("Ellipse");
            previewButton.SetText("Preview");
            runSceneButton.SetText("Run Scene");
            toolbar.SetGap(4.0);
            toolbar.SetPadding(4.0);
            viewToolbar.SetGap(4.0);
            viewToolbar.SetPadding(4.0);
            toolbarStatus.SetVisible(true);
            viewStatusLabel.SetVisible(true);
        }
        UpdateInspectorButton();
        UpdatePaletteButton();
        UpdateHierarchyButton();
        UpdateWorkspaceButton();
        UpdateFocusButton();
        UpdateGameViewButton();
        UpdateModeButtons();
        UpdateCommandMenuButtons();
    }

    /// @brief Apply wide split or compact one-pane-at-a-time presentation.
    hide func ApplyInspectorLayout() {
        if bodySplit == null { return; }
        var wantHierarchyPane = false;
        var showHierarchyMaster = false;
        if hierarchySplit != null {
            wantHierarchyPane =
                compactLayout == false
                and focusModeActive == false
                and hierarchyDock.floating == false
                and UsesDockedHierarchy(lastHostWidth);
            showHierarchyMaster =
                compactHierarchyShown
                and focusModeActive == false
                and hierarchyDock.floating == false
                and UsesDockedHierarchy(lastHostWidth) == false;
            var desiredHierarchySide = 1;
            if wantHierarchyPane { desiredHierarchySide = 0; }
            else if showHierarchyMaster { desiredHierarchySide = 2; }
            var currentHierarchySide =
                hierarchySplit.GetCollapsedSide();
            if desiredHierarchySide == 0 {
                hierarchySplit.Restore();
            } else if desiredHierarchySide == 2 {
                hierarchySplit.CollapseSecond();
            } else {
                hierarchySplit.CollapseFirst();
            }
            if currentHierarchySide != desiredHierarchySide {
                renderDirty = true;
            }
        }
        if objectPaneBox != null {
            objectPaneBox.SetVisible(
                wantHierarchyPane or showHierarchyMaster
                    or hierarchyDock.floating);
        }
        var desiredSide = 0;
        if focusModeActive and inspectorDock.floating == false {
            desiredSide = 2;
        } else if compactLayout {
            desiredSide = 2;
            if compactInspectorShown { desiredSide = 1; }
        } else if !inspectorRequestedVisible or inspectorDock.floating {
            desiredSide = 2;
        }

        if bodySplit.GetCollapsedSide() != desiredSide {
            if desiredSide == 1 { bodySplit.CollapseFirst(); }
            else if desiredSide == 2 { bodySplit.CollapseSecond(); }
            else { bodySplit.Restore(); }
            renderDirty = true;
        }
        if canvasSplit != null {
            canvasSplit.SetVisible(desiredSide != 1);
        }
        if inspectorScroll != null {
            inspectorScroll.SetVisible(
                desiredSide != 2 or inspectorDock.floating);
        }
        UpdateHierarchyButton();
        UpdateInspectorButton();
    }

    /// @brief Apply wide canvas/palette split or short-height master/detail.
    hide func ApplyPaletteLayout() {
        if canvasSplit == null { return; }
        if paletteDock.floating {
            if canvasScroll != null { canvasScroll.SetVisible(true); }
            if paletteStripBox != null { paletteStripBox.SetVisible(true); }
            UpdatePaletteButton();
            return;
        }
        var desiredSide = 0;
        if focusModeActive {
            desiredSide = 2;
        } else if compactPaletteLayout {
            desiredSide = 2;
            if compactPaletteShown { desiredSide = 1; }
        } else if paletteRequestedVisible == false {
            desiredSide = 2;
        }
        if canvasSplit.GetCollapsedSide() != desiredSide {
            if desiredSide == 1 { canvasSplit.CollapseFirst(); }
            else if desiredSide == 2 { canvasSplit.CollapseSecond(); }
            else { canvasSplit.Restore(); }
            renderDirty = true;
        }
        if canvasScroll != null {
            canvasScroll.SetVisible(desiredSide != 1);
        }
        if paletteStripBox != null {
            paletteStripBox.SetVisible(desiredSide != 2);
        }
        UpdatePaletteButton();
    }

    /// @brief Keep the narrow hierarchy master action truthful.
    hide func UpdateHierarchyButton() {
        if hierarchyButton == null { return; }
        var needsMaster =
            lastHostWidth > 0.0
            and UsesDockedHierarchy(lastHostWidth) == false;
        hierarchyButton.SetVisible(needsMaster);
        if needsMaster == false { return; }
        if focusModeActive {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Objects hidden");
            hierarchyButton.SetTooltip(
                "Exit Focus to open the object hierarchy");
            hierarchyButton.SetStyle(0);
        } else if hierarchyDock.floating {
            hierarchyButton.SetEnabled(false);
            hierarchyButton.SetText("Objects floating");
            hierarchyButton.SetTooltip(
                "The object hierarchy is already available in its floating pane");
            hierarchyButton.SetStyle(2);
        } else if compactHierarchyShown {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Canvas");
            hierarchyButton.SetTooltip(
                "Return to the scene canvas");
            hierarchyButton.SetStyle(1);
        } else {
            hierarchyButton.SetEnabled(true);
            hierarchyButton.SetText("Objects");
            hierarchyButton.SetTooltip(
                "Open the object hierarchy at the full editor width");
            hierarchyButton.SetStyle(2);
        }
    }

    /// @brief Describe the destination of the inspector toggle.
    hide func UpdateInspectorButton() {
        if inspectorButton == null { return; }
        if focusModeActive and inspectorDock.floating == false {
            inspectorButton.SetEnabled(false);
            inspectorButton.SetText("Inspector hidden");
            inspectorButton.SetTooltip(
                "Exit Focus to restore the scene inspector");
            inspectorButton.SetStyle(0);
            return;
        }
        inspectorButton.SetEnabled(true);
        if compactHierarchyShown {
            inspectorButton.SetText("Inspector");
            inspectorButton.SetTooltip(
                "Switch from objects to the scene inspector");
            inspectorButton.SetStyle(2);
            return;
        }
        if compactLayout {
            if compactInspectorShown {
                inspectorButton.SetText("Canvas");
                inspectorButton.SetTooltip("Return to the full-width scene canvas");
                inspectorButton.SetStyle(1);
            } else {
                inspectorButton.SetText("Inspector");
                inspectorButton.SetTooltip("Show the scene inspector at full width");
                inspectorButton.SetStyle(2);
            }
        } else if inspectorRequestedVisible {
            inspectorButton.SetText("Hide Inspector");
            inspectorButton.SetTooltip(
                "Hide the scene inspector and give the canvas the full width");
            inspectorButton.SetStyle(2);
        } else {
            inspectorButton.SetText("Show Inspector");
            inspectorButton.SetTooltip("Restore the scene inspector");
            inspectorButton.SetStyle(1);
        }
    }

    /// @brief Describe the destination of the palette toggle.
    hide func UpdatePaletteButton() {
        if paletteButton == null { return; }
        if focusModeActive and paletteDock.floating == false {
            paletteButton.SetEnabled(false);
            paletteButton.SetText("Palette hidden");
            paletteButton.SetTooltip(
                "Exit Focus to restore the tile palette");
            paletteButton.SetStyle(0);
            return;
        }
        if paletteDock.floating {
            paletteButton.SetText("Palette floating");
            paletteButton.SetEnabled(false);
            paletteButton.SetStyle(2);
            return;
        }
        paletteButton.SetEnabled(true);
        if compactHierarchyShown {
            paletteButton.SetText("Palette");
            paletteButton.SetTooltip(
                "Switch from objects to the tile palette");
            paletteButton.SetStyle(2);
            return;
        }
        if compactPaletteLayout {
            if compactPaletteShown {
                paletteButton.SetText("Canvas");
                paletteButton.SetTooltip(
                    "Return to the full-height scene canvas");
                paletteButton.SetStyle(1);
            } else {
                paletteButton.SetText("Palette");
                paletteButton.SetTooltip(
                    "Show the tile palette at full height");
                paletteButton.SetStyle(2);
            }
        } else if paletteRequestedVisible {
            paletteButton.SetText("Hide Palette");
            paletteButton.SetTooltip(
                "Hide the tile palette and give the canvas the full height");
            paletteButton.SetStyle(2);
        } else {
            paletteButton.SetText("Show Palette");
            paletteButton.SetTooltip("Restore the tile palette");
            paletteButton.SetStyle(1);
        }
    }

    /// @brief Keep the reversible outer-only scene-layout action truthful.
    hide func UpdateWorkspaceButton() {
        if workspaceButton == null { return; }
        if workspaceModeActive {
            workspaceButton.SetText("Exit Layout");
            workspaceButton.SetTooltip(
                "Restore the Studio sidebar and tool docks while keeping "
                    + "this scene's internal pane layout");
            workspaceButton.SetStyle(1);
        } else {
            if compactChrome
               or UsesDockedHierarchy(lastHostWidth) == false {
                workspaceButton.SetText("Layout");
            } else {
                workspaceButton.SetText("Scene Layout");
            }
            workspaceButton.SetTooltip(
                "Hide outer Studio docks but keep objects, canvas, palette, "
                    + "and inspector available");
            workspaceButton.SetStyle(2);
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Keep the reversible outer-workbench action truthful.
    hide func UpdateFocusButton() {
        if focusButton == null { return; }
        if focusModeActive {
            focusButton.SetText("Exit Focus");
            focusButton.SetTooltip(
                "Restore scene panes, sidebar, and tool panels (Shift+Space)");
            focusButton.SetStyle(1);
        } else {
            focusButton.SetText("Focus");
            focusButton.SetTooltip(
                "Hide scene panes and outer Studio docks to maximize the canvas "
                + "(Shift+Space)");
            focusButton.SetStyle(2);
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Apply deferred scroll state after the canvas content size is known.
    hide func ApplyPendingWorkspaceScroll() {
        if restoreScrollPending == false { return; }
        if canvasScroll != null {
            SetLogicalScroll(
                canvasScroll,
                pendingCanvasScrollX, pendingCanvasScrollY);
        }
        if inspectorScroll != null {
            SetLogicalScroll(
                inspectorScroll, 0.0, pendingInspectorScrollY);
        }
        restoreScrollPending = false;
    }

    /// @brief Return the editor's monotonically increasing content revision.
    expose func GetRevision() -> Integer {
        return revision;
    }

    /// @brief Create a canonical default scene JSON for New Scene commands.
    expose func DefaultSceneJson() -> String {
        var fresh = SceneDocument.New(DEFAULT_SCENE_WIDTH,
                                      DEFAULT_SCENE_HEIGHT,
                                      DEFAULT_TILE_SIZE,
                                      DEFAULT_TILE_SIZE);
        return fresh.ToJson();
    }

    /// @brief Set one tile through the same transactional path as canvas paint.
    /// @return True only when a valid cell changed.
    expose func SetSceneTile(layer: Integer,
                             x: Integer,
                             y: Integer,
                             tile: Integer) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or x < 0 or y < 0 or x >= scene.Width or y >= scene.Height {
            return false;
        }
        var nextTile = tile;
        if nextTile < 0 { nextTile = 0; }
        if scene.GetTile(layer, x, y) == nextTile { return false; }
        scene.SetTile(layer, x, y, nextTile);
        activeLayer = layer;
        selectedCellX = x;
        selectedCellY = y;
        return CommitScene("Tile " + x + ", " + y + " updated");
    }

    /// @brief Paint an inclusive raster line as one undoable document edit.
    /// @details This is the deterministic command path used to regression-test
    ///          gap-free drag strokes without relying on native pointer timing.
    expose func PaintTileLine(layer: Integer,
                              startX: Integer,
                              startY: Integer,
                              endX: Integer,
                              endY: Integer,
                              tile: Integer) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or startX < 0 or startY < 0 or endX < 0 or endY < 0
           or startX >= scene.Width or endX >= scene.Width
           or startY >= scene.Height or endY >= scene.Height {
            return false;
        }
        var nextTile = tile;
        if nextTile < 0 { nextTile = 0; }
        var snapshot = currentSerialized;
        if ApplyTileLineUncommitted(
               layer, startX, startY, endX, endY, nextTile) == false {
            return false;
        }
        activeLayer = layer;
        selectedCellX = endX;
        selectedCellY = endY;
        if CommitScene("Painted tile stroke") { return true; }
        RestoreSceneSnapshot(snapshot);
        detailLabel.SetText("The tile stroke could not be committed.");
        return false;
    }

    /// @brief Fill one inclusive forward or reverse cell rectangle atomically.
    /// @return True only when at least one canonical tile changed and committed.
    expose func ApplyTileRectangle(layer: Integer,
                                   startX: Integer,
                                   startY: Integer,
                                   endX: Integer,
                                   endY: Integer,
                                   tile: Integer) -> Boolean {
        if RefuseLockedLayer(layer) { return false; }
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or startX < 0 or startY < 0 or endX < 0 or endY < 0
           or startX >= scene.Width or endX >= scene.Width
           or startY >= scene.Height or endY >= scene.Height {
            return false;
        }
        var minimumX = startX;
        var maximumX = endX;
        if maximumX < minimumX {
            minimumX = endX;
            maximumX = startX;
        }
        var minimumY = startY;
        var maximumY = endY;
        if maximumY < minimumY {
            minimumY = endY;
            maximumY = startY;
        }
        var nextTile = tile;
        if nextTile < 0 { nextTile = 0; }

        var changedCells = 0;
        var y = minimumY;
        while y <= maximumY {
            var x = minimumX;
            while x <= maximumX {
                if scene.GetTile(layer, x, y) != nextTile {
                    changedCells = changedCells + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        activeLayer = layer;
        selectedCellX = endX;
        selectedCellY = endY;
        renderDirty = true;
        if changedCells == 0 {
            toolbarStatus.SetText("Rectangle already matches the selected tile");
            return false;
        }

        var snapshot = currentSerialized;
        scene.FillTiles(
            layer,
            minimumX,
            minimumY,
            maximumX - minimumX + 1,
            maximumY - minimumY + 1,
            nextTile);
        if CommitScene(
               "Filled " + changedCells + " rectangle tile(s)") {
            detailLabel.SetText("");
            return true;
        }
        RestoreSceneSnapshot(snapshot);
        detailLabel.SetText("The tile rectangle could not be committed.");
        return false;
    }

    /// @brief Replace one four-connected active-layer tile region atomically.
    /// @return Exact changed-cell count, or zero for invalid/no-op/failure.
    expose func FloodFillSceneTile(layer: Integer,
                                   x: Integer,
                                   y: Integer,
                                   tile: Integer) -> Integer {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or x < 0 or y < 0 or x >= scene.Width or y >= scene.Height {
        if RefuseLockedLayer(layer) { return -1; }
            return 0;
        }
        var nextTile = tile;
        if nextTile < 0 { nextTile = 0; }
        activeLayer = layer;
        selectedCellX = x;
        selectedCellY = y;
        renderDirty = true;
        if scene.GetTile(layer, x, y) == nextTile {
            toolbarStatus.SetText("Fill region already matches the selected tile");
            return 0;
        }

        var snapshot = currentSerialized;
        var changedCells = scene.FloodFill(layer, x, y, nextTile);
        if changedCells <= 0 {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The contiguous tile fill was rejected.");
            return 0;
        }
        if CommitScene(
               "Filled " + changedCells + " connected tile(s)") {
            detailLabel.SetText("");
            return changedCells;
        }
        RestoreSceneSnapshot(snapshot);
        detailLabel.SetText("The contiguous tile fill could not be committed.");
        return 0;
    }

    /// @brief Sample one active-layer cell into the tile field and enter Paint.
    /// @return Authored tile ID, or -1 for invalid input.
    expose func PickSceneTile(layer: Integer,
                              x: Integer,
                              y: Integer) -> Integer {
        if scene == null or tileSpinner == null
           or layer < 0 or layer >= scene.LayerCount()
           or x < 0 or y < 0 or x >= scene.Width or y >= scene.Height {
            return -1;
        }
        var tile = scene.GetTile(layer, x, y);
        activeLayer = layer;
        selectedCellX = x;
        selectedCellY = y;
        tileSpinner.SetValue(ClampInt(tile, 0, 1000000));
        SetMode(MODE_PAINT);
        RefreshTilesetPalette();
        renderDirty = true;
        toolbarStatus.SetText(
            "Picked tile " + tile + " from " + x + ", " + y);
        detailLabel.SetText("");
        return tile;
    }

    /// @brief Add one scene object and commit its canonical JSON immediately.
    /// @return New object index, or -1 when the model rejects the object.
    expose func AddSceneObject(typeName: String,
                               objectId: String,
                               x: Integer,
                               y: Integer) -> Integer {
        return AddSceneObjectAtParent(-1, typeName, objectId, x, y);
    }

    /// @brief Add one object beneath an existing parent in one transaction.
    /// @details The hierarchy link is established before serialization, so
    ///          Undo never exposes an intermediate root object.
    expose func AddSceneChildObject(parentIndex: Integer,
                                    typeName: String,
                                    objectId: String,
                                    x: Integer,
                                    y: Integer) -> Integer {
        return AddSceneObjectAtParent(
            parentIndex, typeName, objectId, x, y);
    }

    /// @brief Shared root/child creation path with exact selection rollback.
    hide func AddSceneObjectAtParent(parentIndex: Integer,
                                     typeName: String,
                                     objectId: String,
                                     x: Integer,
                                     y: Integer) -> Integer {
        if scene == null { return -1; }
        if parentIndex < -1 or parentIndex >= scene.ObjectCount() {
            detailLabel.SetText("Choose an attached parent object.");
            return -1;
        }
        if parentIndex >= 0
           and ObjectHierarchyDepth(parentIndex)
               >= MAX_OBJECT_HIERARCHY_DEPTH {
            detailLabel.SetText(
                "A child there would exceed Studio's hierarchy depth limit.");
            return -1;
        }
        var nextType = Str.Trim(typeName);
        var nextId = Str.Trim(objectId);
        if nextType == "" {
            detailLabel.SetText("Object type cannot be empty.");
            return -1;
        }
        if nextId == "" {
            detailLabel.SetText("Object ID cannot be empty.");
            return -1;
        }
        if ObjectIdExists(nextId, -1) {
            detailLabel.SetText("Object ID \"" + nextId + "\" is already in use.");
            return -1;
        }
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var previousProperty = selectedObjectProperty;
        var objectIndex = scene.AddObject(nextType, nextId, x, y);
        if objectIndex < 0 { return -1; }
        if parentIndex >= 0
           and scene.TrySetObjectParent(
                   objectIndex, parentIndex) == false {
            scene.RemoveObject(objectIndex);
            detailLabel.SetText(
                "The scene model rejected the new child hierarchy link.");
            return -1;
        }
        selectedObject = objectIndex;
        selectedObjects = scene_selection.Single(
            objectIndex, scene.ObjectCount());
        var action = "Added object " + nextId;
        if parentIndex >= 0 { action = "Added child object " + nextId; }
        if CommitScene(action) == false {
            scene.RemoveObject(objectIndex);
            selectedObject = previousPrimary;
            selectedObjects = previousSelection;
            selectedObjectProperty = previousProperty;
            detailLabel.SetText("The object could not be committed to the document.");
            RefreshInspector();
            return -1;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return objectIndex;
    }

    /// @brief Apply reserved metadata and position as one undoable inspector edit.
    expose func UpdateSceneObject(index: Integer,
                                  typeName: String,
                                  objectId: String,
                                  x: Integer,
                                  y: Integer) -> Boolean {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return false;
        }
        var nextType = Str.Trim(typeName);
        var nextId = Str.Trim(objectId);
        if nextType == "" {
            detailLabel.SetText("Object type cannot be empty.");
            return false;
        }
        if nextId == "" {
            detailLabel.SetText("Object ID cannot be empty.");
            return false;
        }
        if ObjectIdExists(nextId, index) {
            detailLabel.SetText("Object ID \"" + nextId + "\" is already in use.");
            return false;
        }

        var previousType = scene.ObjectType(index);
        var previousId = scene.ObjectId(index);
        var previousX = scene.ObjectX(index);
        var previousY = scene.ObjectY(index);
        if previousType == nextType and previousId == nextId
           and previousX == x and previousY == y {
            detailLabel.SetText("Object is already up to date.");
            return false;
        }

        scene.SetObjectMetadata(index, nextType, nextId);
        scene.SetObjectPosition(index, x, y);
        if scene.ObjectType(index) != nextType or scene.ObjectId(index) != nextId {
            scene.SetObjectMetadata(index, previousType, previousId);
            scene.SetObjectPosition(index, previousX, previousY);
            detailLabel.SetText("Object metadata was rejected by the scene model.");
            return false;
        }
        selectedObject = index;
        selectedObjects = scene_selection.Single(
            index, scene.ObjectCount());
        if CommitScene("Updated object " + nextId) == false {
            scene.SetObjectMetadata(index, previousType, previousId);
            scene.SetObjectPosition(index, previousX, previousY);
            detailLabel.SetText("The object update could not be committed.");
            RefreshInspector();
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Duplicate one object without flattening its typed property map.
    /// @return New object index, or -1 when the model rejects the operation.
    expose func DuplicateSceneObject(index: Integer) -> Integer {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return -1;
        }
        var nextId = UniqueObjectId(scene.ObjectId(index) + "-copy");
        var duplicate = scene.DuplicateObject(index, nextId);
        if duplicate < 0 {
            detailLabel.SetText("The scene could not duplicate this object.");
            return -1;
        }
        scene.SetObjectPosition(
            duplicate,
            scene.ObjectX(index) + scene.TileWidth,
            scene.ObjectY(index) + scene.TileHeight);
        selectedObject = duplicate;
        selectedObjects = scene_selection.Single(
            duplicate, scene.ObjectCount());
        if CommitScene("Duplicated object as " + nextId) == false {
            scene.RemoveObject(duplicate);
            selectedObject = index;
            selectedObjects = scene_selection.Single(
                index, scene.ObjectCount());
            detailLabel.SetText("The duplicate could not be committed.");
            RefreshInspector();
            return -1;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return duplicate;
    }

    /// @brief Select validated object rows with one explicit primary object.
    expose func SelectSceneObjects(indices: List[Integer],
                                   primary: Integer) -> Boolean {
        if scene == null { return false; }
        selectedObjects = scene_selection.Normalize(
            indices, scene.ObjectCount(), primary);
        selectedObject = primary;
        if selectedObject < 0 or selectedObject >= scene.ObjectCount() {
            selectedObject = -1;
            if selectedObjects.count() > 0 {
                selectedObject = selectedObjects.get(0);
            }
        }
        selectedObjectProperty = -1;
        if objectTree != null {
            ExpandObjectTreeAncestors(selectedObject);
            RestoreObjectTreeSelection();
            if selectedObject >= 0
               and selectedObject < objectTreeNodes.count()
               and objectTreeNodes.get(selectedObject) != null {
                objectTree.ScrollTo(objectTreeNodes.get(selectedObject));
            }
        }
        RefreshObjectFields();
        renderDirty = true;
        CaptureWorkspaceState();
        return selectedObjects.count() > 0;
    }

    /// @brief Apply one canvas point hit with conventional modifier semantics.
    /// @details An unmodified hit on an already-selected object preserves the
    ///          complete group so the same press can begin a group drag.
    ///          Selection is workspace-only and never commits scene history.
    /// @return True only when selection or primary identity changed.
    expose func ApplyCanvasPointSelection(objectIndex: Integer,
                                          additive: Boolean,
                                          toggle: Boolean) -> Boolean {
        if scene == null { return false; }
        var current = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if objectIndex < 0 or objectIndex >= scene.ObjectCount() {
            if additive or toggle or current.count() == 0 {
                return false;
            }
            SelectSceneObjects([], -1);
            return true;
        }

        var next: List[Integer] = [];
        var nextPrimary = objectIndex;
        if toggle {
            var removing =
                scene_selection.Contains(current, objectIndex);
            var index = 0;
            while index < current.count() {
                var candidate = current.get(index);
                if removing == false or candidate != objectIndex {
                    next.add(candidate);
                }
                index = index + 1;
            }
            if removing == false { next.add(objectIndex); }
            if removing {
                if next.count() == 0 {
                    nextPrimary = -1;
                } else if selectedObject != objectIndex
                          and scene_selection.Contains(
                              next, selectedObject) {
                    nextPrimary = selectedObject;
                } else {
                    nextPrimary = next.get(next.count() - 1);
                }
            }
        } else if additive {
            next = current;
            if scene_selection.Contains(next, objectIndex) == false {
                next.add(objectIndex);
            }
        } else if scene_selection.Contains(current, objectIndex) {
            next = current;
        } else {
            next.add(objectIndex);
        }

        if nextPrimary == selectedObject
           and IntegerListsEqual(next, current) {
            return false;
        }
        SelectSceneObjects(next, nextPrimary);
        return true;
    }

    /// @brief Return authored objects whose point occupies an inclusive cell box.
    /// @details Results follow effective preview draw order, so the final item
    ///          is the same topmost identity a point hit would prefer.
    expose func CanvasObjectsInCellRect(startX: Integer,
                                        startY: Integer,
                                        endX: Integer,
                                        endY: Integer)
        -> List[Integer] {
        var hits: List[Integer] = [];
        if scene == null or scene.TileWidth <= 0 or scene.TileHeight <= 0 {
            return hits;
        }
        var minimumX = startX;
        var maximumX = endX;
        if maximumX < minimumX {
            minimumX = endX;
            maximumX = startX;
        }
        var minimumY = startY;
        var maximumY = endY;
        if maximumY < minimumY {
            minimumY = endY;
            maximumY = startY;
        }
        var stack = ObjectPreviewStack();
        var stackIndex = 0;
        while stackIndex < stack.count() {
            var index = stack.get(stackIndex);
            var cellX = scene.ObjectX(index) / scene.TileWidth;
            var cellY = scene.ObjectY(index) / scene.TileHeight;
            if cellX >= minimumX and cellX <= maximumX
               and cellY >= minimumY and cellY <= maximumY {
                hits.add(index);
            }
            stackIndex = stackIndex + 1;
        }
        return hits;
    }

    /// @brief Apply one completed inclusive canvas marquee against selection.
    /// @return True only when selection or primary identity changed.
    expose func ApplyCanvasMarqueeSelection(startX: Integer,
                                            startY: Integer,
                                            endX: Integer,
                                            endY: Integer,
                                            additive: Boolean,
                                            toggle: Boolean) -> Boolean {
        if scene == null { return false; }
        var current = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var hits = CanvasObjectsInCellRect(
            startX, startY, endX, endY);
        if hits.count() == 0 and (additive or toggle) {
            return false;
        }

        var next: List[Integer] = [];
        var nextPrimary = selectedObject;
        if toggle {
            var currentIndex = 0;
            while currentIndex < current.count() {
                var candidate = current.get(currentIndex);
                if scene_selection.Contains(hits, candidate) == false {
                    next.add(candidate);
                }
                currentIndex = currentIndex + 1;
            }
            var lastAdded = -1;
            var hitIndex = 0;
            while hitIndex < hits.count() {
                var hit = hits.get(hitIndex);
                if scene_selection.Contains(current, hit) == false {
                    next.add(hit);
                    lastAdded = hit;
                }
                hitIndex = hitIndex + 1;
            }
            if lastAdded >= 0 {
                nextPrimary = lastAdded;
            } else if scene_selection.Contains(next, selectedObject) {
                nextPrimary = selectedObject;
            } else if next.count() > 0 {
                nextPrimary = next.get(next.count() - 1);
            } else {
                nextPrimary = -1;
            }
        } else if additive {
            next = current;
            var hitIndex = 0;
            while hitIndex < hits.count() {
                var hit = hits.get(hitIndex);
                if scene_selection.Contains(next, hit) == false {
                    next.add(hit);
                }
                hitIndex = hitIndex + 1;
            }
            if hits.count() > 0 {
                nextPrimary = hits.get(hits.count() - 1);
            }
        } else {
            next = hits;
            nextPrimary = -1;
            if hits.count() > 0 {
                nextPrimary = hits.get(hits.count() - 1);
            }
        }

        if nextPrimary == selectedObject
           and IntegerListsEqual(next, current) {
            return false;
        }
        SelectSceneObjects(next, nextPrimary);
        return true;
    }

    /// @brief Reveal and focus the hierarchy Find field without editing scene data.
    /// @return True when a loaded scene owns a usable search field.
    expose func FocusHierarchySearch() -> Boolean {
        if scene == null or hierarchySearchInput == null { return false; }
        if hierarchyDock.floating == false
           and UsesDockedHierarchy(lastHostWidth) == false {
            compactHierarchyShown = true;
            compactInspectorShown = false;
            compactPaletteShown = false;
        }
        ApplyInspectorLayout();
        ApplyPaletteLayout();
        hierarchySearchInput.Focus();
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Select and reveal one bounded id/type hierarchy match.
    /// @param query Case-insensitive object id or type fragment.
    /// @param direction Negative for previous; zero or positive for next.
    /// @return True when a matching represented row was selected.
    expose func FindHierarchy(query: String,
                              direction: Integer) -> Boolean {
        if scene == null or hierarchySearchInput == null { return false; }
        var normalized = scene_hierarchy_search.Normalize(query);
        var resetCursor = normalized != hierarchySearchQuery;
        if hierarchySearchInput.Text != query {
            hierarchySearchInput.SetText(query);
        }
        RefreshHierarchySearch(resetCursor);
        return NavigateHierarchySearch(direction);
    }

    /// @brief Rebuild match indices from represented rows only.
    /// @details Canonical objects hidden by hierarchy safety bounds remain
    ///          untouched and are never offered as an impossible-to-reveal hit.
    hide func RefreshHierarchySearch(resetCursor: Boolean) {
        if hierarchySearchInput == null { return; }
        hierarchySearchQuery = scene_hierarchy_search.Normalize(
            hierarchySearchInput.Text);
        hierarchySearchMatches = [];
        if scene != null and hierarchySearchQuery != "" {
            var index = 0;
            while index < scene.ObjectCount()
                  and index < objectTreeNodes.count() {
                if objectTreeNodes.get(index) != null
                   and scene_hierarchy_search.MatchesNormalized(
                       hierarchySearchQuery,
                       scene.ObjectId(index),
                       scene.ObjectType(index)) {
                    hierarchySearchMatches.add(index);
                }
                index = index + 1;
            }
        }

        hierarchySearchCursor = -1;
        if resetCursor == false {
            var match = 0;
            while match < hierarchySearchMatches.count() {
                if hierarchySearchMatches.get(match) == selectedObject {
                    hierarchySearchCursor = match;
                    break;
                }
                match = match + 1;
            }
        }
        UpdateHierarchySearchControls();
    }

    /// @brief Apply one previous/next hierarchy jump without scene mutation.
    hide func NavigateHierarchySearch(direction: Integer) -> Boolean {
        hierarchySearchCursor = scene_hierarchy_search.NextCursor(
            hierarchySearchMatches.count(),
            hierarchySearchCursor,
            direction);
        if hierarchySearchCursor < 0
           or hierarchySearchCursor >= hierarchySearchMatches.count() {
            UpdateHierarchySearchControls();
            return false;
        }
        var target = hierarchySearchMatches.get(hierarchySearchCursor);
        var selection = scene_selection.Single(
            target, scene.ObjectCount());
        var selected = SelectSceneObjects(selection, target);
        UpdateHierarchySearchControls();
        return selected;
    }

    /// @brief Pump search text and navigation controls without scene history.
    hide func PumpHierarchySearchControls() {
        if hierarchySearchInput == null { return; }
        var query = scene_hierarchy_search.Normalize(
            hierarchySearchInput.Text);
        if query != hierarchySearchQuery {
            RefreshHierarchySearch(true);
        }
        var direction = 0;
        var requested = false;
        if hierarchySearchPreviousButton.WasClicked() {
            direction = -1;
            requested = true;
        }
        if hierarchySearchNextButton.WasClicked()
           or hierarchySearchInput.WasSubmitted() {
            direction = 1;
            requested = true;
        }
        if requested { NavigateHierarchySearch(direction); }
    }

    /// @brief Reflect query, match cursor, and safety bounds in compact UI.
    hide func UpdateHierarchySearchControls() {
        if hierarchySearchInput == null { return; }
        var available = editorControlsEnabled and scene != null;
        hierarchySearchInput.SetEnabled(available);
        var canNavigate =
            available and hierarchySearchMatches.count() > 0;
        hierarchySearchPreviousButton.SetEnabled(canNavigate);
        hierarchySearchNextButton.SetEnabled(canNavigate);

        var suffix = "";
        if objectHierarchyClipped {
            suffix = " within the bounded visible hierarchy";
        }
        if hierarchySearchQuery == "" {
            hierarchySearchStatus.SetText(
                "Find by object id or type" + suffix);
        } else if hierarchySearchMatches.count() == 0 {
            hierarchySearchStatus.SetText(
                "No matching objects" + suffix);
        } else if hierarchySearchCursor < 0 {
            hierarchySearchStatus.SetText(
                hierarchySearchMatches.count()
                + " matching object(s)" + suffix
                + "; press Enter to jump");
        } else {
            hierarchySearchStatus.SetText(
                "Match " + (hierarchySearchCursor + 1)
                + " of " + hierarchySearchMatches.count()
                + suffix);
        }
    }

    /// @brief Return whether at least one valid object is selected.
    expose func HasSceneObjectSelection() -> Boolean {
        if scene == null { return false; }
        var normalized = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        return normalized.count() > 0;
    }

    /// @brief Return whether Select All has an object target.
    expose func CanSelectAllSceneObjects() -> Boolean {
        return scene != null and scene.ObjectCount() > 0;
    }

    /// @brief Return whether the text clipboard may contain pasteable data.
    /// @details Kind and payload validation happen only on explicit paste so
    ///          Studio does not copy a potentially large native clipboard every
    ///          render frame merely to update menu chrome.
    expose func CanPasteSceneObjects() -> Boolean {
        return scene != null and GUI.ClipboardText.HasText();
    }

    /// @brief Select every authored object without changing scene history.
    expose func SelectAllSceneObjects() -> Boolean {
        if CanSelectAllSceneObjects() == false { return false; }
        var all: List[Integer] = [];
        var index = 0;
        while index < scene.ObjectCount() {
            all.add(index);
            index = index + 1;
        }
        var primary = selectedObject;
        if primary < 0 or primary >= scene.ObjectCount() { primary = 0; }
        if SelectSceneObjects(all, primary) == false { return false; }
        toolbarStatus.SetText(
            "Selected all " + selectedObjects.count() + " scene objects");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Copy selected objects as canonical typed scene data.
    expose func CopySelectedSceneObjects() -> Boolean {
        if scene == null or currentSerialized == "" { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if selectedObjects.count() == 0 { return false; }
        if selectedObject < 0
           or scene_selection.Contains(selectedObjects, selectedObject) == false {
            selectedObject = selectedObjects.get(0);
        }
        var encoded = scene_clipboard.Encode(
            "2d", selectedObjects, selectedObject, currentSerialized);
        if encoded == "" {
            toolbarStatus.SetText("Scene objects not copied");
            detailLabel.SetText(
                "The selected objects exceed Studio's scene clipboard limit.");
            return false;
        }
        GUI.ClipboardText.SetText(encoded);
        toolbarStatus.SetText(
            "Copied " + selectedObjects.count() + " scene object(s)");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Copy and remove selected objects as one undoable edit.
    expose func CutSelectedSceneObjects() -> Boolean {
        var count = selectedObjects.count();
        if CopySelectedSceneObjects() == false { return false; }
        if RemoveSelectedSceneObjects() == false {
            detailLabel.SetText(
                "The objects were copied, but Studio could not remove them.");
            return false;
        }
        toolbarStatus.SetText("Cut " + count + " scene object(s)");
        return true;
    }

    /// @brief Paste typed 2D objects into this scene as one history action.
    /// @details Source metadata and custom null/bool/int/float/string values are
    ///          reconstructed through SceneDocument's typed APIs. Any rejected
    ///          object restores the exact pre-paste canonical snapshot.
    expose func PasteSceneObjectsFromClipboard() -> Boolean {
        if scene == null or currentDoc == null { return false; }
        var payload = scene_clipboard.Decode(GUI.ClipboardText.GetText());
        if payload.valid == false {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(payload.error);
            return false;
        }
        if payload.kind != "2d" {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard contains 3D nodes. Paste them into a 3D scene.");
            return false;
        }
        var parsed = SceneDocument.LoadJsonResult(payload.content);
        if parsed.IsOk == false {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard contains invalid or unsupported 2D scene data.");
            return false;
        }
        var source = parsed.Unwrap() as SceneDocument;
        var sourceSelection = scene_selection.Normalize(
            payload.indices, source.ObjectCount(), payload.primary);
        if sourceSelection.count() != payload.indices.count()
           or payload.primary < 0
           or payload.primary >= source.ObjectCount() {
            toolbarStatus.SetText("Nothing pasted");
            detailLabel.SetText(
                "Clipboard object identities no longer match its scene data.");
            return false;
        }

        var snapshot = currentSerialized;
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var pasted: List[Integer] = [];
        var pastedPrimary = -1;
        var index = 0;
        while index < sourceSelection.count() {
            var sourceIndex = sourceSelection.get(index);
            var destination = CopyObjectFromScene(source, sourceIndex);
            if destination < 0 {
                RestoreSceneSnapshot(snapshot);
                selectedObjects = previousSelection;
                selectedObject = previousPrimary;
                RefreshInspector();
                toolbarStatus.SetText("Paste rolled back");
                detailLabel.SetText(
                    "Studio could not reconstruct every copied object. "
                    + "No scene data was changed.");
                return false;
            }
            pasted.add(destination);
            if sourceIndex == payload.primary { pastedPrimary = destination; }
            index = index + 1;
        }
        index = 0;
        while index < sourceSelection.count() {
            var sourceParent =
                source.ObjectParent(sourceSelection.get(index));
            var parentSelectionIndex =
                IntegerIndexOf(sourceSelection, sourceParent);
            if parentSelectionIndex >= 0
               and scene.TrySetObjectParent(
                      pasted.get(index),
                      pasted.get(parentSelectionIndex)) == false {
                RestoreSceneSnapshot(snapshot);
                selectedObjects = previousSelection;
                selectedObject = previousPrimary;
                RefreshInspector();
                toolbarStatus.SetText("Paste rolled back");
                detailLabel.SetText(
                    "Studio could not restore the copied object hierarchy. "
                    + "No scene data was changed.");
                return false;
            }
            index = index + 1;
        }
        if pastedPrimary < 0 and pasted.count() > 0 {
            pastedPrimary = pasted.get(0);
        }
        selectedObjects = pasted;
        selectedObject = pastedPrimary;
        selectedObjectProperty = -1;
        var message = "Pasted " + pasted.count() + " scene objects";
        if pasted.count() == 1 { message = "Pasted scene object"; }
        if pasted.count() == 0 or CommitScene(message) == false {
            RestoreSceneSnapshot(snapshot);
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            RefreshInspector();
            toolbarStatus.SetText("Paste rolled back");
            detailLabel.SetText(
                "The pasted objects could not be committed. "
                + "No scene data was changed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Reconstruct one object from another loaded scene.
    hide func CopyObjectFromScene(source: SceneDocument,
                                  sourceIndex: Integer) -> Integer {
        if scene == null or source == null
           or sourceIndex < 0 or sourceIndex >= source.ObjectCount() {
            return -1;
        }
        var nextId = UniqueObjectId(
            source.ObjectId(sourceIndex) + "-copy");
        var destination = scene.AddObject(
            source.ObjectType(sourceIndex),
            nextId,
            source.ObjectX(sourceIndex) + scene.TileWidth,
            source.ObjectY(sourceIndex) + scene.TileHeight);
        if destination < 0 { return -1; }

        var keys = source.ObjectKeys(sourceIndex);
        var keyIndex = 0;
        while keyIndex < Seq.get_Count(keys) {
            var key = Seq.GetStr(keys, keyIndex);
            var kind = source.ObjectPropertyKind(sourceIndex, key);
            if kind == "string" {
                scene.ObjectSetStr(
                    destination, key,
                    source.ObjectGetStr(sourceIndex, key, ""));
            } else if kind == "int" {
                scene.ObjectSetInt(
                    destination, key,
                    source.ObjectGetInt(sourceIndex, key, 0));
            } else if kind == "float" {
                scene.ObjectSetFloat(
                    destination, key,
                    source.ObjectGetFloat(sourceIndex, key, 0.0));
            } else if kind == "bool" {
                scene.ObjectSetBool(
                    destination, key,
                    source.ObjectGetBool(sourceIndex, key, false));
            } else if kind == "null" {
                scene.ObjectSetNull(destination, key);
            } else {
                scene.RemoveObject(destination);
                return -1;
            }
            if scene.ObjectHas(destination, key) == false
               or scene.ObjectPropertyKind(destination, key) != kind {
                scene.RemoveObject(destination);
                return -1;
            }
            keyIndex = keyIndex + 1;
        }
        return destination;
    }

    /// @brief Duplicate every selected object as one lossless history action.
    /// @return Number of duplicated objects, or zero when the action fails.
    expose func DuplicateSelectedSceneObjects() -> Integer {
        if scene == null { return 0; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if selectedObjects.count() == 0 { return 0; }

        var snapshot = currentSerialized;
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var sourceIndices = selectedObjects;
        var sourceParents: List[Integer] = [];
        var duplicateIds: List[String] = [];
        var sourceIndex = 0;
        while sourceIndex < sourceIndices.count() {
            sourceParents.add(
                scene.ObjectParent(sourceIndices.get(sourceIndex)));
            duplicateIds.add("");
            sourceIndex = sourceIndex + 1;
        }
        var primaryDuplicateId = "";
        var source = scene.ObjectCount() - 1;
        while source >= 0 {
            if scene_selection.Contains(selectedObjects, source) {
                var selectionPosition =
                    IntegerIndexOf(sourceIndices, source);
                var nextId = UniqueObjectId(
                    scene.ObjectId(source) + "-copy");
                var duplicate = scene.DuplicateObject(source, nextId);
                if duplicate < 0 {
                    selectedObjects = previousSelection;
                    selectedObject = previousPrimary;
                    RestoreSceneSnapshot(snapshot);
                    detailLabel.SetText(
                        "The selected objects could not all be duplicated. "
                        + "No objects were changed.");
                    return 0;
                }
                scene.SetObjectPosition(
                    duplicate,
                    scene.ObjectX(source) + scene.TileWidth,
                    scene.ObjectY(source) + scene.TileHeight);
                if selectionPosition >= 0 {
                    duplicateIds.set(selectionPosition, nextId);
                }
                if source == previousPrimary {
                    primaryDuplicateId = nextId;
                }
            }
            source = source - 1;
        }

        sourceIndex = 0;
        while sourceIndex < sourceIndices.count() {
            var parentPosition = IntegerIndexOf(
                sourceIndices, sourceParents.get(sourceIndex));
            if parentPosition >= 0 {
                var duplicateIndex =
                    ObjectIndexWithId(duplicateIds.get(sourceIndex));
                var duplicateParent = ObjectIndexWithId(
                    duplicateIds.get(parentPosition));
                if duplicateIndex < 0 or duplicateParent < 0
                   or scene.TrySetObjectParent(
                          duplicateIndex, duplicateParent) == false {
                    selectedObjects = previousSelection;
                    selectedObject = previousPrimary;
                    RestoreSceneSnapshot(snapshot);
                    detailLabel.SetText(
                        "The selected hierarchy could not be duplicated. "
                        + "No objects were changed.");
                    return 0;
                }
            }
            sourceIndex = sourceIndex + 1;
        }

        var duplicates: List[Integer] = [];
        var nextPrimary = -1;
        var objectIndex = 0;
        while objectIndex < scene.ObjectCount() {
            var candidateId = scene.ObjectId(objectIndex);
            var idIndex = 0;
            while idIndex < duplicateIds.count() {
                if candidateId == duplicateIds.get(idIndex) {
                    duplicates.add(objectIndex);
                    if candidateId == primaryDuplicateId {
                        nextPrimary = objectIndex;
                    }
                    break;
                }
                idIndex = idIndex + 1;
            }
            objectIndex = objectIndex + 1;
        }
        if nextPrimary < 0 and duplicates.count() > 0 {
            nextPrimary = duplicates.get(0);
        }
        selectedObjects = duplicates;
        selectedObject = nextPrimary;
        selectedObjectProperty = -1;
        var count = duplicates.count();
        var message = "Duplicated " + count + " objects";
        if count == 1 { message = "Duplicated scene object"; }
        if count == 0 or CommitScene(message) == false {
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The selected objects could not be committed.");
            return 0;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return count;
    }

    /// @brief Remove every selected object in one descending-index transaction.
    expose func RemoveSelectedSceneObjects() -> Boolean {
        if scene == null { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var count = selectedObjects.count();
        if count == 0 { return false; }

        var snapshot = currentSerialized;
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var firstRemoved = scene.ObjectCount();
        var index = scene.ObjectCount() - 1;
        while index >= 0 {
            if scene_selection.Contains(selectedObjects, index) {
                if index < firstRemoved { firstRemoved = index; }
                scene.RemoveObject(index);
            }
            index = index - 1;
        }

        var remaining = scene.ObjectCount();
        selectedObject = firstRemoved;
        if selectedObject >= remaining { selectedObject = remaining - 1; }
        selectedObjects = scene_selection.Single(selectedObject, remaining);
        selectedObjectProperty = -1;
        var message = "Removed " + count + " objects";
        if count == 1 { message = "Removed object"; }
        if CommitScene(message) == false {
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The selected objects could not be removed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Translate every selected object by one pixel delta and commit once.
    expose func TranslateSelectedSceneObjects(deltaX: Integer,
                                              deltaY: Integer) -> Boolean {
        if scene == null or (deltaX == 0 and deltaY == 0) {
            return false;
        }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if selectedObjects.count() == 0 { return false; }
        var snapshot = currentSerialized;
        if TranslateSelectedObjectsUncommitted(deltaX, deltaY) == false {
            return false;
        }
        var count = selectedObjects.count();
        var message = "Moved " + count + " objects";
        if count == 1 { message = "Moved scene object"; }
        if CommitScene(message) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The selected object move could not be committed.");
            return false;
        }
        RefreshInspector();
        return true;
    }

    /// @brief Apply one group delta without creating an intermediate history row.
    hide func TranslateSelectedObjectsUncommitted(deltaX: Integer,
                                                  deltaY: Integer) -> Boolean {
        if scene == null or (deltaX == 0 and deltaY == 0) {
            return false;
        }
        var changed = false;
        var selectionIndex = 0;
        while selectionIndex < selectedObjects.count() {
            var objectIndex = selectedObjects.get(selectionIndex);
            if objectIndex >= 0 and objectIndex < scene.ObjectCount() {
                scene.SetObjectPosition(
                    objectIndex,
                    scene.ObjectX(objectIndex) + deltaX,
                    scene.ObjectY(objectIndex) + deltaY);
                changed = true;
            }
            selectionIndex = selectionIndex + 1;
        }
        if changed { renderDirty = true; }
        return changed;
    }

    /// @brief Align or distribute the selected authored point positions once.
    /// @details Align uses selectedObject as the explicit anchor. Distribution
    ///          leaves both extrema fixed and deterministically rounds every
    ///          intermediate integer position. Rejected/no-op layouts do not
    ///          create history.
    expose func ArrangeSelectedSceneObjects(operation: Integer) -> Boolean {
        if scene == null or scene_layout_2d.IsOperation(operation) == false {
            return false;
        }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var minimum = scene_layout_2d.MinimumSelection(operation);
        if selectedObjects.count() < minimum
           or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            detailLabel.SetText(
                scene_layout_2d.OperationLabel(operation)
                + " needs at least " + minimum + " selected objects.");
            return false;
        }

        var snapshot = currentSerialized;
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var useX = scene_layout_2d.UsesX(operation);
        var changed = false;
        if scene_layout_2d.IsDistribution(operation) {
            var ordered = scene_layout_2d.OrderedIndices(
                scene, selectedObjects, useX);
            if ordered.count() < minimum { return false; }
            var minimumCoordinate = scene_layout_2d.Coordinate(
                scene, ordered.get(0), useX);
            var maximumCoordinate = scene_layout_2d.Coordinate(
                scene, ordered.get(ordered.count() - 1), useX);
            var position = 0;
            while position < ordered.count() {
                var objectIndex = ordered.get(position);
                var target = scene_layout_2d.DistributedCoordinate(
                    minimumCoordinate,
                    maximumCoordinate,
                    position,
                    ordered.count());
                var current = scene_layout_2d.Coordinate(
                    scene, objectIndex, useX);
                if current != target {
                    if useX {
                        scene.SetObjectPosition(
                            objectIndex, target, scene.ObjectY(objectIndex));
                    } else {
                        scene.SetObjectPosition(
                            objectIndex, scene.ObjectX(objectIndex), target);
                    }
                    changed = true;
                }
                position = position + 1;
            }
        } else {
            var anchor = scene_layout_2d.Coordinate(
                scene, selectedObject, useX);
            var selectionIndex = 0;
            while selectionIndex < selectedObjects.count() {
                var objectIndex = selectedObjects.get(selectionIndex);
                var current = scene_layout_2d.Coordinate(
                    scene, objectIndex, useX);
                if current != anchor {
                    if useX {
                        scene.SetObjectPosition(
                            objectIndex, anchor, scene.ObjectY(objectIndex));
                    } else {
                        scene.SetObjectPosition(
                            objectIndex, scene.ObjectX(objectIndex), anchor);
                    }
                    changed = true;
                }
                selectionIndex = selectionIndex + 1;
            }
        }

        if changed == false {
            detailLabel.SetText(
                "The selection already satisfies "
                + scene_layout_2d.OperationLabel(operation) + ".");
            return false;
        }
        var message = scene_layout_2d.OperationLabel(operation)
            + " (" + selectedObjects.count() + " objects)";
        if CommitScene(message) == false {
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The selected object layout could not be committed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Move one object to an explicit draw-order index.
    expose func MoveSceneObject(index: Integer, target: Integer) -> Boolean {
        if scene == null or index < 0 or target < 0
           or index >= scene.ObjectCount() or target >= scene.ObjectCount()
           or index == target {
            return false;
        }
        scene.MoveObject(index, target);
        selectedObject = target;
        selectedObjects = scene_selection.Single(
            target, scene.ObjectCount());
        if CommitScene("Changed object draw order") == false {
            scene.MoveObject(target, index);
            selectedObject = index;
            selectedObjects = scene_selection.Single(
                index, scene.ObjectCount());
            detailLabel.SetText("The object order change could not be committed.");
            RefreshInspector();
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Author one object's editor-only tile-layer/priority overrides.
    /// @details The pair commits atomically through ordinary typed properties;
    ///          games remain free to ignore the editor namespace.
    expose func SetObjectPreviewStackOverride(
        objectIndex: Integer,
        afterLayer: Integer,
        drawOrder: Integer) -> Boolean {
        if scene == null or objectIndex < 0
           or objectIndex >= scene.ObjectCount()
           or afterLayer
                < scene_component_schema.MIN_PREVIEW_AFTER_LAYER
           or afterLayer
                > scene_component_schema.MAX_PREVIEW_AFTER_LAYER
           or drawOrder
                < scene_component_schema.MIN_PREVIEW_DRAW_ORDER
           or drawOrder
                > scene_component_schema.MAX_PREVIEW_DRAW_ORDER {
            return false;
        }
        var hasLayer = scene.ObjectPropertyKind(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY) != "";
        var hasOrder = scene.ObjectPropertyKind(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY) != "";
        var requestedBoundary = afterLayer + 1;
        if requestedBoundary < 0 { requestedBoundary = 0; }
        if requestedBoundary > scene.LayerCount() {
            requestedBoundary = scene.LayerCount();
        }
        var currentBoundary =
            scene_object_draw_stack_2d.LayerBoundary(
                scene, componentSchema, objectIndex);
        if hasLayer == false and hasOrder == false
           and requestedBoundary == currentBoundary
           and drawOrder == ObjectPreviewDrawOrder(objectIndex) {
            detailLabel.SetText(
                "The object already inherits that preview draw stack.");
            return false;
        }
        if hasLayer and hasOrder
           and scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY) == "int"
           and scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY) == "int"
           and scene.ObjectGetInt(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY,
               afterLayer - 1) == afterLayer
           and scene.ObjectGetInt(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY,
               drawOrder - 1) == drawOrder {
            detailLabel.SetText(
                "The object preview draw stack is already up to date.");
            return false;
        }

        var snapshot = scene.ToJson();
        scene.ObjectSetInt(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY,
            afterLayer);
        scene.ObjectSetInt(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY,
            drawOrder);
        if scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY) != "int"
           or scene.ObjectGetInt(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY,
               afterLayer - 1) != afterLayer
           or scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY) != "int"
           or scene.ObjectGetInt(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY,
               drawOrder - 1) != drawOrder {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene rejected the preview stack. Object properties "
                + "may be at capacity.");
            return false;
        }
        selectedObject = objectIndex;
        selectedObjects = scene_selection.Single(
            objectIndex, scene.ObjectCount());
        if CommitScene("Updated object preview draw stack") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Remove one object's preview-stack overrides atomically.
    expose func ClearObjectPreviewStackOverride(
        objectIndex: Integer) -> Boolean {
        if scene == null or objectIndex < 0
           or objectIndex >= scene.ObjectCount() {
            return false;
        }
        var layerKind = scene.ObjectPropertyKind(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY);
        var orderKind = scene.ObjectPropertyKind(
            objectIndex,
            scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY);
        if layerKind == "" and orderKind == "" { return false; }
        var snapshot = scene.ToJson();
        if layerKind != "" {
            scene.ObjectRemove(
                objectIndex,
                scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY);
        }
        if orderKind != "" {
            scene.ObjectRemove(
                objectIndex,
                scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY);
        }
        if scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY) != ""
           or scene.ObjectPropertyKind(
               objectIndex,
               scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY) != "" {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene rejected the preview-stack reset.");
            return false;
        }
        selectedObject = objectIndex;
        selectedObjects = scene_selection.Single(
            objectIndex, scene.ObjectCount());
        if CommitScene("Reset object preview draw stack") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    hide func IntegerIndexOf(values: List[Integer],
                             value: Integer) -> Integer {
        var index = 0;
        while index < values.count() {
            if values.get(index) == value { return index; }
            index = index + 1;
        }
        return -1;
    }

    hide func IntegerListsEqual(left: List[Integer],
                                right: List[Integer]) -> Boolean {
        if left.count() != right.count() { return false; }
        var index = 0;
        while index < left.count() {
            if left.get(index) != right.get(index) { return false; }
            index = index + 1;
        }
        return true;
    }

    hide func SnapshotObjectParents() -> List[Integer] {
        var parents: List[Integer] = [];
        if scene == null { return parents; }
        var index = 0;
        while index < scene.ObjectCount() {
            parents.add(scene.ObjectParent(index));
            index = index + 1;
        }
        return parents;
    }

    /// @brief Classify every identity by the selected root that contains it.
    /// @details Memoized parent walks keep hierarchy edits linear even near the
    ///          SceneDocument object limit.
    hide func SelectedRootOwners(parents: List[Integer],
                                 roots: List[Integer])
        -> List[Integer] {
        var owners: List[Integer] = [];
        var index = 0;
        while index < parents.count() {
            owners.add(-2);
            index = index + 1;
        }
        index = 0;
        while index < roots.count() {
            var rootIdentity = roots.get(index);
            if rootIdentity >= 0 and rootIdentity < owners.count() {
                owners.set(rootIdentity, rootIdentity);
            }
            index = index + 1;
        }

        var start = 0;
        while start < parents.count() {
            if owners.get(start) == -2 {
                var path: List[Integer] = [];
                var current = start;
                var steps = 0;
                while current >= 0 and current < parents.count()
                      and owners.get(current) == -2
                      and steps <= parents.count() {
                    path.add(current);
                    current = parents.get(current);
                    steps = steps + 1;
                }
                var owner = -1;
                if current >= 0 and current < owners.count() {
                    owner = owners.get(current);
                }
                var pathIndex = path.count() - 1;
                while pathIndex >= 0 {
                    owners.set(path.get(pathIndex), owner);
                    pathIndex = pathIndex - 1;
                }
            }
            start = start + 1;
        }
        return owners;
    }

    /// @brief Compute every absolute depth with memoized parent walks.
    hide func IdentityDepths(parents: List[Integer]) -> List[Integer] {
        var depths: List[Integer] = [];
        var index = 0;
        while index < parents.count() {
            var depth = -1;
            if parents.get(index) < 0 { depth = 0; }
            depths.add(depth);
            index = index + 1;
        }
        var start = 0;
        while start < parents.count() {
            if depths.get(start) < 0 {
                var path: List[Integer] = [];
                var current = start;
                var steps = 0;
                while current >= 0 and current < parents.count()
                      and depths.get(current) < 0
                      and steps <= parents.count() {
                    path.add(current);
                    current = parents.get(current);
                    steps = steps + 1;
                }
                var depth = -1;
                if current >= 0 and current < depths.count() {
                    depth = depths.get(current);
                }
                var pathIndex = path.count() - 1;
                while pathIndex >= 0 {
                    depth = depth + 1;
                    depths.set(path.get(pathIndex), depth);
                    pathIndex = pathIndex - 1;
                }
            }
            start = start + 1;
        }
        return depths;
    }

    /// @brief Normalize selected hierarchy roots into current draw order.
    hide func TopLevelSelectedObjectRoots(
        parents: List[Integer]) -> List[Integer] {
        var roots: List[Integer] = [];
        var candidate = 0;
        while candidate < parents.count() {
            if scene_selection.Contains(selectedObjects, candidate) {
                var nested = false;
                var ancestor = parents.get(candidate);
                var steps = 0;
                while ancestor >= 0 and steps <= parents.count() {
                    if scene_selection.Contains(
                           selectedObjects, ancestor) {
                        nested = true;
                        break;
                    }
                    ancestor = parents.get(ancestor);
                    steps = steps + 1;
                }
                if nested == false { roots.add(candidate); }
            }
            candidate = candidate + 1;
        }
        return roots;
    }

    hide func MovingObjectIdentities(owners: List[Integer])
        -> List[Integer] {
        var moving: List[Integer] = [];
        var candidate = 0;
        while candidate < owners.count() {
            if owners.get(candidate) >= 0 { moving.add(candidate); }
            candidate = candidate + 1;
        }
        return moving;
    }

    hide func ObjectDropFitsDepth(destinationParent: Integer,
                                  parents: List[Integer],
                                  owners: List[Integer]) -> Boolean {
        var depths = IdentityDepths(parents);
        return ObjectDropFitsKnownDepths(
            destinationParent, depths, owners);
    }

    /// @brief Check a target using one shared depth snapshot.
    /// @details Parent-picker refresh calls this for many candidates and must
    ///          not repeat a complete hierarchy walk for every dropdown row.
    hide func ObjectDropFitsKnownDepths(
        destinationParent: Integer,
        depths: List[Integer],
        owners: List[Integer]) -> Boolean {
        var rootDepth = 0;
        if destinationParent >= 0 {
            rootDepth = depths.get(destinationParent) + 1;
        }
        var identity = 0;
        while identity < owners.count() {
            var owner = owners.get(identity);
            if owner >= 0
               and rootDepth + depths.get(identity) - depths.get(owner)
                  > MAX_OBJECT_HIERARCHY_DEPTH {
                return false;
            }
            identity = identity + 1;
        }
        return true;
    }

    /// @brief Move selected top-level subtrees beneath one explicit parent.
    /// @param targetParent Object index, or -1 for the scene root.
    /// @details This is the keyboard-accessible counterpart to an INTO row
    ///          drop. Reparenting to the scene root appends after the last
    ///          remaining root. Absolute object coordinates are unchanged.
    expose func ReparentSelectedSceneObjects(
        targetParent: Integer) -> Boolean {
        if scene == null or targetParent < -1
           or targetParent >= scene.ObjectCount() {
            return false;
        }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var parents = SnapshotObjectParents();
        var roots = TopLevelSelectedObjectRoots(parents);
        if roots.count() == 0 { return false; }
        var owners = SelectedRootOwners(parents, roots);
        var moving = MovingObjectIdentities(owners);
        if targetParent >= 0
           and scene_selection.Contains(moving, targetParent) {
            detailLabel.SetText(
                "An object cannot be parented to itself or one of its descendants.");
            return false;
        }
        if ObjectDropFitsDepth(
               targetParent, parents, owners) == false {
            detailLabel.SetText(
                "That parent would exceed Studio's hierarchy depth limit.");
            return false;
        }

        var alreadyParented = true;
        var rootIndex = 0;
        while rootIndex < roots.count() {
            if parents.get(roots.get(rootIndex)) != targetParent {
                alreadyParented = false;
            }
            rootIndex = rootIndex + 1;
        }
        if alreadyParented {
            detailLabel.SetText(
                "The selected object subtrees already use that parent.");
            return false;
        }

        var source = roots.get(0);
        if targetParent >= 0 {
            return ApplyObjectHierarchyDrop(source, targetParent, 1);
        }

        var lastRemainingRoot = -1;
        var candidate = 0;
        while candidate < parents.count() {
            if parents.get(candidate) < 0
               and scene_selection.Contains(moving, candidate) == false {
                lastRemainingRoot = candidate;
            }
            candidate = candidate + 1;
        }
        if lastRemainingRoot < 0 {
            detailLabel.SetText(
                "Studio could not find an attached scene-root destination.");
            return false;
        }
        var changed =
            ApplyObjectHierarchyDrop(source, lastRemainingRoot, 2);
        if changed {
            toolbarStatus.SetText(
                "Reparented " + roots.count()
                + " object subtree(s) to scene root");
        }
        return changed;
    }

    /// @brief Apply one retained TreeView row drop as a canonical transaction.
    /// @details Selected top-level roots carry their complete subtrees.
    ///          BEFORE/AFTER use the target's parent; INTO appends beneath the
    ///          target. Every identity and parent index is remapped exactly.
    expose func ApplyObjectHierarchyDrop(sourceIndex: Integer,
                                         targetIndex: Integer,
                                         position: Integer) -> Boolean {
        if scene == null or currentDoc == null
           or sourceIndex < 0 or sourceIndex >= scene.ObjectCount()
           or targetIndex < 0 or targetIndex >= scene.ObjectCount()
           or position < 0 or position > 2 {
            return false;
        }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if scene_selection.Contains(selectedObjects, sourceIndex) == false {
            var sourceOnly = scene_selection.Single(
                sourceIndex, scene.ObjectCount());
            SelectSceneObjects(sourceOnly, sourceIndex);
        }

        var parents = SnapshotObjectParents();
        var roots = TopLevelSelectedObjectRoots(parents);
        var owners = SelectedRootOwners(parents, roots);
        var moving = MovingObjectIdentities(owners);
        if roots.count() == 0
           or scene_selection.Contains(moving, targetIndex) {
            detailLabel.SetText(
                "Drop onto a row outside the selected object subtrees.");
            return false;
        }

        var destinationParent = parents.get(targetIndex);
        if position == 1 {
            destinationParent = targetIndex;
        }
        if ObjectDropFitsDepth(
               destinationParent, parents, owners) == false {
            detailLabel.SetText(
                "That row drop would exceed Studio's hierarchy depth limit.");
            return false;
        }

        var remaining: List[Integer] = [];
        var identityOrder: List[Integer] = [];
        var identity = 0;
        while identity < parents.count() {
            identityOrder.add(identity);
            if scene_selection.Contains(moving, identity) == false {
                remaining.add(identity);
            }
            identity = identity + 1;
        }

        var insertion = -1;
        if position == 0 {
            insertion = IntegerIndexOf(remaining, targetIndex);
        } else {
            var targetRoots: List[Integer] = [];
            targetRoots.add(targetIndex);
            var targetOwners =
                SelectedRootOwners(parents, targetRoots);
            var remainingIndex = 0;
            while remainingIndex < remaining.count() {
                if targetOwners.get(
                       remaining.get(remainingIndex)) == targetIndex {
                    insertion = remainingIndex + 1;
                }
                remainingIndex = remainingIndex + 1;
            }
        }
        if insertion < 0 or insertion > remaining.count() {
            detailLabel.SetText(
                "The hierarchy drop target is no longer attached.");
            return false;
        }

        var desired = remaining;
        var movingIndex = 0;
        while movingIndex < moving.count() {
            desired.insert(
                insertion + movingIndex, moving.get(movingIndex));
            movingIndex = movingIndex + 1;
        }

        var parentAlreadyExact = true;
        var rootIndex = 0;
        while rootIndex < roots.count() {
            if parents.get(roots.get(rootIndex)) != destinationParent {
                parentAlreadyExact = false;
            }
            rootIndex = rootIndex + 1;
        }
        if parentAlreadyExact
           and IntegerListsEqual(identityOrder, desired) {
            detailLabel.SetText(
                "The selected object subtrees already use that row position.");
            return false;
        }

        var snapshot = currentSerialized;
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var currentOrder = identityOrder;
        var destination = 0;
        while destination < desired.count() {
            var desiredIdentity = desired.get(destination);
            var current = IntegerIndexOf(
                currentOrder, desiredIdentity);
            if current < 0 {
                RestoreSceneSnapshot(snapshot);
                selectedObjects = previousSelection;
                selectedObject = previousPrimary;
                RefreshInspector();
                detailLabel.SetText(
                    "Studio lost an object identity while reordering.");
                return false;
            }
            if current != destination {
                scene.MoveObject(current, destination);
                currentOrder.removeAt(current);
                currentOrder.insert(destination, desiredIdentity);
            }
            destination = destination + 1;
        }

        var destinationParentIndex = -1;
        if destinationParent >= 0 {
            destinationParentIndex =
                IntegerIndexOf(desired, destinationParent);
        }
        rootIndex = 0;
        while rootIndex < roots.count() {
            var nextRoot = IntegerIndexOf(
                desired, roots.get(rootIndex));
            if nextRoot < 0
               or scene.TrySetObjectParent(
                      nextRoot, destinationParentIndex) == false {
                RestoreSceneSnapshot(snapshot);
                selectedObjects = previousSelection;
                selectedObject = previousPrimary;
                RefreshInspector();
                detailLabel.SetText(
                    "The scene model rejected the hierarchy change.");
                return false;
            }
            rootIndex = rootIndex + 1;
        }

        var nextSelection: List[Integer] = [];
        var selectionIndex = 0;
        while selectionIndex < previousSelection.count() {
            var mapped = IntegerIndexOf(
                desired, previousSelection.get(selectionIndex));
            if mapped >= 0 { nextSelection.add(mapped); }
            selectionIndex = selectionIndex + 1;
        }
        var nextPrimary = IntegerIndexOf(desired, previousPrimary);
        if nextPrimary < 0 and nextSelection.count() > 0 {
            nextPrimary = nextSelection.get(0);
        }
        selectedObjects = nextSelection;
        selectedObject = nextPrimary;
        selectedObjectProperty = -1;

        var action = "Moved " + roots.count()
            + " object subtree(s)";
        if position == 1 {
            action = "Reparented " + roots.count()
                + " object subtree(s)";
        }
        if CommitScene(action) == false {
            RestoreSceneSnapshot(snapshot);
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            RefreshInspector();
            detailLabel.SetText(
                "The hierarchy edit could not be committed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        CaptureWorkspaceState();
        return true;
    }

    hide func PreviousObjectSibling(index: Integer) -> Integer {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return -1;
        }
        var parent = scene.ObjectParent(index);
        var sibling = -1;
        var candidate = 0;
        while candidate < index {
            if scene.ObjectParent(candidate) == parent {
                sibling = candidate;
            }
            candidate = candidate + 1;
        }
        return sibling;
    }

    hide func NextObjectSibling(index: Integer) -> Integer {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return -1;
        }
        var parent = scene.ObjectParent(index);
        var candidate = index + 1;
        while candidate < scene.ObjectCount() {
            if scene.ObjectParent(candidate) == parent { return candidate; }
            candidate = candidate + 1;
        }
        return -1;
    }

    /// @brief Create, rename, or update one typed scene property transactionally.
    expose func SetSceneProperty(previousKey: String,
                                 key: String,
                                 kind: String,
                                 value: String) -> Boolean {
        if scene == null { return false; }
        var nextKey = Str.Trim(key);
        if nextKey == "" {
            detailLabel.SetText("Scene property key cannot be empty.");
            return false;
        }
        if previousKey != "" and scene.Has(previousKey) == false {
            detailLabel.SetText(
                "The selected scene property no longer exists.");
            return false;
        }
        if previousKey != nextKey and scene.Has(nextKey) {
            detailLabel.SetText(
                "Scene property \"" + nextKey + "\" already exists.");
            return false;
        }

        var snapshot = scene.ToJson();
        var intValue = 0;
        var floatValue = 0.0;
        var boolValue = false;
        if kind == "string" {
            scene.SetStr(nextKey, value);
        } else if kind == "int" {
            var parsedInt = Parse.TryInt(Str.Trim(value));
            if parsedInt.IsNone {
                detailLabel.SetText("Enter a valid whole number.");
                return false;
            }
            intValue = parsedInt.UnwrapI64();
            scene.SetInt(nextKey, intValue);
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(Str.Trim(value));
            if parsedFloat.IsNone {
                detailLabel.SetText("Enter a valid finite number.");
                return false;
            }
            floatValue = parsedFloat.UnwrapF64();
            scene.SetFloat(nextKey, floatValue);
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(Str.Trim(value));
            if parsedBool.IsNone {
                detailLabel.SetText(
                    "Enter true/false, yes/no, on/off, or 1/0.");
                return false;
            }
            boolValue = parsedBool.UnwrapI1();
            scene.SetBool(nextKey, boolValue);
        } else if kind == "null" {
            scene.SetNull(nextKey);
        } else {
            detailLabel.SetText("Choose a supported scene property type.");
            return false;
        }

        if ScenePropertyMatches(
               nextKey, kind, value, intValue, floatValue, boolValue) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene property was rejected. Keys are limited to "
                + "128 bytes and string values to 64 KiB.");
            return false;
        }
        if previousKey != "" and previousKey != nextKey {
            scene.Remove(previousKey);
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Scene property is already up to date.");
            return false;
        }
        if CommitScene("Updated scene property " + nextKey) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene property update could not be committed.");
            return false;
        }

        detailLabel.SetText("");
        RefreshInspector();
        sceneProperties.SelectByKey(nextKey);
        selectedSceneProperty = sceneProperties.selectedProperty;
        return true;
    }

    /// @brief Remove one typed scene property through canonical history.
    expose func RemoveSceneProperty(key: String) -> Boolean {
        if scene == null { return false; }
        var nextKey = Str.Trim(key);
        if nextKey == "" or scene.Has(nextKey) == false { return false; }
        var snapshot = scene.ToJson();
        scene.Remove(nextKey);
        if scene.Has(nextKey) {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene model rejected the property removal.");
            return false;
        }
        if CommitScene("Removed scene property " + nextKey) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene property removal could not be committed.");
            return false;
        }
        detailLabel.SetText("");
        selectedSceneProperty = -1;
        RefreshInspector();
        return true;
    }

    /// @brief Route tile-behavior inspector intents into canonical history.
    hide func PumpTileBehaviorControls() -> Boolean {
        if scene == null or tileBehavior == null { return false; }
        tileBehavior.Pump(scene);
        var tile = Convert.NumToInt(tileSpinner.Value);
        var changed = false;
        if tileBehavior.TakeAutotilePreviewChanged() {
            SetAutotilePreviewEnabled(
                tileBehavior.AutotilePreviewEnabled());
        }
        var collisionKind = tileBehavior.TakeCollisionKind();
        if collisionKind >= 0 {
            changed = SetTileBehaviorCollision(tile, collisionKind) or changed;
        }
        if tileBehavior.TakePropertySetRequested() {
            changed = SetTileBehaviorProperty(
                tile,
                tileBehavior.propertyKeyInput.Text,
                tileBehavior.SelectedPropertyKind(),
                tileBehavior.propertyValueInput.Text) or changed;
        }
        if tileBehavior.TakePropertyRemoveRequested() {
            changed = RemoveTileBehaviorProperty(
                tile, tileBehavior.SelectedPropertyKey()) or changed;
        }
        if tileBehavior.TakeAnimSetRequested() {
            changed = SetTileBehaviorAnim(
                tile,
                tileBehavior.animFramesInput.Text,
                tileBehavior.animDurationsInput.Text) or changed;
        }
        if tileBehavior.TakeAnimClearRequested() {
            changed = ClearTileBehaviorAnim(tile) or changed;
        }
        if tileBehavior.TakeAutotileSetRequested() {
            changed = SetTileBehaviorAutotile(
                tile, tileBehavior.autotileInput.Text) or changed;
        }
        if tileBehavior.TakeAutotileClearRequested() {
            changed = ClearTileBehaviorAutotile(tile) or changed;
        }
        return changed;
    }

    /// @brief Author one tile's collision kind through canonical history.
    expose func SetTileBehaviorCollision(tile: Integer,
                                         kind: Integer) -> Boolean {
        if scene == null { return false; }
        if TileBehaviorTileValid(tile) == false { return false; }
        if kind < 0 or kind > 2 {
            detailLabel.SetText("Collision kind must be 0, 1, or 2.");
            return false;
        }
        var snapshot = scene.ToJson();
        scene.SetTileCollision(tile, kind);
        if scene.TileCollision(tile) != kind {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The scene model rejected the collision edit.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Tile collision is already up to date.");
            return false;
        }
        if CommitScene("Updated collision for tile " + tile) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Author one typed tile property through canonical history.
    expose func SetTileBehaviorProperty(tile: Integer,
                                        key: String,
                                        kind: String,
                                        value: String) -> Boolean {
        if scene == null { return false; }
        if TileBehaviorTileValid(tile) == false { return false; }
        var nextKey = Str.Trim(key);
        if nextKey == "" {
            detailLabel.SetText("Enter a tile property key.");
            return false;
        }
        var snapshot = scene.ToJson();
        if kind == "bool" {
            var parsedBool = Parse.TryBool(Str.Trim(value));
            if parsedBool.IsNone {
                detailLabel.SetText(
                    "Enter true/false, yes/no, on/off, or 1/0.");
                return false;
            }
            scene.SetTilePropertyBool(tile, nextKey, parsedBool.UnwrapI1());
        } else {
            var parsedInt = Parse.TryInt(Str.Trim(value));
            if parsedInt.IsNone {
                detailLabel.SetText("Enter a valid whole number.");
                return false;
            }
            scene.SetTilePropertyInt(tile, nextKey, parsedInt.UnwrapI64());
        }
        if scene.TilePropertyKind(tile, nextKey) != kind {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The tile property was rejected. Keys are limited to 128 "
                + "bytes, 64 properties per tile, and 4,096 per scene.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Tile property is already up to date.");
            return false;
        }
        if CommitScene("Updated tile " + tile + " property " + nextKey)
           == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Remove one typed tile property through canonical history.
    expose func RemoveTileBehaviorProperty(tile: Integer,
                                           key: String) -> Boolean {
        if scene == null or key == "" { return false; }
        if scene.TilePropertyKind(tile, key) == "" { return false; }
        var snapshot = scene.ToJson();
        scene.RemoveTileProperty(tile, key);
        if scene.TilePropertyKind(tile, key) != "" {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene model rejected the tile property removal.");
            return false;
        }
        if CommitScene("Removed tile " + tile + " property " + key) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Author one per-frame tile animation through canonical history.
    expose func SetTileBehaviorAnim(tile: Integer,
                                    framesCsv: String,
                                    durationsCsv: String) -> Boolean {
        if scene == null { return false; }
        if TileBehaviorTileValid(tile) == false { return false; }
        var frames = ParseCsvIntegers(framesCsv);
        var durations = ParseCsvIntegers(durationsCsv);
        if frames == null or durations == null
           or Seq.get_Count(frames) == 0
           or Seq.get_Count(frames) != Seq.get_Count(durations) {
            detailLabel.SetText(
                "Enter matching comma-separated frame ids and positive "
                + "durations.");
            return false;
        }
        var snapshot = scene.ToJson();
        scene.SetTileAnim(tile, frames, durations);
        if Seq.get_Count(scene.TileAnimFrames(tile))
           != Seq.get_Count(frames) {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The scene model rejected the animation. Use 1 to 4,096 "
                + "frames with positive millisecond durations.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Tile animation is already up to date.");
            return false;
        }
        if CommitScene("Updated animation for tile " + tile) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Remove one tile animation through canonical history.
    expose func ClearTileBehaviorAnim(tile: Integer) -> Boolean {
        if scene == null { return false; }
        if Seq.get_Count(scene.TileAnimFrames(tile)) == 0 { return false; }
        var snapshot = scene.ToJson();
        scene.RemoveTileAnim(tile);
        if CommitScene("Removed animation for tile " + tile) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Author one 16-variant autotile rule through canonical history.
    expose func SetTileBehaviorAutotile(tile: Integer,
                                        variantsCsv: String) -> Boolean {
        if scene == null { return false; }
        if TileBehaviorTileValid(tile) == false { return false; }
        var variants = ParseCsvIntegers(variantsCsv);
        if variants == null or Seq.get_Count(variants) != 16 {
            detailLabel.SetText(
                "Enter exactly 16 comma-separated variant tile ids.");
            return false;
        }
        var snapshot = scene.ToJson();
        scene.SetAutotileRule(tile, variants);
        if Seq.get_Count(scene.AutotileVariants(tile)) != 16 {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The scene model rejected the autotile rule.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Autotile rule is already up to date.");
            return false;
        }
        if CommitScene("Updated autotile rule for tile " + tile) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        RefreshAutotilePreviewRules();
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Remove one autotile rule through canonical history.
    expose func ClearTileBehaviorAutotile(tile: Integer) -> Boolean {
        if scene == null { return false; }
        if Seq.get_Count(scene.AutotileVariants(tile)) == 0 { return false; }
        var snapshot = scene.ToJson();
        scene.RemoveAutotileRule(tile);
        if CommitScene("Removed autotile rule for tile " + tile) == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        RefreshAutotilePreviewRules();
        detailLabel.SetText("");
        RefreshTilesetPalette();
        return true;
    }

    /// @brief Draw one object's authored sprite frame, or return false.
    /// @details `editor.sprite` wins, then a loadable `sprite` property, per
    ///          ADR 0179. Resolution shares the layer-image budgets and never
    ///          mutates scene content, history, revision, or dirty state.
    hide func DrawObjectSpritePreview(objectIndex: Integer,
                                      x: Integer,
                                      y: Integer) -> Boolean {
        var path = ObjectSpritePath(objectIndex);
        if path == "" { return false; }
        var frame = ObjectSpriteFrame(objectIndex);
        // Sprite-true rendering (ADR 0192): native frame size at the
        // current zoom with the object's full transform; the legacy
        // one-cell draw remains the bounded fallback.
        if tilesets.DrawSpriteFrameTransformed(
               framePixels, path, frame, x, y,
               displayCellSize, scene.TileWidth, scene.TileHeight,
               scene.ObjectScaleX(objectIndex),
               scene.ObjectScaleY(objectIndex),
               scene.ObjectRotation(objectIndex),
               scene.ObjectFlipX(objectIndex),
               scene.ObjectFlipY(objectIndex),
               scene.ObjectTint(objectIndex),
               scene.ObjectPivotX(objectIndex),
               scene.ObjectPivotY(objectIndex)) {
            return true;
        }
        return tilesets.DrawSpriteFrame(
            framePixels, path, frame, x, y, displayCellSize);
    }

    /// @brief Paint one effective draw-stack boundary's object sprite pixels.
    /// @details Stack order is boundary/priority/document order. This pass
    ///          records successful image draws so the later editor-overlay
    ///          pass can add markers only for objects without renderable art.
    /// @return The first stack cursor belonging to a later boundary.
    hide func DrawObjectSpritesAtBoundary(
        stack: List[Integer],
        spriteDrawn: List[Integer],
        startCursor: Integer,
        boundary: Integer,
        windowWidth: Integer,
        windowHeight: Integer) -> Integer {
        var cursor = startCursor;
        while cursor < stack.count() {
            var objectIndex = stack.get(cursor);
            var objectBoundary =
                scene_object_draw_stack_2d.LayerBoundary(
                    scene, componentSchema, objectIndex);
            if objectBoundary > boundary { return cursor; }
            if objectBoundary == boundary {
                var objectX =
                    scene.ObjectX(objectIndex) * displayCellSize
                    / scene.TileWidth - viewOriginX;
                var objectY =
                    scene.ObjectY(objectIndex) * displayCellSize
                    / scene.TileHeight - viewOriginY;
                var footprint = ObjectCanvasFootprint(objectIndex);
                var visible = true;
                if footprint.valid {
                    visible = footprint.maxX >= 0.0
                        and footprint.maxY >= 0.0
                        and footprint.minX < windowWidth
                        and footprint.minY < windowHeight;
                }
                if visible and DrawObjectSpritePreview(
                       objectIndex, objectX, objectY) {
                    spriteDrawn.set(objectIndex, 1);
                }
            }
            cursor = cursor + 1;
        }
        return cursor;
    }

    /// @brief Resolve one object's sprite reference (`editor.sprite` wins).
    hide func ObjectSpritePath(objectIndex: Integer) -> String {
        var path = Str.Trim(
            scene.ObjectGetStr(objectIndex, "editor.sprite", ""));
        if path != "" { return path; }
        path = Str.Trim(scene.ObjectGetStr(objectIndex, "sprite", ""));
        if path != "" { return path; }
        var preview = ProjectObjectPreview(objectIndex);
        if preview == null { return ""; }
        return preview.sprite;
    }

    /// @brief Resolve authored per-object frame before project profile fallback.
    hide func ObjectSpriteFrame(objectIndex: Integer) -> Integer {
        var explicitPath = Str.Trim(
            scene.ObjectGetStr(objectIndex, "editor.sprite", ""));
        if explicitPath == "" {
            explicitPath = Str.Trim(
                scene.ObjectGetStr(objectIndex, "sprite", ""));
        }
        if explicitPath != "" {
            return scene.ObjectGetInt(objectIndex, "editor.frame", 0);
        }
        var preview = ProjectObjectPreview(objectIndex);
        if preview == null or preview.frameProperty == "" {
            if preview != null { return preview.frame; }
            return 0;
        }
        if scene.ObjectPropertyKind(
               objectIndex, preview.frameProperty) != "int" {
            return preview.frame;
        }
        return preview.FrameForValue(
            scene.ObjectGetInt(
                objectIndex, preview.frameProperty, -1));
    }

    /// @brief Return the deterministic project rule for one object type.
    hide func ProjectObjectPreview(
        objectIndex: Integer)
        -> scene_component_schema.SceneObjectPreviewDefinition {
        if componentSchema == null or componentSchema.valid == false
           or scene == null or objectIndex < 0
           or objectIndex >= scene.ObjectCount() {
            return null;
        }
        return componentSchema.PreviewForObjectType(
            scene.ObjectType(objectIndex));
    }

    /// @brief Effective bounded object-preview priority (smaller paints first).
    expose func ObjectPreviewDrawOrder(objectIndex: Integer) -> Integer {
        return scene_object_draw_stack_2d.EffectiveDrawOrder(
            scene, componentSchema, objectIndex);
    }

    /// @brief Effective tile layer after which one object preview paints.
    expose func ObjectPreviewAfterLayer(objectIndex: Integer) -> Integer {
        return scene_object_draw_stack_2d.EffectiveAfterLayer(
            scene, componentSchema, objectIndex);
    }

    /// @brief Bottom-to-top visual object identities for rendering and picking.
    expose func ObjectPreviewStack() -> List[Integer] {
        return scene_object_draw_stack_2d.Build(
            scene, componentSchema);
    }

    /// @brief Resolve the active project-owned screen-space scene backdrop.
    /// @details A missing/wrong-typed variant key uses the declared fallback.
    hide func ProjectSceneBackground() -> String {
        if componentSchema == null or componentSchema.valid == false
           or scene == null or componentSchema.scenePreview2D == null
           or componentSchema.scenePreview2D.present == false {
            return "";
        }
        var profile = componentSchema.scenePreview2D;
        if profile.variantProperty == ""
           or scene.PropertyKind(profile.variantProperty) != "int" {
            return profile.background;
        }
        return profile.BackgroundForVariant(
            scene.GetInt(profile.variantProperty, 0));
    }

    /// @brief Composite the current project backdrop behind scene content.
    hide func DrawProjectSceneBackground() -> Boolean {
        var path = ProjectSceneBackground();
        if path == "" or componentSchema == null { return false; }
        if gameViewOutputFramed and framePixels != null {
            var width = GameOutputFrameWidthFor(
                framePixels.Width, framePixels.Height);
            var height = GameOutputFrameHeightFor(
                framePixels.Width, framePixels.Height);
            return tilesets.DrawSceneBackgroundRegion(
                framePixels,
                path,
                componentSchema.sourcePath,
                componentSchema.scenePreview2D.fit,
                GameOutputFrameXFor(
                    framePixels.Width, framePixels.Height),
                GameOutputFrameYFor(
                    framePixels.Width, framePixels.Height),
                width,
                height);
        }
        return tilesets.DrawSceneBackground(
            framePixels,
            path,
            componentSchema.sourcePath,
            componentSchema.scenePreview2D.fit);
    }

    /// @brief Cover pixels outside the exact project output with neutral matte.
    hide func DrawGameOutputMatte(width: Integer, height: Integer) {
        if gameViewOutputFramed == false or framePixels == null
           or width <= 0 or height <= 0 {
            return;
        }
        var frameX = GameOutputFrameXFor(width, height);
        var frameY = GameOutputFrameYFor(width, height);
        var frameWidth = GameOutputFrameWidthFor(width, height);
        var frameHeight = GameOutputFrameHeightFor(width, height);
        if frameY > 0 {
            framePixels.DrawBox(
                0, 0, width, frameY, GAME_VIEW_MATTE_COLOR);
        }
        var bottomY = frameY + frameHeight;
        if bottomY < height {
            framePixels.DrawBox(
                0, bottomY, width, height - bottomY,
                GAME_VIEW_MATTE_COLOR);
        }
        if frameX > 0 {
            framePixels.DrawBox(
                0, frameY, frameX, frameHeight,
                GAME_VIEW_MATTE_COLOR);
        }
        var rightX = frameX + frameWidth;
        if rightX < width {
            framePixels.DrawBox(
                rightX, frameY, width - rightX, frameHeight,
                GAME_VIEW_MATTE_COLOR);
        }
    }

    /// @brief Draw workspace-only polylines for route objects (ADR 0179).
    /// @details A route is an object of type `route`; its waypoints are its
    ///          direct children in sibling order. At most 256 waypoints per
    ///          route are drawn; the full list stays editable in the tree.
    hide func DrawRoutePolylines() {
        var routeIndex = 0;
        while routeIndex < scene.ObjectCount() {
            if scene.ObjectType(routeIndex) != "route" {
                routeIndex = routeIndex + 1;
                continue;
            }
            var lineColor = Color.RGB(120, 132, 150);
            if scene_selection.Contains(selectedObjects, routeIndex) {
                lineColor = Color.RGB(104, 220, 255);
            }
            var fromX = scene.ObjectX(routeIndex) * displayCellSize
                / scene.TileWidth + displayCellSize / 2 - viewOriginX;
            var fromY = scene.ObjectY(routeIndex) * displayCellSize
                / scene.TileHeight + displayCellSize / 2 - viewOriginY;
            var drawn = 0;
            var childIndex = 0;
            while childIndex < scene.ObjectCount() and drawn < 256 {
                if scene.ObjectParent(childIndex) == routeIndex {
                    var toX = scene.ObjectX(childIndex) * displayCellSize
                        / scene.TileWidth + displayCellSize / 2 - viewOriginX;
                    var toY = scene.ObjectY(childIndex) * displayCellSize
                        / scene.TileHeight + displayCellSize / 2 - viewOriginY;
                    framePixels.DrawLine(fromX, fromY, toX, toY, lineColor);
                    fromX = toX;
                    fromY = toY;
                    drawn = drawn + 1;
                }
                childIndex = childIndex + 1;
            }
            routeIndex = routeIndex + 1;
        }
    }

    /// @brief Report and reject behavior edits outside Tilemap's tile range.
    hide func TileBehaviorTileValid(tile: Integer) -> Boolean {
        if tile >= 1 and tile <= 4095 { return true; }
        detailLabel.SetText("Behavior applies to tile ids 1 through 4095.");
        return false;
    }

    /// @brief Route camera/lighting form intents into canonical history.
    hide func PumpCameraLightingControls() -> Boolean {
        if scene == null or cameraLighting == null { return false; }
        var changed = false;
        if cameraLighting.TakeCameraApplyRequested() {
            changed = ApplyCameraSection(
                cameraLighting.DraftCameraMode(),
                cameraLighting.cameraMinXInput.Text,
                cameraLighting.cameraMinYInput.Text,
                cameraLighting.cameraMaxXInput.Text,
                cameraLighting.cameraMaxYInput.Text,
                cameraLighting.cameraDeadzoneWidthInput.Text,
                cameraLighting.cameraDeadzoneHeightInput.Text,
                cameraLighting.cameraLerpInput.Text,
                cameraLighting.cameraZoomInput.Text) or changed;
        }
        if cameraLighting.TakeCameraClearRequested() {
            changed = ClearCameraSection() or changed;
        }
        if cameraLighting.TakeLightingApplyRequested() {
            changed = ApplyLightingSection(
                cameraLighting.lightingDarknessInput.Text,
                cameraLighting.lightingTintInput.Text,
                cameraLighting.lightingPlayerRadiusInput.Text,
                cameraLighting.lightingPlayerColorInput.Text) or changed;
        }
        if cameraLighting.TakeLightingClearRequested() {
            changed = ClearLightingSection() or changed;
        }
        return changed;
    }

    /// @brief Author the complete camera section as one history transaction.
    /// @details Blank drafts remove their field; bounds must be authored as a
    ///          complete group of four or left completely blank (ADR 0177).
    expose func ApplyCameraSection(mode: String,
                                   minX: String,
                                   minY: String,
                                   maxX: String,
                                   maxY: String,
                                   deadzoneWidth: String,
                                   deadzoneHeight: String,
                                   lerpPct: String,
                                   zoomPct: String) -> Boolean {
        if scene == null { return false; }
        var boundsFilled = 0;
        if Str.Trim(minX) != "" { boundsFilled = boundsFilled + 1; }
        if Str.Trim(minY) != "" { boundsFilled = boundsFilled + 1; }
        if Str.Trim(maxX) != "" { boundsFilled = boundsFilled + 1; }
        if Str.Trim(maxY) != "" { boundsFilled = boundsFilled + 1; }
        if boundsFilled != 0 and boundsFilled != 4 {
            detailLabel.SetText(
                "Camera bounds need all four values, or none.");
            return false;
        }
        var snapshot = scene.ToJson();
        if mode == "" {
            scene.CameraRemove("mode");
        } else {
            scene.CameraSetStr("mode", mode);
        }
        var applied = mode == "" or scene.CameraGetStr("mode", "") == mode;
        applied = applied and ApplyCameraIntField("minX", minX);
        applied = applied and ApplyCameraIntField("minY", minY);
        applied = applied and ApplyCameraIntField("maxX", maxX);
        applied = applied and ApplyCameraIntField("maxY", maxY);
        applied = applied
            and ApplyCameraIntField("deadzoneWidth", deadzoneWidth);
        applied = applied
            and ApplyCameraIntField("deadzoneHeight", deadzoneHeight);
        applied = applied and ApplyCameraIntField("followLerpPct", lerpPct);
        applied = applied and ApplyCameraIntField("zoomPct", zoomPct);
        if applied == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The camera settings were rejected. Check the documented "
                + "field ranges.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Camera settings are already up to date.");
            return false;
        }
        if CommitScene("Updated camera settings") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Author the complete lighting section as one history transaction.
    expose func ApplyLightingSection(darkness: String,
                                     tint: String,
                                     playerLightRadius: String,
                                     playerLightColor: String) -> Boolean {
        if scene == null { return false; }
        var snapshot = scene.ToJson();
        var applied = ApplyLightingIntField("darkness", darkness);
        applied = applied and ApplyLightingIntField("tint", tint);
        applied = applied
            and ApplyLightingIntField("playerLightRadius", playerLightRadius);
        applied = applied
            and ApplyLightingIntField("playerLightColor", playerLightColor);
        if applied == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The lighting settings were rejected. Check the documented "
                + "field ranges.");
            return false;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Lighting settings are already up to date.");
            return false;
        }
        if CommitScene("Updated lighting settings") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Remove every authored camera field as one history transaction.
    expose func ClearCameraSection() -> Boolean {
        if scene == null { return false; }
        var keys = scene.CameraKeys();
        if Seq.get_Count(keys) == 0 { return false; }
        var snapshot = scene.ToJson();
        var index = 0;
        while index < Seq.get_Count(keys) {
            scene.CameraRemove(Seq.GetStr(keys, index));
            index = index + 1;
        }
        if CommitScene("Cleared camera settings") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Remove every authored lighting field as one history transaction.
    expose func ClearLightingSection() -> Boolean {
        if scene == null { return false; }
        var keys = scene.LightingKeys();
        if Seq.get_Count(keys) == 0 { return false; }
        var snapshot = scene.ToJson();
        var index = 0;
        while index < Seq.get_Count(keys) {
            scene.LightingRemove(Seq.GetStr(keys, index));
            index = index + 1;
        }
        if CommitScene("Cleared lighting settings") == false {
            RestoreSceneSnapshot(snapshot);
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Apply one camera integer draft; blank removes the field.
    hide func ApplyCameraIntField(key: String, draft: String) -> Boolean {
        var text = Str.Trim(draft);
        if text == "" {
            scene.CameraRemove(key);
            return scene.CameraFieldKind(key) == "";
        }
        var parsed = Parse.TryInt(text);
        if parsed.IsNone { return false; }
        var value = parsed.UnwrapI64();
        scene.CameraSetInt(key, value);
        return scene.CameraGetInt(key, value + 1) == value;
    }

    /// @brief Apply one lighting integer draft; blank removes the field.
    hide func ApplyLightingIntField(key: String, draft: String) -> Boolean {
        var text = Str.Trim(draft);
        if text == "" {
            scene.LightingRemove(key);
            return scene.LightingFieldKind(key) == "";
        }
        var parsed = Parse.TryInt(text);
        if parsed.IsNone { return false; }
        var value = parsed.UnwrapI64();
        scene.LightingSetInt(key, value);
        return scene.LightingGetInt(key, value + 1) == value;
    }

    /// @brief Consume the toolbar Run Scene intent for the command layer.
    expose func TakeRunSceneRequested() -> Boolean {
        var requested = runSceneRequested;
        runSceneRequested = false;
        return requested;
    }

    /// @brief Return whether animated preview mode is active for this tab.
    expose func PreviewActive() -> Boolean {
        return previewActive;
    }

    /// @brief Return whether this document is presenting clean gameplay pixels.
    expose func GameViewActive() -> Boolean {
        return gameViewActive;
    }

    /// @brief Enter or leave the non-destructive clean gameplay presentation.
    /// @details Active mutation gestures must finish or cancel first. The mode
    ///          preserves selection, tools, overlays, preview preference,
    ///          canonical bytes, revision, dirty state, and history.
    expose func SetGameViewActive(active: Boolean) {
        if active == gameViewActive {
            UpdateGameViewButton();
            return;
        }
        if active
           and (paintStrokeActive or tileRectangleActive
                or canvasMarqueeActive or canvasGuideDragActive
                or objectDragActive or rectGestureMode != 0) {
            toolbarStatus.SetText(
                "Finish or cancel the active canvas gesture before Game View");
            return;
        }
        if active { CaptureWorkspaceState(); }
        var restoreFramedView = gameViewOutputFramed;
        gameViewActive = active;
        if active {
            gameViewOutputFramed = ProjectGameOutputAvailable();
            gameOutputFramePending = gameViewOutputFramed;
        } else {
            gameViewOutputFramed = false;
            gameOutputFramePending = false;
            if restoreFramedView and currentDoc != null
               and currentDoc.scene2DWorkspace != null {
                var state = currentDoc.scene2DWorkspace;
                zoomPercent = ClampInt(
                    state.zoomPercent,
                    MIN_ZOOM_PERCENT, MAX_ZOOM_PERCENT);
                pendingCanvasScrollX = ClampNumber2D(
                    state.canvasScrollX, 0.0, 1000000.0);
                pendingCanvasScrollY = ClampNumber2D(
                    state.canvasScrollY, 0.0, 1000000.0);
                restoreScrollPending = true;
                PublishCanvasExtentForZoom();
                SetLogicalScroll(
                    canvasScroll,
                    pendingCanvasScrollX,
                    pendingCanvasScrollY);
                restoreScrollPending = false;
            }
        }
        previewLastTickMs = -1;
        previewElapsedMs = 0;
        previewFrameStamp = "";
        hoverCellX = -1;
        hoverCellY = -1;
        UpdateGameViewButton();
        RefreshRulerPresentation();
        SetEditorControlsEnabled(editorControlsEnabled);
        renderDirty = true;
        if active or restoreFramedView == false {
            CaptureWorkspaceState();
        }
        if active {
            if gameViewOutputFramed {
                toolbarStatus.SetText(
                    "Game View: project " + GameOutputSizeLabel()
                    + " output; exit to navigate");
            } else {
                toolbarStatus.SetText(
                    "Game View: authored pixels with pan and zoom");
            }
        } else {
            toolbarStatus.SetText("Editor overlays and canvas tools restored");
        }
    }

    /// @brief Keep the clean-view action and accessibility text truthful.
    hide func UpdateGameViewButton() {
        if gameViewButton == null { return; }
        if canvasImage != null {
            canvasImage.SetDropTarget(gameViewActive == false);
            if gameViewActive {
                if gameViewOutputFramed {
                    canvasImage.SetTooltip(
                        "Clean " + GameOutputSizeLabel()
                        + " project output. The gameplay frame and camera "
                        + "are locked; exit Game View to navigate or edit.");
                } else {
                    canvasImage.SetTooltip(
                        "Clean Game View: middle-drag pans, the wheel zooms, "
                        + "and F fits the scene. Exit Game View to edit.");
                }
            } else {
                canvasImage.SetTooltip(
                    "Paint or erase freehand, drag Rectangle, click Fill or "
                    + "Pick; Escape cancels captured tile gestures. In Select "
                    + "mode click or drag a box, Shift adds, Control/Command "
                    + "toggles, and object drags move the selection. The wheel "
                    + "zooms around the pointer and middle-drag pans.");
            }
        }
        var concise = compactChrome
            or lastHostWidth < WRAPPED_SCENE_2D_CHROME_WIDTH;
        if gameViewActive {
            if concise { gameViewButton.SetText("Exit Game"); }
            else { gameViewButton.SetText("Exit Game View"); }
            gameViewButton.SetStyle(1);
            gameViewButton.SetTooltip(
                "Restore canvas tools, selection, grid, rulers, guides, "
                + "routes, handles, and other editor overlays");
            gameViewButton.SetAccessibleName("Exit 2D Game View");
            UpdateCommandMenuButtons();
            return;
        }
        if concise { gameViewButton.SetText("Game"); }
        else { gameViewButton.SetText("Game View"); }
        gameViewButton.SetStyle(2);
        gameViewButton.SetTooltip(
            "Show only authored gameplay pixels; keep pan and zoom, and "
            + "restore every editor overlay and tool on exit");
        gameViewButton.SetAccessibleName("Enter 2D Game View");
        UpdateCommandMenuButtons();
    }

    /// @brief Return whether the active project declares an exact 2D output.
    hide func ProjectGameOutputAvailable() -> Boolean {
        return componentSchema != null and componentSchema.valid
            and componentSchema.scenePreview2D != null
            and componentSchema.scenePreview2D.present
            and componentSchema.scenePreview2D.HasOutputSize();
    }

    /// @brief Project-authored output width, or zero when no frame is declared.
    expose func GameOutputWidth() -> Integer {
        if ProjectGameOutputAvailable() == false { return 0; }
        return componentSchema.scenePreview2D.outputWidth;
    }

    /// @brief Project-authored output height, or zero when absent.
    expose func GameOutputHeight() -> Integer {
        if ProjectGameOutputAvailable() == false { return 0; }
        return componentSchema.scenePreview2D.outputHeight;
    }

    /// @brief Human-readable exact project output dimensions.
    hide func GameOutputSizeLabel() -> String {
        var width = GameOutputWidth();
        var height = GameOutputHeight();
        if width <= 0 or height <= 0 { return "authored"; }
        return width + "x" + height;
    }

    /// @brief Largest centered project-aspect width inside one viewport.
    expose func GameOutputFrameWidthFor(
        viewportWidth: Integer,
        viewportHeight: Integer) -> Integer {
        var outputWidth = GameOutputWidth();
        var outputHeight = GameOutputHeight();
        if viewportWidth <= 0 or viewportHeight <= 0
           or outputWidth <= 0 or outputHeight <= 0 {
            return viewportWidth;
        }
        if viewportWidth * outputHeight
           <= viewportHeight * outputWidth {
            return viewportWidth;
        }
        var width = viewportHeight * outputWidth / outputHeight;
        if width < 1 { width = 1; }
        return width;
    }

    /// @brief Largest centered project-aspect height inside one viewport.
    expose func GameOutputFrameHeightFor(
        viewportWidth: Integer,
        viewportHeight: Integer) -> Integer {
        var outputWidth = GameOutputWidth();
        var outputHeight = GameOutputHeight();
        if viewportWidth <= 0 or viewportHeight <= 0
           or outputWidth <= 0 or outputHeight <= 0 {
            return viewportHeight;
        }
        if viewportWidth * outputHeight
           <= viewportHeight * outputWidth {
            var height = viewportWidth * outputHeight / outputWidth;
            if height < 1 { height = 1; }
            return height;
        }
        return viewportHeight;
    }

    /// @brief Centered horizontal origin of the project output frame.
    expose func GameOutputFrameXFor(
        viewportWidth: Integer,
        viewportHeight: Integer) -> Integer {
        return (viewportWidth
            - GameOutputFrameWidthFor(viewportWidth, viewportHeight)) / 2;
    }

    /// @brief Centered vertical origin of the project output frame.
    expose func GameOutputFrameYFor(
        viewportWidth: Integer,
        viewportHeight: Integer) -> Integer {
        return (viewportHeight
            - GameOutputFrameHeightFor(viewportWidth, viewportHeight)) / 2;
    }

    /// @brief Fit authored output pixels and center the gameplay start.
    hide func ApplyGameOutputFrame() -> Boolean {
        if gameViewActive == false or gameViewOutputFramed == false
           or scene == null or canvasScroll == null {
            return false;
        }
        var viewportWidth = lastCanvasViewportWidth;
        var viewportHeight = lastCanvasViewportHeight;
        if viewportWidth <= 0 {
            viewportWidth =
                Convert.NumToInt(canvasScroll.GetLogicalWidth());
        }
        if viewportHeight <= 0 {
            viewportHeight =
                Convert.NumToInt(canvasScroll.GetLogicalHeight());
        }
        if viewportWidth <= 0 or viewportHeight <= 0 { return false; }
        var frameWidth =
            GameOutputFrameWidthFor(viewportWidth, viewportHeight);
        var frameHeight =
            GameOutputFrameHeightFor(viewportWidth, viewportHeight);
        var outputWidth = GameOutputWidth();
        var outputHeight = GameOutputHeight();
        if frameWidth <= 0 or frameHeight <= 0
           or outputWidth <= 0 or outputHeight <= 0 {
            return false;
        }
        var widthZoom = frameWidth * 100 / outputWidth;
        var heightZoom = frameHeight * 100 / outputHeight;
        var nextZoom = widthZoom;
        if heightZoom < nextZoom { nextZoom = heightZoom; }
        zoomPercent = ClampInt(
            nextZoom, MIN_ZOOM_PERCENT, MAX_ZOOM_PERCENT);
        initialFramePending = false;
        fitPending = false;
        restoreScrollPending = false;
        var centered = CenterCanvasAtWorldPoint(
            InitialSceneFocusWorldX(), InitialSceneFocusWorldY());
        if centered {
            renderDirty = true;
            SetEditorControlsEnabled(editorControlsEnabled);
        }
        return centered;
    }

    /// @brief Return effective animation playback without rewriting its toggle.
    hide func PreviewPlaybackActive() -> Boolean {
        return previewActive or gameViewActive;
    }

    /// @brief Toggle workspace-only preview playback for the active tab.
    expose func SetPreviewActive(active: Boolean) {
        previewActive = active;
        previewLastTickMs = -1;
        previewElapsedMs = 0;
        previewFrameStamp = "";
        RefreshPreviewButton();
        renderDirty = true;
    }

    /// @brief Set one document's non-destructive runtime-autotile preview.
    expose func SetAutotilePreviewEnabled(enabled: Boolean) {
        autotilePreviewEnabled = enabled;
        if tileBehavior != null
           and tileBehavior.autotilePreviewCheck != null {
            tileBehavior.SetAutotilePreviewEnabled(enabled);
        }
        renderDirty = true;
        CaptureWorkspaceState();
        if toolbarStatus != null {
            if enabled {
                toolbarStatus.SetText("Live autotile preview on");
            } else {
                toolbarStatus.SetText("Live autotile preview off");
            }
        }
    }

    /// @brief Deterministically advance the preview clock (probes and tests).
    expose func AdvancePreviewClock(deltaMs: Integer) {
        if PreviewPlaybackActive() == false or deltaMs <= 0 { return; }
        previewElapsedMs = previewElapsedMs + deltaMs;
        previewLastTickMs = Clock.NowMs();
        previewFrameStamp = "";
        renderDirty = true;
    }

    /// @brief Keep the Preview toggle's label truthful.
    hide func RefreshPreviewButton() {
        if previewButton == null { return; }
        if previewActive {
            previewButton.SetText("Preview: on");
        } else {
            previewButton.SetText("Preview");
        }
    }

    /// @brief Advance the bounded preview clock and repaint on frame changes.
    /// @details Workspace-only: canonical bytes, history, revision, and dirty
    ///          state never change, and edits behave identically while active.
    hide func PumpPreviewClock() {
        if PreviewPlaybackActive() == false or scene == null { return; }
        var now = Clock.NowMs();
        if previewLastTickMs >= 0 {
            var delta = now - previewLastTickMs;
            if delta > 0 and delta < 10000 {
                previewElapsedMs = previewElapsedMs + delta;
            }
        }
        previewLastTickMs = now;
        var stamp = "";
        var bases = scene.TileAnimBases();
        var index = 0;
        while index < Seq.get_Count(bases) {
            var base = Box.ToI64(Seq.Get(bases, index));
            stamp = stamp + base + ":"
                + PreviewFrameForBase(base) + ";";
            index = index + 1;
        }
        if stamp != previewFrameStamp {
            previewFrameStamp = stamp;
            renderDirty = true;
        }
    }

    /// @brief Cache the runtime-visible prefix of canonical autotile rules.
    /// @details Tilemap owns 64 rule slots and SceneDocument enumerates bases
    ///          in ascending order, so retaining the first 64 exactly matches
    ///          BuildTilemap registration precedence. A bounded direct lookup
    ///          keeps the windowed renderer independent of rule count.
    hide func RefreshAutotilePreviewRules() {
        autotilePreviewRuleCount = 0;
        autotilePreviewBases = [];
        autotilePreviewVariants = [];
        autotilePreviewLookup = [];
        if scene == null { return; }

        var runtimeBases = scene.AutotileBases();
        var baseIndex = 0;
        while baseIndex < Seq.get_Count(runtimeBases)
              and autotilePreviewRuleCount
                  < MAX_AUTOTILE_PREVIEW_RULES {
            var base = Box.ToI64(Seq.Get(runtimeBases, baseIndex));
            var variants = scene.AutotileVariants(base);
            if Seq.get_Count(variants) == 16 {
                autotilePreviewBases.add(base);
                var variant = 0;
                while variant < 16 {
                    autotilePreviewVariants.add(
                        Box.ToI64(Seq.Get(variants, variant)));
                    variant = variant + 1;
                }
                autotilePreviewRuleCount =
                    autotilePreviewRuleCount + 1;
            }
            baseIndex = baseIndex + 1;
        }
        if autotilePreviewRuleCount == 0 { return; }

        var tile = 0;
        while tile <= AUTOTILE_LOOKUP_MAX_TILE {
            autotilePreviewLookup.add(-1);
            tile = tile + 1;
        }
        // Runtime variant classification keeps the first registered rule.
        var rule = 0;
        while rule < autotilePreviewRuleCount {
            var variant = 0;
            while variant < 16 {
                tile = autotilePreviewVariants.get(rule * 16 + variant);
                if tile >= 0 and tile <= AUTOTILE_LOOKUP_MAX_TILE
                   and autotilePreviewLookup.get(tile) < 0 {
                    autotilePreviewLookup.set(tile, rule);
                }
                variant = variant + 1;
            }
            rule = rule + 1;
        }
        // An exact base match wins before runtime scans every variant table.
        rule = 0;
        while rule < autotilePreviewRuleCount {
            tile = autotilePreviewBases.get(rule);
            if tile >= 0 and tile <= AUTOTILE_LOOKUP_MAX_TILE {
                autotilePreviewLookup.set(tile, rule);
            }
            rule = rule + 1;
        }
    }

    /// @brief Classify one tile with Tilemap's exact base-before-variant rule.
    hide func AutotilePreviewRuleForTile(tile: Integer) -> Integer {
        if autotilePreviewRuleCount <= 0 { return -1; }
        if tile >= 0 and tile < autotilePreviewLookup.count() {
            return autotilePreviewLookup.get(tile);
        }
        var rule = 0;
        while rule < autotilePreviewRuleCount {
            if autotilePreviewBases.get(rule) == tile { return rule; }
            rule = rule + 1;
        }
        rule = 0;
        while rule < autotilePreviewRuleCount {
            var variant = 0;
            while variant < 16 {
                if autotilePreviewVariants.get(rule * 16 + variant)
                   == tile {
                    return rule;
                }
                variant = variant + 1;
            }
            rule = rule + 1;
        }
        return -1;
    }

    /// @brief Whether one tile connects to a specific cached autotile rule.
    hide func AutotilePreviewRuleContains(rule: Integer,
                                          tile: Integer) -> Boolean {
        if rule < 0 or rule >= autotilePreviewRuleCount {
            return false;
        }
        if autotilePreviewBases.get(rule) == tile { return true; }
        var variant = 0;
        while variant < 16 {
            if autotilePreviewVariants.get(rule * 16 + variant)
               == tile {
                return true;
            }
            variant = variant + 1;
        }
        return false;
    }

    /// @brief Compute Tilemap's up/right/down/left neighbor mask.
    hide func AutotilePreviewMask(layer: Integer,
                                  x: Integer,
                                  y: Integer,
                                  rule: Integer) -> Integer {
        var mask = 0;
        if y > 0
           and AutotilePreviewRuleContains(
               rule, scene.GetTile(layer, x, y - 1)) {
            mask = mask + 1;
        }
        if x < scene.Width - 1
           and AutotilePreviewRuleContains(
               rule, scene.GetTile(layer, x + 1, y)) {
            mask = mask + 2;
        }
        if y < scene.Height - 1
           and AutotilePreviewRuleContains(
               rule, scene.GetTile(layer, x, y + 1)) {
            mask = mask + 4;
        }
        if x > 0
           and AutotilePreviewRuleContains(
               rule, scene.GetTile(layer, x - 1, y)) {
            mask = mask + 8;
        }
        return mask;
    }

    /// @brief Resolve one canonical cell exactly as Tilemap.ApplyAutoTile.
    /// @details Runtime autotile application is base-layer-only. Studio keeps
    ///          that same boundary and never writes the resolved variant back.
    expose func AutotileResolvedSceneTile(layer: Integer,
                                          x: Integer,
                                          y: Integer) -> Integer {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or x < 0 or y < 0 or x >= scene.Width or y >= scene.Height {
            return 0;
        }
        var tile = scene.GetTile(layer, x, y);
        if autotilePreviewEnabled == false or layer != 0
           or autotilePreviewRuleCount <= 0 {
            return tile;
        }
        var rule = AutotilePreviewRuleForTile(tile);
        if rule < 0 { return tile; }
        var mask = AutotilePreviewMask(layer, x, y, rule);
        return autotilePreviewVariants.get(rule * 16 + mask);
    }

    /// @brief Read one prospective single-cell paint without mutating scene.
    hide func AutotilePreviewTileWithOverride(layer: Integer,
                                              x: Integer,
                                              y: Integer,
                                              overrideX: Integer,
                                              overrideY: Integer,
                                              overrideTile: Integer)
                                              -> Integer {
        if x == overrideX and y == overrideY { return overrideTile; }
        return scene.GetTile(layer, x, y);
    }

    /// @brief Resolve one prospective brush cell through the runtime mask.
    hide func AutotileResolvedTileWithOverride(layer: Integer,
                                               x: Integer,
                                               y: Integer,
                                               tile: Integer,
                                               overrideX: Integer,
                                               overrideY: Integer,
                                               overrideTile: Integer)
                                               -> Integer {
        if autotilePreviewEnabled == false or layer != 0
           or autotilePreviewRuleCount <= 0 {
            return tile;
        }
        var rule = AutotilePreviewRuleForTile(tile);
        if rule < 0 { return tile; }
        var mask = 0;
        if y > 0
           and AutotilePreviewRuleContains(
               rule,
               AutotilePreviewTileWithOverride(
                   layer, x, y - 1,
                   overrideX, overrideY, overrideTile)) {
            mask = mask + 1;
        }
        if x < scene.Width - 1
           and AutotilePreviewRuleContains(
               rule,
               AutotilePreviewTileWithOverride(
                   layer, x + 1, y,
                   overrideX, overrideY, overrideTile)) {
            mask = mask + 2;
        }
        if y < scene.Height - 1
           and AutotilePreviewRuleContains(
               rule,
               AutotilePreviewTileWithOverride(
                   layer, x, y + 1,
                   overrideX, overrideY, overrideTile)) {
            mask = mask + 4;
        }
        if x > 0
           and AutotilePreviewRuleContains(
               rule,
               AutotilePreviewTileWithOverride(
                   layer, x - 1, y,
                   overrideX, overrideY, overrideTile)) {
            mask = mask + 8;
        }
        return autotilePreviewVariants.get(rule * 16 + mask);
    }

    /// @brief Resolve one tile through preview animation state when active.
    hide func PreviewResolvedTile(tile: Integer) -> Integer {
        if PreviewPlaybackActive() == false or scene == null or tile <= 0 {
            return tile;
        }
        var frames = scene.TileAnimFrames(tile);
        if Seq.get_Count(frames) == 0 { return tile; }
        var frame = PreviewFrameForBase(tile);
        if frame < 0 or frame >= Seq.get_Count(frames) { return tile; }
        return Box.ToI64(Seq.Get(frames, frame));
    }

    /// @brief Resolve authored autotile and optional animation preview layers.
    expose func ResolvedSceneTileForPreview(layer: Integer,
                                            x: Integer,
                                            y: Integer) -> Integer {
        return PreviewResolvedTile(
            AutotileResolvedSceneTile(layer, x, y));
    }

    /// @brief Return one base tile's current frame index from durations.
    /// @details Matches Tilemap playback: elapsed time cycles through the
    ///          authored per-frame durations in order.
    hide func PreviewFrameForBase(base: Integer) -> Integer {
        var durations = scene.TileAnimDurations(base);
        var count = Seq.get_Count(durations);
        if count <= 0 { return -1; }
        var total = 0;
        var index = 0;
        while index < count {
            total = total + Box.ToI64(Seq.Get(durations, index));
            index = index + 1;
        }
        if total <= 0 { return 0; }
        var cycle = previewElapsedMs % total;
        index = 0;
        while index < count {
            cycle = cycle - Box.ToI64(Seq.Get(durations, index));
            if cycle < 0 { return index; }
            index = index + 1;
        }
        return 0;
    }

    /// @brief Draw the follow-mode deadzone at the player start while previewing.
    hide func DrawPreviewDeadzoneOverlay() {
        if previewActive == false
           or scene.CameraGetStr("mode", "") != "follow"
           or scene.CameraFieldKind("deadzoneWidth") != "int"
           or scene.CameraFieldKind("deadzoneHeight") != "int"
           or scene.PropertyKind("playerStartX") != "int"
           or scene.PropertyKind("playerStartY") != "int" {
            return;
        }
        var centerX = scene.GetInt("playerStartX", 0) * displayCellSize
            / scene.TileWidth - viewOriginX;
        var centerY = scene.GetInt("playerStartY", 0) * displayCellSize
            / scene.TileHeight - viewOriginY;
        var halfWidth = scene.CameraGetInt("deadzoneWidth", 0)
            * displayCellSize / scene.TileWidth / 2;
        var halfHeight = scene.CameraGetInt("deadzoneHeight", 0)
            * displayCellSize / scene.TileHeight / 2;
        if halfWidth <= 0 or halfHeight <= 0 { return; }
        framePixels.DrawFrame(
            centerX - halfWidth,
            centerY - halfHeight,
            halfWidth * 2,
            halfHeight * 2,
            Color.RGB(150, 220, 170));
    }

    /// @brief Draw the authored camera bounds rectangle (workspace-only).
    hide func DrawCameraBoundsOverlay() {
        if scene.CameraFieldKind("minX") != "int"
           or scene.CameraFieldKind("minY") != "int"
           or scene.CameraFieldKind("maxX") != "int"
           or scene.CameraFieldKind("maxY") != "int" {
            return;
        }
        var contentWidth = scene.Width * displayCellSize;
        var contentHeight = scene.Height * displayCellSize;
        var x0 = ClampInt(
            scene.CameraGetInt("minX", 0) * displayCellSize / scene.TileWidth,
            0, contentWidth) - viewOriginX;
        var y0 = ClampInt(
            scene.CameraGetInt("minY", 0) * displayCellSize / scene.TileHeight,
            0, contentHeight) - viewOriginY;
        var x1 = ClampInt(
            scene.CameraGetInt("maxX", 0) * displayCellSize / scene.TileWidth,
            0, contentWidth) - viewOriginX;
        var y1 = ClampInt(
            scene.CameraGetInt("maxY", 0) * displayCellSize / scene.TileHeight,
            0, contentHeight) - viewOriginY;
        if x1 <= x0 or y1 <= y0 { return; }
        framePixels.DrawFrame(
            x0, y0, x1 - x0 + 1, y1 - y0 + 1, Color.RGB(233, 140, 220));
    }

    /// @brief Parse comma-separated integers, or null for malformed drafts.
    hide func ParseCsvIntegers(text: String) -> Any {
        var out = Seq.New();
        var trimmed = Str.Trim(text);
        if trimmed == "" { return out; }
        var parts = Str.Split(trimmed, ",");
        var count = Seq.get_Count(parts);
        var index = 0;
        while index < count {
            var part = Str.Trim(Seq.GetStr(parts, index));
            var parsed = Parse.TryInt(part);
            if parsed.IsNone { return null; }
            Seq.Push(out, Box.I64(parsed.UnwrapI64()));
            index = index + 1;
        }
        return out;
    }

    /// @brief Verify one just-written scene property without string coercion.
    hide func ScenePropertyMatches(key: String,
                                   kind: String,
                                   stringValue: String,
                                   intValue: Integer,
                                   floatValue: Number,
                                   boolValue: Boolean) -> Boolean {
        if scene.Has(key) == false or scene.PropertyKind(key) != kind {
            return false;
        }
        if kind == "string" {
            return scene.GetStr(key, "") == stringValue;
        }
        if kind == "int" { return scene.GetInt(key, 0) == intValue; }
        if kind == "float" {
            var delta = scene.GetFloat(key, 0.0) - floatValue;
            if delta < 0.0 { delta = 0.0 - delta; }
            return delta < 0.000000000001;
        }
        if kind == "bool" {
            return scene.GetBool(key, false) == boolValue;
        }
        return kind == "null";
    }

    /// @brief Create, rename, or update one typed object property transactionally.
    expose func SetSceneObjectProperty(index: Integer,
                                       previousKey: String,
                                       key: String,
                                       kind: String,
                                       value: String) -> Boolean {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return false;
        }
        var nextKey = Str.Trim(key);
        if nextKey == "" {
            detailLabel.SetText("Property key cannot be empty.");
            return false;
        }
        if previousKey != nextKey and scene.ObjectHas(index, nextKey) {
            detailLabel.SetText(
                "Property \"" + nextKey + "\" already exists on this object.");
            return false;
        }

        var snapshot = scene.ToJson();
        var applied = false;
        if kind == "string" {
            scene.ObjectSetStr(index, nextKey, value);
            applied = scene.ObjectGetStr(index, nextKey, "") == value;
        } else if kind == "int" {
            var parsedInt = Parse.TryInt(Str.Trim(value));
            if parsedInt.IsNone {
                detailLabel.SetText("Enter a valid whole number.");
                return false;
            }
            var intValue = parsedInt.UnwrapI64();
            scene.ObjectSetInt(index, nextKey, intValue);
            applied = scene.ObjectGetInt(index, nextKey, 0) == intValue;
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(Str.Trim(value));
            if parsedFloat.IsNone {
                detailLabel.SetText("Enter a valid finite number.");
                return false;
            }
            var floatValue = parsedFloat.UnwrapF64();
            scene.ObjectSetFloat(index, nextKey, floatValue);
            var floatDelta =
                scene.ObjectGetFloat(index, nextKey, 0.0) - floatValue;
            if floatDelta < 0.0 { floatDelta = 0.0 - floatDelta; }
            applied = floatDelta < 0.000000000001;
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(Str.Trim(value));
            if parsedBool.IsNone {
                detailLabel.SetText(
                    "Enter true/false, yes/no, on/off, or 1/0.");
                return false;
            }
            var boolValue = parsedBool.UnwrapI1();
            scene.ObjectSetBool(index, nextKey, boolValue);
            applied = scene.ObjectGetBool(index, nextKey, false) == boolValue;
        } else if kind == "null" {
            scene.ObjectSetNull(index, nextKey);
            applied = scene.ObjectPropertyKind(index, nextKey) == "null";
        } else {
            detailLabel.SetText("Choose a supported property type.");
            return false;
        }

        if applied == false or scene.ObjectHas(index, nextKey) == false
           or scene.ObjectPropertyKind(index, nextKey) != kind {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The property was rejected. Keys are limited to 128 bytes and "
                + "string values to 64 KiB.");
            return false;
        }
        if previousKey != "" and previousKey != nextKey {
            scene.ObjectRemove(index, previousKey);
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText("Property is already up to date.");
            return false;
        }
        selectedObject = index;
        selectedObjects = scene_selection.Single(
            index, scene.ObjectCount());
        if CommitScene("Updated property " + nextKey) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The property update could not be committed.");
            return false;
        }

        selectedObjectProperty = -1;
        detailLabel.SetText("");
        RefreshInspector();
        SelectObjectPropertyByKey(nextKey);
        return true;
    }

    /// @brief Remove one typed object property through the shared history path.
    expose func RemoveSceneObjectProperty(index: Integer,
                                          key: String) -> Boolean {
        if scene == null or index < 0 or index >= scene.ObjectCount()
           or scene.ObjectHas(index, key) == false {
            return false;
        }
        var snapshot = scene.ToJson();
        scene.ObjectRemove(index, key);
        if scene.ObjectHas(index, key) {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The scene model rejected the property removal.");
            return false;
        }
        selectedObject = index;
        selectedObjects = scene_selection.Single(
            index, scene.ObjectCount());
        selectedObjectProperty = -1;
        if CommitScene("Removed property " + key) == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText("The property removal could not be committed.");
            return false;
        }
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Set one typed property across the complete object selection.
    /// @details The value is parsed once, every selected object is verified,
    ///          and one canonical history snapshot covers the entire batch.
    expose func SetSelectedSceneObjectProperty(key: String,
                                               kind: String,
                                               value: String) -> Boolean {
        if scene == null { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var count = selectedObjects.count();
        if count == 0 { return false; }
        var nextKey = Str.Trim(key);
        if nextKey == "" {
            detailLabel.SetText("Property key cannot be empty.");
            return false;
        }

        var intValue = 0;
        var floatValue = 0.0;
        var boolValue = false;
        if kind == "int" {
            var parsedInt = Parse.TryInt(Str.Trim(value));
            if parsedInt.IsNone {
                detailLabel.SetText("Enter a valid whole number.");
                return false;
            }
            intValue = parsedInt.UnwrapI64();
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(Str.Trim(value));
            if parsedFloat.IsNone {
                detailLabel.SetText("Enter a valid finite number.");
                return false;
            }
            floatValue = parsedFloat.UnwrapF64();
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(Str.Trim(value));
            if parsedBool.IsNone {
                detailLabel.SetText(
                    "Enter true/false, yes/no, on/off, or 1/0.");
                return false;
            }
            boolValue = parsedBool.UnwrapI1();
        } else if kind != "string" and kind != "null" {
            detailLabel.SetText("Choose a supported property type.");
            return false;
        }

        var snapshot = scene.ToJson();
        var selectionIndex = 0;
        while selectionIndex < count {
            var objectIndex = selectedObjects.get(selectionIndex);
            if kind == "string" {
                scene.ObjectSetStr(objectIndex, nextKey, value);
            } else if kind == "int" {
                scene.ObjectSetInt(objectIndex, nextKey, intValue);
            } else if kind == "float" {
                scene.ObjectSetFloat(objectIndex, nextKey, floatValue);
            } else if kind == "bool" {
                scene.ObjectSetBool(objectIndex, nextKey, boolValue);
            } else {
                scene.ObjectSetNull(objectIndex, nextKey);
            }
            if BatchPropertyMatches(
                   objectIndex, nextKey, kind, value,
                   intValue, floatValue, boolValue) == false {
                RestoreSceneSnapshot(snapshot);
                detailLabel.SetText(
                    "The batch property was rejected. Keys are limited to "
                    + "128 bytes and string values to 64 KiB. "
                    + "No objects were changed.");
                return false;
            }
            selectionIndex = selectionIndex + 1;
        }
        if scene.ToJson() == snapshot {
            detailLabel.SetText(
                "Property is already up to date on every selected object.");
            return false;
        }
        if CommitScene(
               "Set " + nextKey + " on " + count + " objects") == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The batch property could not be committed. "
                + "No objects were changed.");
            return false;
        }
        selectedObjectProperty = -1;
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Remove one property from every selected object in one history row.
    expose func RemoveSelectedSceneObjectProperty(key: String) -> Boolean {
        if scene == null { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var nextKey = Str.Trim(key);
        if selectedObjects.count() == 0 or nextKey == "" {
            detailLabel.SetText("Enter a property key to remove.");
            return false;
        }
        var snapshot = scene.ToJson();
        var removed = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedObjects.count() {
            var objectIndex = selectedObjects.get(selectionIndex);
            if scene.ObjectHas(objectIndex, nextKey) {
                scene.ObjectRemove(objectIndex, nextKey);
                if scene.ObjectHas(objectIndex, nextKey) {
                    RestoreSceneSnapshot(snapshot);
                    detailLabel.SetText(
                        "The batch property removal was rejected. "
                        + "No objects were changed.");
                    return false;
                }
                removed = removed + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if removed == 0 {
            detailLabel.SetText(
                "None of the selected objects has property \""
                + nextKey + "\".");
            return false;
        }
        if CommitScene(
               "Removed " + nextKey + " from " + removed + " objects")
           == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The batch property removal could not be committed. "
                + "No objects were changed.");
            return false;
        }
        selectedObjectProperty = -1;
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Add every missing field from one project component transactionally.
    /// @details Existing same-kind values are preserved. Any type conflict or
    ///          rejected write restores the complete scene before returning.
    expose func ApplySelectedComponent(
        component: scene_component_schema.SceneComponentDefinition)
        -> Boolean {
        if scene == null or component == null
           or component.SupportsTarget(
               scene_component_schema.TARGET_2D_OBJECT) == false {
            return false;
        }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if selectedObjects.count() == 0 {
            detailLabel.SetText(
                "Select one or more objects before adding a component.");
            return false;
        }

        var missing = 0;
        var selectionIndex = 0;
        while selectionIndex < selectedObjects.count() {
            var objectIndex = selectedObjects.get(selectionIndex);
            var fieldIndex = 0;
            while fieldIndex < component.fields.count() {
                var field = component.fields.get(fieldIndex);
                if scene.ObjectHas(objectIndex, field.key) {
                    if scene.ObjectPropertyKind(objectIndex, field.key)
                       != scene_component_schema.ValueKind(field.kind) {
                        detailLabel.SetText(
                            "Component \"" + component.label
                            + "\" conflicts with property \"" + field.key
                            + "\". No objects were changed.");
                        RefreshComponentPalette();
                        return false;
                    }
                } else {
                    missing = missing + 1;
                }
                fieldIndex = fieldIndex + 1;
            }
            selectionIndex = selectionIndex + 1;
        }
        if missing == 0 {
            detailLabel.SetText(
                "Component \"" + component.label
                + "\" is already complete on the selection.");
            RefreshComponentPalette();
            return false;
        }

        var snapshot = scene.ToJson();
        selectionIndex = 0;
        while selectionIndex < selectedObjects.count() {
            var objectIndex = selectedObjects.get(selectionIndex);
            var fieldIndex = 0;
            while fieldIndex < component.fields.count() {
                var field = component.fields.get(fieldIndex);
                if scene.ObjectHas(objectIndex, field.key) == false
                   and WriteObjectComponentField(objectIndex, field) == false {
                    RestoreSceneSnapshot(snapshot);
                    detailLabel.SetText(
                        "Component \"" + component.label
                        + "\" was rejected. No objects were changed.");
                    RefreshComponentPalette();
                    return false;
                }
                fieldIndex = fieldIndex + 1;
            }
            selectionIndex = selectionIndex + 1;
        }

        if CommitScene(
               "Added " + component.label + " to "
               + selectedObjects.count() + " object(s)") == false {
            RestoreSceneSnapshot(snapshot);
            detailLabel.SetText(
                "The component could not be committed. No objects were changed.");
            RefreshComponentPalette();
            return false;
        }
        selectedObjectProperty = -1;
        detailLabel.SetText(
            "Added " + missing + " missing field(s) from "
            + component.label + ".");
        RefreshInspector();
        return true;
    }

    /// @brief Create one project-defined gameplay object in one transaction.
    /// @details The selected cell wins; otherwise the center visible cell is
    ///          used. The object type and every typed default are staged
    ///          before one canonical commit, so Undo never exposes a generic
    ///          intermediate object.
    expose func CreateObjectFromComponent(
        component: scene_component_schema.SceneComponentDefinition)
        -> Integer {
        if scene == null or component == null
           or component.CanCreateFor(
               scene_component_schema.TARGET_2D_OBJECT) == false {
            detailLabel.SetText(
                "This project component has no 2D creation recipe.");
            return -1;
        }

        var cellX = selectedCellX;
        var cellY = selectedCellY;
        if cellX < 0 or cellY < 0
           or cellX >= scene.Width or cellY >= scene.Height {
            var viewportWidth = lastCanvasViewportWidth;
            var viewportHeight = lastCanvasViewportHeight;
            if viewportWidth <= 0 { viewportWidth = displayCellSize; }
            if viewportHeight <= 0 { viewportHeight = displayCellSize; }
            var contentX =
                viewOriginX + viewportWidth / 2 - centerPadX;
            var contentY =
                viewOriginY + viewportHeight / 2 - centerPadY;
            cellX = ClampInt(
                contentX / displayCellSize, 0, scene.Width - 1);
            cellY = ClampInt(
                contentY / displayCellSize, 0, scene.Height - 1);
        }

        var snapshot = scene.ToJson();
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var previousProperty = selectedObjectProperty;
        var objectId = UniqueObjectId(
            component.name + "-" + (scene.ObjectCount() + 1));
        var objectIndex = scene.AddObject(
            component.createObjectType,
            objectId,
            cellX * scene.TileWidth,
            cellY * scene.TileHeight);
        if objectIndex < 0 {
            detailLabel.SetText(
                "The scene rejected the project object recipe.");
            return -1;
        }
        var fieldIndex = 0;
        while fieldIndex < component.fields.count() {
            if WriteObjectComponentField(
                   objectIndex, component.fields.get(fieldIndex)) == false {
                RestoreSceneSnapshot(snapshot);
                selectedObjects = previousSelection;
                selectedObject = previousPrimary;
                selectedObjectProperty = previousProperty;
                RefreshInspector();
                detailLabel.SetText(
                    "Project object creation was rejected; the scene "
                    + "was restored.");
                return -1;
            }
            fieldIndex = fieldIndex + 1;
        }

        selectedObject = objectIndex;
        selectedObjects = scene_selection.Single(
            objectIndex, scene.ObjectCount());
        selectedObjectProperty = -1;
        if CommitScene("Created " + component.label) == false {
            RestoreSceneSnapshot(snapshot);
            selectedObjects = previousSelection;
            selectedObject = previousPrimary;
            selectedObjectProperty = previousProperty;
            RefreshInspector();
            detailLabel.SetText(
                "The project object could not be committed; the scene "
                + "was restored.");
            return -1;
        }
        detailLabel.SetText(
            "Created " + component.label + " \"" + objectId
            + "\" at cell " + cellX + ", " + cellY + ".");
        RefreshInspector();
        return objectIndex;
    }

    /// @brief Write one already-validated schema default and verify exact kind.
    hide func WriteObjectComponentField(
        index: Integer,
        field: scene_component_schema.SceneComponentField) -> Boolean {
        var intValue = 0;
        var floatValue = 0.0;
        var boolValue = false;
        var kind = scene_component_schema.ValueKind(field.kind);
        if kind == "string" {
            scene.ObjectSetStr(index, field.key, field.defaultText);
        } else if kind == "int" {
            var parsedInt = Parse.TryInt(field.defaultText);
            if parsedInt.IsNone { return false; }
            intValue = parsedInt.UnwrapI64();
            scene.ObjectSetInt(index, field.key, intValue);
        } else if kind == "float" {
            var parsedFloat = Parse.TryDouble(field.defaultText);
            if parsedFloat.IsNone { return false; }
            floatValue = parsedFloat.UnwrapF64();
            scene.ObjectSetFloat(index, field.key, floatValue);
        } else if kind == "bool" {
            var parsedBool = Parse.TryBool(field.defaultText);
            if parsedBool.IsNone { return false; }
            boolValue = parsedBool.UnwrapI1();
            scene.ObjectSetBool(index, field.key, boolValue);
        } else if kind == "null" {
            scene.ObjectSetNull(index, field.key);
        } else {
            return false;
        }
        return BatchPropertyMatches(
            index,
            field.key,
            kind,
            field.defaultText,
            intValue,
            floatValue,
            boolValue);
    }

    /// @brief Verify one just-written typed property without string coercion.
    hide func BatchPropertyMatches(index: Integer,
                                   key: String,
                                   kind: String,
                                   stringValue: String,
                                   intValue: Integer,
                                   floatValue: Number,
                                   boolValue: Boolean) -> Boolean {
        if scene.ObjectHas(index, key) == false
           or scene.ObjectPropertyKind(index, key) != kind {
            return false;
        }
        if kind == "string" {
            return scene.ObjectGetStr(index, key, "") == stringValue;
        }
        if kind == "int" {
            return scene.ObjectGetInt(index, key, 0) == intValue;
        }
        if kind == "float" {
            var delta =
                scene.ObjectGetFloat(index, key, 0.0) - floatValue;
            if delta < 0.0 { delta = 0.0 - delta; }
            return delta < 0.000000000001;
        }
        if kind == "bool" {
            return scene.ObjectGetBool(index, key, false) == boolValue;
        }
        return kind == "null";
    }

    /// @brief Replace the document with a bounded, undoable empty scene.
    expose func ReplaceScene(width: Integer,
                             height: Integer,
                             tileSize: Integer) -> Boolean {
        var nextWidth = ClampInt(width, 1, MAX_NEW_SCENE_CELLS);
        var nextHeight = ClampInt(height, 1, MAX_NEW_SCENE_CELLS);
        var nextTileSize = ClampInt(tileSize, 1, 512);
        scene = SceneDocument.New(nextWidth, nextHeight,
                                  nextTileSize, nextTileSize);
        if scene == null { return false; }
        RefreshAutotilePreviewRules();
        loadError = "";
        activeLayer = 0;
        selectedObject = -1;
        selectedObjects = [];
        selectedObjectProperty = -1;
        selectedCellX = -1;
        selectedCellY = -1;
        SetEditorControlsEnabled(true);
        initialFramePending = false;
        fitPending = true;
        var changed = CommitScene(
            "Created " + nextWidth + "x" + nextHeight + " scene");
        ReloadTilesets();
        detailLabel.SetText("");
        RefreshInspector();
        RefreshSceneSetupFields();
        return changed;
    }

    /// @brief Rename one scene layer through the canonical history path.
    expose func RenameSceneLayer(layer: Integer,
                                 name: String) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount() {
            return false;
        }
        var nextName = Str.Trim(name);
        if nextName == "" or scene.LayerName(layer) == nextName {
            return false;
        }
        scene.SetLayerName(layer, nextName);
        if scene.LayerName(layer) != nextName {
            detailLabel.SetText(
                "Layer names must fit the scene format's 31-byte limit.");
            return false;
        }
        activeLayer = layer;
        var changed = CommitScene("Renamed layer to " + nextName);
        detailLabel.SetText("");
        RefreshInspector();
        return changed;
    }

    /// @brief Validate and persist one external layer tileset reference.
    /// @details Empty paths clear the reference. Accepted changes create one
    ///          canonical history entry; invalid images leave JSON untouched.
    expose func ApplyLayerAssetPath(layer: Integer,
                                    assetPath: String) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount() {
            return false;
        }
        var nextPath = Str.Trim(assetPath);
        var previousPath = scene.LayerAsset(layer);
        if nextPath == previousPath { return false; }

        if nextPath != "" {
            var docPath = "";
            if currentDoc != null { docPath = currentDoc.filePath; }
            var candidate = tilesets.ValidateCandidateForLayer(
                layer, nextPath, docPath,
                scene.TileWidth, scene.TileHeight);
            if candidate.error != "" {
                toolbarStatus.SetText("Layer image not loaded");
                tilesetInspector.status.SetText(candidate.error);
                detailLabel.SetText(
                    "The layer image was not changed.\n\n" + candidate.error);
                GUI.Toast.Error("2D tileset image could not be loaded");
                return false;
            }
        }

        scene.SetLayerAsset(layer, nextPath);
        if scene.LayerAsset(layer) != nextPath {
            detailLabel.SetText("The scene model rejected the layer image path.");
            return false;
        }
        activeLayer = layer;
        var action = "Updated layer image";
        if nextPath == "" { action = "Cleared layer image"; }
        if CommitScene(action) == false {
            scene.SetLayerAsset(layer, previousPath);
            detailLabel.SetText("The layer image change could not be committed.");
            return false;
        }
        ReloadTilesets();
        detailLabel.SetText("");
        RefreshInspector();
        return true;
    }

    /// @brief Reload external layer pixels without changing scene history.
    expose func ReloadTilesetPreviews() {
        ReloadTilesets();
        RefreshTilesetPalette();
        var entry = tilesets.Entry(activeLayer);
        if entry != null and entry.error != "" {
            toolbarStatus.SetText("Layer image reload failed");
            detailLabel.SetText(entry.error);
        } else {
            toolbarStatus.SetText("Reloaded layer image previews");
            detailLabel.SetText("");
        }
    }

    /// @brief Quietly refresh externally changed layer images without history.
    /// @return True when metadata changed and the bounded preview was reloaded.
    expose func PollTilesetExternalChanges(intervalMs: Integer) -> Boolean {
        if scene == null or tilesets == null
           or tilesets.PollExternalChanges(intervalMs) == false {
            return false;
        }
        ReloadTilesets();
        RefreshTilesetPalette();
        var entry = tilesets.Entry(activeLayer);
        if entry != null and entry.error != "" {
            toolbarStatus.SetText("Layer image changed externally");
            detailLabel.SetText(entry.error);
        } else {
            toolbarStatus.SetText(
                "Layer image refreshed after external change");
            detailLabel.SetText("");
        }
        return true;
    }

    /// @brief Select one visible palette frame and enter Paint mode.
    expose func SelectPaletteTile(tileId: Integer) -> Boolean {
        if scene == null or tileId <= 0
           or tileId > tilesets.TileCount(activeLayer) {
            return false;
        }
        tileSpinner.SetValue(tileId);
        SetMode(MODE_PAINT);
        RefreshTilesetPalette();
        toolbarStatus.SetText("Selected tile " + tileId + " for painting");
        return true;
    }

    /// @brief Import one Tiled path transactionally without opening a dialog.
    /// @return True only when import and serialization both succeed.
    expose func ImportTiledPath(path: String) -> Boolean {
        if path == "" { return false; }
        var imported = SceneDocument.ImportTiledResult(path);
        if imported.IsOk == false {
            var message = imported.UnwrapErrStr();
            detailLabel.SetText("Tiled import failed:\n" + message);
            toolbarStatus.SetText("Import failed");
            GUI.Toast.Error("Tiled import failed: " + message);
            return false;
        }
        scene = imported.Unwrap() as SceneDocument;
        RefreshAutotilePreviewRules();
        loadError = "";
        activeLayer = 0;
        selectedObject = -1;
        selectedObjects = [];
        selectedObjectProperty = -1;
        selectedCellX = -1;
        selectedCellY = -1;
        SetEditorControlsEnabled(true);
        initialFramePending = false;
        fitPending = true;
        var changed = CommitScene("Imported " + Path.Name(path));
        ReloadTilesets();
        RefreshInspector();
        RefreshSceneSetupFields();
        return changed;
    }

    /// @brief Import a user-selected Tiled file transactionally.
    hide func ImportTiled() -> Boolean {
        var baseDir = "";
        if currentDoc != null and currentDoc.filePath != "" {
            baseDir = Path.Directory(currentDoc.filePath);
        }
        var path = GUI.FileDialog.Open(
            "Import Tiled Map", baseDir, "*.tmj;*.json;*.tmx");
        if path == "" { return false; }
        return ImportTiledPath(path);
    }

    /// @brief Serialize one accepted edit into the shared Document model.
    hide func CommitScene(message: String) -> Boolean {
        if scene == null or currentDoc == null { return false; }
        var serialized = scene.ToJson();
        if serialized == "" {
            detailLabel.SetText("Scene serialization failed; no document data changed.");
            return false;
        }
        if serialized == currentSerialized { return false; }
        SyncHistoryLabels();
        PushHistory(undoStack, currentSerialized);
        undoLabels.add(message);
        SyncHistoryLabels();
        redoStack = [];
        redoLabels = [];
        currentSerialized = serialized;
        currentDoc.content = serialized;
        currentDoc.isModified = serialized != cleanSerialized;
        revision = revision + 1;
        renderDirty = true;
        toolbarStatus.SetText(message);
        return true;
    }

    /// @brief Append one bounded canonical scene-JSON history snapshot.
    /// @details Entry count and aggregate bytes are both bounded (ADR 0190):
    ///          oldest snapshots drop first, and the newest snapshot is
    ///          always retained so the last edit stays undoable.
    hide func PushHistory(stack: List[String], content: String) {
        if content == "" { return; }
        stack.add(content);
        scene_history.TrimHistory(
            stack, MAX_2D_SCENE_HISTORY, MAX_2D_HISTORY_BYTES);
    }

    /// @brief Reconcile best-effort labels with bounded snapshot stacks.
    /// @details Budget trims can drop old snapshots. Front-trimming and
    ///          padding keep labels aligned without making presentation text
    ///          part of canonical scene history.
    hide func SyncHistoryLabels() {
        while undoLabels.count() > undoStack.count() {
            undoLabels.removeAt(0);
        }
        while undoLabels.count() < undoStack.count() {
            var rebuilt: List[String] = [];
            rebuilt.add("Edit");
            var undoIndex = 0;
            while undoIndex < undoLabels.count() {
                rebuilt.add(undoLabels.get(undoIndex));
                undoIndex = undoIndex + 1;
            }
            undoLabels = rebuilt;
        }
        while redoLabels.count() > redoStack.count() {
            redoLabels.removeAt(0);
        }
        while redoLabels.count() < redoStack.count() {
            redoLabels.add("Edit");
        }
    }

    /// @brief Rebuild the visible 2D History timeline oldest-first.
    expose func RefreshHistoryPanel() {
        if historyList == null { return; }
        SyncHistoryLabels();
        historyListRefreshing = true;
        historyList.Clear();
        var index = 0;
        while index < undoLabels.count() {
            historyList.AddItem(
                (index + 1) + ". " + undoLabels.get(index));
            index = index + 1;
        }
        historyList.AddItem("● Current");
        historyList.SelectIndex(undoLabels.count());
        // Programmatic selection raises a normal selection edge. Drain it so
        // the next frame cannot mistake refresh for a user jump.
        historyList.WasSelectionChanged();
        historyListRefreshing = false;
    }

    /// @brief Jump to the snapshot immediately before one listed edit.
    /// @details Row k is oldest-first; the Current row is intentionally a
    ///          no-op and completed jumps retain the equivalent redo chain.
    expose func JumpToHistoryRow(row: Integer) -> Boolean {
        SyncHistoryLabels();
        if row < 0 or row >= undoStack.count() { return false; }
        var undos = undoStack.count() - row;
        var step = 0;
        while step < undos {
            if Undo() == false { return false; }
            step = step + 1;
        }
        toolbarStatus.SetText("Jumped back " + undos + " edit(s)");
        RefreshHistoryPanel();
        return true;
    }

    /// @brief Route one History row selection into the normal undo path.
    hide func PumpHistoryPanel() -> Boolean {
        if historyList == null or historyListRefreshing { return false; }
        if historyList.WasSelectionChanged() == false { return false; }
        var row = historyList.SelectedIndex;
        SyncHistoryLabels();
        if row >= 0 and row < undoStack.count() {
            return JumpToHistoryRow(row);
        }
        RefreshHistoryPanel();
        return false;
    }

    hide func SetMode(nextMode: Integer) {
        var normalizedMode = nextMode;
        if nextMode < MODE_SELECT or nextMode > MODE_ELLIPSE {
            normalizedMode = MODE_SELECT;
        }
        if paintStrokeActive and normalizedMode != mode {
            CancelPaintStroke();
        }
        if tileRectangleActive and normalizedMode != MODE_RECTANGLE {
            CancelTileRectangle();
        }
        if canvasMarqueeActive and normalizedMode != MODE_SELECT {
            CancelCanvasMarquee();
        }
        if normalizedMode != MODE_PAINT { ClearTileStamp(); }
        var modeChanged = mode != normalizedMode;
        mode = normalizedMode;
        lastPaintX = -1;
        lastPaintY = -1;
        UpdateModeButtons();
        if modeChanged { renderDirty = true; }
    }

    expose func UpdateModeButtons() {
        if selectButton == null { return; }
        var canvasEditingEnabled =
            editorControlsEnabled and gameViewActive == false;
        selectButton.SetEnabled(canvasEditingEnabled);
        paintButton.SetEnabled(canvasEditingEnabled);
        eraseButton.SetEnabled(canvasEditingEnabled);
        rectangleButton.SetEnabled(canvasEditingEnabled);
        lineButton.SetEnabled(canvasEditingEnabled);
        ellipseButton.SetEnabled(canvasEditingEnabled);
        fillButton.SetEnabled(canvasEditingEnabled);
        pickerButton.SetEnabled(canvasEditingEnabled);
        objectButton.SetEnabled(canvasEditingEnabled);
        toolMenuButton.SetEnabled(canvasEditingEnabled);
        selectButton.SetStyle(0);
        paintButton.SetStyle(0);
        eraseButton.SetStyle(0);
        rectangleButton.SetStyle(0);
        lineButton.SetStyle(0);
        ellipseButton.SetStyle(0);
        fillButton.SetStyle(0);
        pickerButton.SetStyle(0);
        objectButton.SetStyle(0);
        if mode == MODE_PAINT {
            paintButton.SetStyle(1);
        } else if mode == MODE_ERASE {
            eraseButton.SetStyle(1);
        } else if mode == MODE_RECTANGLE {
            rectangleButton.SetStyle(1);
        } else if mode == MODE_LINE {
            lineButton.SetStyle(1);
        } else if mode == MODE_ELLIPSE {
            ellipseButton.SetStyle(1);
        } else if mode == MODE_FILL {
            fillButton.SetStyle(1);
        } else if mode == MODE_PICKER {
            pickerButton.SetStyle(1);
        } else if mode == MODE_OBJECT {
            objectButton.SetStyle(1);
        } else {
            selectButton.SetStyle(1);
        }
        UpdateCommandMenuButtons();
    }

    expose func SetEditorControlsEnabled(enabled: Boolean) {
        if selectButton == null { return; }
        editorControlsEnabled = enabled;
        UpdateModeButtons();
        tileSpinner.SetEnabled(enabled and gameViewActive == false);
        previewButton.SetEnabled(enabled and gameViewActive == false);
        gameViewButton.SetEnabled(enabled);
        zoomOutButton.SetEnabled(enabled and gameViewOutputFramed == false);
        zoomInButton.SetEnabled(enabled and gameViewOutputFramed == false);
        fitButton.SetEnabled(enabled and gameViewOutputFramed == false);
        actualSizeButton.SetEnabled(
            enabled and gameViewOutputFramed == false);
        gridButton.SetEnabled(enabled and gameViewActive == false);
        rulersButton.SetEnabled(enabled and gameViewActive == false);
        viewMenuButton.SetEnabled(true);
        layerList.SetEnabled(enabled);
        UpdateLayerActionControls();
        sceneProperties.SetEnabled(enabled);
        tilesetInspector.SetEnabled(enabled);
        hierarchySearchInput.SetEnabled(enabled);
        objectTree.SetEnabled(enabled);
        addObjectButton.SetEnabled(enabled);
        addChildObjectButton.SetEnabled(enabled);
        applyObjectButton.SetEnabled(enabled);
        removeObjectButton.SetEnabled(enabled);
        objectParentDropdown.SetEnabled(enabled);
        reparentObjectButton.SetEnabled(enabled);
        duplicateObjectButton.SetEnabled(enabled);
        objectUpButton.SetEnabled(enabled);
        objectDownButton.SetEnabled(enabled);
        objectArrangeDropdown.SetEnabled(enabled);
        arrangeObjectButton.SetEnabled(enabled);
        objectProperties.SetEnabled(enabled);
        removeObjectPropertyButton.SetEnabled(enabled);
        objectTypeInput.SetEnabled(enabled);
        objectIdInput.SetEnabled(enabled);
        objectXSpinner.SetEnabled(enabled);
        objectYSpinner.SetEnabled(enabled);
        objectAfterLayerDropdown.SetEnabled(enabled);
        objectDrawOrderSpinner.SetEnabled(enabled);
        objectDrawStackApplyButton.SetEnabled(enabled);
        objectDrawStackResetButton.SetEnabled(enabled);
        UpdateHierarchySearchControls();
        UpdateInspectorScope();
        UpdateCommandMenuButtons();
    }

    /// @brief Keep layer controls truthful at empty and draw-order boundaries.
    hide func UpdateLayerActionControls() {
        if addLayerButton == null { return; }
        var valid = editorControlsEnabled and scene != null
            and activeLayer >= 0 and activeLayer < scene.LayerCount();
        addLayerButton.SetEnabled(editorControlsEnabled and scene != null);
        removeLayerButton.SetEnabled(
            valid and scene.LayerCount() > 1);
        layerUpButton.SetEnabled(valid and activeLayer > 0);
        layerDownButton.SetEnabled(
            valid and activeLayer + 1 < scene.LayerCount());
        layerVisibleCheck.SetEnabled(valid);
        layerOpacitySpinner.SetEnabled(valid);
        layerLockCheck.SetEnabled(valid);
        layerSoloCheck.SetEnabled(valid);
        layerNameInput.SetEnabled(valid);
        layerAssetInput.SetEnabled(valid);
        chooseLayerAssetButton.SetEnabled(valid);
    }

    /// @brief Rebuild bounded inspector rows from the active model.
    /// @brief Live single-object X/Y editing with one commit per gesture.
    /// @details Spinner changes move the object in the document immediately
    ///          (matching the canvas-drag preview model); the edit serializes
    ///          exactly once when both spinners are unfocused, and Escape
    ///          while editing restores the captured position without
    ///          creating history. Canvas gestures own their own drafts.
    /// @return True when one canonical transaction committed this frame.
    hide func PumpObjectTransformDraft() -> Boolean {
        if objectDragActive or paintStrokeActive or canvasMarqueeActive
           or rectGestureMode != 0 {
            return false;
        }
        if scene == null or selectedObjects.count() != 1
           or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            objectTransformDraftActive = false;
            return false;
        }
        var edited = objectXSpinner.WasChanged()
            or objectYSpinner.WasChanged();
        if edited {
            var nextX = Convert.NumToInt(objectXSpinner.Value);
            var nextY = Convert.NumToInt(objectYSpinner.Value);
            var currentX = scene.ObjectX(selectedObject);
            var currentY = scene.ObjectY(selectedObject);
            // Echo values equal to the object are refresh noise, not edits.
            if nextX != currentX or nextY != currentY {
                if objectTransformDraftActive == false {
                    objectTransformDraftActive = true;
                    CaptureObjectDraftOrigins();
                }
                scene.SetObjectPosition(selectedObject, nextX, nextY);
                renderDirty = true;
            }
        }
        // Rotation/scale rows share the same one-gesture draft (ADR 0192);
        // the epsilon guard keeps refresh echoes from opening a draft.
        var transformEdited = objectRotationSpinner.WasChanged()
            or objectScaleXSpinner.WasChanged()
            or objectScaleYSpinner.WasChanged()
            or objectPivotXSpinner.WasChanged()
            or objectPivotYSpinner.WasChanged();
        if transformEdited {
            var nextRotation = objectRotationSpinner.Value;
            var nextScaleX = objectScaleXSpinner.Value;
            var nextScaleY = objectScaleYSpinner.Value;
            var nextPivotX = objectPivotXSpinner.Value;
            var nextPivotY = objectPivotYSpinner.Value;
            if NumberDiffers(
                   nextRotation, scene.ObjectRotation(selectedObject))
               or NumberDiffers(
                   nextScaleX, scene.ObjectScaleX(selectedObject))
               or NumberDiffers(
                   nextScaleY, scene.ObjectScaleY(selectedObject))
               or NumberDiffers(
                   nextPivotX, scene.ObjectPivotX(selectedObject))
               or NumberDiffers(
                   nextPivotY, scene.ObjectPivotY(selectedObject)) {
                if objectTransformDraftActive == false {
                    objectTransformDraftActive = true;
                    CaptureObjectDraftOrigins();
                }
                scene.SetObjectRotation(selectedObject, nextRotation);
                scene.SetObjectScale(
                    selectedObject, nextScaleX, nextScaleY);
                scene.SetObjectPivot(
                    selectedObject, nextPivotX, nextPivotY);
                renderDirty = true;
            }
        }
        if objectTransformDraftActive == false { return false; }
        var editingFocused = objectXSpinner.IsFocused()
            or objectYSpinner.IsFocused()
            or objectRotationSpinner.IsFocused()
            or objectScaleXSpinner.IsFocused()
            or objectScaleYSpinner.IsFocused()
            or objectPivotXSpinner.IsFocused()
            or objectPivotYSpinner.IsFocused();
        if editingFocused
           and Input.Keyboard.WasPressed(Input.Key.Escape) {
            scene.SetObjectPosition(
                selectedObject, objectDraftOriginX, objectDraftOriginY);
            scene.SetObjectRotation(
                selectedObject, objectDraftOriginRotation);
            scene.SetObjectScale(
                selectedObject,
                objectDraftOriginScaleX, objectDraftOriginScaleY);
            scene.SetObjectPivot(
                selectedObject,
                objectDraftOriginPivotX, objectDraftOriginPivotY);
            objectTransformDraftActive = false;
            gestureEscapeConsumed = true;
            RefreshObjectFields();
            renderDirty = true;
            toolbarStatus.SetText("Transform edit canceled");
            return false;
        }
        // A completed value scrub commits its gesture immediately, mirroring
        // canvas-drag release; typed edits still commit when focus leaves.
        var scrubFinished = objectXSpinner.WasScrubFinished()
            or objectYSpinner.WasScrubFinished()
            or objectRotationSpinner.WasScrubFinished()
            or objectScaleXSpinner.WasScrubFinished()
            or objectScaleYSpinner.WasScrubFinished()
            or objectPivotXSpinner.WasScrubFinished()
            or objectPivotYSpinner.WasScrubFinished();
        if editingFocused and scrubFinished == false { return false; }
        objectTransformDraftActive = false;
        return CommitScene("Transformed object");
    }

    /// @brief Capture every draft origin when a transform gesture opens.
    hide func CaptureObjectDraftOrigins() {
        objectDraftOriginX = scene.ObjectX(selectedObject);
        objectDraftOriginY = scene.ObjectY(selectedObject);
        objectDraftOriginRotation = scene.ObjectRotation(selectedObject);
        objectDraftOriginScaleX = scene.ObjectScaleX(selectedObject);
        objectDraftOriginScaleY = scene.ObjectScaleY(selectedObject);
        objectDraftOriginPivotX = scene.ObjectPivotX(selectedObject);
        objectDraftOriginPivotY = scene.ObjectPivotY(selectedObject);
    }

    /// @brief Format one raw RGBA tint as eight uppercase hex digits.
    hide func TintHexText(rgba: Integer) -> String {
        var digits = "0123456789ABCDEF";
        var text = "";
        var shift = 28;
        while shift >= 0 {
            var nibble = rgba / PowerOfTwo(shift) % 16;
            text = text + Str.MidLen(digits, nibble, 1);
            shift = shift - 4;
        }
        return text;
    }

    /// @brief Return 2^exponent for the nibble extraction above.
    hide func PowerOfTwo(exponent: Integer) -> Integer {
        var value = 1;
        var step = 0;
        while step < exponent {
            value = value * 2;
            step = step + 1;
        }
        return value;
    }

    /// @brief Parse tint text as RRGGBBAA (or RRGGBB = opaque); -1 invalid.
    hide func TintFromHexText(text: String) -> Integer {
        var clean = Str.Trim(text);
        if Str.StartsWith(clean, "#") { clean = Str.Mid(clean, 1); }
        if Str.get_Length(clean) == 6 { clean = clean + "FF"; }
        if Str.get_Length(clean) != 8 { return -1; }
        var parsed = Parse.IntRadix(clean, 16, -1);
        if parsed < 0 { return -1; }
        return parsed;
    }

    /// @brief Commit a submitted tint as one undoable transaction.
    hide func PumpObjectTintInput() -> Boolean {
        if scene == null or selectedObjects.count() != 1
           or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            return false;
        }
        if objectTintInput.WasSubmitted() == false { return false; }
        var nextTint = TintFromHexText(objectTintInput.Text);
        if nextTint < 0 {
            detailLabel.SetText(
                "Tint must be RRGGBBAA hex (FFFFFFFF clears it).");
            RefreshObjectFields();
            return false;
        }
        if nextTint == scene.ObjectTint(selectedObject) { return false; }
        var previousTint = scene.ObjectTint(selectedObject);
        scene.SetObjectTint(selectedObject, nextTint);
        if CommitScene("Tinted object") == false {
            scene.SetObjectTint(selectedObject, previousTint);
            RefreshObjectFields();
            return false;
        }
        detailLabel.SetText("");
        renderDirty = true;
        return true;
    }

    /// @brief Whether two authored numbers differ beyond echo noise.
    hide func NumberDiffers(next: Number, current: Number) -> Boolean {
        var delta = next - current;
        if delta < 0.0 { delta = 0.0 - delta; }
        return delta > 0.0005;
    }

    /// @brief Commit flip toggles as immediate one-transaction edits.
    hide func PumpObjectFlipControls() -> Boolean {
        if scene == null or selectedObjects.count() != 1
           or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            return false;
        }
        var toggledX = objectFlipXCheck.WasChanged();
        var toggledY = objectFlipYCheck.WasChanged();
        if toggledX == false and toggledY == false { return false; }
        var nextFlipX = objectFlipXCheck.IsChecked();
        var nextFlipY = objectFlipYCheck.IsChecked();
        if nextFlipX == scene.ObjectFlipX(selectedObject)
           and nextFlipY == scene.ObjectFlipY(selectedObject) {
            return false;
        }
        var previousFlipX = scene.ObjectFlipX(selectedObject);
        var previousFlipY = scene.ObjectFlipY(selectedObject);
        scene.SetObjectFlip(selectedObject, nextFlipX, nextFlipY);
        if CommitScene("Flipped object") == false {
            scene.SetObjectFlip(
                selectedObject, previousFlipX, previousFlipY);
            RefreshObjectFields();
            return false;
        }
        renderDirty = true;
        return true;
    }

    /// @brief Consume stale object-spinner change edges after programmatic
    ///        SetValue refreshes so they cannot masquerade as user edits.
    hide func DrainObjectSpinnerEdges() {
        if objectXSpinner == null { return; }
        objectXSpinner.WasChanged();
        objectYSpinner.WasChanged();
        objectRotationSpinner.WasChanged();
        objectScaleXSpinner.WasChanged();
        objectScaleYSpinner.WasChanged();
        objectPivotXSpinner.WasChanged();
        objectPivotYSpinner.WasChanged();
        objectFlipXCheck.WasChanged();
        objectFlipYCheck.WasChanged();
    }

    /// @brief Show only inspector groups relevant to the current selection.
    /// @details Object-scoped fields and groups appear with selected objects;
    ///          scene-scoped groups (setup, imports, scene properties,
    ///          camera/lighting, layers, tile behavior, and the palette
    ///          strip) stay with the loaded scene. Pure presentation: no
    ///          canonical bytes, history, or selection state changes here.
    hide func UpdateInspectorScope() {
        if objectFieldsLabel == null { return; }
        var hasScene = scene != null;
        var hasSelection = hasScene and selectedObjects.count() > 0;
        var objectTab = hasScene and inspectorSceneTab == false;
        var sceneTab = hasScene and inspectorSceneTab;
        var objectScope = objectTab and hasSelection;
        objectTabButton.SetVisible(hasScene);
        sceneTabButton.SetVisible(hasScene);
        objectTabButton.SetStyle(0);
        sceneTabButton.SetStyle(0);
        if sceneTab { sceneTabButton.SetStyle(1); }
        if objectTab { objectTabButton.SetStyle(1); }
        objectTabHost.SetVisible(objectTab);
        sceneTabHost.SetVisible(sceneTab);
        objectFieldsLabel.SetVisible(objectScope);
        objectTypeInput.SetVisible(objectScope);
        objectIdInput.SetVisible(objectScope);
        objectPositionRow.SetVisible(objectScope);
        objectTransformRow.SetVisible(
            objectScope and selectedObjects.count() == 1);
        objectDrawStackGroup.SetVisible(
            objectScope and selectedObjects.count() == 1);
        objectArrangeRow.SetVisible(objectScope);
        objectPropertyLabel.SetVisible(objectScope);
        objectProperties.host.SetVisible(objectScope);
        objectProperties.addButton.SetVisible(objectScope);
        removeObjectPropertyButton.SetVisible(
            objectScope and selectedObjects.count() > 1);
        // X/Y edits commit live and the id/type fields commit on Enter, so
        // the explicit Apply is retired from the visible surface.
        applyObjectButton.SetVisible(false);
        // Keep project recipes available on the Object tab without a
        // selection so gameplay-ready objects need no generic placeholder.
        componentPalette.group.SetVisible(objectTab);
        componentAssetHost.SetVisible(objectScope);
        tilesetInspector.group.SetVisible(hasScene);
        // Scope storms reflow the whole inspector column; force a complete
        // re-measure/arrange/repaint so no child keeps partial-pass geometry.
        if inspectorScroll != null {
            inspectorScroll.InvalidateLayout();
            inspectorScroll.InvalidatePaint();
        }
    }

    /// @brief Choose the Object or Scene inspector tab (workspace-only).
    /// @details Selection changes auto-follow: selecting objects returns to
    ///          Object, clearing the selection returns to Scene.
    expose func SetInspectorSceneTab(sceneTab: Boolean) {
        if inspectorSceneTab == sceneTab { return; }
        inspectorSceneTab = sceneTab;
        UpdateInspectorScope();
    }

    /// @brief Remove hostile, duplicate, or stale layer workspace indices.
    hide func NormalizeLayerWorkspaceState() {
        if scene == null {
            lockedLayers = [];
            soloLayer = -1;
            return;
        }
        var normalized: List[Integer] = [];
        var index = 0;
        while index < lockedLayers.count() {
            var layer = lockedLayers.get(index);
            var duplicate = false;
            var prior = 0;
            while prior < normalized.count() {
                if normalized.get(prior) == layer { duplicate = true; }
                prior = prior + 1;
            }
            if layer >= 0 and layer < scene.LayerCount()
               and duplicate == false {
                normalized.add(layer);
            }
            index = index + 1;
        }
        lockedLayers = normalized;
        if soloLayer < 0 or soloLayer >= scene.LayerCount() {
            soloLayer = -1;
        }
        if currentDoc != null and currentDoc.scene2DWorkspace != null {
            currentDoc.scene2DWorkspace.lockedLayers = lockedLayers;
            currentDoc.scene2DWorkspace.soloLayer = soloLayer;
        }
    }

    /// @brief Compose one scannable layer navigator row.
    hide func LayerNavigatorLabel(layer: Integer) -> String {
        if scene == null or layer < 0 or layer >= scene.LayerCount() {
            return "○ (missing layer)";
        }
        var label = "○ ";
        if scene.LayerVisible(layer) { label = "● "; }
        if LayerLocked(layer) { label = label + "⊘ "; }
        if soloLayer == layer { label = label + "SOLO "; }
        label = label + scene.LayerName(layer);
        var opacityPercent = Convert.NumToInt(
            scene.LayerOpacity(layer) * 100.0 + 0.5);
        if opacityPercent < 100 {
            label = label + "  " + opacityPercent + "%";
        }
        return label;
    }

    /// @brief Tint exceptional layer states without obscuring row text.
    hide func LayerNavigatorColor(layer: Integer) -> Integer {
        if soloLayer == layer { return Color.RGB(102, 220, 190); }
        if LayerLocked(layer) { return Color.RGB(239, 190, 86); }
        if scene != null and layer >= 0 and layer < scene.LayerCount()
           and scene.LayerVisible(layer) == false {
            return Color.RGB(142, 151, 164);
        }
        return Color.RGB(225, 231, 238);
    }

    /// @brief Refresh only fixed-height layer rows and their active selection.
    hide func RefreshLayerNavigator() {
        if layerList == null { return; }
        layerList.Clear();
        layerListItems = [];
        if scene == null { return; }
        var layerCount = scene.LayerCount();
        if activeLayer < 0 or activeLayer >= layerCount { activeLayer = 0; }
        NormalizeLayerWorkspaceState();
        var layer = 0;
        while layer < layerCount {
            var item = layerList.AddItem(LayerNavigatorLabel(layer));
            layerListItems.add(item);
            if item != null {
                GUI.ListBox.ItemSetData(item, "" + layer);
                GUI.ListBox.ItemSetTextColor(
                    item, LayerNavigatorColor(layer));
            }
            layer = layer + 1;
        }
        if layerCount > 0 { layerList.SelectIndex(activeLayer); }
        UpdateLayerActionControls();
    }

    /// @brief Update live row cues without rebuilding or scrolling the list.
    hide func RefreshLayerNavigatorRows() {
        if scene == null { return; }
        var layer = 0;
        while layer < layerListItems.count()
              and layer < scene.LayerCount() {
            var item = layerListItems.get(layer);
            if item != null {
                GUI.ListBox.ItemSetText(
                    item, LayerNavigatorLabel(layer));
                GUI.ListBox.ItemSetTextColor(
                    item, LayerNavigatorColor(layer));
            }
            layer = layer + 1;
        }
        UpdateLayerActionControls();
    }

    hide func RefreshInspector() {
        UpdateInspectorScope();
        layerList.Clear();
        layerListItems = [];
        sceneProperties.Refresh(scene, editorControlsEnabled);
        selectedSceneProperty = sceneProperties.selectedProperty;
        cameraLighting.Refresh(scene, editorControlsEnabled);
        if scene == null {
            selectedObject = -1;
            selectedObjects = [];
            selectedObjectProperty = -1;
            selectedSceneProperty = -1;
            RefreshObjectTree();
            RefreshObjectFields();
            sceneInfoLabel.SetText("Invalid 2D scene");
            toolbarStatus.SetText("Scene JSON needs attention");
            return;
        }

        sceneInfoLabel.SetText(
            scene.Width + " x " + scene.Height + " tiles\n"
            + scene.TileWidth + " x " + scene.TileHeight + " px tiles"
            + "  |  " + scene.LayerCount() + " layer(s)"
            + "  |  " + scene.ObjectCount() + " object(s)");

        RefreshLayerNavigator();
        RefreshLayerFields();

        RefreshObjectTree();
        RefreshObjectFields();
    }

    hide func StringListContains(values: List[String],
                                 value: String) -> Boolean {
        var index = 0;
        while index < values.count() {
            if values.get(index) == value { return true; }
            index = index + 1;
        }
        return false;
    }

    /// @brief Snapshot expansion before replacing retained object rows.
    hide func CaptureObjectTreeExpansion() {
        objectExpandedIds = [];
        objectExpandedPaths = [];
        var sameDocument =
            currentDoc != null and objectTreeDocument == currentDoc;
        objectTreeExpandByDefault =
            objectTreeNodes.count() == 0 or sameDocument == false;
        if sameDocument == false { return; }
        var index = 0;
        while index < objectTreeNodes.count()
              and index < objectTreeIds.count()
              and index < objectTreePaths.count() {
            var treeNode = objectTreeNodes.get(index);
            if treeNode != null
               and GUI.TreeView.Node.IsExpanded(treeNode) {
                var objectId = objectTreeIds.get(index);
                if objectId != "" { objectExpandedIds.add(objectId); }
                objectExpandedPaths.add(objectTreePaths.get(index));
            }
            index = index + 1;
        }
    }

    /// @brief Return a bounded structural depth, with roots at depth zero.
    hide func ObjectHierarchyDepth(index: Integer) -> Integer {
        if scene == null or index < 0 or index >= scene.ObjectCount() {
            return MAX_OBJECT_HIERARCHY_DEPTH + 1;
        }
        var depth = 0;
        var current = index;
        var steps = 0;
        while current >= 0 and steps <= MAX_OBJECT_HIERARCHY_DEPTH {
            var parent = scene.ObjectParent(current);
            if parent < 0 { return depth; }
            depth = depth + 1;
            steps = steps + 1;
            current = parent;
        }
        return MAX_OBJECT_HIERARCHY_DEPTH + 1;
    }

    /// @brief Return whether ancestor contains candidate in the live hierarchy.
    hide func ObjectHierarchyContains(ancestor: Integer,
                                      candidate: Integer) -> Boolean {
        if scene == null or ancestor < 0 or candidate < 0
           or ancestor >= scene.ObjectCount()
           or candidate >= scene.ObjectCount() {
            return false;
        }
        var current = candidate;
        var steps = 0;
        while current >= 0 and steps <= scene.ObjectCount() {
            if current == ancestor { return true; }
            current = scene.ObjectParent(current);
            steps = steps + 1;
        }
        return false;
    }

    hide func ShouldExpandObjectNode(index: Integer,
                                     objectId: String,
                                     path: String) -> Boolean {
        var selectionIndex = 0;
        while selectionIndex < selectedObjects.count() {
            if ObjectHierarchyContains(
                   index, selectedObjects.get(selectionIndex)) {
                return true;
            }
            selectionIndex = selectionIndex + 1;
        }
        if objectTreeExpandByDefault { return true; }
        if objectId != ""
           and StringListContains(objectExpandedIds, objectId) {
            return true;
        }
        return StringListContains(objectExpandedPaths, path);
    }

    /// @brief Rebuild a bounded retained parent/child presentation.
    /// @details Depth and row limits protect the UI while preserving every
    ///          object in canonical scene data.
    hide func RefreshObjectTree() {
        if objectTree == null { return; }
        CaptureObjectTreeExpansion();
        objectTreeNodes = [];
        objectTreeIds = [];
        objectTreePaths = [];
        objectHierarchyClipped = false;
        objectTree.Clear();
        objectTree.PruneRetiredNodes();

        if scene == null {
            objectHierarchyStatus.SetText("");
            objectTreeDocument = currentDoc;
            RefreshHierarchySearch(false);
            return;
        }

        var objectCount = scene.ObjectCount();
        if selectedObject >= objectCount { selectedObject = -1; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, objectCount, selectedObject);
        if selectedObject < 0 and selectedObjects.count() > 0 {
            selectedObject = selectedObjects.get(0);
        }

        var visibleCount = objectCount;
        if visibleCount > MAX_OBJECT_TREE_ROWS {
            visibleCount = MAX_OBJECT_TREE_ROWS;
            objectHierarchyClipped = true;
        }
        var depths: List[Integer] = [];
        var hasChildren: List[Boolean] = [];
        var index = 0;
        while index < visibleCount {
            objectTreeNodes.add(null);
            objectTreeIds.add(scene.ObjectId(index));
            objectTreePaths.add("");
            depths.add(ObjectHierarchyDepth(index));
            hasChildren.add(false);
            index = index + 1;
        }
        index = 0;
        while index < objectCount {
            var parent = scene.ObjectParent(index);
            if parent >= 0 and parent < visibleCount {
                hasChildren.set(parent, true);
            }
            index = index + 1;
        }

        var rowCount = 0;
        var depth = 0;
        while depth <= MAX_OBJECT_HIERARCHY_DEPTH
              and rowCount < MAX_OBJECT_TREE_ROWS {
            index = 0;
            while index < visibleCount
                  and rowCount < MAX_OBJECT_TREE_ROWS {
                if depths.get(index) == depth {
                    var parentIndex = scene.ObjectParent(index);
                    var parentTreeNode: Any = null;
                    var path = Fmt.Int(index);
                    var canAppend = parentIndex < 0;
                    if parentIndex >= 0 and parentIndex < visibleCount
                       and objectTreeNodes.get(parentIndex) != null {
                        parentTreeNode = objectTreeNodes.get(parentIndex);
                        path = objectTreePaths.get(parentIndex)
                            + "/" + Fmt.Int(index);
                        canAppend = true;
                    }
                    if canAppend {
                        var objectId = scene.ObjectId(index);
                        var displayId = objectId;
                        if displayId == "" { displayId = "(unnamed)"; }
                        var treeNode = objectTree.AddNode(
                            parentTreeNode,
                            displayId + "  :  " + scene.ObjectType(index)
                            + "  @ " + scene.ObjectX(index)
                            + ", " + scene.ObjectY(index));
                        if treeNode == null {
                            objectHierarchyClipped = true;
                        } else {
                            GUI.TreeView.Node.SetData(
                                treeNode, Fmt.Int(index));
                            GUI.TreeView.Node.SetStableId(
                                treeNode, objectId + "|" + path);
                            objectTreeNodes.set(index, treeNode);
                            objectTreePaths.set(index, path);
                            rowCount = rowCount + 1;
                        }
                    } else {
                        objectHierarchyClipped = true;
                    }
                } else if depths.get(index)
                          > MAX_OBJECT_HIERARCHY_DEPTH {
                    objectHierarchyClipped = true;
                }
                index = index + 1;
            }
            depth = depth + 1;
        }

        index = 0;
        while index < visibleCount {
            var node = objectTreeNodes.get(index);
            if node != null {
                var icon = "◇";
                if hasChildren.get(index) { icon = "◆"; }
                GUI.TreeView.Node.SetIcon(node, icon);
                if hasChildren.get(index)
                   and ShouldExpandObjectNode(
                       index,
                       objectTreeIds.get(index),
                       objectTreePaths.get(index)) {
                    objectTree.Expand(node);
                }
            }
            index = index + 1;
        }

        if rowCount < objectCount { objectHierarchyClipped = true; }
        if objectHierarchyClipped {
            objectHierarchyStatus.SetText(
                "Hierarchy view is bounded to "
                + MAX_OBJECT_TREE_ROWS + " rows and depth "
                + MAX_OBJECT_HIERARCHY_DEPTH
                + "; hidden objects remain preserved in the scene.");
        } else {
            objectHierarchyStatus.SetText("");
        }
        objectTreeDocument = currentDoc;
        RestoreObjectTreeSelection();
        RefreshHierarchySearch(false);
        objectExpandedIds = [];
        objectExpandedPaths = [];
    }

    /// @brief Route scene-wide metadata drafts into canonical transactions.
    hide func PumpScenePropertyControls() -> Boolean {
        if scene == null { return false; }
        sceneProperties.Pump(scene);
        selectedSceneProperty = sceneProperties.selectedProperty;
        var changed = false;
        var commitRow = sceneProperties.TakeCommitRow();
        if commitRow >= 0 {
            changed = SetSceneProperty(
                sceneProperties.CanonicalKeyAt(commitRow),
                sceneProperties.KeyTextAt(commitRow),
                sceneProperties.KindTokenAt(commitRow),
                sceneProperties.ValueTextAt(commitRow));
        }
        var removeRow = sceneProperties.TakeRemoveRow();
        if removeRow >= 0 {
            changed = RemoveSceneProperty(
                sceneProperties.CanonicalKeyAt(removeRow)) or changed;
        }
        return changed;
    }

    /// @brief Reveal the retained ancestors of one programmatic selection.
    hide func ExpandObjectTreeAncestors(index: Integer) {
        if scene == null or objectTree == null
           or index < 0 or index >= scene.ObjectCount() {
            return;
        }
        var parent = scene.ObjectParent(index);
        var steps = 0;
        while parent >= 0 and steps <= scene.ObjectCount() {
            if parent < objectTreeNodes.count()
               and objectTreeNodes.get(parent) != null {
                objectTree.Expand(objectTreeNodes.get(parent));
            }
            parent = scene.ObjectParent(parent);
            steps = steps + 1;
        }
    }

    /// @brief Restore every validated hierarchy row while keeping one primary.
    hide func RestoreObjectTreeSelection() {
        if objectTree == null { return; }
        objectTree.Select(null);
        var index = 0;
        while index < selectedObjects.count() {
            var selected = selectedObjects.get(index);
            if selected != selectedObject
               and selected >= 0 and selected < objectTreeNodes.count()
               and objectTreeNodes.get(selected) != null {
                objectTree.Select(objectTreeNodes.get(selected));
            }
            index = index + 1;
        }
        if selectedObject >= 0
           and selectedObject < objectTreeNodes.count()
           and objectTreeNodes.get(selectedObject) != null {
            objectTree.Select(objectTreeNodes.get(selectedObject));
        }
    }

    /// @brief Resolve the selected dropdown row to one object parent identity.
    hide func SelectedObjectParentTargetIndex() -> Integer {
        if objectParentDropdown == null
           or objectParentDropdown.Selected < 0
           or objectParentDropdown.Selected
              >= objectParentTargetIndices.count() {
            return OBJECT_PARENT_TARGET_MIXED;
        }
        return objectParentTargetIndices.get(
            objectParentDropdown.Selected);
    }

    /// @brief Select one currently offered parent without changing scene data.
    /// @details Probe and command callers use this instead of synthesizing a
    ///          platform-specific native dropdown click.
    expose func SelectObjectParentTarget(
        targetIndex: Integer) -> Boolean {
        if objectParentDropdown == null { return false; }
        var option = 0;
        while option < objectParentTargetIndices.count() {
            if objectParentTargetIndices.get(option) == targetIndex {
                objectParentDropdown.SetSelected(option);
                UpdateObjectParentControlAvailability();
                return true;
            }
            option = option + 1;
        }
        return false;
    }

    /// @brief Rebuild bounded, cycle-safe parent choices for the selection.
    hide func RefreshObjectParentTargets() {
        if objectParentDropdown == null
           or reparentObjectButton == null {
            return;
        }
        objectParentDropdown.Clear();
        objectParentTargetIndices = [];
        if scene == null or selectedObjects.count() == 0 {
            objectParentDropdown.SetPlaceholder("Select an object");
            objectParentDropdown.SetEnabled(false);
            reparentObjectButton.SetEnabled(false);
            reparentObjectButton.SetText("Reparent");
            return;
        }

        var parents = SnapshotObjectParents();
        var roots = TopLevelSelectedObjectRoots(parents);
        if roots.count() == 0 {
            objectParentDropdown.SetPlaceholder("Select an object");
            objectParentDropdown.SetEnabled(false);
            reparentObjectButton.SetEnabled(false);
            return;
        }
        var owners = SelectedRootOwners(parents, roots);
        var depths = IdentityDepths(parents);
        var commonParent = parents.get(roots.get(0));
        var mixedParents = false;
        var rootIndex = 1;
        while rootIndex < roots.count() {
            if parents.get(roots.get(rootIndex)) != commonParent {
                mixedParents = true;
            }
            rootIndex = rootIndex + 1;
        }

        var selectedOption = -1;
        if mixedParents {
            selectedOption = objectParentDropdown.AddItem(
                "Multiple parents — choose target");
            objectParentTargetIndices.add(
                OBJECT_PARENT_TARGET_MIXED);
        }
        if ObjectDropFitsKnownDepths(-1, depths, owners) {
            var rootOption =
                objectParentDropdown.AddItem("Scene root");
            objectParentTargetIndices.add(-1);
            if mixedParents == false and commonParent < 0 {
                selectedOption = rootOption;
            }
        }

        var candidateLimit = scene.ObjectCount();
        if candidateLimit > MAX_OBJECT_TREE_ROWS {
            candidateLimit = MAX_OBJECT_TREE_ROWS;
        }
        var candidate = 0;
        while candidate < candidateLimit {
            if owners.get(candidate) < 0
               and ObjectDropFitsKnownDepths(
                       candidate, depths, owners) {
                var prefix = "";
                var depth = ObjectHierarchyDepth(candidate);
                var indent = 0;
                while indent < depth and indent < 16 {
                    prefix = prefix + "  ";
                    indent = indent + 1;
                }
                var displayId = scene.ObjectId(candidate);
                if displayId == "" { displayId = "(unnamed)"; }
                var option = objectParentDropdown.AddItem(
                    prefix + displayId + " : "
                    + scene.ObjectType(candidate));
                objectParentTargetIndices.add(candidate);
                if mixedParents == false
                   and commonParent == candidate {
                    selectedOption = option;
                }
            }
            candidate = candidate + 1;
        }

        if selectedOption < 0
           and objectParentTargetIndices.count() > 0 {
            selectedOption = 0;
        }
        if selectedOption >= 0 {
            objectParentDropdown.SetSelected(selectedOption);
        }
        var placeholder = "Choose parent";
        if scene.ObjectCount() > candidateLimit {
            placeholder = "Choose parent (bounded hierarchy view)";
        }
        objectParentDropdown.SetPlaceholder(placeholder);
        UpdateObjectParentControlAvailability();
    }

    /// @brief Enable explicit reparenting only for a changed valid target.
    hide func UpdateObjectParentControlAvailability() {
        if objectParentDropdown == null
           or reparentObjectButton == null {
            return;
        }
        var available = false;
        var rootCount = 0;
        if scene != null and selectedObjects.count() > 0 {
            var parents = SnapshotObjectParents();
            var roots = TopLevelSelectedObjectRoots(parents);
            rootCount = roots.count();
            var owners = SelectedRootOwners(parents, roots);
            var depths = IdentityDepths(parents);
            var target = SelectedObjectParentTargetIndex();
            var targetValid = target == -1
                or (target >= 0 and target < scene.ObjectCount());
            var targetOutsideSelection = target < 0
                or owners.get(target) < 0;
            var alreadyParented = roots.count() > 0;
            var rootIndex = 0;
            while rootIndex < roots.count() {
                if parents.get(roots.get(rootIndex)) != target {
                    alreadyParented = false;
                }
                rootIndex = rootIndex + 1;
            }
            available = roots.count() > 0
                and targetValid
                and targetOutsideSelection
                and ObjectDropFitsKnownDepths(
                        target, depths, owners)
                and alreadyParented == false;
        }
        objectParentDropdown.SetEnabled(
            rootCount > 0 and objectParentTargetIndices.count() > 0);
        reparentObjectButton.SetEnabled(available);
        reparentObjectButton.SetText("Reparent");
        if rootCount > 1 {
            reparentObjectButton.SetText(
                "Reparent (" + rootCount + ")");
        }
        reparentObjectButton.SetTooltip(
            "Move " + rootCount
            + " selected top-level subtree(s) beneath the chosen parent; "
            + "absolute positions stay unchanged");
    }

    hide func RefreshLayerFields() {
        if scene == null or activeLayer < 0
           or activeLayer >= scene.LayerCount() {
            layerVisibleCheck.SetChecked(false);
            layerVisibleRevision = layerVisibleCheck.GetRevision();
            layerOpacitySpinner.SetValue(1.0);
            layerOpacityRevision = layerOpacitySpinner.GetRevision();
            layerLockCheck.SetChecked(false);
            layerLockRevision = layerLockCheck.GetRevision();
            layerSoloCheck.SetChecked(false);
            layerSoloRevision = layerSoloCheck.GetRevision();
            layerNameInput.SetText("");
            layerAssetInput.SetText("");
            UpdateLayerActionControls();
            RefreshTilesetPalette();
            return;
        }
        layerVisibleCheck.SetChecked(scene.LayerVisible(activeLayer));
        layerVisibleRevision = layerVisibleCheck.GetRevision();
        layerOpacitySpinner.SetValue(scene.LayerOpacity(activeLayer));
        layerOpacityRevision = layerOpacitySpinner.GetRevision();
        layerLockCheck.SetChecked(LayerLocked(activeLayer));
        layerLockRevision = layerLockCheck.GetRevision();
        layerSoloCheck.SetChecked(soloLayer == activeLayer);
        layerSoloRevision = layerSoloCheck.GetRevision();
        layerNameInput.SetText(scene.LayerName(activeLayer));
        layerAssetInput.SetText(scene.LayerAsset(activeLayer));
        UpdateLayerActionControls();
        RefreshTilesetPalette();
    }

    /// @brief Reload bounded image previews after scene/path/asset changes.
    hide func ReloadTilesets() {
        if tilesets == null { return; }
        var docPath = "";
        if currentDoc != null { docPath = currentDoc.filePath; }
        tilesets.Reload(scene, docPath);
        tilesetDocumentPath = docPath;
        renderDirty = true;
    }

    /// @brief Refresh the active layer's scrollable visual tile chooser.
    hide func RefreshTilesetPalette() {
        if tilesetInspector == null or tileSpinner == null { return; }
        tilesetInspector.RefreshMarked(
            tilesets,
            activeLayer,
            Convert.NumToInt(tileSpinner.Value),
            BehaviorMarkedTiles(),
            revision);
        RefreshTileBehavior();
    }

    /// @brief Collect palette-range tile ids carrying any authored behavior.
    hide func BehaviorMarkedTiles() -> List[Integer] {
        var marked: List[Integer] = [];
        if scene == null { return marked; }
        AddMarkedTiles(marked, scene.CollisionTiles());
        AddMarkedTiles(marked, scene.TilePropertyTiles());
        AddMarkedTiles(marked, scene.TileAnimBases());
        AddMarkedTiles(marked, scene.AutotileBases());
        return marked;
    }

    /// @brief Append bounded unique palette-range ids from one runtime list.
    hide func AddMarkedTiles(marked: List[Integer], tiles: Any) {
        var count = Seq.get_Count(tiles);
        var index = 0;
        while index < count {
            var tile = Box.ToI64(Seq.Get(tiles, index));
            index = index + 1;
            if tile < 1 or tile > 512 { continue; }
            var existing = 0;
            var found = false;
            while existing < marked.count() {
                if marked.get(existing) == tile { found = true; }
                existing = existing + 1;
            }
            if found == false { marked.add(tile); }
        }
    }

    /// @brief Rebuild the tile-behavior inspector from canonical scene state.
    hide func RefreshTileBehavior() {
        if tileBehavior == null or tileSpinner == null { return; }
        tileBehavior.Refresh(
            scene,
            Convert.NumToInt(tileSpinner.Value),
            editorControlsEnabled);
    }

    /// @brief Route a palette click into the same tile selection as the spinner.
    hide func PumpTilesetPalette() {
        if tilesetInspector == null { return; }
        var tileId =
            tilesetInspector.TakeSelectedTile(tilesets, activeLayer);
        if tileId > 0 { SelectPaletteTile(tileId); }
    }

    /// @brief Human-readable effective layer placement for inspector status.
    hide func ObjectDrawStackLayerText(afterLayer: Integer) -> String {
        if scene == null or scene.LayerCount() <= 0 {
            return "after all tile layers";
        }
        if afterLayer < 0 { return "before all tile layers"; }
        var clamped = afterLayer;
        if clamped >= scene.LayerCount() {
            clamped = scene.LayerCount() - 1;
        }
        return "after layer " + (clamped + 1)
            + " · " + scene.LayerName(clamped);
    }

    /// @brief Rebuild the selected object's direct preview-stack controls.
    hide func RefreshObjectDrawStackControls(hasSingle: Boolean) {
        if objectAfterLayerDropdown == null { return; }
        objectAfterLayerDropdown.Clear();
        objectAfterLayerDropdown.AddItem("Before all tile layers");
        if scene != null {
            var layer = 0;
            while layer < scene.LayerCount() {
                objectAfterLayerDropdown.AddItem(
                    "After " + (layer + 1) + " · "
                    + scene.LayerName(layer));
                layer = layer + 1;
            }
        }
        var enabled = editorControlsEnabled and hasSingle;
        objectAfterLayerDropdown.SetEnabled(enabled);
        objectDrawOrderSpinner.SetEnabled(enabled);
        objectDrawStackApplyButton.SetEnabled(enabled);
        if hasSingle == false {
            objectAfterLayerDropdown.SetSelected(0);
            objectDrawOrderSpinner.SetValue(0.0);
            objectDrawStackResetButton.SetEnabled(false);
            objectDrawStackSummary.SetText(
                "Select one object to inspect its game-like preview order.");
            return;
        }
        var effectiveLayer = ObjectPreviewAfterLayer(selectedObject);
        var selectedLayer = effectiveLayer + 1;
        if selectedLayer < 0 { selectedLayer = 0; }
        if selectedLayer > scene.LayerCount() {
            selectedLayer = scene.LayerCount();
        }
        objectAfterLayerDropdown.SetSelected(selectedLayer);
        objectDrawOrderSpinner.SetValue(
            ObjectPreviewDrawOrder(selectedObject));
        var explicitLayer = scene.ObjectPropertyKind(
            selectedObject,
            scene_object_draw_stack_2d.EXPLICIT_AFTER_LAYER_KEY) != "";
        var explicitOrder = scene.ObjectPropertyKind(
            selectedObject,
            scene_object_draw_stack_2d.EXPLICIT_DRAW_ORDER_KEY) != "";
        var hasOverride = explicitLayer or explicitOrder;
        objectDrawStackResetButton.SetEnabled(
            editorControlsEnabled and hasOverride);
        var source = "Project/default";
        if hasOverride { source = "Per-object override"; }
        objectDrawStackSummary.SetText(
            source + ": " + ObjectDrawStackLayerText(effectiveLayer)
            + ", priority " + ObjectPreviewDrawOrder(selectedObject)
            + ". Higher priorities paint and pick later.");
    }

    hide func RefreshObjectFields() {
        var objectCount = 0;
        if scene != null { objectCount = scene.ObjectCount(); }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, objectCount, selectedObject);
        // Auto-follow the Object/Scene tab on selection-presence changes
        // only, so a manual tab choice survives ordinary refreshes.
        var scopeHasSelection = selectedObjects.count() > 0;
        if scopeHasSelection != inspectorAutoFollowHadSelection {
            inspectorAutoFollowHadSelection = scopeHasSelection;
            inspectorSceneTab = scopeHasSelection == false;
        }
        UpdateInspectorScope();
        var hasSelection = scene != null and selectedObject >= 0
            and selectedObject < objectCount
            and selectedObjects.count() > 0;
        var hasSingle = hasSelection and selectedObjects.count() == 1;
        addChildObjectButton.SetEnabled(hasSingle);
        applyObjectButton.SetEnabled(hasSingle);
        removeObjectButton.SetEnabled(hasSelection);
        duplicateObjectButton.SetEnabled(hasSelection);
        objectUpButton.SetEnabled(
            hasSingle and PreviousObjectSibling(selectedObject) >= 0);
        objectDownButton.SetEnabled(
            hasSingle and NextObjectSibling(selectedObject) >= 0);
        objectTypeInput.SetEnabled(hasSingle);
        objectIdInput.SetEnabled(hasSingle);
        objectXSpinner.SetEnabled(hasSingle);
        objectYSpinner.SetEnabled(hasSingle);
        objectRotationSpinner.SetEnabled(hasSingle);
        objectScaleXSpinner.SetEnabled(hasSingle);
        objectScaleYSpinner.SetEnabled(hasSingle);
        objectFlipXCheck.SetEnabled(hasSingle);
        objectFlipYCheck.SetEnabled(hasSingle);
        objectPivotXSpinner.SetEnabled(hasSingle);
        objectPivotYSpinner.SetEnabled(hasSingle);
        objectTintInput.SetEnabled(hasSingle);
        RefreshObjectDrawStackControls(hasSingle);
        RefreshObjectParentTargets();
        RefreshObjectArrangeControls(hasSelection);
        removeObjectButton.SetText("Remove");
        duplicateObjectButton.SetText("Duplicate");
        objectTypeInput.SetPlaceholder("Object type");
        objectIdInput.SetPlaceholder("Object id");
        if hasSingle == false {
            objectTypeInput.SetText("");
            objectIdInput.SetText("");
            objectXSpinner.SetValue(0.0);
            objectYSpinner.SetValue(0.0);
            objectRotationSpinner.SetValue(0.0);
            objectScaleXSpinner.SetValue(1.0);
            objectScaleYSpinner.SetValue(1.0);
            objectFlipXCheck.SetChecked(false);
            objectFlipYCheck.SetChecked(false);
            objectPivotXSpinner.SetValue(0.5);
            objectPivotYSpinner.SetValue(0.5);
            objectTintInput.SetText("");
            selectedObjectProperty = -1;
            if hasSelection {
                removeObjectButton.SetText(
                    "Remove (" + selectedObjects.count() + ")");
                duplicateObjectButton.SetText(
                    "Duplicate (" + selectedObjects.count() + ")");
                objectTypeInput.SetPlaceholder(
                    selectedObjects.count() + " objects selected");
                objectIdInput.SetPlaceholder(
                    "Single-object fields disabled for group selection");
            }
            RefreshObjectProperties();
            RefreshComponentPalette();
            return;
        }
        objectTypeInput.SetText(scene.ObjectType(selectedObject));
        objectIdInput.SetText(scene.ObjectId(selectedObject));
        objectXSpinner.SetValue(scene.ObjectX(selectedObject));
        objectYSpinner.SetValue(scene.ObjectY(selectedObject));
        objectRotationSpinner.SetValue(
            scene.ObjectRotation(selectedObject));
        objectScaleXSpinner.SetValue(scene.ObjectScaleX(selectedObject));
        objectScaleYSpinner.SetValue(scene.ObjectScaleY(selectedObject));
        objectFlipXCheck.SetChecked(scene.ObjectFlipX(selectedObject));
        objectFlipYCheck.SetChecked(scene.ObjectFlipY(selectedObject));
        objectPivotXSpinner.SetValue(scene.ObjectPivotX(selectedObject));
        objectPivotYSpinner.SetValue(scene.ObjectPivotY(selectedObject));
        objectTintInput.SetText(
            TintHexText(scene.ObjectTint(selectedObject)));
        RefreshObjectProperties();
        RefreshComponentPalette();
    }

    /// @brief Summarize selected-object coverage for the active component.
    hide func RefreshComponentPalette() {
        if componentPalette == null or componentPalette.group == null {
            return;
        }
        var objectCount = 0;
        if scene != null { objectCount = scene.ObjectCount(); }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, objectCount, selectedObject);
        var component = componentPalette.SelectedComponent();
        var enabled = scene != null and selectedObjects.count() > 0
            and component != null;
        var present = 0;
        var missing = 0;
        var conflicts = 0;
        if enabled {
            var selectionIndex = 0;
            while selectionIndex < selectedObjects.count() {
                var objectIndex = selectedObjects.get(selectionIndex);
                var fieldIndex = 0;
                while fieldIndex < component.fields.count() {
                    var field = component.fields.get(fieldIndex);
                    if scene.ObjectHas(objectIndex, field.key) == false {
                        missing = missing + 1;
                    } else if scene.ObjectPropertyKind(
                                  objectIndex, field.key)
                               == scene_component_schema.ValueKind(
                                      field.kind) {
                        present = present + 1;
                    } else {
                        conflicts = conflicts + 1;
                    }
                    fieldIndex = fieldIndex + 1;
                }
                selectionIndex = selectionIndex + 1;
            }
        }
        componentPalette.SetCreationContext(
            scene != null, "Create Object");
        componentPalette.SetContext(enabled, present, missing, conflicts);
    }

    /// @brief Copy one schema field into the raw typed-property controls.
    /// @details A matching single-object value is retained for editing;
    ///          otherwise the schema default becomes the draft.
    expose func EditSelectedComponentField() -> Boolean {
        if scene == null or componentPalette == null { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        var field = componentPalette.SelectedField();
        if field == null or selectedObjects.count() == 0 { return false; }

        var value = field.defaultText;
        selectedObjectProperty = -1;
        if selectedObjects.count() == 1 and selectedObject >= 0
           and selectedObject < scene.ObjectCount()
           and scene.ObjectHas(selectedObject, field.key)
           and scene.ObjectPropertyKind(selectedObject, field.key)
              == scene_component_schema.ValueKind(field.kind) {
            value = PropertyValueText(
                selectedObject,
                field.key,
                scene_component_schema.ValueKind(field.kind));
        }

        StageObjectPropertyDraft(
            field.key,
            scene_component_schema.ValueKind(field.kind),
            value,
            field.kind == "null");
        if field.kind == "asset" {
            componentAssetBrowser.SetExtensions(
                file_utils.AssetKindListExtensions(field.assetKinds));
            componentAssetBrowser.Open();
            detailLabel.SetText(
                "Editing " + field.label
                + ". Browse the filtered project assets or type a "
                + "reference in the raw typed-property controls.");
        } else {
            detailLabel.SetText(
                "Editing " + field.label
                + " in the raw typed-property controls.");
        }
        return true;
    }

    /// @brief Return the selected asset-kind schema field, or null.
    hide func SelectedAssetComponentField()
        -> scene_component_schema.SceneComponentField {
        if componentPalette == null { return null; }
        var field = componentPalette.SelectedField();
        if field == null or field.kind != "asset" { return null; }
        return field;
    }

    /// @brief Stage one browsed asset path into the property draft.
    /// @details Fixes the ADR 0178 deferral for 2D objects: the bounded
    ///          workspace browser stages a portable reference and the
    ///          canonical write still flows through Save Property.
    hide func ApplyComponentAssetPath(assetPath: String) {
        var field = SelectedAssetComponentField();
        if field == null { return; }
        var documentPath = "";
        if currentDoc != null { documentPath = currentDoc.filePath; }
        var portable = scene_asset_browser.PortableReferencePath(
            assetPath, documentPath);
        if portable == "" { return; }
        StageObjectPropertyDraft(
            field.key,
            scene_component_schema.ValueKind(field.kind),
            portable,
            false);
        detailLabel.SetText(
            "Staged " + portable + " into " + field.label
            + ". Press Enter on the row to commit one undoable edit.");
    }

    /// @brief Keep multi-object layout affordances selection-count truthful.
    hide func RefreshObjectArrangeControls(hasSelection: Boolean) {
        if objectArrangeDropdown == null or arrangeObjectButton == null {
            return;
        }
        var operation = objectArrangeDropdown.Selected;
        var minimum = scene_layout_2d.MinimumSelection(operation);
        var available = hasSelection
            and selectedObjects.count() >= minimum;
        objectArrangeDropdown.SetEnabled(
            hasSelection and selectedObjects.count() >= 2);
        arrangeObjectButton.SetEnabled(available);
        arrangeObjectButton.SetText("Arrange");
        if available {
            arrangeObjectButton.SetText(
                "Arrange (" + selectedObjects.count() + ")");
        }
        arrangeObjectButton.SetTooltip(
            scene_layout_2d.OperationLabel(operation)
            + " as one undoable selection edit; needs "
            + minimum + " selected objects");
    }

    hide func RefreshObjectProperties() {
        objectPropertyKeys = [];
        selectedObjectProperty = -1;
        var hasSelection = scene != null and selectedObject >= 0
            and selectedObject < scene.ObjectCount()
            and selectedObjects.count() > 0;
        var hasObject = hasSelection and selectedObjects.count() == 1;
        var hasBatch = hasSelection and selectedObjects.count() > 1;
        removeObjectPropertyButton.SetVisible(hasBatch);
        if hasBatch {
            // One shared draft row batch-edits the whole selection: commit
            // sets the typed value on every object, the explicit button
            // removes its key from every object.
            var count = selectedObjects.count();
            objectProperties.SetRows([], [], []);
            objectProperties.EnsureDraftRow();
            objectProperties.addButton.SetEnabled(false);
            removeObjectPropertyButton.SetText("Remove from " + count);
            removeObjectPropertyButton.SetEnabled(true);
            return;
        }
        objectProperties.addButton.SetEnabled(hasObject);
        if hasObject == false {
            objectProperties.SetRows([], [], []);
            objectProperties.SetEnabled(false);
            return;
        }

        var keys = scene.ObjectKeys(selectedObject);
        var total = Seq.get_Count(keys);
        var visible = total;
        if visible > MAX_INSPECTOR_PROPERTIES {
            visible = MAX_INSPECTOR_PROPERTIES;
        }
        var rowKinds: List[Integer] = [];
        var rowValues: List[String] = [];
        var index = 0;
        while index < visible {
            var key = Seq.GetStr(keys, index);
            var kind = scene.ObjectPropertyKind(selectedObject, key);
            objectPropertyKeys.add(key);
            rowKinds.add(PropertyKindIndex(kind));
            rowValues.add(PropertyValueText(selectedObject, key, kind));
            index = index + 1;
        }
        objectProperties.SetRows(objectPropertyKeys, rowKinds, rowValues);
        objectProperties.SetEnabled(true);
    }

    hide func PropertyValueText(index: Integer,
                                key: String,
                                kind: String) -> String {
        if kind == "string" { return scene.ObjectGetStr(index, key, ""); }
        if kind == "int" {
            return Fmt.Int(scene.ObjectGetInt(index, key, 0));
        }
        if kind == "float" {
            return Fmt.Num(scene.ObjectGetFloat(index, key, 0.0));
        }
        if kind == "bool" {
            return Fmt.Bool(scene.ObjectGetBool(index, key, false));
        }
        if kind == "null" { return ""; }
        return "";
    }

    hide func PropertyPreview(value: String, kind: String) -> String {
        if kind == "null" { return "null"; }
        var preview = Str.Replace(
            Str.Replace(value, "\r", "\\r"), "\n", "\\n");
        if Str.get_Length(preview) > 72 {
            preview = Str.Left(preview, 69) + "...";
        }
        if kind == "string" { return "\"" + preview + "\""; }
        return preview;
    }

    hide func PropertyKindToken(index: Integer) -> String {
        if index == PROPERTY_TYPE_INT { return "int"; }
        if index == PROPERTY_TYPE_FLOAT { return "float"; }
        if index == PROPERTY_TYPE_BOOL { return "bool"; }
        if index == PROPERTY_TYPE_NULL { return "null"; }
        return "string";
    }

    hide func PropertyKindIndex(kind: String) -> Integer {
        if kind == "int" { return PROPERTY_TYPE_INT; }
        if kind == "float" { return PROPERTY_TYPE_FLOAT; }
        if kind == "bool" { return PROPERTY_TYPE_BOOL; }
        if kind == "null" { return PROPERTY_TYPE_NULL; }
        return PROPERTY_TYPE_STRING;
    }

    hide func SelectObjectPropertyByKey(key: String) {
        var index = 0;
        while index < objectPropertyKeys.count() {
            if objectPropertyKeys.get(index) == key {
                var row = objectProperties.rows.get(index);
                row.valueInput.Focus();
                return;
            }
            index = index + 1;
        }
    }

    /// @brief Prefill one existing or draft property row and focus it.
    hide func StageObjectPropertyDraft(key: String,
                                       kind: String,
                                       value: String,
                                       focusKey: Boolean) {
        var index = 0;
        while index < objectPropertyKeys.count() {
            if objectPropertyKeys.get(index) == key {
                var row = objectProperties.rows.get(index);
                row.kindDropdown.SetSelected(PropertyKindIndex(kind));
                row.valueInput.SetText(value);
                if focusKey { row.keyInput.Focus(); }
                else { row.valueInput.Focus(); }
                return;
            }
            index = index + 1;
        }
        objectProperties.AddDraftRow();
        var draft = objectProperties.rows.get(
            objectProperties.rows.count() - 1);
        draft.keyInput.SetText(key);
        draft.kindDropdown.SetSelected(PropertyKindIndex(kind));
        draft.valueInput.SetText(value);
        if focusKey { draft.keyInput.Focus(); }
        else { draft.valueInput.Focus(); }
    }

    hide func RestoreSceneSnapshot(snapshot: String) {
        var restored = SceneDocument.LoadJsonResult(snapshot);
        if restored.IsOk {
            scene = restored.Unwrap() as SceneDocument;
            RefreshAutotilePreviewRules();
            renderDirty = true;
            RefreshInspector();
        }
    }

    /// @brief Whether one layer is workspace-locked against tile edits.
    expose func LayerLocked(layer: Integer) -> Boolean {
        var index = 0;
        while index < lockedLayers.count() {
            if lockedLayers.get(index) == layer { return true; }
            index = index + 1;
        }
        return false;
    }

    /// @brief Refuse an edit on a locked layer with a visible reason.
    hide func RefuseLockedLayer(layer: Integer) -> Boolean {
        if LayerLocked(layer) == false { return false; }
        detailLabel.SetText(
            "Layer " + (layer + 1) + " is locked; unlock it to edit tiles.");
        return true;
    }

    /// @brief Map one old index through a stable layer move.
    hide func RemapLayerIndexForMove(index: Integer,
                                     source: Integer,
                                     destination: Integer) -> Integer {
        if index == source { return destination; }
        if source < destination
           and index > source and index <= destination {
            return index - 1;
        }
        if destination < source
           and index >= destination and index < source {
            return index + 1;
        }
        return index;
    }

    /// @brief Preserve lock/solo identity across one accepted layer move.
    hide func RemapLayerWorkspaceForMove(source: Integer,
                                         destination: Integer) {
        var remapped: List[Integer] = [];
        var index = 0;
        while index < lockedLayers.count() {
            remapped.add(RemapLayerIndexForMove(
                lockedLayers.get(index), source, destination));
            index = index + 1;
        }
        lockedLayers = remapped;
        if soloLayer >= 0 {
            soloLayer = RemapLayerIndexForMove(
                soloLayer, source, destination);
        }
        NormalizeLayerWorkspaceState();
        renderDirty = true;
    }

    /// @brief Preserve surviving layer state after one accepted removal.
    hide func RemapLayerWorkspaceForRemoval(removed: Integer) {
        var remapped: List[Integer] = [];
        var index = 0;
        while index < lockedLayers.count() {
            var layer = lockedLayers.get(index);
            if layer < removed {
                remapped.add(layer);
            } else if layer > removed {
                remapped.add(layer - 1);
            }
            index = index + 1;
        }
        lockedLayers = remapped;
        if soloLayer == removed {
            soloLayer = -1;
        } else if soloLayer > removed {
            soloLayer = soloLayer - 1;
        }
        NormalizeLayerWorkspaceState();
        renderDirty = true;
    }

    /// @brief Move one layer through the shared canonical transaction path.
    /// @details Direct ListBox requests, Alt+Arrow, and explicit buttons all
    ///          preserve Lock/Solo identity and commit exactly one history.
    hide func MoveSceneLayer(source: Integer,
                             destination: Integer,
                             action: String) -> Boolean {
        if scene == null or source < 0 or destination < 0
           or source >= scene.LayerCount()
           or destination >= scene.LayerCount()
           or source == destination {
            return false;
        }
        var before = scene.ToJson();
        if before == "" { return false; }
        scene.MoveLayer(source, destination);
        var after = scene.ToJson();
        if after == "" or after == before { return false; }
        RemapLayerWorkspaceForMove(source, destination);
        activeLayer = destination;
        if CommitScene(action) == false {
            scene.MoveLayer(destination, source);
            RemapLayerWorkspaceForMove(destination, source);
            activeLayer = source;
            RefreshInspector();
            return false;
        }
        ReloadTilesets();
        RefreshInspector();
        return true;
    }

    /// @brief Set one layer's workspace-only tile edit lock.
    /// @return True only when lock state changed.
    expose func SetLayerLocked(layer: Integer,
                               nextLocked: Boolean) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or LayerLocked(layer) == nextLocked {
            return false;
        }
        if nextLocked {
            lockedLayers.add(layer);
        } else {
            var kept: List[Integer] = [];
            var index = 0;
            while index < lockedLayers.count() {
                if lockedLayers.get(index) != layer {
                    kept.add(lockedLayers.get(index));
                }
                index = index + 1;
            }
            lockedLayers = kept;
        }
        NormalizeLayerWorkspaceState();
        RefreshLayerNavigatorRows();
        RefreshLayerFields();
        CaptureWorkspaceState();
        if nextLocked {
            toolbarStatus.SetText("Layer locked against tile edits");
        } else {
            toolbarStatus.SetText("Layer unlocked");
        }
        return true;
    }

    /// @brief Isolate one layer in the canvas, or pass -1 to clear Solo.
    /// @return True only when workspace presentation changed.
    expose func SetSoloLayer(nextSolo: Integer) -> Boolean {
        if scene == null or nextSolo < -1
           or nextSolo >= scene.LayerCount()
           or nextSolo == soloLayer {
            return false;
        }
        soloLayer = nextSolo;
        NormalizeLayerWorkspaceState();
        renderDirty = true;
        RefreshLayerNavigatorRows();
        RefreshLayerFields();
        CaptureWorkspaceState();
        if soloLayer >= 0 {
            toolbarStatus.SetText(
                "Soloing layer " + (soloLayer + 1));
        } else {
            toolbarStatus.SetText("Layer Solo cleared");
        }
        return true;
    }

    /// @brief Set one authored layer's visibility through canonical history.
    expose func SetLayerVisibility(layer: Integer,
                                   nextVisible: Boolean) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or scene.LayerVisible(layer) == nextVisible {
            return false;
        }
        scene.SetLayerVisible(layer, nextVisible);
        var action = "Hidden layer";
        if nextVisible { action = "Shown layer"; }
        if CommitScene(action) == false { return false; }
        activeLayer = layer;
        renderDirty = true;
        RefreshLayerNavigatorRows();
        RefreshLayerFields();
        return true;
    }

    hide func PumpLayerControls() -> Boolean {
        if scene == null { return false; }
        var changed = false;
        if layerList.WasSelectionChanged() {
            var selected = layerList.SelectedIndex;
            if selected >= 0 and selected < scene.LayerCount() {
                activeLayer = selected;
                RefreshLayerFields();
                renderDirty = true;
            }
        }
        if layerList.WasActivated()
           and activeLayer >= 0 and activeLayer < scene.LayerCount() {
            changed = SetLayerVisibility(
                activeLayer,
                scene.LayerVisible(activeLayer) == false) or changed;
        }
        if layerList.WasReorderRequested() {
            var source = layerList.GetReorderSourceIndex();
            var destination = layerList.GetReorderTargetIndex();
            changed = MoveSceneLayer(
                source, destination, "Reordered layer") or changed;
        }
        if addLayerButton.WasClicked() {
            var added = scene.AddLayer("Layer " + (scene.LayerCount() + 1));
            if added >= 0 {
                activeLayer = added;
                changed = CommitScene("Added layer") or changed;
                ReloadTilesets();
                RefreshInspector();
            }
        }
        if removeLayerButton.WasClicked() {
            var before = scene.LayerCount();
            scene.RemoveLayer(activeLayer);
            if scene.LayerCount() != before {
                var removed = activeLayer;
                RemapLayerWorkspaceForRemoval(removed);
                if activeLayer >= scene.LayerCount() {
                    activeLayer = scene.LayerCount() - 1;
                }
                changed = CommitScene("Removed layer") or changed;
                ReloadTilesets();
                RefreshInspector();
            }
        }
        if layerUpButton.WasClicked() and activeLayer > 0 {
            var source = activeLayer;
            var destination = activeLayer - 1;
            changed = MoveSceneLayer(
                source, destination, "Moved layer up") or changed;
        }
        if layerDownButton.WasClicked()
           and activeLayer + 1 < scene.LayerCount() {
            var source = activeLayer;
            var destination = activeLayer + 1;
            changed = MoveSceneLayer(
                source, destination, "Moved layer down") or changed;
        }
        if layerNameInput.WasSubmitted() {
            changed = RenameSceneLayer(
                activeLayer, layerNameInput.Text) or changed;
        }
        var nextVisibleRevision = layerVisibleCheck.GetRevision();
        if nextVisibleRevision != layerVisibleRevision {
            layerVisibleRevision = nextVisibleRevision;
            var nextVisible = layerVisibleCheck.IsChecked();
            changed = SetLayerVisibility(
                activeLayer, nextVisible) or changed;
        }
        var nextOpacityRevision = layerOpacitySpinner.GetRevision();
        if nextOpacityRevision != layerOpacityRevision {
            layerOpacityRevision = nextOpacityRevision;
            var nextOpacity = layerOpacitySpinner.Value;
            if NumberDiffers(
                   nextOpacity, scene.LayerOpacity(activeLayer)) {
                scene.SetLayerOpacity(activeLayer, nextOpacity);
                changed = CommitScene("Updated layer opacity") or changed;
                renderDirty = true;
                RefreshInspector();
            }
        }
        var nextLockRevision = layerLockCheck.GetRevision();
        if nextLockRevision != layerLockRevision {
            layerLockRevision = nextLockRevision;
            var wantLocked = layerLockCheck.IsChecked();
            SetLayerLocked(activeLayer, wantLocked);
        }
        var nextSoloRevision = layerSoloCheck.GetRevision();
        if nextSoloRevision != layerSoloRevision {
            layerSoloRevision = nextSoloRevision;
            var wantSolo = layerSoloCheck.IsChecked();
            var nextSolo = -1;
            if wantSolo { nextSolo = activeLayer; }
            SetSoloLayer(nextSolo);
        }
        if chooseLayerAssetButton.WasClicked() {
            var baseDir = "";
            if currentDoc != null and currentDoc.filePath != "" {
                baseDir = Path.Directory(currentDoc.filePath);
            }
            var assetPath = GUI.FileDialog.Open(
                "Choose Layer Image", baseDir, "*.png;*.jpg;*.jpeg;*.bmp;*.gif");
            if assetPath != "" {
                changed = ApplyLayerAssetPath(
                    activeLayer, PortableLayerAssetPath(assetPath)) or changed;
            }
        }
        if layerAssetInput.WasSubmitted() {
            changed = ApplyLayerAssetPath(
                activeLayer, layerAssetInput.Text) or changed;
        }
        if tilesetInspector.TakeReloadRequested() {
            ReloadTilesetPreviews();
        }
        if tilesetInspector.TakeClearRequested() {
            changed = ApplyLayerAssetPath(activeLayer, "") or changed;
        }
        return changed;
    }

    /// @brief Prefer scene-relative authored paths for saved scene documents.
    hide func PortableLayerAssetPath(assetPath: String) -> String {
        var documentPath = "";
        if currentDoc != null { documentPath = currentDoc.filePath; }
        return scene_asset_browser.PortableReferencePath(
            assetPath, documentPath);
    }

    /// @brief Configure one integer spinner used for new-scene dimensions.
    expose func ConfigureSceneSpinner(spinner: GUI.Spinner,
                                    value: Integer,
                                    maximum: Integer) {
        spinner.SetRange(1.0, maximum);
        spinner.SetStep(1.0);
        spinner.SetDecimals(0);
        spinner.SetValue(value);
        spinner.SetPreferredSize(68.0, 0.0);
    }

    /// @brief Reflect the loaded scene in the new-scene setup controls.
    hide func RefreshSceneSetupFields() {
        if scene == null or sceneWidthSpinner == null { return; }
        sceneWidthSpinner.SetValue(scene.Width);
        sceneHeightSpinner.SetValue(scene.Height);
        sceneTileSizeSpinner.SetValue(scene.TileWidth);
    }

    hide func PumpObjectControls() -> Boolean {
        if scene == null { return false; }
        PumpHierarchySearchControls();
        var changed = false;
        if objectTree.WasSelectionChanged() {
            var primaryRow = objectTree.GetSelected();
            selectedObject = -1;
            if primaryRow != null {
                selectedObject = Parse.IntOr(
                    GUI.TreeView.Node.GetData(primaryRow), -1);
            }
            selectedObjects = scene_selection.FromData(
                objectTree.GetSelectedData(),
                scene.ObjectCount(),
                selectedObject);
            if selectedObject < 0 and selectedObjects.count() > 0 {
                selectedObject = selectedObjects.get(0);
            }
            selectedObjectProperty = -1;
            RefreshObjectFields();
            renderDirty = true;
        }
        if objectTree.WasActivated()
           and selectedObjects.count() > 0 {
            FrameSelected();
        }
        if objectTree.WasDropReceived() {
            var sourceIndex = Parse.IntOr(
                objectTree.GetDropSourceData(), -1);
            var targetIndex = Parse.IntOr(
                objectTree.GetDropTargetData(), -1);
            var dropPosition = objectTree.GetDropPosition();
            objectTree.ClearDrop();
            changed = ApplyObjectHierarchyDrop(
                sourceIndex, targetIndex, dropPosition) or changed;
        }
        if objectTree.WasEditCommitted() {
            changed = ApplyObjectRename() or changed;
        }
        PumpObjectRename();
        if objectParentDropdown.WasChanged() {
            UpdateObjectParentControlAvailability();
        }
        if reparentObjectButton.WasClicked() {
            changed = ReparentSelectedSceneObjects(
                SelectedObjectParentTargetIndex()) or changed;
        }
        if addObjectButton.WasClicked() {
            changed = CreateRootObjectAtSelection() >= 0 or changed;
        }
        if addChildObjectButton.WasClicked() {
            changed = CreateChildObjectUnderSelection() >= 0 or changed;
        }
        var applyRequested = applyObjectButton.WasClicked();
        if objectTypeInput.WasSubmitted() { applyRequested = true; }
        if objectIdInput.WasSubmitted() { applyRequested = true; }
        if applyRequested and selectedObjects.count() == 1
           and selectedObject >= 0
           and selectedObject < scene.ObjectCount() {
            changed = UpdateSceneObject(
                selectedObject,
                objectTypeInput.Text,
                objectIdInput.Text,
                Convert.NumToInt(objectXSpinner.Value),
                Convert.NumToInt(objectYSpinner.Value)) or changed;
        }
        if objectDrawStackApplyButton.WasClicked()
           and selectedObjects.count() == 1
           and selectedObject >= 0
           and selectedObject < scene.ObjectCount() {
            changed = SetObjectPreviewStackOverride(
                selectedObject,
                objectAfterLayerDropdown.Selected - 1,
                Convert.NumToInt(objectDrawOrderSpinner.Value)) or changed;
        }
        if objectDrawStackResetButton.WasClicked()
           and selectedObjects.count() == 1
           and selectedObject >= 0
           and selectedObject < scene.ObjectCount() {
            changed = ClearObjectPreviewStackOverride(
                selectedObject) or changed;
        }
        if duplicateObjectButton.WasClicked() and selectedObject >= 0 {
            if DuplicateSelectedSceneObjects() > 0 { changed = true; }
        }
        if objectArrangeDropdown.WasChanged() {
            RefreshObjectArrangeControls(selectedObjects.count() > 0);
        }
        if arrangeObjectButton.WasClicked() {
            changed = ArrangeSelectedSceneObjects(
                objectArrangeDropdown.Selected) or changed;
        }
        if objectUpButton.WasClicked() {
            changed = MoveSelectedObjectEarlier() or changed;
        }
        if objectDownButton.WasClicked() {
            changed = MoveSelectedObjectLater() or changed;
        }
        if removeObjectButton.WasClicked() and selectedObject >= 0 {
            changed = RemoveSelectedSceneObjects() or changed;
        }
        objectProperties.Pump();
        var propertyCommitRow = objectProperties.TakeCommitRow();
        if propertyCommitRow >= 0 and selectedObjects.count() > 1 {
            changed = SetSelectedSceneObjectProperty(
                objectProperties.KeyTextAt(propertyCommitRow),
                PropertyKindToken(
                    objectProperties.KindIndexAt(propertyCommitRow)),
                objectProperties.ValueTextAt(propertyCommitRow)) or changed;
        } else if propertyCommitRow >= 0 and selectedObjects.count() == 1
                  and selectedObject >= 0 {
            changed = SetSceneObjectProperty(
                selectedObject,
                objectProperties.CanonicalKeyAt(propertyCommitRow),
                objectProperties.KeyTextAt(propertyCommitRow),
                PropertyKindToken(
                    objectProperties.KindIndexAt(propertyCommitRow)),
                objectProperties.ValueTextAt(propertyCommitRow)) or changed;
        }
        var propertyRemoveRow = objectProperties.TakeRemoveRow();
        if propertyRemoveRow >= 0 and selectedObjects.count() == 1
           and selectedObject >= 0 {
            changed = RemoveSceneObjectProperty(
                selectedObject,
                objectProperties.CanonicalKeyAt(
                    propertyRemoveRow)) or changed;
        }
        if removeObjectPropertyButton.WasClicked()
           and selectedObjects.count() > 1
           and objectProperties.RowCount() > 0 {
            changed = RemoveSelectedSceneObjectProperty(
                objectProperties.KeyTextAt(0)) or changed;
        }
        return changed;
    }

    /// @brief Route project component-picker intent into editor transactions.
    hide func PumpComponentControls() -> Boolean {
        if componentPalette == null or componentPalette.group == null {
            return false;
        }
        if componentPalette.Pump() { RefreshComponentPalette(); }
        var schemaChanged = componentAuthoring.PollExternalChanges(
            1000, componentPalette);
        var schemaAuthored =
            componentAuthoring.Pump(componentPalette);
        if schemaChanged or schemaAuthored
           or componentAuthoring.handled {
            componentSchema = componentAuthoring.schema;
            RefreshComponentPalette();
            if componentAuthoring.message != "" {
                detailLabel.SetText(componentAuthoring.message);
            }
        }
        if componentPalette.TakeEditFieldRequested() {
            EditSelectedComponentField();
        }
        if componentPalette.TakeCreateRequested() {
            return CreateObjectFromComponent(
                       componentPalette.SelectedComponent()) >= 0;
        }
        if componentPalette.TakeApplyRequested() {
            return ApplySelectedComponent(
                componentPalette.SelectedComponent());
        }
        return false;
    }

    hide func ObjectIdExists(objectId: String, exceptIndex: Integer) -> Boolean {
        if scene == null { return false; }
        var index = 0;
        while index < scene.ObjectCount() {
            if index != exceptIndex and scene.ObjectId(index) == objectId {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    hide func ObjectIndexWithId(objectId: String) -> Integer {
        if scene == null or objectId == "" { return -1; }
        var index = 0;
        while index < scene.ObjectCount() {
            if scene.ObjectId(index) == objectId { return index; }
            index = index + 1;
        }
        return -1;
    }

    hide func UniqueObjectId(base: String) -> String {
        var stem = Str.Trim(base);
        if stem == "" { stem = "object"; }
        if ObjectIdExists(stem, -1) == false { return stem; }
        var suffix = 2;
        while suffix <= scene.ObjectCount() + 2 {
            var candidate = stem + "-" + suffix;
            if ObjectIdExists(candidate, -1) == false { return candidate; }
            suffix = suffix + 1;
        }
        return stem + "-" + (scene.ObjectCount() + 3);
    }

    /// @brief Return whether either side-specific Shift key is held.
    hide func CanvasShiftDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftShift)
            or Input.Keyboard.IsDown(Input.Key.RightShift);
    }

    /// @brief Return whether conventional Control/Command selection is held.
    /// @brief Return whether either Alt key is held (transient picker).
    hide func CanvasAltDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftAlt)
            or Input.Keyboard.IsDown(Input.Key.RightAlt);
    }

    hide func CanvasPrimaryModifierDown() -> Boolean {
        return Input.Keyboard.IsDown(Input.Key.LeftControl)
            or Input.Keyboard.IsDown(Input.Key.RightControl)
            or Input.Keyboard.IsDown(Input.Key.LeftSuper)
            or Input.Keyboard.IsDown(Input.Key.RightSuper);
    }

    /// @brief Begin one blank-space marquee without changing selection yet.
    hide func BeginCanvasMarquee(cellX: Integer,
                                 cellY: Integer,
                                 additive: Boolean,
                                 toggle: Boolean) {
        canvasMarqueeActive = true;
        canvasMarqueeStartX = cellX;
        canvasMarqueeStartY = cellY;
        canvasMarqueeCurrentX = cellX;
        canvasMarqueeCurrentY = cellY;
        canvasMarqueeAdditive = additive;
        canvasMarqueeToggle = toggle;
        if Input.Mouse.IsCaptured() == false {
            Input.Mouse.Capture();
        }
        renderDirty = true;
        // Keep this transient status short enough to remain on one toolbar
        // line. Reflowing the retained layout after pointer capture moves the
        // canvas underneath the physical pointer and corrupts the drag cell.
        toolbarStatus.SetText("Box select; Escape cancels");
    }

    /// @brief Clear transient marquee state and optionally release its capture.
    hide func ResetCanvasMarquee(releaseCapture: Boolean) {
        var wasActive = canvasMarqueeActive;
        canvasMarqueeActive = false;
        canvasMarqueeStartX = -1;
        canvasMarqueeStartY = -1;
        canvasMarqueeCurrentX = -1;
        canvasMarqueeCurrentY = -1;
        tileRegionMinX = -1;
        tileRegionMinY = -1;
        tileRegionMaxX = -1;
        tileRegionMaxY = -1;
        stampActive = false;
        stampWidth = 0;
        stampHeight = 0;
        stampTiles = [];
        hoverCellX = -1;
        hoverCellY = -1;
        canvasMarqueeAdditive = false;
        canvasMarqueeToggle = false;
        if releaseCapture and wasActive and Input.Mouse.IsCaptured() {
            Input.Mouse.Release();
        }
        if wasActive { renderDirty = true; }
    }

    /// @brief Cancel one active marquee and preserve its prior selection.
    hide func CancelCanvasMarquee() {
        if canvasMarqueeActive == false { return; }
        ResetCanvasMarquee(true);
        gestureEscapeConsumed = true;
        toolbarStatus.SetText("Box selection canceled");
    }

    /// @brief Apply one marquee exactly once when the left button is released.
    hide func FinishCanvasMarquee() {
        if canvasMarqueeActive == false { return; }
        var startX = canvasMarqueeStartX;
        var startY = canvasMarqueeStartY;
        var endX = canvasMarqueeCurrentX;
        var endY = canvasMarqueeCurrentY;
        var additive = canvasMarqueeAdditive;
        var toggle = canvasMarqueeToggle;
        ResetCanvasMarquee(true);
        SetTileRegion(startX, startY, endX, endY);
        var changed = ApplyCanvasMarqueeSelection(
            startX, startY, endX, endY, additive, toggle);
        if selectedObjects.count() == 0 {
            toolbarStatus.SetText("No canvas objects selected");
        } else if changed {
            toolbarStatus.SetText(
                "Selected " + selectedObjects.count()
                + " canvas object(s)");
        } else {
            toolbarStatus.SetText(
                "Canvas selection unchanged ("
                + selectedObjects.count() + " object(s))");
        }
    }

    /// @brief Begin a non-destructive inclusive tile-shape preview.
    hide func BeginTileRectangle(cellX: Integer,
                                 cellY: Integer) {
        tileRectangleShape = 0;
        if mode == MODE_LINE { tileRectangleShape = 1; }
        if mode == MODE_ELLIPSE { tileRectangleShape = 2; }
        tileRectangleActive = true;
        tileRectangleStartX = cellX;
        tileRectangleStartY = cellY;
        tileRectangleCurrentX = cellX;
        tileRectangleCurrentY = cellY;
        tileRectangleTile =
            ClampInt(Convert.NumToInt(tileSpinner.Value), 0, 1000000);
        if Input.Mouse.IsCaptured() == false {
            Input.Mouse.Capture();
        }
        renderDirty = true;
        var shapeName = "rectangle";
        if tileRectangleShape == 1 { shapeName = "line"; }
        if tileRectangleShape == 2 { shapeName = "ellipse"; }
        toolbarStatus.SetText(
            "Drag a tile " + shapeName
            + "; release applies and Escape cancels");
    }

    /// @brief Clear transient rectangle state and optionally release capture.
    hide func ResetTileRectangle(releaseCapture: Boolean) {
        var wasActive = tileRectangleActive;
        tileRectangleActive = false;
        tileRectangleStartX = -1;
        tileRectangleStartY = -1;
        tileRectangleCurrentX = -1;
        tileRectangleCurrentY = -1;
        tileRectangleTile = 0;
        if releaseCapture and wasActive and Input.Mouse.IsCaptured() {
            Input.Mouse.Release();
        }
        if wasActive { renderDirty = true; }
    }

    /// @brief Clamp a captured rectangle pointer to the rendered scene edge.
    hide func UpdateTileRectanglePointer() {
        if tileRectangleActive == false or canvasImage == null
           or displayCellSize <= 0
           or renderedColumns <= 0 or renderedRows <= 0 {
            return;
        }
        var relativeX = PhysicalPointerToUi(Input.Mouse.X())
            - canvasImage.GetScreenX();
        var relativeY = PhysicalPointerToUi(Input.Mouse.Y())
            - canvasImage.GetScreenY();
        var cellX = 0;
        var cellY = 0;
        if relativeX > 0.0 {
            cellX = Convert.NumToInt(relativeX) / displayCellSize;
        }
        if relativeY > 0.0 {
            cellY = Convert.NumToInt(relativeY) / displayCellSize;
        }
        cellX = ClampInt(cellX, 0, renderedColumns - 1);
        cellY = ClampInt(cellY, 0, renderedRows - 1);
        if tileRectangleCurrentX != cellX
           or tileRectangleCurrentY != cellY {
            tileRectangleCurrentX = cellX;
            tileRectangleCurrentY = cellY;
            selectedCellX = cellX;
            selectedCellY = cellY;
            renderDirty = true;
        }
    }

    /// @brief Cancel an active tile rectangle without canonical mutation.
    hide func CancelTileRectangle() {
        if tileRectangleActive == false { return; }
        ResetTileRectangle(true);
        gestureEscapeConsumed = true;
        toolbarStatus.SetText("Tile rectangle canceled");
    }

    /// @brief Apply one captured tile rectangle exactly once on release.
    hide func FinishTileRectangle() -> Boolean {
        if tileRectangleActive == false { return false; }
        var startX = tileRectangleStartX;
        var startY = tileRectangleStartY;
        var endX = tileRectangleCurrentX;
        var endY = tileRectangleCurrentY;
        var tile = tileRectangleTile;
        var shape = tileRectangleShape;
        ResetTileRectangle(true);
        if shape != 0 {
            return ApplyTileShape(
                shape, startX, startY, endX, endY, tile);
        }
        return ApplyTileRectangle(
            activeLayer, startX, startY, endX, endY, tile);
    }

    /// @brief Cells covered by one line or ellipse gesture (x,y pairs).
    /// @details The single source for previews and commits so the ghost
    ///          always matches the written cells. Lines rasterize with the
    ///          classic integer error walk; ellipses sample the boundary
    ///          per column and per row of the inclusive drag rectangle.
    hide func ShapeCells(shape: Integer,
                         startX: Integer,
                         startY: Integer,
                         endX: Integer,
                         endY: Integer) -> List[Integer] {
        var cells: List[Integer] = [];
        if shape == 1 {
            var deltaX = endX - startX;
            if deltaX < 0 { deltaX = 0 - deltaX; }
            var deltaY = endY - startY;
            if deltaY < 0 { deltaY = 0 - deltaY; }
            var stepX = -1;
            if endX > startX { stepX = 1; }
            var stepY = -1;
            if endY > startY { stepY = 1; }
            var walkError = deltaX - deltaY;
            var x = startX;
            var y = startY;
            var guardSteps = deltaX + deltaY + 1;
            while guardSteps >= 0 {
                cells.add(x);
                cells.add(y);
                if x == endX and y == endY { return cells; }
                var doubled = walkError * 2;
                if doubled > 0 - deltaY {
                    walkError = walkError - deltaY;
                    x = x + stepX;
                }
                if doubled < deltaX {
                    walkError = walkError + deltaX;
                    y = y + stepY;
                }
                guardSteps = guardSteps - 1;
            }
            return cells;
        }
        var minX = startX;
        var maxX = endX;
        if maxX < minX {
            minX = endX;
            maxX = startX;
        }
        var minY = startY;
        var maxY = endY;
        if maxY < minY {
            minY = endY;
            maxY = startY;
        }
        var centerX = (minX + maxX) * 0.5;
        var centerY = (minY + maxY) * 0.5;
        var radiusX = (maxX - minX) * 0.5;
        var radiusY = (maxY - minY) * 0.5;
        if radiusX < 0.5 or radiusY < 0.5 {
            // Degenerate ellipses collapse to their bounding rectangle
            // outline, which for a 1-cell-thick drag is the drag itself.
            var x = minX;
            while x <= maxX {
                var y = minY;
                while y <= maxY {
                    cells.add(x);
                    cells.add(y);
                    y = y + 1;
                }
                x = x + 1;
            }
            return cells;
        }
        var column = minX;
        while column <= maxX {
            var normalized = (column - centerX) / radiusX;
            var squared = 1.0 - normalized * normalized;
            if squared < 0.0 { squared = 0.0; }
            var offset = radiusY * Math.Sqrt(squared);
            cells.add(column);
            cells.add(Convert.NumToInt(centerY - offset + 0.5));
            cells.add(column);
            cells.add(Convert.NumToInt(centerY + offset + 0.5));
            column = column + 1;
        }
        var row = minY;
        while row <= maxY {
            var normalized = (row - centerY) / radiusY;
            var squared = 1.0 - normalized * normalized;
            if squared < 0.0 { squared = 0.0; }
            var offset = radiusX * Math.Sqrt(squared);
            cells.add(Convert.NumToInt(centerX - offset + 0.5));
            cells.add(row);
            cells.add(Convert.NumToInt(centerX + offset + 0.5));
            cells.add(row);
            row = row + 1;
        }
        return cells;
    }

    /// @brief Write one line or ellipse of tiles as a single transaction.
    hide func ApplyTileShape(shape: Integer,
                             startX: Integer,
                             startY: Integer,
                             endX: Integer,
                             endY: Integer,
                             tile: Integer) -> Boolean {
        if scene == null or activeLayer < 0
           or activeLayer >= scene.LayerCount() {
            return false;
        }
        if RefuseLockedLayer(activeLayer) { return false; }
        var nextTile = tile;
        if nextTile < 0 { nextTile = 0; }
        var cells = ShapeCells(shape, startX, startY, endX, endY);
        var changedCells = 0;
        var index = 0;
        while index < cells.count() {
            var x = cells.get(index);
            var y = cells.get(index + 1);
            if x >= 0 and x < scene.Width
               and y >= 0 and y < scene.Height
               and scene.GetTile(activeLayer, x, y) != nextTile {
                scene.SetTile(activeLayer, x, y, nextTile);
                changedCells = changedCells + 1;
            }
            index = index + 2;
        }
        renderDirty = true;
        if changedCells == 0 {
            toolbarStatus.SetText(
                "Shape already matches the selected tile");
            return false;
        }
        var label = "Painted tile line";
        if shape == 2 { label = "Painted tile ellipse"; }
        if CommitScene(label) == false {
            RestoreSceneSnapshot(currentSerialized);
            return false;
        }
        toolbarStatus.SetText(
            "Painted " + changedCells + " tile(s)");
        return true;
    }

    /// @brief Reset one freehand stroke and optionally release its capture.
    hide func ResetPaintStroke(releaseCapture: Boolean) {
        var wasActive = paintStrokeActive;
        paintStrokeActive = false;
        paintStrokeChanged = false;
        paintStrokeSnapshot = "";
        lastPaintX = -1;
        lastPaintY = -1;
        if releaseCapture and wasActive and Input.Mouse.IsCaptured() {
            Input.Mouse.Release();
        }
    }

    /// @brief Restore the pre-stroke snapshot and create no history.
    hide func CancelPaintStroke() {
        if paintStrokeActive == false { return; }
        var snapshot = paintStrokeSnapshot;
        var changed = paintStrokeChanged;
        ResetPaintStroke(true);
        gestureEscapeConsumed = true;
        if changed and snapshot != "" {
            RestoreSceneSnapshot(snapshot);
        }
        toolbarStatus.SetText("Tile stroke canceled");
    }

    /// @brief Keep clean-view pan/zoom live while consuming every edit gesture.
    hide func PumpGameViewCanvasNavigation() -> Boolean {
        if canvasImage != null and canvasImage.WasDropped() {
            toolbarStatus.SetText(
                "Exit Game View before dropping assets onto the canvas");
            return false;
        }
        if scene == null or canvasImage == null
           or canvasImage.IsHovered() == false {
            return false;
        }
        var leftPressed =
            Input.Mouse.WasPressed(Input.Mouse.ButtonLeft);
        var leftClicked =
            Input.Mouse.WasClicked(Input.Mouse.ButtonLeft);
        if leftPressed or leftClicked
           or Input.Mouse.WasPressed(Input.Mouse.ButtonMiddle) {
            canvasImage.Focus();
        }
        if gameViewOutputFramed { return false; }
        if Input.Mouse.IsDown(Input.Mouse.ButtonMiddle) {
            var panX = PhysicalPointerToUi(Input.Mouse.DeltaX());
            var panY = PhysicalPointerToUi(Input.Mouse.DeltaY());
            if panX != 0 or panY != 0 {
                SetLogicalScroll(
                    canvasScroll,
                    LogicalScrollX(canvasScroll) - panX,
                    LogicalScrollY(canvasScroll) - panY);
            }
            return false;
        }
        var relativeX = PhysicalPointerToUi(Input.Mouse.X())
            - canvasImage.GetScreenX();
        var relativeY = PhysicalPointerToUi(Input.Mouse.Y())
            - canvasImage.GetScreenY();
        var wheel = Input.Mouse.WheelYFloat();
        if wheel > 0.0 or wheel < 0.0 {
            var direction = 1;
            if wheel < 0.0 { direction = -1; }
            ZoomStepAnchored(
                direction,
                relativeX + viewOriginX,
                relativeY + viewOriginY,
                relativeX + centerPadX,
                relativeY + centerPadY);
        }
        return false;
    }

    /// @brief Apply the current mouse tool to one bounded scene cell.
    hide func PumpCanvas() -> Boolean {
        if gameViewActive {
            return PumpGameViewCanvasNavigation();
        }
        if canvasImage != null and canvasImage.WasDropped() {
            return CreateSpriteObjectFromDrop(
                canvasImage.GetDropData(),
                canvasImage.GetDropX(),
                canvasImage.GetDropY()) >= 0;
        }
        if canvasMarqueeActive {
            if Input.Keyboard.WasPressed(Input.Key.Escape) {
                CancelCanvasMarquee();
                return false;
            }
            if !Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
                FinishCanvasMarquee();
                return false;
            }
        }
        if tileRectangleActive {
            if Input.Keyboard.WasPressed(Input.Key.Escape) {
                CancelTileRectangle();
                return false;
            }
            UpdateTileRectanglePointer();
            if !Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
                return FinishTileRectangle();
            }
            return false;
        }
        if paintStrokeActive {
            if Input.Keyboard.WasPressed(Input.Key.Escape) {
                CancelPaintStroke();
                return false;
            }
            if !Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
                return FinishPaintStroke();
            }
        }
        if objectDragActive
           and !Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
            return FinishObjectDrag();
        }
        if scene == null or canvasImage == null {
            return false;
        }
        if canvasImage.IsHovered() == false { return false; }
        if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft)
           or Input.Mouse.WasPressed(Input.Mouse.ButtonMiddle) {
            FocusActiveModeButton();
        }

        if Input.Mouse.IsDown(Input.Mouse.ButtonMiddle) {
            var panX = PhysicalPointerToUi(Input.Mouse.DeltaX());
            var panY = PhysicalPointerToUi(Input.Mouse.DeltaY());
            if panX != 0 or panY != 0 {
                SetLogicalScroll(
                    canvasScroll,
                    LogicalScrollX(canvasScroll) - panX,
                    LogicalScrollY(canvasScroll) - panY);
            }
            return false;
        }

        var relativeX = PhysicalPointerToUi(Input.Mouse.X())
            - canvasImage.GetScreenX();
        var relativeY = PhysicalPointerToUi(Input.Mouse.Y())
            - canvasImage.GetScreenY();
        if displayCellSize <= 0 { return false; }
        if rectGestureMode != 0 {
            return PumpRectGesture(relativeX, relativeY);
        }

        var wheel = Input.Mouse.WheelYFloat();
        if wheel > 0.0 or wheel < 0.0 {
            // The image's left/top edge sits exactly at content pixel
            // (viewOriginX, viewOriginY), and at (centerPadX, centerPadY)
            // inside the viewport, so both anchor forms derive directly.
            var direction = 1;
            if wheel < 0.0 { direction = -1; }
            ZoomStepAnchored(
                direction,
                relativeX + viewOriginX,
                relativeY + viewOriginY,
                relativeX + centerPadX,
                relativeY + centerPadY);
            return false;
        }

        if rectGestureMode != 0 {
            return PumpRectGesture(relativeX, relativeY);
        }
        if stampActive and Input.Keyboard.WasPressed(Input.Key.Escape) {
            ClearTileStamp();
            gestureEscapeConsumed = true;
            toolbarStatus.SetText("Stamp cleared");
        }
        var contentX = Convert.NumToInt(relativeX) + viewOriginX;
        var contentY = Convert.NumToInt(relativeY) + viewOriginY;
        if contentX < 0 or contentY < 0 { return false; }
        var cellX = contentX / displayCellSize;
        var cellY = contentY / displayCellSize;
        if cellX < 0 or cellY < 0
           or cellX >= scene.Width or cellY >= scene.Height {
            return false;
        }

        if selectedCellX != cellX or selectedCellY != cellY {
            renderDirty = true;
        }
        selectedCellX = cellX;
        selectedCellY = cellY;
        if canvasMarqueeActive {
            if canvasMarqueeCurrentX != cellX
               or canvasMarqueeCurrentY != cellY {
                canvasMarqueeCurrentX = cellX;
                canvasMarqueeCurrentY = cellY;
                renderDirty = true;
            }
            return false;
        }
        // Alt-hold is a transient eyedropper in every paint-family tool.
        if (mode == MODE_PAINT or mode == MODE_ERASE
            or mode == MODE_RECTANGLE or mode == MODE_FILL)
           and CanvasAltDown()
           and Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
            PickSceneTile(activeLayer, cellX, cellY);
            return false;
        }
        if mode == MODE_PAINT or mode == MODE_ERASE {
            if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
                paintStrokeActive = true;
                paintStrokeChanged = false;
                paintStrokeSnapshot = currentSerialized;
                lastPaintX = cellX;
                lastPaintY = cellY;
                if Input.Mouse.IsCaptured() == false {
                    Input.Mouse.Capture();
                }
                paintStrokeChanged =
                    ApplyStrokeCell(cellX, cellY) or paintStrokeChanged;
            }
            if paintStrokeActive
               and Input.Mouse.IsDown(Input.Mouse.ButtonLeft)
               and (cellX != lastPaintX or cellY != lastPaintY) {
                paintStrokeChanged =
                    ApplyStrokeLine(cellX, cellY) or paintStrokeChanged;
            }
            return false;
        }

        if mode == MODE_RECTANGLE or mode == MODE_LINE
           or mode == MODE_ELLIPSE {
            if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
                BeginTileRectangle(cellX, cellY);
            }
            return false;
        }

        if mode == MODE_FILL {
            if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
                var fillTile = ClampInt(
                    Convert.NumToInt(tileSpinner.Value), 0, 1000000);
                return FloodFillSceneTile(
                    activeLayer, cellX, cellY, fillTile) > 0;
            }
            return false;
        }

        if mode == MODE_PICKER {
            if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
                PickSceneTile(activeLayer, cellX, cellY);
            }
            return false;
        }

        if mode == MODE_OBJECT {
            if !Input.Mouse.WasClicked(Input.Mouse.ButtonLeft) { return false; }
            var objectIndex = AddSceneObject(
                "entity",
                UniqueObjectId("object-" + (scene.ObjectCount() + 1)),
                cellX * scene.TileWidth,
                cellY * scene.TileHeight);
            if objectIndex >= 0 {
                toolbarStatus.SetText("Placed object");
                return true;
            }
            return false;
        }

        if Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) {
            if RectToolEligible() {
                var handleHit = RectHandleAtPoint(
                    selectedObject, relativeX, relativeY);
                if handleHit >= 0 {
                    BeginRectGesture(handleHit, relativeX, relativeY);
                    return false;
                }
            }
            var hitObject = FindObjectAtCanvasPoint(relativeX, relativeY);
            var additive = CanvasShiftDown();
            var toggle = CanvasPrimaryModifierDown();
            if hitObject >= 0 {
                ApplyCanvasPointSelection(
                    hitObject, additive, toggle);
            } else {
                objectDragActive = false;
                objectDragChanged = false;
                objectDragSnapshot = "";
                objectDragIndex = -1;
                BeginCanvasMarquee(
                    cellX, cellY, additive, toggle);
                RefreshInspector();
                return false;
            }
            objectDragActive = additive == false
                and toggle == false
                and scene_selection.Contains(
                    selectedObjects, hitObject);
            objectDragChanged = false;
            objectDragSnapshot = currentSerialized;
            objectDragIndex = hitObject;
            if objectDragActive {
                objectDragLastX = scene.ObjectX(objectDragIndex);
                objectDragLastY = scene.ObjectY(objectDragIndex);
            } else {
                objectDragSnapshot = "";
                objectDragIndex = -1;
            }
            RefreshInspector();
            renderDirty = true;
            if objectDragActive {
                toolbarStatus.SetText(
                    "Drag " + selectedObjects.count()
                    + " selected object(s) together");
            } else if selectedObjects.count() > 0 {
                toolbarStatus.SetText(
                    "Selected " + selectedObjects.count()
                    + " canvas object(s)");
            } else {
                toolbarStatus.SetText("No canvas objects selected");
            }
        }
        if objectDragActive
           and Input.Mouse.IsDown(Input.Mouse.ButtonLeft)
           and objectDragIndex >= 0
           and objectDragIndex < scene.ObjectCount() {
            var objectX = cellX * scene.TileWidth;
            var objectY = cellY * scene.TileHeight;
            if CanvasPrimaryModifierDown() {
                // Ctrl/Cmd-hold drops the tile grid: the drag follows the
                // pointer at exact scene-pixel precision (positions are
                // already pixel integers in the model).
                objectX = CanvasFreePixelX(contentX);
                objectY = CanvasFreePixelY(contentY);
            }
            var deltaX = objectX - objectDragLastX;
            var deltaY = objectY - objectDragLastY;
            if deltaX != 0 or deltaY != 0 {
                objectDragChanged = TranslateSelectedObjectsUncommitted(
                    deltaX, deltaY) or objectDragChanged;
                objectDragLastX = objectX;
                objectDragLastY = objectY;
                objectXSpinner.SetValue(objectX);
                objectYSpinner.SetValue(objectY);
                renderDirty = true;
            }
        }
        return false;
    }

    /// @brief Apply focus-safe pixel/grid nudges from the Select surface.
    /// @details Object-list arrows retain native selection navigation and every
    ///          inspector input retains native editing. Shift uses one authored
    ///          tile on each axis; a diagonal key frame still commits once.
    ///          The focused canvas surface and the Select button both qualify.
    hide func PumpCanvasKeyboard() -> Boolean {
        if gameViewActive {
            if gameViewOutputFramed { return false; }
            if scene == null or canvasImage == null
               or canvasImage.IsFocused() == false {
                return false;
            }
            if Input.Keyboard.WasPressed(Input.Key.F) {
                initialFramePending = false;
                fitPending = false;
                if FitScene() { renderDirty = true; }
            }
            return false;
        }
        if scene == null or mode != MODE_SELECT
           or objectDragActive or paintStrokeActive
           or canvasMarqueeActive {
            return false;
        }
        var surfaceFocused =
            (canvasImage != null and canvasImage.IsFocused())
            or (selectButton != null and selectButton.IsFocused());
        if surfaceFocused == false { return false; }
        if Input.Keyboard.WasPressed(Input.Key.F) {
            if selectedObjects.count() > 0 {
                FrameSelected();
            } else {
                initialFramePending = false;
                fitPending = false;
                if FitScene() { renderDirty = true; }
            }
            return false;
        }
        if Input.Keyboard.WasPressed(Input.Key.Escape)
           and gestureEscapeConsumed == false
           and selectedObjects.count() > 0 {
            // Workspace-only: clearing selection never enters scene JSON,
            // history, or dirty state. A gesture canceled by this same key
            // edge sets gestureEscapeConsumed, preserving the selection.
            SelectSceneObjects([], -1);
            return false;
        }
        if selectedObjects.count() == 0 { return false; }
        var deltaX = 0;
        var deltaY = 0;
        if Input.Keyboard.WasPressed(Input.Key.Left) {
            deltaX = deltaX - 1;
        }
        if Input.Keyboard.WasPressed(Input.Key.Right) {
            deltaX = deltaX + 1;
        }
        if Input.Keyboard.WasPressed(Input.Key.Up) {
            deltaY = deltaY - 1;
        }
        if Input.Keyboard.WasPressed(Input.Key.Down) {
            deltaY = deltaY + 1;
        }
        if deltaX == 0 and deltaY == 0 { return false; }

        var coarse =
            Input.Keyboard.IsDown(Input.Key.LeftShift)
            or Input.Keyboard.IsDown(Input.Key.RightShift);
        if coarse {
            deltaX = deltaX * scene.TileWidth;
            deltaY = deltaY * scene.TileHeight;
        }
        var changed = TranslateSelectedSceneObjects(deltaX, deltaY);
        if changed {
            toolbarStatus.SetText(
                "Nudged " + selectedObjects.count() + " object(s) by "
                + deltaX + ", " + deltaY);
        }
        return changed;
    }

    /// @brief F2 begins an inline object-id rename of the single selection.
    /// @details The row editor pre-fills the raw id (rows decorate the label
    ///          with the type). Enter or focus loss commits through
    ///          ApplyObjectRename; Escape cancels.
    hide func PumpObjectRename() {
        if Input.Keyboard.WasPressed(Input.Key.F2) == false { return; }
        if SceneSelectionCommandsOwnFocus() == false { return; }
        BeginRenameSelectedObject();
    }

    /// @brief Begin a visible inline rename of the selected object's row.
    /// @details Shared by F2, context menus, and create-and-rename flows.
    ///          Viewport-priority layouts reveal the full-width hierarchy
    ///          master before opening the row editor. Focus mode refuses the
    ///          edit unless the hierarchy already owns a floating pane.
    /// @return True when the row editor opened.
    expose func BeginRenameSelectedObject() -> Boolean {
        if objectTree == null or scene == null { return false; }
        if objectTree.IsEditing() { return false; }
        if selectedObjects.count() != 1 { return false; }
        if selectedObject < 0
           or selectedObject >= objectTreeNodes.count()
           or objectTreeNodes.get(selectedObject) == null {
            return false;
        }
        if focusModeActive and hierarchyDock.floating == false {
            return false;
        }
        if hierarchyDock.floating == false
           and UsesDockedHierarchy(lastHostWidth) == false {
            compactHierarchyShown = true;
            compactInspectorShown = false;
            compactPaletteShown = false;
            ApplyInspectorLayout();
            ApplyPaletteLayout();
            CaptureWorkspaceState();
        }
        return objectTree.BeginEditNode(
            objectTreeNodes.get(selectedObject),
            scene.ObjectId(selectedObject));
    }

    /// @brief Create one root entity at the selected cell (or the origin).
    /// @details Shared by the Add Root button and the hierarchy context menu;
    ///          one undoable transaction through AddSceneObject.
    /// @return The new object index, or -1 when nothing was created.
    expose func CreateRootObjectAtSelection() -> Integer {
        if scene == null { return -1; }
        var x = 0;
        var y = 0;
        if selectedCellX >= 0 {
            x = selectedCellX * scene.TileWidth;
            y = selectedCellY * scene.TileHeight;
        }
        return AddSceneObject(
            "entity",
            UniqueObjectId("object-" + (scene.ObjectCount() + 1)),
            x,
            y);
    }

    /// @brief Create one child entity beneath the single selected object.
    /// @details Shared by the Add Child button and the hierarchy context
    ///          menu; one undoable transaction through AddSceneChildObject.
    /// @return The new object index, or -1 when nothing was created.
    expose func CreateChildObjectUnderSelection() -> Integer {
        if scene == null or selectedObjects.count() != 1
           or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            return -1;
        }
        var childParent = selectedObject;
        var childX = scene.ObjectX(childParent);
        var childY = scene.ObjectY(childParent);
        if selectedCellX >= 0 and selectedCellY >= 0 {
            childX = selectedCellX * scene.TileWidth;
            childY = selectedCellY * scene.TileHeight;
        }
        return AddSceneChildObject(
            childParent,
            "entity",
            UniqueObjectId("object-" + (scene.ObjectCount() + 1)),
            childX,
            childY);
    }

    /// @brief Create one entity at the scene cell under a physical point.
    /// @details Shared by the canvas context menu's "Add Object Here": one
    ///          undoable transaction, the new object selected, and its
    ///          inline hierarchy rename armed so the id is typed first.
    /// @param pointX Physical pointer x when the menu opened.
    /// @param pointY Physical pointer y when the menu opened.
    /// @return The new object index, or -1 when the point misses the scene.
    expose func CreateObjectAtCanvasPoint(pointX: Number,
                                          pointY: Number) -> Integer {
        if scene == null { return -1; }
        var cellX = CanvasCellAtPointX(pointX);
        var cellY = CanvasCellAtPointY(pointY);
        if cellX < 0 or cellY < 0 { return -1; }
        var objectIndex = AddSceneObject(
            "entity",
            UniqueObjectId("object-" + (scene.ObjectCount() + 1)),
            cellX * scene.TileWidth,
            cellY * scene.TileHeight);
        if objectIndex < 0 { return -1; }
        BeginRenameSelectedObject();
        return objectIndex;
    }

    /// @brief Compute one object's transformed canvas footprint (ADR 0192).
    /// @details Sprite objects use their native frame size at the current
    ///          zoom with scale applied about the pivot and the rotated
    ///          rectangle's axis-aligned bounds; non-sprite objects fall
    ///          back to their legacy one-cell footprint.
    hide func ObjectCanvasFootprint(objectIndex: Integer)
        -> ObjectFootprint2D {
        var rect = ObjectScaledRect(objectIndex);
        if rect.valid == false { return rect; }
        var rotation = scene.ObjectRotation(objectIndex);
        if RotationIsEffectivelyZero(rotation) { return rect; }
        var footprint = new ObjectFootprint2D();
        footprint.pivotCanvasX = rect.pivotCanvasX;
        footprint.pivotCanvasY = rect.pivotCanvasY;
        var radians = rotation * 3.14159265358979323846 / 180.0;
        var cosine = Math.Cos(radians);
        var sine = Math.Sin(radians);
        var corner = 0;
        while corner < 4 {
            var cornerX = rect.minX;
            if corner == 1 or corner == 3 { cornerX = rect.maxX; }
            var cornerY = rect.minY;
            if corner == 2 or corner == 3 { cornerY = rect.maxY; }
            var relativeX = cornerX - rect.pivotCanvasX;
            var relativeY = cornerY - rect.pivotCanvasY;
            var rotatedX = rect.pivotCanvasX
                + relativeX * cosine - relativeY * sine;
            var rotatedY = rect.pivotCanvasY
                + relativeX * sine + relativeY * cosine;
            if corner == 0 {
                footprint.minX = rotatedX;
                footprint.maxX = rotatedX;
                footprint.minY = rotatedY;
                footprint.maxY = rotatedY;
            } else {
                if rotatedX < footprint.minX { footprint.minX = rotatedX; }
                if rotatedX > footprint.maxX { footprint.maxX = rotatedX; }
                if rotatedY < footprint.minY { footprint.minY = rotatedY; }
                if rotatedY > footprint.maxY { footprint.maxY = rotatedY; }
            }
            corner = corner + 1;
        }
        footprint.valid = true;
        return footprint;
    }

    /// @brief The scale-only (unrotated) canvas rectangle for one object.
    /// @details Sprite objects use their zoomed native frame scaled about
    ///          the pivot; non-sprite objects keep the legacy one-cell
    ///          footprint. Pure query — never mutates the model.
    hide func ObjectScaledRect(objectIndex: Integer)
        -> ObjectFootprint2D {
        var footprint = new ObjectFootprint2D();
        if scene == null or displayCellSize <= 0
           or objectIndex < 0 or objectIndex >= scene.ObjectCount() {
            return footprint;
        }
        var anchorX = scene.ObjectX(objectIndex) * displayCellSize * 1.0
            / scene.TileWidth - viewOriginX;
        var anchorY = scene.ObjectY(objectIndex) * displayCellSize * 1.0
            / scene.TileHeight - viewOriginY;
        var path = ObjectSpritePath(objectIndex);
        var nativeWidth = 0;
        var nativeHeight = 0;
        if path != "" {
            nativeWidth = tilesets.SpriteNativeWidth(path);
            nativeHeight = tilesets.SpriteNativeHeight(path);
        }
        if nativeWidth <= 0 or nativeHeight <= 0 {
            footprint.valid = true;
            footprint.minX = anchorX;
            footprint.minY = anchorY;
            footprint.maxX = anchorX + displayCellSize;
            footprint.maxY = anchorY + displayCellSize;
            footprint.pivotCanvasX = anchorX + displayCellSize * 0.5;
            footprint.pivotCanvasY = anchorY + displayCellSize * 0.5;
            return footprint;
        }
        var baseWidth = nativeWidth * displayCellSize * 1.0
            / scene.TileWidth;
        var baseHeight = nativeHeight * displayCellSize * 1.0
            / scene.TileHeight;
        var magnitudeX = scene.ObjectScaleX(objectIndex);
        if magnitudeX < 0.0 { magnitudeX = 0.0 - magnitudeX; }
        var magnitudeY = scene.ObjectScaleY(objectIndex);
        if magnitudeY < 0.0 { magnitudeY = 0.0 - magnitudeY; }
        var scaledWidth = baseWidth * magnitudeX;
        var scaledHeight = baseHeight * magnitudeY;
        var pivotX = scene.ObjectPivotX(objectIndex);
        var pivotY = scene.ObjectPivotY(objectIndex);
        footprint.pivotCanvasX = anchorX + baseWidth * pivotX;
        footprint.pivotCanvasY = anchorY + baseHeight * pivotY;
        footprint.minX = footprint.pivotCanvasX - scaledWidth * pivotX;
        footprint.minY = footprint.pivotCanvasY - scaledHeight * pivotY;
        footprint.maxX = footprint.minX + scaledWidth;
        footprint.maxY = footprint.minY + scaledHeight;
        footprint.valid = true;
        return footprint;
    }

    /// @brief Whether one canvas point is inside an object's rotated sprite.
    /// @details Inverse-rotates the point about the pivot, then tests the
    ///          unrotated rectangle — exact for any rotation and scale.
    hide func ObjectFootprintContains(objectIndex: Integer,
                                      canvasX: Number,
                                      canvasY: Number) -> Boolean {
        var footprint = ObjectCanvasFootprint(objectIndex);
        if footprint.valid == false { return false; }
        var rotation = scene.ObjectRotation(objectIndex);
        if RotationIsEffectivelyZero(rotation) {
            return canvasX >= footprint.minX and canvasX <= footprint.maxX
                and canvasY >= footprint.minY and canvasY <= footprint.maxY;
        }
        // Quick reject against the rotated bounds before the exact test.
        if canvasX < footprint.minX or canvasX > footprint.maxX
           or canvasY < footprint.minY or canvasY > footprint.maxY {
            return false;
        }
        var radians = (0.0 - rotation) * 3.14159265358979323846 / 180.0;
        var cosine = Math.Cos(radians);
        var sine = Math.Sin(radians);
        var relativeX = canvasX - footprint.pivotCanvasX;
        var relativeY = canvasY - footprint.pivotCanvasY;
        var localX = footprint.pivotCanvasX
            + relativeX * cosine - relativeY * sine;
        var localY = footprint.pivotCanvasY
            + relativeX * sine + relativeY * cosine;
        var unrotated = ObjectScaledRect(objectIndex);
        return localX >= unrotated.minX and localX <= unrotated.maxX
            and localY >= unrotated.minY and localY <= unrotated.maxY;
    }

    /// @brief Canvas position of one rect handle (0-3 corners, 4 rotate).
    /// @details Corners follow the rotated scaled rectangle; the rotate
    ///          handle floats above the rotated top-center. Order: 0 TL,
    ///          1 TR, 2 BL, 3 BR (pre-rotation identities).
    expose func RectHandlePoint(objectIndex: Integer,
                                handle: Integer) -> CanvasPoint2D {
        var point = new CanvasPoint2D();
        var rect = ObjectScaledRect(objectIndex);
        if rect.valid == false { return point; }
        var localX = rect.minX;
        var localY = rect.minY;
        if handle == 1 or handle == 3 { localX = rect.maxX; }
        if handle == 2 or handle == 3 { localY = rect.maxY; }
        if handle == 4 {
            localX = (rect.minX + rect.maxX) * 0.5;
            localY = rect.minY - RECT_ROTATE_HANDLE_OFFSET;
        }
        var rotation = scene.ObjectRotation(objectIndex);
        if RotationIsEffectivelyZero(rotation) {
            point.x = localX;
            point.y = localY;
            return point;
        }
        var radians = rotation * 3.14159265358979323846 / 180.0;
        var cosine = Math.Cos(radians);
        var sine = Math.Sin(radians);
        var relativeX = localX - rect.pivotCanvasX;
        var relativeY = localY - rect.pivotCanvasY;
        point.x = rect.pivotCanvasX
            + relativeX * cosine - relativeY * sine;
        point.y = rect.pivotCanvasY
            + relativeX * sine + relativeY * cosine;
        return point;
    }

    /// @brief The rect handle under a canvas point, or -1.
    hide func RectHandleAtPoint(objectIndex: Integer,
                                pointX: Number,
                                pointY: Number) -> Integer {
        var handle = 0;
        while handle <= 4 {
            var handlePoint = RectHandlePoint(objectIndex, handle);
            var deltaX = pointX - handlePoint.x;
            var deltaY = pointY - handlePoint.y;
            if deltaX * deltaX + deltaY * deltaY
               <= RECT_HANDLE_RADIUS_SQUARED {
                return handle;
            }
            handle = handle + 1;
        }
        return -1;
    }

    /// @brief Whether the rect tool applies to the current selection.
    hide func RectToolEligible() -> Boolean {
        return mode == MODE_SELECT
            and selectedObjects.count() == 1
            and selectedObject >= 0
            and selectedObject < scene.ObjectCount()
            and ObjectSpritePath(selectedObject) != "";
    }

    /// @brief Begin a rect-handle gesture at one canvas point.
    hide func BeginRectGesture(handle: Integer,
                               pointX: Number,
                               pointY: Number) {
        var rect = ObjectScaledRect(selectedObject);
        CaptureObjectDraftOrigins();
        rectStartScaleX = scene.ObjectScaleX(selectedObject);
        rectStartScaleY = scene.ObjectScaleY(selectedObject);
        rectStartRotation = scene.ObjectRotation(selectedObject);
        if handle == 4 {
            rectGestureMode = 2;
            rectStartAngle = Math.Atan2(
                pointY - rect.pivotCanvasY, pointX - rect.pivotCanvasX);
        } else {
            rectGestureMode = 1;
            rectGestureHandle = handle;
            var local = RectGestureLocalPoint(pointX, pointY);
            rectStartLocalX = local.x;
            rectStartLocalY = local.y;
        }
    }

    /// @brief A pointer position inverse-rotated into gesture-local space.
    hide func RectGestureLocalPoint(pointX: Number,
                                    pointY: Number) -> CanvasPoint2D {
        var point = new CanvasPoint2D();
        var rect = ObjectScaledRect(selectedObject);
        var radians = (0.0 - rectStartRotation)
            * 3.14159265358979323846 / 180.0;
        var cosine = Math.Cos(radians);
        var sine = Math.Sin(radians);
        var relativeX = pointX - rect.pivotCanvasX;
        var relativeY = pointY - rect.pivotCanvasY;
        point.x = relativeX * cosine - relativeY * sine;
        point.y = relativeX * sine + relativeY * cosine;
        return point;
    }

    /// @brief Track and complete an active rect-handle gesture.
    /// @return True when a completed gesture committed content.
    hide func PumpRectGesture(pointX: Number, pointY: Number) -> Boolean {
        if rectGestureMode == 0 { return false; }
        if selectedObjects.count() != 1 or selectedObject < 0
           or selectedObject >= scene.ObjectCount() {
            rectGestureMode = 0;
            return false;
        }
        if Input.Keyboard.WasPressed(Input.Key.Escape) {
            scene.SetObjectRotation(
                selectedObject, objectDraftOriginRotation);
            scene.SetObjectScale(
                selectedObject,
                objectDraftOriginScaleX, objectDraftOriginScaleY);
            rectGestureMode = 0;
            gestureEscapeConsumed = true;
            RefreshObjectFields();
            renderDirty = true;
            toolbarStatus.SetText("Transform gesture canceled");
            return false;
        }
        if Input.Mouse.IsDown(Input.Mouse.ButtonLeft) {
            var rect = ObjectScaledRect(selectedObject);
            if rectGestureMode == 2 {
                var angle = Math.Atan2(
                    pointY - rect.pivotCanvasY,
                    pointX - rect.pivotCanvasX);
                var degrees = rectStartRotation
                    + (angle - rectStartAngle)
                      * 180.0 / 3.14159265358979323846;
                scene.SetObjectRotation(selectedObject, degrees);
            } else {
                var local = RectGestureLocalPoint(pointX, pointY);
                var nextScaleX = rectStartScaleX;
                var nextScaleY = rectStartScaleY;
                if rectStartLocalX > 0.5 or rectStartLocalX < -0.5 {
                    nextScaleX = rectStartScaleX
                        * local.x / rectStartLocalX;
                }
                if rectStartLocalY > 0.5 or rectStartLocalY < -0.5 {
                    nextScaleY = rectStartScaleY
                        * local.y / rectStartLocalY;
                }
                scene.SetObjectScale(
                    selectedObject, nextScaleX, nextScaleY);
            }
            RefreshObjectFields();
            renderDirty = true;
            return false;
        }
        var wasRotate = rectGestureMode == 2;
        rectGestureMode = 0;
        renderDirty = true;
        var label = "Scaled object";
        if wasRotate { label = "Rotated object"; }
        if NumberDiffers(
               scene.ObjectRotation(selectedObject),
               objectDraftOriginRotation) == false
           and NumberDiffers(
               scene.ObjectScaleX(selectedObject),
               objectDraftOriginScaleX) == false
           and NumberDiffers(
               scene.ObjectScaleY(selectedObject),
               objectDraftOriginScaleY) == false {
            return false;
        }
        return CommitScene(label);
    }

    /// @brief Record one inclusive marquee rect as the active tile region.
    hide func SetTileRegion(startX: Integer,
                            startY: Integer,
                            endX: Integer,
                            endY: Integer) {
        if scene == null or startX < 0 or startY < 0
           or endX < 0 or endY < 0 {
            ClearTileRegion();
            return;
        }
        var minX = startX;
        var maxX = endX;
        if maxX < minX {
            minX = endX;
            maxX = startX;
        }
        var minY = startY;
        var maxY = endY;
        if maxY < minY {
            minY = endY;
            maxY = startY;
        }
        tileRegionMinX = ClampInt(minX, 0, scene.Width - 1);
        tileRegionMaxX = ClampInt(maxX, 0, scene.Width - 1);
        tileRegionMinY = ClampInt(minY, 0, scene.Height - 1);
        tileRegionMaxY = ClampInt(maxY, 0, scene.Height - 1);
        renderDirty = true;
    }

    /// @brief Clear the active tile region marker.
    hide func ClearTileRegion() {
        if tileRegionMinX < 0 { return; }
        tileRegionMinX = -1;
        tileRegionMinY = -1;
        tileRegionMaxX = -1;
        tileRegionMaxY = -1;
        stampActive = false;
        stampWidth = 0;
        stampHeight = 0;
        stampTiles = [];
        hoverCellX = -1;
        hoverCellY = -1;
        renderDirty = true;
    }

    /// @brief Whether a tile region and a valid active layer both exist.
    expose func HasTileRegion() -> Boolean {
        return scene != null and tileRegionMinX >= 0
            and activeLayer >= 0 and activeLayer < scene.LayerCount();
    }

    /// @brief Copy the active layer's region tiles to the clipboard.
    expose func CopyTileRegion() -> Boolean {
        if HasTileRegion() == false { return false; }
        var tiles: List[Integer] = [];
        var y = tileRegionMinY;
        while y <= tileRegionMaxY {
            var x = tileRegionMinX;
            while x <= tileRegionMaxX {
                tiles.add(scene.GetTile(activeLayer, x, y));
                x = x + 1;
            }
            y = y + 1;
        }
        var encoded = scene_clipboard.EncodeTileBlock(
            tileRegionMaxX - tileRegionMinX + 1,
            tileRegionMaxY - tileRegionMinY + 1,
            tiles);
        if encoded == "" {
            detailLabel.SetText(
                "The tile region exceeds Studio's clipboard limit.");
            return false;
        }
        GUI.ClipboardText.SetText(encoded);
        toolbarStatus.SetText(
            "Copied " + tiles.count() + " tile(s)");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Clear the region tiles on the active layer as one edit.
    expose func DeleteTileRegion() -> Boolean {
        if HasTileRegion() == false { return false; }
        if RefuseLockedLayer(activeLayer) { return false; }
        var changedCells = 0;
        var y = tileRegionMinY;
        while y <= tileRegionMaxY {
            var x = tileRegionMinX;
            while x <= tileRegionMaxX {
                if scene.GetTile(activeLayer, x, y) != 0 {
                    scene.SetTile(activeLayer, x, y, 0);
                    changedCells = changedCells + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        if changedCells == 0 { return false; }
        if CommitScene("Deleted tile region") == false {
            RestoreSceneSnapshot(currentSerialized);
            return false;
        }
        renderDirty = true;
        toolbarStatus.SetText(
            "Deleted " + changedCells + " tile(s)");
        return true;
    }

    /// @brief Copy then clear the region tiles as one undoable edit.
    expose func CutTileRegion() -> Boolean {
        if CopyTileRegion() == false { return false; }
        if DeleteTileRegion() == false {
            toolbarStatus.SetText(
                "Copied tiles; the region was already empty");
            return false;
        }
        toolbarStatus.SetText("Cut tile region");
        return true;
    }

    /// @brief Paste a clipboard tile block with its top-left at one cell.
    /// @details One undoable transaction; cells falling outside the scene
    ///          clip away. Zero tiles in the block DO paste (they erase),
    ///          matching every tile editor's block-move behavior.
    expose func PasteTileBlockAt(cellX: Integer,
                                 cellY: Integer) -> Boolean {
        if scene == null
           or activeLayer < 0 or activeLayer >= scene.LayerCount() {
            return false;
        }
        if RefuseLockedLayer(activeLayer) { return false; }
        var payload = scene_clipboard.DecodeTileBlock(
            GUI.ClipboardText.GetText());
        if payload.valid == false {
            detailLabel.SetText(payload.error);
            return false;
        }
        var changedCells = 0;
        var row = 0;
        while row < payload.height {
            var column = 0;
            while column < payload.width {
                var targetX = cellX + column;
                var targetY = cellY + row;
                if targetX >= 0 and targetX < scene.Width
                   and targetY >= 0 and targetY < scene.Height {
                    var tile = payload.tiles.get(
                        row * payload.width + column);
                    if scene.GetTile(activeLayer, targetX, targetY)
                       != tile {
                        scene.SetTile(
                            activeLayer, targetX, targetY, tile);
                        changedCells = changedCells + 1;
                    }
                }
                column = column + 1;
            }
            row = row + 1;
        }
        if changedCells == 0 {
            toolbarStatus.SetText("Paste changed no tiles");
            return false;
        }
        if CommitScene("Pasted tile region") == false {
            RestoreSceneSnapshot(currentSerialized);
            return false;
        }
        SetTileRegion(
            cellX, cellY,
            cellX + payload.width - 1, cellY + payload.height - 1);
        renderDirty = true;
        toolbarStatus.SetText(
            "Pasted " + changedCells + " tile(s)");
        detailLabel.SetText("");
        return true;
    }

    /// @brief Adopt the recorded tile region as the active paint stamp.
    /// @details Stamps come from the canvas region rather than the palette
    ///          because the palette's 8-column display grid does not match
    ///          arbitrary atlas layouts; the region always captures the
    ///          true arrangement. Switching tools or Escape clears it.
    expose func UseTileRegionAsStamp() -> Boolean {
        if HasTileRegion() == false { return false; }
        stampTiles = [];
        var y = tileRegionMinY;
        while y <= tileRegionMaxY {
            var x = tileRegionMinX;
            while x <= tileRegionMaxX {
                stampTiles.add(scene.GetTile(activeLayer, x, y));
                x = x + 1;
            }
            y = y + 1;
        }
        stampWidth = tileRegionMaxX - tileRegionMinX + 1;
        stampHeight = tileRegionMaxY - tileRegionMinY + 1;
        stampActive = true;
        SetToolMode(MODE_PAINT);
        toolbarStatus.SetText(
            "Stamp " + stampWidth + "x" + stampHeight
            + "; Escape or a tool switch clears it");
        renderDirty = true;
        return true;
    }

    /// @brief Clear the active paint stamp back to single-tile painting.
    expose func ClearTileStamp() {
        if stampActive == false { return; }
        stampActive = false;
        stampWidth = 0;
        stampHeight = 0;
        stampTiles = [];
        renderDirty = true;
    }

    /// @brief Write the stamp block anchored to its tiling grid at one cell.
    /// @details Cells align to floor(cell / stampSize) * stampSize so drag
    ///          strokes tile the stamp seamlessly instead of smearing it.
    hide func ApplyStampAt(cellX: Integer, cellY: Integer) -> Boolean {
        var anchorX = cellX / stampWidth * stampWidth;
        var anchorY = cellY / stampHeight * stampHeight;
        var changed = false;
        var row = 0;
        while row < stampHeight {
            var column = 0;
            while column < stampWidth {
                var targetX = anchorX + column;
                var targetY = anchorY + row;
                if targetX >= 0 and targetX < scene.Width
                   and targetY >= 0 and targetY < scene.Height {
                    changed = ApplyTileCell(
                        activeLayer, targetX, targetY,
                        stampTiles.get(row * stampWidth + column))
                        or changed;
                }
                column = column + 1;
            }
            row = row + 1;
        }
        return changed;
    }

    /// @brief Scene-pixel x for one canvas content x (free placement).
    /// @details The Ctrl/Cmd-hold drag path: content pixels scale to scene
    ///          pixels by the authored tile size over the display cell size.
    expose func CanvasFreePixelX(contentXValue: Integer) -> Integer {
        if scene == null or displayCellSize <= 0 { return 0; }
        return contentXValue * scene.TileWidth / displayCellSize;
    }

    /// @brief Scene-pixel y for one canvas content y (free placement).
    expose func CanvasFreePixelY(contentYValue: Integer) -> Integer {
        if scene == null or displayCellSize <= 0 { return 0; }
        return contentYValue * scene.TileHeight / displayCellSize;
    }

    /// @brief The scene cell at one physical point, or -1 outside the canvas.
    expose func CanvasCellAtPointX(pointX: Number) -> Integer {
        return CanvasCellAtPoint(pointX, 0.0, true);
    }

    /// @brief The scene row at one physical point, or -1 outside the canvas.
    expose func CanvasCellAtPointY(pointY: Number) -> Integer {
        return CanvasCellAtPoint(0.0, pointY, false);
    }

    /// @brief Shared point-to-cell math mirroring the canvas hit path.
    /// @details Validates only the queried axis: each caller resolves one
    ///          axis at a time, so the other point argument is a dummy.
    hide func CanvasCellAtPoint(pointX: Number,
                                pointY: Number,
                                horizontal: Boolean) -> Integer {
        if scene == null or canvasImage == null
           or displayCellSize <= 0 {
            return -1;
        }
        if horizontal {
            var relativeX = PhysicalPointerToUi(pointX)
                - canvasImage.GetScreenX();
            var contentX = Convert.NumToInt(relativeX) + viewOriginX;
            if contentX < 0 { return -1; }
            var cellX = contentX / displayCellSize;
            if cellX >= scene.Width { return -1; }
            return cellX;
        }
        var relativeY = PhysicalPointerToUi(pointY)
            - canvasImage.GetScreenY();
        var contentY = Convert.NumToInt(relativeY) + viewOriginY;
        if contentY < 0 { return -1; }
        var cellY = contentY / displayCellSize;
        if cellY >= scene.Height { return -1; }
        return cellY;
    }

    /// @brief Create one sprite object from a dropped image asset.
    /// @details One undoable transaction: the object and its editor.sprite
    ///          reference commit together. The drop lands at the recorded
    ///          drop point's cell; non-image assets are refused.
    /// @param assetPath Absolute workspace path of the dropped asset.
    /// @param dropX Physical pointer x recorded when the drop landed.
    /// @param dropY Physical pointer y recorded when the drop landed.
    /// @return The new object index, or -1 when nothing was created.
    expose func CreateSpriteObjectFromDrop(assetPath: String,
                                           dropX: Number,
                                           dropY: Number) -> Integer {
        if scene == null or assetPath == "" { return -1; }
        if scene_asset_browser.AssetExtensionAllowed(
               assetPath,
               scene_asset_browser.NormalizeAssetExtensions(
                   ".png,.jpg,.jpeg,.bmp,.gif")) == false {
            detailLabel.SetText(
                "Only image assets can drop onto the canvas as sprites.");
            return -1;
        }
        var cellX = CanvasCellAtPointX(dropX);
        var cellY = CanvasCellAtPointY(dropY);
        if cellX < 0 or cellY < 0 {
            detailLabel.SetText(
                "Drop the asset over a scene cell to place a sprite.");
            return -1;
        }
        var documentPath = "";
        if currentDoc != null { documentPath = currentDoc.filePath; }
        var portable = scene_asset_browser.PortableReferencePath(
            assetPath, documentPath);
        if portable == "" {
            detailLabel.SetText(
                "The dropped asset has no portable project reference.");
            return -1;
        }
        var objectId = UniqueObjectId(
            "sprite-" + (scene.ObjectCount() + 1));
        var previousSelection = selectedObjects;
        var previousPrimary = selectedObject;
        var objectIndex = scene.AddObject(
            "sprite", objectId,
            cellX * scene.TileWidth, cellY * scene.TileHeight);
        if objectIndex < 0 { return -1; }
        scene.ObjectSetStr(objectIndex, "editor.sprite", portable);
        selectedObject = objectIndex;
        selectedObjects = scene_selection.Single(
            objectIndex, scene.ObjectCount());
        if CommitScene("Dropped sprite " + objectId) == false {
            scene.RemoveObject(objectIndex);
            selectedObject = previousPrimary;
            selectedObjects = previousSelection;
            detailLabel.SetText(
                "The dropped sprite could not be committed.");
            RefreshInspector();
            return -1;
        }
        detailLabel.SetText("");
        RefreshInspector();
        renderDirty = true;
        return objectIndex;
    }

    /// @brief Move the single selected object before its previous sibling.
    /// @details Shared by the Up button and the hierarchy context menu.
    expose func MoveSelectedObjectEarlier() -> Boolean {
        if selectedObjects.count() != 1 { return false; }
        var previousSibling = PreviousObjectSibling(selectedObject);
        if previousSibling < 0 { return false; }
        return ApplyObjectHierarchyDrop(selectedObject, previousSibling, 0);
    }

    /// @brief Move the single selected object after its next sibling.
    /// @details Shared by the Down button and the hierarchy context menu.
    expose func MoveSelectedObjectLater() -> Boolean {
        if selectedObjects.count() != 1 { return false; }
        var nextSibling = NextObjectSibling(selectedObject);
        if nextSibling < 0 { return false; }
        return ApplyObjectHierarchyDrop(selectedObject, nextSibling, 2);
    }

    /// @brief Switch the active canvas tool as workspace-only state.
    /// @details Shared by the toolbar buttons and the canvas context menu.
    expose func SetToolMode(nextMode: Integer) {
        SetMode(nextMode);
    }

    /// @brief Apply a committed inline object-id rename as one undoable edit.
    /// @details The edited row's data carries the object index, so a selection
    ///          change between commit and consumption cannot retarget the
    ///          rename. UpdateSceneObject owns emptiness, uniqueness, model
    ///          acceptance, rollback, and the single history entry.
    hide func ApplyObjectRename() -> Boolean {
        var edited = objectTree.GetEditedNodeOption();
        if edited.IsSome == false { return false; }
        var index = Parse.IntOr(
            GUI.TreeView.Node.GetData(edited.Unwrap()), -1);
        if index < 0 or index >= scene.ObjectCount() { return false; }
        var nextId = Str.Trim(objectTree.GetEditText());
        if nextId == "" or nextId == scene.ObjectId(index) { return false; }
        return UpdateSceneObject(
            index,
            scene.ObjectType(index),
            nextId,
            scene.ObjectX(index),
            scene.ObjectY(index));
    }

    /// @brief Return whether scene selection shortcuts belong to this surface.
    /// @details Inspector text/value controls intentionally do not qualify.
    ///          The focused canvas surface is the primary owner; tool and
    ///          hierarchy controls remain accepted for keyboard workflows.
    expose func SceneSelectionCommandsOwnFocus() -> Boolean {
        return (canvasImage != null and canvasImage.IsFocused())
            or (objectTree != null and objectTree.IsFocused())
            or (selectButton != null and selectButton.IsFocused())
            or (paintButton != null and paintButton.IsFocused())
            or (eraseButton != null and eraseButton.IsFocused())
            or (objectButton != null and objectButton.IsFocused())
            or (duplicateObjectButton != null
                and duplicateObjectButton.IsFocused())
            or (removeObjectButton != null
                and removeObjectButton.IsFocused())
            or (objectUpButton != null and objectUpButton.IsFocused())
            or (objectDownButton != null and objectDownButton.IsFocused());
    }

    /// @brief Give the canvas surface keyboard focus for its shortcuts.
    /// @details The canvas Image is a real focusable widget; clicking it
    ///          already focuses it through the GUI's click-to-focus path, so
    ///          shortcut ownership follows the surface rather than a
    ///          mode-button proxy.
    hide func FocusActiveModeButton() {
        if canvasImage != null { canvasImage.Focus(); }
    }

    /// @brief Mutate one cell inside the current uncommitted paint stroke.
    hide func ApplyStrokeCell(cellX: Integer, cellY: Integer) -> Boolean {
        if RefuseLockedLayer(activeLayer) { return false; }
        if mode == MODE_PAINT and stampActive
           and stampWidth > 0 and stampHeight > 0 {
            return ApplyStampAt(cellX, cellY);
        }
        var tile = 0;
        if mode == MODE_PAINT {
            tile = Convert.NumToInt(tileSpinner.Value);
            if tile < 0 { tile = 0; }
        }
        return ApplyTileCell(activeLayer, cellX, cellY, tile);
    }

    /// @brief Fill every raster cell between the last and current pointer cell.
    hide func ApplyStrokeLine(targetX: Integer,
                              targetY: Integer) -> Boolean {
        var startX = lastPaintX;
        var startY = lastPaintY;
        if startX < 0 or startY < 0 {
            startX = targetX;
            startY = targetY;
        }
        var tile = 0;
        if mode == MODE_PAINT {
            tile = Convert.NumToInt(tileSpinner.Value);
            if tile < 0 { tile = 0; }
        }
        var changed = ApplyTileLineUncommitted(
            activeLayer, startX, startY, targetX, targetY, tile);
        lastPaintX = targetX;
        lastPaintY = targetY;
        return changed;
    }

    hide func ApplyTileCell(layer: Integer,
                            cellX: Integer,
                            cellY: Integer,
                            tile: Integer) -> Boolean {
        if scene == null or layer < 0 or layer >= scene.LayerCount()
           or cellX < 0 or cellY < 0
           or cellX >= scene.Width or cellY >= scene.Height {
            return false;
        }
        if scene.GetTile(layer, cellX, cellY) == tile { return false; }
        scene.SetTile(layer, cellX, cellY, tile);
        renderDirty = true;
        return true;
    }

    hide func ApplyTileLineUncommitted(layer: Integer,
                                       startX: Integer,
                                       startY: Integer,
                                       targetX: Integer,
                                       targetY: Integer,
                                       tile: Integer) -> Boolean {
        var x = startX;
        var y = startY;
        var dx = AbsInt2D(targetX - x);
        var sx = -1;
        if x < targetX { sx = 1; }
        var dy = 0 - AbsInt2D(targetY - y);
        var sy = -1;
        if y < targetY { sy = 1; }
        var error = dx + dy;
        var changed = false;
        while true {
            changed = ApplyTileCell(layer, x, y, tile) or changed;
            if x == targetX and y == targetY { break; }
            var doubled = error * 2;
            if doubled >= dy {
                error = error + dy;
                x = x + sx;
            }
            if doubled <= dx {
                error = error + dx;
                y = y + sy;
            }
        }
        return changed;
    }

    /// @brief Commit one complete paint gesture as a single history entry.
    hide func FinishPaintStroke() -> Boolean {
        var changed = paintStrokeChanged;
        var snapshot = paintStrokeSnapshot;
        ResetPaintStroke(true);
        if changed == false { return false; }

        var message = "Painted tile stroke";
        if mode == MODE_ERASE { message = "Erased tile stroke"; }
        if CommitScene(message) { return true; }
        RestoreSceneSnapshot(snapshot);
        detailLabel.SetText("The tile stroke could not be committed.");
        return false;
    }

    /// @brief Commit one complete object drag as a single history entry.
    hide func FinishObjectDrag() -> Boolean {
        var changed = objectDragChanged;
        var snapshot = objectDragSnapshot;
        var index = objectDragIndex;
        objectDragActive = false;
        objectDragChanged = false;
        objectDragSnapshot = "";
        objectDragIndex = -1;
        objectDragLastX = 0;
        objectDragLastY = 0;
        if changed == false { return false; }
        selectedObject = index;
        var count = selectedObjects.count();
        var message = "Moved " + count + " objects";
        if count == 1 { message = "Moved scene object"; }
        if CommitScene(message) {
            RefreshInspector();
            return true;
        }
        RestoreSceneSnapshot(snapshot);
        detailLabel.SetText("The object move could not be committed.");
        return false;
    }

    /// @brief Topmost object whose transformed sprite contains one point.
    /// @details The same project/per-object stack used for painting wins.
    ///          Sprite objects test their exact rotated footprint (ADR 0192);
    ///          markers keep their legacy one-cell footprint.
    /// @param pointX Canvas-relative x in display pixels.
    /// @param pointY Canvas-relative y in display pixels.
    hide func FindObjectAtCanvasPoint(pointX: Number,
                                      pointY: Number) -> Integer {
        if scene == null { return -1; }
        var stack = ObjectPreviewStack();
        var stackIndex = stack.count() - 1;
        while stackIndex >= 0 {
            var index = stack.get(stackIndex);
            if ObjectFootprintContains(index, pointX, pointY) {
                return index;
            }
            stackIndex = stackIndex - 1;
        }
        return -1;
    }

    hide func FindObjectAtCell(cellX: Integer, cellY: Integer) -> Integer {
        if scene == null { return -1; }
        var stack = ObjectPreviewStack();
        var stackIndex = stack.count() - 1;
        while stackIndex >= 0 {
            var index = stack.get(stackIndex);
            var objectCellX = scene.ObjectX(index) / scene.TileWidth;
            var objectCellY = scene.ObjectY(index) / scene.TileHeight;
            if objectCellX == cellX and objectCellY == cellY { return index; }
            stackIndex = stackIndex - 1;
        }
        return -1;
    }

    hide func FitScene() -> Boolean {
        if scene == null or canvasScroll == null { return false; }
        var width = Convert.NumToInt(
            canvasScroll.GetLogicalWidth() - 24.0);
        var height = Convert.NumToInt(
            canvasScroll.GetLogicalHeight() - 24.0);
        if width <= 0 or height <= 0 { return false; }
        zoomPercent = FitZoomPercent(
            scene.Width, scene.Height, SceneTilePixelSize(),
            width, height);
        SetLogicalScroll(canvasScroll, 0.0, 0.0);
        return true;
    }

    /// @brief Apply first-open framing after scene and viewport both exist.
    /// @details A useful whole-scene view wins for compact scenes. Large
    ///          gameplay worlds preserve native artwork and open around their
    ///          authored player start instead of as an unreadable thumbnail.
    hide func FrameInitialScene() -> Boolean {
        if scene == null or canvasScroll == null { return false; }
        var width = Convert.NumToInt(
            canvasScroll.GetLogicalWidth() - 24.0);
        var height = Convert.NumToInt(
            canvasScroll.GetLogicalHeight() - 24.0);
        if width <= 0 or height <= 0 { return false; }
        var fit = FitZoomPercent(
            scene.Width, scene.Height, SceneTilePixelSize(),
            width, height);
        zoomPercent = InitialSceneZoomPercent(
            scene.Width, scene.Height, SceneTilePixelSize(),
            width, height);
        fitPending = false;
        if zoomPercent == fit {
            return FitScene();
        }
        return CenterCanvasAtWorldPoint(
            InitialSceneFocusWorldX(), InitialSceneFocusWorldY());
    }

    /// @brief Center the viewport on the selected objects at a useful scale.
    /// @details Matches the 3D editor's F shortcut: one selection gets detail,
    ///          while a spread-out selection is fitted as a bounded group.
    expose func FrameSelected() -> Boolean {
        if gameViewOutputFramed { return false; }
        if scene == null or canvasScroll == null { return false; }
        selectedObjects = scene_selection.Normalize(
            selectedObjects, scene.ObjectCount(), selectedObject);
        if selectedObjects.count() == 0 { return false; }
        var first = selectedObjects.get(0);
        var minimumX = scene.ObjectX(first);
        var minimumY = scene.ObjectY(first);
        var maximumX = minimumX;
        var maximumY = minimumY;
        var index = 1;
        while index < selectedObjects.count() {
            var objectIndex = selectedObjects.get(index);
            var x = scene.ObjectX(objectIndex);
            var y = scene.ObjectY(objectIndex);
            if x < minimumX { minimumX = x; }
            if y < minimumY { minimumY = y; }
            if x > maximumX { maximumX = x; }
            if y > maximumY { maximumY = y; }
            index = index + 1;
        }

        var width = Convert.NumToInt(
            canvasScroll.GetLogicalWidth() - 24.0);
        var height = Convert.NumToInt(
            canvasScroll.GetLogicalHeight() - 24.0);
        if width <= 0 or height <= 0 { return false; }
        var selectionColumns =
            (maximumX - minimumX) / scene.TileWidth + 3;
        var selectionRows =
            (maximumY - minimumY) / scene.TileHeight + 3;
        zoomPercent = FitZoomPercent(
            selectionColumns, selectionRows, SceneTilePixelSize(),
            width, height);
        if zoomPercent > MAX_FRAME_SELECTION_ZOOM_PERCENT {
            zoomPercent = MAX_FRAME_SELECTION_ZOOM_PERCENT;
        }
        initialFramePending = false;
        fitPending = false;
        restoreScrollPending = false;
        var framed = CenterCanvasAtWorldPoint(
            (minimumX + maximumX + scene.TileWidth) / 2,
            (minimumY + maximumY + scene.TileHeight) / 2);
        if framed {
            toolbarStatus.SetText(
                "Framed " + selectedObjects.count() + " object(s)");
            CaptureWorkspaceState();
        }
        return framed;
    }

    /// @brief Return the best gameplay focus in authored scene pixels.
    hide func InitialSceneFocusWorldX() -> Integer {
        if scene.PropertyKind("playerStartX") == "int"
           and scene.PropertyKind("playerStartY") == "int" {
            return scene.GetInt("playerStartX", 0)
                + scene.TileWidth / 2;
        }
        var index = InitialPlayerStartObject();
        if index >= 0 {
            return scene.ObjectX(index) + scene.TileWidth / 2;
        }
        return scene.Width * scene.TileWidth / 2;
    }

    /// @brief Return the best gameplay focus in authored scene pixels.
    hide func InitialSceneFocusWorldY() -> Integer {
        if scene.PropertyKind("playerStartX") == "int"
           and scene.PropertyKind("playerStartY") == "int" {
            return scene.GetInt("playerStartY", 0)
                + scene.TileHeight / 2;
        }
        var index = InitialPlayerStartObject();
        if index >= 0 {
            return scene.ObjectY(index) + scene.TileHeight / 2;
        }
        return scene.Height * scene.TileHeight / 2;
    }

    /// @brief Find the conventional player-start object without editing data.
    hide func InitialPlayerStartObject() -> Integer {
        var index = 0;
        while index < scene.ObjectCount() {
            if Str.ToLower(scene.ObjectType(index)) == "player-start"
               or Str.ToLower(scene.ObjectId(index)) == "player-start" {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Publish the current zoom extent before changing scroll.
    hide func PublishCanvasExtentForZoom() {
        if scene == null or canvasStage == null or canvasScroll == null {
            return;
        }
        var cell = DisplayCellForZoom();
        var stageWidth = scene.Width * cell + 1;
        var stageHeight = scene.Height * cell + 1;
        var viewportWidth = lastCanvasViewportWidth;
        var viewportHeight = lastCanvasViewportHeight;
        if viewportWidth <= 0 {
            viewportWidth =
                Convert.NumToInt(canvasScroll.GetLogicalWidth());
        }
        if viewportHeight <= 0 {
            viewportHeight =
                Convert.NumToInt(canvasScroll.GetLogicalHeight());
        }
        if viewportWidth > stageWidth { stageWidth = viewportWidth; }
        if viewportHeight > stageHeight { stageHeight = viewportHeight; }
        canvasStage.SetSize(stageWidth, stageHeight);
        SetLogicalContentSize(canvasScroll, stageWidth, stageHeight);
    }

    /// @brief Center one authored scene point without changing scene content.
    hide func CenterCanvasAtWorldPoint(worldX: Integer,
                                       worldY: Integer) -> Boolean {
        if scene == null or canvasScroll == null { return false; }
        PublishCanvasExtentForZoom();
        var viewportWidth = canvasScroll.GetLogicalWidth();
        var viewportHeight = canvasScroll.GetLogicalHeight();
        if viewportWidth <= 0.0 or viewportHeight <= 0.0 {
            return false;
        }
        var cell = DisplayCellForZoom();
        var focusX = worldX * cell / scene.TileWidth;
        var focusY = worldY * cell / scene.TileHeight;
        var scrollX = focusX - viewportWidth * 0.5;
        var scrollY = focusY - viewportHeight * 0.5;
        if scrollX < 0.0 { scrollX = 0.0; }
        if scrollY < 0.0 { scrollY = 0.0; }
        SetLogicalScroll(canvasScroll, scrollX, scrollY);
        renderDirty = true;
        return true;
    }

    /// @brief The authored tile edge in pixels that 100% zoom reproduces.
    hide func SceneTilePixelSize() -> Integer {
        if scene != null and scene.TileWidth > 0 { return scene.TileWidth; }
        return DEFAULT_TILE_SIZE;
    }

    /// @brief Rendered cell edge in pixels for the current zoom.
    /// @details 100% zoom shows artwork at native tile resolution; the cell
    ///          never collapses below one pixel.
    hide func DisplayCellForZoom() -> Integer {
        var cell = SceneTilePixelSize() * zoomPercent / 100;
        if cell < 1 { cell = 1; }
        return cell;
    }

    /// @brief Set zoom while keeping one content point fixed in the viewport.
    /// @details @p anchorContentX/Y are content pixels at the CURRENT zoom;
    ///          @p anchorViewX/Y are the same point's viewport offsets. The
    ///          scroll target keeps that world point under the same viewport
    ///          position after the cell size changes; the ScrollView clamps.
    hide func ZoomToPercentAnchored(nextPercent: Integer,
                                    anchorContentX: Number,
                                    anchorContentY: Number,
                                    anchorViewX: Number,
                                    anchorViewY: Number) {
        var clamped = ClampInt(
            nextPercent, MIN_ZOOM_PERCENT, MAX_ZOOM_PERCENT);
        if clamped == zoomPercent { return; }
        var previousCell = displayCellSize;
        if previousCell < 1 { previousCell = 1; }
        var anchorCellX = anchorContentX / previousCell;
        var anchorCellY = anchorContentY / previousCell;
        zoomPercent = clamped;
        initialFramePending = false;
        fitPending = false;
        renderDirty = true;
        var nextCell = DisplayCellForZoom();
        if scene != null and canvasStage != null {
            // Publish the new content extent before anchoring the scroll so
            // the ScrollView cannot clamp against the previous zoom's bounds.
            var contentWidth = scene.Width * nextCell + 1;
            var contentHeight = scene.Height * nextCell + 1;
            var stageWidth = contentWidth;
            var stageHeight = contentHeight;
            if lastCanvasViewportWidth > stageWidth {
                stageWidth = lastCanvasViewportWidth;
            }
            if lastCanvasViewportHeight > stageHeight {
                stageHeight = lastCanvasViewportHeight;
            }
            canvasStage.SetSize(stageWidth, stageHeight);
            SetLogicalContentSize(canvasScroll, stageWidth, stageHeight);
        }
        SetLogicalScroll(
            canvasScroll,
            anchorCellX * nextCell - anchorViewX,
            anchorCellY * nextCell - anchorViewY);
    }

    /// @brief One multiplicative zoom step (~1.25x) anchored at a point.
    hide func ZoomStepAnchored(direction: Integer,
                               anchorContentX: Number,
                               anchorContentY: Number,
                               anchorViewX: Number,
                               anchorViewY: Number) {
        var next = zoomPercent * 5 / 4;
        if direction < 0 { next = zoomPercent * 4 / 5; }
        if next == zoomPercent { next = zoomPercent + direction; }
        ZoomToPercentAnchored(
            next, anchorContentX, anchorContentY, anchorViewX, anchorViewY);
    }

    /// @brief Zoom one step keeping the rendered window's center fixed.
    hide func ZoomAtWindowCenter(direction: Integer) {
        var halfWidth = renderedColumns * displayCellSize / 2.0;
        var halfHeight = renderedRows * displayCellSize / 2.0;
        ZoomStepAnchored(
            direction,
            viewOriginX + halfWidth,
            viewOriginY + halfHeight,
            centerPadX + halfWidth,
            centerPadY + halfHeight);
    }

    /// @brief Public zoom control anchored at the rendered window's center.
    /// @details Wheel zoom anchors at the pointer through the same shared
    ///          helper; this surface serves toolbar, commands, and probes.
    expose func SetZoomPercent(nextPercent: Integer) {
        if gameViewOutputFramed { return; }
        ZoomToPercentAtWindowCenter(nextPercent);
    }

    /// @brief Jump to an exact zoom keeping the window's center fixed.
    hide func ZoomToPercentAtWindowCenter(nextPercent: Integer) {
        var halfWidth = renderedColumns * displayCellSize / 2.0;
        var halfHeight = renderedRows * displayCellSize / 2.0;
        ZoomToPercentAnchored(
            nextPercent,
            viewOriginX + halfWidth,
            viewOriginY + halfHeight,
            centerPadX + halfWidth,
            centerPadY + halfHeight);
    }

    /// @brief Reflect the grid-overlay toggle on its toolbar button.
    hide func RefreshGridButton() {
        if gridButton == null { return; }
        if showGrid and gameViewActive == false {
            gridButton.SetText("Grid: on");
        } else {
            gridButton.SetText("Grid");
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Return one guide's index or -1 when it is absent.
    hide func CanvasGuideIndex(guides: List[Integer],
                               coordinate: Integer) -> Integer {
        var index = 0;
        while index < guides.count() {
            if guides.get(index) == coordinate { return index; }
            index = index + 1;
        }
        return -1;
    }

    /// @brief Retain unique in-range guide coordinates under the axis cap.
    hide func BoundedCanvasGuides(values: List[Integer],
                                  maximum: Integer) -> List[Integer] {
        var bounded: List[Integer] = [];
        var index = 0;
        while index < values.count()
              and bounded.count() < MAX_CANVAS_GUIDES_PER_AXIS {
            var coordinate = values.get(index);
            if coordinate >= 0 and coordinate <= maximum
               and CanvasGuideIndex(bounded, coordinate) < 0 {
                bounded.add(coordinate);
            }
            index = index + 1;
        }
        return bounded;
    }

    /// @brief Drop stale or hostile guide state without touching scene bytes.
    hide func NormalizeCanvasGuides() {
        var maximumX = MAX_SELECTED_CELL;
        var maximumY = MAX_SELECTED_CELL;
        if scene != null {
            maximumX = scene.Width;
            maximumY = scene.Height;
        }
        verticalGuides =
            BoundedCanvasGuides(verticalGuides, maximumX);
        horizontalGuides =
            BoundedCanvasGuides(horizontalGuides, maximumY);
    }

    /// @brief Report whether one axis-aligned canvas guide exists.
    expose func HasCanvasGuide(axis: Integer,
                               coordinate: Integer) -> Boolean {
        if axis == CANVAS_GUIDE_VERTICAL {
            return CanvasGuideIndex(verticalGuides, coordinate) >= 0;
        }
        if axis == CANVAS_GUIDE_HORIZONTAL {
            return CanvasGuideIndex(horizontalGuides, coordinate) >= 0;
        }
        return false;
    }

    /// @brief Add or remove one bounded per-document guide.
    /// @return True when the guide collection changed.
    expose func ToggleCanvasGuide(axis: Integer,
                                  coordinate: Integer) -> Boolean {
        if scene == null { return false; }
        var maximum = scene.Width;
        if axis == CANVAS_GUIDE_HORIZONTAL {
            maximum = scene.Height;
        } else if axis != CANVAS_GUIDE_VERTICAL {
            return false;
        }
        if coordinate < 0 or coordinate > maximum { return false; }
        var existing = -1;
        if axis == CANVAS_GUIDE_VERTICAL {
            existing = CanvasGuideIndex(verticalGuides, coordinate);
            if existing >= 0 {
                verticalGuides.removeAt(existing);
            } else {
                if verticalGuides.count()
                   >= MAX_CANVAS_GUIDES_PER_AXIS {
                    return false;
                }
                verticalGuides.add(coordinate);
            }
        } else {
            existing = CanvasGuideIndex(horizontalGuides, coordinate);
            if existing >= 0 {
                horizontalGuides.removeAt(existing);
            } else {
                if horizontalGuides.count()
                   >= MAX_CANVAS_GUIDES_PER_AXIS {
                    return false;
                }
                horizontalGuides.add(coordinate);
            }
        }
        renderDirty = true;
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Move one existing guide without creating duplicates.
    /// @return True only when a valid guide changed coordinates.
    expose func MoveCanvasGuide(axis: Integer,
                                source: Integer,
                                target: Integer) -> Boolean {
        if scene == null or source == target { return false; }
        var guides = verticalGuides;
        var maximum = scene.Width;
        if axis == CANVAS_GUIDE_HORIZONTAL {
            guides = horizontalGuides;
            maximum = scene.Height;
        } else if axis != CANVAS_GUIDE_VERTICAL {
            return false;
        }
        if target < 0 or target > maximum { return false; }
        var sourceIndex = CanvasGuideIndex(guides, source);
        if sourceIndex < 0 or CanvasGuideIndex(guides, target) >= 0 {
            return false;
        }
        guides.set(sourceIndex, target);
        if axis == CANVAS_GUIDE_VERTICAL {
            verticalGuides = guides;
        } else {
            horizontalGuides = guides;
        }
        renderDirty = true;
        CaptureWorkspaceState();
        return true;
    }

    /// @brief Return one guide's coordinate in its ruler image.
    /// @details Vertical guides map to the horizontal ruler; horizontal guides
    ///          map to the vertical ruler.
    expose func CanvasRulerTickPosition(axis: Integer,
                                        coordinate: Integer) -> Integer {
        if axis == CANVAS_GUIDE_VERTICAL {
            return coordinate * displayCellSize
                - viewOriginX + centerPadX;
        }
        if axis == CANVAS_GUIDE_HORIZONTAL {
            return coordinate * displayCellSize
                - viewOriginY + centerPadY;
        }
        return -1;
    }

    /// @brief Return the closest guide marker within the ruler hit radius.
    hide func CanvasGuideHitIndex(axis: Integer,
                                  localPosition: Integer) -> Integer {
        var guides = verticalGuides;
        if axis == CANVAS_GUIDE_HORIZONTAL {
            guides = horizontalGuides;
        } else if axis != CANVAS_GUIDE_VERTICAL {
            return -1;
        }
        var closestIndex = -1;
        var closestDistance = CANVAS_GUIDE_HIT_RADIUS + 1;
        var index = 0;
        while index < guides.count() {
            var position =
                CanvasRulerTickPosition(axis, guides.get(index));
            var distance = AbsInt2D(position - localPosition);
            if distance <= CANVAS_GUIDE_HIT_RADIUS
               and distance < closestDistance {
                closestIndex = index;
                closestDistance = distance;
            }
            index = index + 1;
        }
        return closestIndex;
    }

    /// @brief Pointer coordinate along one captured guide's ruler axis.
    hide func CanvasGuidePointerLocalPosition(axis: Integer) -> Integer {
        if axis == CANVAS_GUIDE_VERTICAL {
            return Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.X())
                - horizontalRulerImage.GetScreenX());
        }
        if axis == CANVAS_GUIDE_HORIZONTAL {
            return Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.Y())
                - verticalRulerImage.GetScreenY());
        }
        return -1;
    }

    /// @brief Convert the captured pointer to one bounded guide coordinate.
    hide func CanvasGuidePointerCoordinate(axis: Integer) -> Integer {
        if scene == null { return -1; }
        var origin = viewOriginX;
        var pad = centerPadX;
        var maximum = scene.Width;
        var extent = Convert.NumToInt(
            horizontalRulerImage.GetScreenWidth());
        if axis == CANVAS_GUIDE_HORIZONTAL {
            origin = viewOriginY;
            pad = centerPadY;
            maximum = scene.Height;
            extent = Convert.NumToInt(
                verticalRulerImage.GetScreenHeight());
        } else if axis != CANVAS_GUIDE_VERTICAL {
            return -1;
        }
        var localPosition =
            CanvasGuidePointerLocalPosition(axis);
        // Captured motion may leave the widget. Treat leaving the visible
        // ruler lane as an explicit removal preview rather than teleporting
        // a guide to a valid but currently off-screen scene coordinate.
        if localPosition < 0 - CANVAS_GUIDE_HIT_RADIUS
           or localPosition > extent + CANVAS_GUIDE_HIT_RADIUS {
            return -1;
        }
        return CanvasRulerGuideCoordinate(
            localPosition,
            origin, pad, displayCellSize, maximum);
    }

    /// @brief Arm one click-or-drag ruler gesture with pointer capture.
    hide func BeginCanvasGuideDrag(axis: Integer,
                                   guideIndex: Integer,
                                   coordinate: Integer) {
        if Input.Mouse.IsCaptured() { return; }
        canvasGuideDragActive = true;
        canvasGuideDragAxis = axis;
        canvasGuideDragIndex = guideIndex;
        canvasGuideDragOrigin = -1;
        if guideIndex >= 0 {
            if axis == CANVAS_GUIDE_VERTICAL {
                canvasGuideDragOrigin = verticalGuides.get(guideIndex);
            } else {
                canvasGuideDragOrigin = horizontalGuides.get(guideIndex);
            }
        }
        canvasGuideDragCurrent = coordinate;
        if canvasGuideDragOrigin >= 0 {
            canvasGuideDragCurrent = canvasGuideDragOrigin;
        }
        canvasGuideDragMoved = false;
        canvasGuideDragStartX = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.X()));
        canvasGuideDragStartY = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.Y()));
        Input.Mouse.Capture();
        renderDirty = true;
        toolbarStatus.SetText("Drag guide; Escape cancels");
    }

    /// @brief Clear transient ruler manipulation and optionally release capture.
    hide func ResetCanvasGuideDrag(releaseCapture: Boolean) {
        var wasActive = canvasGuideDragActive;
        canvasGuideDragActive = false;
        canvasGuideDragAxis = -1;
        canvasGuideDragIndex = -1;
        canvasGuideDragOrigin = -1;
        canvasGuideDragCurrent = -1;
        canvasGuideDragMoved = false;
        canvasGuideDragStartX = 0;
        canvasGuideDragStartY = 0;
        if releaseCapture and wasActive and Input.Mouse.IsCaptured() {
            Input.Mouse.Release();
        }
        if wasActive { renderDirty = true; }
    }

    /// @brief Cancel one live ruler gesture without changing workspace guides.
    hide func CancelCanvasGuideDrag() {
        if canvasGuideDragActive == false { return; }
        ResetCanvasGuideDrag(true);
        gestureEscapeConsumed = true;
        toolbarStatus.SetText("Guide move canceled");
    }

    /// @brief Update the live guide preview from the captured pointer.
    hide func UpdateCanvasGuideDrag() {
        if canvasGuideDragActive == false { return; }
        var pointerX = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.X()));
        var pointerY = Convert.NumToInt(
            PhysicalPointerToUi(Input.Mouse.Y()));
        if AbsInt2D(pointerX - canvasGuideDragStartX)
              >= CANVAS_GUIDE_DRAG_THRESHOLD
           or AbsInt2D(pointerY - canvasGuideDragStartY)
              >= CANVAS_GUIDE_DRAG_THRESHOLD {
            canvasGuideDragMoved = true;
        }
        if canvasGuideDragMoved {
            var nextCoordinate =
                CanvasGuidePointerCoordinate(canvasGuideDragAxis);
            if nextCoordinate != canvasGuideDragCurrent {
                canvasGuideDragCurrent = nextCoordinate;
                renderDirty = true;
            }
            if nextCoordinate < 0 {
                toolbarStatus.SetText("Release to remove guide");
            } else {
                toolbarStatus.SetText(
                    "Move guide to " + nextCoordinate
                    + "; Escape cancels");
            }
        }
    }

    /// @brief Complete one ruler click, create-drag, move, or drag-out removal.
    hide func FinishCanvasGuideDrag() {
        if canvasGuideDragActive == false { return; }
        var axis = canvasGuideDragAxis;
        var origin = canvasGuideDragOrigin;
        var target = canvasGuideDragCurrent;
        var moved = canvasGuideDragMoved;
        ResetCanvasGuideDrag(true);

        var orientation = "vertical";
        if axis == CANVAS_GUIDE_HORIZONTAL {
            orientation = "horizontal";
        }
        if moved == false {
            var removing = origin >= 0;
            var coordinate = target;
            if removing { coordinate = origin; }
            if ToggleCanvasGuide(axis, coordinate) {
                var action = "Added";
                if removing { action = "Removed"; }
                toolbarStatus.SetText(
                    action + " " + orientation + " guide "
                    + coordinate);
            }
            return;
        }
        if target < 0 {
            if origin >= 0 and ToggleCanvasGuide(axis, origin) {
                toolbarStatus.SetText(
                    "Removed " + orientation + " guide " + origin);
            } else {
                toolbarStatus.SetText("Guide drag canceled");
            }
            return;
        }
        if origin < 0 {
            if HasCanvasGuide(axis, target) {
                toolbarStatus.SetText(
                    "A guide already exists at " + target);
            } else if ToggleCanvasGuide(axis, target) {
                toolbarStatus.SetText(
                    "Added " + orientation + " guide " + target);
            }
            return;
        }
        if origin == target {
            toolbarStatus.SetText(
                "Kept " + orientation + " guide " + origin);
        } else if MoveCanvasGuide(axis, origin, target) {
            toolbarStatus.SetText(
                "Moved " + orientation + " guide "
                + origin + " to " + target);
        } else {
            toolbarStatus.SetText(
                "A guide already exists at " + target);
        }
    }

    /// @brief Reflect visibility in both the toolbar and retained layout.
    hide func RefreshRulerPresentation() {
        var rulersVisible = showRulers and gameViewActive == false;
        if rulersButton != null {
            if showRulers {
                rulersButton.SetText("Rulers: on");
                rulersButton.SetStyle(1);
            } else {
                rulersButton.SetText("Rulers");
                rulersButton.SetStyle(0);
            }
        }
        if rulerTopRow != null { rulerTopRow.SetVisible(rulersVisible); }
        if verticalRulerImage != null {
            verticalRulerImage.SetVisible(rulersVisible);
        }
        UpdateCommandMenuButtons();
    }

    /// @brief Pump click, create-drag, move, cancel, and removal gestures.
    hide func PumpCanvasRulers() {
        if gameViewActive { return; }
        if canvasGuideDragActive {
            if showRulers == false or scene == null
               or horizontalRulerImage == null
               or verticalRulerImage == null
               or displayCellSize < 1 {
                ResetCanvasGuideDrag(true);
                return;
            }
            if Input.Keyboard.WasPressed(Input.Key.Escape) {
                CancelCanvasGuideDrag();
                return;
            }
            UpdateCanvasGuideDrag();
            if Input.Mouse.IsDown(Input.Mouse.ButtonLeft) == false {
                FinishCanvasGuideDrag();
            }
            return;
        }
        if showRulers == false or scene == null
           or horizontalRulerImage == null
           or verticalRulerImage == null
           or displayCellSize < 1
           or Input.Mouse.WasPressed(Input.Mouse.ButtonLeft) == false
           or Input.Mouse.IsCaptured() {
            return;
        }
        var axis = -1;
        var localPosition = -1;
        var origin = 0;
        var pad = 0;
        var maximum = 0;
        if horizontalRulerImage.IsHovered() {
            axis = CANVAS_GUIDE_VERTICAL;
            localPosition = Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.X())
                - horizontalRulerImage.GetScreenX());
            origin = viewOriginX;
            pad = centerPadX;
            maximum = scene.Width;
        } else if verticalRulerImage.IsHovered() {
            axis = CANVAS_GUIDE_HORIZONTAL;
            localPosition = Convert.NumToInt(
                PhysicalPointerToUi(Input.Mouse.Y())
                - verticalRulerImage.GetScreenY());
            origin = viewOriginY;
            pad = centerPadY;
            maximum = scene.Height;
        }
        if axis < 0 { return; }
        var coordinate = CanvasRulerGuideCoordinate(
            localPosition, origin, pad, displayCellSize, maximum);
        if coordinate < 0 { return; }
        var guideIndex =
            CanvasGuideHitIndex(axis, localPosition);
        if guideIndex < 0 {
            var guideCount = verticalGuides.count();
            if axis == CANVAS_GUIDE_HORIZONTAL {
                guideCount = horizontalGuides.count();
            }
            if guideCount >= MAX_CANVAS_GUIDES_PER_AXIS {
                toolbarStatus.SetText("Guide limit reached");
                return;
            }
        }
        BeginCanvasGuideDrag(axis, guideIndex, coordinate);
    }

    /// @brief Draw scroll/zoom-aware cell rulers into their retained images.
    hide func RenderCanvasRulers() {
        if gameViewActive or showRulers == false
           or rulerCornerImage == null
           or horizontalRulerImage == null
           or verticalRulerImage == null {
            return;
        }
        var width = lastCanvasViewportWidth;
        var height = lastCanvasViewportHeight;
        if width < 1 { width = 1; }
        if height < 1 { height = 1; }
        var background = Color.RGB(31, 37, 47);
        var border = Color.RGB(75, 87, 104);
        var minor = Color.RGB(91, 104, 123);
        var major = Color.RGB(181, 192, 208);

        rulerCornerPixels = Pixels.New(
            CANVAS_RULER_LEFT_WIDTH, CANVAS_RULER_TOP_HEIGHT);
        rulerCornerPixels.FillColor(background);
        rulerCornerPixels.DrawLine(
            0, CANVAS_RULER_TOP_HEIGHT - 1,
            CANVAS_RULER_LEFT_WIDTH - 1,
            CANVAS_RULER_TOP_HEIGHT - 1, border);
        rulerCornerPixels.DrawLine(
            CANVAS_RULER_LEFT_WIDTH - 1, 0,
            CANVAS_RULER_LEFT_WIDTH - 1,
            CANVAS_RULER_TOP_HEIGHT - 1, border);
        rulerCornerPixels.DrawText(
            5, 8, "CELL", Color.RGB(143, 158, 178));
        rulerCornerImage.SetPixels(
            rulerCornerPixels,
            CANVAS_RULER_LEFT_WIDTH,
            CANVAS_RULER_TOP_HEIGHT);
        rulerCornerImage.SetSize(
            CANVAS_RULER_LEFT_WIDTH,
            CANVAS_RULER_TOP_HEIGHT);

        horizontalRulerPixels =
            Pixels.New(width, CANVAS_RULER_TOP_HEIGHT);
        horizontalRulerPixels.FillColor(background);
        horizontalRulerPixels.DrawLine(
            0, CANVAS_RULER_TOP_HEIGHT - 1,
            width - 1, CANVAS_RULER_TOP_HEIGHT - 1, border);
        verticalRulerPixels =
            Pixels.New(CANVAS_RULER_LEFT_WIDTH, height);
        verticalRulerPixels.FillColor(background);
        verticalRulerPixels.DrawLine(
            CANVAS_RULER_LEFT_WIDTH - 1, 0,
            CANVAS_RULER_LEFT_WIDTH - 1, height - 1, border);

        if scene != null and displayCellSize > 0 {
            NormalizeCanvasGuides();
            var stride = CanvasRulerMajorStride(displayCellSize);
            var firstColumn = viewOriginX / displayCellSize - 1;
            if firstColumn < 0 { firstColumn = 0; }
            var lastColumn =
                (viewOriginX + width) / displayCellSize + 1;
            if lastColumn > scene.Width { lastColumn = scene.Width; }
            var column = firstColumn;
            while column <= lastColumn {
                var x = CanvasRulerTickPosition(
                    CANVAS_GUIDE_VERTICAL, column);
                if x >= 0 and x < width {
                    var tickTop = CANVAS_RULER_TOP_HEIGHT - 5;
                    var tickColor = minor;
                    if column % stride == 0 {
                        tickTop = CANVAS_RULER_TOP_HEIGHT - 10;
                        tickColor = major;
                        var label = "" + column;
                        var labelWidth = Str.get_Length(label) * 8;
                        if x + 2 + labelWidth < width {
                            horizontalRulerPixels.DrawText(
                                x + 2, 3, label, major);
                        }
                    }
                    horizontalRulerPixels.DrawLine(
                        x, tickTop, x,
                        CANVAS_RULER_TOP_HEIGHT - 1, tickColor);
                }
                column = column + 1;
            }

            var firstRow = viewOriginY / displayCellSize - 1;
            if firstRow < 0 { firstRow = 0; }
            var lastRow =
                (viewOriginY + height) / displayCellSize + 1;
            if lastRow > scene.Height { lastRow = scene.Height; }
            var row = firstRow;
            while row <= lastRow {
                var y = CanvasRulerTickPosition(
                    CANVAS_GUIDE_HORIZONTAL, row);
                if y >= 0 and y < height {
                    var tickLeft = CANVAS_RULER_LEFT_WIDTH - 5;
                    var tickColorY = minor;
                    if row % stride == 0 {
                        tickLeft = CANVAS_RULER_LEFT_WIDTH - 10;
                        tickColorY = major;
                        var rowLabel = "" + row;
                        if y + 10 < height {
                            verticalRulerPixels.DrawText(
                                3, y + 2, rowLabel, major);
                        }
                    }
                    verticalRulerPixels.DrawLine(
                        tickLeft, y,
                        CANVAS_RULER_LEFT_WIDTH - 1, y, tickColorY);
                }
                row = row + 1;
            }

            var guideIndex = 0;
            while guideIndex < verticalGuides.count() {
                var guideCoordinate =
                    verticalGuides.get(guideIndex);
                if canvasGuideDragActive
                   and canvasGuideDragAxis == CANVAS_GUIDE_VERTICAL
                   and canvasGuideDragIndex == guideIndex {
                    guideCoordinate = canvasGuideDragCurrent;
                }
                var guideX = -1;
                if guideCoordinate >= 0 {
                    guideX = CanvasRulerTickPosition(
                        CANVAS_GUIDE_VERTICAL,
                        guideCoordinate);
                }
                if guideX >= 0 and guideX < width {
                    horizontalRulerPixels.DrawLine(
                        guideX, CANVAS_RULER_TOP_HEIGHT - 12,
                        guideX, CANVAS_RULER_TOP_HEIGHT - 1,
                        CANVAS_GUIDE_COLOR);
                }
                guideIndex = guideIndex + 1;
            }
            guideIndex = 0;
            while guideIndex < horizontalGuides.count() {
                var guideCoordinateY =
                    horizontalGuides.get(guideIndex);
                if canvasGuideDragActive
                   and canvasGuideDragAxis == CANVAS_GUIDE_HORIZONTAL
                   and canvasGuideDragIndex == guideIndex {
                    guideCoordinateY = canvasGuideDragCurrent;
                }
                var guideY = -1;
                if guideCoordinateY >= 0 {
                    guideY = CanvasRulerTickPosition(
                        CANVAS_GUIDE_HORIZONTAL,
                        guideCoordinateY);
                }
                if guideY >= 0 and guideY < height {
                    verticalRulerPixels.DrawLine(
                        CANVAS_RULER_LEFT_WIDTH - 12, guideY,
                        CANVAS_RULER_LEFT_WIDTH - 1, guideY,
                        CANVAS_GUIDE_COLOR);
                }
                guideIndex = guideIndex + 1;
            }
            if canvasGuideDragActive
               and canvasGuideDragIndex < 0
               and canvasGuideDragCurrent >= 0 {
                if canvasGuideDragAxis == CANVAS_GUIDE_VERTICAL {
                    var pendingGuideX = CanvasRulerTickPosition(
                        CANVAS_GUIDE_VERTICAL,
                        canvasGuideDragCurrent);
                    if pendingGuideX >= 0 and pendingGuideX < width {
                        horizontalRulerPixels.DrawLine(
                            pendingGuideX,
                            CANVAS_RULER_TOP_HEIGHT - 12,
                            pendingGuideX,
                            CANVAS_RULER_TOP_HEIGHT - 1,
                            CANVAS_GUIDE_COLOR);
                    }
                } else if canvasGuideDragAxis
                              == CANVAS_GUIDE_HORIZONTAL {
                    var pendingGuideY = CanvasRulerTickPosition(
                        CANVAS_GUIDE_HORIZONTAL,
                        canvasGuideDragCurrent);
                    if pendingGuideY >= 0 and pendingGuideY < height {
                        verticalRulerPixels.DrawLine(
                            CANVAS_RULER_LEFT_WIDTH - 12,
                            pendingGuideY,
                            CANVAS_RULER_LEFT_WIDTH - 1,
                            pendingGuideY,
                            CANVAS_GUIDE_COLOR);
                    }
                }
            }

            if selectedCellX >= 0 {
                var cursorX = CanvasRulerTickPosition(
                    CANVAS_GUIDE_VERTICAL, selectedCellX)
                    + displayCellSize / 2;
                if cursorX >= 0 and cursorX < width {
                    horizontalRulerPixels.DrawLine(
                        cursorX, 0, cursorX, 5,
                        Color.RGB(255, 195, 78));
                }
            }
            if selectedCellY >= 0 {
                var cursorY = CanvasRulerTickPosition(
                    CANVAS_GUIDE_HORIZONTAL, selectedCellY)
                    + displayCellSize / 2;
                if cursorY >= 0 and cursorY < height {
                    verticalRulerPixels.DrawLine(
                        0, cursorY, 5, cursorY,
                        Color.RGB(255, 195, 78));
                }
            }
        }

        horizontalRulerImage.SetPixels(
            horizontalRulerPixels, width, CANVAS_RULER_TOP_HEIGHT);
        horizontalRulerImage.SetSize(
            width, CANVAS_RULER_TOP_HEIGHT);
        verticalRulerImage.SetPixels(
            verticalRulerPixels, CANVAS_RULER_LEFT_WIDTH, height);
        verticalRulerImage.SetSize(
            CANVAS_RULER_LEFT_WIDTH, height);
        horizontalRulerImage.SetAccessibleDescription(
            verticalGuides.count()
            + " vertical guides; click a boundary to toggle, "
            + "or drag a guide to move it.");
        verticalRulerImage.SetAccessibleDescription(
            horizontalGuides.count()
            + " horizontal guides; click a boundary to toggle, "
            + "or drag a guide to move it.");
    }

    /// @brief Draw workspace-only guide lines over the visible scene window.
    hide func DrawCanvasGuides() {
        if framePixels == null or scene == null { return; }
        var index = 0;
        while index < verticalGuides.count() {
            var guideCoordinate = verticalGuides.get(index);
            if canvasGuideDragActive
               and canvasGuideDragAxis == CANVAS_GUIDE_VERTICAL
               and canvasGuideDragIndex == index {
                guideCoordinate = canvasGuideDragCurrent;
            }
            var x = guideCoordinate * displayCellSize
                - viewOriginX;
            if x >= 0 and x < framePixels.Width {
                framePixels.DrawLine(
                    x, 0, x, framePixels.Height - 1,
                    CANVAS_GUIDE_COLOR);
            }
            index = index + 1;
        }
        index = 0;
        while index < horizontalGuides.count() {
            var guideCoordinateY = horizontalGuides.get(index);
            if canvasGuideDragActive
               and canvasGuideDragAxis == CANVAS_GUIDE_HORIZONTAL
               and canvasGuideDragIndex == index {
                guideCoordinateY = canvasGuideDragCurrent;
            }
            var y = guideCoordinateY * displayCellSize
                - viewOriginY;
            if y >= 0 and y < framePixels.Height {
                framePixels.DrawLine(
                    0, y, framePixels.Width - 1, y,
                    CANVAS_GUIDE_COLOR);
            }
            index = index + 1;
        }
        if canvasGuideDragActive
           and canvasGuideDragIndex < 0
           and canvasGuideDragCurrent >= 0 {
            if canvasGuideDragAxis == CANVAS_GUIDE_VERTICAL {
                var pendingX = canvasGuideDragCurrent
                    * displayCellSize - viewOriginX;
                if pendingX >= 0 and pendingX < framePixels.Width {
                    framePixels.DrawLine(
                        pendingX, 0,
                        pendingX, framePixels.Height - 1,
                        CANVAS_GUIDE_COLOR);
                }
            } else if canvasGuideDragAxis
                          == CANVAS_GUIDE_HORIZONTAL {
                var pendingY = canvasGuideDragCurrent
                    * displayCellSize - viewOriginY;
                if pendingY >= 0 and pendingY < framePixels.Height {
                    framePixels.DrawLine(
                        0, pendingY,
                        framePixels.Width - 1, pendingY,
                        CANVAS_GUIDE_COLOR);
                }
            }
        }
    }

    /// @brief Composite one already-resolved active-layer brush ghost.
    /// @return True when a real atlas frame was composited.
    hide func DrawResolvedTileGhostCell(tile: Integer,
                                        cellX: Integer,
                                        cellY: Integer,
                                        opacity: Number) -> Boolean {
        if framePixels == null or scene == null or tilesets == null
           or activeLayer < 0 or activeLayer >= scene.LayerCount()
           or displayCellSize <= 0 or tile <= 0
           or cellX < 0 or cellY < 0
           or cellX >= scene.Width or cellY >= scene.Height {
            return false;
        }
        var x = cellX * displayCellSize - viewOriginX;
        var y = cellY * displayCellSize - viewOriginY;
        if x + displayCellSize <= 0 or y + displayCellSize <= 0
           or x >= framePixels.Width or y >= framePixels.Height {
            return false;
        }
        if tilesets.DrawTileWithOpacity(
               framePixels, activeLayer, tile, x, y,
               displayCellSize, opacity) {
            return true;
        }
        framePixels.DrawFrame(
            x + 1, y + 1,
            displayCellSize - 1, displayCellSize - 1,
            TilePreviewColor(tile, activeLayer));
        return false;
    }

    /// @brief Composite one image-true prospective brush cell.
    /// @details Autotile substitution runs before optional animation, matching
    ///          the canonical canvas renderer. Missing atlas frames retain a
    ///          bounded outline fallback instead of hiding the tool position.
    hide func DrawTileGhostCell(tile: Integer,
                                cellX: Integer,
                                cellY: Integer) -> Boolean {
        if scene == null or activeLayer < 0
           or activeLayer >= scene.LayerCount()
           or tile <= 0 or cellX < 0 or cellY < 0
           or cellX >= scene.Width or cellY >= scene.Height {
            return false;
        }
        var resolved = PreviewResolvedTile(
            AutotileResolvedTileWithOverride(
                activeLayer, cellX, cellY, tile,
                cellX, cellY, tile));
        return DrawResolvedTileGhostCell(
            resolved, cellX, cellY, TILE_GHOST_OPACITY);
    }

    /// @brief Preview one neighbor changed by a prospective paint cell.
    hide func DrawAutotileNeighborGhost(pendingTile: Integer,
                                        pendingX: Integer,
                                        pendingY: Integer,
                                        neighborX: Integer,
                                        neighborY: Integer) {
        if neighborX < 0 or neighborY < 0
           or neighborX >= scene.Width or neighborY >= scene.Height {
            return;
        }
        var raw = scene.GetTile(activeLayer, neighborX, neighborY);
        var current = AutotileResolvedSceneTile(
            activeLayer, neighborX, neighborY);
        var prospective = AutotileResolvedTileWithOverride(
            activeLayer, neighborX, neighborY, raw,
            pendingX, pendingY, pendingTile);
        if prospective == current { return; }
        DrawResolvedTileGhostCell(
            PreviewResolvedTile(prospective),
            neighborX, neighborY,
            AUTOTILE_NEIGHBOR_GHOST_OPACITY);
    }

    /// @brief Preview every adjacent variant the next paint click would change.
    hide func DrawAutotileNeighborGhosts(tile: Integer,
                                         cellX: Integer,
                                         cellY: Integer) {
        if scene == null or activeLayer != 0
           or autotilePreviewEnabled == false
           or autotilePreviewRuleCount <= 0 {
            return;
        }
        DrawAutotileNeighborGhost(tile, cellX, cellY, cellX, cellY - 1);
        DrawAutotileNeighborGhost(tile, cellX, cellY, cellX + 1, cellY);
        DrawAutotileNeighborGhost(tile, cellX, cellY, cellX, cellY + 1);
        DrawAutotileNeighborGhost(tile, cellX, cellY, cellX - 1, cellY);
    }

    /// @brief Paint non-destructive atlas-true previews for tile tools.
    /// @details A hover previews one tile for Paint, Fill, Rectangle, Line, and
    ///          Ellipse. Active stamps preview every non-empty source cell, and
    ///          captured shapes preview exactly the cells their commit path
    ///          will write. Rectangle iteration is clipped to the visible
    ///          raster window so huge scenes cannot turn a hover into
    ///          unbounded work.
    hide func DrawTileBrushGhosts() {
        if framePixels == null or scene == null
           or selectedCellX < 0 or selectedCellY < 0
           or LayerLocked(activeLayer) {
            return;
        }
        var selectedTile = ClampInt(
            Convert.NumToInt(tileSpinner.Value), 0, 1000000);
        if mode == MODE_PAINT {
            if stampActive and stampWidth > 0 and stampHeight > 0 {
                var anchorX =
                    selectedCellX / stampWidth * stampWidth;
                var anchorY =
                    selectedCellY / stampHeight * stampHeight;
                var row = 0;
                while row < stampHeight {
                    var column = 0;
                    while column < stampWidth {
                        DrawTileGhostCell(
                            stampTiles.get(row * stampWidth + column),
                            anchorX + column, anchorY + row);
                        column = column + 1;
                    }
                    row = row + 1;
                }
            } else {
                DrawAutotileNeighborGhosts(
                    selectedTile, selectedCellX, selectedCellY);
                DrawTileGhostCell(
                    selectedTile, selectedCellX, selectedCellY);
            }
            return;
        }
        if mode == MODE_ERASE {
            DrawAutotileNeighborGhosts(
                0, selectedCellX, selectedCellY);
            return;
        }
        if mode == MODE_FILL {
            DrawTileGhostCell(
                selectedTile, selectedCellX, selectedCellY);
            return;
        }
        if mode != MODE_RECTANGLE and mode != MODE_LINE
           and mode != MODE_ELLIPSE {
            return;
        }
        if tileRectangleActive == false {
            DrawTileGhostCell(
                selectedTile, selectedCellX, selectedCellY);
            return;
        }
        if tileRectangleShape != 0 {
            var cells = ShapeCells(
                tileRectangleShape,
                tileRectangleStartX, tileRectangleStartY,
                tileRectangleCurrentX, tileRectangleCurrentY);
            var index = 0;
            while index + 1 < cells.count() {
                DrawTileGhostCell(
                    tileRectangleTile,
                    cells.get(index), cells.get(index + 1));
                index = index + 2;
            }
            return;
        }

        var minimumX = tileRectangleStartX;
        var maximumX = tileRectangleCurrentX;
        if maximumX < minimumX {
            minimumX = tileRectangleCurrentX;
            maximumX = tileRectangleStartX;
        }
        var minimumY = tileRectangleStartY;
        var maximumY = tileRectangleCurrentY;
        if maximumY < minimumY {
            minimumY = tileRectangleCurrentY;
            maximumY = tileRectangleStartY;
        }
        var firstVisibleX = viewOriginX / displayCellSize;
        var firstVisibleY = viewOriginY / displayCellSize;
        var lastVisibleX =
            (viewOriginX + framePixels.Width - 1) / displayCellSize;
        var lastVisibleY =
            (viewOriginY + framePixels.Height - 1) / displayCellSize;
        if maximumX < firstVisibleX or minimumX > lastVisibleX
           or maximumY < firstVisibleY or minimumY > lastVisibleY {
            return;
        }
        minimumX = ClampInt(minimumX, firstVisibleX, lastVisibleX);
        maximumX = ClampInt(maximumX, firstVisibleX, lastVisibleX);
        minimumY = ClampInt(minimumY, firstVisibleY, lastVisibleY);
        maximumY = ClampInt(maximumY, firstVisibleY, lastVisibleY);
        if minimumX > maximumX or minimumY > maximumY { return; }
        var y = minimumY;
        while y <= maximumY {
            var x = minimumX;
            while x <= maximumX {
                DrawTileGhostCell(tileRectangleTile, x, y);
                x = x + 1;
            }
            y = y + 1;
        }
    }

    /// @brief Re-render when the viewport or scroll offset changes.
    /// @details The image holds only the visible window, so unlike the old
    ///          full-scene buffer, every scroll movement (scrollbar, wheel
    ///          pan, restored session offset) must re-rasterize the window.
    hide func UpdateCanvasViewportSize() {
        if canvasScroll == null { return; }
        var width = Convert.NumToInt(canvasScroll.GetLogicalWidth());
        var height = Convert.NumToInt(canvasScroll.GetLogicalHeight());
        if width != lastCanvasViewportWidth
           or height != lastCanvasViewportHeight {
            lastCanvasViewportWidth = width;
            lastCanvasViewportHeight = height;
            if gameViewOutputFramed {
                gameOutputFramePending = true;
            }
            renderDirty = true;
        }
        if scene != null {
            var scrollX = Convert.NumToInt(LogicalScrollX(canvasScroll));
            var scrollY = Convert.NumToInt(LogicalScrollY(canvasScroll));
            if scrollX != viewOriginX or scrollY != viewOriginY {
                renderDirty = true;
            }
        }
    }

    /// @brief Return the app's logical-to-framebuffer scale for legacy pixel APIs.
    hide func EffectiveUiScale() -> Number {
        if guiApp == null { return 1.0; }
        var scale = guiApp.GetEffectiveScale();
        if scale <= 0.0 { return 1.0; }
        return scale;
    }

    /// @brief Convert a GUI-app pointer coordinate into effective UI units.
    /// @details GUI widget screen bounds are logical while Zanna.Input.Mouse
    ///          receives framebuffer coordinates from GUI application polling.
    hide func PhysicalPointerToUi(value: Number) -> Number {
        return value / EffectiveUiScale();
    }

    /// @brief Read a legacy framebuffer scroll offset as logical UI units.
    hide func LogicalScrollX(scroll: GUI.ScrollView) -> Number {
        if scroll == null { return 0.0; }
        return scroll.GetScrollX() / EffectiveUiScale();
    }

    /// @brief Read a legacy framebuffer scroll offset as logical UI units.
    hide func LogicalScrollY(scroll: GUI.ScrollView) -> Number {
        if scroll == null { return 0.0; }
        return scroll.GetScrollY() / EffectiveUiScale();
    }

    /// @brief Apply logical offsets through ScrollView's framebuffer-pixel API.
    hide func SetLogicalScroll(scroll: GUI.ScrollView,
                               x: Number,
                               y: Number) {
        if scroll == null { return; }
        var scale = EffectiveUiScale();
        scroll.SetScroll(x * scale, y * scale);
    }

    /// @brief Apply logical content dimensions through the legacy pixel API.
    hide func SetLogicalContentSize(scroll: GUI.ScrollView,
                                    width: Number,
                                    height: Number) {
        if scroll == null { return; }
        var scale = EffectiveUiScale();
        scroll.SetContentSize(width * scale, height * scale);
    }

    /// @brief Render a bounded, dependency-free scene preview into GUI.Image.
    hide func RenderScene() {
        renderDirty = false;
        if canvasImage == null { return; }
        if scene == null {
            framePixels = Pixels.New(640, 360);
            framePixels.FillColor(Color.RGB(24, 28, 36));
            framePixels.DrawTextCentered(
                150, "Unable to display this 2D scene", Color.RGB(230, 115, 115));
            framePixels.DrawTextCentered(
                172, "Use New 32x18 or repair the JSON as text",
                Color.RGB(180, 188, 202));
            canvasImage.SetPixels(framePixels, 640, 360);
            canvasImage.SetSize(640, 360);
            var emptyStageWidth = 640;
            var emptyStageHeight = 360;
            if lastCanvasViewportWidth > emptyStageWidth {
                emptyStageWidth = lastCanvasViewportWidth;
            }
            if lastCanvasViewportHeight > emptyStageHeight {
                emptyStageHeight = lastCanvasViewportHeight;
            }
            centerPadX = (emptyStageWidth - 640) / 2;
            centerPadY = (emptyStageHeight - 360) / 2;
            if centerPadX < 0 { centerPadX = 0; }
            if centerPadY < 0 { centerPadY = 0; }
            canvasImage.SetMarginEdges(centerPadX, centerPadY, 0.0, 0.0);
            canvasStage.SetSize(emptyStageWidth, emptyStageHeight);
            SetLogicalContentSize(
                canvasScroll, emptyStageWidth, emptyStageHeight);
            renderedColumns = 0;
            renderedRows = 0;
            viewOriginX = 0;
            viewOriginY = 0;
            viewStatusLabel.SetText("");
            RenderCanvasRulers();
            return;
        }

        // Windowed rendering: the stage advertises the complete scene extent
        // to the scrollbars while only the visible window rasterizes, so every
        // cell of every scene stays reachable at every zoom.
        displayCellSize = DisplayCellForZoom();
        var sceneColumns = scene.Width;
        var sceneRows = scene.Height;
        if sceneColumns < 1 { sceneColumns = 1; }
        if sceneRows < 1 { sceneRows = 1; }
        var contentWidth = sceneColumns * displayCellSize + 1;
        var contentHeight = sceneRows * displayCellSize + 1;

        var viewportWidth = lastCanvasViewportWidth;
        var viewportHeight = lastCanvasViewportHeight;
        if viewportWidth <= 0 { viewportWidth = 640; }
        if viewportHeight <= 0 { viewportHeight = 360; }

        var stageWidth = contentWidth;
        var stageHeight = contentHeight;
        if viewportWidth > stageWidth { stageWidth = viewportWidth; }
        if viewportHeight > stageHeight { stageHeight = viewportHeight; }
        canvasStage.SetSize(stageWidth, stageHeight);
        SetLogicalContentSize(canvasScroll, stageWidth, stageHeight);

        var windowWidth = contentWidth;
        if windowWidth > viewportWidth { windowWidth = viewportWidth; }
        if windowWidth > MAX_RENDER_DIMENSION {
            windowWidth = MAX_RENDER_DIMENSION;
        }
        var windowHeight = contentHeight;
        if windowHeight > viewportHeight { windowHeight = viewportHeight; }
        if windowHeight > MAX_RENDER_DIMENSION {
            windowHeight = MAX_RENDER_DIMENSION;
        }
        if windowWidth < 1 { windowWidth = 1; }
        if windowHeight < 1 { windowHeight = 1; }

        centerPadX = (viewportWidth - contentWidth) / 2;
        centerPadY = (viewportHeight - contentHeight) / 2;
        if centerPadX < 0 { centerPadX = 0; }
        if centerPadY < 0 { centerPadY = 0; }

        viewOriginX = Convert.NumToInt(LogicalScrollX(canvasScroll));
        viewOriginY = Convert.NumToInt(LogicalScrollY(canvasScroll));
        var maxOriginX = contentWidth - windowWidth;
        var maxOriginY = contentHeight - windowHeight;
        if maxOriginX < 0 { maxOriginX = 0; }
        if maxOriginY < 0 { maxOriginY = 0; }
        viewOriginX = ClampInt(viewOriginX, 0, maxOriginX);
        viewOriginY = ClampInt(viewOriginY, 0, maxOriginY);

        var firstColumn = viewOriginX / displayCellSize;
        var firstRow = viewOriginY / displayCellSize;
        var lastColumn = (viewOriginX + windowWidth - 1) / displayCellSize;
        var lastRow = (viewOriginY + windowHeight - 1) / displayCellSize;
        if lastColumn > sceneColumns - 1 { lastColumn = sceneColumns - 1; }
        if lastRow > sceneRows - 1 { lastRow = sceneRows - 1; }
        renderedColumns = lastColumn - firstColumn + 1;
        renderedRows = lastRow - firstRow + 1;

        framePixels = Pixels.New(windowWidth, windowHeight);
        framePixels.FillColor(Color.RGB(24, 28, 36));
        DrawProjectSceneBackground();

        var objectStack = ObjectPreviewStack();
        var objectSpriteDrawn: List[Integer] = [];
        var objectFlagIndex = 0;
        while objectFlagIndex < scene.ObjectCount() {
            objectSpriteDrawn.add(0);
            objectFlagIndex = objectFlagIndex + 1;
        }
        var objectVisualCursor = DrawObjectSpritesAtBoundary(
            objectStack, objectSpriteDrawn, 0, 0,
            windowWidth, windowHeight);

        var layer = 0;
        while layer < scene.LayerCount() {
            var layerShown = scene.LayerVisible(layer)
                and (gameViewActive
                     or soloLayer < 0 or soloLayer == layer);
            var layerOpacity = scene.LayerOpacity(layer);
            if layerShown and layerOpacity > 0.001 {
                var y = firstRow;
                while y <= lastRow {
                    var x = firstColumn;
                    while x <= lastColumn {
                        var tile =
                            ResolvedSceneTileForPreview(layer, x, y);
                        if tile > 0 {
                            var drawX = x * displayCellSize - viewOriginX;
                            var drawY = y * displayCellSize - viewOriginY;
                            var drewAsset = tilesets.DrawTileWithOpacity(
                                framePixels,
                                layer,
                                tile,
                                drawX,
                                drawY,
                                displayCellSize,
                                layerOpacity);
                            if drewAsset == false {
                                framePixels.DrawBox(
                                    drawX + 1,
                                    drawY + 1,
                                    displayCellSize - 1,
                                    displayCellSize - 1,
                                    TilePreviewColor(tile, layer));
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }
            objectVisualCursor = DrawObjectSpritesAtBoundary(
                objectStack, objectSpriteDrawn,
                objectVisualCursor, layer + 1,
                windowWidth, windowHeight);
            layer = layer + 1;
        }

        if showGrid {
            var gridColor = Color.RGB(54, 61, 73);
            var x = firstColumn;
            while x <= lastColumn + 1 {
                var lineX = x * displayCellSize - viewOriginX;
                framePixels.DrawLine(lineX, 0,
                                     lineX, windowHeight - 1,
                                     gridColor);
                x = x + 1;
            }
            var y = firstRow;
            while y <= lastRow + 1 {
                var lineY = y * displayCellSize - viewOriginY;
                framePixels.DrawLine(0, lineY,
                                     windowWidth - 1, lineY,
                                     gridColor);
                y = y + 1;
            }
        }

        if gameViewActive == false {
            DrawCameraBoundsOverlay();
            DrawPreviewDeadzoneOverlay();
            DrawRoutePolylines();
        }
        var overlayMargin = displayCellSize * 2 + 32;
        var objectStackIndex = 0;
        if gameViewActive { objectStackIndex = objectStack.count(); }
        while objectStackIndex < objectStack.count() {
            var objectIndex = objectStack.get(objectStackIndex);
            var objectX = scene.ObjectX(objectIndex) * displayCellSize
                / scene.TileWidth - viewOriginX;
            var objectY = scene.ObjectY(objectIndex) * displayCellSize
                / scene.TileHeight - viewOriginY;
            if objectX < 0 - overlayMargin
               or objectY < 0 - overlayMargin
               or objectX > windowWidth + overlayMargin
               or objectY > windowHeight + overlayMargin {
                objectStackIndex = objectStackIndex + 1;
                continue;
            }
            var objectColor = Color.RGB(255, 190, 72);
            if scene_selection.Contains(selectedObjects, objectIndex) {
                objectColor = Color.RGB(104, 220, 255);
            }
            if objectIndex == selectedObject {
                objectColor = Color.RGB(170, 242, 255);
            }
            var drewSprite = objectSpriteDrawn.get(objectIndex) != 0;
            if drewSprite == false {
                framePixels.DrawDisc(objectX + displayCellSize / 2,
                                     objectY + displayCellSize / 2,
                                     ClampInt(displayCellSize / 4, 2, 10),
                                     objectColor);
            }
            if scene.ObjectPropertyKind(objectIndex, "light.radius")
               == "int" {
                framePixels.DrawRing(
                    objectX + displayCellSize / 2,
                    objectY + displayCellSize / 2,
                    ClampInt(displayCellSize / 2 + 3, 5, 24),
                    Color.RGB(255, 236, 150));
            }
            // The outline follows the transformed sprite footprint
            // (ADR 0192); markers keep their legacy one-cell frame.
            if objectIndex == selectedObject and RectToolEligible() {
                var handle = 0;
                while handle <= 4 {
                    var handlePoint =
                        RectHandlePoint(objectIndex, handle);
                    if handle == 4 {
                        framePixels.DrawDisc(
                            Convert.NumToInt(handlePoint.x),
                            Convert.NumToInt(handlePoint.y),
                            4, Color.RGB(170, 242, 255));
                    } else {
                        framePixels.DrawBox(
                            Convert.NumToInt(handlePoint.x) - 3,
                            Convert.NumToInt(handlePoint.y) - 3,
                            7, 7, Color.RGB(255, 255, 255));
                    }
                    handle = handle + 1;
                }
            }
            var outline = ObjectCanvasFootprint(objectIndex);
            if outline.valid {
                framePixels.DrawFrame(
                    Convert.NumToInt(outline.minX),
                    Convert.NumToInt(outline.minY),
                    Convert.NumToInt(outline.maxX - outline.minX),
                    Convert.NumToInt(outline.maxY - outline.minY),
                    objectColor);
            } else {
                framePixels.DrawFrame(objectX, objectY,
                                      displayCellSize, displayCellSize,
                                      objectColor);
            }
            objectStackIndex = objectStackIndex + 1;
        }

        if gameViewActive == false { DrawTileBrushGhosts(); }

        if gameViewActive == false
           and selectedCellX >= 0 and selectedCellY >= 0
           and selectedCellX < sceneColumns
           and selectedCellY < sceneRows {
            framePixels.DrawFrame(
                selectedCellX * displayCellSize - viewOriginX,
                selectedCellY * displayCellSize - viewOriginY,
                displayCellSize + 1,
                displayCellSize + 1,
                Color.RGB(255, 255, 255));
        }
        if gameViewActive == false and tileRegionMinX >= 0 {
            framePixels.DrawFrame(
                tileRegionMinX * displayCellSize - viewOriginX,
                tileRegionMinY * displayCellSize - viewOriginY,
                (tileRegionMaxX - tileRegionMinX + 1) * displayCellSize + 1,
                (tileRegionMaxY - tileRegionMinY + 1) * displayCellSize + 1,
                Color.RGB(255, 220, 120));
        }
        // Stamp ghost: the grid-anchored footprint the next click writes.
        if gameViewActive == false
           and stampActive and mode == MODE_PAINT
           and stampWidth > 0 and stampHeight > 0
           and selectedCellX >= 0 and selectedCellY >= 0 {
            var ghostCellX = selectedCellX / stampWidth * stampWidth;
            var ghostCellY = selectedCellY / stampHeight * stampHeight;
            framePixels.DrawFrame(
                ghostCellX * displayCellSize - viewOriginX,
                ghostCellY * displayCellSize - viewOriginY,
                stampWidth * displayCellSize + 1,
                stampHeight * displayCellSize + 1,
                Color.RGB(140, 235, 170));
        }

        if gameViewActive == false
           and tileRectangleActive
           and tileRectangleStartX >= 0
           and tileRectangleStartY >= 0
           and tileRectangleCurrentX >= 0
           and tileRectangleCurrentY >= 0 {
            if tileRectangleShape != 0 {
                // Line/ellipse previews frame the exact commit cells.
                var previewCells = ShapeCells(
                    tileRectangleShape,
                    tileRectangleStartX, tileRectangleStartY,
                    tileRectangleCurrentX, tileRectangleCurrentY);
                var previewIndex = 0;
                while previewIndex < previewCells.count() {
                    framePixels.DrawFrame(
                        previewCells.get(previewIndex)
                            * displayCellSize - viewOriginX,
                        previewCells.get(previewIndex + 1)
                            * displayCellSize - viewOriginY,
                        displayCellSize + 1,
                        displayCellSize + 1,
                        TILE_RECTANGLE_COLOR);
                    previewIndex = previewIndex + 2;
                }
            } else {
                var minimumTileX = tileRectangleStartX;
                var maximumTileX = tileRectangleCurrentX;
                if maximumTileX < minimumTileX {
                    minimumTileX = tileRectangleCurrentX;
                    maximumTileX = tileRectangleStartX;
                }
                var minimumTileY = tileRectangleStartY;
                var maximumTileY = tileRectangleCurrentY;
                if maximumTileY < minimumTileY {
                    minimumTileY = tileRectangleCurrentY;
                    maximumTileY = tileRectangleStartY;
                }
                framePixels.DrawFrame(
                    minimumTileX * displayCellSize - viewOriginX,
                    minimumTileY * displayCellSize - viewOriginY,
                    (maximumTileX - minimumTileX + 1)
                        * displayCellSize + 1,
                    (maximumTileY - minimumTileY + 1)
                        * displayCellSize + 1,
                    TILE_RECTANGLE_COLOR);
            }
        }

        if gameViewActive == false
           and canvasMarqueeActive
           and canvasMarqueeStartX >= 0
           and canvasMarqueeStartY >= 0
           and canvasMarqueeCurrentX >= 0
           and canvasMarqueeCurrentY >= 0 {
            var minimumX = canvasMarqueeStartX;
            var maximumX = canvasMarqueeCurrentX;
            if maximumX < minimumX {
                minimumX = canvasMarqueeCurrentX;
                maximumX = canvasMarqueeStartX;
            }
            var minimumY = canvasMarqueeStartY;
            var maximumY = canvasMarqueeCurrentY;
            if maximumY < minimumY {
                minimumY = canvasMarqueeCurrentY;
                maximumY = canvasMarqueeStartY;
            }
            framePixels.DrawFrame(
                minimumX * displayCellSize - viewOriginX,
                minimumY * displayCellSize - viewOriginY,
                (maximumX - minimumX + 1) * displayCellSize + 1,
                (maximumY - minimumY + 1) * displayCellSize + 1,
                CANVAS_MARQUEE_COLOR);
        }

        // Guides are editor chrome: keep them legible above authored pixels
        // and transient tool previews without changing either source.
        if gameViewActive == false { DrawCanvasGuides(); }
        DrawGameOutputMatte(windowWidth, windowHeight);
        RenderCanvasRulers();
        canvasImage.SetPixels(framePixels, windowWidth, windowHeight);
        canvasImage.SetSize(windowWidth, windowHeight);
        // Pin the rendered window under the viewport: the ScrollView places
        // the image at (margin - scroll), so a margin equal to the clamped
        // scroll origin keeps window pixels exactly aligned with content
        // coordinates; the pad centers small scenes.
        canvasImage.SetMarginEdges(
            viewOriginX + centerPadX, viewOriginY + centerPadY, 0.0, 0.0);
        var suffix = "";
        if tilesets.cacheSaturated {
            suffix = suffix + "  |  tileset preview cache capped";
        }
        var cellStatus = "";
        if selectedCellX >= 0 and selectedCellY >= 0 {
            cellStatus = "  |  cell "
                + selectedCellX + ", " + selectedCellY;
        }
        var marqueeStatus = "";
        if canvasMarqueeActive {
            marqueeStatus = "  |  box "
                + (AbsInt2D(
                    canvasMarqueeCurrentX - canvasMarqueeStartX) + 1)
                + "x"
                + (AbsInt2D(
                    canvasMarqueeCurrentY - canvasMarqueeStartY) + 1);
        }
        var rectangleStatus = "";
        if tileRectangleActive {
            var shapeName = "rectangle";
            if tileRectangleShape == 1 { shapeName = "line"; }
            if tileRectangleShape == 2 { shapeName = "ellipse"; }
            rectangleStatus = "  |  " + shapeName + " "
                + (AbsInt2D(
                    tileRectangleCurrentX - tileRectangleStartX) + 1)
                + "x"
                + (AbsInt2D(
                    tileRectangleCurrentY - tileRectangleStartY) + 1);
        }
        if gameViewActive {
            if gameViewOutputFramed {
                viewStatusLabel.SetText(
                    "Game View  |  " + GameOutputSizeLabel()
                    + " project output" + suffix);
                canvasImage.SetAccessibleDescription(
                    scene.ObjectCount() + " authored objects in the locked "
                    + GameOutputSizeLabel()
                    + " project gameplay frame. Exit Game View to navigate "
                    + "or edit.");
            } else {
                viewStatusLabel.SetText(
                    "Game View  |  zoom " + zoomPercent + "%" + suffix);
                canvasImage.SetAccessibleDescription(
                    scene.ObjectCount() + " authored objects on a "
                    + renderedColumns + " by " + renderedRows
                    + " cell clean gameplay preview. Pan with the middle "
                    + "mouse button, zoom with the wheel, or exit Game View "
                    + "to edit.");
            }
        } else {
            viewStatusLabel.SetText(
                "Layer " + (activeLayer + 1) + "/" + scene.LayerCount()
                + "  |  zoom " + zoomPercent + "%"
                + cellStatus + marqueeStatus + rectangleStatus + suffix);
            canvasImage.SetAccessibleDescription(
                scene.ObjectCount() + " authored objects on a "
                + renderedColumns + " by " + renderedRows
                + " cell preview. Tile tools preview real atlas frames and "
                + "support freehand Paint and Erase, captured Rectangle, Line, "
                + "and Ellipse, connected Fill, and active-layer Pick. "
                + "Cell rulers can toggle workspace-only alignment guides. "
                + "In Select mode, click objects or drag blank space to "
                + "box-select; Shift adds and Control or Command toggles.");
        }
    }
}
