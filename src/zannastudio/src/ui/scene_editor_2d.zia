// Stable helper value types retained at the historical module boundary.
type ObjectFootprint2D = SceneEditor2DModel.ObjectFootprint2D;
type CanvasPoint2D = SceneEditor2DModel.CanvasPoint2D;

// Stable pure-function surface retained at the historical module boundary.
/// @brief Forward RotationIsEffectivelyZero to the focused 2D editor model.
func RotationIsEffectivelyZero(rotation: Number) -> Boolean {
    return SceneEditor2DModel.RotationIsEffectivelyZero(rotation);
}

/// @brief Forward TilePreviewColor to the focused 2D editor model.
func TilePreviewColor(tile: Integer, layer: Integer) -> Integer {
    return SceneEditor2DModel.TilePreviewColor(tile, layer);
}

/// @brief Forward ClampInt to the focused 2D editor model.
func ClampInt(value: Integer, minimum: Integer, maximum: Integer) -> Integer {
    return SceneEditor2DModel.ClampInt(value, minimum, maximum);
}

/// @brief Forward ClampNumber2D to the focused 2D editor model.
func ClampNumber2D(value: Number, minimum: Number, maximum: Number) -> Number {
    return SceneEditor2DModel.ClampNumber2D(value, minimum, maximum);
}

/// @brief Forward AbsInt2D to the focused 2D editor model.
func AbsInt2D(value: Integer) -> Integer {
    return SceneEditor2DModel.AbsInt2D(value);
}

/// @brief Forward FitZoomPercent to the focused 2D editor model.
expose func FitZoomPercent(sceneWidth: Integer,
                           sceneHeight: Integer,
                           tileSize: Integer,
                           viewportWidth: Integer,
                           viewportHeight: Integer) -> Integer {
    return SceneEditor2DModel.FitZoomPercent(
        sceneWidth,
        sceneHeight,
        tileSize,
        viewportWidth,
        viewportHeight);
}

/// @brief Forward InitialSceneZoomPercent to the focused 2D editor model.
expose func InitialSceneZoomPercent(sceneWidth: Integer,
                                    sceneHeight: Integer,
                                    tileSize: Integer,
                                    viewportWidth: Integer,
                                    viewportHeight: Integer) -> Integer {
    return SceneEditor2DModel.InitialSceneZoomPercent(
        sceneWidth,
        sceneHeight,
        tileSize,
        viewportWidth,
        viewportHeight);
}

/// @brief Forward UsesCompactLayout to the focused 2D editor model.
expose func UsesCompactLayout(width: Number) -> Boolean {
    return SceneEditor2DModel.UsesCompactLayout(width);
}

/// @brief Forward UsesCompactChrome to the focused 2D editor model.
expose func UsesCompactChrome(width: Number) -> Boolean {
    return SceneEditor2DModel.UsesCompactChrome(width);
}

/// @brief Forward UsesSceneCommandMenus to the focused 2D editor model.
expose func UsesSceneCommandMenus(width: Number) -> Boolean {
    return SceneEditor2DModel.UsesSceneCommandMenus(width);
}

/// @brief Forward UsesCompactPaletteLayout to the focused 2D editor model.
expose func UsesCompactPaletteLayout(height: Number) -> Boolean {
    return SceneEditor2DModel.UsesCompactPaletteLayout(height);
}

/// @brief Forward UsesDockedHierarchy to the focused 2D editor model.
expose func UsesDockedHierarchy(width: Number) -> Boolean {
    return SceneEditor2DModel.UsesDockedHierarchy(width);
}

/// @brief Forward CanvasRulerMajorStride to the focused 2D editor model.
expose func CanvasRulerMajorStride(cellSize: Integer) -> Integer {
    return SceneEditor2DModel.CanvasRulerMajorStride(cellSize);
}

/// @brief Forward CanvasRulerGuideCoordinate to the focused 2D editor model.
expose func CanvasRulerGuideCoordinate(localPosition: Integer,
                                       viewOrigin: Integer,
                                       centerPad: Integer,
                                       cellSize: Integer,
                                       maximum: Integer) -> Integer {
    return SceneEditor2DModel.CanvasRulerGuideCoordinate(localPosition, viewOrigin, centerPad, cellSize, maximum);
}

/// @brief Public facade for the focused 2D scene-editor implementation layers.
class SceneEditor2D extends SceneEditor2DImplementation.SceneEditor2DRendererLayer {
    expose func init() {
        InitializeState();
    }
}
