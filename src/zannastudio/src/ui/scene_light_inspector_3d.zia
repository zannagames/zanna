//
// File: zannastudio/src/ui/scene_light_inspector_3d.zia
// Purpose: Accessible all-type Light3D controls for Studio's 3D inspector.
// Key invariants:
//   - This presentation object never mutates a SceneNode or canonical VSCN.
//   - Controls are enabled only for one unambiguous selected node.
//   - Type-specific rows describe local light fields and hide inapplicable data.
//   - Apply and Remove return intent to the transactional scene controller.
// Ownership/Lifetime: SceneEditor3D owns one inspector; GUI owns its widgets.
// Links: zannastudio/src/ui/scene_editor_3d.zia,
//        zannastudio/src/ui/scene_light_3d.zia,
//        zannastudio/src/probes/scene_light_authoring_probe.zia,
//        docs/adr/0172-public-scenenode-light-authoring-and-studio-light-inspector.md
//
//===----------------------------------------------------------------------===//

module scene_light_inspector_3d;

bind "scene_light_3d";
bind "inspector_rows";

bind GUI = Zanna.GUI;
bind SceneNode = Zanna.Graphics3D.SceneNode;
bind Light3D = Zanna.Graphics3D.Light3D;

// ============================================================================
// MODULE: scene_light_inspector_3d
// PURPOSE: Keep responsive light presentation outside the VSCN controller.
//
// WHERE-THIS-FITS: SceneEditor3D refreshes this object from the selected
//          runtime node and consumes its buttons as transaction requests.
//
// TEACHING-NOTE: Widgets are a draft. BuildState returns values only; the
//          controller constructs an independent light and owns history.
// ============================================================================

/// @brief Presentation-only node-light component inspector.
class SceneLightInspector3D {
    expose GUI.GroupBox group;
    expose GUI.Label summary;
    expose GUI.Dropdown typeDropdown;
    expose GUI.Checkbox colorOverride;
    expose GUI.ColorPicker colorPicker;
    expose GUI.Spinner intensity;
    expose GUI.Checkbox enabledCheck;
    expose GUI.Checkbox castsShadowsCheck;
    expose GUI.GroupBox positionGroup;
    expose GUI.Spinner positionX;
    expose GUI.Spinner positionY;
    expose GUI.Spinner positionZ;
    expose GUI.GroupBox directionGroup;
    expose GUI.Spinner directionX;
    expose GUI.Spinner directionY;
    expose GUI.Spinner directionZ;
    expose GUI.GroupBox falloffGroup;
    expose GUI.Spinner attenuation;
    expose GUI.Dropdown decayType;
    expose GUI.Spinner range;
    expose GUI.GroupBox shapeGroup;
    expose GUI.Spinner width;
    expose GUI.Spinner height;
    expose GUI.Spinner radius;
    expose GUI.Spinner innerCone;
    expose GUI.Spinner outerCone;
    expose GUI.Button applyButton;
    expose GUI.Button removeButton;

    expose func init() {
        group = null;
        summary = null;
        typeDropdown = null;
        colorOverride = null;
        colorPicker = null;
        intensity = null;
        enabledCheck = null;
        castsShadowsCheck = null;
        positionGroup = null;
        positionX = null;
        positionY = null;
        positionZ = null;
        directionGroup = null;
        directionX = null;
        directionY = null;
        directionZ = null;
        falloffGroup = null;
        attenuation = null;
        decayType = null;
        range = null;
        shapeGroup = null;
        width = null;
        height = null;
        radius = null;
        innerCone = null;
        outerCone = null;
        applyButton = null;
        removeButton = null;
    }

    /// @brief Build the complete node-light component surface.
    expose func Setup(parent: GUI.VBox) {
        group = GUI.GroupBox.New(parent, "Light component");
        summary = GUI.Label.New(
            group,
            "No light component. Create a Point light or choose another type.");
        summary.SetWordWrap(true);

        typeDropdown = GUI.Dropdown.New(group);
        typeDropdown.SetAccessibleName("Node light type");
        typeDropdown.AddItem("Directional");
        typeDropdown.AddItem("Point");
        typeDropdown.AddItem("Ambient");
        typeDropdown.AddItem("Spot");
        typeDropdown.AddItem("Rectangle Area");
        typeDropdown.AddItem("Sphere Area");
        typeDropdown.AddItem("Volume");
        typeDropdown.SetSelected(scene_light_3d.LIGHT_POINT);

        var appearance = inspector_rows.NewWrapRow();
        group.AddChild(appearance);
        colorOverride = GUI.Checkbox.New(appearance, "Color");
        colorOverride.SetTooltip(
            "Determinate applies this color to the selection; mixed "
            + "preserves each node's color");
        colorOverride.SetChecked(true);
        colorPicker = GUI.ColorPicker.New(appearance);
        colorPicker.SetFlex(1.0);
        colorPicker.SetAccessibleName("Node light color");
        colorPicker.SetAlphaEnabled(false);
        colorPicker.SetColor(scene_light_3d.DEFAULT_COLOR);
        intensity = AddSpinner(
            appearance, "Intensity", 0.0, 1000000.0, 0.1, 2, 1.0);

        enabledCheck = GUI.Checkbox.New(group, "Enabled");
        enabledCheck.SetTooltip(
            "Keep this light in the scene while temporarily disabling its contribution");
        enabledCheck.SetChecked(true);
        castsShadowsCheck =
            GUI.Checkbox.New(group, "Eligible to cast shadows");
        castsShadowsCheck.SetTooltip(
            "Request renderer shadow slots; availability remains backend dependent");
        castsShadowsCheck.SetChecked(false);

        positionGroup = GUI.GroupBox.New(group, "Local light offset");
        var positionRow = inspector_rows.NewWrapRow();
        positionGroup.AddChild(positionRow);
        positionX = AddSignedSpinner(positionRow, "X", 0.0);
        positionY = AddSignedSpinner(positionRow, "Y", 0.0);
        positionZ = AddSignedSpinner(positionRow, "Z", 0.0);

        directionGroup = GUI.GroupBox.New(group, "Local light direction");
        var directionRow = inspector_rows.NewWrapRow();
        directionGroup.AddChild(directionRow);
        directionX = AddSignedSpinner(directionRow, "X", 0.0);
        directionY = AddSignedSpinner(directionRow, "Y", -1.0);
        directionZ = AddSignedSpinner(directionRow, "Z", 0.0);

        falloffGroup = GUI.GroupBox.New(group, "Falloff");
        var falloffRow = inspector_rows.NewWrapRow();
        falloffGroup.AddChild(falloffRow);
        attenuation = AddSpinner(
            falloffRow, "Atten", 0.001, 1000000.0, 0.01, 3,
            scene_light_3d.DEFAULT_ATTENUATION);
        range = AddSpinner(
            falloffRow, "Range", 0.001, 1000000.0, 0.25, 2,
            scene_light_3d.DEFAULT_RANGE);
        decayType = GUI.Dropdown.New(falloffGroup);
        decayType.SetAccessibleName("Node light distance decay");
        decayType.AddItem("No decay");
        decayType.AddItem("Linear");
        decayType.AddItem("Quadratic");
        decayType.AddItem("Cubic");
        decayType.SetSelected(scene_light_3d.DECAY_QUADRATIC);

        shapeGroup = GUI.GroupBox.New(group, "Emitter shape");
        var dimensionRow = inspector_rows.NewWrapRow();
        shapeGroup.AddChild(dimensionRow);
        width = AddSpinner(
            dimensionRow, "Width", 0.001, 1000000.0, 0.1, 2, 1.0);
        height = AddSpinner(
            dimensionRow, "Height", 0.001, 1000000.0, 0.1, 2, 1.0);
        radius = AddSpinner(
            dimensionRow, "Radius", 0.001, 1000000.0, 0.1, 2, 1.0);
        var coneRow = inspector_rows.NewWrapRow();
        shapeGroup.AddChild(coneRow);
        innerCone = AddSpinner(
            coneRow, "Inner °", 0.0, 89.0, 0.5, 2,
            scene_light_3d.DEFAULT_INNER_CONE);
        outerCone = AddSpinner(
            coneRow, "Outer °", 0.01, 89.0, 0.5, 2,
            scene_light_3d.DEFAULT_OUTER_CONE);

        var buttons = inspector_rows.NewWrapRow();
        group.AddChild(buttons);
        applyButton = GUI.Button.New(buttons, "Create Light");
        applyButton.SetTooltip(
            "Build an independent light and commit one undoable VSCN edit");
        removeButton = GUI.Button.New(buttons, "Remove");
        removeButton.SetTooltip(
            "Remove the light while keeping the node and its other components");

        UpdateTypeControls();
        var noNodes: List[SceneNode] = [];
        UpdateSelectionControls(false, noNodes, 0);
    }

    /// @brief Refresh truthful common/mixed fields for one node selection.
    /// @details Mixed detection spans light-bearing nodes only; nodes
    ///          without lights participate in coverage counts (ADR 0186).
    expose func RefreshSelection(nodes: List[SceneNode],
                                 primary: SceneNode,
                                 editorEnabled: Boolean) {
        if typeDropdown == null { return; }
        var primaryLight: Light3D = null;
        if primary != null { primaryLight = primary.Light; }
        var lightCount = 0;
        var reference: Light3D = null;
        var index = 0;
        while index < nodes.count() {
            var candidate = nodes.get(index).Light;
            if candidate != null {
                lightCount = lightCount + 1;
                if reference == null { reference = candidate; }
            }
            index = index + 1;
        }
        if primaryLight == null { primaryLight = reference; }
        var state = scene_light_3d.FromLight(primaryLight);

        var kindMixed = false;
        var colorMixed = false;
        var intensityMixed = false;
        var enabledMixed = false;
        var shadowsMixed = false;
        var positionXMixed = false;
        var positionYMixed = false;
        var positionZMixed = false;
        var directionXMixed = false;
        var directionYMixed = false;
        var directionZMixed = false;
        var attenuationMixed = false;
        var decayMixed = false;
        var rangeMixed = false;
        var widthMixed = false;
        var heightMixed = false;
        var radiusMixed = false;
        var innerMixed = false;
        var outerMixed = false;
        index = 0;
        while index < nodes.count() {
            var candidate = nodes.get(index).Light;
            if candidate != null and candidate != primaryLight {
                var other = scene_light_3d.FromLight(candidate);
                if other.kind != state.kind { kindMixed = true; }
                if MixedNumber(other.red, state.red)
                   or MixedNumber(other.green, state.green)
                   or MixedNumber(other.blue, state.blue) {
                    colorMixed = true;
                }
                if MixedNumber(other.intensity, state.intensity) {
                    intensityMixed = true;
                }
                if other.enabled != state.enabled { enabledMixed = true; }
                if other.castsShadows != state.castsShadows {
                    shadowsMixed = true;
                }
                if MixedNumber(other.positionX, state.positionX) {
                    positionXMixed = true;
                }
                if MixedNumber(other.positionY, state.positionY) {
                    positionYMixed = true;
                }
                if MixedNumber(other.positionZ, state.positionZ) {
                    positionZMixed = true;
                }
                if MixedNumber(other.directionX, state.directionX) {
                    directionXMixed = true;
                }
                if MixedNumber(other.directionY, state.directionY) {
                    directionYMixed = true;
                }
                if MixedNumber(other.directionZ, state.directionZ) {
                    directionZMixed = true;
                }
                if MixedNumber(other.attenuation, state.attenuation) {
                    attenuationMixed = true;
                }
                if other.decayType != state.decayType {
                    decayMixed = true;
                }
                if MixedNumber(other.range, state.range) {
                    rangeMixed = true;
                }
                if MixedNumber(other.width, state.width) {
                    widthMixed = true;
                }
                if MixedNumber(other.height, state.height) {
                    heightMixed = true;
                }
                if MixedNumber(other.radius, state.radius) {
                    radiusMixed = true;
                }
                if MixedNumber(
                       other.innerConeDegrees, state.innerConeDegrees) {
                    innerMixed = true;
                }
                if MixedNumber(
                       other.outerConeDegrees, state.outerConeDegrees) {
                    outerMixed = true;
                }
            }
            index = index + 1;
        }

        typeDropdown.SetSelected(state.kind);
        if kindMixed { typeDropdown.SetSelected(-1); }
        colorPicker.SetColor(scene_light_3d.PackedRgb(primaryLight));
        colorOverride.SetChecked(lightCount > 0);
        if colorMixed { colorOverride.SetIndeterminate(true); }
        intensity.SetValue(state.intensity);
        if intensityMixed { intensity.SetIndeterminate(true); }
        enabledCheck.SetChecked(state.enabled);
        if enabledMixed { enabledCheck.SetIndeterminate(true); }
        castsShadowsCheck.SetChecked(state.castsShadows);
        if shadowsMixed { castsShadowsCheck.SetIndeterminate(true); }
        positionX.SetValue(state.positionX);
        if positionXMixed { positionX.SetIndeterminate(true); }
        positionY.SetValue(state.positionY);
        if positionYMixed { positionY.SetIndeterminate(true); }
        positionZ.SetValue(state.positionZ);
        if positionZMixed { positionZ.SetIndeterminate(true); }
        directionX.SetValue(state.directionX);
        if directionXMixed { directionX.SetIndeterminate(true); }
        directionY.SetValue(state.directionY);
        if directionYMixed { directionY.SetIndeterminate(true); }
        directionZ.SetValue(state.directionZ);
        if directionZMixed { directionZ.SetIndeterminate(true); }
        attenuation.SetValue(state.attenuation);
        if attenuationMixed { attenuation.SetIndeterminate(true); }
        decayType.SetSelected(state.decayType);
        if decayMixed { decayType.SetSelected(-1); }
        range.SetValue(state.range);
        if rangeMixed { range.SetIndeterminate(true); }
        width.SetValue(state.width);
        if widthMixed { width.SetIndeterminate(true); }
        height.SetValue(state.height);
        if heightMixed { height.SetIndeterminate(true); }
        radius.SetValue(state.radius);
        if radiusMixed { radius.SetIndeterminate(true); }
        innerCone.SetValue(state.innerConeDegrees);
        if innerMixed { innerCone.SetIndeterminate(true); }
        outerCone.SetValue(state.outerConeDegrees);
        if outerMixed { outerCone.SetIndeterminate(true); }
        // Programmatic refresh must not look like user color intent.
        colorPicker.WasChanged();

        if nodes.count() == 0 {
            summary.SetText(
                "Select one or more nodes to author light components.");
        } else if nodes.count() > 1 {
            var coverage = lightCount + " of " + nodes.count()
                + " nodes carry lights";
            if lightCount == 0 {
                coverage = "No selected nodes carry lights";
            } else if lightCount == nodes.count() {
                coverage = "All " + nodes.count()
                    + " selected nodes carry lights";
            }
            summary.SetText(
                coverage
                + ". Mixed fields preserve each node's value; choosing a "
                + "concrete kind rebuilds each light, keeping compatible "
                + "fields and defaulting the rest.");
        } else if primaryLight == null {
            summary.SetText(
                "No light component. Create a Point light or choose another type.");
        } else {
            var stateText = "enabled";
            if primaryLight.IsEnabled == false { stateText = "disabled"; }
            summary.SetText(
                scene_light_3d.TypeName(primaryLight.Type)
                + " light • " + stateText
                + " • light-local fields follow the node world transform.");
        }
        UpdateTypeControls();
        UpdateSelectionControls(editorEnabled, nodes, lightCount);
    }

    /// @brief Return whether two field values disagree beyond the epsilon.
    hide func MixedNumber(a: Number, b: Number) -> Boolean {
        var difference = a - b;
        if difference < 0.0 { difference = 0.0 - difference; }
        return difference >= scene_light_3d.LIGHT_VALUE_EPSILON;
    }

    /// @brief Resolve mixed color intent when the picker itself changes.
    expose func PumpDraftIntent() {
        if colorPicker != null and colorPicker.WasChanged() {
            colorOverride.SetChecked(true);
        }
    }

    /// @brief Build a sparse patch from every currently determined control.
    expose func BuildPatch() -> scene_light_3d.LightPatch3D {
        var patch = new scene_light_3d.LightPatch3D();
        if typeDropdown == null { return patch; }
        patch.applyKind = typeDropdown.Selected >= 0;
        patch.kind = typeDropdown.Selected;
        patch.applyColor = colorOverride.IsIndeterminate() == false
            and colorOverride.IsChecked();
        patch.red = scene_light_3d.UnitFromByte(colorPicker.GetRed());
        patch.green =
            scene_light_3d.UnitFromByte(colorPicker.GetGreen());
        patch.blue = scene_light_3d.UnitFromByte(colorPicker.GetBlue());
        patch.applyIntensity = intensity.IsIndeterminate() == false;
        patch.intensity = intensity.Value;
        patch.applyEnabled = enabledCheck.IsIndeterminate() == false;
        patch.enabled = enabledCheck.IsChecked();
        patch.applyCastsShadows =
            castsShadowsCheck.IsIndeterminate() == false;
        patch.castsShadows = castsShadowsCheck.IsChecked();
        patch.applyPositionX = positionX.IsIndeterminate() == false;
        patch.positionX = positionX.Value;
        patch.applyPositionY = positionY.IsIndeterminate() == false;
        patch.positionY = positionY.Value;
        patch.applyPositionZ = positionZ.IsIndeterminate() == false;
        patch.positionZ = positionZ.Value;
        patch.applyDirectionX = directionX.IsIndeterminate() == false;
        patch.directionX = directionX.Value;
        patch.applyDirectionY = directionY.IsIndeterminate() == false;
        patch.directionY = directionY.Value;
        patch.applyDirectionZ = directionZ.IsIndeterminate() == false;
        patch.directionZ = directionZ.Value;
        patch.applyAttenuation = attenuation.IsIndeterminate() == false;
        patch.attenuation = attenuation.Value;
        patch.applyDecayType = decayType.Selected >= 0;
        patch.decayType = decayType.Selected;
        patch.applyRange = range.IsIndeterminate() == false;
        patch.range = range.Value;
        patch.applyWidth = width.IsIndeterminate() == false;
        patch.width = width.Value;
        patch.applyHeight = height.IsIndeterminate() == false;
        patch.height = height.Value;
        patch.applyRadius = radius.IsIndeterminate() == false;
        patch.radius = radius.Value;
        patch.applyInnerCone = innerCone.IsIndeterminate() == false;
        patch.innerConeDegrees = innerCone.Value;
        patch.applyOuterCone = outerCone.IsIndeterminate() == false;
        patch.outerConeDegrees = outerCone.Value;
        return patch;
    }

    /// @brief Keep actions truthful for multi-node coverage (ADR 0186).
    expose func UpdateSelectionControls(editorEnabled: Boolean,
                                        nodes: List[SceneNode],
                                        lightCount: Integer) {
        if typeDropdown == null { return; }
        var hasSelection = editorEnabled and nodes.count() > 0;
        group.SetEnabled(editorEnabled);
        typeDropdown.SetEnabled(hasSelection);
        colorOverride.SetEnabled(hasSelection);
        colorPicker.SetEnabled(hasSelection);
        intensity.SetEnabled(hasSelection);
        enabledCheck.SetEnabled(hasSelection);
        applyButton.SetEnabled(hasSelection);
        removeButton.SetEnabled(hasSelection and lightCount > 0);
        positionX.SetEnabled(hasSelection);
        positionY.SetEnabled(hasSelection);
        positionZ.SetEnabled(hasSelection);
        directionX.SetEnabled(hasSelection);
        directionY.SetEnabled(hasSelection);
        directionZ.SetEnabled(hasSelection);
        if hasSelection == false {
            applyButton.SetText("Apply Light");
            applyButton.SetTooltip(
                "Select one or more nodes before editing lights");
        } else if lightCount == 0 {
            applyButton.SetText("Create Light");
            applyButton.SetTooltip(
                "Create these light components in one undoable VSCN edit");
        } else if lightCount < nodes.count() {
            applyButton.SetText(
                "Apply To " + lightCount + " Light(s)");
            applyButton.SetTooltip(
                "Apply determined fields to light-bearing nodes; nodes "
                + "without lights are skipped (Create first)");
        } else {
            applyButton.SetText("Apply Light");
            applyButton.SetTooltip(
                "Apply determined fields to every selected light in one "
                + "undoable edit; mixed fields preserve node values");
        }
        if lightCount > 1 {
            removeButton.SetText("Remove (" + lightCount + ")");
        } else {
            removeButton.SetText("Remove");
        }
        UpdateTypeControls();
        var kindKnown = typeDropdown.Selected >= 0;
        if kindKnown {
            castsShadowsCheck.SetEnabled(
                hasSelection
                and scene_light_3d.SupportsShadows(
                        typeDropdown.Selected));
            attenuation.SetEnabled(
                hasSelection
                and scene_light_3d.HasAttenuation(
                        typeDropdown.Selected));
            decayType.SetEnabled(
                hasSelection
                and scene_light_3d.HasDecay(typeDropdown.Selected));
            range.SetEnabled(
                hasSelection
                and scene_light_3d.HasRange(typeDropdown.Selected));
            width.SetEnabled(
                hasSelection
                and typeDropdown.Selected
                    == scene_light_3d.LIGHT_AREA_RECTANGLE);
            height.SetEnabled(
                hasSelection
                and typeDropdown.Selected
                    == scene_light_3d.LIGHT_AREA_RECTANGLE);
            radius.SetEnabled(
                hasSelection
                and (typeDropdown.Selected
                        == scene_light_3d.LIGHT_AREA_SPHERE
                     or typeDropdown.Selected
                        == scene_light_3d.LIGHT_VOLUME));
            innerCone.SetEnabled(
                hasSelection
                and typeDropdown.Selected == scene_light_3d.LIGHT_SPOT);
            outerCone.SetEnabled(
                hasSelection
                and typeDropdown.Selected == scene_light_3d.LIGHT_SPOT);
        }
    }

    /// @brief Build one complete normalized draft from visible controls.
    expose func BuildState() -> scene_light_3d.LightState3D {
        var state = new scene_light_3d.LightState3D();
        state.kind = typeDropdown.Selected;
        state.red =
            scene_light_3d.UnitFromByte(colorPicker.GetRed());
        state.green =
            scene_light_3d.UnitFromByte(colorPicker.GetGreen());
        state.blue =
            scene_light_3d.UnitFromByte(colorPicker.GetBlue());
        state.intensity = intensity.Value;
        state.enabled = enabledCheck.IsChecked();
        state.castsShadows = castsShadowsCheck.IsChecked();
        state.positionX = positionX.Value;
        state.positionY = positionY.Value;
        state.positionZ = positionZ.Value;
        state.directionX = directionX.Value;
        state.directionY = directionY.Value;
        state.directionZ = directionZ.Value;
        state.attenuation = attenuation.Value;
        state.decayType = decayType.Selected;
        state.range = range.Value;
        state.width = width.Value;
        state.height = height.Value;
        state.radius = radius.Value;
        state.innerConeDegrees = innerCone.Value;
        state.outerConeDegrees = outerCone.Value;
        return scene_light_3d.Normalize(state);
    }

    /// @brief Show and enable only fields meaningful for the selected type.
    expose func UpdateTypeControls() {
        if typeDropdown == null { return; }
        var kind = typeDropdown.Selected;
        if kind < 0 {
            // Mixed kinds: every group stays reachable so concrete edits
            // to shared fields remain possible without forcing one kind.
            positionGroup.SetVisible(true);
            directionGroup.SetVisible(true);
            falloffGroup.SetVisible(true);
            shapeGroup.SetVisible(true);
            attenuation.SetEnabled(true);
            range.SetEnabled(true);
            width.SetEnabled(true);
            height.SetEnabled(true);
            radius.SetEnabled(true);
            innerCone.SetEnabled(true);
            outerCone.SetEnabled(true);
            castsShadowsCheck.SetEnabled(true);
            return;
        }
        if kind > scene_light_3d.LIGHT_VOLUME {
            kind = scene_light_3d.LIGHT_POINT;
            typeDropdown.SetSelected(kind);
        }
        positionGroup.SetVisible(scene_light_3d.HasPosition(kind));
        directionGroup.SetVisible(scene_light_3d.HasDirection(kind));
        falloffGroup.SetVisible(scene_light_3d.HasDecay(kind));
        shapeGroup.SetVisible(kind >= scene_light_3d.LIGHT_SPOT);
        attenuation.SetEnabled(scene_light_3d.HasAttenuation(kind));
        range.SetEnabled(scene_light_3d.HasRange(kind));
        width.SetEnabled(kind == scene_light_3d.LIGHT_AREA_RECTANGLE);
        height.SetEnabled(kind == scene_light_3d.LIGHT_AREA_RECTANGLE);
        radius.SetEnabled(
            kind == scene_light_3d.LIGHT_AREA_SPHERE
            or kind == scene_light_3d.LIGHT_VOLUME);
        innerCone.SetEnabled(kind == scene_light_3d.LIGHT_SPOT);
        outerCone.SetEnabled(kind == scene_light_3d.LIGHT_SPOT);
        castsShadowsCheck.SetEnabled(
            scene_light_3d.SupportsShadows(kind));
        if scene_light_3d.SupportsShadows(kind) == false {
            castsShadowsCheck.SetChecked(false);
        }
    }


    hide func AddSignedSpinner(parent: GUI.Flex,
                               label: String,
                               value: Number) -> GUI.Spinner {
        return AddSpinner(
            parent, label,
            0.0 - scene_light_3d.LIGHT_POSITION_LIMIT,
            scene_light_3d.LIGHT_POSITION_LIMIT,
            0.1, 3, value);
    }

    hide func AddSpinner(parent: GUI.Flex,
                         label: String,
                         minimum: Number,
                         maximum: Number,
                         step: Number,
                         decimals: Integer,
                         value: Number) -> GUI.Spinner {
        GUI.Label.New(parent, label);
        var spinner = GUI.Spinner.New(parent);
        spinner.SetRange(minimum, maximum);
        spinner.SetStep(step);
        spinner.SetDecimals(decimals);
        spinner.SetValue(value);
        spinner.SetPreferredSize(72.0, 0.0);
        spinner.SetAccessibleName(label + " light value");
        return spinner;
    }
}
