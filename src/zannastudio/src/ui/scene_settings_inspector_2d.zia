//
// File: zannastudio/src/ui/scene_settings_inspector_2d.zia
// Purpose: Schema-v19 Scene Settings surface for the 2D editor (typed
//          scene-property forms above the raw grid).
// Key invariants:
//   - Presentation only: forms read SceneDocument properties and report
//     committed key/kind/value batches; SceneEditor2D owns the
//     one-transaction write.
//   - Rebuilds only on schema-identity or repeat-count change; refreshes
//     are edge-free (ADR 0221).
// Ownership/Lifetime:
//   - The host widget tree owns the widgets; this class owns row records.
// Links: zannastudio/src/ui/scene_component_form.zia,
//        zannastudio/src/ui/scene_settings_inspector_3d.zia
//
//===----------------------------------------------------------------------===//

module scene_settings_inspector_2d;

bind "scene_component_schema_model" as SceneComponentModel;
bind "scene_component_schema_forms_model" as FormsModel;
bind "scene_component_form";
bind "scene_settings_inspector_3d" as Shared;
bind "layout_metrics";

bind Fmt = Zanna.Text.Fmt;
bind GUI = Zanna.GUI;
bind SceneDocument = Zanna.Game2D.SceneDocument;

/// @brief Typed Scene Settings inspector bound to 2D scene properties.
class SceneSettingsInspector2D {
    expose GUI.VBox host;
    expose GUI.Label summary;
    expose List[Shared.SceneSettingsSection] sections;
    hide String builtStamp;

    expose func init() {
        host = null;
        summary = null;
        sections = [];
        builtStamp = "";
    }

    /// @brief Create the retained container under @p parent.
    expose func Setup(parent: GUI.VBox) {
        host = GUI.VBox.New();
        host.SetSpacing(layout_metrics.GAP_GROUP);
        parent.AddChild(host);
        summary = GUI.Label.New(host, "");
    }

    /// @brief Rebuild on schema change; reload values edge-free.
    expose func Refresh(schema: SceneComponentModel.SceneComponentSchema,
                        scene: SceneDocument,
                        enabled: Boolean) {
        if host == null { return; }
        var stamp = SchemaStamp(schema, scene);
        if stamp != builtStamp {
            Rebuild(schema, scene);
            builtStamp = stamp;
        }
        var index = 0;
        while index < sections.count() {
            var section = sections.get(index);
            section.form.RefreshValues(
                ValuesFor(section.form, scene));
            section.form.SetEnabled(enabled and scene != null);
            if section.addItemButton != null {
                var count = RepeatCount(section.component, scene);
                section.addItemButton.SetEnabled(
                    enabled and scene != null
                    and count < section.component.repeat.maximum);
                section.removeItemButton.SetEnabled(
                    enabled and scene != null and count > 0);
            }
            index = index + 1;
        }
        if sections.count() == 0 {
            summary.SetText(
                "No 2d-scene components declared. Add a v19 "
                + "sceneComponents section to scene-components.json to "
                + "author scene properties as typed forms.");
        } else {
            summary.SetText(
                "Typed scene settings write ordinary scene properties; "
                + "the raw grid stays authoritative for undeclared keys.");
        }
    }

    /// @brief Consume one committed row into a keyed write batch, or null.
    expose func TakeCommit(
        scene: SceneDocument) -> Shared.SceneSettingsCommit {
        if scene == null { return null; }
        var index = 0;
        while index < sections.count() {
            var section = sections.get(index);
            var row = section.form.TakeCommittedRow();
            if row >= 0 {
                var commit = new Shared.SceneSettingsCommit();
                var formRow = section.form.rows.get(row);
                var texts = section.form.CommittedTexts(row);
                var kind = section.form.KindTokenAt(row);
                var keyIndex = 0;
                while keyIndex < formRow.keys.count() {
                    commit.keys.add(formRow.keys.get(keyIndex));
                    commit.kinds.add(kind);
                    if keyIndex < texts.count() {
                        commit.values.add(texts.get(keyIndex));
                    } else {
                        commit.values.add("");
                    }
                    keyIndex = keyIndex + 1;
                }
                commit.label =
                    "Edited " + formRow.field.label + " in "
                    + section.component.label;
                return commit;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Consume one repeat-item ADD request into a write batch.
    expose func TakeAddItem(
        scene: SceneDocument) -> Shared.SceneSettingsCommit {
        if scene == null { return null; }
        var index = 0;
        while index < sections.count() {
            var section = sections.get(index);
            if section.addItemButton != null
               and section.addItemButton.WasClicked() {
                var repeat = section.component.repeat;
                var count = RepeatCount(section.component, scene);
                if count >= repeat.maximum { return null; }
                var commit = new Shared.SceneSettingsCommit();
                var prefix = repeat.PrefixFor(count);
                var fieldIndex = 0;
                while fieldIndex < section.component.fields.count() {
                    Shared.AppendDefaultWritesFor(
                        commit,
                        section.component.fields.get(fieldIndex),
                        prefix);
                    fieldIndex = fieldIndex + 1;
                }
                commit.keys.add(repeat.countKey);
                commit.kinds.add("int");
                commit.values.add(Fmt.Int(count + 1));
                commit.label =
                    "Added " + Shared.RepeatItemLabelFor(
                        section.component) + " " + count;
                return commit;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Consume one repeat-item REMOVE-last request.
    expose func TakeRemoveItem(
        scene: SceneDocument) -> Shared.SceneSettingsCommit {
        if scene == null { return null; }
        var index = 0;
        while index < sections.count() {
            var section = sections.get(index);
            if section.removeItemButton != null
               and section.removeItemButton.WasClicked() {
                var repeat = section.component.repeat;
                var count = RepeatCount(section.component, scene);
                if count <= 0 { return null; }
                var commit = new Shared.SceneSettingsCommit();
                var prefix = repeat.PrefixFor(count - 1);
                var fieldIndex = 0;
                while fieldIndex < section.component.fields.count() {
                    Shared.AppendRemovalKeysFor(
                        commit,
                        section.component.fields.get(fieldIndex),
                        prefix);
                    fieldIndex = fieldIndex + 1;
                }
                commit.keys.add(repeat.countKey);
                commit.kinds.add("int");
                commit.values.add(Fmt.Int(count - 1));
                commit.label =
                    "Removed " + Shared.RepeatItemLabelFor(
                        section.component) + " " + (count - 1);
                return commit;
            }
            index = index + 1;
        }
        return null;
    }

    // ---- construction -----------------------------------------------------

    hide func Rebuild(schema: SceneComponentModel.SceneComponentSchema,
                      scene: SceneDocument) {
        host.ClearChildren();
        summary = GUI.Label.New(host, "");
        sections = [];
        if schema == null or schema.valid == false { return; }
        var index = 0;
        while index < schema.sceneSettings.count() {
            var component = schema.sceneSettings.get(index);
            if component != null
               and component.SupportsTarget(
                       FormsModel.TARGET_2D_SCENE) {
                BuildSection(component, scene);
            }
            index = index + 1;
        }
    }

    hide func BuildSection(
        component: FormsModel.SceneSettingsComponent,
        scene: SceneDocument) {
        var section = new Shared.SceneSettingsSection();
        section.component = component;
        section.host = GUI.VBox.New();
        section.host.SetSpacing(layout_metrics.GAP_ROW);
        host.AddChild(section.host);
        if component.description != "" {
            var heading = GUI.Label.New(section.host, component.label);
            heading.SetTooltip(component.description);
        } else {
            GUI.Label.New(section.host, component.label);
        }
        section.form = new scene_component_form.SceneComponentForm();
        if component.repeat.IsActive() {
            var count = RepeatCount(component, scene);
            section.builtRepeatCount = count;
            var item = 0;
            while item < count {
                section.form.Build(
                    section.host,
                    component.fields,
                    component.repeat.PrefixFor(item),
                    item);
                item = item + 1;
            }
            var actions = GUI.HBox.New();
            actions.SetSpacing(layout_metrics.GAP_ROW);
            section.host.AddChild(actions);
            section.addItemButton = GUI.Button.New(
                actions,
                "Add " + Shared.RepeatItemLabelFor(component));
            section.removeItemButton = GUI.Button.New(
                actions, "Remove Last");
        } else {
            section.form.Build(section.host, component.fields, "", -1);
        }
        sections.add(section);
    }

    // ---- values -----------------------------------------------------------

    hide func ValuesFor(
        form: scene_component_form.SceneComponentForm,
        scene: SceneDocument) -> List[String] {
        var values: List[String] = [];
        var keys = form.KeysNeeded();
        var index = 0;
        while index < keys.count() {
            values.add(PropertyValueText(scene, keys.get(index)));
            index = index + 1;
        }
        return values;
    }

    hide func PropertyValueText(scene: SceneDocument,
                                key: String) -> String {
        if scene == null or scene.Has(key) == false { return ""; }
        var kind = scene.PropertyKind(key);
        if kind == "string" { return scene.GetStr(key, ""); }
        if kind == "int" { return Fmt.Int(scene.GetInt(key, 0)); }
        if kind == "float" { return Fmt.Num(scene.GetFloat(key, 0.0)); }
        if kind == "bool" { return Fmt.Bool(scene.GetBool(key, false)); }
        return "";
    }

    hide func RepeatCount(
        component: FormsModel.SceneSettingsComponent,
        scene: SceneDocument) -> Integer {
        if scene == null or component.repeat.IsActive() == false {
            return 0;
        }
        var count = scene.GetInt(component.repeat.countKey, 0);
        if count < 0 { return 0; }
        if count > component.repeat.maximum {
            return component.repeat.maximum;
        }
        return count;
    }

    hide func SchemaStamp(
        schema: SceneComponentModel.SceneComponentSchema,
        scene: SceneDocument) -> String {
        if schema == null { return "none"; }
        var stamp = schema.sourcePath + "#" + schema.version + "#"
            + schema.sceneSettings.count();
        var index = 0;
        while index < schema.sceneSettings.count() {
            var component = schema.sceneSettings.get(index);
            if component != null and component.repeat.IsActive() {
                stamp = stamp + "/" + component.name + ":"
                    + RepeatCount(component, scene);
            }
            index = index + 1;
        }
        return stamp;
    }
}
