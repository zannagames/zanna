/// @brief Return whether a handle names one single-axis transform.
func IsGizmoAxis(handle: Integer) -> Boolean {
    return handle == GIZMO_AXIS_X
        or handle == GIZMO_AXIS_Y
        or handle == GIZMO_AXIS_Z;
}

/// @brief Return whether a handle names one two-axis transform plane.
func IsGizmoPlane(handle: Integer) -> Boolean {
    return handle == GIZMO_PLANE_XY
        or handle == GIZMO_PLANE_XZ
        or handle == GIZMO_PLANE_YZ;
}

/// @brief Return the first conventional axis in one plane handle.
func GizmoPlaneAxisA(plane: Integer) -> Integer {
    if plane == GIZMO_PLANE_YZ { return GIZMO_AXIS_Y; }
    return GIZMO_AXIS_X;
}

/// @brief Return the second conventional axis in one plane handle.
func GizmoPlaneAxisB(plane: Integer) -> Integer {
    if plane == GIZMO_PLANE_XY { return GIZMO_AXIS_Y; }
    return GIZMO_AXIS_Z;
}

/// @brief Return the first oriented basis axis for one rotation ring.
/// @details The ordered pairs follow positive right-handed rotation:
///          X rotates Y toward Z, Y rotates Z toward X, Z rotates X toward Y.
func GizmoRingAxisA(axis: Integer) -> Integer {
    if axis == GIZMO_AXIS_X { return GIZMO_AXIS_Y; }
    if axis == GIZMO_AXIS_Y { return GIZMO_AXIS_Z; }
    return GIZMO_AXIS_X;
}

/// @brief Return the second oriented basis axis for one rotation ring.
func GizmoRingAxisB(axis: Integer) -> Integer {
    if axis == GIZMO_AXIS_X { return GIZMO_AXIS_Z; }
    if axis == GIZMO_AXIS_Y { return GIZMO_AXIS_X; }
    return GIZMO_AXIS_Y;
}

/// @brief Read one Cartesian component from a runtime vector.
func GizmoAxisValue(value: Vec3,
                    axis: Integer) -> Number {
    if value == null { return 0.0; }
    if axis == GIZMO_AXIS_X { return value.X; }
    if axis == GIZMO_AXIS_Y { return value.Y; }
    return value.Z;
}

/// @brief Clamp one Number used by persisted scene workspace geometry.
func ClampNumber3D(value: Number, minimum: Number, maximum: Number) -> Number {
    if value < minimum { return minimum; }
    if value > maximum { return maximum; }
    return value;
}

/// @brief Keep long orbit sessions numerically stable and easy to persist.
func NormalizeYawDegrees(value: Integer) -> Integer {
    var normalized = value;
    while normalized > 180 { normalized = normalized - 360; }
    while normalized < -180 { normalized = normalized + 360; }
    return normalized;
}

/// @brief Squared pointer distance to a finite projected line segment.
/// @details Pure geometry keeps gizmo hit testing deterministic and probeable.
expose func DistanceSquaredToSegment(pointerX: Number,
                                     pointerY: Number,
                                     startX: Number,
                                     startY: Number,
                                     endX: Number,
                                     endY: Number) -> Number {
    var segmentX = endX - startX;
    var segmentY = endY - startY;
    var lengthSquared = segmentX * segmentX + segmentY * segmentY;
    if lengthSquared <= 0.000001 {
        var pointX = pointerX - startX;
        var pointY = pointerY - startY;
        return pointX * pointX + pointY * pointY;
    }
    var projection = ((pointerX - startX) * segmentX
                      + (pointerY - startY) * segmentY)
        / lengthSquared;
    if projection < 0.0 { projection = 0.0; }
    if projection > 1.0 { projection = 1.0; }
    var nearestX = startX + projection * segmentX;
    var nearestY = startY + projection * segmentY;
    var deltaX = pointerX - nearestX;
    var deltaY = pointerY - nearestY;
    return deltaX * deltaX + deltaY * deltaY;
}

/// @brief Pick the nearest projected translation axis within a pixel radius.
expose func ClosestGizmoAxis(pointerX: Number,
                             pointerY: Number,
                             originX: Number,
                             originY: Number,
                             axisXX: Number,
                             axisXY: Number,
                             axisYX: Number,
                             axisYY: Number,
                             axisZX: Number,
                             axisZY: Number,
                             radius: Number) -> Integer {
    var threshold = radius * radius;
    var centerX = pointerX - originX;
    var centerY = pointerY - originY;
    if centerX * centerX + centerY * centerY <= threshold {
        return GIZMO_AXIS_NONE;
    }
    var bestDistance = threshold;
    var best = GIZMO_AXIS_NONE;
    var distance = DistanceSquaredToSegment(
        pointerX, pointerY, originX, originY, axisXX, axisXY);
    if distance <= bestDistance {
        bestDistance = distance;
        best = GIZMO_AXIS_X;
    }
    distance = DistanceSquaredToSegment(
        pointerX, pointerY, originX, originY, axisYX, axisYY);
    if distance < bestDistance {
        bestDistance = distance;
        best = GIZMO_AXIS_Y;
    }
    distance = DistanceSquaredToSegment(
        pointerX, pointerY, originX, originY, axisZX, axisZY);
    if distance < bestDistance {
        best = GIZMO_AXIS_Z;
    }
    return best;
}

/// @brief Return whether a pointer lies inside one projected plane handle.
func GizmoPlaneContains(pointerX: Number,
                        pointerY: Number,
                        originX: Number,
                        originY: Number,
                        axisAX: Number,
                        axisAY: Number,
                        axisBX: Number,
                        axisBY: Number) -> Boolean {
    var vectorAX = axisAX - originX;
    var vectorAY = axisAY - originY;
    var vectorBX = axisBX - originX;
    var vectorBY = axisBY - originY;
    if scene_transform_3d.PlaneProjectionIsUsable(
           vectorAX, vectorAY, vectorBX, vectorBY) == false {
        return false;
    }
    var relativeX = pointerX - originX;
    var relativeY = pointerY - originY;
    var determinant =
        vectorAX * vectorBY - vectorAY * vectorBX;
    var fractionA =
        (relativeX * vectorBY - relativeY * vectorBX) / determinant;
    var fractionB =
        (vectorAX * relativeY - vectorAY * relativeX) / determinant;
    return fractionA >= GIZMO_PLANE_INNER_FRACTION
        and fractionA <= GIZMO_PLANE_OUTER_FRACTION
        and fractionB >= GIZMO_PLANE_INNER_FRACTION
        and fractionB <= GIZMO_PLANE_OUTER_FRACTION;
}

/// @brief Squared projected area used to prefer the most face-on overlap.
func GizmoPlaneAreaSquared(originX: Number,
                           originY: Number,
                           axisAX: Number,
                           axisAY: Number,
                           axisBX: Number,
                           axisBY: Number) -> Number {
    var vectorAX = axisAX - originX;
    var vectorAY = axisAY - originY;
    var vectorBX = axisBX - originX;
    var vectorBY = axisBY - originY;
    var determinant =
        vectorAX * vectorBY - vectorAY * vectorBX;
    return determinant * determinant;
}

/// @brief Pick the most face-on projected XY, XZ, or YZ transform plane.
/// @details Axis-line picking runs only after this function so an intentional
///          click inside a visible plane cannot be stolen by its border axes.
expose func ClosestGizmoPlane(pointerX: Number,
                              pointerY: Number,
                              originX: Number,
                              originY: Number,
                              axisXX: Number,
                              axisXY: Number,
                              axisYX: Number,
                              axisYY: Number,
                              axisZX: Number,
                              axisZY: Number) -> Integer {
    var best = GIZMO_AXIS_NONE;
    var bestArea = 0.0;
    if GizmoPlaneContains(
           pointerX, pointerY, originX, originY,
           axisXX, axisXY, axisYX, axisYY) {
        best = GIZMO_PLANE_XY;
        bestArea = GizmoPlaneAreaSquared(
            originX, originY, axisXX, axisXY, axisYX, axisYY);
    }
    if GizmoPlaneContains(
           pointerX, pointerY, originX, originY,
           axisXX, axisXY, axisZX, axisZY) {
        var area = GizmoPlaneAreaSquared(
            originX, originY, axisXX, axisXY, axisZX, axisZY);
        if area > bestArea {
            best = GIZMO_PLANE_XZ;
            bestArea = area;
        }
    }
    if GizmoPlaneContains(
           pointerX, pointerY, originX, originY,
           axisYX, axisYY, axisZX, axisZY) {
        var area = GizmoPlaneAreaSquared(
            originX, originY, axisYX, axisYY, axisZX, axisZY);
        if area > bestArea {
            best = GIZMO_PLANE_YZ;
        }
    }
    return best;
}

/// @brief Squared pointer distance to a sampled projected rotation ellipse.
/// @details Sampling the same 32-segment ellipse used for drawing keeps hit
///          testing stable without assuming that the projection is circular.
func DistanceSquaredToGizmoRotationRing(
    pointerX: Number,
    pointerY: Number,
    originX: Number,
    originY: Number,
    axisAX: Number,
    axisAY: Number,
    axisBX: Number,
    axisBY: Number) -> Number {
    var vectorAX = axisAX - originX;
    var vectorAY = axisAY - originY;
    var vectorBX = axisBX - originX;
    var vectorBY = axisBY - originY;
    if scene_transform_3d.PlaneProjectionIsUsable(
           vectorAX, vectorAY, vectorBX, vectorBY) == false {
        return GIZMO_RING_INVALID_DISTANCE;
    }
    var previousX = originX + vectorAX;
    var previousY = originY + vectorAY;
    var best = GIZMO_RING_INVALID_DISTANCE;
    var segment = 1;
    while segment <= GIZMO_RING_SEGMENTS {
        var angle = segment * GIZMO_RING_STEP_RADIANS;
        var cosine = Math.Cos(angle);
        var sine = Math.Sin(angle);
        var currentX =
            originX + vectorAX * cosine + vectorBX * sine;
        var currentY =
            originY + vectorAY * cosine + vectorBY * sine;
        var distance = DistanceSquaredToSegment(
            pointerX, pointerY,
            previousX, previousY, currentX, currentY);
        if distance < best { best = distance; }
        previousX = currentX;
        previousY = currentY;
        segment = segment + 1;
    }
    return best;
}

/// @brief Pick the nearest stable projected X, Y, or Z rotation ring.
/// @details Ring planes use the right-handed basis order shared by angular
///          decoding. Exact ties remain deterministic in X/Y/Z order.
expose func ClosestGizmoRotationRing(
    pointerX: Number,
    pointerY: Number,
    originX: Number,
    originY: Number,
    axisXX: Number,
    axisXY: Number,
    axisYX: Number,
    axisYY: Number,
    axisZX: Number,
    axisZY: Number,
    radius: Number) -> Integer {
    var threshold = radius * radius;
    var bestDistance = threshold;
    var best = GIZMO_AXIS_NONE;
    var distance = DistanceSquaredToGizmoRotationRing(
        pointerX, pointerY, originX, originY,
        axisYX, axisYY, axisZX, axisZY);
    if distance <= bestDistance {
        bestDistance = distance;
        best = GIZMO_AXIS_X;
    }
    distance = DistanceSquaredToGizmoRotationRing(
        pointerX, pointerY, originX, originY,
        axisZX, axisZY, axisXX, axisXY);
    if distance < bestDistance {
        bestDistance = distance;
        best = GIZMO_AXIS_Y;
    }
    distance = DistanceSquaredToGizmoRotationRing(
        pointerX, pointerY, originX, originY,
        axisXX, axisXY, axisYX, axisYY);
    if distance < bestDistance {
        best = GIZMO_AXIS_Z;
    }
    return best;
}

/// @brief Return whether a 3D scene width needs master/detail presentation.
expose func UsesCompactLayout(width: Number) -> Boolean {
    return width > 0.0 and width <= COMPACT_SCENE_3D_WIDTH;
}

/// @brief Return whether 3D toolbar labels need their narrowest presentation.
expose func UsesCompactChrome(width: Number) -> Boolean {
    return width > 0.0 and width <= COMPACT_SCENE_3D_CHROME_WIDTH;
}

/// @brief Return whether complete secondary command sets belong in menus.
/// @details Progressive disclosure is width-independent: growing a scene lane
///          gives the authored viewport more room instead of exposing every
///          secondary action at once. Zero denotes an unmeasured host.
expose func UsesSceneCommandMenus(width: Number) -> Boolean {
    return width > 0.0;
}

/// @brief Return whether the hierarchy may remain docked beside viewport detail.
/// @details Ordinary laptop-width scene lanes prioritize a readable viewport
///          and inspector; the hierarchy stays available through the
///          Hierarchy master action until all three columns have useful width.
expose func UsesDockedHierarchy(width: Number) -> Boolean {
    return width >= HIERARCHY_PANE_MIN_WIDTH;
}

/// @brief One projected viewport coordinate.
class ProjectedPoint {
    expose Integer x;
    expose Integer y;
    expose Boolean visible;

    expose func init() {
        x = 0;
        y = 0;
        visible = true;
    }
}

/// @brief One node subtree's screen-projected world-bounds rectangle.
class ScreenBounds3D {
    expose Integer minX;
    expose Integer minY;
    expose Integer maxX;
    expose Integer maxY;
    expose Boolean visible;

    expose func init() {
        minX = 0;
        minY = 0;
        maxX = 0;
        maxY = 0;
        visible = false;
    }
}

/// @brief One node subtree's axis-aligned bounds in world space.
class WorldBounds3D {
    expose Number minX;
    expose Number minY;
    expose Number minZ;
    expose Number maxX;
    expose Number maxY;
    expose Number maxZ;
    expose Boolean valid;

    expose func init() {
        minX = 0.0;
        minY = 0.0;
        minZ = 0.0;
        maxX = 0.0;
        maxY = 0.0;
        maxZ = 0.0;
        valid = false;
    }
}

/// @brief One selected root's vertical placement result.
class SurfacePlacement3D {
    expose Boolean hit;
    expose Number surfaceY;
    expose Vec3 normal;

    expose func init() {
        hit = false;
        surfaceY = 0.0;
        normal = Vec3.New(0.0, 1.0, 0.0);
    }
}

/// @brief One bounded source or target point for a vertex-snap gesture.
class VertexSnapPoint3D {
    expose Boolean valid;
    expose Boolean clipped;
    expose Integer kind;
    expose Vec3 world;
    expose Integer screenX;
    expose Integer screenY;
    expose Integer distanceSquared;
    expose Integer ownerIndex;
    expose Integer vertexIndex;
    expose String label;

    expose func init() {
        valid = false;
        clipped = false;
        kind = VERTEX_SNAP_KIND_NONE;
        world = Vec3.New(0.0, 0.0, 0.0);
        screenX = 0;
        screenY = 0;
        distanceSquared = 1000000000;
        ownerIndex = -1;
        vertexIndex = -1;
        label = "";
    }
}

/// @brief One precise hit on the currently selected canonical terrain.
class TerrainPointerHit3D {
    expose Boolean valid;
    expose Number localX;
    expose Number localY;
    expose Number localZ;

    expose func init() {
        valid = false;
        localX = 0.0;
        localY = 0.0;
        localZ = 0.0;
    }
}

/// @brief Resolved, validated runtime-water geometry for one scene root.
class ProjectWaterPreviewState {
    expose Boolean valid;
    expose Number width;
    expose Number depth;
    expose Number x;
    expose Number y;
    expose Number z;

    expose func init() {
        valid = false;
        width = 1.0;
        depth = 1.0;
        x = 0.0;
        y = 0.0;
        z = 0.0;
    }
}

/// @brief Fully validated viewport atmosphere resolved from scene metadata.
class ScenePreview3DRenderState {
    expose Boolean hasCameraFov;
    expose Number cameraFov;
    expose Boolean hasIblIntensity;
    expose Number iblIntensity;
    expose Boolean hasAmbient;
    expose Number ambientR;
    expose Number ambientG;
    expose Number ambientB;
    expose Boolean hasClear;
    expose Number clearR;
    expose Number clearG;
    expose Number clearB;
    expose Boolean hasFog;
    expose Number fogR;
    expose Number fogG;
    expose Number fogB;
    expose Number fogNear;
    expose Number fogFar;
    expose Boolean hasSky;
    expose Number zenithR;
    expose Number zenithG;
    expose Number zenithB;
    expose Number groundR;
    expose Number groundG;
    expose Number groundB;
    expose Number cloudDensity;
    expose Boolean stars;
    expose Boolean hasSun;
    expose Number sunX;
    expose Number sunY;
    expose Number sunZ;
    expose Number sunR;
    expose Number sunG;
    expose Number sunB;
    expose Number sunIntensity;
    expose Boolean hasFill;
    expose Number fillX;
    expose Number fillY;
    expose Number fillZ;
    expose Number fillR;
    expose Number fillG;
    expose Number fillB;
    expose Number fillIntensity;
    expose Boolean hasHeightFog;
    expose Boolean heightFogEnabled;
    expose Number heightFogBase;
    expose Number heightFogFalloff;
    expose Number heightFogDensity;
    expose Number heightFogOpacity;

    expose func init() {
        hasCameraFov = false;
        cameraFov = VIEWPORT_FOV_DEGREES;
        hasIblIntensity = false;
        iblIntensity = 0.0;
        hasAmbient = false;
        ambientR = 0.0;
        ambientG = 0.0;
        ambientB = 0.0;
        hasClear = false;
        clearR = 0.0;
        clearG = 0.0;
        clearB = 0.0;
        hasFog = false;
        fogR = 0.0;
        fogG = 0.0;
        fogB = 0.0;
        fogNear = 0.0;
        fogFar = 1.0;
        hasSky = false;
        zenithR = 0.0;
        zenithG = 0.0;
        zenithB = 0.0;
        groundR = 0.0;
        groundG = 0.0;
        groundB = 0.0;
        cloudDensity = 0.0;
        stars = false;
        hasSun = false;
        sunX = 0.0;
        sunY = -1.0;
        sunZ = 0.0;
        sunR = 1.0;
        sunG = 1.0;
        sunB = 1.0;
        sunIntensity = 0.0;
        hasFill = false;
        fillX = 0.0;
        fillY = -1.0;
        fillZ = 0.0;
        fillR = 1.0;
        fillG = 1.0;
        fillB = 1.0;
        fillIntensity = 0.0;
        hasHeightFog = false;
        heightFogEnabled = false;
        heightFogBase = 0.0;
        heightFogFalloff = 0.0;
        heightFogDensity = 0.0;
        heightFogOpacity = 0.0;
    }
}



/// @brief Clamp one integer without platform-specific math helpers.
func ClampInt3D(value: Integer,
                minimum: Integer,
                maximum: Integer) -> Integer {
    if value < minimum { return minimum; }
    if value > maximum { return maximum; }
    return value;
}
