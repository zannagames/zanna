    /// @brief Return whether Search currently uses its narrow control treatment.
    expose override func IsSearchControlsCompact() -> Boolean {
        return compactSearchControls;
    }

    /// @brief Reflow Search controls without replacing their live widget state.
    /// @details Flex rows wrap from the preferred bases below. Compact copy and
    ///          smaller action widths keep query/replace actions on one line at
    ///          normal side-dock widths, while filters wrap into full-width rows
    ///          instead of overflowing at the minimum supported window size.
    hide override func ApplyResponsiveSearchControls() {
        if searchPanel == null or searchQueryInput == null { return; }
        var width = searchPanel.GetLogicalWidth();
        if width <= 0.0 and panelRoot != null {
            width = panelRoot.GetLogicalWidth();
        }
        if width <= 0.0 { return; }

        var compact = ToolPanelModel.SearchUsesCompactControls(width);
        if compact == compactSearchControls { return; }
        compactSearchControls = compact;
        if compactSearchControls {
            searchQueryInput.SetPreferredSize(104.0, 0.0);
            searchReplaceInput.SetPreferredSize(112.0, 0.0);
            searchKindsInput.SetPreferredSize(112.0, 0.0);
            searchIncludeInput.SetPreferredSize(112.0, 0.0);
            searchExcludeInput.SetPreferredSize(112.0, 0.0);

            searchRunButton.SetText("Go");
            searchRunButton.SetMinSize(44.0, 0.0);
            searchRunButton.SetPreferredSize(44.0, 0.0);
            searchCancelButton.SetText("Stop");
            searchCancelButton.SetMinSize(52.0, 0.0);
            searchCancelButton.SetPreferredSize(52.0, 0.0);
            searchReplaceButton.SetText("All");
            searchReplaceButton.SetMinSize(64.0, 0.0);
            searchReplaceButton.SetPreferredSize(64.0, 0.0);
        } else {
            searchQueryInput.SetPreferredSize(240.0, 0.0);
            searchReplaceInput.SetPreferredSize(240.0, 0.0);
            searchKindsInput.SetPreferredSize(180.0, 0.0);
            searchIncludeInput.SetPreferredSize(240.0, 0.0);
            searchExcludeInput.SetPreferredSize(240.0, 0.0);

            searchRunButton.SetText("Search");
            searchRunButton.SetPreferredSize(0.0, 0.0);
            searchRunButton.SetMinSize(60.0, 0.0);
            searchCancelButton.SetText("Stop");
            searchCancelButton.SetPreferredSize(0.0, 0.0);
            searchCancelButton.SetMinSize(60.0, 0.0);
            searchReplaceButton.SetText("Replace All");
            searchReplaceButton.SetPreferredSize(0.0, 0.0);
            searchReplaceButton.SetMinSize(60.0, 0.0);
        }
    }

    /// @brief Return whether Terminal currently uses wrapping equal-width actions.
    expose override func IsTerminalActionsCompact() -> Boolean {
        return compactTerminalActions;
    }

    /// @brief Keep every Terminal session action inside narrow side docks.
    /// @details Compact actions retain descriptive text and tooltips. Flex growth
    ///          produces two balanced rows at the minimum dock width, while a
    ///          roomy dock restores natural button widths on a single row.
    hide override func ApplyResponsiveTerminalActions() {
        if terminalPanel == null or terminalActionRow == null
           or terminalKill == null {
            return;
        }
        var width = terminalPanel.GetLogicalWidth();
        if width <= 0.0 and panelRoot != null {
            width = panelRoot.GetLogicalWidth();
        }
        if width <= 0.0 { return; }

        var compact = ToolPanelModel.TerminalUsesCompactActions(width);
        if compact == compactTerminalActions { return; }
        compactTerminalActions = compact;
        if compactTerminalActions {
            terminalKill.SetFlex(1.0);
            terminalRestart.SetFlex(1.0);
            terminalNew.SetFlex(1.0);
            terminalNext.SetFlex(1.0);
            terminalKill.SetMinSize(60.0, 0.0);
            terminalRestart.SetMinSize(76.0, 0.0);
            terminalNew.SetMinSize(60.0, 0.0);
            terminalNext.SetMinSize(60.0, 0.0);
            terminalKill.SetPreferredSize(60.0, 0.0);
            terminalRestart.SetPreferredSize(76.0, 0.0);
            terminalNew.SetPreferredSize(60.0, 0.0);
            terminalNext.SetPreferredSize(60.0, 0.0);
        } else {
            terminalKill.SetFlex(0.0);
            terminalRestart.SetFlex(0.0);
            terminalNew.SetFlex(0.0);
            terminalNext.SetFlex(0.0);
            terminalKill.SetPreferredSize(0.0, 0.0);
            terminalRestart.SetPreferredSize(0.0, 0.0);
            terminalNew.SetPreferredSize(0.0, 0.0);
            terminalNext.SetPreferredSize(0.0, 0.0);
            terminalKill.SetMinSize(60.0, 0.0);
            terminalRestart.SetMinSize(60.0, 0.0);
            terminalNew.SetMinSize(60.0, 0.0);
            terminalNext.SetMinSize(60.0, 0.0);
        }
    }

    /// @brief Return whether Variables uses compact watch controls.
    expose override func IsWatchToolbarCompact() -> Boolean {
        return compactWatchToolbar;
    }

    /// @brief Keep watch entry and actions within narrow side docks.
    /// @details The Flex row wraps as one stable widget tree. Compact bases
    ///          preserve a useful Variables list below the controls without
    ///          replacing the user's in-progress expression or keyboard focus.
    hide override func ApplyResponsiveWatchToolbar() {
        if variablesPanel == null or watchToolbar == null
           or watchExpressionInput == null {
            return;
        }
        var width = variablesPanel.GetLogicalWidth();
        if width <= 0.0 and panelRoot != null {
            width = panelRoot.GetLogicalWidth();
        }
        if app != null {
            var uiScale = app.GetUiScale();
            if uiScale > 0.0 { width = width / uiScale; }
        }
        if width <= 0.0 { return; }

        var compact = ToolPanelModel.WatchToolbarUsesCompactActions(width);
        if compact == compactWatchToolbar { return; }
        compactWatchToolbar = compact;
        if compactWatchToolbar {
            watchToolbar.SetPreferredSize(0.0, 60.0);
            watchExpressionInput.SetMinSize(60.0, 0.0);
            watchExpressionInput.SetPreferredSize(72.0, 0.0);
            watchAddButton.SetText("+");
            watchRemoveButton.SetText("−");
            watchRefreshButton.SetText("↻");
            watchClearButton.SetText("×");
            watchAddButton.SetPreferredSize(36.0, 0.0);
            watchRemoveButton.SetPreferredSize(36.0, 0.0);
            watchRefreshButton.SetPreferredSize(36.0, 0.0);
            watchClearButton.SetPreferredSize(36.0, 0.0);
        } else {
            // Flex wrap resolves its cross-axis extent before the parent width
            // is final. Reserve a second row so late fractional layout cannot
            // place the final action over the Variables list.
            watchToolbar.SetPreferredSize(0.0, 60.0);
            watchExpressionInput.SetMinSize(120.0, 0.0);
            watchExpressionInput.SetPreferredSize(160.0, 0.0);
            watchAddButton.SetText("Add");
            watchRemoveButton.SetText("Remove");
            watchRefreshButton.SetText("Refresh");
            watchClearButton.SetText("Clear");
            watchAddButton.SetPreferredSize(48.0, 0.0);
            watchRemoveButton.SetPreferredSize(64.0, 0.0);
            watchRefreshButton.SetPreferredSize(64.0, 0.0);
            watchClearButton.SetPreferredSize(52.0, 0.0);
        }
        var actionMin = 36.0;
        if compactWatchToolbar == false { actionMin = 48.0; }
        watchAddButton.SetMinSize(actionMin, 0.0);
        watchRemoveButton.SetMinSize(actionMin, 0.0);
        watchRefreshButton.SetMinSize(actionMin, 0.0);
        watchClearButton.SetMinSize(actionMin, 0.0);
    }
}
