    /// @brief Initialize one cohesive segment of retained 2D editor state.
    hide func InitializeGestureState() {        cleanSerialized = "";
        lastPaintX = -1;
        lastPaintY = -1;
        layerVisibleRevision = 0;
        renderDirty = true;
        fitPending = false;
        initialFramePending = false;
        paintStrokeActive = false;
        paintStrokeChanged = false;
        paintStrokeSnapshot = "";
        tileRectangleTile = 0;
        objectDragActive = false;
        objectDragChanged = false;
        objectDragSnapshot = "";
        objectDragIndex = -1;
        objectDragLastX = 0;
        objectDragLastY = 0;
