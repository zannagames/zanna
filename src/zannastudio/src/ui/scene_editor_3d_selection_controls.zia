bind "../core/document";
bind "../core/project_manager";
bind "../services/file_utils";
bind "../services/material_library_3d";
bind "../services/project_locator";
bind "../services/safe_io";
bind "scene_asset_browser";
bind "scene_bake_3d";
bind "scene_camera_3d";
bind "scene_camera_inspector_3d";
bind "scene_clipboard";
bind "scene_collider_3d";
bind "scene_collider_inspector_3d";
bind "scene_component_authoring_controller";
bind "scene_component_palette";
bind "scene_component_schema";
bind "scene_hierarchy_search";
bind "scene_hierarchy_3d";
bind "scene_history";
bind "scene_selection";
bind "scene_light_inspector_3d";
bind "scene_light_3d";
bind "scene_material_inspector_3d";
bind "scene_material_3d";
bind "scene_metadata_inspector_3d";
bind "scene_pane_docking";
bind "scene_terrain_3d";
bind "scene_terrain_inspector_3d";
bind "scene_transform_3d";
bind Zanna.GUI as GUI;
bind SceneGraph = Zanna.Graphics3D.SceneGraph;
bind SceneNode = Zanna.Graphics3D.SceneNode;
bind SceneAsset = Zanna.Graphics3D.SceneAsset;
bind Mesh3D = Zanna.Graphics3D.Mesh3D;
bind Material3D = Zanna.Graphics3D.Material3D;
bind Light3D = Zanna.Graphics3D.Light3D;
bind Canvas3D = Zanna.Graphics3D.Canvas3D;
bind RenderTarget3D = Zanna.Graphics3D.RenderTarget3D;
bind Camera3D = Zanna.Graphics3D.Camera3D;
bind PostFX3D = Zanna.Graphics3D.PostFX3D;
bind LightBaker3D = Zanna.Graphics3D.LightBaker3D;
bind LightProbeGrid3D = Zanna.Graphics3D.LightProbeGrid3D;
bind CubeMap3D = Zanna.Graphics3D.CubeMap3D;
bind Water3D = Zanna.Graphics3D.Water3D;
bind Mesh3D2 = Zanna.Graphics3D.Mesh3D;
bind Pixels = Zanna.Graphics.Pixels;
bind Color = Zanna.Graphics.Color;
bind Vec3 = Zanna.Math.Vec3;
bind Quat = Zanna.Math.Quat;
bind Mat4 = Zanna.Math.Mat4;
bind RayHit3D = Zanna.Graphics3D.RayHit3D;
bind Seq = Zanna.Collections.Seq;
