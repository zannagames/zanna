/// @brief One validated typed field in a project scene-component template.
class SceneComponentField {
    expose String key;
    expose String label;
    expose String kind;
    expose String defaultText;
    expose String description;
    expose List[String] choices;
    expose List[String] choiceLabels;
    expose String storedKind;
    expose List[String] assetKinds;

    expose func init() {
        key = "";
        label = "";
        kind = "";
        defaultText = "";
        description = "";
        choices = [];
        choiceLabels = [];
        storedKind = "";
        assetKinds = [];
    }

    /// @brief Return whether one exact value is a declared enum choice.
    expose func HasChoice(value: String) -> Boolean {
        var index = 0;
        while index < choices.count() {
            if choices.get(index) == value { return true; }
            index = index + 1;
        }
        return false;
    }
}

/// @brief One named project template applicable to 2D objects, 3D nodes, or both.
class SceneComponentDefinition {
    expose String name;
    expose String label;
    expose String target;
    expose String description;
    expose String createObjectType;
    expose String createNodeName;
    expose List[SceneComponentField] fields;

    expose func init() {
        name = "";
        label = "";
        target = "";
        description = "";
        createObjectType = "";
        createNodeName = "";
        fields = [];
    }

    /// @brief Return whether this definition may be applied to one editor target.
    expose func SupportsTarget(requested: String) -> Boolean {
        return target == TARGET_BOTH or target == requested;
    }

    /// @brief Return whether this template can create content in one editor.
    expose func CanCreateFor(requested: String) -> Boolean {
        if SupportsTarget(requested) == false { return false; }
        if requested == TARGET_2D_OBJECT {
            return createObjectType != "";
        }
        if requested == TARGET_3D_NODE {
            return createNodeName != "";
        }
        return false;
    }

    /// @brief Find one exact field key, or null when absent.
    expose func FieldNamed(key: String) -> SceneComponentField {
        var index = 0;
        while index < fields.count() {
            var field = fields.get(index);
            if field != null and field.key == key { return field; }
            index = index + 1;
        }
        return null;
    }
}

/// @brief One deterministic project-owned 2D object visualization rule.
class SceneObjectPreviewDefinition {
    expose String objectType;
    expose String sprite;
    expose Integer frame;
    expose String frameProperty;
    expose Integer frameOffset;
    expose List[Integer] frameMap;
    expose Integer drawOrder;
    expose Integer afterLayer;

    expose func init() {
        objectType = "";
        sprite = "";
        frame = 0;
        frameProperty = "";
        frameOffset = 0;
        frameMap = [];
        drawOrder = 0;
        // SceneDocument supports at most sixteen layers. Fifteen therefore
        // means "after the final layer" for every smaller scene as well.
        afterLayer = MAX_PREVIEW_AFTER_LAYER;
    }

    /// @brief Resolve one property value to a bounded atlas frame.
    /// @details Negative, unmapped, or overflowing values use the authored
    ///          fallback frame instead of producing an invalid image lookup.
    expose func FrameForValue(value: Integer) -> Integer {
        if value < 0 { return frame; }
        if frameMap.count() > 0 {
            if value >= frameMap.count() { return frame; }
            return frameMap.get(value);
        }
        var resolved = value + frameOffset;
        if resolved < 0 or resolved > MAX_PREVIEW_FRAME {
            return frame;
        }
        return resolved;
    }
}

/// @brief One bounded project-owned gameplay-like 2D scene backdrop profile.
/// @details Images resolve beside the project schema, not beside scene files.
///          Integer variants are read-only editor presentation conventions.
class ScenePreview2DDefinition {
    expose Boolean present;
    expose Boolean hasOutputSize;
    expose Integer outputWidth;
    expose Integer outputHeight;
    expose String background;
    expose String variantProperty;
    expose Integer variantOffset;
    expose List[String] variantImages;
    expose String fit;
    expose Boolean hasShowGrid;
    expose Boolean showGrid;

    expose func init() {
        present = false;
        hasOutputSize = false;
        outputWidth = 0;
        outputHeight = 0;
        background = "";
        variantProperty = "";
        variantOffset = 0;
        variantImages = [];
        fit = BACKGROUND_FIT_COVER;
        hasShowGrid = false;
        showGrid = false;
    }

    /// @brief Return whether Game View owns an exact project output frame.
    expose func HasOutputSize() -> Boolean {
        return hasOutputSize and outputWidth > 0 and outputHeight > 0;
    }

    /// @brief Resolve one integer variant or the optional fallback image.
    expose func BackgroundForVariant(value: Integer) -> String {
        var index = value + variantOffset;
        if index >= 0 and index < variantImages.count() {
            return variantImages.get(index);
        }
        return background;
    }
}

/// @brief One independently matched, metadata-transformed 3D environment layer.
/// @details The record is project-owned preview data only. Studio resolves the
///          match and optional float transform properties against the canonical
///          scene root without executing project code or mutating the scene.
class SceneEnvironmentLayer3DDefinition {
    expose String matchProperty;
    expose String matchKind;
    expose Boolean matchBoolean;
    expose Integer matchInteger;
    expose String matchString;
    expose String prefab;
    expose String positionXProperty;
    expose String positionYProperty;
    expose String positionZProperty;
    expose String scaleXProperty;
    expose String scaleYProperty;
    expose String scaleZProperty;
    expose String yawProperty;
    expose String yawUnit;

    expose func init() {
        matchProperty = "";
        matchKind = "";
        matchBoolean = false;
        matchInteger = 0;
        matchString = "";
        prefab = "";
        positionXProperty = "";
        positionYProperty = "";
        positionZProperty = "";
        scaleXProperty = "";
        scaleYProperty = "";
        scaleZProperty = "";
        yawProperty = "";
        yawUnit = "";
    }
}

/// @brief One bounded Gerstner wave for a runtime-backed water preview.
class SceneWaterWave3DDefinition {
    expose Number dirX;
    expose Number dirZ;
    expose Number speed;
    expose Number amplitude;
    expose Number wavelength;

    expose func init() {
        dirX = 1.0;
        dirZ = 0.0;
        speed = 0.0;
        amplitude = 0.0;
        wavelength = 1.0;
    }
}

/// @brief One conditionally present runtime Water3D preview surface.
/// @details Static values remain useful for ordinary project scenery; optional
///          float metadata mappings replace them from the canonical scene root.
class SceneWaterLayer3DDefinition {
    expose String matchProperty;
    expose String matchKind;
    expose Boolean matchBoolean;
    expose Integer matchInteger;
    expose String matchString;
    expose Number positionX;
    expose Number positionY;
    expose Number positionZ;
