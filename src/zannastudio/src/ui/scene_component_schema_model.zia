    expose String positionYProperty;
    expose String positionZProperty;
    expose Number width;
    expose Number depth;
    expose String widthProperty;
    expose String depthProperty;
    expose Number widthMultiplier;
    expose Number depthMultiplier;
    expose Boolean hasColor;
    expose Number colorR;
    expose Number colorG;
    expose Number colorB;
    expose Number colorA;
    expose String texture;
    expose String normalMap;
    expose Integer resolution;
    expose Boolean animate;
    expose List[SceneWaterWave3DDefinition] waves;

    expose func init() {
        matchProperty = "";
        matchKind = "";
        matchBoolean = false;
        matchInteger = 0;
        matchString = "";
        positionX = 0.0;
        positionY = 0.0;
        positionZ = 0.0;
        positionXProperty = "";
        positionYProperty = "";
        positionZProperty = "";
        width = 1.0;
        depth = 1.0;
        widthProperty = "";
        depthProperty = "";
        widthMultiplier = 1.0;
        depthMultiplier = 1.0;
        hasColor = false;
        colorR = 0.1;
        colorG = 0.3;
        colorB = 0.6;
        colorA = 0.5;
        texture = "";
        normalMap = "";
        resolution = 64;
        animate = false;
        waves = [];
    }
}

/// @brief Project root-metadata mappings for a gameplay-like 3D preview.
/// @details Property groups are either complete or absent. The editor reads
///          only typed scalar metadata and never executes project code.
class ScenePreview3DDefinition {
    expose Boolean present;
    expose Boolean hasOutputSize;
    expose Integer outputWidth;
    expose Integer outputHeight;
    expose String startXProperty;
    expose String startYProperty;
    expose String startZProperty;
    expose String startYawProperty;
    expose Boolean hasStartEyeHeight;
    expose Number startEyeHeight;
    expose String ambientRProperty;
    expose String ambientGProperty;
    expose String ambientBProperty;
    expose String clearRProperty;
    expose String clearGProperty;
    expose String clearBProperty;
    expose String fogRProperty;
    expose String fogGProperty;
    expose String fogBProperty;
    expose String fogNearProperty;
    expose String fogFarProperty;
    expose String zenithRProperty;
    expose String zenithGProperty;
    expose String zenithBProperty;
    expose String groundRProperty;
    expose String groundGProperty;
    expose String groundBProperty;
    expose String cloudProperty;
    expose String starsProperty;
    expose String sunXProperty;
    expose String sunYProperty;
    expose String sunZProperty;
    expose String sunRProperty;
    expose String sunGProperty;
    expose String sunBProperty;
    expose String sunIntensityProperty;
    expose String fillXProperty;
    expose String fillYProperty;
    expose String fillZProperty;
    expose String fillRProperty;
    expose String fillGProperty;
    expose String fillBProperty;
    expose String fillIntensityProperty;
    expose Boolean hasCameraFov;
    expose Number cameraFov;
    expose Boolean hasIblIntensity;
    expose Number iblIntensity;
    expose String heightFogProperty;
    expose Boolean hasHeightFogBase;
    expose Number heightFogBase;
    expose Boolean hasHeightFogFalloff;
    expose Number heightFogFalloff;
    expose Boolean hasHeightFogDensity;
    expose Number heightFogDensity;
    expose Boolean hasHeightFogOpacity;
    expose Number heightFogOpacity;
    expose Boolean hasShowGrid;
    expose Boolean showGrid;
    expose Boolean hasShowMarkers;
    expose Boolean showMarkers;
    expose Boolean hasShowLights;
    expose Boolean showLights;
    expose Boolean hasShowCameras;
    expose Boolean showCameras;
    expose Boolean hasShowColliders;
    expose Boolean showColliders;
    expose Boolean hasShowRoutes;
    expose Boolean showRoutes;
    expose String environmentPrefab;
    expose String environmentVariantProperty;
    expose List[String] environmentVariantPrefabs;
    expose Integer environmentVariantOffset;
    expose List[SceneEnvironmentLayer3DDefinition] environmentLayers;
    expose List[SceneWaterLayer3DDefinition] waterLayers;
    expose Boolean hasTonemap;
    expose Integer tonemapMode;
    expose Number tonemapExposure;
    expose Boolean hasBloom;
    expose Number bloomThreshold;
    expose Number bloomIntensity;
    expose Integer bloomPasses;
    expose Boolean hasColorGrade;
    expose Number colorGradeBrightness;
    expose Number colorGradeContrast;
    expose Number colorGradeSaturation;
    expose Boolean hasVignette;
    expose Number vignetteRadius;
    expose Number vignetteSoftness;
    expose Boolean hasFxaa;
    expose Boolean fxaa;

    expose func init() {
        present = false;
        hasOutputSize = false;
        outputWidth = 0;
        outputHeight = 0;
        startXProperty = "";
        startYProperty = "";
        startZProperty = "";
        startYawProperty = "";
        hasStartEyeHeight = false;
        startEyeHeight = 0.0;
        ambientRProperty = "";
        ambientGProperty = "";
        ambientBProperty = "";
        clearRProperty = "";
        clearGProperty = "";
        clearBProperty = "";
        fogRProperty = "";
        fogGProperty = "";
        fogBProperty = "";
        fogNearProperty = "";
        fogFarProperty = "";
        zenithRProperty = "";
        zenithGProperty = "";
        zenithBProperty = "";
        groundRProperty = "";
        groundGProperty = "";
        groundBProperty = "";
        cloudProperty = "";
        starsProperty = "";
        sunXProperty = "";
        sunYProperty = "";
        sunZProperty = "";
        sunRProperty = "";
        sunGProperty = "";
        sunBProperty = "";
        sunIntensityProperty = "";
        fillXProperty = "";
        fillYProperty = "";
        fillZProperty = "";
        fillRProperty = "";
        fillGProperty = "";
        fillBProperty = "";
        fillIntensityProperty = "";
        hasCameraFov = false;
        cameraFov = 60.0;
        hasIblIntensity = false;
        iblIntensity = 0.0;
        heightFogProperty = "";
        hasHeightFogBase = false;
        heightFogBase = 0.0;
        hasHeightFogFalloff = false;
        heightFogFalloff = 0.0;
        hasHeightFogDensity = false;
        heightFogDensity = 0.0;
        hasHeightFogOpacity = false;
        heightFogOpacity = 0.0;
        hasShowGrid = false;
        showGrid = false;
        hasShowMarkers = false;
        showMarkers = false;
        hasShowLights = false;
        showLights = false;
        hasShowCameras = false;
        showCameras = false;
        hasShowColliders = false;
        showColliders = false;
        hasShowRoutes = false;
        showRoutes = false;
        environmentPrefab = "";
        environmentVariantProperty = "";
        environmentVariantPrefabs = [];
        environmentVariantOffset = 0;
        environmentLayers = [];
        waterLayers = [];
        hasTonemap = false;
        tonemapMode = 0;
        tonemapExposure = 1.0;
        hasBloom = false;
        bloomThreshold = 0.8;
        bloomIntensity = 1.0;
        bloomPasses = 3;
        hasColorGrade = false;
        colorGradeBrightness = 0.0;
        colorGradeContrast = 1.0;
        colorGradeSaturation = 1.0;
        hasVignette = false;
        vignetteRadius = 0.7;
        vignetteSoftness = 0.3;
        hasFxaa = false;
        fxaa = false;
    }

    /// @brief Return whether Game View owns an exact project output frame.
    expose func HasOutputSize() -> Boolean {
        return hasOutputSize and outputWidth > 0 and outputHeight > 0;
    }

    expose func HasStart() -> Boolean {
        return startXProperty != "" and startYProperty != ""
            and startZProperty != "";
    }

    expose func HasAmbient() -> Boolean {
        return ambientRProperty != "" and ambientGProperty != ""
            and ambientBProperty != "";
    }

    expose func HasClear() -> Boolean {
        return clearRProperty != "" and clearGProperty != ""
            and clearBProperty != "";
    }

    expose func HasFog() -> Boolean {
        return fogRProperty != "" and fogGProperty != ""
            and fogBProperty != "" and fogNearProperty != ""
            and fogFarProperty != "";
    }

    expose func HasSkyPalette() -> Boolean {
        return HasClear()
            and zenithRProperty != "" and zenithGProperty != ""
            and zenithBProperty != ""
            and groundRProperty != "" and groundGProperty != ""
            and groundBProperty != "";
    }

    expose func HasSun() -> Boolean {
        return sunXProperty != "" and sunYProperty != ""
            and sunZProperty != ""
            and sunRProperty != "" and sunGProperty != ""
            and sunBProperty != "" and sunIntensityProperty != "";
    }

    expose func HasFill() -> Boolean {
        return fillXProperty != "" and fillYProperty != ""
            and fillZProperty != ""
            and fillRProperty != "" and fillGProperty != ""
            and fillBProperty != "" and fillIntensityProperty != "";
    }

    expose func HasHeightFog() -> Boolean {
        return heightFogProperty != ""
            and hasHeightFogBase
            and hasHeightFogFalloff
            and hasHeightFogDensity
            and hasHeightFogOpacity;
    }

    /// @brief Number of enabled deterministic post-processing passes.
    expose func PostFXEffectCount() -> Integer {
        var count = 0;
        if hasTonemap { count = count + 1; }
        if hasBloom { count = count + 1; }
        if hasColorGrade { count = count + 1; }
        if hasVignette { count = count + 1; }
        if hasFxaa and fxaa { count = count + 1; }
        return count;
    }

    /// @brief Return whether this profile owns any active post-processing.
    expose func HasPostFX() -> Boolean {
        return PostFXEffectCount() > 0;
    }

    /// @brief Resolve one root-metadata environment variant or its fallback.
    expose func EnvironmentPrefabForVariant(value: Integer) -> String {
        var index = value + environmentVariantOffset;
        if index >= 0 and index < environmentVariantPrefabs.count() {
            return environmentVariantPrefabs.get(index);
        }
        return environmentPrefab;
    }
}

/// @brief One metadata-matched transient 3D prefab visualization rule.
class SceneNodePreview3DDefinition {
    expose String matchProperty;
    expose String matchValue;
    expose String matchKind;
    expose Boolean matchBoolean;
    expose Integer matchInteger;
    expose String matchString;
    expose String prefab;
    expose String variantProperty;
    expose List[String] variantPrefabs;
    expose String yawProperty;
    expose String yawUnit;
    expose String scaleProperty;
    expose Number scale;
    expose Number yawDegrees;
    expose Number offsetX;
    expose Number offsetY;
    expose Number offsetZ;

    expose func init() {
        matchProperty = "";
        matchValue = "";
        matchKind = "";
        matchBoolean = false;
        matchInteger = 0;
        matchString = "";
        prefab = "";
        variantProperty = "";
        variantPrefabs = [];
        yawProperty = "";
        yawUnit = "";
        scaleProperty = "";
        scale = 1.0;
        yawDegrees = 0.0;
        offsetX = 0.0;
        offsetY = 0.0;
        offsetZ = 0.0;
    }

    /// @brief Resolve a bounded integer variant or the authored fallback.
    expose func PrefabForVariant(value: Integer) -> String {
        if value >= 0 and value < variantPrefabs.count() {
            return variantPrefabs.get(value);
        }
        return prefab;
    }
}

/// @brief One exact typed value exposed by a project node-preview filter.
class SceneNodePreviewFilterState3DDefinition {
    expose String label;
    expose String matchKind;
    expose Boolean matchBoolean;
    expose Integer matchInteger;
    expose String matchString;

    expose func init() {
        label = "";
        matchKind = "";
        matchBoolean = false;
        matchInteger = 0;
        matchString = "";
    }
}

/// @brief One project-owned session-only selector for transient node previews.
/// @details Index zero always means the explicit All option. Configured states
///          occupy indices one through N and compare exact metadata kinds.
class SceneNodePreviewFilter3DDefinition {
    expose Boolean present;
    expose String label;
    expose String allLabel;
    expose String matchProperty;
    expose Integer defaultIndex;
    expose List[SceneNodePreviewFilterState3DDefinition] states;

    expose func init() {
        present = false;
        label = "Preview";
        allLabel = "All";
        matchProperty = "";
        defaultIndex = 0;
        states = [];
    }

    expose func OptionCount() -> Integer {
        return states.count() + 1;
    }

    expose func LabelAt(index: Integer) -> String {
        if index <= 0 or index > states.count() { return allLabel; }
        return states.get(index - 1).label;
    }

    expose func StateAt(
        index: Integer) -> SceneNodePreviewFilterState3DDefinition {
        if index <= 0 or index > states.count() { return null; }
        return states.get(index - 1);
    }
}

/// @brief One typed metadata-matched, render-only PBR material overlay.
/// @details Source albedo tint and every unspecified material field survive.
///          Texture paths resolve beside the project schema, while optional
///          emissive properties resolve only against typed scene-root floats.
class SceneMaterialPreview3DDefinition {
    expose String matchProperty;
    expose String matchKind;
    expose Boolean matchBoolean;
    expose Integer matchInteger;
    expose String matchString;
    expose String albedoMap;
    expose String normalMap;
    expose String metallicRoughnessMap;
    expose String ambientOcclusionMap;
    expose String emissiveMap;
    expose Boolean hasMetallic;
    expose Number metallic;
    expose Boolean hasRoughness;
    expose Number roughness;
    expose Boolean hasAmbientOcclusion;
    expose Number ambientOcclusion;
    expose Boolean hasNormalScale;
    expose Number normalScale;
    expose Boolean hasEmissiveColor;
    expose Number emissiveR;
    expose Number emissiveG;
    expose Number emissiveB;
    expose String emissiveRProperty;
    expose String emissiveGProperty;
    expose String emissiveBProperty;
    expose Number emissiveMultiplier;
    expose Boolean hasEmissiveIntensity;
    expose Number emissiveIntensity;
    expose Boolean useProjectEnvironment;
    expose Boolean hasSsrEnabled;
    expose Boolean ssrEnabled;

    expose func init() {
        matchProperty = "";
        matchKind = "";
        matchBoolean = false;
        matchInteger = 0;
        matchString = "";
        albedoMap = "";
        normalMap = "";
        metallicRoughnessMap = "";
        ambientOcclusionMap = "";
        emissiveMap = "";
        hasMetallic = false;
        metallic = 0.0;
        hasRoughness = false;
        roughness = 0.5;
        hasAmbientOcclusion = false;
        ambientOcclusion = 1.0;
        hasNormalScale = false;
        normalScale = 1.0;
        hasEmissiveColor = false;
        emissiveR = 0.0;
        emissiveG = 0.0;
        emissiveB = 0.0;
        emissiveRProperty = "";
        emissiveGProperty = "";
        emissiveBProperty = "";
        emissiveMultiplier = 1.0;
        hasEmissiveIntensity = false;
        emissiveIntensity = 1.0;
        useProjectEnvironment = false;
        hasSsrEnabled = false;
        ssrEnabled = false;
    }

    expose func HasRootEmissive() -> Boolean {
        return emissiveRProperty != ""
            and emissiveGProperty != ""
            and emissiveBProperty != "";
    }

    expose func HasOverrides() -> Boolean {
        return albedoMap != ""
            or normalMap != ""
            or metallicRoughnessMap != ""
            or ambientOcclusionMap != ""
            or emissiveMap != ""
            or hasMetallic
            or hasRoughness
            or hasAmbientOcclusion
            or hasNormalScale
            or hasEmissiveColor
            or HasRootEmissive()
            or hasEmissiveIntensity
            or useProjectEnvironment
            or hasSsrEnabled;
    }
}

/// @brief Complete fail-closed result of loading one project schema.
class SceneComponentSchema {
    expose Boolean found;
    expose Boolean valid;
    expose String sourcePath;
    expose String error;
    expose Integer version;
    expose List[SceneComponentDefinition] components;
    expose List[SceneObjectPreviewDefinition] objectPreviews;
    expose ScenePreview2DDefinition scenePreview2D;
    expose ScenePreview3DDefinition scenePreview3D;
    expose List[SceneNodePreview3DDefinition] nodePreviews3D;
    expose SceneNodePreviewFilter3DDefinition nodePreviewFilter3D;
    expose List[SceneMaterialPreview3DDefinition] materialPreviews3D;
    expose List[FormsModel.SceneSettingsComponent] sceneSettings;

    expose func init() {
        found = false;
        valid = true;
        sourcePath = "";
        error = "";
        version = SCHEMA_VERSION;
        components = [];
        objectPreviews = [];
        scenePreview2D = new ScenePreview2DDefinition();
        scenePreview3D = new ScenePreview3DDefinition();
        nodePreviews3D = [];
        nodePreviewFilter3D =
            new SceneNodePreviewFilter3DDefinition();
        materialPreviews3D = [];
        sceneSettings = [];
    }

    /// @brief Return the declared label for one enum-choice property value.
    /// @details Scans target-compatible component fields for @p key and
    ///          returns the paired choice label when it adds information;
    ///          undeclared keys, non-choice fields, unknown values, and
    ///          label-less choices return "".
    expose func EnumChoiceLabel(requested: String,
                                key: String,
                                value: String) -> String {
        if valid == false { return ""; }
        var c = 0;
        while c < components.count() {
            var component = components.get(c);
            if component != null and component.SupportsTarget(requested) {
                var f = 0;
                while f < component.fields.count() {
                    var field = component.fields.get(f);
                    if field.key == key and field.choices.count() > 0 {
                        var i = 0;
                        while i < field.choices.count() {
                            if field.choices.get(i) == value {
                                if i < field.choiceLabels.count()
                                   and field.choiceLabels.get(i) != ""
                                   and field.choiceLabels.get(i) != value {
                                    return field.choiceLabels.get(i);
                                }
                                return "";
                            }
                            i = i + 1;
                        }
                        return "";
                    }
                    f = f + 1;
                }
            }
            c = c + 1;
        }
        return "";
    }

    /// @brief Count definitions compatible with one editor target.
    expose func CountForTarget(target: String) -> Integer {
        var count = 0;
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    /// @brief Return one compatible component by filtered index.
    expose func AtForTarget(
        target: String,
        filteredIndex: Integer) -> SceneComponentDefinition {
        if filteredIndex < 0 { return null; }
        var seen = 0;
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target) {
                if seen == filteredIndex { return component; }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find a compatible component by case-insensitive stable name.
    expose func Find(name: String,
                     target: String) -> SceneComponentDefinition {
        var folded = Str.ToLower(Str.Trim(name));
        var index = 0;
        while index < components.count() {
            var component = components.get(index);
            if component != null and component.SupportsTarget(target)
               and Str.ToLower(component.name) == folded {
                return component;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find one project preview rule by case-insensitive object type.
    expose func PreviewForObjectType(
        objectType: String) -> SceneObjectPreviewDefinition {
        var folded = Str.ToLower(Str.Trim(objectType));
        var index = 0;
        while index < objectPreviews.count() {
            var preview = objectPreviews.get(index);
            if preview != null
               and Str.ToLower(preview.objectType) == folded {
                return preview;
            }
            index = index + 1;
        }
        return null;
    }

    /// @brief Find one exact string-metadata 3D node preview rule.
    expose func NodePreview3DForMatch(
        metadataKey: String,
        metadataValue: String) -> SceneNodePreview3DDefinition {
        var index = 0;
        while index < nodePreviews3D.count() {
            var preview = nodePreviews3D.get(index);
            if preview != null
               and preview.matchProperty == metadataKey
               and preview.matchValue == metadataValue {
                return preview;
            }
            index = index + 1;
        }
        return null;
    }
}

/// @brief Return the fixed schema path beneath a workspace root.
