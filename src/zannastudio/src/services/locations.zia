//
// File: zannastudio/src/services/locations.zia
// Purpose: Store and safely resolve structured source-navigation targets.
// Key invariants:
//   - Display text is never parsed to recover a source location.
//   - A failed target open never moves the caret in an unrelated document.
//   - Search locations can retain an immutable source revision and exact line
//     context so later transformations reject stale result rows.
// Ownership/Lifetime:
//   - Callers own each LocationStore and clear it with the related result rows.
// Links: zannastudio/src/commands/file_commands.zia,
//        zannastudio/src/commands/search_commands.zia
//
//===----------------------------------------------------------------------===//

module locations;

bind "path_identity";

bind "../core/document_manager";
bind "../editor/editor_engine";
bind "../editor/editor_tabs";
bind "../commands/file_commands";
bind "../ui/app_shell";

bind Zanna.GUI;
bind Convert = Zanna.Core.Convert;
bind Str = Zanna.String;

final KIND_SEARCH = 1;
final KIND_DIAGNOSTIC = 2;
final KIND_BUILD = 3;
final KIND_DEFINITION = 4;
final KIND_REFERENCE = 5;
final KIND_SCENE = 6;
final KIND_SYMBOL = 7;

// ============================================================================
// MODULE: locations
// PURPOSE: Structured navigation targets for clickable IDE rows.
//
// WHERE-THIS-FITS: Search, Problems, References, build output, symbols, and scene
//          surfaces store location ids here. UI rows display text, but navigation
//          uses the structured record behind that row.
//
// TEACHING-NOTE: Never parse rendered row text to navigate. Add a Location kind
//          when a new panel has clickable results, then store that id on the row.
// ============================================================================

class Location {
    expose Integer id;
    expose String filePath;
    expose Integer line;
    expose Integer column;
    expose Integer endLine;
    expose Integer endColumn;
    expose Integer kind;
    expose String message;
    expose String sourceRevision;
    expose String sourceLineText;

    expose func init() {
        id = 0;
        filePath = "";
        line = 1;
        column = 1;
        endLine = 1;
        endColumn = 1;
        kind = 0;
        message = "";
        sourceRevision = "";
        sourceLineText = "";
    }
}

class LocationStore {
    expose List[Location] items;
    expose Integer nextId;

    expose func init() {
        items = [];
        nextId = 1;
    }

    expose func Clear() {
        items = [];
        nextId = 1;
    }

    /// @brief Remove targets for one file or descendant subtree only.
    /// @details IDs of unaffected locations remain stable and `nextId` remains
    ///          monotonic, so rows owned by other result sets keep resolving
    ///          without risking reuse of an invalidated id.
    /// @param path File or directory path changed by the workspace watcher.
    /// @return Number of removed locations.
    expose func InvalidatePath(path: String) -> Integer {
        if path == "" { return 0; }
        var retained: List[Location] = [];
        var removed = 0;
        var i = 0;
        while i < items.count() {
            var loc = items.get(i);
            if loc.filePath != ""
               and (path_identity.SameFile(loc.filePath, path)
                    or path_identity.IsWithinRoot(loc.filePath, path)) {
                removed = removed + 1;
            } else {
                retained.add(loc);
            }
            i = i + 1;
        }
        items = retained;
        return removed;
    }

    expose func Add(filePath: String,
                    line: Integer,
                    column: Integer,
                    endLine: Integer,
                    endColumn: Integer,
                    kind: Integer,
                    message: String) -> String {
        var loc = new Location();
        loc.id = nextId;
        loc.filePath = filePath;
        loc.line = line;
        loc.column = column;
        loc.endLine = endLine;
        loc.endColumn = endColumn;
        loc.kind = kind;
        loc.message = message;
        items.add(loc);
        nextId = nextId + 1;
        return "" + loc.id;
    }

    /// @brief Add a search result bound to the complete source snapshot scanned.
    /// @details `sourceRevision` is a content-derived revision token and
    ///          `sourceLineText` is the exact, untrimmed line. Keeping both on
    ///          the structured location prevents delayed replace commands from
    ///          treating a newly introduced match as the original result.
    expose func AddSearch(filePath: String,
                          line: Integer,
                          column: Integer,
                          endLine: Integer,
                          endColumn: Integer,
                          message: String,
                          sourceRevision: String,
                          sourceLineText: String) -> String {
        var idText = Add(filePath, line, column, endLine, endColumn,
                         KIND_SEARCH, message);
        var loc = Get(idText);
        if loc != null {
            loc!.sourceRevision = sourceRevision;
            loc!.sourceLineText = sourceLineText;
        }
        return idText;
    }

    expose func Get(idText: String) -> Location? {
        var id = Convert.ToInt64(idText);
        var i = 0;
        while i < items.count() {
            var loc = items.get(i);
            if loc.id == id {
                return loc;
            }
            i = i + 1;
        }
        return null;
    }

    expose func OpenLocation(shell: app_shell.AppShell,
                             docMgr: document_manager.DocumentManager,
                             engine: editor_engine.EditorEngine,
                             tabs: editor_tabs.EditorTabs,
                             idText: String) -> Boolean {
        var locOpt = Get(idText);
        if locOpt == null { return false; }
        return OpenResolvedLocation(shell, docMgr, engine, tabs, locOpt!);
    }
}

func OpenResolvedLocation(shell: app_shell.AppShell,
                          docMgr: document_manager.DocumentManager,
                          engine: editor_engine.EditorEngine,
                          tabs: editor_tabs.EditorTabs,
                          loc: Location) -> Boolean {
    if loc == null or shell == null or docMgr == null or engine == null
       or engine.editor == null or tabs == null {
        return false;
    }
    if loc.filePath != "" {
        var activeDoc = docMgr.GetActive();
        if activeDoc == null or SameLocationPath(activeDoc.filePath, loc.filePath) == false {
            if file_commands.OpenFileAtPath(shell, docMgr, engine, tabs,
                                            loc.filePath) == false {
                return false;
            }
        }
    } else if docMgr.GetActive() == null {
        shell.SetStatusLeft("Location unavailable");
        return false;
    }
    if loc.line > 0 {
        engine.GoToLine(loc.line);
        if loc.column > 0 {
            engine.editor.SetCursor(loc.line - 1, loc.column - 1);
        }
    }
    return true;
}

/// @brief Compare two location paths after absolute lexical normalization.
/// @details Stored locations can originate from compiler diagnostics, search,
///          and project index results; each source can spell the same file
///          differently. Normalized comparison prevents duplicate tab opens.
/// @param a First path.
/// @param b Second path.
/// @return True when both paths normalize to the same file spelling.
func SameLocationPath(a: String, b: String) -> Boolean {
    return path_identity.SameFile(a, b);
}

func IsLocationData(data: String) -> Boolean {
    if data == "" { return false; }
    var i = 1;
    while i <= Str.get_Length(data) {
        var ch = Str.MidLen(data, i, 1);
        if ch < "0" or ch > "9" { return false; }
        i = i + 1;
    }
    return true;
}
