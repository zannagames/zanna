//
// File: zannastudio/src/services/search_matcher.zia
// Purpose: Compile and execute reusable literal/regex search programs.
// Key invariants:
//   - Literal and regex modes share Zanna.Text.CompiledPattern.
//   - Malformed interactive regexes return diagnostics rather than trapping.
//   - Match coordinates are one-based byte columns; resume offsets are
//     zero-based bytes and always make UTF-8-safe progress for zero-width hits.
//   - Whole-word checks use the runtime's deterministic Unicode table.
// Ownership/Lifetime:
//   - Search controllers own one SearchProgram per request; helpers borrow it.
// Links: zannastudio/src/commands/search_commands_support.zia,
//        runtime/text/rt_compiled_pattern.c
//
//===----------------------------------------------------------------------===//

module search_matcher;

bind Str = Zanna.String;
bind Seq = Zanna.Collections.Seq;
bind Box = Zanna.Core.Box;
bind Pattern = Zanna.Text.Pattern;
bind CompiledPattern = Zanna.Text.CompiledPattern;
bind TextChar = Zanna.Text.Char;

/// @brief One exact line match and the offset for the next non-overlapping query.
class SearchMatch {
    expose Boolean matched;
    expose Integer startCol;
    expose Integer length;
    expose Integer resumeOffset;

    expose func init() {
        matched = false;
        startCol = 1;
        length = 0;
        resumeOffset = 0;
    }
}

/// @brief Result of expanding one replacement template at an exact match.
class SearchExpansion {
    expose Boolean ok;
    expose String text;
    expose String error;

    expose func init() {
        ok = false;
        text = "";
        error = "";
    }
}

/// @brief Immutable search options plus one reusable compiled engine object.
class SearchProgram {
    expose Boolean valid;
    expose String error;
    expose String query;
    expose Boolean caseSensitive;
    expose Boolean wholeWord;
    expose Boolean regexMode;
    expose CompiledPattern compiled;

    expose func init() {
        valid = false;
        error = "";
        query = "";
        caseSensitive = false;
        wholeWord = false;
        regexMode = false;
        compiled = null;
    }

    /// @brief Find the next match at or after a zero-based byte offset.
    expose func FindFrom(line: String, startOffset: Integer) -> SearchMatch {
        var match = new SearchMatch();
        if valid == false or compiled == null { return match; }
        var range = compiled.FindRangeFrom(line, startOffset, wholeWord);
        if range == null or Seq.get_Count(range) < 3 { return match; }

        var startByte = Box.ToI64(Seq.Get(range, 0));
        var endByte = Box.ToI64(Seq.Get(range, 1));
        var resume = Box.ToI64(Seq.Get(range, 2));
        if startByte < 0 or endByte < startByte or resume <= startByte {
            return match;
        }
        match.matched = true;
        match.startCol = startByte + 1;
        match.length = endByte - startByte;
        match.resumeOffset = resume;
        return match;
    }

    /// @brief Expand replacement captures at a previously returned match.
    expose func ExpandAt(line: String,
                         startOffset: Integer,
                         replacement: String) -> SearchExpansion {
        var expansion = new SearchExpansion();
        if valid == false or compiled == null {
            expansion.error = "search pattern is not compiled";
            return expansion;
        }
        if regexMode == false {
            expansion.ok = true;
            expansion.text = replacement;
            return expansion;
        }
        var expanded = compiled.ExpandReplacementAt(line, startOffset, replacement);
        if expanded == null or expanded.IsOk == false {
            expansion.error = "replacement no longer matches the searched line";
            if expanded != null { expansion.error = expanded.UnwrapErrStr(); }
            return expansion;
        }
        expansion.ok = true;
        expansion.text = expanded.UnwrapStr();
        return expansion;
    }
}

/// @brief Compile a request once, escaping literal queries into the shared regex language.
expose func CompileSearch(query: String,
                          caseSensitive: Boolean,
                          wholeWord: Boolean,
                          regexMode: Boolean) -> SearchProgram {
    var program = new SearchProgram();
    program.query = query;
    program.caseSensitive = caseSensitive;
    program.wholeWord = wholeWord;
    program.regexMode = regexMode;
    if query == "" {
        program.error = "search query is empty";
        return program;
    }

    var source = query;
    if regexMode == false { source = Pattern.Escape(query); }
    var attempted = CompiledPattern.TryNew(source, caseSensitive == false);
    if attempted == null or attempted.IsOk == false {
        program.error = "invalid regular expression";
        if attempted != null { program.error = attempted.UnwrapErrStr(); }
        return program;
    }
    program.compiled = attempted.Unwrap() as CompiledPattern;
    if program.compiled == null {
        program.error = "compiled search pattern is unavailable";
        return program;
    }
    program.valid = true;
    return program;
}

/// @brief Find the next match using a request-owned compiled program.
expose func FindLineMatchFrom(line: String,
                              startOffset: Integer,
                              program: SearchProgram) -> SearchMatch {
    if program == null { return new SearchMatch(); }
    return program.FindFrom(line, startOffset);
}

/// @brief Compile and find the first line match for compatibility callers.
expose func FindLineMatch(line: String,
                          query: String,
                          caseSensitive: Boolean,
                          wholeWord: Boolean,
                          regexMode: Boolean) -> SearchMatch {
    var program = CompileSearch(query, caseSensitive, wholeWord, regexMode);
    return program.FindFrom(line, 0);
}

expose func LineMatches(line: String,
                        query: String,
                        caseSensitive: Boolean,
                        wholeWord: Boolean) -> Boolean {
    return FindLineMatch(line, query, caseSensitive, wholeWord, false).matched;
}

expose func LineMatchesWithMode(line: String,
                                query: String,
                                caseSensitive: Boolean,
                                wholeWord: Boolean,
                                regexMode: Boolean) -> Boolean {
    return FindLineMatch(line, query, caseSensitive, wholeWord, regexMode).matched;
}

expose func MatchColumn(line: String, query: String, caseSensitive: Boolean) -> Integer {
    return MatchColumnWithMode(line, query, caseSensitive, false);
}

expose func MatchColumnWithMode(line: String,
                                query: String,
                                caseSensitive: Boolean,
                                regexMode: Boolean) -> Integer {
    var match = FindLineMatch(line, query, caseSensitive, false, regexMode);
    if match.matched == false { return 1; }
    return match.startCol;
}

expose func MatchLengthWithMode(line: String,
                                query: String,
                                caseSensitive: Boolean,
                                regexMode: Boolean) -> Integer {
    var match = FindLineMatch(line, query, caseSensitive, false, regexMode);
    if match.matched == false { return 0; }
    return match.length;
}

expose func FindLiteralLineMatch(line: String,
                                 query: String,
                                 caseSensitive: Boolean,
                                 wholeWord: Boolean) -> SearchMatch {
    return FindLineMatch(line, query, caseSensitive, wholeWord, false);
}

expose func FindRegexLineMatch(line: String,
                               query: String,
                               caseSensitive: Boolean,
                               wholeWord: Boolean) -> SearchMatch {
    return FindLineMatch(line, query, caseSensitive, wholeWord, true);
}

/// @brief Test a byte range against Unicode whole-word boundaries.
/// @details Compatibility helper implemented through the same compiled engine,
///          avoiding mixed byte/codepoint indexing in Zia string helpers.
expose func IsWholeWordMatch(text: String,
                             startCol: Integer,
                             len: Integer) -> Boolean {
    if startCol < 1 or len < 0 { return false; }
    var query = Str.Substring(text, startCol - 1, len);
    if Str.get_Length(query) != len { return false; }
    var program = CompileSearch(query, true, true, false);
    var match = program.FindFrom(text, startCol - 1);
    return match.matched and match.startCol == startCol and match.length == len;
}

/// @brief Classify the first scalar of a string using Unicode word rules.
expose func IsIdentifierChar(ch: String) -> Boolean {
    return TextChar.IsWord(ch);
}
