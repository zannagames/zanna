//
// File: zannastudio/src/editor/scheduler.zia
// Purpose: Registry-backed debounce scheduling for Studio editor jobs.
// Key invariants:
//   - Every job kind has exactly one ScheduledJob record as its source of truth.
//   - Queue/cancel generation changes invalidate stale asynchronous results.
//   - Deadlines are absolute monotonic millisecond values.
// Ownership/Lifetime: EditorScheduler owns its fixed job registry.
// Links: zannastudio/src/app/language_tool_frame.zia,
//        zannastudio/src/editor/diagnostics.zia
//
//===----------------------------------------------------------------------===//

module scheduler;

bind Clock = Zanna.Time.Clock;

final JOB_DIAGNOSTICS = 1;
final JOB_COMPLETION = 2;
final JOB_SIGNATURE = 3;
final JOB_HOVER = 4;
final JOB_SYMBOLS = 5;
final JOB_INDEX_SYNC = 6;
final JOB_SEARCH = 7;
final JOB_QUICK_OPEN_REFRESH = 8;
final JOB_KIND_COUNT = 8;

final SCHED_DIAGNOSTICS_IDLE_MS = 500;
final SCHED_COMPLETION_DEBOUNCE_MS = 180;
final SCHED_SIGNATURE_DEBOUNCE_MS = 120;
final SCHED_HOVER_DWELL_MS = 300;
final SCHED_SYMBOLS_IDLE_MS = 300;
final SCHED_INDEX_IDLE_MS = 350;
final SCHED_SEARCH_IDLE_MS = 50;
final SCHED_QUICK_OPEN_REFRESH_MS = 100;

/// @brief Complete state and metadata for one scheduler job kind.
class ScheduledJob {
    expose Integer kind;
    expose String name;
    expose Integer defaultDelayMs;
    expose Boolean queued;
    expose String path;
    expose Integer revision;
    expose Integer dueMs;
    expose Integer generation;

    expose func init(jobKind: Integer,
                     jobName: String,
                     delayMs: Integer) {
        kind = jobKind;
        name = jobName;
        defaultDelayMs = delayMs;
        queued = false;
        path = "";
        revision = -1;
        dueMs = 0;
        generation = 0;
    }

    expose func Queue(jobPath: String,
                      jobRevision: Integer,
                      dueAtMs: Integer) -> Integer {
        queued = true;
        path = jobPath;
        revision = jobRevision;
        dueMs = dueAtMs;
        generation = generation + 1;
        if generation <= 0 { generation = 1; }
        return generation;
    }

    expose func Matches(jobPath: String,
                        jobRevision: Integer) -> Boolean {
        return queued and path == jobPath and revision == jobRevision;
    }

    expose func IsDue(nowMs: Integer,
                      jobPath: String,
                      jobRevision: Integer) -> Boolean {
        return Matches(jobPath, jobRevision) and nowMs >= dueMs;
    }

    expose func Cancel() {
        queued = false;
        generation = generation + 1;
        if generation <= 0 { generation = 1; }
    }

    expose func Complete() { queued = false; }
}

/// @brief Fixed registry of all debounce-scheduled editor work.
class EditorScheduler {
    expose List[ScheduledJob] jobs;
    expose Integer queuedTotal;
    expose Integer completedTotal;
    expose Integer canceledTotal;
    expose Integer lastQueuedKind;
    expose Integer lastCompletedKind;

    expose func init() {
        jobs = [];
        jobs.add(new ScheduledJob(
            JOB_DIAGNOSTICS, "diagnostics", SCHED_DIAGNOSTICS_IDLE_MS));
        jobs.add(new ScheduledJob(
            JOB_COMPLETION, "completion", SCHED_COMPLETION_DEBOUNCE_MS));
        jobs.add(new ScheduledJob(
            JOB_SIGNATURE, "signature", SCHED_SIGNATURE_DEBOUNCE_MS));
        jobs.add(new ScheduledJob(
            JOB_HOVER, "hover", SCHED_HOVER_DWELL_MS));
        jobs.add(new ScheduledJob(
            JOB_SYMBOLS, "symbols", SCHED_SYMBOLS_IDLE_MS));
        jobs.add(new ScheduledJob(
            JOB_INDEX_SYNC, "index", SCHED_INDEX_IDLE_MS));
        jobs.add(new ScheduledJob(
            JOB_SEARCH, "search", SCHED_SEARCH_IDLE_MS));
        jobs.add(new ScheduledJob(
            JOB_QUICK_OPEN_REFRESH, "quick open",
            SCHED_QUICK_OPEN_REFRESH_MS));
        queuedTotal = 0;
        completedTotal = 0;
        canceledTotal = 0;
        lastQueuedKind = 0;
        lastCompletedKind = 0;
    }

    /// @brief Resolve one job kind from the sole registry.
    expose func Job(kind: Integer) -> ScheduledJob? {
        if kind < 1 or kind > jobs.count() { return null; }
        var job = jobs.get(kind - 1) as ScheduledJob;
        if job == null or job.kind != kind { return null; }
        return job;
    }

    expose func DefaultDelay(kind: Integer) -> Integer {
        var job = Job(kind);
        if job == null { return 0; }
        return job!.defaultDelayMs;
    }

    expose func Configure(diagnosticsDelay: Integer,
                          completionDelay: Integer) {
        var diagnostics = diagnosticsDelay;
        var completion = completionDelay;
        if diagnostics < 100 { diagnostics = 100; }
        if diagnostics > 5000 { diagnostics = 5000; }
        if completion < 0 { completion = 0; }
        if completion > 2000 { completion = 2000; }
        var diagnosticsJob = Job(JOB_DIAGNOSTICS);
        var completionJob = Job(JOB_COMPLETION);
        if diagnosticsJob != null {
            diagnosticsJob!.defaultDelayMs = diagnostics;
        }
        if completionJob != null {
            completionJob!.defaultDelayMs = completion;
        }
    }

    expose func Queue(kind: Integer,
                      path: String,
                      revision: Integer,
                      delayMs: Integer) -> Integer {
        var job = Job(kind);
        if job == null { return 0; }
        var delay = delayMs;
        if delay < 0 { delay = job!.defaultDelayMs; }
        if delay < 0 { delay = 0; }
        queuedTotal = queuedTotal + 1;
        lastQueuedKind = kind;
        return job!.Queue(path, revision, Clock.NowMs() + delay);
    }

    expose func IsQueued(kind: Integer,
                         path: String,
                         revision: Integer) -> Boolean {
        var job = Job(kind);
        return job != null and job!.Matches(path, revision);
    }

    expose func IsDue(kind: Integer,
                      path: String,
                      revision: Integer) -> Boolean {
        var job = Job(kind);
        return job != null and job!.IsDue(Clock.NowMs(), path, revision);
    }

    expose func CurrentGeneration(kind: Integer) -> Integer {
        var job = Job(kind);
        if job == null { return 0; }
        return job!.generation;
    }

    expose func QueuedGeneration(kind: Integer) -> Integer {
        var job = Job(kind);
        if job == null or job!.queued == false { return 0; }
        return job!.generation;
    }

    expose func IsCurrent(kind: Integer,
                          generation: Integer) -> Boolean {
        return generation > 0 and CurrentGeneration(kind) == generation;
    }

    expose func Cancel(kind: Integer) {
        var job = Job(kind);
        if job == null { return; }
        job!.Cancel();
        canceledTotal = canceledTotal + 1;
    }

    expose func CancelAll() {
        var i = 0;
        while i < jobs.count() {
            var job = jobs.get(i) as ScheduledJob;
            job.Cancel();
            canceledTotal = canceledTotal + 1;
            i = i + 1;
        }
    }

    expose func Complete(kind: Integer) {
        var job = Job(kind);
        if job == null { return; }
        job!.Complete();
        completedTotal = completedTotal + 1;
        lastCompletedKind = kind;
    }

    expose func QueuedCount() -> Integer {
        var count = 0;
        var i = 0;
        while i < jobs.count() {
            var job = jobs.get(i) as ScheduledJob;
            if job.queued { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    /// @brief Earliest absolute deadline among queued jobs, or zero when idle.
    expose func EarliestDueMs() -> Integer {
        var earliest = 0;
        var i = 0;
        while i < jobs.count() {
            var job = jobs.get(i) as ScheduledJob;
            if job.queued and (earliest == 0 or job.dueMs < earliest) {
                earliest = job.dueMs;
            }
            i = i + 1;
        }
        return earliest;
    }

    expose func KindName(kind: Integer) -> String {
        var job = Job(kind);
        if job == null { return "idle"; }
        return job!.name;
    }

    expose func NextQueuedKind() -> Integer {
        if IsKindQueued(JOB_COMPLETION) { return JOB_COMPLETION; }
        if IsKindQueued(JOB_SIGNATURE) { return JOB_SIGNATURE; }
        if IsKindQueued(JOB_DIAGNOSTICS) { return JOB_DIAGNOSTICS; }
        if IsKindQueued(JOB_HOVER) { return JOB_HOVER; }
        if IsKindQueued(JOB_SEARCH) { return JOB_SEARCH; }
        if IsKindQueued(JOB_QUICK_OPEN_REFRESH) { return JOB_QUICK_OPEN_REFRESH; }
        if IsKindQueued(JOB_SYMBOLS) { return JOB_SYMBOLS; }
        if IsKindQueued(JOB_INDEX_SYNC) { return JOB_INDEX_SYNC; }
        return 0;
    }

    expose func StatusText() -> String {
        var count = QueuedCount();
        if count <= 0 { return "Tasks: idle"; }
        return "Tasks: " + count + " queued ("
               + KindName(NextQueuedKind()) + ")";
    }

    hide func IsKindQueued(kind: Integer) -> Boolean {
        var job = Job(kind);
        return job != null and job!.queued;
    }
}
