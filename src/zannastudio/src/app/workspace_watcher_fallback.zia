//
// File: zannastudio/src/app/workspace_watcher_fallback.zia
// Purpose: Fingerprint workspaces with degraded native coverage on an owned worker.
// Key invariants:
//   - The UI pump only starts or publishes work and never performs file traversal.
//   - The worker consumes bounded explicit-cursor pages until a full snapshot ends.
//   - Nanosecond metadata and sampled content participate in two fingerprints.
//   - A completed changed snapshot refreshes topology-derived state once.
// Ownership/Lifetime: Borrows application state; owns no watcher or cursor.
// Links: zannastudio/src/app/workspace_watcher.zia,
//        zannastudio/src/app/workspace_watcher_state.zia,
//        docs/adr/0303-complete-owned-workspace-index-cursors.md
//
//===----------------------------------------------------------------------===//

module workspace_watcher_fallback;

bind "workspace_refresh";
bind "workspace_watcher_state";
bind "../ui/app_shell";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../editor/editor_engine";
bind "../editor/project_index";
bind "../services/locations";
bind "../services/path_identity";
bind "../services/workspace_file_cursor";

bind Hash = Zanna.Crypto.Hash;
bind Map = Zanna.Collections.Map;
bind Monitor = Zanna.Threads.Monitor;
bind Async = Zanna.Threads.Async;
bind Future = Zanna.Threads.Future;
bind Seq = Zanna.Collections.Seq;

final WORKSPACE_FALLBACK_PAGE_SIZE = 256;
final WORKSPACE_FINGERPRINT_MODULUS = 2000000011;
final WORKSPACE_SECONDARY_FINGERPRINT_MODULUS = 1999999973;

/// @brief Start or publish one owned fallback scan without blocking the UI.
expose func Pump(
    shell: app_shell.AppShell,
    projMgr: project_manager.ProjectManager,
    docMgr: document_manager.DocumentManager,
    indexer: project_index.ProjectIndexer,
    locStore: locations.LocationStore,
    engine: editor_engine.EditorEngine,
    state: workspace_watcher_state.WorkspaceWatcherState) {
    if state == null or state.rootPaths.count() == 0 { return; }
    if state.discoveryActive { return; }
    if state.fallbackScanActive == false {
        if state.fallbackFuture != null {
            if Future.get_IsDone(state.fallbackFuture) == false { return; }
            state.fallbackFuture = null;
            state.fallbackRequest = null;
        }
        if state.fallbackRestartRequested {
            Begin(state);
            return;
        }
        if state.rescanThrottle.TryAcquire() == false { return; }
        Begin(state);
        return;
    }
    if state.fallbackFuture == null
       or Future.get_IsDone(state.fallbackFuture) == false { return; }

    var future = state.fallbackFuture;
    var request = state.fallbackRequest;
    state.fallbackFuture = null;
    state.fallbackRequest = null;
    state.fallbackScanActive = false;
    if request == null or Future.get_IsError(future)
       or request!.failed or request!.cancelled {
        state.degraded = true;
        if state.fallbackRestartRequested {
            Begin(state);
            return;
        }
        ResetThrottle(state);
        return;
    }
    if request!.succeeded == false
       or request!.rootSignature != state.rootSignature {
        ResetThrottle(state);
        return;
    }
    state.fallbackEntryCounts = request!.entryCounts;
    state.fallbackFingerprints = request!.fingerprints;
    state.fallbackSecondaryFingerprints = request!.secondaryFingerprints;
    Complete(shell, projMgr, docMgr, indexer, locStore, engine, state);
}

/// @brief Start one immutable full-workspace fallback scan on an owned worker.
func Begin(state: workspace_watcher_state.WorkspaceWatcherState) {
    var request = new workspace_watcher_state.WorkspaceFallbackScanRequest();
    request.rootSignature = state.rootSignature;
    var i = 0;
    while i < state.rootPaths.count() {
        request.rootPaths.Push(state.rootPaths.get(i));
        if i < state.rootIgnorePatterns.count() {
            request.rootIgnorePatterns.Push(state.rootIgnorePatterns.get(i));
        } else {
            request.rootIgnorePatterns.Push("");
        }
        i = i + 1;
    }
    state.fallbackScanActive = true;
    state.fallbackRestartRequested = false;
    state.fallbackPageOffset = 0;
    state.fallbackRequest = request;
    try {
        state.fallbackFuture = Async.RunOwned(&RunFallbackScan, request);
    } catch {
        state.fallbackFuture = null;
    }
    if state.fallbackFuture == null {
        request.failed = true;
        request.error = "Could not start workspace fallback scan";
        state.fallbackScanActive = false;
        state.degraded = true;
        ResetThrottle(state);
    }
}

/// @brief Cancel a running fallback snapshot after workspace/shutdown changes.
expose func Cancel(state: workspace_watcher_state.WorkspaceWatcherState) {
    if state == null or state.fallbackRequest == null { return; }
    Monitor.Enter(state.fallbackRequest);
    state.fallbackRequest.cancelled = true;
    Monitor.Exit(state.fallbackRequest);
}

/// @brief Test one request cancellation flag under its monitor.
func IsCancelled(request: workspace_watcher_state.WorkspaceFallbackScanRequest)
    -> Boolean {
    if request == null { return true; }
    Monitor.Enter(request);
    var cancelled = request.cancelled;
    Monitor.Exit(request);
    return cancelled;
}

/// @brief Traverse all roots on a worker and publish only compact fingerprints.
func RunFallbackScan(
    request: workspace_watcher_state.WorkspaceFallbackScanRequest) -> Any {
    if request == null { return request; }
    var rootIndex = 0;
    while rootIndex < request.rootPaths.count() and IsCancelled(request) == false {
        var root = request.rootPaths.get(rootIndex);
        var ignores = "";
        if rootIndex < request.rootIgnorePatterns.count() {
            ignores = request.rootIgnorePatterns.get(rootIndex);
        }
        var cursor = new workspace_file_cursor.WorkspaceFileCursor();
        if cursor.Open(root, "", ignores, true) == false {
            request.failed = true;
            request.error = "Workspace fallback traversal could not open " + root;
            break;
        }
        var count = 0;
        var fingerprint = 0;
        var secondaryFingerprint = 0;
        var done = false;
        while done == false and IsCancelled(request) == false {
            var page = cursor.Next(WORKSPACE_FALLBACK_PAGE_SIZE);
            if page == null or Map.GetBool(page, "valid") == false {
                request.failed = true;
                request.error = "Workspace fallback traversal failed for " + root;
                break;
            }
            var entries = Map.Get(page, "entries") as Seq;
            var entryCount = 0;
            if entries != null { entryCount = Seq.get_Count(entries); }
            var entryIndex = 0;
            while entries != null and entryIndex < entryCount {
                var entry = Seq.Get(entries, entryIndex);
                fingerprint = (fingerprint + PrimaryFingerprintTerm(entry))
                    % WORKSPACE_FINGERPRINT_MODULUS;
                secondaryFingerprint =
                    (secondaryFingerprint + SecondaryFingerprintTerm(entry))
                    % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
                count = count + 1;
                entryIndex = entryIndex + 1;
            }
            request.pagesScanned = request.pagesScanned + 1;
            done = Map.GetBool(page, "done");
            if Map.GetBool(page, "truncated") {
                request.failed = true;
                request.error = "Workspace fallback traversal was truncated for " + root;
                break;
            }
            if entryCount == 0 and done == false and Map.GetInt(page, "work") <= 0 {
                request.failed = true;
                request.error = "Workspace fallback traversal stalled for " + root;
                break;
            }
        }
        cursor.Destroy();
        if request.failed or IsCancelled(request) { break; }
        request.entryCounts.Push(count);
        request.fingerprints.Push(fingerprint);
        request.secondaryFingerprints.Push(secondaryFingerprint);
        rootIndex = rootIndex + 1;
    }
    request.succeeded = request.failed == false
        and IsCancelled(request) == false
        and rootIndex == request.rootPaths.count();
    return request;
}

/// @brief Fold one FileIndex row into bounded order-independent metadata keys.
expose func Accumulate(
    state: workspace_watcher_state.WorkspaceWatcherState,
    entry: Any) {
    if state == null or entry == null { return; }
    state.fallbackCurrentFingerprint =
        (state.fallbackCurrentFingerprint + PrimaryFingerprintTerm(entry))
        % WORKSPACE_FINGERPRINT_MODULUS;
    state.fallbackCurrentSecondaryFingerprint =
        (state.fallbackCurrentSecondaryFingerprint + SecondaryFingerprintTerm(entry))
        % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    state.fallbackCurrentCount = state.fallbackCurrentCount + 1;
}

/// @brief Return the primary order-independent contribution for one entry.
func PrimaryFingerprintTerm(entry: Any) -> Integer {
    var idPart = NormalizePrimary(Map.GetInt(entry, "id"));
    var modifiedPart = NormalizePrimary(Map.GetInt(entry, "modified"));
    var modifiedNsPart = NormalizePrimary(Map.GetInt(entry, "modifiedNs"));
    var sizePart = NormalizePrimary(Map.GetInt(entry, "size"));
    var samplePart = NormalizePrimary(Map.GetInt(entry, "sampleHash"));
    var pathPart = NormalizePrimary(
        Hash.NonCryptoFast(path_identity.Normalize(Map.GetStr(entry, "path"))));
    var term = idPart;
    term = (term + modifiedPart * 31) % WORKSPACE_FINGERPRINT_MODULUS;
    term = (term + sizePart * 131) % WORKSPACE_FINGERPRINT_MODULUS;
    term = (term + pathPart * 521) % WORKSPACE_FINGERPRINT_MODULUS;
    term = (term + modifiedNsPart * 8191) % WORKSPACE_FINGERPRINT_MODULUS;
    term = (term + samplePart * 65537) % WORKSPACE_FINGERPRINT_MODULUS;
    if Map.GetBool(entry, "isDirectory") {
        term = (term + 104729) % WORKSPACE_FINGERPRINT_MODULUS;
    }
    return term;
}

/// @brief Return the secondary order-independent contribution for one entry.
func SecondaryFingerprintTerm(entry: Any) -> Integer {
    var secondary = NormalizeSecondary(Map.GetInt(entry, "id"));
    secondary = (secondary
                 + NormalizeSecondary(Map.GetInt(entry, "size")) * 8191)
                % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    secondary = (secondary
                 + NormalizeSecondary(Map.GetInt(entry, "modifiedNs")) * 131)
                % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    secondary = (secondary
                 + NormalizeSecondary(Map.GetInt(entry, "sampleHash")) * 521)
                % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    secondary = (secondary
                 + NormalizeSecondary(Hash.NonCryptoFast(
                       path_identity.Normalize(Map.GetStr(entry, "path"))))
                   * 65537)
                % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    return secondary;
}

func NormalizePrimary(value: Integer) -> Integer {
    var result = value % WORKSPACE_FINGERPRINT_MODULUS;
    if result < 0 { result = result + WORKSPACE_FINGERPRINT_MODULUS; }
    return result;
}

func NormalizeSecondary(value: Integer) -> Integer {
    var result = value % WORKSPACE_SECONDARY_FINGERPRINT_MODULUS;
    if result < 0 { result = result + WORKSPACE_SECONDARY_FINGERPRINT_MODULUS; }
    return result;
}

/// @brief Commit the current root aggregate and advance the fallback cursor.
func FinishRoot(state: workspace_watcher_state.WorkspaceWatcherState) {
    if state.fallbackCursor != null { state.fallbackCursor.Destroy(); }
    state.fallbackEntryCounts.Push(state.fallbackCurrentCount);
    state.fallbackFingerprints.Push(state.fallbackCurrentFingerprint);
    state.fallbackSecondaryFingerprints.Push(
        state.fallbackCurrentSecondaryFingerprint);
    state.fallbackRootIndex = state.fallbackRootIndex + 1;
    state.fallbackPageOffset = 0;
    state.fallbackCurrentCount = 0;
    state.fallbackCurrentFingerprint = 0;
    state.fallbackCurrentSecondaryFingerprint = 0;
}

/// @brief Compare and publish one completed cooperative fallback snapshot.
func Complete(
    shell: app_shell.AppShell,
    projMgr: project_manager.ProjectManager,
    docMgr: document_manager.DocumentManager,
    indexer: project_index.ProjectIndexer,
    locStore: locations.LocationStore,
    engine: editor_engine.EditorEngine,
    state: workspace_watcher_state.WorkspaceWatcherState) {
    var changed = false;
    if state.fallbackBaselineReady
       and state.lastEntryCounts.count() == state.fallbackEntryCounts.count()
       and state.lastFingerprints.count() == state.fallbackFingerprints.count()
       and state.lastSecondaryFingerprints.count()
           == state.fallbackSecondaryFingerprints.count() {
        var i = 0;
        while i < state.fallbackEntryCounts.count() {
            if state.lastEntryCounts.get(i) != state.fallbackEntryCounts.get(i)
               or state.lastFingerprints.get(i) != state.fallbackFingerprints.get(i)
               or state.lastSecondaryFingerprints.get(i)
                  != state.fallbackSecondaryFingerprints.get(i) {
                changed = true;
            }
            i = i + 1;
        }
    } else if state.fallbackBaselineReady {
        changed = true;
    }
    state.lastEntryCounts = state.fallbackEntryCounts;
    state.lastFingerprints = state.fallbackFingerprints;
    state.lastSecondaryFingerprints = state.fallbackSecondaryFingerprints;
    state.fallbackBaselineReady = true;
    state.fallbackScanActive = false;
    if state.lastEntryCounts.count() > 0 {
        state.lastEntryCount = state.lastEntryCounts.get(0);
        state.lastFingerprint = state.lastFingerprints.get(0);
    } else {
        state.lastEntryCount = -1;
        state.lastFingerprint = 0;
    }
    ResetThrottle(state);

    if changed {
        if projMgr != null {
            projMgr.InvalidateAllSourceFreshness();
            projMgr.RefreshTree();
        }
        workspace_refresh.ReindexAfterTreeMove(projMgr, indexer, docMgr);
        workspace_refresh.InvalidateWorkspaceLocations(shell, locStore, engine);
        if shell != null {
            shell.SetStatusLeft("Workspace changed: refreshed nested files");
        }
    }
}

/// @brief Restart the periodic-scan interval after success or failure.
func ResetThrottle(state: workspace_watcher_state.WorkspaceWatcherState) {
    if state == null { return; }
    state.rescanThrottle.Reset();
    state.rescanThrottle.TryAcquire();
}
