//
// File: zannastudio/src/app/lifecycle_controller.zia
// Purpose: Centralize clean Studio shutdown and debugger-overlay lifecycle work.
// Key invariants:
//   - Every confirmed exit persists one recovery-free clean session.
//   - Crash markers are cleared only after services have stopped successfully.
//   - Teardown never creates transient UI that is destroyed before it is useful.
// Ownership/Lifetime:
//   - Borrows application-owned controllers for the duration of each operation.
// Links: zannastudio/src/main.zia, zannastudio/src/core/recovery_store.zia
//
//===----------------------------------------------------------------------===//

module lifecycle_controller;

bind "../app/file_watch_controller";
bind "../app/workspace_watcher";
bind "../build/build_system";
bind "../build/breakpoints";
bind "../build/debug_session";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../core/recovery_store";
bind "../core/session";
bind "../commands/file_commands";
bind "../editor/editor_engine";
bind "../editor/project_index";
bind "../terminal/terminal_controller";
bind "../ui/app_shell";
bind "../ui/debug_breakpoint_overlay";

bind Zanna.GUI;

// ============================================================================
// MODULE: lifecycle_controller
// PURPOSE: Own the shutdown and debugger-overlay lifecycle code that used to
//          live at the bottom of main.zia.
//
// WHERE-THIS-FITS: main.zia still decides when the app is leaving the frame
//          loop, but this module owns the shared teardown checklist. Debug
//          command routing can also call the overlay helpers without adding more
//          helper functions to the entry point.
//
// TEACHING-NOTE: Shutdown paths are a common source of partial cleanup bugs.
//          Keep every process, watcher, indexer, session, and shell teardown
//          step in one function so new features have an obvious place to add
//          their own finalizer.
// ============================================================================

/// @brief Idempotency and clean-exit truth for the process shutdown boundary.
/// @details The application owner begins this latch before stopping producers.
///          Every bounded worker drain is folded into one sticky result. This
///          keeps a second exit signal from destroying native resources twice
///          and prevents recovery data from being cleared after a failed drain.
class ShutdownState {
    expose Boolean started;
    expose Boolean completed;
    expose Boolean workerDrainsSucceeded;
    expose Boolean currentAttemptSucceeded;
    expose Integer attempts;

    expose func init() {
        started = false;
        completed = false;
        workerDrainsSucceeded = true;
        currentAttemptSucceeded = true;
        attempts = 0;
    }

    /// @brief Claim shutdown ownership exactly once.
    expose func Begin() -> Boolean {
        attempts = attempts + 1;
        if started { return false; }
        started = true;
        currentAttemptSucceeded = true;
        return true;
    }

    /// @brief Fold one worker's bounded drain result into the shutdown truth.
    expose func RecordWorkerDrain(succeeded: Boolean) {
        if succeeded == false {
            workerDrainsSucceeded = false;
            currentAttemptSucceeded = false;
        }
    }

    /// @brief Relinquish an incomplete attempt without permitting teardown.
    /// @details A later exit signal may retry drains after cooperative workers
    ///          finish. The historical failure remains sticky for recovery truth.
    expose func ReleaseForRetry() {
        if completed { return; }
        started = false;
    }

    /// @brief Mark native and persistent teardown complete.
    expose func Finish() {
        completed = true;
    }

    /// @brief Return whether recovery state may truthfully be retired.
    expose func MayMarkCleanExit(sessionSaved: Boolean) -> Boolean {
        return started and workerDrainsSucceeded and sessionSaved;
    }
}

/// @brief Stop all long-lived IDE services and persist final state before exit.
/// @details Used for normal loop termination, File > Exit, and window-manager
///          close requests so no path can bypass build/debug cancellation,
///          watcher shutdown, indexer cleanup, breakpoint persistence, session
///          persistence, or shell destruction.
/// @param shell Workbench shell to persist and destroy.
/// @param docMgr Open document manager whose active editor state is saved.
/// @param projMgr Project manager persisted with the session.
/// @param engine Editor engine used to capture cursor, scroll, and buffer state.
/// @param buildSys Active build/run process controller.
/// @param dbgSession Active debug-adapter process controller.
/// @param terminalCtrl Integrated-terminal controller whose PTY child is stopped.
/// @param fileWatchCtrl Active-file and open-document external-change controller.
/// @param workspaceWatcherState Project-root watcher state.
/// @param indexer Semantic workspace indexer to destroy.
/// @param breakpointStore Breakpoint persistence store.
/// @param sessionMgr Session persistence store.
/// @param recoveryStore Crash-recovery store whose lock is retired last.
expose func CleanupIdeWithWorkerStatus(
    shell: app_shell.AppShell,
    docMgr: document_manager.DocumentManager,
    projMgr: project_manager.ProjectManager,
    engine: editor_engine.EditorEngine,
    buildSys: build_system.BuildSystem,
    dbgSession: debug_session.DebugSession,
    terminalCtrl: terminal_controller.TerminalController,
    fileWatchCtrl: file_watch_controller.FileWatchController,
    workspaceWatcherState: workspace_watcher.WorkspaceWatcherState,
    indexer: project_index.ProjectIndexer,
    breakpointStore: breakpoints.BreakpointStore,
    sessionMgr: session.SessionManager,
    recoveryStore: recovery_store.RecoveryStore,
    workerDrainsSucceeded: Boolean) -> Boolean {
    // Native child destruction may wait for process trees or ConPTY teardown,
    // so Studio routes it through handle-only workers. Do not release watchers,
    // indexes, persistence owners, or GUI state until every reaper has drained.
    var nativeHandlesDrained = true;
    if buildSys != null and buildSys.Shutdown() == false {
        nativeHandlesDrained = false;
    }
    if dbgSession != null and dbgSession.Shutdown() == false {
        nativeHandlesDrained = false;
    }
    if terminalCtrl != null and terminalCtrl.Shutdown() == false {
        nativeHandlesDrained = false;
    }
    if nativeHandlesDrained == false {
        if shell != null {
            shell.SetStatusLeft(
                "Waiting for child-process cleanup; Studio remains open");
        }
        return false;
    }

    file_commands.SaveEditorState(docMgr, engine);
    if breakpointStore != null {
        if breakpointStore.Save() == false and shell != null {
            shell.SetStatusLeft("Could not save breakpoints");
        }
    }
    var sessionSaved = true;
    if sessionMgr != null {
        if engine != null and engine.PaneCount() >= 2 {
            var firstPaneDocument = engine.PrimaryDocument();
            var secondPaneDocument = engine.SecondaryDocument();
            if firstPaneDocument != null and secondPaneDocument != null {
                sessionMgr.CaptureSplitState(firstPaneDocument!,
                                             secondPaneDocument!,
                                             engine.secondaryFocused);
            } else {
                sessionMgr.ClearSplitState();
            }
        } else {
            sessionMgr.ClearSplitState();
        }
        sessionSaved = sessionMgr.SaveCleanExit(docMgr, projMgr);
        if sessionSaved == false and shell != null {
            shell.SetStatusLeft("Could not save session; recovery data retained");
        }
    }
    if fileWatchCtrl != null {
        fileWatchCtrl.Destroy();
    }
    workspace_watcher.StopWorkspaceWatcher(workspaceWatcherState);
    if indexer != null {
        indexer.Destroy();
    }
    // Keep the lock until all persistent state is written and background
    // services are stopped. A process failure before this point must remain
    // recoverable on the next launch.
    if recoveryStore != null and sessionSaved and workerDrainsSucceeded {
        if recoveryStore.MarkCleanExit() == false and shell != null {
            shell.SetStatusLeft("Could not retire recovery data; it was retained");
        }
    }
    if shell != null {
        shell.Destroy();
    }
    return true;
}

/// @brief Compatibility cleanup entry for callers without background workers.
/// @details Application code must use CleanupIdeWithWorkerStatus so a failed
///          drain retains recovery data. Probes and small embeddings that own no
///          asynchronous Studio services keep the compact original surface.
expose func CleanupIde(shell: app_shell.AppShell,
                       docMgr: document_manager.DocumentManager,
                       projMgr: project_manager.ProjectManager,
                       engine: editor_engine.EditorEngine,
                       buildSys: build_system.BuildSystem,
                       dbgSession: debug_session.DebugSession,
                       terminalCtrl: terminal_controller.TerminalController,
                       fileWatchCtrl: file_watch_controller.FileWatchController,
                       workspaceWatcherState: workspace_watcher.WorkspaceWatcherState,
                       indexer: project_index.ProjectIndexer,
                       breakpointStore: breakpoints.BreakpointStore,
                       sessionMgr: session.SessionManager,
                       recoveryStore: recovery_store.RecoveryStore) -> Boolean {
    return CleanupIdeWithWorkerStatus(
        shell, docMgr, projMgr, engine, buildSys, dbgSession, terminalCtrl,
        fileWatchCtrl, workspaceWatcherState, indexer, breakpointStore,
        sessionMgr, recoveryStore, true);
}

/// @brief Open the non-modal condition/logpoint editor for the cursor line.
/// @details The helper validates that the active document has a saved path,
///          snapshots editor content into the document manager, and preloads
///          existing breakpoint metadata for the selected line.
/// @param shell Workbench shell for status text.
/// @param overlay Debug breakpoint overlay to show.
/// @param docMgr Open document manager.
/// @param engine Active editor engine.
/// @param store Persistent breakpoint store.
/// @param action Debug overlay action to open.
expose func OpenDebugBreakpointOverlay(shell: app_shell.AppShell,
                                       overlay: debug_breakpoint_overlay.DebugBreakpointOverlay,
                                       docMgr: document_manager.DocumentManager,
                                       engine: editor_engine.EditorEngine,
                                       store: breakpoints.BreakpointStore,
                                       action: Integer) {
    file_commands.SaveEditorState(docMgr, engine);
    var maybeDoc = docMgr.GetActive();
    if maybeDoc == null or maybeDoc!.filePath == "" or maybeDoc!.isNew {
        shell.SetStatusLeft("Save file before setting breakpoints");
        return;
    }
    var doc = maybeDoc!;
    var line = engine.GetCursorLine();
    if action == debug_breakpoint_overlay.DEBUG_BP_ACTION_CONDITION {
        overlay.OpenCondition(shell, doc.filePath, line, store.ConditionAt(doc.filePath, line));
    } else if action == debug_breakpoint_overlay.DEBUG_BP_ACTION_LOGPOINT {
        overlay.OpenLogpoint(shell, doc.filePath, line, store.LogMessageAt(doc.filePath, line));
    }
}

/// @brief Persist and live-sync a completed breakpoint metadata overlay edit.
/// @param shell Workbench shell for status text.
/// @param overlay Completed debug breakpoint overlay.
/// @param docMgr Open document manager.
/// @param engine Active editor engine.
/// @param store Persistent breakpoint store.
/// @param session Active debug session, if any.
/// @param action Completed overlay action.
expose func ApplyDebugBreakpointOverlay(shell: app_shell.AppShell,
                                        overlay: debug_breakpoint_overlay.DebugBreakpointOverlay,
                                        docMgr: document_manager.DocumentManager,
                                        engine: editor_engine.EditorEngine,
                                        store: breakpoints.BreakpointStore,
                                        session: debug_session.DebugSession,
                                        action: Integer) {
    var path = overlay.TargetPath();
    var line = overlay.TargetLine();
    if path == "" or line <= 0 {
        overlay.Finish();
        return;
    }
    var value = overlay.ReadValue();
    if action == debug_breakpoint_overlay.DEBUG_BP_ACTION_CONDITION {
        store.SetCondition(path, line, value);
    } else if action == debug_breakpoint_overlay.DEBUG_BP_ACTION_LOGPOINT {
        store.SetLogMessage(path, line, value);
    }
    var breakpointSaved = store.Save();
    var doc = docMgr.GetActive();
    if doc != null {
        store.ApplyToEditor(engine, doc!);
    }
    if session != null and session.IsActive() {
        session.SyncBreakpoints(path, store);
    }
    if action == debug_breakpoint_overlay.DEBUG_BP_ACTION_CONDITION {
        if value == "" {
            shell.SetStatusLeft("Condition cleared at line " + line);
        } else {
            shell.SetStatusLeft("Breakpoint at line " + line + " stops when: " + value);
        }
    } else {
        if value == "" {
            shell.SetStatusLeft("Logpoint cleared at line " + line);
        } else {
            shell.SetStatusLeft("Logpoint set at line " + line);
        }
    }
    if breakpointSaved == false {
        shell.SetStatusLeft("Breakpoint changed, but could not be saved");
        GUI.Toast.Error("Could not save breakpoints");
    }
    overlay.Finish();
}
