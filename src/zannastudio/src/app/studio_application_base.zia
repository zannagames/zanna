    hide diff_view.DiffView diffOverlay;
    hide workspace_edit_preview.WorkspaceEditPreview renamePreview;
    hide terminal_controller.TerminalController terminalCtrl;
    hide build_system.BuildSystem buildSys;
    hide breakpoints.BreakpointStore breakpointStore;
    hide debug_session.DebugSession dbgSession;
    hide locations.LocationStore locStore;
    hide command_registry.CommandRegistry commandRegistry;
