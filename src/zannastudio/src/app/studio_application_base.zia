    hide project_index.ProjectIndexer indexer;
    hide scheduler.EditorScheduler editorScheduler;
    hide search_commands.SearchController searcher;
    hide command_palette_controller.CommandPaletteController paletteCtrl;
    hide file_watch_controller.FileWatchController fileWatchCtrl;
    hide focus_throttle.FocusThrottle focusThrottle;
    hide basic_workspace_commands.BasicWorkspaceCommandController basicWorkspaceCommands;
    hide diagnostic_edit_commands.DiagnosticActionController diagnosticActions;
    hide zia_workspace_commands.ZiaWorkspaceCommandController ziaWorkspaceCommands;
    hide ide_overlays.IdeOverlays overlays;
    hide explorer_actions.ExplorerActionOverlay explorerOverlay;
    hide debug_breakpoint_overlay.DebugBreakpointOverlay debugOverlay;
    hide command_input.CommandInputOverlay commandInputOverlay;
    hide welcome_view.WelcomeView welcomeView;
    hide scene_editor_2d.SceneEditor2D scene2DEditor;
    hide scene_context_menus_2d.SceneContextMenus2D scene2DContextMenus;
    hide scene_editor_3d.SceneEditor3D scene3DEditor;
    hide scene_context_menus_3d.SceneContextMenus3D scene3DContextMenus;
    hide completion.CompletionController completer;
    hide diagnostics.LiveDiagnostics liveDiag;
    hide semantic_tokens.SemanticHighlighter semHighlighter;
    hide hover.HoverController hoverCtrl;
    hide signature.SignatureController sigCtrl;
    hide inlay_hints.InlayHintController inlayCtrl;
    hide symbols.SymbolOutline symbolOutline;
    hide language_tool_frame.LanguageToolFrameController languageFrame;
    hide settings.SettingsManager appSettings;
    hide session.SessionManager sessionMgr;
    hide recovery_store.RecoveryStore recoveryStore;
    hide String startupFile;
    hide Integer restoredCount;
    hide Boolean restoreSplitRequested;
    hide workspace_watcher.WorkspaceWatcherState workspaceWatcherState;
    hide command_context.CommandContext commandContext;
    hide Integer prevDocCount;
    hide Boolean previousSceneSurfaceActive;
    hide Integer prevCursorLine;
    hide Integer prevCursorCol;
    hide Integer prevStatusRevision;
    hide Integer prevStatusLineCount;
    hide Integer prevStatusCursorCount;
    hide Boolean didPostFirstFrameActivate;
    hide Integer startupRepaintFrames;
    hide Integer autoSaveRevision;
    hide Integer autoSaveActiveIndex;
    hide Threads.Debouncer autoSaveDebounce;
    hide Integer recoveryRevision;
    hide Integer recoveryActiveIndex;
    hide Threads.Debouncer recoveryDebounce;
    hide scm_gutter_controller.ScmGutterController scmGutter;
    hide Integer scmGutterRevision;
    hide Threads.Debouncer scmGutterDebounce;
    hide Integer scmGutterActiveIndex;
    hide breadcrumb_index.IncrementalBreadcrumbIndex breadcrumbFunctions;
