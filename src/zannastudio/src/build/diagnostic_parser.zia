//
// File: zannastudio/src/build/diagnostic_parser.zia
// Purpose: Parse complete or streaming compiler diagnostics into Studio records.
// Key invariants:
//   - Stdout and stderr retain independent line carries across process chunks.
//   - Diagnostics are published before process completion and survive output truncation.
//   - Unterminated input and record counts remain explicitly bounded.
//   - Byte offsets returned by string searches are sliced with byte APIs.
// Ownership/Lifetime: Each build job owns one resettable stream parser.
// Links: zannastudio/src/build/build_system.zia,
//        zannastudio/src/build/diagnostic.zia
//
//===----------------------------------------------------------------------===//

module diagnostic_parser;

bind "diagnostic";

bind Json = Zanna.Data.Json;
bind Map = Zanna.Collections.Map;
bind Obj = Zanna.Core.Object;
bind Parse = Zanna.Core.Parse;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;
bind StringBuilder = Zanna.Text.StringBuilder;

final MAX_DIAGNOSTIC_STREAM_CARRY_BYTES = 4000000;
final MAX_DIAGNOSTIC_RECORDS = 5000;

// ============================================================================

/// @brief Stateful, per-stream incremental diagnostic parser.
/// @details Process chunks may divide one UTF-8 line arbitrarily. Stdout and
///          stderr carries stay separate so tagged output interleaving cannot
///          splice two unrelated compiler records together.
class DiagnosticStreamParser {
    expose List[diagnostic.Diagnostic] records;
    hide StringBuilder stdoutCarry;
    hide StringBuilder stderrCarry;
    expose Integer revision;
    expose Integer generation;
    expose Integer nextRecordId;
    expose Boolean truncated;
    expose Boolean recordLimitReached;
    expose Boolean carryLimitReached;

    expose func init() {
        Reset();
    }

    expose func Reset() {
        records = [];
        stdoutCarry = new StringBuilder();
        stderrCarry = new StringBuilder();
        revision = 0;
        generation = generation + 1;
        if generation <= 0 { generation = 1; }
        nextRecordId = 1;
        truncated = false;
        recordLimitReached = false;
        carryLimitReached = false;
    }

    /// @brief Consume one ordered output chunk and publish complete records.
    expose func Append(stream: String, text: String) {
        if text == "" { return; }
        if stream == "stderr" {
            Consume(stderrCarry, text);
        } else {
            Consume(stdoutCarry, text);
        }
    }

    /// @brief Parse final unterminated lines at a process-stage boundary.
    expose func Flush() {
        FlushCarry(stdoutCarry);
        FlushCarry(stderrCarry);
    }

    /// @brief Scan one chunk by byte cursor without rebuilding prior carry.
    hide func Consume(carry: StringBuilder, chunk: String) {
        if carry == null { return; }
        var lineStart = 1;
        var newline = Str.IndexOfFrom(chunk, lineStart, "\n");
        while newline > 0 {
            if newline > lineStart {
                carry.Append(Str.Substring(
                    chunk, lineStart - 1, newline - lineStart));
            }
            ConsumeLine(carry.ToString());
            carry.Clear();
            lineStart = newline + 1;
            newline = Str.IndexOfFrom(chunk, lineStart, "\n");
        }
        var chunkBytes = Str.get_Length(chunk);
        if lineStart <= chunkBytes {
            carry.Append(Str.Substring(
                chunk, lineStart - 1, chunkBytes - lineStart + 1));
        }
        if carry.Length > MAX_DIAGNOSTIC_STREAM_CARRY_BYTES {
            truncated = true;
            carryLimitReached = true;
            carry.Clear();
        }
    }

    hide func FlushCarry(carry: StringBuilder) {
        if carry == null or carry.Length <= 0 { return; }
        ConsumeLine(carry.ToString());
        carry.Clear();
    }

    hide func ConsumeLine(rawLine: String) {
        if records.count() >= MAX_DIAGNOSTIC_RECORDS {
            truncated = true;
            recordLimitReached = true;
            return;
        }
        var line = rawLine;
        var lineBytes = Str.get_Length(line);
        if lineBytes > 0
           and Str.Substring(line, lineBytes - 1, 1) == "\r" {
            line = Str.Substring(line, 0, lineBytes - 1);
        }
        var remaining = MAX_DIAGNOSTIC_RECORDS - records.count();
        var jsonResult = ParseJsonDiagnosticsBounded(
            line, records, remaining);
        if jsonResult.found {
            AssignStableIds(records.count() - jsonResult.addedCount);
            revision = revision + jsonResult.addedCount;
            if jsonResult.truncated {
                truncated = true;
                recordLimitReached = true;
            }
            return;
        }
        var diag = ParseDiagnosticLine(line);
        if diag != null {
            AssignStableId(diag!);
            records.add(diag!);
            revision = revision + 1;
        }
    }

    /// @brief Assign IDs to records appended by one bounded JSON decode.
    hide func AssignStableIds(firstIndex: Integer) {
        var index = firstIndex;
        if index < 0 { index = 0; }
        while index < records.count() {
            AssignStableId(records.get(index));
            index = index + 1;
        }
    }

    hide func AssignStableId(item: diagnostic.Diagnostic) {
        if item == null or item.stableId != "" { return; }
        item.stableId = "diagnostic:" + generation + ":" + nextRecordId;
        nextRecordId = nextRecordId + 1;
    }
}

/// @brief Bounded JSON-diagnostic decode outcome.
class JsonDiagnosticParseResult {
    expose Boolean found;
    expose Boolean truncated;
    expose Integer addedCount;

    expose func init() {
        found = false;
        truncated = false;
        addedCount = 0;
    }
}

// ============================================================================
// MODULE: diagnostic_parser
// PURPOSE: Parse Zanna CLI diagnostic output into Zanna Studio Diagnostic records.
//
// WHERE-THIS-FITS: BuildSystem owns process lifecycle and output collection.
//          This leaf module owns diagnostic extraction from captured text so the
//          build controller does not also carry parser-specific state machines.
//
// TEACHING-NOTE: Prefer structured JSON diagnostics when available, but keep
//          legacy text parsing as a fallback because installed toolchains and
//          older probe binaries can emit either shape.
// ============================================================================

/// @brief Parse all diagnostics from a captured compiler/build output buffer.
/// @param text Complete captured build output.
/// @return Diagnostic records parsed from JSON when present, otherwise legacy
///         `path:line:col: severity[code]: message` text lines.
expose func ParseDiagnostics(text: String) -> List[diagnostic.Diagnostic] {
    var records: List[diagnostic.Diagnostic] = [];
    var jsonResult = ParseJsonDiagnosticsBounded(
        text, records, MAX_DIAGNOSTIC_RECORDS);
    if jsonResult.found {
        return records;
    }

    var lineStart = 1;
    var newline = Str.IndexOfFrom(text, lineStart, "\n");
    var textBytes = Str.get_Length(text);
    while lineStart <= textBytes
          and records.count() < MAX_DIAGNOSTIC_RECORDS {
        var lineEnd = newline;
        if lineEnd == 0 { lineEnd = textBytes + 1; }
        var line = Str.Substring(
            text, lineStart - 1, lineEnd - lineStart);
        var diag = ParseDiagnosticLine(line);
        if diag != null {
            records.add(diag);
        }
        if newline == 0 { break; }
        lineStart = newline + 1;
        newline = Str.IndexOfFrom(text, lineStart, "\n");
    }
    return records;
}

/// @brief Parse `--diagnostic-format=json` output from the zanna CLI.
/// @details The CLI writes a compact object with a `diagnostics` array. This
///          parser accepts that object even when stdout/stderr wrappers add
///          text before or after it, and returns false so callers can fall
///          back to legacy text parsing when JSON is absent.
/// @param text Complete captured build output.
/// @param out Mutable list receiving parsed diagnostic records.
/// @return True when a JSON diagnostics object was found and consumed.
func ParseJsonDiagnosticsBounded(
    text: String,
    out: List[diagnostic.Diagnostic],
    maxRecords: Integer) -> JsonDiagnosticParseResult {
    var result = new JsonDiagnosticParseResult();
    var start = Str.IndexOf(text, "{\"diagnostics\"");
    if start == 0 { return result; }
    var endPos = JsonObjectEnd(text, start);
    if endPos <= 0 { return result; }
    var jsonText = Str.Substring(
        text, start - 1, endPos - start + 1);
    if Json.IsValid(jsonText) == false { return result; }

    var root = Json.Parse(jsonText);
    var records = Map.Get(root, "diagnostics") as Seq;
    if records == null { return result; }
    result.found = true;

    var limit = maxRecords;
    if limit < 0 { limit = 0; }
    var count = Seq.get_Count(records);
    var i = 0;
    while i < count and result.addedCount < limit {
        var record = Seq.Get(records, i);
        var diag = DiagnosticFromJsonRecord(record);
        if diag != null {
            out.add(diag);
            result.addedCount = result.addedCount + 1;
        }
        i = i + 1;
    }
    if i < count { result.truncated = true; }
    return result;
}

/// @brief Find the balanced end of a JSON object embedded in process output.
/// @details Compiler diagnostics may be preceded or followed by human text,
///          and that trailing text can contain braces. This scanner respects
///          JSON strings and escapes so the first complete object is extracted
///          instead of slicing to the last brace.
/// @param text Complete captured process output.
/// @param start One-based index of the opening `{`.
/// @return One-based index of the matching `}`, or 0 when incomplete.
func JsonObjectEnd(text: String, start: Integer) -> Integer {
    var depth = 0;
    var inString = false;
    var escaped = false;
    var pos = start;
    while pos <= Str.get_Length(text) {
        var ch = Str.Substring(text, pos - 1, 1);
        if inString {
            if escaped {
                escaped = false;
            } else if ch == "\\" {
                escaped = true;
            } else if ch == "\"" {
                inString = false;
            }
        } else {
            if ch == "\"" {
                inString = true;
            } else if ch == "{" {
                depth = depth + 1;
            } else if ch == "}" {
                depth = depth - 1;
                if depth == 0 { return pos; }
            }
        }
        pos = pos + 1;
    }
    return 0;
}

/// @brief Convert one CLI JSON diagnostic record to the IDE diagnostic model.
/// @details Prefer the primary location object, then fall back to the range
///          begin object because some diagnostics only have concrete ranges.
func DiagnosticFromJsonRecord(record: Any) -> diagnostic.Diagnostic? {
    if record == null { return null; }
    var loc = Map.Get(record, "location");
    var range = Map.Get(record, "range");
    var path = "";
    var lineNo = 0;
    var colNo = 0;
    if loc != null {
        path = Map.GetStr(loc, "file");
        lineNo = Map.GetInt(loc, "line");
        colNo = Map.GetInt(loc, "column");
    }
    if path == "" or lineNo <= 0 or colNo <= 0 {
        if range != null {
            var begin = Map.Get(range, "begin");
            if begin != null {
                path = Map.GetStr(begin, "file");
                lineNo = Map.GetInt(begin, "line");
                colNo = Map.GetInt(begin, "column");
            }
        }
    }
    if path == "" or lineNo <= 0 or colNo <= 0 { return null; }

    var diag = new diagnostic.Diagnostic();
    diag.filePath = path;
    diag.line = lineNo;
    diag.column = colNo;
    diag.endLine = lineNo;
    diag.endColumn = colNo + 1;
    if range != null {
        var endLoc = Map.Get(range, "end");
        if endLoc != null {
            var parsedEndLine = Map.GetInt(endLoc, "line");
            var parsedEndColumn = Map.GetInt(endLoc, "column");
            if parsedEndLine > 0 and parsedEndColumn > 0 {
                diag.endLine = parsedEndLine;
                diag.endColumn = parsedEndColumn;
            }
        }
    }
    var sev = Map.GetStr(record, "severity");
    diag.severity = diagnostic.SEV_ERROR;
    if sev == "warning" {
        diag.severity = diagnostic.SEV_WARNING;
    } else if sev == "note" or sev == "info" {
        diag.severity = diagnostic.SEV_INFO;
    }
    diag.code = Map.GetStr(record, "code");
    diag.message = Map.GetStr(record, "message");
    var notes = Map.Get(record, "notes") as Seq;
    if notes != null {
        diag.noteCount = Seq.get_Count(notes);
        if diag.noteCount > 0 {
            diag.noteSummary = Map.GetStr(Seq.Get(notes, 0), "message");
        }
    }
    var fixits = Map.Get(record, "fixits") as Seq;
    if fixits != null {
        diag.fixitCount = Seq.get_Count(fixits);
        if diag.fixitCount > 0 {
            diag.fixitMessage = Map.GetStr(Seq.Get(fixits, 0), "message");
            if diag.fixitMessage == "" {
                diag.fixitMessage = Map.GetStr(Seq.Get(fixits, 0), "label");
            }
        }
    }
    return diag;
}

/// @brief Parse one legacy compiler diagnostic line.
/// @param line Text in `path:line:col: error[code]: message` form.
/// @return A Diagnostic record, or null when the line is not diagnostic text.
expose func ParseDiagnosticLine(line: String) -> diagnostic.Diagnostic? {
    var severity = "error";
    var sevPos = Str.IndexOf(line, ": error[");
    if sevPos == 0 {
        sevPos = Str.IndexOf(line, ": warning[");
        severity = "warning";
    }
    if sevPos == 0 { return null; }

    var before = Str.Substring(line, 0, sevPos - 1);
    var codeStart = sevPos + Str.get_Length(": " + severity + "[");
    var msgSep = Str.IndexOfFrom(line, codeStart, "]: ");
    if msgSep == 0 { return null; }
    var code = Str.Substring(
        line, codeStart - 1, msgSep - codeStart);
    var msgOffset = msgSep + 2;
    var msg = Str.Substring(
        line, msgOffset, Str.get_Length(line) - msgOffset);

    var colSep = Str.LastIndexOf(before, ":");
    if colSep <= 0 { return null; }
    var colText = Str.Substring(
        before, colSep, Str.get_Length(before) - colSep);
    var pathAndLine = Str.Substring(before, 0, colSep - 1);
    var lineSep = Str.LastIndexOf(pathAndLine, ":");
    if lineSep <= 0 { return null; }
    var lineText = Str.Substring(
        pathAndLine, lineSep, Str.get_Length(pathAndLine) - lineSep);
    var path = Str.Substring(pathAndLine, 0, lineSep - 1);
    var lineNo = Parse.IntOr(lineText, 0);
    var colNo = Parse.IntOr(colText, 0);
    if path == "" or lineNo <= 0 or colNo <= 0 { return null; }

    var diag = new diagnostic.Diagnostic();
    diag.filePath = path;
    diag.line = lineNo;
    diag.column = colNo;
    diag.endLine = lineNo;
    diag.endColumn = colNo + 1;
    diag.severity = diagnostic.SEV_ERROR;
    if severity == "warning" {
        diag.severity = diagnostic.SEV_WARNING;
    }
    diag.code = code;
    diag.message = msg;
    return diag;
}
