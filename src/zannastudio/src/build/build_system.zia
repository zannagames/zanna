//
// File: zannastudio/src/build/build_system.zia
// Purpose: Own bounded asynchronous build/run process state and output.
// Key invariants:
//   - Invalid launch configurations fail before a process is created.
//   - Process output and deltas remain within explicit memory ceilings.
//   - Multi-stage jobs retain one output/diagnostic/timing chain.
//   - Every terminal path drains, destroys, and publishes one typed result.
// Ownership/Lifetime: BuildSystem owns active process handles and output state.
// Links: zannastudio/src/build/run_config.zia,
//        zannastudio/src/build/bounded_output.zia
//
//===----------------------------------------------------------------------===//

module build_system;

bind "bounded_output";
bind "diagnostic";
bind "diagnostic_parser";
bind "diagnostic_publication";
bind "executable_resolver";
bind "run_config";
bind "../services/process_reaper";
bind Zanna.Collections.Seq as Seq;
bind Zanna.Collections.Map as Map;
bind Zanna.System.Process as Process;
bind Zanna.GUI as GUI;
bind StringBuilder = Zanna.Text.StringBuilder;

// ============================================================================
// MODULE: build_system
// PURPOSE: Compile and run Zia/BASIC programs from the IDE.
//
// WHERE-THIS-FITS: Build and debug command handlers create jobs here; main.zia
//          pumps UpdateJob every frame and AppShell renders the streamed output.
//
// TEACHING-NOTE: Build/run processes are long-lived external state. Keep process
//          handles, output deltas, cancellation, and elapsed time together so
//          command handlers remain thin request initiators. Pure parsing and
//          buffer policies live in sibling leaf modules.
// ============================================================================

final MAX_BUILD_OUTPUT_CHARS = 250000;
final MAX_BUILD_OUTPUT_DELTA_CHARS = 65536;

/// @brief Immutable terminal snapshot consumed by the Studio frame loop.
class BuildJobResult {
    expose Boolean success;
    expose Boolean stopped;
    expose Integer exitCode;
    expose String action;
    expose String name;
    expose String duration;
    expose String output;
    expose Integer errorCount;
    expose Integer warningCount;

    expose func init() {
        success = false;
        stopped = false;
        exitCode = -1;
        action = "";
        name = "";
        duration = "";
        output = "";
        errorCount = 0;
        warningCount = 0;
    }
}

class BuildSystem {
    // Build state
    expose Boolean isBuilding;
    expose Boolean isRunning;
    expose Boolean lastBuildSuccess;

    // Build output
    expose String buildOutput;
    expose String outputDelta;
    expose String compilerPath;

    // Build timing ("1.2s" after last build)
    expose String lastBuildTime;
    expose Integer startMs;
    expose Integer exitCode;
    expose String activeAction;
    expose String activeName;
    expose run_config.RunConfig activeConfig;
    expose Process.ProcessHandle processHandle;
    expose BuildJobResult completedResult;
    expose diagnostic_parser.DiagnosticStreamParser diagnosticStream;
    expose Integer reportedDiagnosticRevision;
    hide diagnostic_publication.DiagnosticPublicationCursor publicationCursor;
    expose Boolean diagnosticTruncationReported;
    expose process_reaper.ProcessReaper processReaper;
    hide GUI.App wakeApp;
    hide Boolean activityWakeAttached;

    // Parsed diagnostics
    expose List[diagnostic.Diagnostic] diagnostics;

    expose func init() {
        isBuilding = false;
        isRunning = false;
        lastBuildSuccess = false;
        buildOutput = "";
        outputDelta = "";
        compilerPath = "zanna";
        lastBuildTime = "";
        startMs = 0;
        exitCode = -1;
        activeAction = "";
        activeName = "";
        activeConfig = null;
        processHandle = null;
        completedResult = null;
        diagnosticStream = new diagnostic_parser.DiagnosticStreamParser();
        reportedDiagnosticRevision = 0;
        publicationCursor = new diagnostic_publication.DiagnosticPublicationCursor();
        diagnosticTruncationReported = false;
        processReaper = new process_reaper.ProcessReaper();
        wakeApp = null;
        activityWakeAttached = false;
        diagnostics = [];
    }

    /// @brief Select the App whose native wait receives process activity wakes.
    expose func SetWakeApp(value: GUI.App) { wakeApp = value; }

    /// @brief Report whether active process I/O still needs timer polling.
    expose func NeedsActivityPolling() -> Boolean {
        return IsActive() and activityWakeAttached == false;
    }

    expose func IsActive() -> Boolean {
        return isBuilding or isRunning;
    }

    expose func StartConfig(cfg: run_config.RunConfig) -> Boolean {
        if cfg == null or IsActive() { return false; }
        return StartStage(cfg, false);
    }

    /// @brief Launch one stage, optionally preserving the owning job chain.
    func StartStage(cfg: run_config.RunConfig,
                    preserveChain: Boolean) -> Boolean {
        if cfg == null { return false; }

        activeConfig = cfg;
        activeAction = cfg.action;
        activeName = cfg.name;
        if preserveChain == false {
            buildOutput = "";
            outputDelta = "";
            diagnosticStream.Reset();
            diagnostics = diagnosticStream.records;
            reportedDiagnosticRevision = 0;
            diagnosticTruncationReported = false;
            completedResult = null;
            startMs = Zanna.Time.Clock.NowMs();
        }
        exitCode = -1;
        lastBuildSuccess = false;
        lastBuildTime = "";

        if cfg.action == run_config.ACTION_BUILD {
            isBuilding = true;
            isRunning = false;
        } else {
            isBuilding = false;
            isRunning = true;
        }

        if cfg.validationError != "" {
            AppendOutput("Invalid run configuration: " + cfg.validationError + "\n");
            FinalizeJob(-1, false);
            return false;
        }

        // The Process runtime spawns via execve(), which neither searches PATH nor
        // resolves a bare name against anything except the child's working directory
        // (the edited file's folder). Resolve an absolute path up front so a build
        // actually starts, and report a precise error instead of a silent exit 127.
        var resolution = executable_resolver.Resolve(
            cfg.program, cfg.workingDirectory);
        if resolution.IsResolved() == false {
            AppendOutput(resolution.error);
            FinalizeJob(-1, false);
            return false;
        }
        compilerPath = resolution.path;

        // Run/build configuration variables are overrides, not a hermetic
        // environment. Preserve PATH, locale, proxy/certificate settings, and
        // platform loader state; embedded Play otherwise launched with only its
        // two ZANNA_* variables and could fail before producing a frame.
        processHandle = Process.StartWithEnvOverlay(
            resolution.path, cfg.args, cfg.workingDirectory, cfg.env);
        if processHandle == null or processHandle.IsValid() == false {
            AppendOutput("Could not start process: " + cfg.program + "\n");
            FinalizeJob(-1, false);
            return false;
        }
        activityWakeAttached = wakeApp != null
            and wakeApp.WatchProcess(processHandle);
        return true;
    }

    /// @brief Resolve a runnable path through the shared typed resolver.
    expose func ResolveCompiler(preferred: String) -> String {
        return executable_resolver.Resolve(preferred, "").path;
    }

    expose func ResolveProgram(preferred: String,
                               workingDirectory: String) -> String {
        return executable_resolver.Resolve(
            preferred, workingDirectory).path;
    }

    expose func Update() -> Boolean {
        processReaper.Pump();
        if processHandle == null { return false; }
        DrainProcessOutput();

        if processHandle.IsRunning() {
            return true;
        }
        DrainProcessOutput();
        var finishedCode = processHandle.ExitCode();
        // A successful stage hands off to its continuation in the same
        // job slot (build-then-launch chains, ADR 0225).
        if finishedCode == 0 and activeConfig != null
           and activeConfig.next != null {
            var continuation = activeConfig.next;
            ReleaseProcessHandle();
            diagnosticStream.Flush();
            diagnostics = diagnosticStream.records;
            AppendOutput("\n[stage] " + continuation.name + "\n");
            if StartStage(continuation, true) { return true; }
            return false;
        }
        FinalizeJob(finishedCode, false);
        return false;
    }

    expose func Stop() -> Boolean {
        if processHandle == null { return false; }
        var killed = processHandle.Kill();
        AppendOutput("\n[stopped]\n");
        FinalizeJob(-1, true);
        return killed;
    }

    /// @brief Drain both streams through one parser/output path.
    func DrainProcessOutput() {
        if processHandle == null { return; }
        var result = processHandle.ReadOutputResult();
        var chunks = Map.Get(result, "chunks");
        var frameOutput = new StringBuilder();
        var i = 0;
        while chunks != null and i < Seq.get_Count(chunks) {
            var chunk = Seq.Get(chunks, i);
            var streamName = Map.GetStr(chunk, "stream");
            var text = Map.GetStr(chunk, "text");
            frameOutput.Append(text);
            diagnosticStream.Append(streamName, text);
            i = i + 1;
        }
        AppendOutput(frameOutput.ToString());
        diagnostics = diagnosticStream.records;
        ReportDiagnosticTruncation();
        if Map.GetBool(result, "truncated") {
            AppendOutput("\n[ordered process output truncated by runtime]\n");
        }
    }

    func AppendOutput(text: String) {
        if text == "" { return; }
        buildOutput = bounded_output.Append(buildOutput, text,
                                            "[output truncated]\n",
                                            MAX_BUILD_OUTPUT_CHARS);
        outputDelta = bounded_output.Append(outputDelta, text,
                                            "[output delta truncated]\n",
                                            MAX_BUILD_OUTPUT_DELTA_CHARS);
    }

    /// @brief Publish parser limits once in the durable build output.
    func ReportDiagnosticTruncation() {
        if diagnosticTruncationReported or diagnosticStream.truncated == false {
            return;
        }
        diagnosticTruncationReported = true;
        if diagnosticStream.recordLimitReached {
            AppendOutput("\n[diagnostics truncated: showing the first "
                         + diagnostic_parser.MAX_DIAGNOSTIC_RECORDS
                         + " records]\n");
        } else {
            AppendOutput("\n[diagnostic record discarded: unterminated input exceeded "
                         + diagnostic_parser.MAX_DIAGNOSTIC_STREAM_CARRY_BYTES
                         + " bytes]\n");
        }
    }

    /// @brief Release the active runtime handle exactly once.
    func ReleaseProcessHandle() {
        if processHandle == null { return; }
        processReaper.RetireProcess(processHandle);
        processHandle = null;
        activityWakeAttached = false;
    }

    /// @brief Stop active work and drain handle-only destruction workers.
    expose func Shutdown() -> Boolean {
        if IsActive() { Stop(); }
        return processReaper.WaitForShutdown();
    }

    /// @brief Unified terminal path for launch failure, exit, and cancellation.
    func FinalizeJob(code: Integer,
                     stopped: Boolean) {
        DrainProcessOutput();
        ReleaseProcessHandle();
        diagnosticStream.Flush();
        diagnostics = diagnosticStream.records;
        ReportDiagnosticTruncation();
        exitCode = code;
        isBuilding = false;
        isRunning = false;
        lastBuildSuccess = code == 0;
        lastBuildTime = FormatDuration(Zanna.Time.Clock.NowMs() - startMs);
        var result = new BuildJobResult();
        result.success = lastBuildSuccess;
        result.stopped = stopped;
        result.exitCode = code;
        result.action = activeAction;
        result.name = activeName;
        result.duration = lastBuildTime;
        result.output = buildOutput;
        result.errorCount = GetErrorCount();
        result.warningCount = GetWarningCount();
        completedResult = result;
    }

    /// @brief Format an elapsed millisecond count as a readable duration: "850ms"
    ///        under a second, "1.2s" at or above one second (rounded to a tenth).
    expose func FormatDuration(ms: Integer) -> String {
        var millis = ms;
        if millis < 0 { millis = 0; }
        if millis < 1000 { return "" + millis + "ms"; }
        var tenths = (millis + 50) / 100;
        var whole = tenths / 10;
        var frac = tenths - whole * 10;
        return "" + whole + "." + frac + "s";
    }

    expose func ParseDiagnosticLine(line: String) -> diagnostic.Diagnostic? {
        return diagnostic_parser.ParseDiagnosticLine(line);
    }

    /// @brief Consume the typed completion snapshot once.
    expose func TakeCompletedResult() -> BuildJobResult? {
        var result = completedResult;
        completedResult = null;
        return result;
    }

    /// @brief Report whether streaming diagnostics changed since the last take.
    expose func TakeDiagnosticsChanged() -> Boolean {
        if diagnosticStream.revision == reportedDiagnosticRevision { return false; }
        reportedDiagnosticRevision = diagnosticStream.revision;
        return true;
    }

    /// @brief Begin one UI publication generation after a new root job.
    /// @return True exactly once when callers must retire prior Problems rows.
    expose func TakeDiagnosticPublicationReset() -> Boolean {
        return publicationCursor.TakeReset(diagnosticStream.generation);
    }

    /// @brief Index of the first diagnostic not yet published to Problems.
    expose func FirstUnpublishedDiagnosticIndex() -> Integer {
        return publicationCursor.FirstUnpublished(
            diagnosticStream.generation, diagnostics.count());
    }

    /// @brief Commit all currently parsed diagnostics as published.
    expose func MarkDiagnosticsPublished() {
        publicationCursor.MarkPublished(
            diagnosticStream.generation, diagnostics.count());
    }

    // Get the number of errors.
    expose func GetErrorCount() -> Integer {
        var count = 0;
        var i = 0;
        while i < diagnostics.count() {
            var diag = diagnostics.get(i);
            if diag.severity == 0 {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    // Get the number of warnings.
    expose func GetWarningCount() -> Integer {
        var count = 0;
        var i = 0;
        while i < diagnostics.count() {
            var diag = diagnostics.get(i);
            if diag.severity == 1 {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    // Get the build output text.
    expose func GetOutput() -> String {
        return buildOutput;
    }

    expose func TakeOutputDelta() -> String {
        var delta = outputDelta;
        outputDelta = "";
        return delta;
    }

    // Get the elapsed time of the last build ("1.2s").
    expose func GetBuildTime() -> String {
        return lastBuildTime;
    }

    // Clear diagnostics.
    expose func ClearDiagnostics() {
        diagnostics = [];
    }
}
