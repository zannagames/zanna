//
// File: zannastudio/src/build/run_config.zia
// Purpose: Resolve project/document build and run requests into argv configs.
// Key invariants:
//   - Argument parsing never invokes a shell or consumes literal path backslashes.
//   - Unmatched quotes fail closed before default arguments are synthesized.
// Ownership/Lifetime: Each RunConfig owns its argument/environment snapshots.
// Links: zannastudio/src/build/build_system.zia,
//        zannastudio/src/core/project.zia
//
//===----------------------------------------------------------------------===//

module run_config;

bind "../core/document";
bind "../core/project_manager";
bind "../services/file_utils";

bind Seq = Zanna.Collections.Seq;
bind Obj = Zanna.Core.Object;
bind Path = Zanna.IO.Path;
bind Str = Zanna.String;

final ACTION_BUILD = "build";
final ACTION_RUN = "run";
final KIND_CURRENT_FILE = "current-file";
final KIND_PROJECT_ENTRY = "project-entry";
final KIND_CUSTOM = "custom";

// ============================================================================
// MODULE: run_config
// PURPOSE: Convert an active document/project manifest into build/run argv.
//
// WHERE-THIS-FITS: Command handlers ask this module what to run; BuildSystem
//          owns process launch. Keeping target selection here prevents build
//          commands from duplicating project-entry and custom-argv policy.
//
// TEACHING-NOTE: Build and run commands are argument vectors, not shell strings.
//          Preserve quoting and `{target}` expansion here so process code can
//          execute exactly what the project model describes.
// ============================================================================

class RunConfig {
    expose String name;
    expose String action;
    expose String kind;
    expose String program;
    expose Any args;
    expose String workingDirectory;
    expose Any env;
    expose String problemMatcher;
    expose String targetPath;
    expose String validationError;
    /// Optional continuation started when this config exits 0 (ADR 0225).
    expose RunConfig next;

    expose func init() {
        name = "";
        action = ACTION_RUN;
        kind = KIND_CURRENT_FILE;
        program = "zanna";
        args = Seq.New();
        workingDirectory = "";
        env = null;
        problemMatcher = "zanna";
        targetPath = "";
        validationError = "";
        next = null;
    }
}

/// @brief Build-then-launch chain for native run-profile scenes (ADR 0225).
/// @details Stage 1 builds the project into a per-project run directory;
///          stage 2 launches the produced binary with the scene under
///          --scene-watch. Callers may skip stage 1 when the binary is
///          fresh by starting from `.next` directly.
expose func ForNativeScene(projectRoot: String,
                           projectName: String,
                           scenePath: String,
                           binaryPath: String,
                           extraEnv: Any) -> RunConfig {
    var build = new RunConfig();
    build.name = "Build " + projectName;
    build.action = ACTION_BUILD;
    build.kind = KIND_PROJECT_ENTRY;
    build.program = "zanna";
    build.args = Seq.New();
    Seq.Push(build.args, "build");
    Seq.Push(build.args, projectRoot);
    Seq.Push(build.args, "--build-profile");
    Seq.Push(build.args, "release");
    Seq.Push(build.args, "-o");
    Seq.Push(build.args, binaryPath);
    build.workingDirectory = projectRoot;

    var launch = new RunConfig();
    launch.name = "Run " + projectName + " (native)";
    launch.action = ACTION_RUN;
    launch.kind = KIND_PROJECT_ENTRY;
    launch.program = binaryPath;
    launch.args = Seq.New();
    Seq.Push(launch.args, "--scene");
    Seq.Push(launch.args, scenePath);
    Seq.Push(launch.args, "--scene-watch");
    launch.workingDirectory = projectRoot;
    launch.env = extraEnv;
    launch.targetPath = scenePath;

    build.next = launch;
    return build;
}

func ForDocument(action: String,
                 doc: document.Document,
                 projMgr: project_manager.ProjectManager) -> RunConfig {
    var cfg = new RunConfig();
    cfg.action = action;
    if action == ACTION_BUILD {
        cfg.name = "Build";
    } else {
        cfg.name = "Run";
    }

    var root = "";
    var lang = "";
    if doc != null {
        lang = doc.language;
    }
    if projMgr != null and projMgr.project != null and projMgr.project.isOpen {
        root = projMgr.project.rootPath;
        lang = projMgr.project.lang;
        cfg.kind = KIND_PROJECT_ENTRY;
        cfg.targetPath = root;
        cfg.workingDirectory = root;
        cfg.problemMatcher = "zanna";
        ApplyProjectOverrides(cfg, projMgr);
    } else if doc != null {
        cfg.kind = KIND_CURRENT_FILE;
        cfg.targetPath = doc.filePath;
        cfg.workingDirectory = Path.Directory(doc.filePath);
    }

    if cfg.program == "" { cfg.program = "zanna"; }
    if cfg.validationError == "" and Seq.get_Count(cfg.args) == 0 {
        if action == ACTION_BUILD {
            Seq.Push(cfg.args, "build");
        } else {
            Seq.Push(cfg.args, "run");
        }
        if cfg.program == "zanna" {
            Seq.Push(cfg.args, "--diagnostic-format=json");
        }
        Seq.Push(cfg.args, cfg.targetPath);
    }
    if lang == "basic" and cfg.kind == KIND_CURRENT_FILE and cfg.program == "zanna" {
        // zanna run/build handles BASIC directly; keep this branch explicit so
        // project configs can override BASIC without changing call sites.
    }
    return cfg;
}

func ApplyProjectOverrides(cfg: RunConfig,
                           projMgr: project_manager.ProjectManager) {
    if projMgr == null or projMgr.project == null { return; }
    var proj = projMgr.project;
    if proj.problemMatcher != "" {
        cfg.problemMatcher = proj.problemMatcher;
    }
    if proj.workingDirectory != "" {
        cfg.workingDirectory = Path.Join(proj.rootPath, proj.workingDirectory);
    }
    if cfg.action == ACTION_BUILD {
        if proj.buildProgram != "" { cfg.program = proj.buildProgram; }
        if proj.buildArgs != "" {
            var buildArgs = SplitArgsWithTarget(proj.buildArgs, cfg.targetPath);
            if buildArgs == null {
                cfg.validationError = "Build arguments contain an unmatched quote.";
                cfg.args = Seq.New();
            } else {
                cfg.args = buildArgs;
            }
            cfg.kind = KIND_CUSTOM;
        }
    } else {
        if proj.runProgram != "" { cfg.program = proj.runProgram; }
        if proj.runArgs != "" {
            var runArgs = SplitArgsWithTarget(proj.runArgs, cfg.targetPath);
            if runArgs == null {
                cfg.validationError = "Run arguments contain an unmatched quote.";
                cfg.args = Seq.New();
            } else {
                cfg.args = runArgs;
            }
            cfg.kind = KIND_CUSTOM;
        }
    }
}

func SplitArgsWithTarget(text: String, targetPath: String) -> Any {
    var items = SplitArgs(text);
    if items == null { return null; }
    var out = Seq.New();
    var i = 0;
    while i < Seq.get_Count(items) {
        var item = Obj.ToString(Seq.Get(items, i));
        if item == "{target}" {
            item = targetPath;
        }
        Seq.Push(out, item);
        i = i + 1;
    }
    return out;
}

/// @brief Split a project run/build argument string into an argv sequence.
/// @details Supports whitespace-delimited tokens, single and double quoted
///          spans, and targeted backslash escapes for whitespace and quotes.
///          Other backslashes remain literal so Windows drive and UNC paths
///          round-trip without invoking a shell or platform command parser.
///          Empty quoted tokens are retained and unmatched quotes fail closed.
/// @param text User-authored argument string from zanna.project.
/// @return Seq of argv tokens with quotes removed, or null for unmatched quotes.
func SplitArgs(text: String) -> Any {
    var items = Seq.New();
    var token = "";
    var quote = "";
    var tokenStarted = false;
    var i = 1;
    while i <= Str.get_Length(text) {
        var ch = Str.MidLen(text, i, 1);
        if ch == "\\" {
            if i < Str.get_Length(text) {
                var next = Str.MidLen(text, i + 1, 1);
                if next == " " or next == "\t" or next == "\"" or next == "'" {
                    token = token + next;
                    tokenStarted = true;
                    i = i + 1;
                } else {
                    token = token + "\\";
                    tokenStarted = true;
                }
            } else {
                token = token + "\\";
                tokenStarted = true;
            }
        } else if ch == "\"" or ch == "'" {
            if quote == "" {
                quote = ch;
                tokenStarted = true;
            } else if quote == ch {
                quote = "";
            } else {
                token = token + ch;
            }
        } else if (ch == " " or ch == "\t") and quote == "" {
            if tokenStarted {
                Seq.Push(items, token);
                token = "";
                tokenStarted = false;
            }
        } else {
            token = token + ch;
            tokenStarted = true;
        }
        i = i + 1;
    }
    if quote != "" { return null; }
    if tokenStarted {
        Seq.Push(items, token);
    }
    return items;
}
