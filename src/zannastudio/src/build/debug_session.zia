//
// File: zannastudio/src/build/debug_session.zia
// Purpose: Own the asynchronous VM debug-adapter process and paused-state data.
// Key invariants:
//   - Adapter I/O and variable expansion never block the Studio frame loop.
//   - Variable references and child caches are invalidated whenever execution resumes.
// Ownership/Lifetime:
//   - DebugSession owns the child process handle and all parsed adapter snapshots.
//   - VarTreeState owns copied child records; adapter event maps remain transient.
// Links: zannastudio/src/commands/debug_commands.zia,
//        zannastudio/src/build/var_model.zia
//
//===----------------------------------------------------------------------===//

module debug_session;

bind "bounded_output";
bind "var_model";
bind "debug_session_view" as View;

bind Json = Zanna.Data.Json;
bind Map = Zanna.Collections.Map;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;

// ============================================================================
// MODULE: debug_session
// PURPOSE: Drive the out-of-process VM debug adapter.
//
// WHERE-THIS-FITS: debug_commands starts and controls the session. main.zia pumps
//          DebugUpdate every frame. AppShell renders call stack, variables, debug
//          console output, and toolbar enablement from this state.
//
// TEACHING-NOTE: Debugging is asynchronous. Commands are written to the adapter
//          stdin as newline JSON, then matching events arrive later on stderr
//          with the "@@VDBG@@ " sentinel. Polling keeps this explicit and avoids
//          callback state hidden outside the frame loop.
// ============================================================================

final SENTINEL = "@@VDBG@@ ";
final MAX_DEBUG_OUTPUT_CHARS = 250000;
final TERMINATE_GRACE_MS = 750;
final VARIABLE_REQUEST_TIMEOUT_MS = 2000;
final MAX_DEBUG_CONTROL_CARRY_BYTES = 1024 * 1024;

class DebugSession extends View.DebugSessionViewLayer {
    expose func init() {
        InitializeState();
    }

    /// @brief Drain program output + control events. Returns true on a state change.
    expose func Poll() -> Boolean {
        processReaper.Pump();
        if processHandle == null { return false; }
        dirty = false;

        FlushAdapterInput();
        drainProcessOutput();
        if pendingVarPath != "" and variableRequestCountdown.get_IsExpired() {
            failedVarPath = pendingVarPath;
            pendingVarPath = "";
            pendingVarRef = 0;
            if expectedVariableRequestId == pendingVarRequestId {
                expectedVariableRequestId = 0;
            }
            pendingVarRequestId = 0;
            variableRequestCountdown.Reset();
            dirty = true;
        }
        if pendingManualEvalRequestId > 0
           and manualEvalCountdown.get_IsExpired() {
            lastEvalExpr = pendingManualEvalExpr;
            lastEvalValue = "(timed out)";
            lastEvalType = "";
            lastEvalOk = false;
            evalJustArrived = true;
            pendingManualEvalExpr = "";
            pendingManualEvalRequestId = 0;
            manualEvalCountdown.Reset();
            dirty = true;
        }
        if watchRequestActive and watchRequestCountdown.get_IsExpired() {
            ExpireWatchRequest();
        }
        if terminateRequested and terminated == false and processHandle.IsRunning()
           and terminateCountdown.get_IsExpired() {
            processHandle.Kill();
            dirty = true;
        }

        if processHandle.IsRunning() == false {
            // Final drain after the child exited.
            AppendStdoutResult(processHandle.ReadStdoutResult());
            AppendStderrResult(processHandle.ReadStderrResult());
            if terminated == false {
                exitCode = processHandle.ExitCode();
                terminated = true;
                stopped = false;
                hasSession = false;
                terminateRequested = false;
                lastType = "terminated";
                if lastReason == "" { lastReason = "exit"; }
                dirty = true;
            } else {
                stopped = false;
                hasSession = false;
                terminateRequested = false;
            }
            ClearStopSnapshot();
            ClearWatchValues();
            ReleaseProcessHandle();
        }
        return dirty;
    }

    /// @brief Drain stdout and debug-adapter stderr without changing process state.
    /// @details Used by both the frame pump and the graceful terminate path so
    ///          shutdown messages are not lost when Stop is clicked.
    hide func drainProcessOutput() {
        if processHandle == null { return; }
        AppendStdoutResult(processHandle.ReadStdoutResult());
        AppendStderrResult(processHandle.ReadStderrResult());
    }

    hide func AppendStdoutResult(result: Any) {
        if result == null { return; }
        var out = Map.GetStr(result, "text");
        if out != "" {
            programOutput = AppendBoundedOutput(programOutput, out);
            dirty = true;
        }
        if Map.GetBool(result, "truncated") {
            programOutput = AppendBoundedOutput(programOutput,
                                                "\n[debug stdout truncated by runtime]\n");
            dirty = true;
        }
    }

    hide func AppendStderrResult(result: Any) {
        if result == null { return; }
        var err = Map.GetStr(result, "text");
        AcceptAdapterControlText(err);
        if Map.GetBool(result, "truncated") {
            programOutput = AppendBoundedOutput(programOutput,
                                                "\n[debug stderr truncated by runtime]\n");
            dirty = true;
        }
    }

    /// @brief Consume one arbitrary byte chunk from the adapter's stderr stream.
    /// @details Complete records and the unterminated carry are bounded before
    ///          JSON parsing. Keeping this as a narrow input seam also lets the
    ///          headless debugger probe exercise malformed framing without a
    ///          test-only process implementation.
    expose func AcceptAdapterControlText(text: String) {
        if text == "" { return; }
        ctrlBuf = ctrlBuf + text;
        drainControlLines();
        if Str.get_Length(ctrlBuf) > MAX_DEBUG_CONTROL_CARRY_BYTES {
            ctrlBuf = "";
            ReportProtocolDiagnostic("oversized debug control line discarded");
        }
    }

    hide func drainControlLines() {
        var lineStart = 1;
        var nl = Str.IndexOfFrom(ctrlBuf, lineStart, "\n");
        while nl != 0 {
            var lineBytes = nl - lineStart;
            if lineBytes > MAX_DEBUG_CONTROL_CARRY_BYTES {
                ReportProtocolDiagnostic("oversized debug control line discarded");
            } else {
                var line = Str.Substring(ctrlBuf, lineStart - 1, lineBytes);
                handleLine(line);
            }
            lineStart = nl + 1;
            nl = Str.IndexOfFrom(ctrlBuf, lineStart, "\n");
        }
        var remaining = Str.get_Length(ctrlBuf) - lineStart + 1;
        if remaining <= 0 {
            ctrlBuf = "";
        } else if lineStart > 1 {
            ctrlBuf = Str.Substring(ctrlBuf, lineStart - 1, remaining);
        }
    }

    hide func handleLine(line: String) {
        if line == "" { return; }
        if Str.StartsWith(line, SENTINEL) {
            var prefixBytes = Str.get_Length(SENTINEL);
            var lineBytes = Str.get_Length(line);
            handleEvent(Str.Substring(line, prefixBytes,
                                      lineBytes - prefixBytes));
        } else {
            // Raw program stderr or trap text: show it as output.
            programOutput = AppendBoundedOutput(programOutput, line + "\n");
            dirty = true;
        }
    }

    /// @brief Publish one bounded, visible adapter-protocol diagnostic.
    hide func ReportProtocolDiagnostic(message: String) {
        programOutput = AppendBoundedOutput(
            programOutput, "\n[" + message + "]\n");
        dirty = true;
    }

    /// @brief Append debug output while preserving a bounded console history.
    /// @details Debug sessions can run indefinitely and stream unbounded stdout or
    ///          stderr. Keeping only the newest history avoids quadratic string
    ///          growth in long IDE sessions while making truncation visible.
    /// @param existing Existing console buffer.
    /// @param text Newly read process output.
    /// @return Combined buffer, trimmed to MAX_DEBUG_OUTPUT_CHARS when needed.
    hide func AppendBoundedOutput(existing: String, text: String) -> String {
        return bounded_output.Append(existing, text,
                                     "[debug output truncated]\n",
                                     MAX_DEBUG_OUTPUT_CHARS);
    }

    /// @brief Clear only user-program stdout/stderr retained by this session.
    /// @details Debugger stop and termination status are separate state and
    ///          remain available to the Debug Console after this operation.
    expose func ClearProgramOutput() {
        programOutput = "";
        dirty = true;
    }

    /// @brief Copy a matching asynchronous variables reply into the stable path cache.
    hide func CachePendingVariableChildren() {
        if pendingVarPath == "" or pendingVarRef <= 0
           or lastVarRef != pendingVarRef or lastVarChildren == null { return; }
        var children = new var_model.VarChildList();
        var i = 0;
        while i < Seq.get_Count(lastVarChildren) {
            var child = Seq.Get(lastVarChildren, i);
            var record = new var_model.VarChildRec();
            record.name = Map.GetStr(child, "name");
            record.value = Map.GetStr(child, "value");
            record.typeName = Map.GetStr(child, "type");
            record.varRef = Map.GetInt(child, "varRef");
            record.childCount = Map.GetInt(child, "childCount");
            children.items.add(record);
            i = i + 1;
        }
        if varTree != null { varTree.PutCache(pendingVarPath, children); }
        if failedVarPath == pendingVarPath { failedVarPath = ""; }
        pendingVarPath = "";
        pendingVarRef = 0;
        pendingVarRequestId = 0;
        variableRequestCountdown.Reset();
    }

    /// @brief Fail one timed-out watch and continue the serialized refresh.
    hide func ExpireWatchRequest() {
        var watchIdx = FindWatch(watchRequestExpr);
        if watchIdx >= 0 {
            watchValues.removeAt(watchIdx);
            watchValues.insert(watchIdx, "(timed out)");
            watchTypes.removeAt(watchIdx);
            watchTypes.insert(watchIdx, "");
            watchOk.removeAt(watchIdx);
            watchOk.insert(watchIdx, false);
            watchRefreshIndex = watchIdx + 1;
            if watchRefreshIndex >= watchExprs.count() {
                watchRefreshIndex = -1;
            }
        }
        watchRequestActive = false;
        watchRequestExpr = "";
        watchRequestId = 0;
        watchRequestCountdown.Reset();
        dirty = true;
        PumpWatchRequest();
    }

    hide func handleEvent(jsonText: String) {
        if Json.IsValid(jsonText) == false {
            ReportProtocolDiagnostic("malformed debug control JSON discarded");
            return;
        }
        var ev = Json.Parse(jsonText);
        var evType = Zanna.Collections.Map.GetStr(ev, "type");
        if evType == "stopped" {
            stopped = true;
            lastType = "stopped";
            lastReason = Zanna.Collections.Map.GetStr(ev, "reason");
            self.activePath = Zanna.Collections.Map.GetStr(ev, "path");
            lastLine = Zanna.Collections.Map.GetInt(ev, "line");
            stopFrames = Map.Get(ev, "frames") as Seq;
            stopLocals = Map.Get(ev, "locals") as Seq;
            consoleText = formatStopped(ev);
            RefreshWatches();
            dirty = true;
        } else if evType == "terminated" {
            terminated = true;
            stopped = false;
            hasSession = false;
            ClearStopSnapshot();
            lastType = "terminated";
            lastReason = Zanna.Collections.Map.GetStr(ev, "reason");
            exitCode = Zanna.Collections.Map.GetInt(ev, "exitCode");
            ClearEvaluationSnapshot();
            ClearWatchValues();
            dirty = true;
        } else if evType == "evaluated" {
            var responseId = Zanna.Collections.Map.GetInt(ev, "requestId");
            var expr = Zanna.Collections.Map.GetStr(ev, "expr");
            var value = Zanna.Collections.Map.GetStr(ev, "value");
            var valueType = Zanna.Collections.Map.GetStr(ev, "valueType");
            var ok = Zanna.Collections.Map.GetBool(ev, "ok");
            var watchIdx = FindWatch(expr);
            var matched = false;
            if watchIdx >= 0 and watchRequestActive
               and responseId == watchRequestId and expr == watchRequestExpr {
                watchValues.removeAt(watchIdx);
                if ok {
                    watchValues.insert(watchIdx, value);
                } else {
                    watchValues.insert(watchIdx, "(unavailable)");
                }
                watchTypes.removeAt(watchIdx);
                watchTypes.insert(watchIdx, valueType);
                watchOk.removeAt(watchIdx);
                watchOk.insert(watchIdx, ok);
                watchRequestActive = false;
                watchRequestExpr = "";
                watchRequestId = 0;
                watchRequestCountdown.Reset();
                watchRefreshIndex = watchIdx + 1;
                if watchRefreshIndex >= watchExprs.count() {
                    watchRefreshIndex = -1;
                }
                PumpWatchRequest();
                matched = true;
            }
            if pendingManualEvalRequestId > 0
               and responseId == pendingManualEvalRequestId
               and expr == pendingManualEvalExpr {
                lastEvalExpr = expr;
                lastEvalValue = value;
                lastEvalType = valueType;
                lastEvalOk = ok;
                evalJustArrived = true;
                pendingManualEvalExpr = "";
                pendingManualEvalRequestId = 0;
                manualEvalCountdown.Reset();
                matched = true;
            }
            if matched { dirty = true; }
        } else if evType == "variables" {
            // Lazy expansion result for a composite local/child. Copy matching
            // UI requests into the stable name-path cache before publishing.
            var responseId = Zanna.Collections.Map.GetInt(ev, "requestId");
            if responseId <= 0 or responseId != expectedVariableRequestId { return; }
            expectedVariableRequestId = 0;
            lastVarRef = Zanna.Collections.Map.GetInt(ev, "varRef");
            lastVarChildren = Map.Get(ev, "vars") as Seq;
            if responseId == pendingVarRequestId {
                CachePendingVariableChildren();
            }
            dirty = true;
        } else if evType == "log" {
            // Logpoint: surfaced in the debug console; execution never paused.
            programOutput = AppendBoundedOutput(programOutput,
                "[logpoint:" + Zanna.Collections.Map.GetInt(ev, "line") + "] " + Zanna.Collections.Map.GetStr(ev, "message") + "\n");
            dirty = true;
        } else if evType == "initialized" {
            dirty = true;
        }
    }

}
