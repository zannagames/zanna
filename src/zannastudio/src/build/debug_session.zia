//
// File: zannastudio/src/build/debug_session.zia
// Purpose: Own the asynchronous VM debug-adapter process and paused-state data.
// Key invariants:
//   - Adapter I/O and variable expansion never block the Studio frame loop.
//   - Variable references and child caches are invalidated whenever execution resumes.
// Ownership/Lifetime:
//   - DebugSession owns the child process handle and all parsed adapter snapshots.
//   - VarTreeState owns copied child records; adapter event maps remain transient.
// Links: zannastudio/src/commands/debug_commands.zia,
//        zannastudio/src/build/var_model.zia
//
//===----------------------------------------------------------------------===//

module debug_session;

bind "bounded_output";
bind "breakpoints";
bind "var_model";
bind "debug_session_base";

bind Process = Zanna.System.Process;
bind Json = Zanna.Data.Json;
bind Map = Zanna.Collections.Map;
bind Seq = Zanna.Collections.Seq;
bind Str = Zanna.String;
bind Obj = Zanna.Core.Object;
bind Path = Zanna.IO.Path;
bind Time = Zanna.Time;

// ============================================================================
// MODULE: debug_session
// PURPOSE: Drive the out-of-process VM debug adapter.
//
// WHERE-THIS-FITS: debug_commands starts and controls the session. main.zia pumps
//          DebugUpdate every frame. AppShell renders call stack, variables, debug
//          console output, and toolbar enablement from this state.
//
// TEACHING-NOTE: Debugging is asynchronous. Commands are written to the adapter
//          stdin as newline JSON, then matching events arrive later on stderr
//          with the "@@VDBG@@ " sentinel. Polling keeps this explicit and avoids
//          callback state hidden outside the frame loop.
// ============================================================================

final SENTINEL = "@@VDBG@@ ";
final MAX_DEBUG_OUTPUT_CHARS = 250000;
final TERMINATE_GRACE_MS = 750;
final VARIABLE_REQUEST_TIMEOUT_MS = 2000;

class DebugSession extends debug_session_base.DebugSessionBase {
    expose func init() {
        InitializeState();
    }

    /// @brief Drain program output + control events. Returns true on a state change.
    expose func Poll() -> Boolean {
        if processHandle == null { return false; }
        dirty = false;

        drainProcessOutput();
        if pendingVarPath != "" and variableRequestCountdown.get_IsExpired() {
            failedVarPath = pendingVarPath;
            pendingVarPath = "";
            pendingVarRef = 0;
            variableRequestCountdown.Reset();
            dirty = true;
        }
        if terminateRequested and terminated == false and processHandle.IsRunning()
           and terminateCountdown.get_IsExpired() {
            processHandle.Kill();
            dirty = true;
        }

        if processHandle.IsRunning() == false {
            // Final drain after the child exited.
            AppendStdoutResult(processHandle.ReadStdoutResult());
            AppendStderrResult(processHandle.ReadStderrResult());
            if terminated == false {
                exitCode = processHandle.ExitCode();
                terminated = true;
                stopped = false;
                hasSession = false;
                terminateRequested = false;
                lastType = "terminated";
                if lastReason == "" { lastReason = "exit"; }
                dirty = true;
            } else {
                stopped = false;
                hasSession = false;
                terminateRequested = false;
            }
            ClearStopSnapshot();
            ClearWatchValues();
            ReleaseProcessHandle();
        }
        return dirty;
    }

    /// @brief Drain stdout and debug-adapter stderr without changing process state.
    /// @details Used by both the frame pump and the graceful terminate path so
    ///          shutdown messages are not lost when Stop is clicked.
    hide func drainProcessOutput() {
        if processHandle == null { return; }
        AppendStdoutResult(processHandle.ReadStdoutResult());
        AppendStderrResult(processHandle.ReadStderrResult());
    }

    hide func AppendStdoutResult(result: Any) {
        if result == null { return; }
        var out = Map.GetStr(result, "text");
        if out != "" {
            programOutput = AppendBoundedOutput(programOutput, out);
            dirty = true;
        }
        if Map.GetBool(result, "truncated") {
            programOutput = AppendBoundedOutput(programOutput,
                                                "\n[debug stdout truncated by runtime]\n");
            dirty = true;
        }
    }

    hide func AppendStderrResult(result: Any) {
        if result == null { return; }
        var err = Map.GetStr(result, "text");
        if err != "" {
            ctrlBuf = ctrlBuf + err;
            drainControlLines();
        }
        if Map.GetBool(result, "truncated") {
            programOutput = AppendBoundedOutput(programOutput,
                                                "\n[debug stderr truncated by runtime]\n");
            dirty = true;
        }
    }

    hide func drainControlLines() {
        var nl = Str.IndexOf(ctrlBuf, "\n");
        while nl != 0 {
            var line = Str.Left(ctrlBuf, nl - 1);
            ctrlBuf = Str.Mid(ctrlBuf, nl + 1);
            handleLine(line);
            nl = Str.IndexOf(ctrlBuf, "\n");
        }
    }

    hide func handleLine(line: String) {
        if line == "" { return; }
        if Str.StartsWith(line, SENTINEL) {
            handleEvent(Str.Mid(line, Str.get_Length(SENTINEL) + 1));
        } else {
            // Raw program stderr or trap text: show it as output.
            programOutput = AppendBoundedOutput(programOutput, line + "\n");
            dirty = true;
        }
    }

    /// @brief Append debug output while preserving a bounded console history.
    /// @details Debug sessions can run indefinitely and stream unbounded stdout or
    ///          stderr. Keeping only the newest history avoids quadratic string
    ///          growth in long IDE sessions while making truncation visible.
    /// @param existing Existing console buffer.
    /// @param text Newly read process output.
    /// @return Combined buffer, trimmed to MAX_DEBUG_OUTPUT_CHARS when needed.
    hide func AppendBoundedOutput(existing: String, text: String) -> String {
        return bounded_output.Append(existing, text,
                                     "[debug output truncated]\n",
                                     MAX_DEBUG_OUTPUT_CHARS);
    }

    /// @brief Clear only user-program stdout/stderr retained by this session.
    /// @details Debugger stop and termination status are separate state and
    ///          remain available to the Debug Console after this operation.
    expose func ClearProgramOutput() {
        programOutput = "";
        dirty = true;
    }

    /// @brief Copy a matching asynchronous variables reply into the stable path cache.
    hide func CachePendingVariableChildren() {
        if pendingVarPath == "" or pendingVarRef <= 0
           or lastVarRef != pendingVarRef or lastVarChildren == null { return; }
        var children = new var_model.VarChildList();
        var i = 0;
        while i < Seq.get_Count(lastVarChildren) {
            var child = Seq.Get(lastVarChildren, i);
            var record = new var_model.VarChildRec();
            record.name = Map.GetStr(child, "name");
            record.value = Map.GetStr(child, "value");
            record.typeName = Map.GetStr(child, "type");
            record.varRef = Map.GetInt(child, "varRef");
            record.childCount = Map.GetInt(child, "childCount");
            children.items.add(record);
            i = i + 1;
        }
        if varTree != null { varTree.PutCache(pendingVarPath, children); }
        if failedVarPath == pendingVarPath { failedVarPath = ""; }
        pendingVarPath = "";
        pendingVarRef = 0;
        variableRequestCountdown.Reset();
    }

    hide func handleEvent(jsonText: String) {
        if Json.IsValid(jsonText) == false { return; }
        var ev = Json.Parse(jsonText);
        var evType = Zanna.Collections.Map.GetStr(ev, "type");
        if evType == "stopped" {
            stopped = true;
            lastType = "stopped";
            lastReason = Zanna.Collections.Map.GetStr(ev, "reason");
            activePath = Zanna.Collections.Map.GetStr(ev, "path");
            lastLine = Zanna.Collections.Map.GetInt(ev, "line");
            stopFrames = Map.Get(ev, "frames");
            stopLocals = Map.Get(ev, "locals");
            consoleText = formatStopped(ev);
            RefreshWatches();
            dirty = true;
        } else if evType == "terminated" {
            terminated = true;
            stopped = false;
            hasSession = false;
            ClearStopSnapshot();
            lastType = "terminated";
            lastReason = Zanna.Collections.Map.GetStr(ev, "reason");
            exitCode = Zanna.Collections.Map.GetInt(ev, "exitCode");
            ClearEvaluationSnapshot();
            ClearWatchValues();
            dirty = true;
        } else if evType == "evaluated" {
            var expr = Zanna.Collections.Map.GetStr(ev, "expr");
            var value = Zanna.Collections.Map.GetStr(ev, "value");
            var valueType = Zanna.Collections.Map.GetStr(ev, "valueType");
            var ok = Zanna.Collections.Map.GetBool(ev, "ok");
            var watchIdx = FindWatch(expr);
            if watchIdx >= 0 and watchRequestActive and expr == watchRequestExpr {
                watchValues.removeAt(watchIdx);
                if ok {
                    watchValues.insert(watchIdx, value);
                } else {
                    watchValues.insert(watchIdx, "(unavailable)");
                }
                watchTypes.removeAt(watchIdx);
                watchTypes.insert(watchIdx, valueType);
                watchOk.removeAt(watchIdx);
                watchOk.insert(watchIdx, ok);
                watchRequestActive = false;
                watchRequestExpr = "";
                watchRefreshIndex = watchIdx + 1;
                if watchRefreshIndex >= watchExprs.count() {
                    watchRefreshIndex = -1;
                }
                PumpWatchRequest();
            }
            if pendingManualEvalExpr != "" and expr == pendingManualEvalExpr {
                lastEvalExpr = expr;
                lastEvalValue = value;
                lastEvalType = valueType;
                lastEvalOk = ok;
                evalJustArrived = true;
                pendingManualEvalExpr = "";
            }
            dirty = true;
        } else if evType == "variables" {
            // Lazy expansion result for a composite local/child. Copy matching
            // UI requests into the stable name-path cache before publishing.
            lastVarRef = Zanna.Collections.Map.GetInt(ev, "varRef");
            lastVarChildren = Map.Get(ev, "vars");
            CachePendingVariableChildren();
            dirty = true;
        } else if evType == "log" {
            // Logpoint: surfaced in the debug console; execution never paused.
            programOutput = AppendBoundedOutput(programOutput,
                "[logpoint:" + Zanna.Collections.Map.GetInt(ev, "line") + "] " + Zanna.Collections.Map.GetStr(ev, "message") + "\n");
            dirty = true;
        } else if evType == "initialized" {
            dirty = true;
        }
    }

    expose func FormatConsole() -> String {
        if hasSession == false and terminated == false { return ""; }
        if consoleText != "" { return consoleText; }
        var state = lastType;
        if state == "" and hasSession { state = "running"; }
        var result = "[debug] " + state;
        if lastReason != "" { result = result + " " + lastReason; }
        return result;
    }

    // ── Structured stop accessors (Variables / Call Stack panels) ───────────

    /// @brief Number of call-stack frames at the current stop (0 if not stopped).
    expose func FrameCount() -> Integer {
        if stopFrames == null { return 0; }
        return Seq.get_Count(stopFrames);
    }

    /// @brief One-line label for call-stack frame @p i: "function — file:line".
    expose func FrameLabel(i: Integer) -> String {
        if stopFrames == null or i < 0 or i >= Seq.get_Count(stopFrames) { return ""; }
        var f = Seq.Get(stopFrames, i);
        var fn = Zanna.Collections.Map.GetStr(f, "function");
        if fn == "" { fn = "<anonymous>"; }
        return fn + " — " + baseName(Zanna.Collections.Map.GetStr(f, "path")) + ":" + Zanna.Collections.Map.GetInt(f, "line");
    }

    /// @brief Source path for frame @p i (for click-to-navigate), or "".
    expose func FramePath(i: Integer) -> String {
        if stopFrames == null or i < 0 or i >= Seq.get_Count(stopFrames) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(stopFrames, i), "path");
    }

    /// @brief One-based source line for frame @p i, or 0.
    expose func FrameLine(i: Integer) -> Integer {
        if stopFrames == null or i < 0 or i >= Seq.get_Count(stopFrames) { return 0; }
        return Zanna.Collections.Map.GetInt(Seq.Get(stopFrames, i), "line");
    }

    /// @brief Number of locals visible at the current stop (0 if not stopped).
    expose func LocalCount() -> Integer {
        if stopLocals == null { return 0; }
        return Seq.get_Count(stopLocals);
    }

    /// @brief "name = value : type" label for local @p i.
    expose func LocalLabel(i: Integer) -> String {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return ""; }
        var l = Seq.Get(stopLocals, i);
        return Zanna.Collections.Map.GetStr(l, "name") + " = " + Zanna.Collections.Map.GetStr(l, "value")
            + " : " + Zanna.Collections.Map.GetStr(l, "type");
    }

    /// @brief Expansion ref for local @p i: >0 when it is a composite that can be
    ///        expanded via RequestVariables, 0 for a leaf.
    expose func LocalVarRef(i: Integer) -> Integer {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return 0; }
        return Zanna.Collections.Map.GetInt(Seq.Get(stopLocals, i), "varRef");
    }

    /// @brief Number of children local @p i has when expandable, else 0.
    expose func LocalChildCount(i: Integer) -> Integer {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return 0; }
        return Zanna.Collections.Map.GetInt(Seq.Get(stopLocals, i), "childCount");
    }

    /// @brief Number of children returned by the most recent RequestVariables.
    expose func VarChildCount() -> Integer {
        if lastVarChildren == null { return 0; }
        return Seq.get_Count(lastVarChildren);
    }

    /// @brief "name = value : type" label for expanded child @p i.
    expose func VarChildLabel(i: Integer) -> String {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return ""; }
        var c = Seq.Get(lastVarChildren, i);
        return Zanna.Collections.Map.GetStr(c, "name") + " = " + Zanna.Collections.Map.GetStr(c, "value")
            + " : " + Zanna.Collections.Map.GetStr(c, "type");
    }

    /// @brief Expansion ref for expanded child @p i (>0 when it nests further).
    expose func VarChildVarRef(i: Integer) -> Integer {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return 0; }
        return Zanna.Collections.Map.GetInt(Seq.Get(lastVarChildren, i), "varRef");
    }

    /// @brief Display name of expanded child @p i (e.g. "[0]" or a map key).
    expose func VarChildName(i: Integer) -> String {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(lastVarChildren, i), "name");
    }

    /// @brief Display value of expanded child @p i.
    expose func VarChildValue(i: Integer) -> String {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(lastVarChildren, i), "value");
    }

    /// @brief Type label of expanded child @p i.
    expose func VarChildType(i: Integer) -> String {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(lastVarChildren, i), "type");
    }

    /// @brief Child count of expanded child @p i (>0 when it nests further).
    expose func VarChildChildCount(i: Integer) -> Integer {
        if lastVarChildren == null or i < 0 or i >= Seq.get_Count(lastVarChildren) { return 0; }
        return Zanna.Collections.Map.GetInt(Seq.Get(lastVarChildren, i), "childCount");
    }

    /// @brief Name of local @p i (the stable key used for tree paths).
    expose func LocalName(i: Integer) -> String {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(stopLocals, i), "name");
    }

    /// @brief Display value of local @p i.
    expose func LocalValue(i: Integer) -> String {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(stopLocals, i), "value");
    }

    /// @brief Type label of local @p i.
    expose func LocalType(i: Integer) -> String {
        if stopLocals == null or i < 0 or i >= Seq.get_Count(stopLocals) { return ""; }
        return Zanna.Collections.Map.GetStr(Seq.Get(stopLocals, i), "type");
    }

    /// @brief Compatibility helper that synchronously fetches one child level.
    /// @details Headless probes may use this helper; Studio UI code must use
    ///          RequestVariableChildren so adapter latency never blocks a frame.
    ///          On success children remain readable through VarChild* accessors.
    expose func FetchChildren(varRef: Integer, start: Integer, count: Integer) -> Boolean {
        if pendingVarPath != "" { return false; }
        lastVarChildren = null;
        lastVarRef = 0;
        if RequestVariables(varRef, start, count) == false { return false; }
        var waited = 0;
        while waited < 2000 and lastVarRef != varRef {
            Poll();
            if lastVarRef == varRef { return true; }
            Time.Clock.Sleep(2);
            waited = waited + 2;
        }
        return lastVarRef == varRef;
    }

    /// @brief Trailing path component of @p p (handles both / and \\ separators).
    hide func baseName(p: String) -> String {
        var slash = Str.LastIndexOf(p, "/");
        var back = Str.LastIndexOf(p, "\\");
        var cut = slash;
        if back > cut { cut = back; }
        if cut <= 0 { return p; }
        return Str.Mid(p, cut + 1);
    }

    hide func formatStopped(ev: Any) -> String {
        var text = "[debug] stopped (" + lastReason + ") at "
            + activePath + ":" + lastLine + "\n";

        var frames = Map.Get(ev, "frames");
        if frames != null and Seq.get_Count(frames) > 0 {
            text = text + "\nCall stack:\n";
            var i = 0;
            while i < Seq.get_Count(frames) {
                var f = Seq.Get(frames, i);
                text = text + "  #" + i + " " + Zanna.Collections.Map.GetStr(f, "function")
                    + " " + Zanna.Collections.Map.GetStr(f, "path") + ":" + Zanna.Collections.Map.GetInt(f, "line") + "\n";
                i = i + 1;
            }
        }

        var locals = Map.Get(ev, "locals");
        if locals != null and Seq.get_Count(locals) > 0 {
            text = text + "\nLocals:\n";
            var j = 0;
            while j < Seq.get_Count(locals) {
                var l = Seq.Get(locals, j);
                text = text + "  " + Zanna.Collections.Map.GetStr(l, "name") + " = "
                    + Zanna.Collections.Map.GetStr(l, "value") + " : " + Zanna.Collections.Map.GetStr(l, "type") + "\n";
                j = j + 1;
            }
        }
        return text;
    }
}
