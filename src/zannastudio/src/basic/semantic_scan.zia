//
// File: zannastudio/src/basic/semantic_scan.zia
// Purpose: Provide bounded lightweight BASIC semantic scans for Studio-only
//          navigation, refactoring, call hierarchy, and signature features.
// Key invariants:
//   - Identifiers are matched case-insensitively outside strings/comments.
//   - Capped entry points never append beyond their caller-owned result limit.
// Ownership/Lifetime: Stateless; callers own every source and result sequence.
// Links: zannastudio/src/editor/basic_workspace_query_job.zia,
//        zannastudio/src/commands/edit_commands.zia
//
//===----------------------------------------------------------------------===//

module semantic_scan;

bind Map = Zanna.Collections.Map;
bind "semantic_lexing" as SemanticLexing;
bind Seq = Zanna.Collections.Seq;
bind Obj = Zanna.Core.Object;
bind Str = Zanna.String;

final BASIC_MAX_SIGNATURE_BACKTRACK_LINES = 200;

// ============================================================================
// MODULE: semantic_scan
// PURPOSE: Lightweight BASIC semantic scanning for IDE navigation.
//
// WHERE-THIS-FITS: The BASIC compiler bridge exposes diagnostics, completion,
//          hover, and document symbols. This module fills editor-only project
//          navigation gaps without changing runtime ABI: go-to-definition,
//          references, rename edits, call hierarchy tokens, workspace symbols,
//          and signature-help records.
//
// TEACHING-NOTE: This is not a replacement parser. It mirrors BASIC's lexical
//          rules closely enough for IDE assists: case-insensitive identifiers,
//          optional type suffixes, apostrophe/REM comments, and doubled-quote
//          string escapes. Compiler diagnostics remain the source of truth.
// ============================================================================

expose func IdentifierAt(source: String,
                         lineNumber: Integer,
                         col0: Integer) -> String {
    var line = SemanticLexing.SourceLine(source, lineNumber);
    if line == "" { return ""; }
    var at = col0 + 1;
    if at < 1 { at = 1; }
    if at > Str.get_Length(line) { at = Str.get_Length(line); }
    if at < 1 { return ""; }

    if SemanticLexing.IsBasicIdentifierChar(Str.MidLen(line, at, 1)) == false {
        if at > 1 and SemanticLexing.IsBasicIdentifierChar(Str.MidLen(line, at - 1, 1)) {
            at = at - 1;
        } else {
            return "";
        }
    }

    var start = at;
    while start > 1 and SemanticLexing.IsBasicIdentifierChar(Str.MidLen(line, start - 1, 1)) {
        start = start - 1;
    }
    var endPos = at;
    while endPos < Str.get_Length(line) and SemanticLexing.IsBasicIdentifierChar(Str.MidLen(line, endPos + 1, 1)) {
        endPos = endPos + 1;
    }
    return Str.MidLen(line, start, endPos - start + 1);
}

expose func CanonicalName(name: String) -> String {
    return Str.ToLower(SemanticLexing.StripTypeSuffix(name));
}

expose func IsValidBasicIdentifier(name: String) -> Boolean {
    if name == "" { return false; }
    var base = SemanticLexing.StripTypeSuffix(name);
    if base == "" { return false; }
    if SemanticLexing.IsKeyword(base) { return false; }
    if SemanticLexing.IsBasicIdentifierStart(Str.MidLen(base, 1, 1)) == false { return false; }
    var i = 2;
    while i <= Str.get_Length(base) {
        if SemanticLexing.IsBasicIdentifierPart(Str.MidLen(base, i, 1)) == false { return false; }
        i = i + 1;
    }
    return true;
}

expose func ReplacementForOccurrence(oldToken: String,
                                     newName: String) -> String {
    if SemanticLexing.HasTypeSuffix(newName) { return newName; }
    var suffix = SemanticLexing.TypeSuffix(oldToken);
    if suffix != "" { return newName + suffix; }
    return newName;
}

expose func NewNotFound() -> Any {
    var item = Map.New();
    Map.SetBool(item, "found", false);
    return item;
}

expose func DeclarationsForFile(path: String,
                                source: String) -> Any {
    var decls = Seq.New();
    AddDeclarations(decls, path, source);
    return decls;
}

expose func AddDeclarations(decls: Any,
                            path: String,
                            source: String) {
    AddDeclarationsCapped(decls, path, source, 0);
}

/// @brief Append declarations without exceeding an aggregate result ceiling.
/// @param decls Caller-owned declaration sequence.
/// @param path Source path attached to declarations.
/// @param source BASIC source text.
/// @param maxCount Maximum aggregate sequence size, or zero for unlimited.
/// @return True when the complete source was scanned; false when capped.
expose func AddDeclarationsCapped(decls: Any,
                                  path: String,
                                  source: String,
                                  maxCount: Integer) -> Boolean {
    if decls == null or source == "" { return true; }
    var lines = Str.Split(source, "\n");
    var lineCount = Seq.get_Count(lines);
    var i = 1;
    while i <= lineCount and HasResultCapacity(decls, maxCount) {
        var rawLine = Obj.ToString(Seq.Get(lines, i - 1));
        var code = SemanticLexing.StripLineComment(rawLine);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "FUNCTION", "function", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "SUB", "function", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "PROPERTY", "property", maxCount);
        AddDestructorDeclaration(decls, path, source, code, i, maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "CLASS", "type", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "INTERFACE", "interface", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "TYPE", "type", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "ENUM", "enum", maxCount);
        AddBlockDeclaration(decls, path, source, code, i, lineCount,
                            "NAMESPACE", "module", maxCount);
        AddLabelDeclaration(decls, path, code, i, lineCount, maxCount);
        AddDimDeclarations(decls, path, source, code, i, lineCount, maxCount);
        AddConstDeclaration(decls, path, source, code, i, lineCount, maxCount);
        AddClassFieldDeclaration(decls, path, source, code, i, lineCount, maxCount);
        i = i + 1;
    }
    return i > lineCount
       and (maxCount <= 0 or Seq.get_Count(decls) < maxCount);
}

expose func BestDefinition(decls: Any,
                           activePath: String,
                           activeLine: Integer,
                           token: String) -> Any {
    if decls == null or token == "" { return NewNotFound(); }
    var canon = CanonicalName(token);
    if canon == "" { return NewNotFound(); }

    var best = NewNotFound();
    var bestScore = -1;
    var i = 0;
    while i < Seq.get_Count(decls) {
        var decl = Seq.Get(decls, i);
        if Map.GetStr(decl, "canon") == canon {
            var score = DefinitionScore(decl, activePath, activeLine);
            if score > bestScore {
                best = decl;
                bestScore = score;
            }
        }
        i = i + 1;
    }
    if bestScore < 0 { return NewNotFound(); }
    Map.SetBool(best, "found", true);
    return best;
}

expose func AddReferencesForFile(refs: Any,
                                 path: String,
                                 source: String,
                                 def: Any) {
    AddReferencesForFileCapped(refs, path, source, def, 0);
}

/// @brief Append references without exceeding an aggregate result ceiling.
/// @param refs Caller-owned reference sequence.
/// @param path Source path attached to references.
/// @param source BASIC source text.
/// @param def Resolved declaration record.
/// @param maxCount Maximum aggregate sequence size, or zero for unlimited.
/// @return True when the relevant source range was completely scanned.
expose func AddReferencesForFileCapped(refs: Any,
                                       path: String,
                                       source: String,
                                       def: Any,
                                       maxCount: Integer) -> Boolean {
    if refs == null or def == null or source == "" { return true; }
    var canon = Map.GetStr(def, "canon");
    if canon == "" { return true; }

    var localOnly = Map.GetBool(def, "local") or Map.GetStr(def, "kind") == "label";
    var fromLine = 1;
    var toLine = SemanticLexing.LineCount(source);
    if localOnly {
        if path != Map.GetStr(def, "file") { return true; }
        fromLine = Map.GetIntOr(def, "scopeStart", 1);
        toLine = Map.GetIntOr(def, "scopeEnd", toLine);
    }

    var lines = Str.Split(source, "\n");
    var i = fromLine;
    while i <= toLine and i <= Seq.get_Count(lines)
          and HasResultCapacity(refs, maxCount) {
        AddLineReferences(refs, path, Obj.ToString(Seq.Get(lines, i - 1)),
                          i, def, canon, maxCount);
        i = i + 1;
    }
    return (i > toLine or i > Seq.get_Count(lines))
       and (maxCount <= 0 or Seq.get_Count(refs) < maxCount);
}

expose func RenameEditsFromReferences(refs: Any,
                                      newName: String) -> Any {
    var edits = Seq.New();
    if refs == null { return edits; }
    var i = 0;
    while i < Seq.get_Count(refs) {
        var ref = Seq.Get(refs, i);
        var edit = Map.New();
        Map.SetStr(edit, "file", Map.GetStr(ref, "file"));
        Map.SetInt(edit, "startLine", Map.GetInt(ref, "line"));
        Map.SetInt(edit, "startColumn", Map.GetInt(ref, "column"));
        Map.SetInt(edit, "endLine", Map.GetInt(ref, "endLine"));
        Map.SetInt(edit, "endColumn", Map.GetInt(ref, "endColumn"));
        Map.SetStr(edit, "newText",
                   ReplacementForOccurrence(Map.GetStr(ref, "text"), newName));
        Map.SetStr(edit, "expectedText", Map.GetStr(ref, "text"));
        Map.SetInt(edit, "expectedMtime", Map.GetIntOr(ref, "expectedMtime", -1));
        Seq.Push(edits, edit);
        i = i + 1;
    }
    return edits;
}

expose func EnclosingBasicProcedureStartLine(source: String,
                                             lineNumber: Integer) -> Integer {
    var lines = Str.Split(source, "\n");
    var i = lineNumber;
    if i > Seq.get_Count(lines) { i = Seq.get_Count(lines); }
    while i >= 1 {
        var code = SemanticLexing.StripLineComment(Obj.ToString(Seq.Get(lines, i - 1)));
        var kind = SemanticLexing.ProcedureKeywordOnLine(code);
        if kind != "" {
            var endLine = SemanticLexing.BasicBlockEndLine(source, i, kind);
            if lineNumber <= endLine {
                return i;
            }
        }
        i = i - 1;
    }
    return 0;
}

expose func EnclosingBasicProcedureName(source: String,
                                        lineNumber: Integer) -> String {
    var start = EnclosingBasicProcedureStartLine(source, lineNumber);
    if start <= 0 { return ""; }
    var decl = ProcedureDeclarationFromLine("<editor>", source,
                                            SemanticLexing.SourceLine(source, start), start,
                                            SemanticLexing.LineCount(source));
    if Map.GetBool(decl, "found") { return Map.GetStr(decl, "name"); }
    return "";
}

expose func BasicProcedureEndLine(source: String,
                                  startLine: Integer) -> Integer {
    if startLine <= 0 { return 0; }
    var kind = SemanticLexing.ProcedureKeywordOnLine(SemanticLexing.SourceLine(source, startLine));
    if kind == "" { return startLine; }
    return SemanticLexing.BasicBlockEndLine(source, startLine, kind);
}

expose func OutgoingBasicCallTokens(source: String,
                                    startLine: Integer,
                                    endLine: Integer) -> Any {
    return OutgoingBasicCallTokensCapped(source, startLine, endLine, 0);
}

/// @brief Return call-like tokens without exceeding a result ceiling.
/// @param source BASIC source text.
/// @param startLine Inclusive procedure start line.
/// @param endLine Inclusive procedure end line.
/// @param maxCount Maximum token count, or zero for unlimited.
/// @return Sequence of call-token maps.
expose func OutgoingBasicCallTokensCapped(source: String,
                                          startLine: Integer,
                                          endLine: Integer,
                                          maxCount: Integer) -> Any {
    var tokens = Seq.New();
    if source == "" { return tokens; }
    var lines = Str.Split(source, "\n");
    var fromLine = startLine;
    var toLine = endLine;
    if fromLine < 1 { fromLine = 1; }
    if toLine < fromLine { toLine = fromLine; }
    if toLine > Seq.get_Count(lines) { toLine = Seq.get_Count(lines); }

    var i = fromLine;
    while i <= toLine and HasResultCapacity(tokens, maxCount) {
        AddOutgoingCallsFromLine(tokens, Obj.ToString(Seq.Get(lines, i - 1)),
                                 i, maxCount);
        i = i + 1;
    }
    return tokens;
}

expose func SignatureInfoForFile(path: String,
                                 source: String,
                                 lineNumber: Integer,
                                 col0: Integer) -> Any {
    var info = Map.New();
    Map.SetBool(info, "available", false);
    var call = ActiveCallAt(source, lineNumber, col0);
    if Map.GetBool(call, "available") == false { return info; }

    var callName = Map.GetStr(call, "name");
    var decls = DeclarationsForFile(path, source);
    var overloads = Seq.New();
    var i = 0;
    while i < Seq.get_Count(decls) {
        var decl = Seq.Get(decls, i);
        if Map.GetStr(decl, "canon") == CanonicalName(callName)
           and IsCallableKind(Map.GetStr(decl, "kind")) {
            Seq.Push(overloads, SignatureRecordForDeclaration(decl));
        }
        i = i + 1;
    }
    if Seq.get_Count(overloads) == 0 { return info; }

    var first = Seq.Get(overloads, 0);
    Map.SetBool(info, "available", true);
    Map.SetInt(info, "activeSignature", 0);
    Map.SetInt(info, "activeParameter", Map.GetInt(call, "activeParameter"));
    Map.SetInt(info, "overloadCount", Seq.get_Count(overloads));
    Map.Set(info, "overloads", overloads);
    Map.SetStr(info, "name", Map.GetStr(first, "name"));
    Map.SetStr(info, "display", Map.GetStr(first, "display"));
    Map.Set(info, "parameters", Map.Get(first, "parameters"));
    Map.SetStr(info, "returnType", Map.GetStr(first, "returnType"));
    Map.SetStr(info, "documentation", "");
    Map.SetStr(info, "source", "basic");
    return info;
}

expose func WorkspaceSymbolMatchesDecl(decl: Any,
                                       needle: String) -> Boolean {
    if decl == null { return false; }
    if needle == "" { return true; }
    if Str.IndexOf(Str.ToLower(Map.GetStr(decl, "name")), needle) != 0 { return true; }
    if Str.IndexOf(Str.ToLower(Map.GetStr(decl, "kind")), needle) != 0 { return true; }
    if Str.IndexOf(Str.ToLower(Map.GetStr(decl, "file")), needle) != 0 { return true; }
    return false;
}

func DefinitionScore(decl: Any,
                     activePath: String,
                     activeLine: Integer) -> Integer {
    var score = 0;
    var file = Map.GetStr(decl, "file");
    var scopeStart = Map.GetIntOr(decl, "scopeStart", 1);
    var scopeEnd = Map.GetIntOr(decl, "scopeEnd", scopeStart);
    if file == activePath { score = score + 10000; }
    if activeLine >= scopeStart and activeLine <= scopeEnd {
        score = score + 50000;
        var span = scopeEnd - scopeStart;
        if span < 0 { span = 0; }
        score = score + 10000 - span;
    }
    if Map.GetBool(decl, "local") { score = score + 1000; }
    if IsCallableKind(Map.GetStr(decl, "kind")) { score = score + 100; }
    return score;
}

func AddBlockDeclaration(decls: Any,
                         path: String,
                         source: String,
                         line: String,
                         lineNumber: Integer,
                         lineCount: Integer,
                         keyword: String,
                         kind: String,
                         maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    var decl = ProcedureOrBlockDeclaration(path, source, line, lineNumber,
                                           lineCount, keyword, kind);
    if Map.GetBool(decl, "found") == false { return; }
    Seq.Push(decls, decl);
    if keyword == "FUNCTION" or keyword == "SUB" or keyword == "PROPERTY" {
        AddParameterDeclarations(decls, path, decl, maxCount);
    }
}

func ProcedureDeclarationFromLine(path: String,
                                  source: String,
                                  line: String,
                                  lineNumber: Integer,
                                  lineCount: Integer) -> Any {
    var kind = SemanticLexing.ProcedureKeywordOnLine(line);
    if kind == "" { return NewNotFound(); }
    return ProcedureOrBlockDeclaration(path, source, line, lineNumber,
                                       lineCount, kind, "function");
}

func ProcedureOrBlockDeclaration(path: String,
                                 source: String,
                                 line: String,
                                 lineNumber: Integer,
                                 lineCount: Integer,
                                 keyword: String,
                                 kind: String) -> Any {
    var code = SemanticLexing.StripLineComment(line);
    var keywordCol = SemanticLexing.KeywordColumn(code, keyword);
    if keywordCol <= 0 { return NewNotFound(); }
    if SemanticLexing.EndsWithToken(Str.Trim(Str.Left(code, keywordCol - 1)), "END") {
        return NewNotFound();
    }
    var nameStart = SemanticLexing.SkipWhitespace(code, keywordCol + Str.get_Length(keyword));
    var name = SemanticLexing.ReadBasicIdentifierAt(code, nameStart);
    if name == "" { return NewNotFound(); }

    var endLine = lineCount;
    if SemanticLexing.IsBlockKeyword(keyword) {
        endLine = SemanticLexing.BasicBlockEndLine(source, lineNumber, keyword);
    }
    var openParen = Str.IndexOfFrom(code, nameStart + Str.get_Length(name), "(");
    var closeParen = 0;
    var paramsText = "";
    if openParen != 0 {
        closeParen = SemanticLexing.MatchingParenOnLine(code, openParen);
        if closeParen > openParen {
            paramsText = Str.MidLen(code, openParen + 1, closeParen - openParen - 1);
        }
    }
    var returnType = SemanticLexing.ReturnTypeFromDeclarationLine(code, closeParen);
    var signature = SignatureDisplay(keyword, name, paramsText, returnType);
    var decl = NewDecl(path, name, kind, lineNumber, nameStart,
                       nameStart + Str.get_Length(name), lineNumber, endLine,
                       false, signature, paramsText, returnType);
    Map.SetStr(decl, "signatureLine", code);
    if keyword == "FUNCTION" { Map.SetStr(decl, "kind", "function"); }
    if keyword == "SUB" { Map.SetStr(decl, "kind", "function"); }
    if keyword == "PROPERTY" { Map.SetStr(decl, "kind", "property"); }
    if kind == "type" or kind == "interface" or kind == "enum" or kind == "module" {
        Map.SetBool(decl, "local", false);
    }
    return decl;
}

func AddDestructorDeclaration(decls: Any,
                              path: String,
                              source: String,
                              line: String,
                              lineNumber: Integer,
                              maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    var keywordCol = SemanticLexing.KeywordColumn(line, "DESTRUCTOR");
    if keywordCol <= 0 { return; }
    if SemanticLexing.EndsWithToken(Str.Trim(Str.Left(line, keywordCol - 1)), "END") { return; }
    var endLine = SemanticLexing.BasicBlockEndLine(source, lineNumber, "DESTRUCTOR");
    var decl = NewDecl(path, "DESTRUCTOR", "function", lineNumber, keywordCol,
                       keywordCol + Str.get_Length("DESTRUCTOR"), lineNumber,
                       endLine, false, "DESTRUCTOR", "", "");
    Seq.Push(decls, decl);
}

func AddLabelDeclaration(decls: Any,
                         path: String,
                         line: String,
                         lineNumber: Integer,
                         lineCount: Integer,
                         maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    var code = Str.Trim(line);
    if code == "" { return; }
    var offset = SemanticLexing.LeadingWhitespaceLength(line) + 1;
    var name = SemanticLexing.ReadBasicIdentifierAt(line, offset);
    if name == "" or SemanticLexing.IsKeyword(name) { return; }
    var after = offset + Str.get_Length(name);
    if after <= Str.get_Length(line) and Str.MidLen(line, after, 1) == ":" {
        var decl = NewDecl(path, name, "label", lineNumber, offset,
                           offset + Str.get_Length(name), 1, lineCount,
                           true, name + ":", "", "");
        Seq.Push(decls, decl);
    }
}

func AddDimDeclarations(decls: Any,
                        path: String,
                        source: String,
                        line: String,
                        lineNumber: Integer,
                        lineCount: Integer,
                        maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    var dimCol = SemanticLexing.KeywordColumn(line, "DIM");
    if dimCol <= 0 { return; }
    var scopeStart = EnclosingBasicProcedureStartLine(source, lineNumber);
    var scopeEnd = lineCount;
    var local = false;
    if scopeStart > 0 {
        scopeEnd = BasicProcedureEndLine(source, scopeStart);
        local = true;
    }
    AddVariableDeclarationsFromList(decls, path, line, lineNumber,
                                    dimCol + Str.get_Length("DIM"),
                                    scopeStart, scopeEnd, local, "variable",
                                    maxCount);
}

func AddConstDeclaration(decls: Any,
                         path: String,
                         source: String,
                         line: String,
                         lineNumber: Integer,
                         lineCount: Integer,
                         maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    var constCol = SemanticLexing.KeywordColumn(line, "CONST");
    if constCol <= 0 { return; }
    var scopeStart = EnclosingBasicProcedureStartLine(source, lineNumber);
    var scopeEnd = lineCount;
    var local = false;
    if scopeStart > 0 {
        scopeEnd = BasicProcedureEndLine(source, scopeStart);
        local = true;
    }
    AddVariableDeclarationsFromList(decls, path, line, lineNumber,
                                    constCol + Str.get_Length("CONST"),
                                    scopeStart, scopeEnd, local, "constant",
                                    maxCount);
}

func AddClassFieldDeclaration(decls: Any,
                              path: String,
                              source: String,
                              line: String,
                              lineNumber: Integer,
                              lineCount: Integer,
                              maxCount: Integer) {
    if HasResultCapacity(decls, maxCount) == false { return; }
    if EnclosingBasicProcedureStartLine(source, lineNumber) > 0 { return; }
    var code = Str.Trim(line);
    if code == "" { return; }
    var firstCol = SemanticLexing.LeadingWhitespaceLength(line) + 1;
    var name = SemanticLexing.ReadBasicIdentifierAt(line, firstCol);
    if name == "" or SemanticLexing.IsKeyword(name) { return; }
    var afterName = firstCol + Str.get_Length(name);
    var asCol = SemanticLexing.KeywordColumnFrom(line, "AS", afterName);
    if asCol <= 0 { return; }
    var decl = NewDecl(path, name, "field", lineNumber, firstCol,
                       firstCol + Str.get_Length(name), 1, lineCount,
                       false, name, "", SemanticLexing.TypeTextAfterAs(line, asCol));
    Seq.Push(decls, decl);
}

func AddVariableDeclarationsFromList(decls: Any,
                                     path: String,
                                     line: String,
                                     lineNumber: Integer,
                                     startPos: Integer,
                                     scopeStart: Integer,
                                     scopeEnd: Integer,
                                     local: Boolean,
                                     kind: String,
                                     maxCount: Integer) {
    var pos = startPos;
    var actualScopeStart = scopeStart;
    if actualScopeStart <= 0 { actualScopeStart = 1; }
    while pos <= Str.get_Length(line) and HasResultCapacity(decls, maxCount) {
        pos = SemanticLexing.SkipWhitespaceAndCommas(line, pos);
        if pos > Str.get_Length(line) { break; }
        var name = SemanticLexing.ReadBasicIdentifierAt(line, pos);
        if name == "" { break; }
        var typeText = "";
        var asCol = SemanticLexing.KeywordColumnFrom(line, "AS", pos + Str.get_Length(name));
        var commaCol = SemanticLexing.NextCommaOutsideParens(line, pos + Str.get_Length(name));
        if asCol > 0 and (commaCol == 0 or asCol < commaCol) {
            typeText = SemanticLexing.TypeTextAfterAs(line, asCol);
        }
        var decl = NewDecl(path, name, kind, lineNumber, pos,
                           pos + Str.get_Length(name), actualScopeStart, scopeEnd,
                           local, name, "", typeText);
        Seq.Push(decls, decl);
        if commaCol == 0 { break; }
        pos = commaCol + 1;
    }
}

func AddParameterDeclarations(decls: Any,
                              path: String,
                              procDecl: Any,
                              maxCount: Integer) {
    var paramsText = Map.GetStr(procDecl, "paramsText");
    if paramsText == "" { return; }
    var procLine = Map.GetInt(procDecl, "line");
    var scopeStart = Map.GetInt(procDecl, "scopeStart");
    var scopeEnd = Map.GetInt(procDecl, "scopeEnd");
    var line = Map.GetStr(procDecl, "signatureLine");
    var openParen = Str.IndexOf(line, "(");
    if openParen == 0 { return; }

    var pos = openParen + 1;
    while pos <= Str.get_Length(line) and HasResultCapacity(decls, maxCount) {
        pos = SemanticLexing.SkipWhitespaceAndCommas(line, pos);
        pos = SemanticLexing.SkipParameterModifier(line, pos);
        var name = SemanticLexing.ReadBasicIdentifierAt(line, pos);
        if name == "" { break; }
        var commaCol = SemanticLexing.NextCommaOutsideParens(line, pos + Str.get_Length(name));
        var asCol = SemanticLexing.KeywordColumnFrom(line, "AS", pos + Str.get_Length(name));
        var typeText = "";
        if asCol > 0 and (commaCol == 0 or asCol < commaCol) {
            typeText = SemanticLexing.TypeTextAfterAs(line, asCol);
        }
        var decl = NewDecl(path, name, "parameter", procLine, pos,
                           pos + Str.get_Length(name), scopeStart, scopeEnd,
                           true, name, "", typeText);
        Seq.Push(decls, decl);
        if commaCol == 0 { break; }
        pos = commaCol + 1;
    }
}

func NewDecl(path: String,
             name: String,
             kind: String,
             lineNumber: Integer,
             column: Integer,
             endColumn: Integer,
             scopeStart: Integer,
             scopeEnd: Integer,
             local: Boolean,
             signature: String,
             paramsText: String,
             returnType: String) -> Any {
    var decl = Map.New();
    Map.SetBool(decl, "found", true);
    Map.SetStr(decl, "file", path);
    Map.SetStr(decl, "name", name);
    Map.SetStr(decl, "canon", CanonicalName(name));
    Map.SetStr(decl, "kind", kind);
    Map.SetInt(decl, "line", lineNumber);
    Map.SetInt(decl, "column", column);
    Map.SetInt(decl, "endLine", lineNumber);
    Map.SetInt(decl, "endColumn", endColumn);
    Map.SetInt(decl, "scopeStart", scopeStart);
    Map.SetInt(decl, "scopeEnd", scopeEnd);
    Map.SetBool(decl, "local", local);
    Map.SetStr(decl, "signature", signature);
    Map.SetStr(decl, "signatureLine", SourceSafeLine(signature));
    Map.SetStr(decl, "paramsText", paramsText);
    Map.SetStr(decl, "returnType", returnType);
    return decl;
}

func SourceSafeLine(text: String) -> String {
    return text;
}

func AddLineReferences(refs: Any,
                       path: String,
                       line: String,
                       lineNumber: Integer,
                       def: Any,
                       canon: String,
                       maxCount: Integer) {
    var pos = 1;
    var inString = false;
    var n = Str.get_Length(line);
    while pos <= n and HasResultCapacity(refs, maxCount) {
        var ch = Str.MidLen(line, pos, 1);
        if inString {
            if ch == "\"" {
                if pos < n and Str.MidLen(line, pos + 1, 1) == "\"" {
                    pos = pos + 2;
                    continue;
                }
                inString = false;
            }
            pos = pos + 1;
            continue;
        }
        if ch == "\"" {
            inString = true;
            pos = pos + 1;
            continue;
        }
        if ch == "'" { break; }
        if SemanticLexing.IsRemCommentAt(line, pos) { break; }
        if SemanticLexing.IsBasicIdentifierStart(ch) {
            var start = pos;
            var token = SemanticLexing.ReadBasicIdentifierAt(line, start);
            if token != "" {
                if CanonicalName(token) == canon {
                    var ref = Map.New();
                    Map.SetStr(ref, "file", path);
                    Map.SetStr(ref, "name", Map.GetStr(def, "name"));
                    Map.SetStr(ref, "text", token);
                    Map.SetInt(ref, "line", lineNumber);
                    Map.SetInt(ref, "column", start);
                    Map.SetInt(ref, "endLine", lineNumber);
                    Map.SetInt(ref, "endColumn", start + Str.get_Length(token));
                    Map.SetBool(ref, "isDefinition",
                                path == Map.GetStr(def, "file")
                                and lineNumber == Map.GetInt(def, "line")
                                and start == Map.GetInt(def, "column"));
                    Seq.Push(refs, ref);
                }
                pos = start + Str.get_Length(token);
                continue;
            }
        }
        pos = pos + 1;
    }
}

func AddOutgoingCallsFromLine(tokens: Any,
                              line: String,
                              lineNumber: Integer,
                              maxCount: Integer) {
    var pos = 1;
    var inString = false;
    var n = Str.get_Length(line);
    while pos <= n and HasResultCapacity(tokens, maxCount) {
        var ch = Str.MidLen(line, pos, 1);
        if inString {
            if ch == "\"" {
                if pos < n and Str.MidLen(line, pos + 1, 1) == "\"" {
                    pos = pos + 2;
                    continue;
                }
                inString = false;
            }
            pos = pos + 1;
            continue;
        }
        if ch == "\"" {
            inString = true;
            pos = pos + 1;
            continue;
        }
        if ch == "'" { break; }
        if SemanticLexing.IsRemCommentAt(line, pos) { break; }
        if SemanticLexing.IsBasicIdentifierStart(ch) {
            var start = pos;
            var name = SemanticLexing.ReadBasicIdentifierAt(line, start);
            var next = SemanticLexing.SkipWhitespace(line, start + Str.get_Length(name));
            if SemanticLexing.IsKeyword(name) == false
               and SemanticLexing.IsDeclarationNameAt(line, start) == false
               and next <= n
               and Str.MidLen(line, next, 1) == "(" {
                var token = Map.New();
                Map.SetStr(token, "name", name);
                Map.SetInt(token, "line", lineNumber);
                Map.SetInt(token, "column", start);
                Seq.Push(tokens, token);
            }
            pos = start + Str.get_Length(name);
            continue;
        }
        pos = pos + 1;
    }
}

/// @brief Return whether an append-oriented semantic result has capacity.
/// @param items Runtime sequence receiving result maps.
/// @param maxCount Maximum aggregate count, or zero for unlimited.
/// @return True when another item may be appended.
func HasResultCapacity(items: Any,
                       maxCount: Integer) -> Boolean {
    if items == null { return false; }
    return maxCount <= 0 or Seq.get_Count(items) < maxCount;
}

func ActiveCallAt(source: String,
                  lineNumber: Integer,
                  col0: Integer) -> Any {
    var result = Map.New();
    Map.SetBool(result, "available", false);
    var lines = Str.Split(source, "\n");
    var lineIdx = lineNumber - 1;
    if lineIdx >= Seq.get_Count(lines) { lineIdx = Seq.get_Count(lines) - 1; }
    if lineIdx < 0 { return result; }

    var minLine = lineIdx - BASIC_MAX_SIGNATURE_BACKTRACK_LINES + 1;
    if minLine < 0 { minLine = 0; }
    var depth = 0;
    var activeParam = 0;
    var row = lineIdx;
    while row >= minLine {
        var text = SemanticLexing.StripLineComment(Obj.ToString(Seq.Get(lines, row)));
        var pos = Str.get_Length(text);
        if row == lineIdx {
            pos = col0;
            if pos > Str.get_Length(text) { pos = Str.get_Length(text); }
        }
        while pos >= 1 {
            var ch = Str.MidLen(text, pos, 1);
            if ch == ")" {
                depth = depth + 1;
            } else if ch == "(" {
                if depth == 0 {
                    var name = CallNameBeforeOpenParen(text, pos);
                    if name == "" { return result; }
                    Map.SetBool(result, "available", true);
                    Map.SetStr(result, "name", name);
                    Map.SetInt(result, "activeParameter", activeParam);
                    Map.SetInt(result, "line", row + 1);
                    Map.SetInt(result, "column", pos);
                    return result;
                }
                depth = depth - 1;
            } else if ch == "," and depth == 0 {
                activeParam = activeParam + 1;
            }
            pos = pos - 1;
        }
        row = row - 1;
    }
    return result;
}

func CallNameBeforeOpenParen(line: String,
                             openCol: Integer) -> String {
    var pos = openCol - 1;
    while pos >= 1 and SemanticLexing.IsSpace(Str.MidLen(line, pos, 1)) { pos = pos - 1; }
    var endPos = pos;
    while pos >= 1 and SemanticLexing.IsBasicIdentifierChar(Str.MidLen(line, pos, 1)) {
        pos = pos - 1;
    }
    if endPos < pos + 1 { return ""; }
    return Str.MidLen(line, pos + 1, endPos - pos);
}

func SignatureRecordForDeclaration(decl: Any) -> Any {
    var sig = Map.New();
    var params = ParamsSeqFromText(Map.GetStr(decl, "paramsText"));
    Map.SetStr(sig, "name", Map.GetStr(decl, "name"));
    Map.SetStr(sig, "display", Map.GetStr(decl, "signature"));
    Map.Set(sig, "parameters", params);
    Map.SetStr(sig, "returnType", Map.GetStr(decl, "returnType"));
    Map.SetStr(sig, "documentation", "");
    Map.SetStr(sig, "source", "basic");
    return sig;
}

func ParamsSeqFromText(paramsText: String) -> Any {
    var params = Seq.New();
    var pos = 1;
    while pos <= Str.get_Length(paramsText) {
        pos = SemanticLexing.SkipWhitespaceAndCommas(paramsText, pos);
        pos = SemanticLexing.SkipParameterModifier(paramsText, pos);
        var name = SemanticLexing.ReadBasicIdentifierAt(paramsText, pos);
        if name == "" { break; }
        var commaCol = SemanticLexing.NextCommaOutsideParens(paramsText, pos + Str.get_Length(name));
        var asCol = SemanticLexing.KeywordColumnFrom(paramsText, "AS", pos + Str.get_Length(name));
        var typeText = "";
        if asCol > 0 and (commaCol == 0 or asCol < commaCol) {
            typeText = SemanticLexing.TypeTextAfterAs(paramsText, asCol);
        }
        var param = Map.New();
        Map.SetStr(param, "name", name);
        Map.SetStr(param, "type", typeText);
        Seq.Push(params, param);
        if commaCol == 0 { break; }
        pos = commaCol + 1;
    }
    return params;
}

func SignatureDisplay(keyword: String,
                      name: String,
                      paramsText: String,
                      returnType: String) -> String {
    var text = keyword + " " + name + "(" + SemanticLexing.CleanInline(paramsText) + ")";
    if returnType != "" {
        text = text + " AS " + returnType;
    }
    return text;
}

func IsCallableKind(kind: String) -> Boolean {
    return kind == "function" or kind == "property";
}
