//
// File: zannastudio/src/commands/edit_basic_navigation.zia
// Purpose: BASIC definition, reference, and call-hierarchy navigation.
// Key invariants:
//   - Queries use live document content and publish structured locations.
// Ownership/Lifetime:
//   - Handlers borrow shell, document, index, editor, and location services.
// Links: zannastudio/src/basic/semantic_scan.zia,
//        zannastudio/src/commands/edit_commands.zia
//
//===----------------------------------------------------------------------===//

module edit_basic_navigation;

bind "../ui/app_shell";
bind "../editor/editor_engine";
bind "../core/document_manager";
bind "../core/project_manager";
bind "../editor/editor_tabs";
bind "../editor/project_index";
bind "../services/locations";
bind "../services/safe_io";
bind "../services/text_utils";
bind "../services/workspace_file_index";
bind "../commands/file_commands";
bind "../basic/semantic_scan";
bind "../zia/source_scan";

bind Zanna.GUI;
bind IO = Zanna.IO;
bind Path = Zanna.IO.Path;
bind Str = Zanna.String;
bind Seq = Zanna.Collections.Seq;
bind Obj = Zanna.Core.Object;
bind Map = Zanna.Collections.Map;

func ReferencePreviewLine(docMgr: document_manager.DocumentManager,
                          filePath: String,
                          lineNumber: Integer) -> String {
    var source = SourceForPath(docMgr, filePath);
    if source == "" { return ""; }
    var lines = Str.Split(source, "\n");
    if lineNumber < 1 or lineNumber > Seq.get_Count(lines) { return ""; }
    return Str.Trim(Obj.ToString(Seq.Get(lines, lineNumber - 1)));
}

func SourceForPath(docMgr: document_manager.DocumentManager,
                   filePath: String) -> String {
    if docMgr != null {
        var idx = docMgr.FindByPath(filePath);
        if idx >= 0 {
            return docMgr.documents.get(idx).content;
        }
    }
    if IO.File.Exists(filePath) {
        var readResult = safe_io.ReadAllTextBounded(
            filePath, document_manager.MAX_TEXT_OPEN_BYTES);
        if readResult.ok { return readResult.text; }
    }
    return "";
}

expose func handleBasicGoToDefinition(shell: app_shell.AppShell,
                               docMgr: document_manager.DocumentManager,
                               engine: editor_engine.EditorEngine,
                               tabs: editor_tabs.EditorTabs,
                               indexer: project_index.ProjectIndexer,
                               locStore: locations.LocationStore,
                               activeDoc: document.Document) {
    file_commands.SaveEditorState(docMgr, engine);
    var source = engine.GetTextSnapshot();
    activeDoc.content = source;
    var token = semantic_scan.IdentifierAt(source, engine.editor.CursorLine + 1,
                                           engine.editor.CursorCol);
    if token == "" {
        shell.SetStatusLeft("No BASIC symbol at cursor");
        return;
    }
    var decls = BasicWorkspaceDeclarations(docMgr, indexer, activeDoc);
    var def = semantic_scan.BestDefinition(decls, activeDoc.filePath,
                                           engine.editor.CursorLine + 1, token);
    if def != null and Map.GetBool(def, "found") {
        var file = Map.GetStr(def, "file");
        var line = Map.GetInt(def, "line");
        var col = Map.GetInt(def, "column");
        var endLine = Map.GetIntOr(def, "endLine", line);
        var endCol = Map.GetIntOr(def, "endColumn", col + Str.get_Length(token));
        var id = locStore.Add(file, line, col, endLine, endCol,
                              locations.KIND_DEFINITION, Map.GetStr(def, "name"));
        if locStore.OpenLocation(shell, docMgr, engine, tabs, id) {
            shell.SetStatusLeft("Definition: " + Map.GetStr(def, "name"));
        }
        return;
    }
    shell.SetStatusLeft("Definition not found");
}

expose func handleBasicFindReferences(shell: app_shell.AppShell,
                               docMgr: document_manager.DocumentManager,
                               engine: editor_engine.EditorEngine,
                               indexer: project_index.ProjectIndexer,
                               locStore: locations.LocationStore,
                               activeDoc: document.Document) {
    file_commands.SaveEditorState(docMgr, engine);
    var source = engine.GetTextSnapshot();
    activeDoc.content = source;
    var token = semantic_scan.IdentifierAt(source, engine.editor.CursorLine + 1,
                                           engine.editor.CursorCol);
    if token == "" {
        shell.SetStatusLeft("No BASIC symbol at cursor");
        return;
    }
    var decls = BasicWorkspaceDeclarations(docMgr, indexer, activeDoc);
    var def = semantic_scan.BestDefinition(decls, activeDoc.filePath,
                                           engine.editor.CursorLine + 1, token);
    if def == null or Map.GetBool(def, "found") == false {
        shell.SetStatusLeft("Definition not found");
        return;
    }
    var refs = BasicWorkspaceReferences(docMgr, indexer, activeDoc, def);
    RenderBasicReferences(shell, docMgr, locStore, refs, "references");
}

expose func handleBasicIncomingCalls(shell: app_shell.AppShell,
                              docMgr: document_manager.DocumentManager,
                              engine: editor_engine.EditorEngine,
                              indexer: project_index.ProjectIndexer,
                              locStore: locations.LocationStore,
                              activeDoc: document.Document) {
    file_commands.SaveEditorState(docMgr, engine);
    var source = engine.GetTextSnapshot();
    activeDoc.content = source;
    var token = semantic_scan.IdentifierAt(source, engine.editor.CursorLine + 1,
                                           engine.editor.CursorCol);
    if token == "" {
        shell.SetStatusLeft("No BASIC symbol at cursor");
        return;
    }
    var decls = BasicWorkspaceDeclarations(docMgr, indexer, activeDoc);
    var def = semantic_scan.BestDefinition(decls, activeDoc.filePath,
                                           engine.editor.CursorLine + 1, token);
    if def == null or Map.GetBool(def, "found") == false {
        shell.SetStatusLeft("Definition not found");
        return;
    }
    var refs = BasicWorkspaceReferences(docMgr, indexer, activeDoc, def);
    shell.toolPanels.ClearToolRows(shell.toolPanels.referencesListBox);
    var i = 0;
    var count = 0;
    var lastGroup = "";
    while i < Seq.get_Count(refs) {
        var ref = Seq.Get(refs, i);
        if Map.GetBool(ref, "isDefinition") {
            i = i + 1;
            continue;
        }
        var file = Map.GetStr(ref, "file");
        var line = Map.GetInt(ref, "line");
        var col = Map.GetInt(ref, "column");
        var caller = semantic_scan.EnclosingBasicProcedureName(SourceForPath(docMgr, file), line);
        if caller == "" { caller = "<top-level>"; }
        var group = file + "|" + caller;
        if group != lastGroup {
            shell.toolPanels.AddToolGroupHeader(shell.toolPanels.referencesListBox, caller, Path.Name(file));
            lastGroup = group;
        }
        var preview = ReferencePreviewLine(docMgr, file, line);
        var id = locStore.Add(file, line, col, Map.GetIntOr(ref, "endLine", line),
                              Map.GetIntOr(ref, "endColumn", col + 1),
                              locations.KIND_REFERENCE, Map.GetStr(ref, "name"));
        var item = shell.toolPanels.AddToolLocationRow(shell.toolPanels.referencesListBox,
                                            "call", "basic",
                                            "" + line + ":" + col,
                                            "", preview, "");
        shell.toolPanels.SetAddedToolRowLocationData(
            shell.toolPanels.referencesListBox, item, id);
        count = count + 1;
        i = i + 1;
    }
    if count == 0 {
        shell.toolPanels.HideReferencesPanel();
        shell.SetStatusLeft("No incoming calls found");
        return;
    }
    shell.toolPanels.ShowReferencesPanel();
    shell.SetStatusLeft("Found " + count + " incoming calls");
}

expose func handleBasicOutgoingCalls(shell: app_shell.AppShell,
                              docMgr: document_manager.DocumentManager,
                              engine: editor_engine.EditorEngine,
                              indexer: project_index.ProjectIndexer,
                              locStore: locations.LocationStore,
                              activeDoc: document.Document) {
    file_commands.SaveEditorState(docMgr, engine);
    var source = engine.GetTextSnapshot();
    activeDoc.content = source;
    var cursorLine = engine.editor.CursorLine + 1;
    var startLine = semantic_scan.EnclosingBasicProcedureStartLine(source, cursorLine);
    if startLine <= 0 {
        shell.toolPanels.HideReferencesPanel();
        shell.SetStatusLeft("No enclosing BASIC procedure found");
        return;
    }
    var endLine = semantic_scan.BasicProcedureEndLine(source, startLine);
    var callerName = semantic_scan.EnclosingBasicProcedureName(source, cursorLine);
    if callerName == "" { callerName = "<procedure>"; }
    var tokens = semantic_scan.OutgoingBasicCallTokens(source, startLine, endLine) as Seq;
    shell.toolPanels.ClearToolRows(shell.toolPanels.referencesListBox);
    if tokens == null or Seq.get_Count(tokens) == 0 {
        shell.toolPanels.HideReferencesPanel();
        shell.SetStatusLeft("No outgoing calls found");
        return;
    }

    var decls = BasicWorkspaceDeclarations(docMgr, indexer, activeDoc);
    var i = 0;
    var count = 0;
    var lastTarget = "";
    while i < Seq.get_Count(tokens) {
        var tokenMap = Seq.Get(tokens, i);
        var tokenLine = Map.GetInt(tokenMap, "line");
        var tokenCol = Map.GetInt(tokenMap, "column");
        var tokenName = Map.GetStr(tokenMap, "name");
        var def = semantic_scan.BestDefinition(decls, activeDoc.filePath, tokenLine, tokenName);
        if def != null and Map.GetBool(def, "found") {
            var file = Map.GetStr(def, "file");
            var line = Map.GetInt(def, "line");
            var col = Map.GetInt(def, "column");
            var targetName = Map.GetStr(def, "name");
            var targetGroup = file + "|" + targetName + "|" + line + "|" + col;
            if targetGroup != lastTarget {
                shell.toolPanels.AddToolGroupHeader(shell.toolPanels.referencesListBox,
                                         callerName + " -> " + targetName,
                                         Path.Name(file));
                lastTarget = targetGroup;
            }
            var preview = ReferencePreviewLine(docMgr, activeDoc.filePath, tokenLine);
            var id = locStore.Add(file, line, col,
                                  Map.GetIntOr(def, "endLine", line),
                                  Map.GetIntOr(def, "endColumn", col + 1),
                                  locations.KIND_DEFINITION, targetName);
            var item = shell.toolPanels.AddToolLocationRow(shell.toolPanels.referencesListBox,
                                                "call", "basic",
                                                "" + tokenLine + ":" + tokenCol,
                                                "definition", preview, "");
            shell.toolPanels.SetAddedToolRowLocationData(
                shell.toolPanels.referencesListBox, item, id);
            count = count + 1;
        }
        i = i + 1;
    }
    if count == 0 {
        shell.toolPanels.HideReferencesPanel();
        shell.SetStatusLeft("No outgoing calls found");
        return;
    }
    shell.toolPanels.ShowReferencesPanel();
    shell.SetStatusLeft("Found " + count + " outgoing calls");
}

func RenderBasicReferences(shell: app_shell.AppShell,
                           docMgr: document_manager.DocumentManager,
                           locStore: locations.LocationStore,
                           refs: Seq,
                           label: String) {
    shell.toolPanels.ClearToolRows(shell.toolPanels.referencesListBox);
    if refs == null or Seq.get_Count(refs) == 0 {
        shell.toolPanels.HideReferencesPanel();
        shell.SetStatusLeft("No " + label + " found");
        return;
    }
    var i = 0;
    var lastFile = "";
    while i < Seq.get_Count(refs) {
        var ref = Seq.Get(refs, i);
        var file = Map.GetStr(ref, "file");
        var line = Map.GetInt(ref, "line");
        var col = Map.GetInt(ref, "column");
        var endLine = Map.GetIntOr(ref, "endLine", line);
        var endCol = Map.GetIntOr(ref, "endColumn", col + 1);
        var marker = "";
        if Map.GetBool(ref, "isDefinition") { marker = "definition"; }
        if file != lastFile {
            shell.toolPanels.AddToolGroupHeader(shell.toolPanels.referencesListBox, Path.Name(file), file);
            lastFile = file;
        }
        var preview = ReferencePreviewLine(docMgr, file, line);
        var id = locStore.Add(file, line, col, endLine, endCol,
                              locations.KIND_REFERENCE, Map.GetStr(ref, "name"));
        var item = shell.toolPanels.AddToolLocationRow(shell.toolPanels.referencesListBox,
                                            "ref", "basic",
                                            "" + line + ":" + col,
                                            marker, preview, "");
        shell.toolPanels.SetAddedToolRowLocationData(
            shell.toolPanels.referencesListBox, item, id);
        i = i + 1;
    }
    shell.toolPanels.ShowReferencesPanel();
    shell.SetStatusLeft("Found " + Seq.get_Count(refs) + " " + label);
}

func BasicWorkspaceDeclarations(docMgr: document_manager.DocumentManager,
                                indexer: project_index.ProjectIndexer,
                                activeDoc: document.Document) -> Seq {
    var decls = Seq.New();
    if activeDoc == null { return decls; }
    var files = BasicWorkspaceFiles(docMgr, indexer, activeDoc);
    var i = 0;
    while i < files.count() {
        var filePath = Obj.ToString(files.get(i));
        semantic_scan.AddDeclarations(decls, filePath, SourceForPath(docMgr, filePath));
        i = i + 1;
    }
    if activeDoc.filePath == "" {
        semantic_scan.AddDeclarations(decls, "", activeDoc.content);
    }
    return decls;
}

func BasicWorkspaceReferences(docMgr: document_manager.DocumentManager,
                              indexer: project_index.ProjectIndexer,
                              activeDoc: document.Document,
                              def: Any) -> Seq {
    var refs = Seq.New();
    if activeDoc == null or def == null { return refs; }
    var files = BasicWorkspaceFiles(docMgr, indexer, activeDoc);
    var i = 0;
    while i < files.count() {
        var filePath = Obj.ToString(files.get(i));
        semantic_scan.AddReferencesForFile(refs, filePath,
                                           SourceForPath(docMgr, filePath), def);
        i = i + 1;
    }
    if activeDoc.filePath == "" {
        semantic_scan.AddReferencesForFile(refs, "", activeDoc.content, def);
    }
    return refs;
}

func BasicWorkspaceFiles(docMgr: document_manager.DocumentManager,
                         indexer: project_index.ProjectIndexer,
                         activeDoc: document.Document) -> List {
    var files = new List();
    var root = "";
    if indexer != null { root = indexer.rootPath; }
    if root == "" and activeDoc != null and activeDoc.filePath != "" {
        root = Path.Directory(activeDoc.filePath);
    }
    if root != "" {
        workspace_file_index.AddEnumeratedFiles(files, root, ".bas,.vb", "");
    }
    if docMgr != null {
        var i = 0;
        while i < docMgr.GetCount() {
            var doc = docMgr.documents.get(i);
            if doc.language == "basic" and doc.filePath != "" {
                if workspace_file_index.ListContains(files, doc.filePath) == false {
                    files.Push(doc.filePath);
                }
            }
            i = i + 1;
        }
    }
    if activeDoc != null and activeDoc.filePath != "" {
        if workspace_file_index.ListContains(files, activeDoc.filePath) == false {
            files.Push(activeDoc.filePath);
        }
    }
    return files;
}

func SkipWhitespace(line: String,
                    pos: Integer) -> Integer {
    return source_scan.SkipWhitespace(line, pos);
}
