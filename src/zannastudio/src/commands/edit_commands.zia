/// @brief Toggle the find bar; auto-focuses when shown.
func handleFind(shell: app_shell.AppShell) {
    if shell.workbench.findBar.IsVisible() {
        shell.workbench.findBar.SetVisible(false);
    } else {
        shell.workbench.findBar.SetVisible(true);
        shell.workbench.findBar.Focus();
    }
}

/// @brief Jump to a line from a non-modal command-input value.
/// @param shell Workbench shell used for status feedback.
/// @param engine Active editor engine.
/// @param lineText User-entered line number text.
/// @return True when the editor jumped to a valid positive line.
func handleGoToLineText(shell: app_shell.AppShell,
                        engine: editor_engine.EditorEngine,
                        lineText: String) -> Boolean {
    var clean = Str.Trim(lineText);
    if clean == "" { return false; }
    if IsPositiveIntegerText(clean) == false {
        shell.SetStatusLeft("Go To Line: enter a positive line number");
        return false;
    }
    var lineNum = Convert.ToInt64(clean);
    if lineNum <= 0 {
        shell.SetStatusLeft("Go To Line: enter a positive line number");
        return false;
    }
    engine.GoToLine(lineNum);
    shell.SetStatusLeft("Jumped to line " + lineNum);
    return true;
}

/// @brief Return whether text contains only ASCII decimal digits.
/// @param text Trimmed candidate line number.
/// @return True when every character is 0-9.
hide func IsPositiveIntegerText(text: String) -> Boolean {
    if text == "" { return false; }
    var i = 0;
    while i < Str.get_Length(text) {
        var ch = Str.ByteAt(text, i);
        if ch < 48 or ch > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

