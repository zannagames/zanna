//
// File: zannastudio/src/commands/file_save_support.zia
// Purpose: Normalize save text and synchronize editor/document presentation.
// Key invariants:
//   - Visual scene serializers are never rewritten by text-save preferences.
//   - Save normalization is one undoable buffer edit and preserves cursors,
//     selections, folds, scroll, and prior history for active and detached tabs.
//   - Existing LF, CRLF, and CR terminators are preserved per line; only a newly
//     appended final terminator uses the documented dominant-style policy.
//   - External-change confirmation reports the exact observed disk state.
// Ownership/Lifetime:
//   - Module state owns save-format preferences; all UI/model objects are borrowed.
// Links: zannastudio/src/commands/file_commands.zia,
//        zannastudio/src/core/document_manager.zia
//
//===----------------------------------------------------------------------===//

module file_save_support;

bind "../ui/app_shell";
bind "../core/document";
bind "../core/document_manager";
bind "../editor/editor_engine";
bind "../services/file_utils";

bind Zanna.GUI;
bind Str = Zanna.String;
bind Seq = Zanna.Collections.Seq;
bind Obj = Zanna.Core.Object;

var trimTrailingWhitespaceOnSave = false;
var ensureFinalNewlineOnSave = true;

func SetSaveFormatOptions(trimWhitespace: Boolean,
                          finalNewline: Boolean) {
    trimTrailingWhitespaceOnSave = trimWhitespace;
    ensureFinalNewlineOnSave = finalNewline;
}

func NormalizeDocumentForSave(docMgr: document_manager.DocumentManager,
                              engine: editor_engine.EditorEngine,
                              index: Integer) {
    if docMgr == null or index < 0 or index >= docMgr.GetCount() { return; }
    var doc = docMgr.documents.get(index);
    if doc.isReadOnlyPreview { return; }
    // Scene controllers already own a canonical serializer. Text-editor save
    // preferences (especially the default final-newline rule) must not rewrite
    // those assets, desynchronize visual history, or force a post-save reload.
    if file_utils.IsVisualKind(doc.kind) { return; }
    var normalized = ApplySaveTextRules(doc.content);
    if normalized != doc.content {
        if engine != null {
            if engine.ReplaceDocumentTextPreservingState(doc, normalized) == false {
                return;
            }
        } else {
            doc.content = normalized;
            doc.isModified = true;
        }
    }
}

func ApplySaveTextRules(text: String) -> String {
    return ApplySaveTextRulesWithOptions(text,
                                         trimTrailingWhitespaceOnSave,
                                         ensureFinalNewlineOnSave);
}

/// @brief Apply one immutable save-policy snapshot, including on worker threads.
func ApplySaveTextRulesWithOptions(text: String,
                                   trimWhitespace: Boolean,
                                   finalNewline: Boolean) -> String {
    var result = text;
    if trimWhitespace {
        result = TrimTrailingWhitespacePreservingEol(result);
    }

    if finalNewline and Str.EndsWith(result, "\n") == false
       and Str.EndsWith(result, "\r") == false {
        result = result + PreferredFinalEol(result);
    }
    return result;
}

func TrimTrailingWhitespaceOnSaveEnabled() -> Boolean {
    return trimTrailingWhitespaceOnSave;
}

func EnsureFinalNewlineOnSaveEnabled() -> Boolean {
    return ensureFinalNewlineOnSave;
}

/// @brief Trim line suffixes while retaining every original line terminator.
/// @details Split preserves trailing empty segments. LF partitions identify LF
///          versus CRLF, and an inner CR split preserves legacy CR-only lines.
func TrimTrailingWhitespacePreservingEol(text: String) -> String {
    var output = new Zanna.Text.StringBuilder();
    var lfParts = Str.Split(text, "\n");
    var i = 0;
    while i < Seq.get_Count(lfParts) {
        var line = Obj.ToString(Seq.Get(lfParts, i));
        var terminator = "";
        if i + 1 < Seq.get_Count(lfParts) {
            terminator = "\n";
            if Str.EndsWith(line, "\r") {
                line = Str.Left(line, Str.get_Length(line) - 1);
                terminator = "\r\n";
            }
        }

        var crParts = Str.Split(line, "\r");
        var j = 0;
        while j < Seq.get_Count(crParts) {
            output.Append(TrimLineRightWhitespace(
                Obj.ToString(Seq.Get(crParts, j))));
            if j + 1 < Seq.get_Count(crParts) { output.Append("\r"); }
            j = j + 1;
        }
        if terminator != "" { output.Append(terminator); }
        i = i + 1;
    }
    return output.ToString();
}

/// @brief Choose only the terminator appended to a file that lacks one.
/// @details The most frequent existing style wins; ties and files without an
///          existing terminator use LF. Existing terminators are never changed.
func PreferredFinalEol(text: String) -> String {
    var crlfCount = Str.Count(text, "\r\n");
    var lfCount = Str.Count(text, "\n") - crlfCount;
    var crCount = Str.Count(text, "\r") - crlfCount;
    if crlfCount > lfCount and crlfCount >= crCount { return "\r\n"; }
    if crCount > lfCount and crCount > crlfCount { return "\r"; }
    return "\n";
}

func TrimLineRightWhitespace(line: String) -> String {
    var end = Str.get_Length(line);
    while end > 0 {
        var ch = Str.MidLen(line, end, 1);
        if ch != " " and ch != "\t" { break; }
        end = end - 1;
    }
    if end <= 0 { return ""; }
    return Str.Left(line, end);
}

func ConfirmOverwriteExternal(shell: app_shell.AppShell,
                              docMgr: document_manager.DocumentManager,
                              index: Integer,
                              state: Integer) -> Boolean {
    if state == document.EXTERNAL_STATE_CLEAN {
        return true;
    }
    var doc = docMgr.documents.get(index);
    var title = "File Changed on Disk";
    var msg = doc.fileName + " changed on disk since it was opened or saved.\nOverwrite it?";
    if state == document.EXTERNAL_STATE_DELETED {
        title = "File Deleted on Disk";
        msg = doc.fileName + " was deleted on disk.\nRecreate it at the original path?";
    } else if state == document.EXTERNAL_STATE_RENAMED {
        title = "File Moved on Disk";
        msg = doc.fileName + " was renamed or moved on disk.\nRecreate it at the original path?";
    } else if state == document.EXTERNAL_STATE_MISSING {
        title = "File Missing on Disk";
        msg = doc.fileName + " is missing on disk.\nRecreate it at the original path?";
    }
    var confirmed = GUI.MessageBox.Confirm(
        title,
        msg);
    if confirmed == 0 {
        shell.SetStatusLeft("Save canceled: " + docMgr.ExternalStateMessage(index));
        return false;
    }
    return true;
}

/// @brief Flush the focused pane into its owning Document and activate it.
/// @details Pane focus is authoritative. Repairing DocumentManager selection
///          here makes every command preflight safe even if a native focus
///          event and the app-level tab synchronization occur in one frame.
func SaveEditorState(docMgr: document_manager.DocumentManager,
                     engine: editor_engine.EditorEngine) {
    if docMgr == null or engine == null {
        return;
    }
    var doc = engine.currentDoc;
    if doc != null {
        engine.SaveToDocument(doc);
        docMgr.SetActiveDocument(doc);
    }
}

/// @brief Build the right-aligned status-bar label "Lang | EOL".
/// @details Reports Mixed rather than implying that one observed CRLF controls
///          the complete document.
func DocStatusLabel(doc: document.Document) -> String {
    if doc.kind == file_utils.DOC_KIND_SCENE_2D {
        return "2D Scene  |  Visual";
    }
    if doc.kind == file_utils.DOC_KIND_SCENE_3D {
        return "3D Scene  |  Visual";
    }
    var lang = "Text";
    if doc.language == "zia"   { lang = "Zia"; }
    if doc.language == "basic" { lang = "Basic"; }
    if doc.language == "scene" { lang = "Scene"; }

    var crlfCount = Str.Count(doc.content, "\r\n");
    var lfCount = Str.Count(doc.content, "\n") - crlfCount;
    var crCount = Str.Count(doc.content, "\r") - crlfCount;
    var styles = 0;
    if crlfCount > 0 { styles = styles + 1; }
    if lfCount > 0 { styles = styles + 1; }
    if crCount > 0 { styles = styles + 1; }
    var eol = "LF";
    if styles > 1 {
        eol = "Mixed";
    } else if crlfCount > 0 {
        eol = "CRLF";
    } else if crCount > 0 {
        eol = "CR";
    }

    if doc.isReadOnlyPreview {
        return lang + "  |  Read-only preview";
    }
    return lang + "  |  " + eol;
}
