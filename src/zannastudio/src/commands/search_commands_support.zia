/// @brief Return true when a file source should be skipped by project search.
/// @param docMgr Open document manager used to measure edited in-memory buffers.
/// @param filePath Absolute candidate path.
/// @return True when the live buffer or closed file exceeds the search guard.
/// @details Open buffers still take precedence over disk, but they are not
///          exempt from the ceiling: splitting a pathological unsaved buffer on
///          the UI thread is just as expensive as reading a generated disk file.
func SearchDiskFileTooLarge(docMgr: document_manager.DocumentManager,
                            filePath: String) -> Boolean {
    if filePath == "" { return false; }
    var size = SearchContentSize(docMgr, filePath);
    return size < 0 or size > MAX_SEARCH_FILE_BYTES;
}

/// @brief Estimate the source size search will materialize for one path.
func SearchContentSize(docMgr: document_manager.DocumentManager,
                       filePath: String) -> Integer {
    if docMgr != null {
        var docIndex = docMgr.FindByPath(filePath);
        if docIndex >= 0 {
            return Str.get_Length(docMgr.documents.get(docIndex).content);
        }
    }
    if IO.File.Exists(filePath) == false { return -1; }
    return safe_io.SizeBytes(filePath);
}

func searchOneFile(shell: app_shell.AppShell,
                   filePath: String,
                   query: String,
                   caseSensitive: Boolean,
                   wholeWord: Boolean,
                   regexMode: Boolean,
                   docMgr: document_manager.DocumentManager,
                   locStore: locations.LocationStore,
                   maxResults: Integer) -> Integer {
    var program = search_matcher.CompileSearch(query, caseSensitive,
                                               wholeWord, regexMode);
    if program.valid == false { return 0; }
    return searchOneFileWithProgram(shell, filePath, program,
                                    docMgr, locStore, maxResults);
}

/// @brief Search one file with a request-owned compiled matcher.
/// @details Publishes every non-overlapping occurrence on each line, including
///          zero-width matches. The runtime-provided resume offset guarantees
///          Unicode-safe progress without recompiling the query.
func searchOneFileWithProgram(shell: app_shell.AppShell,
                              filePath: String,
                              program: search_matcher.SearchProgram,
                              docMgr: document_manager.DocumentManager,
                              locStore: locations.LocationStore,
                              maxResults: Integer) -> Integer {
    return searchOneFileWithProgramResult(shell, filePath, program, docMgr,
                                          locStore, maxResults).matches;
}

/// @brief Search one file and preserve bounded-read failures as ordinary data.
/// @details An empty file is a successful source. A missing, unreadable, raced,
///          or oversized closed file is an explicit failure so a controller
///          cannot publish a silently incomplete result set.
func searchOneFileWithProgramResult(
    shell: app_shell.AppShell,
    filePath: String,
    program: search_matcher.SearchProgram,
    docMgr: document_manager.DocumentManager,
    locStore: locations.LocationStore,
    maxResults: Integer) -> SearchFileResult {
    var result = new SearchFileResult();
    if maxResults <= 0 or program == null or program.valid == false {
        result.error = "search program is unavailable";
        return result;
    }
    var source = contentResultForPath(docMgr, filePath);
    if source.ok == false {
        result.error = source.error;
        return result;
    }
    var count = 0;
    var content = source.text;
    var sourceRevision = Hash.Sha256(content);
    var contentLines = Str.Split(content, "\n");
    var lineNum = 0;
    var addedHeader = false;
    while lineNum < Seq.get_Count(contentLines) and count < maxResults {
        var line = Obj.ToString(Seq.Get(contentLines, lineNum));
        lineNum = lineNum + 1;
        var offset = 0;
        var lineLength = Str.get_Length(line);
        while offset <= lineLength and count < maxResults {
            var match = search_matcher.FindLineMatchFrom(line, offset, program);
            if match.matched == false { break; }
            if addedHeader == false {
                shell.toolPanels.AddToolGroupHeader(shell.toolPanels.searchListBox, Path.Name(filePath), filePath);
                addedHeader = true;
            }
            var resultText = Str.Trim(line);
            var item = shell.toolPanels.AddToolLocationRow(shell.toolPanels.searchListBox, "match", "text",
                                                "" + lineNum + ":" + match.startCol,
                                                "", resultText, "");
            var locId = locStore.AddSearch(filePath, lineNum, match.startCol,
                                           lineNum, match.startCol + match.length,
                                           Str.Trim(line), sourceRevision, line);
            shell.toolPanels.SetAddedToolRowLocationData(
                shell.toolPanels.searchListBox, item, locId);
            count = count + 1;
            offset = match.resumeOffset;
        }
    }
    result.ok = true;
    result.matches = count;
    return result;
}

func QuickOpenScore(relativePath: String, query: String) -> Integer {
    return quick_open_commands.QuickOpenScore(relativePath, query);
}

func contentForPath(docMgr: document_manager.DocumentManager, filePath: String) -> String {
    var result = contentResultForPath(docMgr, filePath);
    if result.ok { return result.text; }
    return "";
}

/// @brief Materialize live or on-disk search source under the hard file cap.
func contentResultForPath(docMgr: document_manager.DocumentManager,
                          filePath: String) -> SearchContentResult {
    var result = new SearchContentResult();
    if filePath == "" {
        result.error = "search source path is empty";
        return result;
    }
    if docMgr != null {
        var idx = docMgr.FindByPath(filePath);
        if idx >= 0 {
            result.text = docMgr.documents.get(idx).content;
            if Str.get_Length(result.text) > MAX_SEARCH_FILE_BYTES {
                result.text = "";
                result.error = "search source exceeds the file byte budget: " + filePath;
                return result;
            }
            result.ok = true;
            return result;
        }
    }
    var readResult = safe_io.ReadAllTextBounded(filePath, MAX_SEARCH_FILE_BYTES);
    if readResult.ok == false {
        result.error = "search source is unavailable, unreadable, or changed while reading: "
                       + filePath;
        return result;
    }
    result.ok = true;
    result.text = readResult.text;
    return result;
}

