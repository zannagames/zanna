//
// File: zannastudio/src/core/recovery_store.zia
// Purpose: Bounded recovery discovery, validation, and clean-exit cleanup.
// Key invariants:
//   - Live instance namespaces are excluded by process-lifetime file leases.
//   - Metadata identities are authenticated against SHA-256 swap basenames.
//   - Scan count and retained payload bytes remain caller-bounded.
//   - Clean tombstones are durable before leases are released.
// Ownership/Lifetime:
//   - Inherited state owns current and explicitly claimed namespace leases.
// Links: zannastudio/src/core/recovery_store_base.zia,
//        zannastudio/src/core/recovery_types.zia,
//        docs/adr/0276-process-lifetime-file-leases-and-isolated-studio-recovery.md
//
//===----------------------------------------------------------------------===//

module recovery_store;

bind "document_manager";
bind "../editor/editor_engine";
bind "../services/file_utils";
bind "../services/safe_io";
bind "recovery_store_base" as Base;
bind "recovery_types" as Types;

bind File = Zanna.IO.File;
bind FileLease = Zanna.IO.FileLease;
bind Path = Zanna.IO.Path;
bind Dir = Zanna.IO.Dir;
bind Hash = Zanna.Crypto.Hash;
bind Json = Zanna.Data.Json;
bind Uuid = Zanna.Text.Uuid;
bind Str = Zanna.String;
bind Obj = Zanna.Core.Object;
bind Map = Zanna.Collections.Map;
bind Async = Zanna.Threads.Async;
bind Future = Zanna.Threads.Future;

final MAX_RECOVERY_PATH_BYTES = Types.MAX_RECOVERY_PATH_BYTES;
final MAX_RECOVERY_METADATA_BYTES = Types.MAX_RECOVERY_METADATA_BYTES;
final MAX_RECOVERY_SWAP_BYTES = Types.MAX_RECOVERY_SWAP_BYTES;
final MAX_RECOVERY_RECORDS = Types.MAX_RECOVERY_RECORDS;
final MAX_RECOVERY_TOTAL_BYTES = Types.MAX_RECOVERY_TOTAL_BYTES;
final RECOVERY_FORMAT_VERSION = Types.RECOVERY_FORMAT_VERSION;

type RecoveryRecord = Types.RecoveryRecord;
type RecoveryScanJob = Types.RecoveryScanJob;
type RecoveryPayloadCandidate = Types.RecoveryPayloadCandidate;
type RecoveryPayloadReadRequest = Types.RecoveryPayloadReadRequest;
type RecoveryWriteRequest = Types.RecoveryWriteRequest;
type RecoveryWriteSnapshot = Types.RecoveryWriteSnapshot;

func RunRecoveryPayloadRead(request: RecoveryPayloadReadRequest) -> Any {
    return Types.ReadRecoveryPayloads(request);
}

/// @brief Recovery discovery and cleanup layered over leased write ownership.
class RecoveryStore extends Base.RecoveryStoreBase {
    expose func init() {
        InitializeRecoveryState();
    }

    /// @brief Queue immutable modified-buffer snapshots for background I/O.
    expose func QueueSwaps(docMgr: document_manager.DocumentManager,
                           engine: editor_engine.EditorEngine) -> Boolean {
        if recoveryDir == "" or lockClaimed == false or docMgr == null {
            return false;
        }
        var request = BuildRequest(docMgr, engine, false);
        if request == null { return false; }
        if request.error != "" { lastAsyncError = request.error; }
        if request.succeeded == false {
            return false;
        }
        if request.snapshots.count() == 0 { return request.truncated == false; }
        asyncQueuedRequests = asyncQueuedRequests + 1;
        if activeFuture == null { return StartRequest(request); }
        pendingRequest = request;
        return true;
    }

    /// @brief Synchronously write all current modified-buffer swaps.
    expose func WriteSwaps(docMgr: document_manager.DocumentManager,
                           engine: editor_engine.EditorEngine) -> Boolean {
        if recoveryDir == "" or lockClaimed == false or docMgr == null {
            return false;
        }
        CancelAsync();
        var request = BuildRequest(docMgr, engine, true);
        var allWritten = request != null and request!.succeeded
            and request!.truncated == false;
        if request != null and request!.succeeded
           and request!.snapshots.count() > 0 {
            Types.WriteRecoveryRequest(request!);
            if request!.succeeded and request!.cancelled == false {
                RememberCommittedRecoveryContent(request!);
            } else {
                allWritten = false;
            }
        }
        if request != null and request!.error != "" {
            lastAsyncError = request!.error;
        }
        if PruneStaleSwaps(docMgr) == false { allWritten = false; }
        return allWritten;
    }

    /// @brief Reconcile swaps after save, reload, close, rename, or delete.
    expose func ReconcileDocuments(docMgr: document_manager.DocumentManager,
                                   engine: editor_engine.EditorEngine) -> Boolean {
        if recoveryDir == "" or lockClaimed == false or docMgr == null {
            return false;
        }
        CancelAsync();
        var cleaned = PruneStaleSwaps(docMgr);
        var hasModified = false;
        var i = 0;
        while i < docMgr.GetCount() {
            var doc = docMgr.GetDocument(i);
            if doc != null and doc!.isModified and doc!.isReadOnlyPreview == false {
                hasModified = true;
                break;
            }
            i = i + 1;
        }
        if hasModified and QueueSwaps(docMgr, engine) == false { return false; }
        return cleaned;
    }

    hide func BuildRequest(docMgr: document_manager.DocumentManager,
                           engine: editor_engine.EditorEngine,
                           forceAll: Boolean) -> RecoveryWriteRequest {
        var request = new RecoveryWriteRequest();
        request.generation = nextGeneration;
        nextGeneration = nextGeneration + 1;
        if docMgr.activeIndex >= 0 and docMgr.activeIndex < docMgr.GetCount() {
            AppendDocumentSnapshot(
                request, docMgr, engine, docMgr.activeIndex, forceAll);
        }
        var i = 0;
        while i < docMgr.GetCount() {
            if i != docMgr.activeIndex {
                AppendDocumentSnapshot(request, docMgr, engine, i, forceAll);
            }
            i = i + 1;
        }
        return request;
    }

    /// @brief Append one eligible recovery snapshot without discarding peers on failure.
    hide func AppendDocumentSnapshot(request: RecoveryWriteRequest,
                                     docMgr: document_manager.DocumentManager,
                                     engine: editor_engine.EditorEngine,
                                     index: Integer,
                                     forceAll: Boolean) {
        if request == null or docMgr == null { return; }
        var doc = docMgr.GetDocument(index);
        if doc == null or doc!.isModified == false or doc!.isReadOnlyPreview { return; }
        var basePath = SwapBase(doc!);
        var sourceGeneration = doc!.sharedBuffer.generation;
        var sourceRevision = -1;
        var activeText = index == docMgr.activeIndex and engine != null
            and engine.currentDoc == doc
            and file_utils.IsVisualKind(doc!.kind) == false;
        if activeText {
            sourceRevision = engine.GetRevision();
        }
        if forceAll == false and activeText and sourceRevision >= 0
           and basePath != ""
           and Map.Has(lastRecoveredRevisions, basePath)
           and Map.Has(lastRecoveredGenerations, basePath)
           and Map.GetInt(lastRecoveredRevisions, basePath) == sourceRevision
           and Map.GetInt(lastRecoveredGenerations, basePath) == sourceGeneration {
            return;
        }
        var snapshot = new RecoveryWriteSnapshot();
        snapshot.basePath = basePath;
        snapshot.originPath = doc!.filePath;
        snapshot.identity = KeyFor(doc!);
        snapshot.instanceId = instanceId;
        snapshot.documentId = doc!.recoveryId;
        snapshot.sourceRevision = sourceRevision;
        snapshot.sourceGeneration = sourceGeneration;
        snapshot.content = doc!.content;
        snapshot.metadata = RecoveryMetadata(doc!);
        if index == docMgr.activeIndex and engine != null
           and file_utils.IsVisualKind(doc!.kind) == false {
            snapshot.content = engine.GetTextSnapshot();
        }
        var contentBytes = Str.get_Length(snapshot.content);
        if snapshot.basePath == "" or snapshot.metadata == "" {
            MarkRecoverySkip(request, "Could not allocate one crash-recovery identity");
            return;
        }
        if contentBytes < 0 or contentBytes > MAX_RECOVERY_SWAP_BYTES
           or Str.get_Length(snapshot.metadata) > MAX_RECOVERY_METADATA_BYTES
           or request.totalBytes + contentBytes > MAX_RECOVERY_TOTAL_BYTES
           or request.snapshots.count() >= MAX_RECOVERY_RECORDS {
            MarkRecoverySkip(request,
                             "One or more crash-recovery snapshots exceeded the bounded request budget");
            return;
        }
        if forceAll == false
           and Map.Has(lastRecoveredContents, snapshot.basePath)
           and Map.GetStr(lastRecoveredContents, snapshot.basePath) == snapshot.content {
            return;
        }
        var unique = ".recovery-" + request.generation + "-" + index;
        snapshot.tempMetadataFile = snapshot.basePath + unique + ".meta.tmp";
        snapshot.tempSwapFile = snapshot.basePath + unique + ".swp.tmp";
        request.snapshots.add(snapshot);
        request.totalBytes = request.totalBytes + contentBytes;
    }

    /// @brief Record bounded partial-recovery loss while retaining valid snapshots.
    hide func MarkRecoverySkip(request: RecoveryWriteRequest,
                               message: String) {
        if request == null { return; }
        request.truncated = true;
        if request.error == "" { request.error = message; }
    }

    /// @brief Collect every valid record under the fixed startup ceilings.
    expose func CollectRecovered() -> List {
        var job = BeginRecoveryScan(true);
        while job.active { PumpRecoveryScan(job, 64); }
        return job.records;
    }

    /// @brief Start a paged scan across claimed, legacy, and current namespaces.
    expose func BeginRecoveryScan(collectRecords: Boolean) -> RecoveryScanJob {
        var job = new RecoveryScanJob();
        job.collectRecords = collectRecords;
        var i = 0;
        while i < claimedRecoveryDirs.count() {
            AddScanDirectory(job, Obj.ToString(claimedRecoveryDirs.get(i)));
            i = i + 1;
        }
        if legacyRecoveryClaimed { AddScanDirectory(job, recoveryRoot); }
        AddScanDirectory(job, recoveryDir);
        if job.directories.count() == 0 {
            job.complete = true;
            return job;
        }
        job.active = true;
        return job;
    }

    hide func AddScanDirectory(job: RecoveryScanJob,
                               directory: String) {
        if job == null or directory == "" or Dir.Exists(directory) == false {
            return;
        }
        var i = 0;
        while i < job.directories.count() {
            if Obj.ToString(job.directories.get(i)) == directory { return; }
            i = i + 1;
        }
        job.directories.add(directory);
    }

    /// @brief Examine at most @p maxEntries entries from one scan page.
    expose func PumpRecoveryScan(job: RecoveryScanJob,
                                 maxEntries: Integer) -> Integer {
        if job == null or job.active == false { return 0; }
        if job.payloadFuture != null { return PumpPayloadRead(job); }
        var limit = maxEntries;
        if limit <= 0 { limit = 1; }
        if job.directoryIndex >= job.directories.count() {
            FinishRecoveryEnumeration(job);
            return 0;
        }
        var directory = Obj.ToString(
            job.directories.get(job.directoryIndex));
        var oldOffset = job.nextOffset;
        var page = safe_io.ListDirectoryPage(directory, job.nextOffset, limit);
        if page.ok == false {
            job.failed = true;
            job.lastPumpCount = 0;
            AdvanceScanDirectory(job);
            return 0;
        }

        var i = 0;
        while i < page.entries.count() {
            var entry = page.entries.get(i);
            var name = Map.GetStr(entry, "name");
            if Types.IsRecoveryTemporaryName(name) {
                safe_io.DeleteFile(Path.Join(directory, name));
            } else if job.collectRecords and Str.EndsWith(name, ".meta") {
                AddRecoveredMetadataRecord(job, directory, name);
            } else if job.collectRecords and Str.EndsWith(name, ".path") {
                AddRecoveredPathRecord(job, directory, name);
            }
            i = i + 1;
        }
        job.lastPumpCount = i;
        job.entriesScanned = job.entriesScanned + i;
        job.nextOffset = page.nextOffset;
        if page.done or (i == 0 and job.nextOffset == oldOffset) {
            AdvanceScanDirectory(job);
        }
        return i;
    }

    hide func AdvanceScanDirectory(job: RecoveryScanJob) {
        job.directoryIndex = job.directoryIndex + 1;
        job.nextOffset = 0;
        if job.directoryIndex >= job.directories.count() {
            FinishRecoveryEnumeration(job);
        }
    }

    /// @brief Hand validated payload candidates to one owned worker batch.
    hide func FinishRecoveryEnumeration(job: RecoveryScanJob) {
        if job == null { return; }
        if job.collectRecords == false
           or job.payloadRequest == null
           or job.payloadRequest.candidates.count() == 0 {
            job.active = false;
            job.complete = true;
            return;
        }
        try {
            job.payloadFuture = Async.RunOwned(
                &RunRecoveryPayloadRead, job.payloadRequest);
        } catch {
            job.payloadFuture = null;
        }
        if job.payloadFuture == null {
            job.failed = true;
            job.active = false;
            job.complete = true;
        }
    }

    /// @brief Publish a completed background payload batch without blocking.
    hide func PumpPayloadRead(job: RecoveryScanJob) -> Integer {
        if job == null or job.payloadFuture == null { return 0; }
        if Future.get_IsDone(job.payloadFuture) == false { return 0; }
        if Future.get_IsError(job.payloadFuture) {
            job.failed = true;
        } else if job.payloadRequest != null {
            job.records = job.payloadRequest.records;
            job.recoveredBytes = job.payloadRequest.recoveredBytes;
            if job.payloadRequest.truncated { job.truncated = true; }
            if job.payloadRequest.succeeded == false { job.failed = true; }
        }
        job.payloadFuture = null;
        job.active = false;
        job.complete = true;
        job.lastPumpCount = 0;
        return 0;
    }

    /// @brief Validate a v2 metadata/digest pair before retaining its payload.
    hide func AddRecoveredMetadataRecord(job: RecoveryScanJob,
                                         directory: String,
                                         name: String) {
        if job == null or directory == "" or name == "" { return; }
        var metadataFile = Path.Join(directory, name);
        var base = Str.MidLen(
            metadataFile, 1, Str.get_Length(metadataFile) - 5);
        var swapFile = base + ".swp";
        if File.Exists(swapFile) == false { return; }
        var metadataResult = safe_io.ReadAllTextBounded(
            metadataFile, MAX_RECOVERY_METADATA_BYTES);
        if metadataResult.ok == false
           or Json.IsValid(metadataResult.text) == false {
            return;
        }
        var metadata = Json.Parse(metadataResult.text);
        if Map.GetInt(metadata, "version") != RECOVERY_FORMAT_VERSION { return; }
        var sourceInstance = Map.GetStr(metadata, "instanceId");
        var sourceDocument = Map.GetStr(metadata, "documentId");
        var identity = Map.GetStr(metadata, "identity");
        var origin = Map.GetStr(metadata, "path");
        if Uuid.IsValid(sourceInstance) == false
           or Uuid.IsValid(sourceDocument) == false or identity == "" {
            return;
        }
        var digest = Hash.Sha256(
            sourceInstance + "\n" + sourceDocument + "\n" + identity);
        if name != "swap-" + digest + ".meta" { return; }
        var recordKey = sourceInstance + ":" + sourceDocument;
        if Map.GetBool(job.seenRecords, recordKey) { return; }
        AddPayloadCandidate(job, swapFile, origin, identity,
                            sourceInstance, sourceDocument, recordKey);
    }

    /// @brief Validate and retain one legacy `.path` / `.swp` pair.
    hide func AddRecoveredPathRecord(job: RecoveryScanJob,
                                     directory: String,
                                     name: String) {
        if job == null or directory == "" or name == "" { return; }
        if job.payloadRequest.candidates.count() >= MAX_RECOVERY_RECORDS {
            job.truncated = true;
            return;
        }
        var pathFile = Path.Join(directory, name);
        var swapFile = Str.MidLen(
            pathFile, 1, Str.get_Length(pathFile) - 5) + ".swp";
        if File.Exists(swapFile) == false { return; }
        var pathResult = safe_io.ReadAllTextBounded(
            pathFile, MAX_RECOVERY_PATH_BYTES);
        if pathResult.ok == false { return; }
        var legacyKey = "legacy:" + directory + ":" + name;
        if Map.GetBool(job.seenRecords, legacyKey) { return; }
        AddPayloadCandidate(job, swapFile, pathResult.text,
                            legacyKey, "", "", legacyKey);
    }

    /// @brief Retain validated metadata for background payload materialization.
    hide func AddPayloadCandidate(job: RecoveryScanJob,
                                  swapFile: String,
                                  origin: String,
                                  identity: String,
                                  sourceInstance: String,
                                  sourceDocument: String,
                                  recordKey: String) {
        if job == null or swapFile == "" or recordKey == "" { return; }
        if job.payloadRequest == null
           or job.payloadRequest.candidates.count() >= MAX_RECOVERY_RECORDS {
            job.truncated = true;
            return;
        }
        var candidate = new RecoveryPayloadCandidate();
        candidate.swapFile = swapFile;
        candidate.origin = origin;
        candidate.identity = identity;
        candidate.instanceId = sourceInstance;
        candidate.documentId = sourceDocument;
        job.payloadRequest.candidates.add(candidate);
        Map.SetBool(job.seenRecords, recordKey, true);
    }

    /// @brief Delete swaps from the current and explicitly claimed namespaces.
    expose func ClearAll() -> Boolean {
        if recoveryDir == "" { return false; }
        CancelAsync();
        var allRemoved = ClearRecoveryDirectory(recoveryDir);
        var i = 0;
        while i < claimedRecoveryDirs.count() {
            if ClearRecoveryDirectory(
                   Obj.ToString(claimedRecoveryDirs.get(i))) == false {
                allRemoved = false;
            }
            i = i + 1;
        }
        if legacyRecoveryClaimed
           and ClearRecoveryDirectory(recoveryRoot) == false {
            allRemoved = false;
        }
        return allRemoved;
    }

    hide func ClearRecoveryDirectory(directory: String) -> Boolean {
        if directory == "" or Dir.Exists(directory) == false { return true; }
        var result = safe_io.ListFiles(directory);
        if result.ok == false { return false; }
        var allRemoved = true;
        var i = 0;
        while i < result.items.count() {
            var name = Obj.ToString(result.items.get(i));
            if Str.EndsWith(name, ".swp") or Str.EndsWith(name, ".path")
               or Str.EndsWith(name, ".meta")
               or Types.IsRecoveryTemporaryName(name) {
                if safe_io.DeleteFile(Path.Join(directory, name)) == false {
                    allRemoved = false;
                }
            }
            i = i + 1;
        }
        return allRemoved;
    }

    /// @brief Durably mark clean ownership before releasing any lease.
    expose func MarkCleanExit() -> Boolean {
        if recoveryDir == "" or WaitForShutdown() == false { return false; }
        if ClearAll() == false { return false; }
        if WriteCleanMarker(recoveryDir) == false { return false; }
        var markerIndex = 0;
        while markerIndex < claimedRecoveryDirs.count() {
            if WriteCleanMarker(Obj.ToString(
                   claimedRecoveryDirs.get(markerIndex))) == false {
                return false;
            }
            markerIndex = markerIndex + 1;
        }

        var ownedDir = recoveryDir;
        var ownedId = instanceId;
        FileLease.Release(sessionLease);
        sessionLease = null;
        RetireRecoveryNamespace(ownedDir, ownedId);
        var i = 0;
        while i < claimedRecoveryDirs.count() {
            var claimedDir = Obj.ToString(claimedRecoveryDirs.get(i));
            FileLease.Release(claimedRecoveryLeases.get(i));
            RetireRecoveryNamespace(
                claimedDir, NamespaceIdFromDirectory(claimedDir));
            i = i + 1;
        }
        if legacyRecoveryClaimed
           and safe_io.DeleteFile(
                  Path.Join(recoveryRoot, "session.lock")) == false {
            return false;
        }
        claimedRecoveryDirs = new List();
        claimedRecoveryLeases = new List();
        lockClaimed = false;
        return true;
    }

    /// @brief Release only this instance lease while retaining all swap data.
    expose func ReleaseOwnershipWithoutCleanup() {
        CancelAsync();
        if sessionLease != null {
            FileLease.Release(sessionLease);
            sessionLease = null;
        }
        lockClaimed = false;
    }
}
