//
// File: zannastudio/src/core/project_manager.zia
// Purpose: Stable public facade for workspace, Explorer, cache, and mutation services.
// Key invariants:
//   - Public names and constructor behavior remain compatible with existing callers.
// Ownership/Lifetime:
//   - ProjectManager inherits implementation state and behavior from focused layers.
// Links: zannastudio/src/core/project_manager_base.zia, zannastudio/src/core/project_manager_mutations.zia
//
//===----------------------------------------------------------------------===//

module project_manager;

bind "project_tree_sort" as TreeSort;
bind "project_manager_mutations" as Implementation;

/// @brief Compare Explorer names using deterministic natural ordering.
expose func NaturalNameCompare(left: String, right: String) -> Integer {
    return TreeSort.NaturalNameCompare(left, right);
}

/// @brief Return a naturally sorted copy of Explorer names.
expose func NaturalSortNames(items: List) -> List {
    return TreeSort.NaturalSortNames(items);
}

/// @brief Public workspace and Explorer controller.
class ProjectManager extends Implementation.ProjectManagerMutationLayer {
    expose func init() {
        InitializeState();
    }
}
