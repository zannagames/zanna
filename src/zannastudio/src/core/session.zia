//
// File: zannastudio/src/core/session.zia
// Purpose: Stable public facade for Studio session persistence and restoration.
// Key invariants:
//   - Public types, constants, and SessionManager construction remain source-compatible.
// Ownership/Lifetime:
//   - SessionManager initializes inherited state and borrows live IDE models.
// Links: zannastudio/src/core/session_state.zia, zannastudio/src/core/session_manager.zia
//
//===----------------------------------------------------------------------===//

module session;

bind "session_state" as State;
bind "session_manager" as Implementation;

final MAX_RECENT_PROJECTS = State.MAX_RECENT_PROJECTS;
final MAX_RECENT_FILES = State.MAX_RECENT_FILES;
final MAX_SESSION_WORKSPACE_ROOTS = State.MAX_SESSION_WORKSPACE_ROOTS;
final MAX_SESSION_FILES = State.MAX_SESSION_FILES;
final MAX_SESSION_RECOVERY_CHARS = State.MAX_SESSION_RECOVERY_CHARS;
final MAX_SESSION_RECOVERY_ENCODED_CHARS = State.MAX_SESSION_RECOVERY_ENCODED_CHARS;
final MAX_SESSION_RECOVERY_TOTAL_CHARS = State.MAX_SESSION_RECOVERY_TOTAL_CHARS;
final MAX_SESSION_STALE_SECTIONS = State.MAX_SESSION_STALE_SECTIONS;
final SCENE_WORKSPACE_STATE_VERSION = State.SCENE_WORKSPACE_STATE_VERSION;
final MAX_SCENE_WORKSPACE_SCROLL = State.MAX_SCENE_WORKSPACE_SCROLL;
final MAX_SCENE_WORKSPACE_TARGET_MILLIS = State.MAX_SCENE_WORKSPACE_TARGET_MILLIS;

type SessionRestoreJob = State.SessionRestoreJob;
type SessionSaveState = State.SessionSaveState;

class SessionManager extends Implementation.SessionManagerImplementation {
    expose func init() {
        InitializeState();
    }
}
