RT_FUNC(ServicesSteamHardwareNone,         rt_services_steam_hardware_none,            "Zanna.Services.SteamHardware.get_None",         "i64()")
RT_FUNC(ServicesSteamHardwareSteamDeck,    rt_services_steam_hardware_steam_deck,      "Zanna.Services.SteamHardware.get_SteamDeck",    "i64()")
RT_FUNC(ServicesSteamHardwareSteamMachine, rt_services_steam_hardware_steam_machine,   "Zanna.Services.SteamHardware.get_SteamMachine", "i64()")
RT_FUNC(ServicesSteamHardwareSteamFrame,   rt_services_steam_hardware_steam_frame,     "Zanna.Services.SteamHardware.get_SteamFrame",   "i64()")

//=============================================================================
// SERVICES - CLASSES
//=============================================================================

/// @summary Starts a distribution platform's services and reads identity, licensing, and events.
/// @details
/// `Zanna.Services.Platform` is the provider-neutral entry point to store platforms such as Steam.
/// Call `Init(provider, appId)` once at startup, before creating any window; it returns a
/// `Zanna.Result` holding the provider id or an error message, and `Status` holds a
/// `Zanna.Services.Status` code. While a provider is started, `Canvas.Poll` and `Canvas3D.Poll`
/// pump it every frame (call `Update` in loops without a canvas). Drain events with `PollEvent`,
/// which returns a `Zanna.Services.EventKind` and exposes the payload through `EventResultCode`,
/// `EventText`, `EventValue`, `EventTotal`, and `EventFlag`.
///
/// When no provider is started (no Steam client, no redistributable, or a non-Steam build) every
/// query returns an empty string, `0`, or `false` and never traps, so one build runs everywhere.
/// Stateful members must be called on the main thread. Call `Shutdown` on the quit path.
/// `LaunchCommandLine` and `LaunchParameter(key)` read what the platform passed through a launch
/// URL (for example a friend joining through rich presence); read them again after
/// `EventKind.LaunchParametersChanged`. `DlcCount` with `DlcIdAt`, `DlcNameAt`, and
/// `DlcAvailableAt` lists the application's DLC, and `BuildId` and `BranchName` identify the
/// installed build. The player features live in `Achievements`, `Stats`, `Leaderboards`,
/// `Presence`, `Overlay`, `OnScreenKeyboard`, `Cloud`, and `Timeline`.
RT_CLASS_BEGIN("Zanna.Services.Platform", ServicesPlatform, "none", none)
    RT_PROP("IsAvailable", "i1", ServicesPlatformIsAvailable, none)
    RT_PROP("Status", "i64", ServicesPlatformStatus, none)
    RT_PROP("Provider", "str", ServicesPlatformProvider, none)
    RT_PROP("AppId", "str", ServicesPlatformAppId, none)
    RT_PROP("UserId", "str", ServicesPlatformUserId, none)
    RT_PROP("UserName", "str", ServicesPlatformUserName, none)
    RT_PROP("Language", "str", ServicesPlatformLanguage, none)
    RT_PROP("IsLicensed", "i1", ServicesPlatformIsLicensed, none)
    RT_PROP("IsOnline", "i1", ServicesPlatformIsOnline, none)
    RT_PROP("LaunchCommandLine", "str", ServicesPlatformLaunchCommandLine, none)
    RT_PROP("DlcCount", "i64", ServicesPlatformDlcCount, none)
    RT_PROP("BuildId", "i64", ServicesPlatformBuildId, none)
    RT_PROP("BranchName", "str", ServicesPlatformBranchName, none)
    RT_PROP("EventResultCode", "i64", ServicesPlatformEventResultCode, none)
    RT_PROP("EventText", "str", ServicesPlatformEventText, none)
    RT_PROP("EventValue", "i64", ServicesPlatformEventValue, none)
    RT_PROP("EventTotal", "i64", ServicesPlatformEventTotal, none)
    RT_PROP("EventFlag", "i1", ServicesPlatformEventFlag, none)
    RT_PROP("DroppedEvents", "i64", ServicesPlatformDroppedEvents, none)
    RT_METHOD("Init", "obj<Zanna.Result>(str,str)", ServicesPlatformInit)
    RT_METHOD("Update", "void()", ServicesPlatformUpdate)
    RT_METHOD("Shutdown", "void()", ServicesPlatformShutdown)
    RT_METHOD("PollEvent", "i64()", ServicesPlatformPollEvent)
    RT_METHOD("HasProvider", "i1(str)", ServicesPlatformHasProvider)
    RT_METHOD("HasFeature", "i1(i64)", ServicesPlatformHasFeature)
    RT_METHOD("IsDlcInstalled", "i1(str)", ServicesPlatformIsDlcInstalled)
    RT_METHOD("RequestPlayerCount", "obj<Zanna.Services.Request>()", ServicesPlatformRequestPlayerCount)
    RT_METHOD("Diagnostics", "seq<str>()", ServicesPlatformDiagnostics)
    RT_METHOD("LaunchParameter", "str(str)", ServicesPlatformLaunchParameter)
    RT_METHOD("DlcIdAt", "str(i64)", ServicesPlatformDlcIdAt)
    RT_METHOD("DlcNameAt", "str(i64)", ServicesPlatformDlcNameAt)
    RT_METHOD("DlcAvailableAt", "i1(i64)", ServicesPlatformDlcAvailableAt)
RT_CLASS_END()

/// @summary Tracks one non-blocking platform services request.
/// @details
/// `Zanna.Services.Request` objects are returned by request methods such as
/// `Platform.RequestPlayerCount`, `Leaderboards.Download`, and `OnScreenKeyboard.RequestText`.
/// A request completes during a later provider pump; poll `IsDone` across frames rather than
/// waiting.
/// `Succeeded`, `ResultCode`, `Value`, `Flag`, and `Text` describe the result (their meaning
/// depends on `Kind`), and `Error` holds the failure message. Leaderboard downloads also carry
/// entries: `EntryCount`, then `EntryRank(i)`, `EntryScore(i)`, `EntryUserId(i)`, and
/// `EntryUserName(i)` for `i` in `0..EntryCount-1` (other indexes trap). Some kinds also carry
/// integer details read with `Detail(i)` for `i` in `0..DetailCount-1`. Workshop queries carry
/// `ItemCount` items read with `ItemAt(i)` as `Zanna.Services.WorkshopItem` objects. Requests that
/// cannot start are returned already completed as failed, and `Platform.Shutdown` cancels
/// outstanding requests.
RT_CLASS_BEGIN("Zanna.Services.Request", ServicesRequest, "obj", none)
    RT_PROP("Kind", "i64", ServicesRequestKind, none)
    RT_PROP("IsDone", "i1", ServicesRequestIsDone, none)
    RT_PROP("Succeeded", "i1", ServicesRequestSucceeded, none)
    RT_PROP("ResultCode", "i64", ServicesRequestResultCode, none)
    RT_PROP("Value", "i64", ServicesRequestValue, none)
    RT_PROP("Flag", "i1", ServicesRequestFlag, none)
    RT_PROP("Text", "str", ServicesRequestText, none)
    RT_PROP("Error", "str", ServicesRequestError, none)
    RT_PROP("EntryCount", "i64", ServicesRequestEntryCount, none)
    RT_PROP("DetailCount", "i64", ServicesRequestDetailCount, none)
    RT_PROP("ItemCount", "i64", ServicesRequestItemCount, none)
    RT_METHOD("EntryRank", "i64(i64)", ServicesRequestEntryRank)
    RT_METHOD("EntryScore", "i64(i64)", ServicesRequestEntryScore)
    RT_METHOD("EntryUserId", "str(i64)", ServicesRequestEntryUserId)
    RT_METHOD("EntryUserName", "str(i64)", ServicesRequestEntryUserName)
    RT_METHOD("Detail", "i64(i64)", ServicesRequestDetail)
    RT_METHOD("ItemAt", "obj<Zanna.Services.WorkshopItem>(i64)", ServicesRequestItemAt)
RT_CLASS_END()

/// @summary Unlocks and inspects the game's platform achievements.
/// @details
/// `Zanna.Services.Achievements` addresses achievements by the API id defined with the platform
/// (for Steam, in the Steamworks app admin). `Unlock` changes the achievement locally; call
/// `Stats.Store` soon afterwards to commit it and show the unlock notification.
/// `IndicateProgress(id, current, maximum)` shows a progress notification without unlocking.
/// `IsUnlocked`, `UnlockTime` (Unix seconds), `DisplayName`, `Description`, and `IsHidden` read the
/// achievement, and `Count` with `IdAt(index)` enumerates them. `Clear` relocks an achievement for
/// testing.
///
/// `IconWidth`, `IconHeight`, and `IconRgba` read the icon for the achievement's current state
/// (locked or unlocked) as `IconWidth * IconHeight * 4` RGBA bytes, ready for `Pixels` or a
/// texture. Platforms load icons on demand: while an icon loads these return `0` and empty
/// `Bytes`, and an `EventKind.AchievementIconReady` event names the achievement once it is ready.
/// `RequestGlobalPercentages` downloads the share of players who unlocked each achievement;
/// after the request succeeds `GlobalPercent(id)` returns it in the range 0 to 100.
///
/// Without a provider that supports achievements every member returns `false`, `0`, `""`, or
/// empty `Bytes`. An empty id traps. A rejected call returns `false` and `Platform.Diagnostics`
/// explains why.
RT_CLASS_BEGIN("Zanna.Services.Achievements", ServicesAchievements, "none", none)
    RT_PROP("Count", "i64", ServicesAchievementsCount, none)
    RT_METHOD("Unlock", "i1(str)", ServicesAchievementsUnlock)
    RT_METHOD("Clear", "i1(str)", ServicesAchievementsClear)
    RT_METHOD("IsUnlocked", "i1(str)", ServicesAchievementsIsUnlocked)
    RT_METHOD("UnlockTime", "i64(str)", ServicesAchievementsUnlockTime)
    RT_METHOD("IndicateProgress", "i1(str,i64,i64)", ServicesAchievementsIndicateProgress)
    RT_METHOD("IdAt", "str(i64)", ServicesAchievementsIdAt)
    RT_METHOD("DisplayName", "str(str)", ServicesAchievementsDisplayName)
    RT_METHOD("Description", "str(str)", ServicesAchievementsDescription)
    RT_METHOD("IsHidden", "i1(str)", ServicesAchievementsIsHidden)
    RT_METHOD("IconWidth", "i64(str)", ServicesAchievementsIconWidth)
    RT_METHOD("IconHeight", "i64(str)", ServicesAchievementsIconHeight)
    RT_METHOD("IconRgba", "obj<Zanna.Collections.Bytes>(str)", ServicesAchievementsIconRgba)
    RT_METHOD("RequestGlobalPercentages", "obj<Zanna.Services.Request>()", ServicesAchievementsRequestGlobalPercentages)
    RT_METHOD("GlobalPercent", "f64(str)", ServicesAchievementsGlobalPercent)
RT_CLASS_END()

/// @summary Reads, updates, and commits the player's platform stats.
/// @details
/// `Zanna.Services.Stats` addresses stats by the API name defined with the platform. `GetInt` and
/// `SetInt` work on integer stats, `GetFloat` and `SetFloat` on floating-point stats, and
/// `UpdateAverageRate(name, count, seconds)` adds a session to an average-rate stat. Changes are
/// local until `Store` commits them together with achievement unlocks; the result arrives as
/// `EventKind.StatsStored`. Platforms rate-limit commits, so store at natural break points such as
/// the end of a game rather than every frame. `ResetAll` clears stats (and optionally
/// achievements) for testing.
///
/// Without a provider that supports stats every member returns `false` or `0`. An empty name traps;
/// values a provider cannot store (Steam: outside int32 or float32, or non-finite) return `false`
/// with a diagnostic.
RT_CLASS_BEGIN("Zanna.Services.Stats", ServicesStats, "none", none)
    RT_METHOD("GetInt", "i64(str)", ServicesStatsGetInt)
    RT_METHOD("SetInt", "i1(str,i64)", ServicesStatsSetInt)
    RT_METHOD("GetFloat", "f64(str)", ServicesStatsGetFloat)
    RT_METHOD("SetFloat", "i1(str,f64)", ServicesStatsSetFloat)
    RT_METHOD("UpdateAverageRate", "i1(str,f64,f64)", ServicesStatsUpdateAverageRate)
    RT_METHOD("Store", "i1()", ServicesStatsStore)
    RT_METHOD("ResetAll", "i1(i1)", ServicesStatsResetAll)
RT_CLASS_END()

/// @summary Finds leaderboards, uploads scores, and downloads ranked entries by board name.
/// @details
/// `Zanna.Services.Leaderboards` starts non-blocking `Zanna.Services.Request` operations addressed
/// by leaderboard name. `Find(name)` checks that a board exists (`Value` holds its entry count) and
/// `FindOrCreate(name, sort, display)` creates a missing board with `LeaderboardSort` and
/// `LeaderboardDisplay` values. `Upload(name, score, keepBest)` stores the player's score; `Value`
/// holds the new global rank and `Flag` whether the stored score changed.
/// `Download(name, scope, start, end)` fetches up to 100 entries with a `LeaderboardScope`:
/// `Global` ranks `start..end` (from 1), `AroundUser` offsets such as `-4..5`, or `Friends`
/// (range ignored); read them with `Request.EntryRank`, `EntryScore`, `EntryUserId`, and
/// `EntryUserName`, and `Value` holds the board's total entry count.
///
/// An empty name, an unknown constant, or an impossible download range traps. Without a provider
/// that supports leaderboards the request completes as failed.
RT_CLASS_BEGIN("Zanna.Services.Leaderboards", ServicesLeaderboards, "none", none)
    RT_METHOD("Find", "obj<Zanna.Services.Request>(str)", ServicesLeaderboardsFind)
    RT_METHOD("FindOrCreate", "obj<Zanna.Services.Request>(str,i64,i64)", ServicesLeaderboardsFindOrCreate)
    RT_METHOD("Upload", "obj<Zanna.Services.Request>(str,i64,i1)", ServicesLeaderboardsUpload)
    RT_METHOD("Download", "obj<Zanna.Services.Request>(str,i64,i64,i64)", ServicesLeaderboardsDownload)
RT_CLASS_END()

/// @summary Publishes what the player is doing to their friends.
/// @details
/// `Zanna.Services.Presence` sets rich presence key/value pairs for the signed-in user.
/// `Set(key, value)` publishes one pair and an empty value removes the key; `Clear` removes every
/// key. Keys and their meaning are provider-defined: on Steam, `status` is plain text shown in some
/// views and `steam_display` names a localization token configured for the app. Without a provider
/// that supports presence both members do nothing and `Set` returns `false`; an empty key traps.
RT_CLASS_BEGIN("Zanna.Services.Presence", ServicesPresence, "none", none)
    RT_METHOD("Set", "i1(str,str)", ServicesPresenceSet)
    RT_METHOD("Clear", "void()", ServicesPresenceClear)
RT_CLASS_END()

/// @summary Opens the platform's in-game overlay and positions its notifications.
/// @details
/// `Zanna.Services.Overlay` controls the platform overlay drawn over the game. `IsEnabled` reports
/// whether it is attached right now (it can take a few seconds after startup). `Open(page)` shows an
/// `OverlayPage`, `OpenWebPage(url, modal)` opens the overlay browser, and
/// `OpenStore(productId, addToCart)` opens a store page (on Steam the product id is a decimal app
/// id, and a malformed one traps). `SetNotificationPosition` and `SetNotificationInset` move
/// notifications such as achievement unlocks away from the game's HUD.
///
/// The desktop overlay needs GPU presentation (`Canvas3D` or `World3D`). Members return `true` when
/// the request reached the platform and `false` without a provider that supports the overlay.
RT_CLASS_BEGIN("Zanna.Services.Overlay", ServicesOverlay, "none", none)
    RT_PROP("IsEnabled", "i1", ServicesOverlayIsEnabled, none)
    RT_METHOD("Open", "i1(i64)", ServicesOverlayOpen)
    RT_METHOD("OpenWebPage", "i1(str,i1)", ServicesOverlayOpenWebPage)
    RT_METHOD("OpenStore", "i1(str,i1)", ServicesOverlayOpenStore)
    RT_METHOD("SetNotificationPosition", "i1(i64)", ServicesOverlaySetNotificationPosition)
    RT_METHOD("SetNotificationInset", "i1(i64,i64)", ServicesOverlaySetNotificationInset)
RT_CLASS_END()

/// @summary Shows platform on-screen keyboards for controller-only devices.
/// @details
/// `Zanna.Services.OnScreenKeyboard` brings up text entry on devices without a keyboard, such as
/// Steam Deck. `ShowFloating(mode, x, y, width, height)` opens a floating keyboard beside the
/// game's own text field (given in window pixels) whose keys arrive as ordinary keyboard input;
/// `EventKind.TextInputDismissed` reports when it closes and `DismissFloating` closes it early.
/// `RequestText(prompt, initialText, maxLength, mode)` opens full-screen text entry and returns a
/// `Zanna.Services.Request` that completes with the submitted text in `Text` (cancelling fails the
/// request). Modes are `TextInputMode` values.
///
/// On a desktop without a controller-oriented shell the keyboards are unavailable: `ShowFloating`
/// returns `false` and `RequestText` fails. Unknown modes and a `maxLength` outside `1..4096` trap.
RT_CLASS_BEGIN("Zanna.Services.OnScreenKeyboard", ServicesOnScreenKeyboard, "none", none)
    RT_METHOD("ShowFloating", "i1(i64,i64,i64,i64,i64)", ServicesOnScreenKeyboardShowFloating)
    RT_METHOD("DismissFloating", "i1()", ServicesOnScreenKeyboardDismissFloating)
    RT_METHOD("RequestText", "obj<Zanna.Services.Request>(str,str,i64,i64)", ServicesOnScreenKeyboardRequestText)
RT_CLASS_END()

/// @summary Stores per-user files that the platform synchronizes across devices.
/// @details
/// `Zanna.Services.Cloud` reads and writes whole files in the platform's cloud storage for the
/// signed-in user. `Write(name, bytes)` creates or replaces a file, `Read(name)` returns a
/// `Zanna.Result` holding `Bytes` or an error message, and `Exists`, `Delete`, `Size`,
/// `Timestamp`, and `Files` manage what is stored. `IsEnabled` is `true` only when both the user and
/// the app have cloud storage enabled, and `QuotaTotal` and `QuotaAvailable` report space in bytes.
/// Wrap the writes and deletes of one save in `BeginBatch` and `EndBatch` so the platform never
/// synchronizes half of it. Operations work against the platform's local copy; it uploads on its
/// own schedule.
///
/// Games whose saves already live under `Zanna.IO.Path.DataDir` can instead use platform
/// synchronization configured outside the game (Steam Auto-Cloud). An empty file name traps.
RT_CLASS_BEGIN("Zanna.Services.Cloud", ServicesCloud, "none", none)
    RT_PROP("IsEnabled", "i1", ServicesCloudIsEnabled, none)
    RT_PROP("QuotaTotal", "i64", ServicesCloudQuotaTotal, none)
    RT_PROP("QuotaAvailable", "i64", ServicesCloudQuotaAvailable, none)
    RT_METHOD("Write", "i1(str,obj<Zanna.Collections.Bytes>)", ServicesCloudWrite)
    RT_METHOD("Read", "obj<Zanna.Result>(str)", ServicesCloudRead)
    RT_METHOD("Exists", "i1(str)", ServicesCloudExists)
    RT_METHOD("Delete", "i1(str)", ServicesCloudDelete)
    RT_METHOD("Size", "i64(str)", ServicesCloudSize)
    RT_METHOD("Timestamp", "i64(str)", ServicesCloudTimestamp)
    RT_METHOD("Files", "seq<str>()", ServicesCloudFiles)
    RT_METHOD("BeginBatch", "i1()", ServicesCloudBeginBatch)
    RT_METHOD("EndBatch", "i1()", ServicesCloudEndBatch)
RT_CLASS_END()

/// @summary Marks the platform's game recording timeline with events, state, and phases.
/// @details
/// `Zanna.Services.Timeline` annotates background gameplay recording (Steam game recording) so
/// players can find and clip moments later. `SetGameMode` colors the timeline bar with a
/// `TimelineMode`, and `SetTooltip(text, offsetSeconds)` describes the current state, such as the
/// score. `AddEvent(title, description, icon, priority, offsetSeconds, clip)` marks a moment and
/// `AddRangeEvent` a finished span; `StartRangeEvent`, `UpdateRangeEvent`, and `EndRangeEvent`
/// follow a span as it happens, and `RemoveEvent` deletes one. Event methods return an event id
/// (`""` when nothing was added). Offsets are seconds relative to now (negative is the past),
/// priorities range over `0..1000`, and `clip` is a `TimelineClip` value.
///
/// Phases group a longer stretch such as a match: `StartPhase`, `EndPhase`, `SetPhaseId`,
/// `AddPhaseTag`, and `SetPhaseAttribute`. `RequestEventRecording` and `RequestPhaseRecording`
/// return a `Zanna.Services.Request` that reports what was recorded, and `OpenOverlayToPhase` and
/// `OpenOverlayToEvent` show it in the overlay. Empty titles, ids, tag names, or groups, unknown
/// constants, and out-of-range priorities trap. Without a provider that supports the timeline,
/// members return `false` or `""`.
RT_CLASS_BEGIN("Zanna.Services.Timeline", ServicesTimeline, "none", none)
    RT_METHOD("SetGameMode", "i1(i64)", ServicesTimelineSetGameMode)
    RT_METHOD("SetTooltip", "i1(str,f64)", ServicesTimelineSetTooltip)
    RT_METHOD("ClearTooltip", "i1(f64)", ServicesTimelineClearTooltip)
    RT_METHOD("AddEvent", "str(str,str,str,i64,f64,i64)", ServicesTimelineAddEvent)
    RT_METHOD("AddRangeEvent", "str(str,str,str,i64,f64,f64,i64)", ServicesTimelineAddRangeEvent)
    RT_METHOD("StartRangeEvent", "str(str,str,str,i64,f64,i64)", ServicesTimelineStartRangeEvent)
    RT_METHOD("UpdateRangeEvent", "i1(str,str,str,str,i64,i64)", ServicesTimelineUpdateRangeEvent)
    RT_METHOD("EndRangeEvent", "i1(str,f64)", ServicesTimelineEndRangeEvent)
    RT_METHOD("RemoveEvent", "i1(str)", ServicesTimelineRemoveEvent)
    RT_METHOD("RequestEventRecording", "obj<Zanna.Services.Request>(str)", ServicesTimelineRequestEventRecording)
    RT_METHOD("StartPhase", "i1()", ServicesTimelineStartPhase)
    RT_METHOD("EndPhase", "i1()", ServicesTimelineEndPhase)
    RT_METHOD("SetPhaseId", "i1(str)", ServicesTimelineSetPhaseId)
    RT_METHOD("AddPhaseTag", "i1(str,str,str,i64)", ServicesTimelineAddPhaseTag)
    RT_METHOD("SetPhaseAttribute", "i1(str,str,i64)", ServicesTimelineSetPhaseAttribute)
    RT_METHOD("RequestPhaseRecording", "obj<Zanna.Services.Request>(str)", ServicesTimelineRequestPhaseRecording)
    RT_METHOD("OpenOverlayToPhase", "i1(str)", ServicesTimelineOpenOverlayToPhase)
    RT_METHOD("OpenOverlayToEvent", "i1(str)", ServicesTimelineOpenOverlayToEvent)
RT_CLASS_END()

/// @summary Reads the platform's action-based controller input.
/// @details
/// `Zanna.Services.ActionInput` reads controllers through the platform's action system (Steam
/// Input). The game names what the player does in an action manifest, such as `swing` or `aim`,
/// and the player binds those actions to any controller in the platform's own interface.
/// `Start(manifestPath)` begins, with the manifest file or `""` for the configuration published
/// with the platform, and `Stop` ends. `ControllerCount`, `ControllerIdAt`, `ControllerType`,
/// and `GamepadIndex` describe the connected controllers, and the pump keeps them current.
///
/// `ActivateActionSet` selects a group of actions, and `ActivateLayer`, `DeactivateLayer`, and
/// `DeactivateAllLayers` stack layers on top of it. `IsPressed` reads a digital action,
/// `AnalogX` and `AnalogY` an analog one, and `IsActionActive` whether an action is available in
/// the active set. `ActionLabel` returns the action's localized name. `OriginCount` and
/// `OriginAt` list the physical inputs bound to an action, and `OriginLabel` and
/// `OriginGlyphPath` describe one for button prompts. `Vibrate`, `SetLedColor`, and
/// `ResetLedColor` drive feedback, and `ShowBindingPanel` opens the platform's binding screen.
///
/// An empty controller id means every connected controller: activation also reaches controllers
/// connected later, `IsPressed` and `IsActionActive` ask whether any controller qualifies,
/// `AnalogX` and `AnalogY` read the controller whose vector is longest, feedback reaches every
/// controller, and the other members use the first controller. Empty action, set, and layer
/// names, negative origins, unknown `GlyphSize` values, strengths outside 0..1, and color
/// components outside 0..255 trap. Before `Start`, or without a provider that supports action
/// input, members return `false`, `0`, `-1`, or `""`.
RT_CLASS_BEGIN("Zanna.Services.ActionInput", ServicesActionInput, "none", none)
    RT_PROP("IsStarted", "i1", ServicesActionInputIsStarted, none)
    RT_PROP("ControllerCount", "i64", ServicesActionInputControllerCount, none)
    RT_METHOD("Start", "i1(str)", ServicesActionInputStart)
    RT_METHOD("Stop", "i1()", ServicesActionInputStop)
    RT_METHOD("ControllerIdAt", "str(i64)", ServicesActionInputControllerIdAt)
    RT_METHOD("ControllerType", "i64(str)", ServicesActionInputControllerType)
    RT_METHOD("GamepadIndex", "i64(str)", ServicesActionInputGamepadIndex)
    RT_METHOD("ActivateActionSet", "i1(str,str)", ServicesActionInputActivateActionSet)
    RT_METHOD("ActivateLayer", "i1(str,str)", ServicesActionInputActivateLayer)
    RT_METHOD("DeactivateLayer", "i1(str,str)", ServicesActionInputDeactivateLayer)
    RT_METHOD("DeactivateAllLayers", "i1(str)", ServicesActionInputDeactivateAllLayers)
    RT_METHOD("IsPressed", "i1(str,str)", ServicesActionInputIsPressed)
    RT_METHOD("AnalogX", "f64(str,str)", ServicesActionInputAnalogX)
    RT_METHOD("AnalogY", "f64(str,str)", ServicesActionInputAnalogY)
    RT_METHOD("IsActionActive", "i1(str,str)", ServicesActionInputIsActionActive)
    RT_METHOD("ActionLabel", "str(str)", ServicesActionInputActionLabel)
    RT_METHOD("OriginCount", "i64(str,str,str)", ServicesActionInputOriginCount)
    RT_METHOD("OriginAt", "i64(str,str,str,i64)", ServicesActionInputOriginAt)
    RT_METHOD("OriginLabel", "str(i64)", ServicesActionInputOriginLabel)
    RT_METHOD("OriginGlyphPath", "str(i64,i64)", ServicesActionInputOriginGlyphPath)
    RT_METHOD("Vibrate", "i1(str,f64,f64)", ServicesActionInputVibrate)
    RT_METHOD("SetLedColor", "i1(str,i64,i64,i64)", ServicesActionInputSetLedColor)
    RT_METHOD("ResetLedColor", "i1(str)", ServicesActionInputResetLedColor)
    RT_METHOD("ShowBindingPanel", "i1(str)", ServicesActionInputShowBindingPanel)
RT_CLASS_END()

/// @summary Lists, installs, browses, and publishes the game's Workshop items.
/// @details
/// `Zanna.Services.Workshop` reads the platform's user-generated content service (Steam
/// Workshop). Items are addressed by provider-defined ids. `SubscribedCount` and
/// `SubscribedIdAt` list the items the player subscribed to; `IsSubscribed`, `IsInstalled`,
/// `NeedsUpdate`, and `IsDownloading` report an item's state, `InstallFolder`, `InstallSize`,
/// and `InstallTime` where its files are, and `DownloadedBytes` and `DownloadTotalBytes` a
/// download's progress. `Download` fetches or updates an item, and `Subscribe` and
/// `Unsubscribe` change the player's subscriptions.
///
/// `Query(order, page, requiredTags, searchText)`, `QueryUser(list, page)`, and
/// `QueryItems(itemIds)` return a `Zanna.Services.Request` whose `ItemAt(i)` items describe one
/// page (`Value` holds the number of matching items). `CreateItem` creates an item owned by the
/// player; `StartUpdate` returns an update id that `SetTitle`, `SetDescription`, `SetMetadata`,
/// `SetTags`, `SetVisibility`, `SetContent`, and `SetPreview` fill in before `SubmitUpdate`
/// sends it, with `UpdateStatus` and `UpdateProgress` following the upload. `DeleteItem`
/// removes an item. Lists of tags and ids are comma-separated.
///
/// Empty ids, unknown constants, pages below 1, and more than 100 query ids trap. Without a
/// provider that supports the Workshop, members return `false`, `0`, or `""` and requests fail.
RT_CLASS_BEGIN("Zanna.Services.Workshop", ServicesWorkshop, "none", none)
    RT_PROP("SubscribedCount", "i64", ServicesWorkshopSubscribedCount, none)
    RT_METHOD("SubscribedIdAt", "str(i64)", ServicesWorkshopSubscribedIdAt)
    RT_METHOD("IsSubscribed", "i1(str)", ServicesWorkshopIsSubscribed)
    RT_METHOD("IsInstalled", "i1(str)", ServicesWorkshopIsInstalled)
    RT_METHOD("NeedsUpdate", "i1(str)", ServicesWorkshopNeedsUpdate)
    RT_METHOD("IsDownloading", "i1(str)", ServicesWorkshopIsDownloading)
    RT_METHOD("InstallFolder", "str(str)", ServicesWorkshopInstallFolder)
    RT_METHOD("InstallSize", "i64(str)", ServicesWorkshopInstallSize)
    RT_METHOD("InstallTime", "i64(str)", ServicesWorkshopInstallTime)
    RT_METHOD("DownloadedBytes", "i64(str)", ServicesWorkshopDownloadedBytes)
    RT_METHOD("DownloadTotalBytes", "i64(str)", ServicesWorkshopDownloadTotalBytes)
    RT_METHOD("Download", "i1(str,i1)", ServicesWorkshopDownload)
    RT_METHOD("Subscribe", "obj<Zanna.Services.Request>(str)", ServicesWorkshopSubscribe)
    RT_METHOD("Unsubscribe", "obj<Zanna.Services.Request>(str)", ServicesWorkshopUnsubscribe)
    RT_METHOD("Query", "obj<Zanna.Services.Request>(i64,i64,str,str)", ServicesWorkshopQuery)
    RT_METHOD("QueryUser", "obj<Zanna.Services.Request>(i64,i64)", ServicesWorkshopQueryUser)
    RT_METHOD("QueryItems", "obj<Zanna.Services.Request>(str)", ServicesWorkshopQueryItems)
    RT_METHOD("CreateItem", "obj<Zanna.Services.Request>()", ServicesWorkshopCreateItem)
    RT_METHOD("StartUpdate", "str(str)", ServicesWorkshopStartUpdate)
    RT_METHOD("SetTitle", "i1(str,str)", ServicesWorkshopSetTitle)
    RT_METHOD("SetDescription", "i1(str,str)", ServicesWorkshopSetDescription)
    RT_METHOD("SetMetadata", "i1(str,str)", ServicesWorkshopSetMetadata)
    RT_METHOD("SetTags", "i1(str,str)", ServicesWorkshopSetTags)
    RT_METHOD("SetVisibility", "i1(str,i64)", ServicesWorkshopSetVisibility)
    RT_METHOD("SetContent", "i1(str,str)", ServicesWorkshopSetContent)
    RT_METHOD("SetPreview", "i1(str,str)", ServicesWorkshopSetPreview)
    RT_METHOD("SubmitUpdate", "obj<Zanna.Services.Request>(str,str)", ServicesWorkshopSubmitUpdate)
    RT_METHOD("UpdateStatus", "i64(str)", ServicesWorkshopUpdateStatus)
    RT_METHOD("UpdateProgress", "f64(str)", ServicesWorkshopUpdateProgress)
    RT_METHOD("DeleteItem", "obj<Zanna.Services.Request>(str)", ServicesWorkshopDeleteItem)
RT_CLASS_END()

/// @summary Describes one Workshop item returned by a query.
/// @details
/// `Zanna.Services.WorkshopItem` objects come from `Request.ItemAt` on a completed Workshop query
/// and keep their values after the request is released. `Id`, `Title`, `Description`, `OwnerId`
/// (the author's user id), `Tags` (comma-separated), `PreviewUrl`, and `Metadata` (game-defined
/// text set with `Workshop.SetMetadata`) are strings; `Created` and `Updated` are Unix seconds;
/// `Visibility` is a `WorkshopVisibility` value; `VotesUp`, `VotesDown`, and `Size` (bytes) are
/// integers; and `Score` is the vote score from 0 to 1.
RT_CLASS_BEGIN("Zanna.Services.WorkshopItem", ServicesWorkshopItem, "obj", none)
    RT_PROP("Id", "str", ServicesWorkshopItemId, none)
    RT_PROP("Title", "str", ServicesWorkshopItemTitle, none)
    RT_PROP("Description", "str", ServicesWorkshopItemDescription, none)
    RT_PROP("OwnerId", "str", ServicesWorkshopItemOwnerId, none)
    RT_PROP("Tags", "str", ServicesWorkshopItemTags, none)
    RT_PROP("PreviewUrl", "str", ServicesWorkshopItemPreviewUrl, none)
    RT_PROP("Metadata", "str", ServicesWorkshopItemMetadata, none)
    RT_PROP("Created", "i64", ServicesWorkshopItemCreated, none)
    RT_PROP("Updated", "i64", ServicesWorkshopItemUpdated, none)
    RT_PROP("Visibility", "i64", ServicesWorkshopItemVisibility, none)
    RT_PROP("VotesUp", "i64", ServicesWorkshopItemVotesUp, none)
    RT_PROP("VotesDown", "i64", ServicesWorkshopItemVotesDown, none)
    RT_PROP("Size", "i64", ServicesWorkshopItemSize, none)
    RT_PROP("Score", "f64", ServicesWorkshopItemScore, none)
RT_CLASS_END()

/// @summary Exposes Steam-only capabilities of the platform services layer.
/// @details
/// `Zanna.Services.Steam` complements `Zanna.Services.Platform` when Steam is the active provider.
/// `RestartAppIfNecessary(appId)` works before `Platform.Init`: when it returns `true`, Steam is
/// relaunching the game and the process should exit immediately. `SteamId` is the signed-in
/// user's SteamID64, `HardwareType` reports a `Zanna.Services.SteamHardware` value, and
/// `IsUnderProton`, `IsBigPicture`, and `LibraryPath` describe the running environment. Every
/// query returns a neutral value while Steam is not the active provider.
///
/// The provider loads the developer-shipped Steamworks redistributable (`steam_api64.dll`,
/// `libsteam_api.dylib`, or `libsteam_api.so`) from the executable directory, or from the path in
/// the `ZANNA_SERVICES_STEAM_LIBRARY` environment variable during development.
RT_CLASS_BEGIN("Zanna.Services.Steam", ServicesSteam, "none", none)
    RT_PROP("IsActive", "i1", ServicesSteamIsActive, none)
    RT_PROP("SteamId", "i64", ServicesSteamSteamId, none)
    RT_PROP("HardwareType", "i64", ServicesSteamHardwareType, none)
    RT_PROP("IsUnderProton", "i1", ServicesSteamIsUnderProton, none)
    RT_PROP("IsBigPicture", "i1", ServicesSteamIsBigPicture, none)
    RT_PROP("LibraryPath", "str", ServicesSteamLibraryPath, none)
    RT_METHOD("RestartAppIfNecessary", "i1(i64)", ServicesSteamRestartAppIfNecessary)
RT_CLASS_END()

/// @summary Defines platform services status codes.
/// @details
/// `Zanna.Services.Status` values are read from `Platform.Status`. `Ok` means a provider is started,
/// `NotStarted` is the state before `Init` and after `Shutdown`, and the remaining values name why
/// the last `Init` failed: an unknown provider, a missing or incompatible redistributable library,
/// an unsupported platform, a platform client that is not running or is too old, or another
/// initialization failure.
RT_CLASS_BEGIN("Zanna.Services.Status", ServicesStatus, "none", none)
    RT_PROP("Ok", "i64", ServicesStatusOk, none)
    RT_PROP("NotStarted", "i64", ServicesStatusNotStarted, none)
    RT_PROP("UnknownProvider", "i64", ServicesStatusUnknownProvider, none)
    RT_PROP("LibraryNotFound", "i64", ServicesStatusLibraryNotFound, none)
    RT_PROP("LibraryIncompatible", "i64", ServicesStatusLibraryIncompatible, none)
    RT_PROP("UnsupportedPlatform", "i64", ServicesStatusUnsupportedPlatform, none)
    RT_PROP("ClientNotRunning", "i64", ServicesStatusClientNotRunning, none)
    RT_PROP("VersionMismatch", "i64", ServicesStatusVersionMismatch, none)
    RT_PROP("InitFailed", "i64", ServicesStatusInitFailed, none)
RT_CLASS_END()

/// @summary Defines platform services event kinds returned by Platform.PollEvent.
/// @details
/// `Zanna.Services.EventKind` values identify queued platform events. `ServiceConnected`,
/// `ServiceDisconnected` (EventResultCode holds the provider result), and `ConnectFailed`
/// (EventFlag is true while retrying) track the online connection. `OverlayChanged` reports the
/// platform overlay opening (EventFlag true) or closing; pause single-player games while it is
/// open. `DlcInstalled` carries the DLC id in EventText and EventValue,
/// `LaunchParametersChanged` reports a relaunch with new parameters (read them again with
/// `Platform.LaunchCommandLine` and `Platform.LaunchParameter`), and `ServiceShutdown` asks
/// the game to save and shut the provider down. `StatsStored` reports the result of
/// `Stats.Store` (EventFlag is true on success, EventResultCode holds the provider result).
/// `AchievementStored` reports a stored unlock (EventFlag true) or progress notification
/// (EventValue out of EventTotal) with the achievement id in EventText. `TextInputDismissed`
/// reports that the floating keyboard closed. `AchievementIconReady` reports that an icon
/// finished loading: EventText holds the achievement id, EventFlag is true for the unlocked
/// variant, and EventValue is 1 when the achievement has an icon for that state.
/// `ControllerConnected` and `ControllerDisconnected` carry the controller id in EventText while
/// `ActionInput` is started, and `ControllerConfigured` reports that a controller's bindings loaded
/// (EventFlag is true when they bind actions, EventValue holds the major binding revision).
/// `WorkshopItemInstalled` names an installed or updated item in EventText,
/// `WorkshopItemDownloaded` reports a `Workshop.Download` (EventFlag is true on success,
/// EventResultCode holds the provider result), and `WorkshopSubscriptionChanged` reports a
/// subscription (EventFlag true) or unsubscription with the item id in EventText. `None` means the
/// queue is empty.
RT_CLASS_BEGIN("Zanna.Services.EventKind", ServicesEventKind, "none", none)
    RT_PROP("None", "i64", ServicesEventKindNone, none)
    RT_PROP("ServiceConnected", "i64", ServicesEventKindServiceConnected, none)
    RT_PROP("ServiceDisconnected", "i64", ServicesEventKindServiceDisconnected, none)
    RT_PROP("ConnectFailed", "i64", ServicesEventKindConnectFailed, none)
    RT_PROP("OverlayChanged", "i64", ServicesEventKindOverlayChanged, none)
    RT_PROP("DlcInstalled", "i64", ServicesEventKindDlcInstalled, none)
    RT_PROP("LaunchParametersChanged", "i64", ServicesEventKindLaunchParametersChanged, none)
    RT_PROP("ServiceShutdown", "i64", ServicesEventKindServiceShutdown, none)
    RT_PROP("StatsStored", "i64", ServicesEventKindStatsStored, none)
    RT_PROP("AchievementStored", "i64", ServicesEventKindAchievementStored, none)
    RT_PROP("TextInputDismissed", "i64", ServicesEventKindTextInputDismissed, none)
    RT_PROP("AchievementIconReady", "i64", ServicesEventKindAchievementIconReady, none)
    RT_PROP("ControllerConnected", "i64", ServicesEventKindControllerConnected, none)
    RT_PROP("ControllerDisconnected", "i64", ServicesEventKindControllerDisconnected, none)
    RT_PROP("ControllerConfigured", "i64", ServicesEventKindControllerConfigured, none)
    RT_PROP("WorkshopItemInstalled", "i64", ServicesEventKindWorkshopItemInstalled, none)
    RT_PROP("WorkshopItemDownloaded", "i64", ServicesEventKindWorkshopItemDownloaded, none)
    RT_PROP("WorkshopSubscriptionChanged", "i64", ServicesEventKindWorkshopSubscriptionChanged, none)
RT_CLASS_END()

/// @summary Defines platform services feature identifiers for Platform.HasFeature.
/// @details
/// `Zanna.Services.Feature` values ask whether the active provider can serve a group of members
/// right now: `Identity` (UserId, UserName, IsOnline), `Licensing` (IsLicensed, IsDlcInstalled),
/// `Language`, `PlayerCount` (RequestPlayerCount), one value per feature class
/// (`Achievements`, `Stats`, `Leaderboards`, `Presence`, `Overlay`, `TextInput` for
/// `OnScreenKeyboard`, `Cloud`, and `Timeline`), `LaunchParameters` (LaunchCommandLine,
/// LaunchParameter), `AppDetails` (the DLC list, BuildId, BranchName), `AchievementIcons`
/// (Achievements.IconWidth, IconHeight, IconRgba), `AchievementPercentages`
/// (Achievements.RequestGlobalPercentages, GlobalPercent), `ActionInput`, and `Workshop`.
/// A feature can be unavailable even while a provider is started, for example when an older
/// redistributable lacks an interface; `Platform.Diagnostics` then explains why.
RT_CLASS_BEGIN("Zanna.Services.Feature", ServicesFeature, "none", none)
    RT_PROP("Identity", "i64", ServicesFeatureIdentity, none)
    RT_PROP("Licensing", "i64", ServicesFeatureLicensing, none)
    RT_PROP("Language", "i64", ServicesFeatureLanguage, none)
    RT_PROP("PlayerCount", "i64", ServicesFeaturePlayerCount, none)
    RT_PROP("Achievements", "i64", ServicesFeatureAchievements, none)
    RT_PROP("Stats", "i64", ServicesFeatureStats, none)
    RT_PROP("Leaderboards", "i64", ServicesFeatureLeaderboards, none)
    RT_PROP("Presence", "i64", ServicesFeaturePresence, none)
    RT_PROP("Overlay", "i64", ServicesFeatureOverlay, none)
    RT_PROP("TextInput", "i64", ServicesFeatureTextInput, none)
    RT_PROP("Cloud", "i64", ServicesFeatureCloud, none)
    RT_PROP("LaunchParameters", "i64", ServicesFeatureLaunchParameters, none)
    RT_PROP("Timeline", "i64", ServicesFeatureTimeline, none)
    RT_PROP("AppDetails", "i64", ServicesFeatureAppDetails, none)
    RT_PROP("AchievementIcons", "i64", ServicesFeatureAchievementIcons, none)
    RT_PROP("AchievementPercentages", "i64", ServicesFeatureAchievementPercentages, none)
    RT_PROP("ActionInput", "i64", ServicesFeatureActionInput, none)
    RT_PROP("Workshop", "i64", ServicesFeatureWorkshop, none)
RT_CLASS_END()

/// @summary Defines platform services request kinds reported by Request.Kind.
/// @details
/// `Zanna.Services.RequestKind` identifies what a `Zanna.Services.Request` asked for. `PlayerCount`
/// requests the number of players currently running the game (`Value` holds the count).
/// `LeaderboardFind`, `LeaderboardUpload`, and `LeaderboardDownload` come from
/// `Zanna.Services.Leaderboards`, and `TextInput` from `OnScreenKeyboard.RequestText` (`Text`
/// holds the submitted text). `TimelineEventRecording` and `TimelinePhaseRecording` come from
/// `Zanna.Services.Timeline` (`Flag` is true when something was recorded),
/// `AchievementPercentages` from `Achievements.RequestGlobalPercentages`, and the `Workshop*`
/// kinds from `Zanna.Services.Workshop` (`WorkshopQuery` requests carry items; the other kinds
/// hold the item id in `Text`, and `WorkshopCreate` and `WorkshopSubmit` set `Flag` when the player
/// must accept the Workshop agreement).
RT_CLASS_BEGIN("Zanna.Services.RequestKind", ServicesRequestKind, "none", none)
    RT_PROP("PlayerCount", "i64", ServicesRequestKindPlayerCount, none)
    RT_PROP("LeaderboardFind", "i64", ServicesRequestKindLeaderboardFind, none)
    RT_PROP("LeaderboardUpload", "i64", ServicesRequestKindLeaderboardUpload, none)
    RT_PROP("LeaderboardDownload", "i64", ServicesRequestKindLeaderboardDownload, none)
    RT_PROP("TextInput", "i64", ServicesRequestKindTextInput, none)
    RT_PROP("TimelineEventRecording", "i64", ServicesRequestKindTimelineEventRecording, none)
    RT_PROP("TimelinePhaseRecording", "i64", ServicesRequestKindTimelinePhaseRecording, none)
    RT_PROP("AchievementPercentages", "i64", ServicesRequestKindAchievementPercentages, none)
    RT_PROP("WorkshopQuery", "i64", ServicesRequestKindWorkshopQuery, none)
    RT_PROP("WorkshopSubscribe", "i64", ServicesRequestKindWorkshopSubscribe, none)
    RT_PROP("WorkshopUnsubscribe", "i64", ServicesRequestKindWorkshopUnsubscribe, none)
    RT_PROP("WorkshopCreate", "i64", ServicesRequestKindWorkshopCreate, none)
    RT_PROP("WorkshopSubmit", "i64", ServicesRequestKindWorkshopSubmit, none)
    RT_PROP("WorkshopDelete", "i64", ServicesRequestKindWorkshopDelete, none)
RT_CLASS_END()

/// @summary Defines the game modes that color the platform recording timeline.
/// @details
/// `Zanna.Services.TimelineMode` values are passed to `Timeline.SetGameMode`: `Playing` while the
/// player plays, `Staging` while play is being set up (a lobby, a lineup screen), `Menus` in
/// menus, and `LoadingScreen` while loading.
RT_CLASS_BEGIN("Zanna.Services.TimelineMode", ServicesTimelineMode, "none", none)
    RT_PROP("Playing", "i64", ServicesTimelineModePlaying, none)
    RT_PROP("Staging", "i64", ServicesTimelineModeStaging, none)
    RT_PROP("Menus", "i64", ServicesTimelineModeMenus, none)
    RT_PROP("LoadingScreen", "i64", ServicesTimelineModeLoadingScreen, none)
RT_CLASS_END()

/// @summary Defines whether the platform offers a timeline event as a clip.
/// @details
/// `Zanna.Services.TimelineClip` values tell the platform how to treat a timeline event when the
/// player saves clips: `None` never suggests it, `Standard` may suggest it, and `Featured` suggests
/// it ahead of standard events.
RT_CLASS_BEGIN("Zanna.Services.TimelineClip", ServicesTimelineClip, "none", none)
    RT_PROP("None", "i64", ServicesTimelineClipNone, none)
    RT_PROP("Standard", "i64", ServicesTimelineClipStandard, none)
    RT_PROP("Featured", "i64", ServicesTimelineClipFeatured, none)
RT_CLASS_END()

/// @summary Defines controller types reported by ActionInput.ControllerType.
/// @details
/// `Zanna.Services.ControllerType` values name the kind of controller behind a controller id:
/// `Unknown`, `SteamController`, `Xbox360`, `XboxOne` (including Xbox Series controllers),
/// `GenericGamepad`, `PlayStation4`, `AppleMfi`, `Android`, `SwitchJoyConPair`,
/// `SwitchJoyConSingle`, `SwitchPro`, `MobileTouch` (an on-screen controller), `PlayStation3`,
/// `PlayStation5`, `SteamDeck`, `SteamOSHandheld`, `Switch2Pro`, `SteamController2026`, and
/// `SteamFrameControllerPair`. Use them for defaults and analytics; show button prompts with
/// `ActionInput.OriginGlyphPath`, which follows the player's bindings.
RT_CLASS_BEGIN("Zanna.Services.ControllerType", ServicesControllerType, "none", none)
    RT_PROP("Unknown", "i64", ServicesControllerTypeUnknown, none)
    RT_PROP("SteamController", "i64", ServicesControllerTypeSteamController, none)
    RT_PROP("Xbox360", "i64", ServicesControllerTypeXbox360, none)
    RT_PROP("XboxOne", "i64", ServicesControllerTypeXboxOne, none)
    RT_PROP("GenericGamepad", "i64", ServicesControllerTypeGenericGamepad, none)
    RT_PROP("PlayStation4", "i64", ServicesControllerTypePlayStation4, none)
    RT_PROP("AppleMfi", "i64", ServicesControllerTypeAppleMfi, none)
    RT_PROP("Android", "i64", ServicesControllerTypeAndroid, none)
    RT_PROP("SwitchJoyConPair", "i64", ServicesControllerTypeSwitchJoyConPair, none)
    RT_PROP("SwitchJoyConSingle", "i64", ServicesControllerTypeSwitchJoyConSingle, none)
    RT_PROP("SwitchPro", "i64", ServicesControllerTypeSwitchPro, none)
    RT_PROP("MobileTouch", "i64", ServicesControllerTypeMobileTouch, none)
    RT_PROP("PlayStation3", "i64", ServicesControllerTypePlayStation3, none)
    RT_PROP("PlayStation5", "i64", ServicesControllerTypePlayStation5, none)
    RT_PROP("SteamDeck", "i64", ServicesControllerTypeSteamDeck, none)
    RT_PROP("SteamOSHandheld", "i64", ServicesControllerTypeSteamOSHandheld, none)
    RT_PROP("Switch2Pro", "i64", ServicesControllerTypeSwitch2Pro, none)
    RT_PROP("SteamController2026", "i64", ServicesControllerTypeSteamController2026, none)
    RT_PROP("SteamFrameControllerPair", "i64", ServicesControllerTypeSteamFrameControllerPair, none)
RT_CLASS_END()

/// @summary Defines glyph image sizes for ActionInput.OriginGlyphPath.
/// @details
/// `Zanna.Services.GlyphSize` values select the glyph image: `Small` (32 by 32 pixels on Steam),
/// `Medium` (128 by 128), and `Large` (256 by 256).
RT_CLASS_BEGIN("Zanna.Services.GlyphSize", ServicesGlyphSize, "none", none)
    RT_PROP("Small", "i64", ServicesGlyphSizeSmall, none)
    RT_PROP("Medium", "i64", ServicesGlyphSizeMedium, none)
    RT_PROP("Large", "i64", ServicesGlyphSizeLarge, none)
RT_CLASS_END()

/// @summary Defines the orders Workshop.Query ranks items by.
/// @details
/// `Zanna.Services.WorkshopQuery` values: `Popular` (by votes), `Newest` (by publication date),
/// `Trending` (by recent votes), `MostSubscribed` (by unique subscriptions), `RecentlyUpdated`
/// (by last update), and `TextSearch` (by how well items match the search text).
RT_CLASS_BEGIN("Zanna.Services.WorkshopQuery", ServicesWorkshopQuery, "none", none)
    RT_PROP("Popular", "i64", ServicesWorkshopQueryPopular, none)
    RT_PROP("Newest", "i64", ServicesWorkshopQueryNewest, none)
    RT_PROP("Trending", "i64", ServicesWorkshopQueryTrending, none)
    RT_PROP("MostSubscribed", "i64", ServicesWorkshopQueryMostSubscribed, none)
    RT_PROP("RecentlyUpdated", "i64", ServicesWorkshopQueryRecentlyUpdated, none)
    RT_PROP("TextSearch", "i64", ServicesWorkshopQueryTextSearch, none)
RT_CLASS_END()

/// @summary Defines the player's Workshop lists for Workshop.QueryUser.
/// @details
/// `Zanna.Services.WorkshopList` values: `Published`, `Subscribed`, `Favorited`, `VotedUp`, and
/// `Played` (items the player used).
RT_CLASS_BEGIN("Zanna.Services.WorkshopList", ServicesWorkshopList, "none", none)
    RT_PROP("Published", "i64", ServicesWorkshopListPublished, none)
    RT_PROP("Subscribed", "i64", ServicesWorkshopListSubscribed, none)
    RT_PROP("Favorited", "i64", ServicesWorkshopListFavorited, none)
    RT_PROP("VotedUp", "i64", ServicesWorkshopListVotedUp, none)
    RT_PROP("Played", "i64", ServicesWorkshopListPlayed, none)
RT_CLASS_END()

/// @summary Defines who can see a Workshop item.
/// @details
/// `Zanna.Services.WorkshopVisibility` values: `Public`, `FriendsOnly`, `Private` (the author only),
/// and `Unlisted` (anyone with the link).
RT_CLASS_BEGIN("Zanna.Services.WorkshopVisibility", ServicesWorkshopVisibility, "none", none)
    RT_PROP("Public", "i64", ServicesWorkshopVisibilityPublic, none)
    RT_PROP("FriendsOnly", "i64", ServicesWorkshopVisibilityFriendsOnly, none)
    RT_PROP("Private", "i64", ServicesWorkshopVisibilityPrivate, none)
    RT_PROP("Unlisted", "i64", ServicesWorkshopVisibilityUnlisted, none)
RT_CLASS_END()

/// @summary Defines the stages of a submitted Workshop update.
/// @details
/// `Zanna.Services.WorkshopUpdateStatus` values: `None` (no upload in progress for the id),
/// `PreparingConfig`, `PreparingContent`, `UploadingContent`, `UploadingPreview`, and
/// `Committing`.
RT_CLASS_BEGIN("Zanna.Services.WorkshopUpdateStatus", ServicesWorkshopUpdateStatus, "none", none)
    RT_PROP("None", "i64", ServicesWorkshopUpdateStatusNone, none)
    RT_PROP("PreparingConfig", "i64", ServicesWorkshopUpdateStatusPreparingConfig, none)
    RT_PROP("PreparingContent", "i64", ServicesWorkshopUpdateStatusPreparingContent, none)
    RT_PROP("UploadingContent", "i64", ServicesWorkshopUpdateStatusUploadingContent, none)
    RT_PROP("UploadingPreview", "i64", ServicesWorkshopUpdateStatusUploadingPreview, none)
    RT_PROP("Committing", "i64", ServicesWorkshopUpdateStatusCommitting, none)
RT_CLASS_END()

/// @summary Defines which leaderboard entries Leaderboards.Download fetches.
/// @details
/// `Zanna.Services.LeaderboardScope` values select a download range: `Global` treats start and end
/// as absolute ranks from 1, `AroundUser` treats them as offsets from the player's own rank (for
/// example -4..5 fetches the player and nearby entries), and `Friends` fetches the player and their
/// friends and ignores the range.
RT_CLASS_BEGIN("Zanna.Services.LeaderboardScope", ServicesLeaderboardScope, "none", none)
    RT_PROP("Global", "i64", ServicesLeaderboardScopeGlobal, none)
    RT_PROP("AroundUser", "i64", ServicesLeaderboardScopeAroundUser, none)
    RT_PROP("Friends", "i64", ServicesLeaderboardScopeFriends, none)
RT_CLASS_END()

/// @summary Defines how a leaderboard created by Leaderboards.FindOrCreate ranks scores.
/// @details
/// `Zanna.Services.LeaderboardSort` values choose the ranking order: `Ascending` ranks the lowest
/// score first (times, strokes) and `Descending` ranks the highest score first (points).
RT_CLASS_BEGIN("Zanna.Services.LeaderboardSort", ServicesLeaderboardSort, "none", none)
    RT_PROP("Ascending", "i64", ServicesLeaderboardSortAscending, none)
    RT_PROP("Descending", "i64", ServicesLeaderboardSortDescending, none)
RT_CLASS_END()

/// @summary Defines how the platform displays scores of a leaderboard created by FindOrCreate.
/// @details
/// `Zanna.Services.LeaderboardDisplay` values tell the platform how to format scores in its own
/// views: `Numeric` for plain numbers, `Seconds` and `Milliseconds` for times.
RT_CLASS_BEGIN("Zanna.Services.LeaderboardDisplay", ServicesLeaderboardDisplay, "none", none)
    RT_PROP("Numeric", "i64", ServicesLeaderboardDisplayNumeric, none)
    RT_PROP("Seconds", "i64", ServicesLeaderboardDisplaySeconds, none)
    RT_PROP("Milliseconds", "i64", ServicesLeaderboardDisplayMilliseconds, none)
RT_CLASS_END()

/// @summary Defines the overlay pages Overlay.Open can show.
/// @details
/// `Zanna.Services.OverlayPage` values name overlay pages: `Friends`, `Community`, `Players`
/// (people recently played with), `Settings`, `OfficialGroup` (the game's official group),
/// `Stats`, and `Achievements` (the player's stats and achievements for this game).
RT_CLASS_BEGIN("Zanna.Services.OverlayPage", ServicesOverlayPage, "none", none)
    RT_PROP("Friends", "i64", ServicesOverlayPageFriends, none)
    RT_PROP("Community", "i64", ServicesOverlayPageCommunity, none)
    RT_PROP("Players", "i64", ServicesOverlayPagePlayers, none)
    RT_PROP("Settings", "i64", ServicesOverlayPageSettings, none)
    RT_PROP("OfficialGroup", "i64", ServicesOverlayPageOfficialGroup, none)
    RT_PROP("Stats", "i64", ServicesOverlayPageStats, none)
    RT_PROP("Achievements", "i64", ServicesOverlayPageAchievements, none)
RT_CLASS_END()

/// @summary Defines the screen corners for Overlay.SetNotificationPosition.
/// @details
/// `Zanna.Services.NotificationPosition` values choose where overlay notifications such as
/// achievement unlocks appear: `TopLeft`, `TopRight`, `BottomLeft`, or `BottomRight`.
RT_CLASS_BEGIN("Zanna.Services.NotificationPosition", ServicesNotificationPosition, "none", none)
    RT_PROP("TopLeft", "i64", ServicesNotificationPositionTopLeft, none)
    RT_PROP("TopRight", "i64", ServicesNotificationPositionTopRight, none)
    RT_PROP("BottomLeft", "i64", ServicesNotificationPositionBottomLeft, none)
    RT_PROP("BottomRight", "i64", ServicesNotificationPositionBottomRight, none)
RT_CLASS_END()

/// @summary Defines on-screen keyboard layouts for Zanna.Services.OnScreenKeyboard.
/// @details
/// `Zanna.Services.TextInputMode` values choose the keyboard: `SingleLine` (Enter finishes),
/// `MultiLine` (the player closes the keyboard), `Email`, `Numeric`, and `Password` (masked entry
/// for full-screen text input; the floating keyboard uses `SingleLine` instead).
RT_CLASS_BEGIN("Zanna.Services.TextInputMode", ServicesTextInputMode, "none", none)
    RT_PROP("SingleLine", "i64", ServicesTextInputModeSingleLine, none)
    RT_PROP("MultiLine", "i64", ServicesTextInputModeMultiLine, none)
    RT_PROP("Email", "i64", ServicesTextInputModeEmail, none)
    RT_PROP("Numeric", "i64", ServicesTextInputModeNumeric, none)
    RT_PROP("Password", "i64", ServicesTextInputModePassword, none)
RT_CLASS_END()

/// @summary Defines Steam hardware identifiers reported by Steam.HardwareType.
/// @details
/// `Zanna.Services.SteamHardware` values describe the device the game runs on: `None` for a regular
/// PC, `SteamDeck`, `SteamMachine`, or `SteamFrame`. `Unknown` is reported while Steam is not the
/// active provider. Redistributables older than Steamworks SDK 1.65 distinguish only `SteamDeck`
/// from `None`. Use these values for analytics and default settings, not to gate features.
RT_CLASS_BEGIN("Zanna.Services.SteamHardware", ServicesSteamHardware, "none", none)
    RT_PROP("Unknown", "i64", ServicesSteamHardwareUnknown, none)
    RT_PROP("None", "i64", ServicesSteamHardwareNone, none)
    RT_PROP("SteamDeck", "i64", ServicesSteamHardwareSteamDeck, none)
    RT_PROP("SteamMachine", "i64", ServicesSteamHardwareSteamMachine, none)
    RT_PROP("SteamFrame", "i64", ServicesSteamHardwareSteamFrame, none)
RT_CLASS_END()
