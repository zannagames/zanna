module Benchmark;

bind Zanna.Terminal;
bind Zanna.Text.Fmt as Fmt;

// Fibonacci benchmark - compute fib(45), matching bench.c
func fib(n: Integer) -> Integer {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func start() {
    var result = fib(45);
    Say("fib(45) = " + Fmt.Int(result));
}
