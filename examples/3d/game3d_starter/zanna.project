project game3d_starter
version 0.1.0
lang zia
entry main.zia

package-name "Game3D Starter"
package-description "A code-first Zanna Game3D starter scene"
package-identifier org.zanna-lang.game3d-starter
package-author "Zanna Project"
package-license MIT

# Embed the marker model so the demo binary is self-contained: the loose
# `asset` form only works when the binary runs beside its assets directory,
# and examples/bin binaries run from anywhere (Assets3D.LoadEntityAsset
# resolves embedded bytes first, filesystem second).
embed assets/models/triangle.gltf
