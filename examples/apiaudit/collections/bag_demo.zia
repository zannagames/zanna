// bag_demo.zia - Comprehensive API audit for Zanna.Collections.StringSet
// Tests: New, Add, Has, Remove, Count, IsEmpty, ToSeq, Clear, Union, Intersect, Difference

module BagDemo;

bind Zanna.Collections;
bind Zanna.Core;
bind Zanna.Terminal;
bind Zanna.Text.Fmt;

func start() {
    Say("=== StringSet API Audit ===");

    // --- New ---
    Say("--- New ---");
    var bag = StringSet.New();
    SayInt(bag.Count);       // 0
    SayBool(bag.IsEmpty);  // 1

    // --- Add / Count ---
    Say("--- Add / Count ---");
    SayBool(bag.Add("apple"));   // 1 (new)
    SayBool(bag.Add("banana"));  // 1 (new)
    SayBool(bag.Add("cherry")); // 1 (new)
    SayBool(bag.Add("apple"));  // 0 (duplicate)
    SayInt(bag.Count);             // 3
    SayBool(bag.IsEmpty);        // 0

    // --- Has ---
    Say("--- Has ---");
    SayBool(bag.Has("apple"));   // 1
    SayBool(bag.Has("banana"));  // 1
    SayBool(bag.Has("grape"));   // 0

    // --- Remove ---
    Say("--- Remove ---");
    SayBool(bag.Remove("banana")); // 1
    SayBool(bag.Has("banana"));  // 0
    SayInt(bag.Count);             // 2
    SayBool(bag.Remove("banana")); // 0 (already removed)

    // --- ToSeq ---
    Say("--- ToSeq ---");
    var items = bag.ToSeq();
    SayInt(items.Count);           // 2

    // --- Union ---
    Say("--- Union ---");
    var b1 = StringSet.New();
    b1.Add("a");
    b1.Add("b");
    b1.Add("c");

    var b2 = StringSet.New();
    b2.Add("b");
    b2.Add("c");
    b2.Add("d");

    var merged = b1.Union(b2);
    SayInt(merged.Count);          // 4 (a, b, c, d)
    SayBool(merged.Has("a"));    // 1
    SayBool(merged.Has("d"));    // 1

    // --- Intersect ---
    Say("--- Intersect ---");
    var common = b1.Intersect(b2);
    SayInt(common.Count);          // 2 (b, c)
    SayBool(common.Has("b"));    // 1
    SayBool(common.Has("c"));    // 1
    SayBool(common.Has("a"));    // 0

    // --- Difference ---
    Say("--- Difference ---");
    var diff = b1.Difference(b2);
    SayInt(diff.Count);            // 1 (a)
    SayBool(diff.Has("a"));      // 1
    SayBool(diff.Has("b"));      // 0

    // --- Clear ---
    Say("--- Clear ---");
    b1.Clear();
    SayInt(b1.Count);              // 0
    SayBool(b1.IsEmpty);         // 1

    Say("=== StringSet audit complete ===");
}
