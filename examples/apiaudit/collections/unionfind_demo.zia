// unionfind_demo.zia - Comprehensive API audit for Zanna.Collections.UnionFind
// Tests: New, FindRoot, Union, IsConnected, Count, ComponentSize, Clear

module UnionFindDemo;

bind Zanna.Collections;
bind Zanna.Core;
bind Zanna.Terminal;
bind Zanna.Text.Fmt;

func start() {
    Say("=== UnionFind API Audit ===");

    // --- New ---
    Say("--- New ---");
    var uf = UnionFind.New(6);
    SayInt(uf.Count);       // 6 (each element is its own set)

    // --- FindRoot ---
    Say("--- FindRoot ---");
    SayInt(uf.FindRoot(0).UnwrapOrI64(-1));     // 0 (own representative)
    SayInt(uf.FindRoot(3).UnwrapOrI64(-1));     // 3 (own representative)
    var root = uf.FindRoot(0);
    SayBool(root.IsSome);
    SayInt(root.UnwrapI64()); // 0
    SayBool(uf.FindRoot(99).IsNone);

    // --- Union ---
    Say("--- Union ---");
    SayInt(uf.Union(0, 1));  // 1 (merged)
    SayInt(uf.Count);        // 5
    SayInt(uf.Union(2, 3));  // 1 (merged)
    SayInt(uf.Count);        // 4
    SayInt(uf.Union(0, 1));  // 0 (already in same set)
    SayInt(uf.Count);        // 4 (unchanged)

    // --- Connected ---
    Say("--- Connected ---");
    SayBool(uf.IsConnected(0, 1)); // 1
    SayBool(uf.IsConnected(2, 3)); // 1
    SayBool(uf.IsConnected(0, 2)); // 0 (different sets)
    SayBool(uf.IsConnected(4, 5)); // 0

    // --- Union across groups ---
    Say("--- Union across groups ---");
    SayInt(uf.Union(1, 3));      // 1 (merge {0,1} and {2,3})
    SayInt(uf.Count);            // 3
    SayBool(uf.IsConnected(0, 2)); // 1 (now connected)
    SayBool(uf.IsConnected(0, 3)); // 1

    // --- SetSize ---
    Say("--- SetSize ---");
    SayInt(uf.ComponentSize(0));       // 4 ({0,1,2,3})
    SayInt(uf.ComponentSize(4));       // 1 ({4} alone)
    SayInt(uf.ComponentSize(5));       // 1 ({5} alone)

    // --- Union remaining ---
    Say("--- Union remaining ---");
    uf.Union(4, 5);
    SayInt(uf.Count);            // 2
    SayInt(uf.ComponentSize(4));       // 2

    uf.Union(0, 4);
    SayInt(uf.Count);            // 1
    SayInt(uf.ComponentSize(0));       // 6 (all connected)

    // --- Reset ---
    Say("--- Reset ---");
    uf.Clear();
    SayInt(uf.Count);            // 6 (back to individual sets)
    SayBool(uf.IsConnected(0, 1)); // 0
    SayInt(uf.ComponentSize(0));       // 1

    Say("=== UnionFind audit complete ===");
}
