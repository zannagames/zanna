// sortedset_demo.zia - Comprehensive API audit for Zanna.Collections.SortedSet
// Tests: New, Add, Remove, Has, First, Last, Floor, Ceiling, Lower, Higher,
//        At, IndexOf, ToSeq, Range, Take, Skip, Union, Intersect, Difference,
//        IsSubset, Len, IsEmpty, Clear

module SortedSetDemo;

bind Zanna.Collections;
bind Zanna.Core;
bind Zanna.Terminal;

func start() {
    Say("=== SortedSet API Audit ===");

    // --- New ---
    Say("--- New ---");
    var ss = SortedSet.New();
    SayInt(ss.Count);       // 0
    SayBool(ss.IsEmpty);  // 1

    // --- Add ---
    Say("--- Add ---");
    SayBool(ss.Add("cherry"));   // 1 (new)
    SayBool(ss.Add("apple"));    // 1 (new)
    SayBool(ss.Add("banana"));   // 1 (new)
    SayBool(ss.Add("date"));     // 1 (new)
    SayBool(ss.Add("elderberry")); // 1 (new)
    SayBool(ss.Add("apple"));    // 0 (duplicate)
    SayInt(ss.Count);              // 5
    SayBool(ss.IsEmpty);         // 0

    // --- Has ---
    Say("--- Has ---");
    SayBool(ss.Has("apple"));    // 1
    SayBool(ss.Has("banana"));   // 1
    SayBool(ss.Has("fig"));      // 0

    // --- First / Last (sorted order) ---
    Say("--- First / Last ---");
    Say(ss.First());   // apple (lexicographic first)
    Say(ss.Last());    // elderberry (lexicographic last)

    // --- At (index access, sorted) ---
    Say("--- At ---");
    Say(ss.At(0));  // apple
    Say(ss.At(1));  // banana
    Say(ss.At(2));  // cherry
    Say(ss.At(3));  // date
    Say(ss.At(4));  // elderberry

    // --- IndexOf ---
    Say("--- IndexOf ---");
    SayInt(ss.IndexOf("apple"));     // 0
    SayInt(ss.IndexOf("cherry"));    // 2
    SayInt(ss.IndexOf("elderberry")); // 4

    // --- Floor (greatest element <= key) ---
    Say("--- Floor ---");
    Say(ss.Floor("cherry"));  // cherry
    Say(ss.Floor("c"));       // banana (greatest <= "c")

    // --- Ceiling (smallest element >= key) ---
    Say("--- Ceiling ---");
    Say(ss.Ceiling("cherry"));   // cherry
    Say(ss.Ceiling("c"));        // cherry (smallest >= "c")

    // --- Lower (greatest element < key) ---
    Say("--- Lower ---");
    Say(ss.Lower("cherry"));  // banana

    // --- Higher (smallest element > key) ---
    Say("--- Higher ---");
    Say(ss.Higher("cherry")); // date

    // --- ToSeq ---
    Say("--- ToSeq ---");
    var items = ss.ToSeq();
    SayInt(items.Count);  // 5

    // --- Range ---
    Say("--- Range ---");
    var ranged = ss.Range("banana", "date");
    SayInt(ranged.Count);  // 3 (banana, cherry, date)

    // --- Take ---
    Say("--- Take ---");
    var taken = ss.Take(3);
    SayInt(taken.Count);  // 3

    // --- Skip ---
    Say("--- Skip ---");
    var skipped = ss.Skip(2);
    SayInt(skipped.Count);  // 3

    // --- Remove ---
    Say("--- Remove ---");
    SayBool(ss.Remove("banana"));  // 1 (removed)
    SayBool(ss.Has("banana"));   // 0
    SayInt(ss.Count);              // 4
    SayBool(ss.Remove("banana"));  // 0 (already removed)

    // --- Union ---
    Say("--- Union ---");
    var ss2 = SortedSet.New();
    ss2.Add("apple");
    ss2.Add("fig");
    ss2.Add("grape");
    var merged = ss.Union(ss2);
    SayInt(merged.Count);  // 6 (apple, cherry, date, elderberry, fig, grape)

    // --- Intersect ---
    Say("--- Intersect ---");
    var common = ss.Intersect(ss2);
    SayInt(common.Count);  // 1 (apple)

    // --- Diff ---
    Say("--- Diff ---");
    var diff = ss.Difference(ss2);
    SayInt(diff.Count);  // 3 (cherry, date, elderberry)

    // --- IsSubset ---
    Say("--- IsSubset ---");
    var sub = SortedSet.New();
    sub.Add("apple");
    sub.Add("cherry");
    SayBool(sub.IsSubset(ss));  // 1

    // --- Clear ---
    Say("--- Clear ---");
    ss.Clear();
    SayInt(ss.Count);       // 0
    SayBool(ss.IsEmpty);  // 1

    Say("=== SortedSet audit complete ===");
}
