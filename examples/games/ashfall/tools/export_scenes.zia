//
// File: examples/games/ashfall/tools/export_scenes.zia
// Purpose: Export every authored mission as a canonical .scene3d scene for
//          the scene-driven recreation (ashfall-scenes).
// Key invariants:
//   - Missions build through the exact production levels.build path, so
//     exports cannot drift from the game.
//   - Every gameplay record becomes a typed scene node: geometry boxes carry
//     real meshes/materials/transforms, lights carry real Light3D visuals,
//     and every marker kind carries its `af.kind` metadata discriminator.
//   - Sibling order preserves each builder list's authoring order exactly.
//   - Scalar payloads ride typed metadata for exact i64/f64 VSCN round trips
//     (light directions stay authored-raw; the visual Light3D normalizes).
//   - The complete level_env row, water pool, terrain offsets, objectives,
//     ambient, and start pose persist as root metadata.
// Ownership/Lifetime:
//   - The process owns one LevelBuilder/Objectives/SceneGraph per mission.
// Links: ../world/level_base.zia, ../world/levels.zia,
//        tools/scene_parity_probe.zia, ../../ashfall-scenes/world/scene_levels.zia,
//        docs/adr/0185-collider-authoring-and-gameplay-overlays.md
//
//===----------------------------------------------------------------------===//

module export_scenes;

bind "../config" as config;
bind "../world/level_base" as level_base;
bind "../world/levels" as levels;
bind "../world/level_env" as level_env;
bind "../world/objectives" as objectives;

bind Zanna.Graphics3D as G3D;
bind Zanna.Math as Math;
bind Zanna.Terminal as Terminal;
bind Zanna.IO.Dir as Dir;

var OUT_ROOT: String = "../../ashfall-scenes/assets/scenes";

func main() {
    Dir.MakeAll(OUT_ROOT);
    var env = new level_env.LevelEnv();
    env.setup();
    var exported = 0;
    var id = config.LV_L1;
    while id <= config.LV_HUB {
        if exportLevel(id, env) { exported = exported + 1; }
        else {
            Terminal.Say("RESULT: fail export level " + id);
            return;
        }
        id = id + 1;
    }
    Terminal.Say("Exported " + exported + " mission scenes to " + OUT_ROOT);
    Terminal.Say("RESULT: ok");
}

/// Return the exported scene path for one level id.
func scenePathFor(levelId: Integer) -> String {
    if levelId == config.LV_HUB { return OUT_ROOT + "/hub.scene3d"; }
    return OUT_ROOT + "/mission-0" + levelId + ".scene3d";
}

hide func exportLevel(levelId: Integer, env: level_env.LevelEnv) -> Boolean {
    var lb = new level_base.LevelBuilder();
    var obj = new objectives.Objectives();
    levels.build(levelId, lb, obj);

    var scene = G3D.SceneGraph.New();
    var root = scene.Root;
    writeRootMeta(root, levelId, lb, obj, env);
    exportBoxes(scene, lb);
    exportLights(scene, lb);
    exportSpawns(scene, lb);
    exportPickups(scene, lb);
    exportProps(scene, lb);
    exportCovers(scene, lb);
    exportFlanks(scene, lb);
    exportRouteMarkers(scene, lb);
    exportLandmarks(scene, lb);
    exportBeats(scene, lb);
    exportGates(scene, lb);
    exportIntroCamera(scene, levelId, lb, env);
    return scene.Save(scenePathFor(levelId)) != 0;
}

// --- Root metadata --------------------------------------------------------

hide func writeRootMeta(root: G3D.SceneNode, levelId: Integer,
                        lb: level_base.LevelBuilder,
                        obj: objectives.Objectives,
                        env: level_env.LevelEnv) {
    root.MetadataSetString("af.name", lb.getName());
    root.MetadataSetInt("af.levelId", levelId);
    root.MetadataSetFloat("af.ambR", lb.ambRv());
    root.MetadataSetFloat("af.ambG", lb.ambGv());
    root.MetadataSetFloat("af.ambB", lb.ambBv());
    root.MetadataSetFloat("af.startX", lb.startXv());
    root.MetadataSetFloat("af.startY", lb.startYv());
    root.MetadataSetFloat("af.startZ", lb.startZv());
    root.MetadataSetFloat("af.startYaw", lb.startYawv());
    root.MetadataSetInt("af.terrain", lb.terrainKindOf());
    root.MetadataSetFloat("af.terraOffX", lb.terrainOffXv());
    root.MetadataSetFloat("af.terraOffY", lb.terrainOffYv());
    root.MetadataSetFloat("af.terraOffZ", lb.terrainOffZv());
    root.MetadataSetBool("af.wantWater", lb.wantsWater());
    root.MetadataSetFloat("af.watX", lb.waterXv());
    root.MetadataSetFloat("af.watY", lb.waterYv());
    root.MetadataSetFloat("af.watZ", lb.waterZv());
    root.MetadataSetFloat("af.watW", lb.waterHalfWv());
    root.MetadataSetFloat("af.watD", lb.waterHalfDv());
    writeObjectivesMeta(root, obj);
    writeEnvRowMeta(root, levelId, env);
}

hide func writeObjectivesMeta(root: G3D.SceneNode, obj: objectives.Objectives) {
    root.MetadataSetInt("obj.count", obj.count());
    var i = 0;
    while i < obj.count() {
        var p = "obj." + i + ".";
        root.MetadataSetInt(p + "kind", obj.kindOf(i));
        root.MetadataSetFloat(p + "x", obj.txAt(i));
        root.MetadataSetFloat(p + "z", obj.tzAt(i));
        root.MetadataSetFloat(p + "radius", obj.radiusOf(i));
        root.MetadataSetInt(p + "count", obj.targetOf(i));
        root.MetadataSetString(p + "text", obj.textOf(i));
        root.MetadataSetString(p + "prompt", obj.promptOf(i));
        root.MetadataSetBool(p + "optional", obj.isOptional(i));
        root.MetadataSetInt(p + "prereq", obj.prereqOf(i));
        i = i + 1;
    }
}

hide func writeEnvRowMeta(root: G3D.SceneNode, l: Integer, env: level_env.LevelEnv) {
    root.MetadataSetFloat("lenv.zenR", env.zenithR(l));
    root.MetadataSetFloat("lenv.zenG", env.zenithG(l));
    root.MetadataSetFloat("lenv.zenB", env.zenithB(l));
    root.MetadataSetFloat("lenv.horR", env.horizonR(l));
    root.MetadataSetFloat("lenv.horG", env.horizonG(l));
    root.MetadataSetFloat("lenv.horB", env.horizonB(l));
    root.MetadataSetFloat("lenv.grdR", env.groundR(l));
    root.MetadataSetFloat("lenv.grdG", env.groundG(l));
    root.MetadataSetFloat("lenv.grdB", env.groundB(l));
    root.MetadataSetFloat("lenv.cloud", env.cloudDensity(l));
    root.MetadataSetBool("lenv.stars", env.hasStars(l));
    root.MetadataSetFloat("lenv.sunX", env.sunDirX(l));
    root.MetadataSetFloat("lenv.sunY", env.sunDirY(l));
    root.MetadataSetFloat("lenv.sunZ", env.sunDirZ(l));
    root.MetadataSetFloat("lenv.sunR", env.sunColR(l));
    root.MetadataSetFloat("lenv.sunG", env.sunColG(l));
    root.MetadataSetFloat("lenv.sunB", env.sunColB(l));
    root.MetadataSetFloat("lenv.sunI", env.sunIntensity(l));
    root.MetadataSetFloat("lenv.filX", env.fillDirX(l));
    root.MetadataSetFloat("lenv.filY", env.fillDirY(l));
    root.MetadataSetFloat("lenv.filZ", env.fillDirZ(l));
    root.MetadataSetFloat("lenv.filR", env.fillColR(l));
    root.MetadataSetFloat("lenv.filG", env.fillColG(l));
    root.MetadataSetFloat("lenv.filB", env.fillColB(l));
    root.MetadataSetFloat("lenv.filI", env.fillIntensity(l));
    root.MetadataSetFloat("lenv.ambR", env.ambientR(l));
    root.MetadataSetFloat("lenv.ambG", env.ambientG(l));
    root.MetadataSetFloat("lenv.ambB", env.ambientB(l));
    root.MetadataSetFloat("lenv.fogNear", env.fogNearOf(l));
    root.MetadataSetFloat("lenv.fogFar", env.fogFarOf(l));
    root.MetadataSetBool("lenv.heightFog", env.hasHeightFog(l));
    root.MetadataSetBool("lenv.flare", env.hasFlare(l));
    root.MetadataSetFloat("lenv.accR", env.accentR(l));
    root.MetadataSetFloat("lenv.accG", env.accentG(l));
    root.MetadataSetFloat("lenv.accB", env.accentB(l));
    root.MetadataSetInt("lenv.atmo", env.atmoKind(l));
    root.MetadataSetBool("lenv.terrain", env.hasTerrain(l));
    root.MetadataSetFloat("lenv.vanX", env.vantageX(l));
    root.MetadataSetFloat("lenv.vanY", env.vantageY(l));
    root.MetadataSetFloat("lenv.vanZ", env.vantageZ(l));
}

// --- Node exports ---------------------------------------------------------

hide func markerNode(scene: G3D.SceneGraph, kind: String, name: String,
                     x: Float, y: Float, z: Float) -> G3D.SceneNode {
    var node = G3D.SceneNode.New();
    node.Name = name;
    node.SetPosition(x, y, z);
    node.MetadataSetString("af.kind", kind);
    scene.Add(node);
    return node;
}

hide func exportBoxes(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    // One shared unit mesh: scale carries the half extents (x2). Materials
    // dedupe by exact surface class + RGB so Studio shows one shared
    // material per palette entry.
    var unit = G3D.Mesh3D.Box(1.0, 1.0, 1.0);
    var matKeys: List[String] = [];
    var mats: List[G3D.Material3D] = [];
    var i = 0;
    while i < lb.boxCount() {
        var node = G3D.SceneNode.New();
        node.Name = "Box " + i;
        node.Mesh = unit;
        node.SetPosition(lb.boxCXat(i), lb.boxCYat(i), lb.boxCZat(i));
        node.SetScale(lb.boxHXat(i) * 2.0, lb.boxHYat(i) * 2.0,
                      lb.boxHZat(i) * 2.0);
        var surf = lb.boxSurfAt(i);
        var r = lb.boxRat(i);
        var g = lb.boxGat(i);
        var b = lb.boxBat(i);
        // Exact palette identity: the concatenated text of the authored
        // constants (no epsilon — identical literals must share).
        var key = surf + ":" + r + ":" + g + ":" + b;
        var found = -1;
        var m = 0;
        while m < mats.Count {
            if matKeys[m] == key { found = m; }
            m = m + 1;
        }
        if found < 0 {
            var mat = G3D.Material3D.PBR(r, g, b);
            mats.Add(mat); matKeys.Add(key);
            found = mats.Count - 1;
        }
        node.Material = mats[found];
        node.MetadataSetString("af.kind", "box");
        node.MetadataSetInt("surf", surf);
        if lb.boxCollideAt(i) == 1 {
            // The ADR 0185 collider convention: node-local half extents of
            // 0.5 scale with the node transform to the authored box.
            node.MetadataSetString("collider.kind", "box");
            node.MetadataSetFloat("collider.halfX", 0.5);
            node.MetadataSetFloat("collider.halfY", 0.5);
            node.MetadataSetFloat("collider.halfZ", 0.5);
            node.MetadataSetBool("collider.trigger", false);
        } else {
            node.MetadataSetBool("dressing", true);
        }
        scene.Add(node);
        i = i + 1;
    }
}

hide func exportLights(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.lightCount() {
        var kind = lb.lightKindAt(i);
        var node = G3D.SceneNode.New();
        node.MetadataSetString("af.kind", "light");
        node.MetadataSetInt("light.kind", kind);
        node.MetadataSetFloat("light.r", lb.lightRat(i));
        node.MetadataSetFloat("light.g", lb.lightGat(i));
        node.MetadataSetFloat("light.b", lb.lightBat(i));
        node.MetadataSetFloat("light.range", lb.lightRangeAt(i));
        if kind == 0 {
            node.Name = "Sun " + i;
            // Directions stay authored-raw in metadata; the attached visual
            // normalizes on load, which would otherwise break parity.
            node.MetadataSetFloat("light.dx", lb.lightXat(i));
            node.MetadataSetFloat("light.dy", lb.lightYat(i));
            node.MetadataSetFloat("light.dz", lb.lightZat(i));
            var d = Math.Vec3.New(lb.lightXat(i), lb.lightYat(i), lb.lightZat(i));
            node.Light = G3D.Light3D.Directional(
                d, lb.lightRat(i), lb.lightGat(i), lb.lightBat(i));
        } else {
            node.Name = "Practical " + i;
            node.SetPosition(lb.lightXat(i), lb.lightYat(i), lb.lightZat(i));
            var p = Math.Vec3.New(0.0, 0.0, 0.0);
            node.Light = G3D.Light3D.Point(
                p, lb.lightRat(i), lb.lightGat(i), lb.lightBat(i),
                lb.lightRangeAt(i));
        }
        scene.Add(node);
        i = i + 1;
    }
}

hide func exportSpawns(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.spawnCount() {
        var node = markerNode(scene, "spawn", "Spawn " + i,
                              lb.spawnXat(i), 0.0, lb.spawnZat(i));
        node.MetadataSetInt("spawn.archetype", lb.spawnArchAt(i));
        node.MetadataSetInt("spawn.wave", lb.spawnWaveAt(i));
        node.MetadataSetFloat("spawn.routeX", lb.spawnRouteXat(i));
        node.MetadataSetFloat("spawn.routeZ", lb.spawnRouteZat(i));
        i = i + 1;
    }
}

hide func exportPickups(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.pickupCount() {
        var node = markerNode(scene, "pickup", "Pickup " + i,
                              lb.pickupXat(i), lb.pickupYat(i), lb.pickupZat(i));
        node.MetadataSetInt("pickup.kind", lb.pickupKindAt(i));
        node.MetadataSetFloat("pickup.amount", lb.pickupAmtAt(i));
        i = i + 1;
    }
}

hide func exportProps(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.propCount() {
        var node = markerNode(scene, "prop", "Prop " + i,
                              lb.propXat(i), lb.propYat(i), lb.propZat(i));
        node.MetadataSetInt("prop.kind", lb.propKindAt(i));
        node.MetadataSetFloat("prop.yaw", lb.propYawAt(i));
        node.MetadataSetFloat("prop.scale", lb.propScaleAt(i));
        i = i + 1;
    }
}

hide func exportCovers(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.coverCount() {
        var node = markerNode(scene, "cover", "Cover " + i,
                              lb.coverXat(i), 0.0, lb.coverZat(i));
        node.MetadataSetFloat("cover.faceX", lb.coverFaceXat(i));
        node.MetadataSetFloat("cover.faceZ", lb.coverFaceZat(i));
        i = i + 1;
    }
}

hide func exportFlanks(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.flankCount() {
        markerNode(scene, "flank", "Flank " + i,
                   lb.flankXat(i), 0.0, lb.flankZat(i));
        i = i + 1;
    }
}

hide func exportRouteMarkers(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.routeMarkerCount() {
        var node = markerNode(scene, "routeMarker", "Route " + i,
                              lb.routeMarkerXat(i), 0.0, lb.routeMarkerZat(i));
        node.MetadataSetInt("routeMarker.kind", lb.routeMarkerKindAt(i));
        i = i + 1;
    }
}

hide func exportLandmarks(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.landmarkCount() {
        var node = markerNode(scene, "landmark", "Landmark " + i,
                              lb.landmarkXat(i), 0.0, lb.landmarkZat(i));
        node.MetadataSetInt("landmark.kind", lb.landmarkKindAt(i));
        i = i + 1;
    }
}

hide func exportBeats(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.encounterBeatCount() {
        var node = markerNode(scene, "beat", "Beat " + i,
                              lb.encounterBeatXat(i), 0.0, lb.encounterBeatZat(i));
        node.MetadataSetInt("beat.kind", lb.encounterBeatKindAt(i));
        node.MetadataSetInt("beat.wave", lb.encounterBeatWaveAt(i));
        i = i + 1;
    }
}

hide func exportGates(scene: G3D.SceneGraph, lb: level_base.LevelBuilder) {
    var i = 0;
    while i < lb.gateCount() {
        var node = markerNode(scene, "gate", "Gate " + i,
                              lb.gateXat(i), lb.gateYat(i), lb.gateZat(i));
        node.SetScale(lb.gateHXat(i) * 2.0, lb.gateHYat(i) * 2.0,
                      lb.gateHZat(i) * 2.0);
        node.MetadataSetInt("gate.unlock", lb.gateUnlockAt(i));
        i = i + 1;
    }
}

hide func exportIntroCamera(scene: G3D.SceneGraph, levelId: Integer,
                            lb: level_base.LevelBuilder,
                            env: level_env.LevelEnv) {
    // Authoring value-add: the fly-in vantage as an editable camera node.
    // The reader skips camera-bearing nodes; the game derives its intro from
    // the lenv vantage row exactly as before.
    var node = G3D.SceneNode.New();
    node.Name = "Intro Camera";
    node.SetPosition(lb.startXv() + env.vantageX(levelId),
                     lb.startYv() + env.vantageY(levelId),
                     lb.startZv() + env.vantageZ(levelId));
    node.Camera = G3D.Camera3D.New(60.0, 1.7777777777777777, 0.1, 500.0);
    node.MetadataSetString("af.kind", "camera");
    scene.Add(node);
}
