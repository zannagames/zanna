//===----------------------------------------------------------------------===//
//
// File: examples/games/ashfall/tools/scene_reader.zia
// Purpose: Rebuild a LevelBuilder + Objectives from one exported .scene3d.
// Key invariants:
//   - Node dispatch follows the `af.kind` metadata discriminator in sibling
//     order, so every builder list restores its authoring order exactly.
//   - Geometry restores from real node transforms and material colors, so
//     Studio edits to placed boxes flow straight into gameplay.
//   - Light directions restore from authored-raw metadata (the attached
//     Light3D visual normalizes on load and is presentation-only).
//   - The ashfall-scenes fork carries a byte-matched copy of this module;
//     the parity probe pins both against the code-built levels.
// Ownership/Lifetime:
//   - Callers own the LevelBuilder/Objectives being filled.
// Links: export_scenes.zia, scene_parity_probe.zia,
//        ../../ashfall-scenes/world/scene_levels.zia
//
//===----------------------------------------------------------------------===//

module scene_reader;

bind "../world/level_base" as level_base;
bind "../world/objectives" as objectives;

bind Zanna.Graphics3D as G3D;

/// Fill lb + obj from one exported mission scene. Returns false on load
/// failure; a loaded scene always fills deterministically.
func loadInto(path: String, lb: level_base.LevelBuilder,
              obj: objectives.Objectives) -> Boolean {
    var scene = G3D.SceneGraph.Load(path);
    if scene == null { return false; }
    lb.reset();
    obj.clear();
    var root = scene.Root;
    readRootMeta(root, lb);
    readObjectives(root, obj);
    var i = 0;
    while i < root.ChildCount {
        readNode(root.GetChild(i), lb);
        i = i + 1;
    }
    return true;
}

hide func readRootMeta(root: G3D.SceneNode, lb: level_base.LevelBuilder) {
    lb.setName(root.MetadataGetString("af.name", "Level"));
    lb.setAmbient(root.MetadataGetFloat("af.ambR", 0.15),
                  root.MetadataGetFloat("af.ambG", 0.15),
                  root.MetadataGetFloat("af.ambB", 0.18));
    lb.setStart(root.MetadataGetFloat("af.startX", 0.0),
                root.MetadataGetFloat("af.startY", 0.2),
                root.MetadataGetFloat("af.startZ", 0.0),
                root.MetadataGetFloat("af.startYaw", 0.0));
    lb.setTerrain(root.MetadataGetInt("af.terrain", 0));
    if root.MetadataGetBool("af.wantWater", false) {
        lb.setWater(root.MetadataGetFloat("af.watX", 0.0),
                    root.MetadataGetFloat("af.watY", 0.0),
                    root.MetadataGetFloat("af.watZ", 0.0),
                    root.MetadataGetFloat("af.watW", 4.0),
                    root.MetadataGetFloat("af.watD", 4.0));
    }
}

hide func readObjectives(root: G3D.SceneNode, obj: objectives.Objectives) {
    var count = root.MetadataGetInt("obj.count", 0);
    var i = 0;
    while i < count {
        var p = "obj." + i + ".";
        var prereq = root.MetadataGetInt(p + "prereq", -1);
        if prereq >= 0 {
            obj.addAfter(root.MetadataGetInt(p + "kind", 0),
                         root.MetadataGetFloat(p + "x", 0.0),
                         root.MetadataGetFloat(p + "z", 0.0),
                         root.MetadataGetFloat(p + "radius", 0.0),
                         root.MetadataGetInt(p + "count", 0),
                         root.MetadataGetString(p + "text", ""),
                         root.MetadataGetBool(p + "optional", false),
                         prereq);
        } else {
            obj.add(root.MetadataGetInt(p + "kind", 0),
                    root.MetadataGetFloat(p + "x", 0.0),
                    root.MetadataGetFloat(p + "z", 0.0),
                    root.MetadataGetFloat(p + "radius", 0.0),
                    root.MetadataGetInt(p + "count", 0),
                    root.MetadataGetString(p + "text", ""),
                    root.MetadataGetBool(p + "optional", false));
        }
        obj.setPrompt(i, root.MetadataGetString(p + "prompt", ""));
        i = i + 1;
    }
}

hide func readNode(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    var kind = node.MetadataGetString("af.kind", "");
    if kind == "box" { readBox(node, lb); }
    else if kind == "light" { readLight(node, lb); }
    else if kind == "spawn" { readSpawn(node, lb); }
    else if kind == "pickup" { readPickup(node, lb); }
    else if kind == "prop" { readProp(node, lb); }
    else if kind == "cover" { readCover(node, lb); }
    else if kind == "flank" {
        lb.addFlank(node.Position.X, node.Position.Z);
    }
    else if kind == "routeMarker" {
        lb.addRouteMarker(node.Position.X, node.Position.Z,
                          node.MetadataGetInt("routeMarker.kind", 0));
    }
    else if kind == "landmark" {
        lb.addLandmark(node.Position.X, node.Position.Z,
                       node.MetadataGetInt("landmark.kind", 0));
    }
    else if kind == "beat" {
        lb.addEncounterBeat(node.Position.X, node.Position.Z,
                            node.MetadataGetInt("beat.kind", 0),
                            node.MetadataGetInt("beat.wave", 0));
    }
    else if kind == "gate" { readGate(node, lb); }
    // "camera" and unknown kinds are authoring-only.
}

hide func readBox(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    var position = node.Position;
    var scale = node.Scale;
    var color = node.Material.Color;
    var collide = node.MetadataGetString("collider.kind", "") == "box";
    lb.addBoxMat(position.X, position.Y, position.Z,
                 scale.X * 0.5, scale.Y * 0.5, scale.Z * 0.5,
                 node.MetadataGetInt("surf", 0),
                 color.X, color.Y, color.Z, collide);
}

hide func readLight(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    if node.MetadataGetInt("light.kind", 1) == 0 {
        lb.addDirectional(node.MetadataGetFloat("light.dx", 0.0),
                          node.MetadataGetFloat("light.dy", -1.0),
                          node.MetadataGetFloat("light.dz", 0.0),
                          node.MetadataGetFloat("light.r", 1.0),
                          node.MetadataGetFloat("light.g", 1.0),
                          node.MetadataGetFloat("light.b", 1.0));
    } else {
        var position = node.Position;
        lb.addPoint(position.X, position.Y, position.Z,
                    node.MetadataGetFloat("light.r", 1.0),
                    node.MetadataGetFloat("light.g", 1.0),
                    node.MetadataGetFloat("light.b", 1.0),
                    node.MetadataGetFloat("light.range", 10.0));
    }
}

hide func readSpawn(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    lb.addSpawnRoute(node.MetadataGetInt("spawn.archetype", 0),
                     node.Position.X, node.Position.Z,
                     node.MetadataGetInt("spawn.wave", 0),
                     node.MetadataGetFloat("spawn.routeX", 99999.0),
                     node.MetadataGetFloat("spawn.routeZ", 99999.0));
}

hide func readPickup(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    var position = node.Position;
    lb.addPickup(node.MetadataGetInt("pickup.kind", 0),
                 position.X, position.Y, position.Z,
                 node.MetadataGetFloat("pickup.amount", 0.0));
}

hide func readProp(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    var position = node.Position;
    lb.addProp(node.MetadataGetInt("prop.kind", 0),
               position.X, position.Y, position.Z,
               node.MetadataGetFloat("prop.yaw", 0.0),
               node.MetadataGetFloat("prop.scale", 1.0));
}

hide func readCover(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    lb.addCover(node.Position.X, node.Position.Z,
                node.MetadataGetFloat("cover.faceX", 0.0),
                node.MetadataGetFloat("cover.faceZ", 0.0));
}

hide func readGate(node: G3D.SceneNode, lb: level_base.LevelBuilder) {
    var position = node.Position;
    var scale = node.Scale;
    lb.addGate(position.X, position.Y, position.Z,
               scale.X * 0.5, scale.Y * 0.5, scale.Z * 0.5,
               node.MetadataGetInt("gate.unlock", -1));
}
