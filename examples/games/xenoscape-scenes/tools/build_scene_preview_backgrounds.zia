//
// File: examples/games/xenoscape-scenes/tools/build_scene_preview_backgrounds.zia
// Purpose: Bake fixed-time Studio backdrops through Xenoscape's live renderer.
// Key invariants:
//   - GameCamera.drawBiomeBackground remains the only backdrop implementation.
//   - Every output is a deterministic 1280x720 snapshot at the same fixed time.
//   - Failure omits RESULT: ok and never reports a partial bake as successful.
// Ownership/Lifetime:
//   - The process owns one temporary Canvas, camera, and screenshot at a time.
// Links: ../camera.zia, ../scene-components.json,
//        ../assets/backgrounds/README.md,
//        docs/adr/0202-project-owned-2d-scene-background-previews.md
//
//===----------------------------------------------------------------------===//

module build_scene_preview_backgrounds;

bind Zanna.Graphics;
bind Zanna.IO.Dir as Dir;
bind Zanna.Terminal as Terminal;
bind "../camera";
bind "../config";
bind "../palette";

final PREVIEW_TIMER_MS: Integer = 2400;
final PREVIEW_DIRECTORY: String = "assets/backgrounds";

/// @brief Return one stable zero-padded region background path.
func previewPath(region: Integer) -> String {
    var suffix = "" + region;
    if region < 10 { suffix = "0" + suffix; }
    return PREVIEW_DIRECTORY + "/scene-region-" + suffix + ".png";
}

/// @brief Bake all ten runtime biome backgrounds at a fixed animation time.
func main() {
    Dir.MakeAll(PREVIEW_DIRECTORY);
    if Dir.Exists(PREVIEW_DIRECTORY) == false {
        Terminal.Say(
            "BACKGROUND BUILD FAILED: cannot create "
                + PREVIEW_DIRECTORY);
        return;
    }
    var palette = new Palette();
    var camera = new GameCamera(palette);
    var canvas = Canvas.New(
        "XENOSCAPE Scene Preview Background Builder",
        SCREEN_W,
        SCREEN_H);
    canvas.SetFps(-1);
    if canvas.BeginFrame() == 0 {
        canvas.Close();
        Terminal.Say("BACKGROUND BUILD FAILED: canvas unavailable");
        return;
    }

    var region = 1;
    while region <= 10 {
        camera.drawBiomeBackground(
            canvas, region, PREVIEW_TIMER_MS);
        var pixels = canvas.Screenshot();
        var path = previewPath(region);
        if pixels == null or pixels.Width != SCREEN_W
           or pixels.Height != SCREEN_H
           or pixels.SavePng(path) != 1 {
            canvas.Close();
            Terminal.Say(
                "BACKGROUND BUILD FAILED: cannot write " + path);
            return;
        }
        region = region + 1;
    }
    canvas.Close();
    Terminal.Say("RESULT: ok");
}
