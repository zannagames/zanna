//
// File: examples/games/xenoscape-scenes/tools/build_release_assets.zia
// Purpose: Bakes deterministic first-party sprite, tile, icon, and UI atlases.
// Key invariants:
//   - Every output is derived only from in-tree procedural art and fixed colors.
//   - Atlas cell sizes and ordering remain stable for package probes and tooling.
// Ownership/Lifetime:
//   - The process owns temporary Pixels buffers and releases them on exit.
// Links: ../sprites.zia, ../player_animation.zia, ../assets/manifest.txt,
//        ../docs/internals/testing.md
//
//===----------------------------------------------------------------------===//

module build_release_assets;

bind Zanna.Graphics;
bind Zanna.Terminal as Terminal;
bind "../config";
bind "../palette";
bind "../player_animation";
bind "../sprites";

/// @brief Save one mandatory PNG and report an actionable build diagnostic.
///
/// @param pixels Owned or borrowed output buffer to encode.
/// @param path Project-relative destination whose parent directory already exists.
/// @return True when PNG encoding and the filesystem write both succeed.
func saveReleasePng(pixels: Pixels, path: String) -> Boolean {
    if pixels == null {
        Terminal.Say("ASSET BUILD FAILED: null buffer for " + path);
        return false;
    }
    if pixels.SavePng(path) != 1 {
        Terminal.Say("ASSET BUILD FAILED: cannot write " + path);
        return false;
    }
    return true;
}

/// @brief Bake all 41 stable right-facing player frames into an 8x6 atlas.
///
/// Empty cells at the end remain transparent. The grid layout is compatible
/// with `SpriteSheet.FromGrid(..., PLAYER_SPRITE_W, PLAYER_SPRITE_H)` and gives
/// runtime code a first-party production path while preserving SpriteFactory as
/// the exact deterministic missing-asset fallback.
///
/// @param sprites Borrowed fully constructed SpriteFactory.
/// @return Newly allocated 448x432 release player atlas.
func buildPlayerAtlas(sprites: SpriteFactory) -> Pixels {
    var columns = 8;
    var rows = 6;
    var atlas = Pixels.New(columns * PLAYER_SPRITE_W,
                           rows * PLAYER_SPRITE_H);
    var frame = 0;
    while frame < PLAYER_RELEASE_FRAME_COUNT {
        var x = (frame % columns) * PLAYER_SPRITE_W;
        var y = (frame / columns) * PLAYER_SPRITE_H;
        atlas.Copy(x, y, sprites.getPlayerFrame(1, frame), 0, 0,
                   PLAYER_SPRITE_W, PLAYER_SPRITE_H);
        frame = frame + 1;
    }
    return atlas;
}

/// @brief Bake every stable gameplay tile id into an 8x8 inspection atlas.
///
/// Unused trailing cells remain transparent. Animated tiles use their authored
/// base frame so tooling and package validation never depend on wall-clock time.
///
/// @param sprites Borrowed fully constructed SpriteFactory.
/// @return Newly allocated 512x512 tile atlas covering ids 0..56.
func buildTileAtlas(sprites: SpriteFactory) -> Pixels {
    var columns = 8;
    var atlas = Pixels.New(columns * TILE_SIZE, columns * TILE_SIZE);
    var tile = 0;
    while tile <= TILE_GRAPPLE_ANCHOR {
        var x = (tile % columns) * TILE_SIZE;
        var y = (tile / columns) * TILE_SIZE;
        atlas.Copy(x, y, sprites.getTile(tile), 0, 0,
                   TILE_SIZE, TILE_SIZE);
        tile = tile + 1;
    }
    return atlas;
}

/// @brief Compose the release HUD icon strip from production pickup art.
///
/// Four retained pickup sprites are paired with hand-authored map, objective,
/// radio, and simulator pictograms. Cell borders and cyan/gold accents match the
/// game HUD so this atlas can be reused by downstream UI tooling.
///
/// @param sprites Borrowed fully constructed SpriteFactory.
/// @return Newly allocated 512x64 icon atlas with eight 64px cells.
func buildIconAtlas(sprites: SpriteFactory) -> Pixels {
    var atlas = Pixels.New(512, 64);
    atlas.FillColor(Color.RGB(4, 9, 18));
    var cell = 0;
    while cell < 8 {
        atlas.DrawFrame(cell * 64, 0, 64, 64, Color.RGB(38, 76, 105));
        cell = cell + 1;
    }
    var coin = sprites.getCoinFrame(0).Scale(42, 42);
    var health = sprites.getHealthOrb().Scale(42, 42);
    var speed = sprites.getSpeedPickup().Scale(42, 42);
    var shield = sprites.getShieldPickup().Scale(42, 42);
    atlas.Copy(11, 11, coin, 0, 0, 42, 42);
    atlas.Copy(75, 11, health, 0, 0, 42, 42);
    atlas.Copy(139, 11, speed, 0, 0, 42, 42);
    atlas.Copy(203, 11, shield, 0, 0, 42, 42);

    // Map node and routes.
    atlas.DrawDisc(288, 32, 10, Color.RGB(65, 200, 225));
    atlas.DrawLine(274, 18, 302, 46, Color.RGB(190, 225, 235));
    atlas.DrawLine(274, 46, 302, 18, Color.RGB(190, 225, 235));
    // Objective diamond.
    atlas.DrawTriangle(352, 9, 375, 32, 352, 55, Color.RGB(245, 205, 95));
    atlas.DrawTriangle(352, 9, 329, 32, 352, 55, Color.RGB(170, 125, 45));
    // Radio rings.
    atlas.DrawRing(416, 32, 19, Color.RGB(65, 200, 225));
    atlas.DrawRing(416, 32, 10, Color.RGB(120, 235, 245));
    atlas.DrawDisc(416, 32, 3, Color.RGB(245, 205, 95));
    // Simulator crossed blades / energy traces.
    atlas.DrawThickLine(470, 15, 498, 49, 4, Color.RGB(185, 95, 225));
    atlas.DrawThickLine(498, 15, 470, 49, 4, Color.RGB(245, 205, 95));
    return atlas;
}

/// @brief Build the authored translucent title-menu panel texture.
///
/// The texture contains only framing, circuit traces, and scan accents; text and
/// focus remain live Canvas elements so accessibility scaling and semantic input
/// prompts stay authoritative. Alpha is preserved by PNG output.
///
/// @return Newly allocated 440x330 UI texture.
func buildTitlePanelTexture() -> Pixels {
    var panel = Pixels.New(440, 330);
    panel.DrawBox(0, 0, 440, 330, Color.RGBA(2, 7, 16, 205));
    panel.DrawFrame(0, 0, 440, 330, Color.RGB(55, 120, 150));
    panel.DrawFrame(4, 4, 432, 322, Color.RGB(20, 58, 82));
    panel.DrawLine(24, 54, 416, 54, Color.RGB(46, 105, 132));
    panel.DrawLine(24, 304, 416, 304, Color.RGB(46, 105, 132));
    var y = 78;
    while y < 288 {
        panel.DrawLine(30, y, 52, y, Color.RGB(32, 76, 100));
        panel.DrawLine(388, y, 410, y, Color.RGB(32, 76, 100));
        y = y + 40;
    }
    panel.DrawLine(8, 36, 36, 8, Color.RGB(245, 175, 65));
    panel.DrawLine(404, 8, 432, 36, Color.RGB(65, 200, 225));
    panel.DrawDisc(22, 318, 3, Color.RGB(245, 205, 95));
    panel.DrawDisc(418, 318, 3, Color.RGB(65, 200, 225));
    return panel;
}

/// @brief Return the runtime's representative frame for one stable enemy id.
func enemyPreview(sprites: SpriteFactory, enemyType: Integer) -> Pixels {
    if enemyType == ENEMY_SLIME { return sprites.getSlimeFrame(0); }
    if enemyType == ENEMY_BAT { return sprites.getBatFrame(0); }
    if enemyType == ENEMY_TURRET { return sprites.getTurretBase(); }
    if enemyType == ENEMY_BOSS
       or enemyType == ENEMY_BEACON_WARDEN
       or enemyType == ENEMY_RELAY_CUSTODIAN
       or enemyType == ENEMY_TIDE_LEVIATHAN
       or enemyType == ENEMY_VERDANT_COLOSSUS
       or enemyType == ENEMY_CRYO_CUSTODIAN
       or enemyType == ENEMY_NULL_HARVESTER {
        return sprites.getBossFrame(0);
    }
    if enemyType == ENEMY_DRONE {
        return sprites.getDroneFrame(0);
    }
    if enemyType == ENEMY_SPOREWALKER {
        return sprites.getSporewalkerFrame(0);
    }
    if enemyType == ENEMY_GLOWMOTH {
        return sprites.getGlowmothFrame(0);
    }
    if enemyType == ENEMY_FUNGAL_TURRET {
        return sprites.getFungalTurretFrame(0);
    }
    if enemyType == ENEMY_MYCELIUM {
        return sprites.getMyceliumFrame(0);
    }
    if enemyType == ENEMY_SPORE_MOTHER {
        return sprites.getSporeMothFrame(0);
    }
    if enemyType == ENEMY_CRYSTAL_GOLEM {
        return sprites.getCrystalGolemFrame(0);
    }
    if enemyType == ENEMY_SHARD_BAT {
        return sprites.getShardBatFrame(0);
    }
    if enemyType == ENEMY_RESONANCE_ORB {
        return sprites.getResonanceOrbFrame(0);
    }
    if enemyType == ENEMY_MIRROR_SLIME {
        return sprites.getMirrorSlimeFrame(0);
    }
    if enemyType == ENEMY_CRYSTAL_WYRM {
        return sprites.getCrystalWyrmFrame(0);
    }
    if enemyType == ENEMY_MAGMA_SLUG {
        return sprites.getMagmaSlugFrame(0);
    }
    if enemyType == ENEMY_EMBER_WASP {
        return sprites.getEmberWaspFrame(0);
    }
    if enemyType == ENEMY_FORGE_SENTINEL {
        return sprites.getForgeSentinelFrame(0);
    }
    if enemyType == ENEMY_MAGMA_CORE {
        return sprites.getMagmaCoreFrame(0);
    }
    if enemyType == ENEMY_ICE_WRAITH {
        return sprites.getIceWraithFrame(0);
    }
    if enemyType == ENEMY_FROST_BEETLE {
        return sprites.getFrostBeetleFrame(0);
    }
    if enemyType == ENEMY_STALACTITE_BAT {
        return sprites.getStalactiteBatFrame(0);
    }
    if enemyType == ENEMY_VINE_WHIP {
        return sprites.getVineWhipSprite();
    }
    if enemyType == ENEMY_MOSS_GOLEM {
        return sprites.getMossGolemFrame(0);
    }
    if enemyType == ENEMY_RUIN_GUARDIAN {
        return sprites.getRuinGuardianFrame(0);
    }
    if enemyType == ENEMY_SHADOW_CLONE {
        return sprites.getShadowCloneFrame(0);
    }
    if enemyType == ENEMY_CORRUPTION {
        return sprites.getCorruptionSprite();
    }
    if enemyType == ENEMY_ARCHITECT {
        return sprites.getArchitectFrame(0);
    }
    if enemyType == ENEMY_PATROL_DRONE {
        return sprites.getDroneFrame(0);
    }
    if enemyType == ENEMY_BOMB_CARRIER {
        return sprites.getBombCarrierFrame(0);
    }
    var fallback = Pixels.New(48, 48);
    fallback.DrawBox(4, 4, 40, 40, Color.RGB(110, 44, 130));
    fallback.DrawFrame(4, 4, 40, 40, Color.RGB(255, 80, 220));
    fallback.DrawLine(12, 12, 36, 36, Color.RGB(255, 180, 240));
    fallback.DrawLine(36, 12, 12, 36, Color.RGB(255, 180, 240));
    return fallback;
}

/// @brief Build one representative pickup cell, including procedural types.
func pickupPreview(sprites: SpriteFactory, pickupType: Integer) -> Pixels {
    if pickupType == PICKUP_COIN { return sprites.getCoinFrame(0); }
    if pickupType == PICKUP_HEALTH { return sprites.getHealthOrb(); }
    if pickupType == PICKUP_SPEED { return sprites.getSpeedPickup(); }
    if pickupType == PICKUP_SHIELD { return sprites.getShieldPickup(); }
    if pickupType == PICKUP_RAPIDFIRE { return sprites.getRapidPickup(); }
    var icon = Pixels.New(48, 48);
    if pickupType == PICKUP_GEM {
        icon.DrawTriangle(24, 6, 11, 23, 37, 23,
                          Color.RGB(115, 205, 255));
        icon.DrawTriangle(24, 42, 11, 23, 37, 23,
                          Color.RGB(55, 125, 225));
        icon.DrawLine(19, 17, 29, 17, Color.RGB(220, 245, 255));
        return icon;
    }
    if pickupType == PICKUP_HP_UP {
        icon.DrawDisc(18, 18, 10, Color.RGB(245, 86, 110));
        icon.DrawDisc(30, 18, 10, Color.RGB(245, 86, 110));
        icon.DrawTriangle(8, 20, 40, 20, 24, 43,
                          Color.RGB(205, 45, 76));
        icon.DrawBox(21, 16, 6, 19, Color.RGB(255, 235, 170));
        icon.DrawBox(15, 22, 18, 6, Color.RGB(255, 235, 170));
        return icon;
    }
    if pickupType == PICKUP_KEY {
        icon.DrawRing(16, 19, 9, Color.RGB(245, 205, 80));
        icon.DrawThickLine(23, 25, 40, 40, 5,
                           Color.RGB(220, 170, 48));
        icon.DrawBox(33, 34, 5, 10, Color.RGB(220, 170, 48));
        icon.DrawBox(39, 37, 5, 7, Color.RGB(220, 170, 48));
        return icon;
    }
    icon.DrawDisc(24, 24, 16, Color.RGB(255, 80, 220));
    return icon;
}

/// @brief Return the production tile that visually represents an interaction.
func interactionPreview(sprites: SpriteFactory,
                        interactionType: Integer) -> Pixels {
    if interactionType == INTERACTION_SWITCH
       or interactionType == INTERACTION_SWITCH_TARGET {
        return sprites.getTile(TILE_SWITCH);
    }
    if interactionType == INTERACTION_LOCKED_DOOR {
        return sprites.getTile(TILE_LOCKED_DOOR);
    }
    if interactionType == INTERACTION_SAVE_STATION {
        return sprites.getTile(TILE_SAVE_STATION);
    }
    if interactionType == INTERACTION_ABILITY_SHRINE {
        return sprites.getTile(TILE_ABILITY_SHRINE);
    }
    if interactionType == INTERACTION_TELEPORTER {
        return sprites.getTile(TILE_TELEPORTER);
    }
    if interactionType == INTERACTION_LORE_TERMINAL {
        return sprites.getTile(TILE_LORE_TERMINAL);
    }
    if interactionType == INTERACTION_REGION_GATE {
        return sprites.getTile(TILE_AIRLOCK);
    }
    return sprites.getTile(TILE_SWITCH);
}

/// @brief Center one runtime sprite in a 64px project-preview atlas cell.
func placePreview(atlas: Pixels, frame: Integer, source: Pixels) {
    if atlas == null or source == null or frame < 0 { return; }
    var sprite = source;
    var width = sprite.get_Width();
    var height = sprite.get_Height();
    var targetWidth = width;
    var targetHeight = height;
    if targetWidth > 56 {
        targetHeight = targetHeight * 56 / targetWidth;
        targetWidth = 56;
    }
    if targetHeight > 56 {
        targetWidth = targetWidth * 56 / targetHeight;
        targetHeight = 56;
    }
    if targetWidth < 1 { targetWidth = 1; }
    if targetHeight < 1 { targetHeight = 1; }
    if targetWidth != width or targetHeight != height {
        sprite = source.Scale(targetWidth, targetHeight);
    }
    var cellX = (frame % 8) * 64;
    var cellY = (frame / 8) * 64;
    atlas.Copy(cellX + (64 - targetWidth) / 2,
               cellY + (64 - targetHeight) / 2,
               sprite, 0, 0, targetWidth, targetHeight);
}

/// @brief Bake runtime-equivalent enemy, pickup, and interaction previews.
/// @details Frames 0-36 are enemy ids, 40-47 pickup ids, 49-56 interaction
///          ids 1-8, and 57-59 are marker/checkpoint/player-start records.
func buildSceneObjectPreviewAtlas(sprites: SpriteFactory) -> Pixels {
    var atlas = Pixels.New(512, 512);
    var enemyType = 0;
    while enemyType <= 36 {
        placePreview(atlas, enemyType, enemyPreview(sprites, enemyType));
        enemyType = enemyType + 1;
    }
    var pickupType = 0;
    while pickupType <= PICKUP_KEY {
        placePreview(
            atlas, 40 + pickupType,
            pickupPreview(sprites, pickupType));
        pickupType = pickupType + 1;
    }
    var interactionType = 1;
    while interactionType <= INTERACTION_REGION_GATE {
        placePreview(
            atlas, 48 + interactionType,
            interactionPreview(sprites, interactionType));
        interactionType = interactionType + 1;
    }

    var marker = Pixels.New(48, 48);
    marker.DrawDisc(24, 24, 14, Color.RGB(65, 200, 225));
    marker.DrawRing(24, 24, 20, Color.RGB(245, 205, 95));
    marker.DrawLine(24, 4, 24, 44, Color.RGB(190, 235, 245));
    marker.DrawLine(4, 24, 44, 24, Color.RGB(190, 235, 245));
    placePreview(atlas, 57, marker);
    placePreview(atlas, 58, sprites.getTile(TILE_SAVE_STATION));
    placePreview(atlas, 59, sprites.getPlayerFrame(1, 0));
    return atlas;
}

/// @brief Generate the complete deterministic release-art inventory.
///
/// @return Nothing. Prints `RESULT: ok` only when all five PNGs are written.
func main() {
    var palette = new Palette();
    var sprites = new SpriteFactory(palette);
    if saveReleasePng(buildPlayerAtlas(sprites),
                      "assets/sprites/player-release-sheet.png") == false {
        return;
    }
    if saveReleasePng(buildTileAtlas(sprites),
                      "assets/tiles/biome-tile-atlas.png") == false {
        return;
    }
    if saveReleasePng(buildIconAtlas(sprites),
                      "assets/icons/hud-icon-atlas.png") == false {
        return;
    }
    if saveReleasePng(
           buildSceneObjectPreviewAtlas(sprites),
           "assets/sprites/scene-object-preview-atlas.png") == false {
        return;
    }
    if saveReleasePng(buildTitlePanelTexture(),
                      "assets/ui/title-menu-panel.png") == false {
        return;
    }
    Terminal.Say("RESULT: ok");
}
