  "scenePreview2D": {
    "outputWidth": 1280,
    "outputHeight": 720,
    "variantProperty": "region",
    "variantOffset": -1,
    "variantImages": [
      "assets/backgrounds/scene-region-01.png",
      "assets/backgrounds/scene-region-02.png",
      "assets/backgrounds/scene-region-03.png",
      "assets/backgrounds/scene-region-04.png",
      "assets/backgrounds/scene-region-05.png",
      "assets/backgrounds/scene-region-06.png",
      "assets/backgrounds/scene-region-07.png",
      "assets/backgrounds/scene-region-08.png",
      "assets/backgrounds/scene-region-09.png",
      "assets/backgrounds/scene-region-10.png"
    ],
    "fit": "cover",
    "showGrid": false
