{
  "version": 19,
  "components": [
    {
      "name": "enemy-spawn",
      "label": "Enemy Spawn",
      "target": "2d-object",
      "createObjectType": "enemy",
      "description": "One enemy spawn record. enemy.type uses the game's stable EnemyType id (see config.zia).",
      "fields": [
        {
          "key": "enemy.type",
          "label": "Enemy type id",
          "type": "int",
          "default": 0
        }
      ]
    },
    {
      "name": "pickup",
      "label": "Pickup",
      "target": "2d-object",
      "createObjectType": "pickup",
      "description": "One pickup record. pickup.type uses the stable PICKUP_* id (0 coin, 1 health, 2 speed, 3 shield, 4 rapid fire, 5 gem, 6 max-HP up, 7 keycard).",
      "fields": [
        {
          "key": "pickup.type",
          "label": "Pickup type id",
          "type": "int",
          "default": 0
        }
      ]
    },
    {
      "name": "interaction",
      "label": "Interaction",
      "target": "2d-object",
      "createObjectType": "interaction",
      "description": "One authored interaction. interaction.type uses INTERACTION_* (1 switch, 2 switch target, 3 locked door, 4 save station, 5 ability shrine, 6 teleporter, 7 lore terminal, 8 region gate).",
      "fields": [
        {
          "key": "interaction.type",
          "label": "Interaction type id",
          "type": "enum",
          "default": "4",
          "storedKind": "int",
          "choices": [
            {
              "value": "1",
              "label": "Switch"
            },
            {
              "value": "2",
              "label": "Switch Target"
            },
            {
              "value": "3",
              "label": "Locked Door"
            },
            {
              "value": "4",
              "label": "Save Station"
            },
            {
              "value": "5",
              "label": "Ability Shrine"
            },
            {
              "value": "6",
              "label": "Teleporter"
            },
            {
              "value": "7",
              "label": "Lore Terminal"
            },
            {
              "value": "8",
              "label": "Region Gate"
            }
          ]
        },
        {
          "key": "interaction.id",
          "label": "Stable record id",
          "type": "int",
          "default": 0
        },
        {
          "key": "interaction.channel",
          "label": "Switch channel or requirement",
          "type": "int",
          "default": 0
        },
        {
          "key": "interaction.payload",
          "label": "Payload (lore/ability/region id)",
          "type": "int",
          "default": 0
        }
      ]
    },
    {
      "name": "boss",
      "label": "Boss Spawn",
      "target": "2d-object",
      "createObjectType": "boss",
      "description": "The regional boss arena spawn point.",
      "fields": [
        {
          "key": "boss.type",
          "label": "Boss enemy type id",
          "type": "int",
          "default": 3
        }
      ]
    },
    {
      "name": "marker",
      "label": "Structural Marker",
      "target": "2d-object",
      "createObjectType": "marker",
      "description": "Column anchor consumed by the HUD, validation, and campaign probes. Position X divided by the tile size is the anchor column.",
      "fields": [
        {
          "key": "marker.kind",
          "label": "Marker kind",
          "type": "enum",
          "choices": [
            "landmark",
            "tutorial",
            "mastery",
            "setpiece",
            "secret"
          ],
          "default": "landmark"
        }
      ]
    },
    {
      "name": "collider",
      "label": "Collider",
      "target": "2d-object",
      "description": "2D collider convention games read at spawn (ADR 0225).",
      "fields": [
        {
          "key": "collider.kind",
          "type": "enum",
          "label": "Kind",
          "choices": [
            "box",
            "circle",
            "tile-rect"
          ]
        },
        {
          "key": "collider.halfW",
          "type": "float",
          "label": "Half width"
        },
        {
          "key": "collider.halfH",
          "type": "float",
          "label": "Half height"
        },
        {
          "key": "collider.radius",
          "type": "float",
          "label": "Radius"
        },
        {
          "key": "collider.offsetX",
          "type": "float",
          "label": "Offset X"
        },
        {
          "key": "collider.offsetY",
          "type": "float",
          "label": "Offset Y"
        },
        {
          "key": "collider.trigger",
          "type": "bool",
          "label": "Trigger"
        }
      ]
    },
    {
      "name": "sprite-clip",
      "label": "Sprite Clip",
      "target": "2d-object",
      "description": "AnimationClip2D frames games play at spawn (ADR 0225).",
      "fields": [
        {
          "key": "anim.start",
          "type": "int",
          "label": "Start frame",
          "default": 0
        },
        {
          "key": "anim.count",
          "type": "int",
          "label": "Frame count",
          "default": 1
        },
        {
          "key": "anim.delayMs",
          "type": "int",
          "label": "Frame delay ms",
          "default": 120
        },
        {
          "key": "anim.loop",
          "type": "bool",
          "label": "Loop"
        }
      ]
    }
  ],
