  "sceneComponents": [
    {
      "name": "region-settings",
      "label": "Region",
      "target": "2d-scene",
      "description": "Region identity and player start the game reads.",
      "fields": [
        {
          "key": "region",
          "type": "int",
          "label": "Region id",
          "group": "Identity"
        },
        {
          "key": "theme",
          "type": "enum",
          "label": "Theme",
          "group": "Identity",
          "storedKind": "int",
          "choices": [
            {
              "value": "0",
              "label": "Grasslands"
            },
            {
              "value": "1",
              "label": "Cave"
            },
            {
              "value": "2",
              "label": "Volcano"
            },
            {
              "value": "3",
              "label": "Sky"
            },
            {
              "value": "4",
              "label": "Ruins"
            },
            {
              "value": "5",
              "label": "Station"
            }
          ]
        },
        {
          "key": "playerStartX",
          "type": "vec2",
          "label": "Player start",
          "keys": [
            "playerStartX",
            "playerStartY"
          ],
          "group": "Player"
        }
      ]
    }
  ]
}
