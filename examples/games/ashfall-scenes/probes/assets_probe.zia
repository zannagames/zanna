//
// File: examples/games/ashfall-scenes/probes/assets_probe.zia
// Purpose: Validate runtime asset fallbacks and Studio authoring previews.
// Key invariants:
//   - Optional downloaded art can never make the fallback render path impure.
//   - Every metadata variant referenced by Studio has a loadable, nonempty
//     self-contained preview prefab.
//   - Procedural terrain variants have deterministic scene-level previews.
//   - Schema-v15 runtime water owns exact loadable production albedo/normal maps.
//   - Schema-v16 material overlays own every generated production surface map.
// Ownership/Lifetime:
//   - Each probe game and loaded preview graph is process-local and temporary.
//   - The probe never writes or mutates source assets.
// Links: ../tools/build_studio_previews.zia, ../scene-components.json,
//        docs/adr/0199-project-owned-3d-node-prefab-previews.md,
//        docs/adr/0203-project-owned-3d-scene-environment-previews.md,
//        docs/adr/0212-additive-3d-environment-preview-layers.md,
//        docs/adr/0213-runtime-backed-water-preview-layers.md,
//        docs/adr/0214-project-owned-3d-material-previews.md
//
//===----------------------------------------------------------------------===//

module assets_probe;

bind Zanna.Graphics3D as G3D;
bind Zanna.Graphics.Pixels as Pixels;
bind Zanna.IO.File as File;
bind Zanna.Terminal as Terminal;
bind "../config" as config;
bind "../game" as game;

/// @brief Return a stable two-digit metadata-variant suffix.
func variantSuffix(index: Integer) -> String {
    if index < 10 { return "0" + index; }
    return "" + index;
}

/// @brief Resolve previews from either the project or repository working dir.
func previewRoot() -> String {
    var local = "assets/editor-previews";
    if File.Exists(local + "/prop-00.scene3d") { return local; }
    return "examples/games/ashfall-scenes/assets/editor-previews";
}

/// @brief Validate a contiguous prefab family without mutating any graph.
func validatePreviewFamily(
    root: String, prefix: String, count: Integer) -> Boolean {
    var index = 0;
    while index < count {
        var path =
            root + "/" + prefix + "-" + variantSuffix(index) + ".scene3d";
        if File.Exists(path) == false {
            Terminal.Say("FAIL: missing Studio preview " + path);
            return false;
        }
        var preview = G3D.SceneGraph.Load(path);
        if preview == null or preview.Root == null
           or preview.Root.ChildCount == 0 {
            Terminal.Say("FAIL: invalid Studio preview " + path);
            return false;
        }
        index = index + 1;
    }
    return true;
}

/// @brief Validate every prefab referenced by scene-components.json.
func validateStudioPreviews() -> Boolean {
    var root = previewRoot();
    if validatePreviewFamily(root, "prop", 24) == false { return false; }
    if validatePreviewFamily(root, "enemy", 14) == false { return false; }
    if validatePreviewFamily(root, "pickup", 5) == false { return false; }
    // Terrain ids start at one; variant zero intentionally has no asset.
    var terrainIndex = 1;
    while terrainIndex <= 3 {
        var terrainPath =
            root + "/environment-terrain-"
            + variantSuffix(terrainIndex) + ".scene3d";
        if File.Exists(terrainPath) == false {
            Terminal.Say(
                "FAIL: missing Studio preview " + terrainPath);
            return false;
        }
        var terrain = G3D.SceneGraph.Load(terrainPath);
        if terrain == null or terrain.Root == null
           or terrain.Root.ChildCount == 0 {
            Terminal.Say(
                "FAIL: invalid Studio preview " + terrainPath);
            return false;
        }
        terrainIndex = terrainIndex + 1;
    }
    var waterImages: List[String] = [
        root + "/water-albedo.png",
        root + "/water-normal.png"
    ];
    var waterIndex = 0;
    while waterIndex < waterImages.Count {
        var waterPath = waterImages[waterIndex];
        if File.Exists(waterPath) == false {
            Terminal.Say("FAIL: missing Studio water image " + waterPath);
            return false;
        }
        var water = Pixels.Load(waterPath);
        if water == null
           or Pixels.get_Width(water) != 256
           or Pixels.get_Height(water) != 256 {
            Terminal.Say("FAIL: invalid Studio water image " + waterPath);
            return false;
        }
        waterIndex = waterIndex + 1;
    }
    var surfaceIndex = 0;
    var surfaceImageCount = 0;
    while surfaceIndex < 10 {
        // Surface 7 is the runtime's intentionally textureless emissive accent.
        if surfaceIndex != 7 {
            var surfacePrefix =
                root + "/surface-" + variantSuffix(surfaceIndex);
            var surfaceImages: List[String] = [
                surfacePrefix + "-albedo.png",
                surfacePrefix + "-normal.png"
            ];
            var imageIndex = 0;
            while imageIndex < surfaceImages.Count {
                var surfacePath = surfaceImages[imageIndex];
                if File.Exists(surfacePath) == false {
                    Terminal.Say(
                        "FAIL: missing Studio surface image " + surfacePath);
                    return false;
                }
                var surface = Pixels.Load(surfacePath);
                if surface == null
                   or Pixels.get_Width(surface) != 256
                   or Pixels.get_Height(surface) != 256 {
                    Terminal.Say(
                        "FAIL: invalid Studio surface image " + surfacePath);
                    return false;
                }
                surfaceImageCount = surfaceImageCount + 1;
                imageIndex = imageIndex + 1;
            }
        }
        surfaceIndex = surfaceIndex + 1;
    }
    Terminal.Say(
        "studioPreviews=ok prefabs=46 waterImages=2 surfaceImages="
        + surfaceImageCount);
    return true;
}

/// @brief Exercise all runtime enemy and weapon presentation paths.
func sweep(g: game.Game) {
    var a = 0;
    while a < config.EN_TYPE_COUNT {
        g.devSpawnEnemy(a, 5.0 + (a % 5) * 2.0, -5.0 - (a / 5) * 3.0);
        a = a + 1;
    }
    var t = 0;
    while t < 60 {
        g.tickSim(config.FIXED_DT);
        g.stepPhysics(config.FIXED_DT);
        t = t + 1;
    }
    g.devRenderFrame();
    // Cycle all weapons with a render each (view-model path per weapon).
    var w = 0;
    while w < config.WEAPON_COUNT {
        g.devGiveWeapon(w);
        g.devSwitchWeapon(w);
        g.tickSim(config.FIXED_DT);
        g.devRenderFrame();
        w = w + 1;
    }
}

/// @brief Run authored-preview, optional-art, and fallback-purity checks.
func start() {
    if validateStudioPreviews() == false { return; }

    // (a) Registry forced on.
    var g = new game.Game();
    g.setHeadless(true);
    g.initCore(0x5A17F00D);
    g.boot(true, false);
    g.devForceAssets(true);
    sweep(g);
    if g.devAssetsLoaded() > 0 {
        Terminal.Say("assets=loaded count=" + g.devAssetsLoaded());
    } else {
        Terminal.Say("assets=fallback");
    }

    // (b) Registry off: composite purity.
    var g2 = new game.Game();
    g2.setHeadless(true);
    g2.initCore(0x5A17F00D);
    g2.boot(true, false);
    sweep(g2);
    Terminal.Say("fallback=ok");
    Terminal.Say("RESULT: ok");
    Terminal.Say("PASS");
}
