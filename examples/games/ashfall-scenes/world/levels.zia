//
// File: examples/games/ashfall-scenes/world/levels.zia
// Purpose: Scene-driven mission dispatch — every campaign level builds from
//          its authored assets/scenes/*.scene3d file.
// Key invariants:
//   - build() keeps the exact signature the level manager consumes; only
//     the source of authored data changed from code builders to scenes.
//   - The test arena (LV_ARENA) stays code-built in world/arena.zia and is
//     not scene-driven by design.
//   - A missing or unreadable scene falls back to a minimal recovery room
//     instead of trapping mid-transition.
//   - The --scene override redirects the next build to one explicit file.
// Ownership/Lifetime:
//   - Callers own the LevelBuilder/Objectives being filled.
// Links: ./scene_levels.zia, ./level_manager.zia,
//        ../../ashfall/tools/export_scenes.zia
//
//===----------------------------------------------------------------------===//

module levels;

bind "../config" as config;
bind "./level_base" as level_base;
bind "./objectives" as objectives;
bind "./scene_levels" as scene_levels;

// One-shot explicit scene override (set from --scene; cleared after use).
var overridePath: String = "";
// The path build() actually read, for sidecar discovery (ADR 0225).
var builtScenePath: String = "";

/// Redirect the next build() to one explicit scene file.
func setSceneOverride(path: String) { overridePath = path; }

/// Return the scene path the most recent build() consumed.
func lastScenePath() -> String { return builtScenePath; }

/// Return the authored scene path for one campaign level id.
func scenePathFor(levelId: Integer) -> String {
    if levelId == config.LV_HUB { return "assets/scenes/hub.scene3d"; }
    return "assets/scenes/mission-0" + levelId + ".scene3d";
}

// Dispatch: fill lb + obj for the given level id from its authored scene.
func build(levelId: Integer, lb: level_base.LevelBuilder, obj: objectives.Objectives) {
    lb.reset();
    obj.clear();
    var path = scenePathFor(levelId);
    if overridePath != "" {
        path = overridePath;
        overridePath = "";
    }
    builtScenePath = path;
    if scene_levels.loadInto(path, lb, obj) { return; }
    buildRecoveryRoom(lb, obj, path);
}

// A readable, winnable fallback so a broken scene reference never strands
// the player in an unloaded void.
hide func buildRecoveryRoom(lb: level_base.LevelBuilder,
                            obj: objectives.Objectives, path: String) {
    lb.reset();
    obj.clear();
    lb.setName("RECOVERY: " + path);
    lb.addArenaShell(10.0, 3.0, 0.34, 0.34, 0.38, 0.30, 0.30, 0.34);
    lb.setStart(0.0, 0.2, 4.0, 3.14159);
    lb.addRouteMarker(0.0, -6.0, 2);
    obj.add(0, 0.0, -6.0, 2.0, 0, "REACH THE EXIT MARKER", false);
}
