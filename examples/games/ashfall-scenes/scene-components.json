        {
          "key": "routeMarker.kind",
          "type": "enum",
          "choices": [
            "0",
            "1",
            "2",
            "3"
          ],
          "default": "0"
        }
      ]
    },
    {
      "name": "landmark",
      "label": "Landmark",
