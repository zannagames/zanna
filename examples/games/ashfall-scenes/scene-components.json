{
  "version": 19,
  "components": [
    {
      "name": "enemy-spawn",
      "label": "Enemy Spawn",
      "target": "3d-node",
      "createNodeName": "Enemy Spawn",
      "description": "One campaign enemy placement (af.kind=spawn nodes).",
      "fields": [
        {
          "key": "af.kind",
          "type": "string",
          "default": "spawn"
        },
        {
          "key": "spawn.archetype",
          "type": "enum",
          "choices": [
            {
              "value": "0",
              "label": "Husk"
            },
            {
              "value": "1",
              "label": "Sapper"
            },
            {
              "value": "2",
              "label": "Drone"
            },
            {
              "value": "3",
              "label": "Ranger"
            },
            {
              "value": "4",
              "label": "Marauder"
            },
            {
              "value": "5",
              "label": "Vanguard"
            },
            {
              "value": "6",
              "label": "Stalker"
            },
            {
              "value": "7",
              "label": "Wraith"
            },
            {
              "value": "8",
              "label": "Turret"
            },
            {
              "value": "9",
              "label": "Mite"
            },
            {
              "value": "10",
              "label": "Shrike"
            },
            {
              "value": "11",
              "label": "WARDEN Goliath"
            }
          ],
          "default": "0"
        },
        {
          "key": "spawn.wave",
          "type": "int",
          "default": 0
        },
        {
          "key": "spawn.routeX",
          "type": "float",
          "default": 99999.0
        },
        {
          "key": "spawn.routeZ",
          "type": "float",
          "default": 99999.0
        }
      ]
    },
    {
      "name": "pickup",
      "label": "Pickup",
