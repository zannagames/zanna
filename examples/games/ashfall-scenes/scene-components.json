        {
          "key": "landmark.kind",
          "type": "enum",
          "choices": [
            "0",
            "1",
            "2",
            "3"
          ],
          "default": "0"
        }
      ]
    },
    {
      "name": "beat",
      "label": "Encounter Beat",
      "target": "3d-node",
      "createNodeName": "Encounter Beat",
      "description": "Authored flow beat (0=reveal 1=ambush 2=holdout 3=boss).",
      "fields": [
        {
          "key": "af.kind",
          "type": "string",
          "default": "beat"
        },
        {
          "key": "beat.kind",
          "type": "enum",
          "choices": [
            "0",
            "1",
            "2",
            "3"
          ],
          "default": "0"
        },
        {
          "key": "beat.wave",
          "type": "int",
          "default": 0
        }
      ]
    },
    {
      "name": "gate",
      "label": "Objective Gate",
      "target": "3d-node",
      "createNodeName": "Objective Gate",
