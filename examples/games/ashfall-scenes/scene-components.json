        {
          "key": "af.kind",
          "type": "string",
          "default": "gate"
        },
        {
          "key": "gate.unlock",
          "type": "int",
          "default": 0
        }
      ]
    },
    {
      "name": "collider",
      "label": "Box Collider",
      "target": "3d-node",
      "description": "ADR 0185 collider convention for colliding geometry.",
      "fields": [
        {
          "key": "collider.kind",
