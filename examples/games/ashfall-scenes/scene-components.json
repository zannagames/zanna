        {
          "key": "af.kind",
          "type": "string",
          "default": "pickup"
        },
        {
          "key": "pickup.kind",
          "type": "int",
          "default": 0
        },
        {
          "key": "pickup.amount",
          "type": "float",
          "default": 25.0
        }
      ]
    },
    {
      "name": "prop",
      "label": "Prop",
